/-!
# The geometric inputs (★) and (P6) of MR7's Route T′, as statements (JAC D-d)

MR7's Route T′ (`MR7-plan.md`, "Lead decisions 2026-10-23, after JAC agent 27") consumes the
Jacobian only through two curve-level statements (`JAC-plan.md`, D-d.0):

* **(★) theta pull-back.** For an automorphism `σ` of `X` (over `k`, non-trivial), the arithmetic
  Chern class of an explicit `k`-rational divisor `P_σ` of positive degree (`P_σ = δ_σ^* L`,
  `δ_σ : X → J`, `x ↦ [x] − [σ x]`, `L = (1, φ_Θ)^* 𝒫`) is the pull-back of the theta class of the
  Weil form along `π_σ : Π_X → Δ_X^{ab} ⋊ G_k`:
  `c^{ar}(P_σ) = π_σ^* θ_{e^{±1}}` in `H²(Π_X, μ_n)` (`n` odd).
* **(P6) Weil pairing = ± cup product** on `Δ_X`: for `δ ∈ Δ_X` and a character
  `ψ : Δ_X → ℤ/n`, `χ_δ ∪ ψ = c₁(pt)^{± ψ(δ)}` with `χ_δ = e(δ, ·)` (Milne, *Lectures on étale
  cohomology*, Example 14.8: the cup-product duality on `H¹(X, μ_n)` "can be identified with the
  Weil pairing", stated there without proof and without sign; `MR7-plan.md` R4, P6).

This file states both as `Prop`s (**named debts** of MR7's T′ assembly, proved by the Jacobian
track; milestones C1, C2, J1–J6, P6 of `JAC-plan.md`), on the Galois model
`D₀ = curveGaloisData k hτ` of a curve `X` over a field `k` of characteristic `0`:

* `sigmaH`, **`sigmaPi`**: the automorphism `σ̃` of `Π_X` over `G_k` induced by conjugation with
  `σ ∈ Gal(Ω/k(t))` normalising `H = Gal(Ω/F)` and fixing `k̄` (e.g. a deck transformation of a
  Galois cover, as in step 0 of T′; `σ|_F` is then an automorphism of `X` over `k`): it maps
  inertia groups to inertia groups (`conj_mem_ambientKernel_SAll`);
* `cupCocycle`, **`cupClass χ ψ ∈ H²(Δ_X, μ_n)`**: the cup product of `χ : Δ_X → μ_n` and
  `ψ : Δ_X → ℤ/n` (cocycle `(γ, δ) ↦ χ(γ)^{ψ(δ)}`; `Δ_X` acts trivially on `μ_n`);
* **`ThetaPullback hτ n`** (★) and **`WeilCup hτ n`** (P6).

In (P6) the generator `c₁(pt)` of `H²(Δ_X, μ_n)` is replaced by the restriction to `Δ_X` of the
arithmetic Chern class of any `k`-rational divisor `E` (`res_{Δ_X} c^{ar}(E) = c₁(pt)^{deg E}`),
so that both statements live on the group-theoretic `Π_X = PiX D₀`, `Δ_X = DeltaX D₀`.
-/

open KummerTheory Curve AffOrbicurve WeilCurves.FunctionField AlgebraicGeometry Belyi
open CategoryTheory CurvesJacobian.Cusp
open CurvesJacobian.Kummer CurvesJacobian.LocAn.SemiAb CurvesJacobian.LocAn.WeilForm
open CurvesJacobian.LocAn.ArithChern

set_option linter.unusedSectionVars false

namespace CurvesJacobian.LocAn.JacInput

universe u

/-! ### The automorphism `σ̃` of `Π_X` induced by `σ` -/

section Sigma

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  {D : Pi1.Orbifold.GaloisData k t} [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω]

attribute [local instance 2000] Kummer.group_piX

/-- `σ` normalises `H` and fixes `k̄` pointwise. -/
structure IsGeomAut (D : Pi1.Orbifold.GaloisData k t) (σ : Ω ≃ₐ[K₀ k t] Ω) : Prop where
  conj_mem : ∀ h ∈ D.H, σ * h * σ⁻¹ ∈ D.H
  conj_inv_mem : ∀ h ∈ D.H, σ⁻¹ * h * σ ∈ D.H
  fix_kbar : ∀ x : kbar k Ω, σ (x : Ω) = x

variable {σ : Ω ≃ₐ[K₀ k t] Ω}

/-- Conjugation by `σ` maps the elements of `H` lying in some inertia group to such elements. -/
theorem conj_mem_SAll (hσ : IsGeomAut D σ) {s : Ω ≃ₐ[K₀ k t] Ω} (hs : s ∈ SAll D) :
    σ * s * σ⁻¹ ∈ SAll D := by
  obtain ⟨hsH, W, hkW, hsW⟩ := hs
  refine ⟨hσ.conj_mem s hsH, W.comap ((σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω).toRingEquiv : Ω →+* Ω),
    fun c => ?_, ?_⟩
  · rw [ValuationSubring.mem_comap]
    have : (σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω) (algebraMap k Ω c) = algebraMap k Ω c := by
      rw [IsScalarTower.algebraMap_apply k (K₀ k t) Ω, AlgEquiv.commutes]
    change (σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω) (algebraMap k Ω c) ∈ W
    rw [this]
    exact hkW c
  · refine ChernClass.mem_inertia_comap (σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω).toRingEquiv (fun x => ?_) hsW
    change (σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω) ((σ * s * σ⁻¹) x) = s ((σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω) x)
    simp [AlgEquiv.mul_apply]

/-- **Conjugation by `σ` preserves the closed subgroup generated by the inertia groups.** -/
theorem conj_mem_ambientKernel_SAll (hσ : IsGeomAut D σ) {x : Ω ≃ₐ[K₀ k t] Ω}
    (hx : x ∈ GaloisPi1.ambientKernel D.H (SAll D)) :
    σ * x * σ⁻¹ ∈ GaloisPi1.ambientKernel D.H (SAll D) := by
  let c : (Ω ≃ₐ[K₀ k t] Ω) →* (Ω ≃ₐ[K₀ k t] Ω) := MulAut.conj σ
  have hc : Continuous c := by
    change Continuous fun x => σ * x * σ⁻¹
    fun_prop
  have hcl : Subgroup.closure (GaloisPi1.conjSet D.H (SAll D)) ≤
      (GaloisPi1.ambientKernel D.H (SAll D)).comap c := by
    rw [Subgroup.closure_le]
    rintro _ ⟨g, hg, s, hs, rfl⟩
    refine Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ?_)
    refine ⟨σ * g * σ⁻¹, hσ.conj_mem g hg, σ * s * σ⁻¹, conj_mem_SAll hσ hs, ?_⟩
    change σ * (g * s * g⁻¹) * σ⁻¹ = _
    group
  have : GaloisPi1.ambientKernel D.H (SAll D) ≤ (GaloisPi1.ambientKernel D.H (SAll D)).comap c :=
    Subgroup.topologicalClosure_minimal _ hcl
      ((GaloisPi1.isClosed_ambientKernel _ _).preimage hc)
  exact this hx

/-- Conjugation by `σ` on `H`. -/
def sigmaH (hσ : IsGeomAut D σ) : D.H →* D.H where
  toFun h := ⟨σ * h * σ⁻¹, hσ.conj_mem h h.2⟩
  map_one' := Subtype.ext (by simp)
  map_mul' a b := Subtype.ext (by simp only [Subgroup.coe_mul]; group)

theorem continuous_sigmaH (hσ : IsGeomAut D σ) : Continuous (sigmaH hσ) := by
  refine Continuous.subtype_mk ?_ _
  change Continuous fun h : D.H => σ * (h : Ω ≃ₐ[K₀ k t] Ω) * σ⁻¹
  fun_prop

theorem hToGk_sigmaH (hσ : IsGeomAut D σ) (h : D.H) : hToGk D (sigmaH hσ h) = hToGk D h := by
  ext x
  change algebraMap (kbar k Ω) Ω (hToGk D (sigmaH hσ h) x) = algebraMap (kbar k Ω) Ω (hToGk D h x)
  rw [algebraMap_hToGk_apply, algebraMap_hToGk_apply]
  change σ ((h : Ω ≃ₐ[K₀ k t] Ω) ((σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω) x)) = _
  have hx : (σ⁻¹ : Ω ≃ₐ[K₀ k t] Ω) (x : Ω) = x := by
    conv_lhs => rw [← hσ.fix_kbar x]
    exact σ.symm_apply_apply _
  rw [hx, ← algebraMap_hToGk_apply]
  exact hσ.fix_kbar _

set_option synthInstance.maxHeartbeats 400000 in
-- the group structure of the quotient `Π_X` is slow to synthesize
/-- **`σ̃ : Π_X → Π_X`**, induced by conjugation with `σ`. -/
noncomputable def sigmaPiHom (hσ : IsGeomAut D σ) : PiX D →* PiX D :=
  QuotientGroup.map _ _ (sigmaH hσ) fun x hx => by
    rw [Subgroup.mem_comap]
    exact conj_mem_ambientKernel_SAll hσ hx

set_option synthInstance.maxHeartbeats 400000 in
-- the group structure of the quotient `Π_X` is slow to synthesize
theorem sigmaPiHom_mk (hσ : IsGeomAut D σ) (h : D.H) :
    sigmaPiHom hσ (h : PiX D) = ((sigmaH hσ h : D.H) : PiX D) := rfl

set_option synthInstance.maxHeartbeats 400000 in
-- the group structure of the quotient `Π_X` is slow to synthesize
theorem continuous_sigmaPiHom (hσ : IsGeomAut D σ) : Continuous (sigmaPiHom hσ) :=
  (QuotientGroup.isQuotientMap_mk _).continuous_iff.2
    (QuotientGroup.continuous_mk.comp (continuous_sigmaH hσ))

set_option synthInstance.maxHeartbeats 400000 in
-- the group structure of the quotient `Π_X` is slow to synthesize
/-- **`σ̃` as an endomorphism of `Π_X` over `G_k`.** -/
noncomputable def sigmaPi [Fact (Function.Surjective (piJ1ToGk D))] (hσ : IsGeomAut D σ) :
    OverGk D where
  toHom := sigmaPiHom hσ
  continuous_toHom := continuous_sigmaPiHom hσ
  piXToGk_toHom u := by
    induction u using QuotientGroup.induction_on with
    | H h => rw [sigmaPiHom_mk, piXToGk_mk, piXToGk_mk, hToGk_sigmaH]

end Sigma

/-! ### The cup product `H¹(Δ_X, μ_n) × H¹(Δ_X, ℤ/n) → H²(Δ_X, μ_n)` -/

section Cup

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  {D : Pi1.Orbifold.GaloisData k t} [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω]
  {n : ℕ} [NeZero n]

attribute [local instance 2000] Kummer.group_piX

theorem deltaX_smul_mu (γ : DeltaX D) (ζ : Mu n Ω) : γ • ζ = ζ := by
  change piXToGk D (γ : PiX D) • ζ = ζ
  rw [show piXToGk D (γ : PiX D) = 1 from γ.2, one_smul]

/-- The cup-product cocycle `(γ, δ) ↦ χ(γ)^{ψ(δ)}`. -/
noncomputable def cupFun (χ : DeltaX D →* Mu n Ω) (ψ : DeltaX D →* Multiplicative (ZMod n)) :
    DeltaX D × DeltaX D → Mu n Ω :=
  fun p => χ p.1 ^ (Multiplicative.toAdd (ψ p.2)).val

theorem pow_val_add (ζ : Mu n Ω) (a b : ZMod n) : ζ ^ (a + b).val = ζ ^ a.val * ζ ^ b.val := by
  rw [← pow_add, ← pow_mod_orderOf, ← pow_mod_orderOf (n := a.val + b.val)]
  congr 1
  have h : orderOf ζ ∣ n := orderOf_dvd_of_pow_eq_one (Mu.ext (by
    rw [map_pow, Mu.val_pow_n, map_one]))
  rw [ZMod.val_add, Nat.mod_mod_of_dvd _ h]

theorem isMulCocycle₂_cupFun (χ : DeltaX D →* Mu n Ω) (ψ : DeltaX D →* Multiplicative (ZMod n)) :
    groupCohomology.IsMulCocycle₂ (cupFun χ ψ) := fun g h j => by
  simp only [cupFun, deltaX_smul_mu, map_mul, toAdd_mul, mul_pow, pow_val_add]
  generalize χ g ^ (Multiplicative.toAdd (ψ j)).val = a
  generalize χ h ^ (Multiplicative.toAdd (ψ j)).val = b
  generalize χ g ^ (Multiplicative.toAdd (ψ h)).val = c
  rw [mul_comm c a, ← mul_assoc, mul_comm b a]

/-- The cup-product cocycle, locally constant for locally constant `χ`, `ψ`. -/
noncomputable def cupCocycle (χ : DeltaX D →* Mu n Ω) (hχ : IsLocallyConstant χ)
    (ψ : DeltaX D →* Multiplicative (ZMod n)) (hψ : IsLocallyConstant ψ) :
    ContH2.cocycles (DeltaX D) (Mu n Ω) :=
  ContH2.mkCocycle (cupFun χ ψ)
    ((hχ.comp_continuous continuous_fst).comp₂ (hψ.comp_continuous continuous_snd)
      fun a b => a ^ (Multiplicative.toAdd b).val)
    (isMulCocycle₂_cupFun χ ψ)

/-- **The cup product `χ ∪ ψ ∈ H²(Δ_X, μ_n)`** of `χ : Δ_X → μ_n` and `ψ : Δ_X → ℤ/n`. -/
noncomputable def cupClass (χ : DeltaX D →* Mu n Ω) (hχ : IsLocallyConstant χ)
    (ψ : DeltaX D →* Multiplicative (ZMod n)) (hψ : IsLocallyConstant ψ) :
    ContH2 (DeltaX D) (Mu n Ω) :=
  ContH2.mk (cupCocycle χ hχ ψ hψ)

/-- Restriction `H²(Π_X, μ_n) → H²(Δ_X, μ_n)`. -/
noncomputable def resDelta : ContH2 (PiX D) (Mu n Ω) →* ContH2 (DeltaX D) (Mu n Ω) :=
  ContH2.map (DeltaX D).subtype continuous_subtype_val (MonoidHom.id _) fun _ _ => rfl

end Cup

/-! ### The statements, for any Galois model -/

section Statements

attribute [local instance] isFunctionField_F

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  {D : Pi1.Orbifold.GaloisData k t} [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω]
  [Fact (Function.Surjective (piJ1ToGk D))] {n : ℕ} [NeZero n]
  (hW : Function.Bijective (weilDual (κ := kbar k Ω) (K := F (Kummer.baseChange D)) (n := n)))

attribute [local instance 2000] Kummer.group_piX

/-- The character `χ_δ = e(δ, ·) : Δ_X → μ_n` of `δ ∈ Δ_X` (the Kummer character of `a(δ)`). -/
noncomputable def chiDelta (δ : DeltaX D) : DeltaX D →* Mu n Ω :=
  (MonoidHom.mk' (weilForm hW (deltaAbMk D δ)) (weilForm_mul_right hW _)).comp (deltaAbMk D)

theorem isLocallyConstant_chiDelta [Finite (JT D n)] (δ : DeltaX D) :
    IsLocallyConstant (chiDelta hW δ) := by
  have h1 := (isLocallyConstant_weilForm hW).comp_continuous
    (Continuous.prodMk_right (deltaAbMk D δ))
  unfold chiDelta
  rw [MonoidHom.coe_comp]
  exact h1.comp_continuous (QuotientGroup.continuous_mk (N := (commClosure _).subgroupOf _))

variable (D n) in
/-- **(★) The theta pull-back, for a Galois model `D`** (JAC D-d, `JAC-plan.md` D-d.0; debt of
MR7's T′), `hW` the perfectness of the Weil pairing on `J(k̄)[n]` (which defines the Weil form
`e = weilForm hW`): for odd `n` and `g(X_{k̄}) ≥ 2`, for every `σ ∈ Gal(Ω/k(t))` normalising
`H = Gal(Ω/F)`, fixing `k̄` and acting non-trivially on `F`, there are a `G_k`-invariant divisor
`P` of `X_{k̄}` of positive degree (`P = P_σ = δ_σ^* L`), a representative `f` of `P` modulo `n`
and a sign `s = ±1` with

  `c^{ar}(P) = π_σ^* θ_{e^s}` in `H²(Π_X, μ_n)`,

`π_σ = piSigma (sigmaPi σ) : Π_X → Δ_X^{ab} ⋊ G_k`, `θ_{e^s} = thetaE hW s` the theta class of the
Weil form (`e^s = halfForm (e^{2s})`, whose commutator pairing `e^{2s}` is that of `c(L)`;
`WeilForm.thetaE_eq_halfForm`). -/
def ThetaPullbackG [Finite (JT D n)]
    (hW : Function.Bijective (weilDual (κ := kbar k Ω) (K := F (Kummer.baseChange D)) (n := n))) :
    Prop :=
  Odd n → 2 ≤ genus (kbar k Ω) (F (Kummer.baseChange D)) →
  ∀ σ : Ω ≃ₐ[K₀ k t] Ω, ∀ hσ : IsGeomAut D σ, σ ∉ D.H →
  ∃ (P : Divisor (kbar k Ω) (F (Kummer.baseChange D))) (f : Ω) (hf : IsArithRep D n P f)
    (s : ℤ),
    (∀ h : D.H, divMap (autF _ h) P = P) ∧ 0 < P.deg ∧ (s = 1 ∨ s = -1) ∧
    hf.chern = ContH2.map (piSigma (sigmaPi hσ)) (continuous_piSigma _) (MonoidHom.id _)
      (fun _ _ => rfl) (thetaE hW s)

variable (D n) in
/-- **(P6) The Weil pairing is `±` the cup product, for a Galois model `D`** (JAC D-d; debt of
MR7's T′; Milne, *LEC*, Example 14.8): there is a sign `s = ±1` such that for every
`G_k`-invariant divisor `E` of `X_{k̄}` with representative `f`, every `δ ∈ Δ_X` and every
locally constant character `ψ : Δ_X → ℤ/n`,

  `(χ_δ ∪ ψ)^{deg E} = (res_{Δ_X} c^{ar}(E))^{s ψ(δ)}`   in `H²(Δ_X, μ_n)`,

`χ_δ = e(δ, ·)` (`chiDelta`). Since `res_{Δ_X} c^{ar}(E) = c₁(pt)^{deg E}`, this says
`χ_δ ∪ ψ = c₁(pt)^{s ψ(δ)}` when `deg E` is prime to `n`. -/
def WeilCupG [Finite (JT D n)]
    (hW : Function.Bijective (weilDual (κ := kbar k Ω) (K := F (Kummer.baseChange D)) (n := n))) :
    Prop :=
  1 ≤ genus (kbar k Ω) (F (Kummer.baseChange D)) →
  ∃ s : ℤ, (s = 1 ∨ s = -1) ∧
  ∀ (E : Divisor (kbar k Ω) (F (Kummer.baseChange D))) (f : Ω) (hf : IsArithRep D n E f),
    (∀ h : D.H, divMap (autF _ h) E = E) →
    ∀ (δ : DeltaX D) (ψ : DeltaX D →* Multiplicative (ZMod n)) (hψ : IsLocallyConstant ψ),
    cupClass (chiDelta hW δ) (isLocallyConstant_chiDelta hW δ) ψ hψ ^ E.deg =
      resDelta (D := D) (n := n) hf.chern ^ (s * ((Multiplicative.toAdd (ψ δ)).val : ℤ))

end Statements

/-! ### The Galois model of a curve -/

section Curve

variable {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}} [X.Over (Spec (.of k))]
  [IsCurveOver k X] [IsIntegral X] {τ : X.functionField} (hτ : Transcendental k τ)
  [IsGalois (K₀ k (coordT τ)) (FFClosure X)]

/-- **(★)** for the Galois model `curveGaloisData k hτ` of a curve (`ThetaPullbackG`). -/
def ThetaPullback (n : ℕ) [NeZero n] : Prop :=
  ThetaPullbackG (curveGaloisData k hτ) n (weilDual_bijective_baseChange k hτ)

/-- **(P6)** for the Galois model `curveGaloisData k hτ` of a curve (`WeilCupG`). -/
def WeilCup (n : ℕ) [NeZero n] : Prop :=
  WeilCupG (curveGaloisData k hτ) n (weilDual_bijective_baseChange k hτ)

end Curve

end CurvesJacobian.LocAn.JacInput
