import CurvesJacobian.LocAn.ArithChern
import CurvesJacobian.Kummer.SyncEquivariant
import CurvesJacobian.Kummer.DeltaAbKummer

/-!
# The arithmetic Chern class of a `k`-rational divisor (JAC D-d, C1 for curves)

For a curve `X` over a field `k` of characteristic `0` (Galois model `D₀ = curveGaloisData k hτ`,
`Π_X = PiX D₀`) and the model `barData k hτ = baseChange D₀` of `X_{k̄}`
(`ρ̄ = rhoBar hτ : Gal(Ω/F k̄) ↠ Δ_X = DeltaBarX k hτ`, `Kummer/SyncBaseChange.lean`):

* **the universal covers agree**: `IsFix ρ̄ f ↔ IsFix ρ f` for `ρ = rhoPi D₀ : H ↠ Π_X`
  (`isFix_rhoPi_iff`; both kernels are generated by the inertia groups of all places of `Ω` over
  `k`, and `Gal(Ω/F k̄) ≅ Δ̃ ⊆ H` by `bcToDeltaTilde`);
* `IsArithRep.toIsChernRepDiv`: an arithmetic representative is a geometric one (MR5's
  `IsChernRepDiv` for `X_{k̄}`), and **`isArithRep_of_isChernRepDiv`**: for a `G_k`-invariant
  divisor `E` every geometric representative is arithmetic (Galois equivariance of
  representatives, `ChernClass.IsChernRepDiv.map`, plus uniqueness up to `n`-th powers);
* **`exists_isArithRep`** (genus `≥ 1`): every `G_k`-invariant divisor of `X_{k̄}` has an
  arithmetic representative; **`IsArithRep.chern_eq`**: the class does not depend on it;
* **`c1Arith`**: `c^{ar}(E) ∈ H²(Π_X, μ_n)` for `G_k`-invariant `E`, with `c1Arith_eq`,
  `c1Arith_add`;
* `iotaBar : Δ_X = DeltaBarX k hτ → Π_X` (induced by `Gal(Ω/F k̄) ≅ Δ̃ ⊆ H`) and
  **`map_iotaBar_chern`**: `ι^* c^{ar}(E) = c₁(E_{k̄})` (MR5's `c1Div`, via `h2lcToContH2`).
-/

open CategoryTheory AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale AffOrbicurve Topology
open Pi1.Orbifold Pi1 CurvesJacobian.Cusp KummerTheory KummerTheory.Curve Pi1.Profinite
open WeilCurves.FunctionField CurvesJacobian.ChernClass CurvesJacobian.Kummer

set_option linter.unusedSectionVars false

namespace CurvesJacobian.LocAn.ArithChern

universe u

variable {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}} [X.Over (Spec (.of k))]
  [IsCurveOver k X] [IsIntegral X] {τ : X.functionField} (hτ : Transcendental k τ)
  [IsGalois (K₀ k (coordT τ)) (FFClosure X)]

attribute [local instance] isFunctionField_F
attribute [local instance 2000] Kummer.group_piX

/-! ### The two universal covers agree -/

/-- `H` permutes the inertia elements. -/
theorem conj_mem_SAll_H {D : GaloisData k (coordT τ)} (g : D.H)
    {s : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X} (hs : s ∈ SAll D) :
    (g : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X) * s * g⁻¹ ∈ SAll D := by
  obtain ⟨hsH, W, hkW, hsW⟩ := hs
  set σ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X :=
    (g : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X)
  refine ⟨D.H.mul_mem (D.H.mul_mem g.2 hsH) (D.H.inv_mem g.2),
    W.comap ((σ⁻¹ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X).toRingEquiv :
      FFClosure X →+* FFClosure X), fun c => ?_, ?_⟩
  · rw [ValuationSubring.mem_comap]
    have : (σ⁻¹ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X)
        (algebraMap k (FFClosure X) c) = algebraMap k (FFClosure X) c := by
      rw [IsScalarTower.algebraMap_apply k (K₀ k (coordT τ)) (FFClosure X), AlgEquiv.commutes]
    change (σ⁻¹ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X)
      (algebraMap k (FFClosure X) c) ∈ W
    rw [this]
    exact hkW c
  · refine ChernClass.mem_inertia_comap
      (σ⁻¹ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X).toRingEquiv (fun x => ?_) hsW
    change (σ⁻¹ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X) ((σ * s * σ⁻¹) x) =
      s ((σ⁻¹ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X) x)
    simp [AlgEquiv.mul_apply]

/-- An inertia element of `H` is (the restriction of) an inertia element of `Gal(Ω/F k̄)`, lying
in the kernel of `ρ̄`. -/
theorem exists_rhoBar_eq_one_of_SAll {s : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X}
    (hs : s ∈ SAll (curveGaloisData k hτ)) :
    ∃ σ : (barData k hτ).H, rhoBar hτ σ = 1 ∧
      ∀ x, (σ : FFClosure X ≃ₐ[K₀ (kbar k (FFClosure X)) (coordT τ)] FFClosure X) x = s x := by
  obtain ⟨hsH, W, hkW, hsW⟩ := hs
  have hfix : ∀ x ∈ kbar k (FFClosure X), s x = x := fun x hx =>
    inertia_fix_algebraic hkW hsW (mem_algebraicClosure_iff.mp hx)
  obtain ⟨σ, hσ⟩ := exists_resK₀_eq hfix
  have hσH : σ ∈ (barData k hτ).H := by
    rw [mem_baseChange_H, hσ]
    exact hsH
  refine ⟨⟨σ, hσH⟩, ?_, fun x => by rw [← hσ]; rfl⟩
  have hker := (genericL_spec (barData k hτ) (baseChangeKbar k X) (barEquivL k hτ)
    (barEquivL_algebraMap k hτ) (barData_H_le k hτ) (barEquivL_tau k hτ) ⊤ (by simp)).1
  rw [← MonoidHom.mem_ker, hker]
  refine Subgroup.mem_subgroupOf.2 (Subgroup.le_topologicalClosure _
    (Subgroup.subset_closure ⟨1, (barData k hτ).H.one_mem, σ, ?_, by simp⟩))
  refine (mem_SU_iff _ _ _ ⊤ σ).2 ⟨hσH, W, isCentredOn_top_of (barEquivL_algebraMap k hτ)
    fun c => kbar_mem W hkW c, ?_⟩
  intro a ha
  have := hsW a ha
  rwa [← hσ] at this

/-- **`ker ρ ⊆ ker ρ̄`** in their action on `Ω`: an element fixed by `ker ρ̄` is fixed by
`ker ρ`. -/
theorem isFix_rhoPi_of_isFix_rhoBar {f : FFClosure X} (hf : IsFix (rhoBar hτ) f) :
    IsFix (rhoPi (curveGaloisData k hτ)) f := by
  intro σ hσ
  let St : Subgroup (FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X) :=
    MulAction.stabilizer _ f
  have hcl : IsClosed (St : Set (FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X)) :=
    Subgroup.isClosed_of_isOpen _ (stabilizer_isOpen_of_isIntegral f)
  have hle :
      GaloisPi1.ambientKernel (curveGaloisData k hτ).H (SAll (curveGaloisData k hτ)) ≤ St := by
    refine Subgroup.topologicalClosure_minimal _ ((Subgroup.closure_le _).2 ?_) hcl
    rintro _ ⟨g, hg, s, hs, rfl⟩
    have hgs := conj_mem_SAll_H (D := (curveGaloisData k hτ)) ⟨g, hg⟩ hs
    obtain ⟨σ'', hσ'1, hσ''⟩ := exists_rhoBar_eq_one_of_SAll hτ hgs
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
    have := hf σ'' (MonoidHom.mem_ker.2 hσ'1)
    rw [Subgroup.smul_def, AlgEquiv.smul_def, hσ''] at this
    exact this
  have hσ' : (σ : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X) ∈
      GaloisPi1.ambientKernel (curveGaloisData k hτ).H (SAll (curveGaloisData k hτ)) := by
    have : σ ∈ GaloisPi1.kernel (curveGaloisData k hτ).H (SAll (curveGaloisData k hτ)) :=
      (QuotientGroup.eq_one_iff σ).1 (MonoidHom.mem_ker.1 hσ)
    exact Subgroup.mem_subgroupOf.1 this
  exact hle hσ'

/-- **`ker ρ̄ ⊆ ker ρ`**: an element fixed by `ker ρ` is fixed by `ker ρ̄`. -/
theorem isFix_rhoBar_of_isFix_rhoPi {f : FFClosure X}
    (hf : IsFix (rhoPi (curveGaloisData k hτ)) f) : IsFix (rhoBar hτ) f := by
  intro σ hσ
  have hker := (genericL_spec (barData k hτ) (baseChangeKbar k X) (barEquivL k hτ)
    (barEquivL_algebraMap k hτ) (barData_H_le k hτ) (barEquivL_tau k hτ) ⊤ (by simp)).1
  rw [hker] at hσ
  have hσ' : σ ∈ GaloisPi1.kernel (barData k hτ).H (SAll (barData k hτ)) := by
    refine Subgroup.mem_subgroupOf.2 ?_
    refine GaloisPi1.ambientKernel_mono le_rfl (fun s hs => ?_) (Subgroup.mem_subgroupOf.1 hσ)
    obtain ⟨hsH, W, hkW, -, hsW⟩ := hs
    exact ⟨hsH, W, hkW, hsW⟩
  have h1 := bcToDeltaTilde_mem_kernel (D := curveGaloisData k hτ) hσ'
  have h2 := hf _ ((QuotientGroup.eq_one_iff _).2 h1)
  exact h2

theorem isFix_rhoPi_iff {f : FFClosure X} :
    IsFix (rhoPi (curveGaloisData k hτ)) f ↔ IsFix (rhoBar hτ) f :=
  ⟨isFix_rhoBar_of_isFix_rhoPi hτ, isFix_rhoPi_of_isFix_rhoBar hτ⟩

/-! ### Arithmetic and geometric representatives -/

variable {n : ℕ} [NeZero n]

/-- **An arithmetic representative is a geometric one** (for `X_{k̄}`). -/
theorem IsArithRep.toIsChernRepDiv
    {E : Divisor (kbar k (FFClosure X)) (F (barData k hτ))} {f : FFClosure X}
    (hf : IsArithRep (curveGaloisData k hτ) n E f) :
    IsChernRepDiv (barData k hτ) (barEquivL k hτ) (barData_H_le k hτ) n E f where
  ne := hf.ne
  fix := isFix_rhoBar_of_isFix_rhoPi hτ hf.fix
  inv σ := by
    obtain ⟨g, hg, h⟩ := hf.inv ((bcToDeltaTilde (curveGaloisData k hτ) σ : deltaTilde _) :
      (curveGaloisData k hτ).H)
    exact ⟨g, isFix_rhoBar_of_isFix_rhoPi hτ hg, h⟩
  loc := hf.loc

/-- **A geometric representative of a `G_k`-invariant divisor is arithmetic.** -/
theorem isArithRep_of_isChernRepDiv
    {E : Divisor (kbar k (FFClosure X)) (F (barData k hτ))}
    (hE : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E = E) {f : FFClosure X}
    (hf : IsChernRepDiv (barData k hτ) (barEquivL k hτ) (barData_H_le k hτ) n E f) :
    IsArithRep (curveGaloisData k hτ) n E f where
  ne := hf.ne
  fix := isFix_rhoPi_of_isFix_rhoBar hτ hf.fix
  inv h := by
    have hm := IsChernRepDiv.map
      (h : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X).toRingEquiv (thetaH _ h).toMulEquiv
      (fun σ x ↦ by
        change h.1 (σ.1 x) = (thetaH _ h σ).1 (h.1 x)
        rw [thetaH_apply, AlgEquiv.symm_apply_apply])
      (thetaBar hτ h) (fun σ ↦ (thetaBar_rhoBar h σ).symm) (autF _ h) (fun _ ↦ rfl) hf
    rw [hE h] at hm
    obtain ⟨b, hb, _, hbe⟩ := hf.exists_eq_mul_pow (barEquivL_algebraMap k hτ)
      (barEquivL_tau k hτ) hm
    exact ⟨b, isFix_rhoPi_of_isFix_rhoBar hτ hb, hbe⟩
  loc := hf.loc

/-- **Every `G_k`-invariant divisor of `X_{k̄}` has an arithmetic representative** (genus
`≥ 1`). -/
theorem exists_isArithRep (hg : 0 < (curveGenus k X).toNat)
    (E : Divisor (kbar k (FFClosure X)) (F (barData k hτ)))
    (hE : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E = E) :
    ∃ f, IsArithRep (curveGaloisData k hτ) n E f := by
  obtain ⟨f, hf⟩ := exists_isChernRepDiv (barEquivL_algebraMap k hτ) (barEquivL_tau k hτ)
    (n := n) (hH := barData_H_le k hτ) (genus_bar_pos hg) E
  exact ⟨f, isArithRep_of_isChernRepDiv hτ hE hf⟩

/-- **The arithmetic Chern class does not depend on the representative.** -/
theorem IsArithRep.chern_eq {E : Divisor (kbar k (FFClosure X)) (F (barData k hτ))}
    {f f' : FFClosure X} (hf : IsArithRep (curveGaloisData k hτ) n E f)
    (hf' : IsArithRep (curveGaloisData k hτ) n E f') : hf.chern = hf'.chern := by
  obtain ⟨b, hb, hb0, rfl⟩ := (hf.toIsChernRepDiv hτ).exists_eq_mul_pow
    (barEquivL_algebraMap k hτ) (barEquivL_tau k hτ) (hf'.toIsChernRepDiv hτ)
  exact (chernArith_mul_pow hf.toKummerInv (isFix_rhoPi_of_isFix_rhoBar hτ hb) hb0
    hf'.toKummerInv).symm

/-- The product of representatives of `E`, `E'` represents `E + E'`. -/
theorem IsArithRep.mul {E E' : Divisor (kbar k (FFClosure X)) (F (barData k hτ))}
    (hE : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E = E)
    (hE' : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E' = E')
    {f f' : FFClosure X} (hf : IsArithRep (curveGaloisData k hτ) n E f)
    (hf' : IsArithRep (curveGaloisData k hτ) n E' f') :
    IsArithRep (curveGaloisData k hτ) n (E + E') (f * f') :=
  isArithRep_of_isChernRepDiv hτ (fun h => by rw [map_add, hE h, hE' h])
    ((hf.toIsChernRepDiv hτ).mul (hf'.toIsChernRepDiv hτ))

variable (n) in
/-- **The arithmetic first Chern class** `c^{ar}(E) ∈ H²(Π_X, μ_n)` of a `G_k`-invariant
divisor `E` of `X_{k̄}` (genus `≥ 1`): the Kummer boundary of any representative. -/
noncomputable def c1Arith (hg : 0 < (curveGenus k X).toNat)
    (E : Divisor (kbar k (FFClosure X)) (F (barData k hτ)))
    (hE : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E = E) :
    ContH2 (PiX (curveGaloisData k hτ)) (Mu n (FFClosure X)) :=
  (exists_isArithRep hτ (n := n) hg E hE).choose_spec.chern

theorem c1Arith_eq (hg : 0 < (curveGenus k X).toNat)
    {E : Divisor (kbar k (FFClosure X)) (F (barData k hτ))}
    (hE : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E = E) {f : FFClosure X}
    (hf : IsArithRep (curveGaloisData k hτ) n E f) : c1Arith hτ n hg E hE = hf.chern :=
  IsArithRep.chern_eq hτ _ hf

/-- **`c^{ar}` is additive.** -/
theorem c1Arith_add (hg : 0 < (curveGenus k X).toNat)
    {E E' : Divisor (kbar k (FFClosure X)) (F (barData k hτ))}
    (hE : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E = E)
    (hE' : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) E' = E')
    (hEE' : ∀ h : (curveGaloisData k hτ).H, divMap (autF _ h) (E + E') = E + E') :
    c1Arith hτ n hg (E + E') hEE' = c1Arith hτ n hg E hE * c1Arith hτ n hg E' hE' := by
  obtain ⟨f, hf⟩ := exists_isArithRep hτ (n := n) hg E hE
  obtain ⟨f', hf'⟩ := exists_isArithRep hτ (n := n) hg E' hE'
  rw [c1Arith_eq hτ hg hE hf, c1Arith_eq hτ hg hE' hf',
    c1Arith_eq hτ hg hEE' (hf.mul hτ hE hE' hf')]
  exact chernArith_mul hf.toKummerInv hf'.toKummerInv _

/-! ### Restriction to `Δ_X`: comparison with MR5's `c1Div` -/

/-- `κ : Gal(Ω/F k̄) ≅ Δ̃ ⊆ H`. -/
noncomputable def kappaBar : (barData k hτ).H →* (curveGaloisData k hτ).H :=
  (deltaTilde (curveGaloisData k hτ)).subtype.comp (bcToDeltaTilde (curveGaloisData k hτ))

set_option synthInstance.maxHeartbeats 400000 in
-- the group structure of the quotient `Π_X` is slow to synthesize
theorem rhoPi_kappaBar_eq_one {σ : (barData k hτ).H} (hσ : rhoBar hτ σ = 1) :
    rhoPi (curveGaloisData k hτ) (kappaBar hτ σ) = 1 := by
  have hker := (genericL_spec (barData k hτ) (baseChangeKbar k X) (barEquivL k hτ)
    (barEquivL_algebraMap k hτ) (barData_H_le k hτ) (barEquivL_tau k hτ) ⊤ (by simp)).1
  rw [← MonoidHom.mem_ker, hker] at hσ
  have hσ' : σ ∈ GaloisPi1.kernel (barData k hτ).H (SAll (barData k hτ)) := by
    refine Subgroup.mem_subgroupOf.2 ?_
    refine GaloisPi1.ambientKernel_mono le_rfl (fun s hs => ?_) (Subgroup.mem_subgroupOf.1 hσ)
    obtain ⟨hsH, W, hkW, -, hsW⟩ := hs
    exact ⟨hsH, W, hkW, hsW⟩
  exact (QuotientGroup.eq_one_iff _).2 (bcToDeltaTilde_mem_kernel (D := curveGaloisData k hτ) hσ')

set_option synthInstance.maxHeartbeats 400000 in
-- the group structure of the quotient `Π_X` is slow to synthesize
/-- **`ι : Δ_X → Π_X`** (`Δ_X = DeltaBarX k hτ = π₁ᵉᵗ(X_{k̄})`), induced by `κ`. -/
noncomputable def iotaBar : DeltaBarX k hτ →* PiX (curveGaloisData k hτ) :=
  (rhoBar hτ).liftOfSurjective rhoBar_surjective
    ⟨(rhoPi (curveGaloisData k hτ)).comp (kappaBar hτ), fun _ hσ => rhoPi_kappaBar_eq_one hτ hσ⟩

theorem iotaBar_rhoBar (σ : (barData k hτ).H) :
    iotaBar hτ (rhoBar hτ σ) = rhoPi (curveGaloisData k hτ) (kappaBar hτ σ) :=
  MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ σ

theorem continuous_iotaBar : Continuous (iotaBar hτ) := by
  refine continuous_def.2 fun U hU => isOpen_of_rhoBar _ ?_
  have h : rhoBar hτ ⁻¹' (iotaBar hτ ⁻¹' U) =
      (fun σ => rhoPi (curveGaloisData k hτ) (kappaBar hτ σ)) ⁻¹' U := by
    ext σ
    simp only [Set.mem_preimage, iotaBar_rhoBar]
  rw [h]
  refine hU.preimage ?_
  exact QuotientGroup.continuous_mk.comp
    (continuous_subtype_val.comp (continuous_bcToDeltaTilde (D := curveGaloisData k hτ)))

/-- `ι(Δ_X)` acts trivially on `μ_n`. -/
theorem iotaBar_smul_mu (γ : DeltaBarX k hτ) (ζ : Mu n (FFClosure X)) :
    iotaBar hτ γ • ζ = ζ := by
  obtain ⟨σ, rfl⟩ := rhoBar_surjective (hτ := hτ) γ
  rw [iotaBar_rhoBar]
  apply Mu.ext
  apply Units.ext
  rw [ArithChern.rhoPi_smul_mu]
  change (bcToDeltaTilde (curveGaloisData k hτ) σ : (curveGaloisData k hτ).H) • _ = _
  exact deltaTilde_fixes_kbar _ (SemiAb.mem_kbar ζ)

attribute [local instance] instTrivMu in
/-- **`ι^* c^{ar}(E) = c₁(E_{k̄})`**: the restriction of the arithmetic Chern class to the geometric
fundamental group is MR5's first Chern class `c1Div` of `E` on `X_{k̄}` (in `ContH2` via
`h2lcToContH2`). -/
theorem map_iotaBar_chern {E : Divisor (kbar k (FFClosure X)) (F (barData k hτ))}
    {f : FFClosure X} (hg : 0 < (curveGenus k X).toNat)
    (hf : IsArithRep (curveGaloisData k hτ) n E f) :
    ContH2.map (iotaBar hτ) (continuous_iotaBar hτ) (MonoidHom.id _)
      (fun γ ζ => (iotaBar_smul_mu hτ γ ζ).trans rfl) hf.chern =
      h2lcToContH2 (Additive.toMul (c1Div (barData_H_le k hτ) (barEquivL_algebraMap k hτ)
        (barEquivL_tau k hτ) n (genus_bar_pos hg) E)) := by
  rw [c1Div_eq (barEquivL_algebraMap k hτ) (barEquivL_tau k hτ) (genus_bar_pos hg)
    (hf.toIsChernRepDiv hτ), toMul_ofMul]
  have key := map_chernClassA (rhoPi_sPi (curveGaloisData k hτ))
    (rhoPi_smul_mu (n := n) (curveGaloisData k hτ)) (isOpen_stabilizer_H (curveGaloisData k hτ))
    (isOpen_of_rhoPi (curveGaloisData k hτ))
    (rhoX_sX (barData_H_le k hτ) (barEquivL_algebraMap k hτ) (barEquivL_tau k hτ))
    (fun σ ζ ↦ (smul_eq_of_pow_eq_one (barData k hτ) n σ (by
      rw [← Units.val_pow_eq_pow_val, Mu.val_pow_n, Units.val_one])).symm)
    (isOpen_stabilizer (barData k hτ)) (isOpen_of_rhoBar (hτ := hτ)) (kappaBar hτ)
    (fun _ _ => rfl) (iotaBar hτ)
    (continuous_iotaBar hτ) (fun σ => (iotaBar_rhoBar hτ σ).symm)
    (fun σ hσ => rhoPi_kappaBar_eq_one hτ hσ) (fun γ ζ => (iotaBar_smul_mu hτ γ ζ).trans rfl)
    hf.toKummerInv (hf.toIsChernRepDiv hτ).toKummerInv
  exact key

end CurvesJacobian.LocAn.ArithChern
