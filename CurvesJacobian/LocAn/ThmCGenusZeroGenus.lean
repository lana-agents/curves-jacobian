import CurvesJacobian.LocAn.ThmCGenusZeroFinite

/-!
# Genus `0` descends along algebraic constant extensions (MR7 S3, [LocAn] Thm C, genus `0`)

Setting of `LocAn/ThmCConstExt.lean`: `D : GaloisData k t`, `char k = 0`, `K ⊆ Ω` algebraic over
`k`, `F_K = F (constExt K D)` the function field of `U_K` (over `K`) and
`F_{k̄} = F (baseChange D)` the function field of `X_{k̄}` (over `k̄`). We show

  **if `X_{k̄}` has genus `0` and `F_K` has a place of degree `1`, then `F_K` has genus `0`**

(`CurvesJacobian.LocAn.genus_constExt_eq_zero`), so that the genus-`0` case of Theorem C can be
stated with the geometric genus `genus (kbar k Ω) (F (baseChange D)) = 0`, as the genus `≥ 1`
case (`LocAn/ThmC.lean`).

Proof (descent of a coordinate). Let `P` be the place of degree `1` of `F_K` and `P'` a place of
`F_{k̄}` above it (`exists_place_liesOver`, via a valuation ring of `Ω` above `P`). Since
`F_{k̄}` has genus `0`, there is `w ∈ F_{k̄}` with a single simple pole at `P'`
(`exists_adjoin_eq_top_of_genus_eq_zero`). By infinite Galois theory `F_{k̄} = F_K · k̄`
(`mem_span_kbar_of_mem_F_baseChange`), so `w = ∑ᵢ fᵢ cᵢ` with `fᵢ ∈ F_K`, `cᵢ ∈ k̄`. Let `K'` be
the (finite, separable) extension of `K` generated by the `cᵢ`, `(b_j)` a `K`-basis of `K'` with
trace-dual basis `(d_j)`, and `g_j = ∑ᵢ (b_j-coordinate of cᵢ) fᵢ ∈ F_K`, so `w = ∑_j b_j g_j`.
Every `K`-embedding `φ : K' → k̄` is the restriction of some `σ_φ ∈ Gal(Ω/F_K)`
(`F_K` has constant field `K`, as it has a place of degree `1`, so `Gal(Ω/F_K) ↠ G_K`), whence
`g_j = ∑_φ φ(d_j) σ_φ(w)`. The poles of `σ_φ(w)` are simple and lie at `σ_φ(P')`, a place above
`P`; comparing valuations along `F_K ⊆ F_{k̄}` (`ord_ge_neg_one_of_liesOver`), every `g_j` has at
most a simple pole at `P` and no other pole. Some `g_j` is not constant (otherwise
`w ∈ k̄`), so `[F_K : K(g_j)] = 1` and `F_K` has genus `0`
(`genus_eq_zero_of_finrank_eq_one`).

Classically this is a special case of the invariance of the genus under separable algebraic
constant field extensions (Riemann–Roch spaces are compatible with such extensions); here only
the descent of a single function with a simple pole is needed.

## Main results

* `CurvesJacobian.LocAn.mem_F_baseChange_of_mem_F_constExt`: `F_K ⊆ F_{k̄}`;
* `CurvesJacobian.LocAn.mem_span_kbar_of_mem_F_baseChange`: `F_{k̄} = F_K · k̄`;
* `CurvesJacobian.LocAn.exists_place_liesOver`: places of `F_K` extend to `F_{k̄}`;
* `WeilCurves.FunctionField.ell_zero_eq_one_of_deg_eq_one`: a place of degree `1` forces
  `ℓ(0) = 1`;
* **`CurvesJacobian.LocAn.genus_constExt_eq_zero`**: `g(X_{k̄}) = 0` and a place of degree `1`
  give `genus K F_K = 0`;
* `CurvesJacobian.LocAn.placeOfF_eq_of_ratSectionGk_conj_genus_zero_constExt'` and its
  number-field / `p`-adic forms: Theorem C in genus `0` with the geometric genus hypothesis.
-/

open KummerTheory Curve AffOrbicurve IsLocalRing CurvesJacobian.Kummer WeilCurves.FunctionField
open scoped IntermediateField

namespace WeilCurves.FunctionField

variable {κ L : Type*} [Field κ] [Field L] [Algebra κ L] [PerfectField κ] [IsFunctionField κ L]

/-- At a place of degree `1`, every element algebraic over `κ` lies in `κ`. -/
theorem eq_algebraMap_of_isAlgebraic {P : Place κ L} (hP : P.deg = 1) {x : L}
    (hx : IsAlgebraic κ x) : ∃ a : κ, algebraMap κ L a = x := by
  have hxP : x ∈ P.1 := P.mem_of_isAlgebraic hx
  obtain ⟨a, ha⟩ := Place.exists_sub_mem_maximalIdeal hP ⟨x, hxP⟩
  refine ⟨a, ?_⟩
  by_contra hne
  have h0 : x - algebraMap κ L a ≠ 0 := sub_ne_zero.2 (Ne.symm hne)
  have hmem : x - algebraMap κ L a ∈ P.1 := sub_mem hxP (P.algebraMap_mem a)
  have hpos : 0 < P.ord (x - algebraMap κ L a) := by
    refine (P.ord_pos_iff_mem_maximalIdeal (a := ⟨_, hmem⟩) h0).2 ?_
    rw [← Place.residue_eq_zero_iff]
    have : (⟨_, hmem⟩ : P.1) = ⟨x, hxP⟩ - ⟨algebraMap κ L a, P.algebraMap_mem a⟩ := rfl
    rw [this, map_sub, ha, Place.residue_mk_algebraMap, sub_self]
  have halg : IsAlgebraic κ (x - algebraMap κ L a) := hx.sub (isAlgebraic_algebraMap a)
  rw [P.ord_eq_zero_of_isAlgebraic halg] at hpos
  exact lt_irrefl _ hpos

/-- **A place of degree `1` forces `ℓ(0) = 1`** (`κ` is the full constant field). -/
theorem ell_zero_eq_one_of_deg_eq_one {P : Place κ L} (hP : P.deg = 1) :
    Divisor.ell (0 : Divisor κ L) = 1 := by
  rw [Divisor.ell_zero, Subalgebra.finrank_eq_one_iff]
  refine eq_bot_iff.mpr fun y hy ↦ ?_
  obtain ⟨a, ha⟩ := eq_algebraMap_of_isAlgebraic hP (hy : IsIntegral κ y).isAlgebraic
  exact ⟨a, ha⟩

/-- If `ι x ∈ 𝒪_{Q'} ↔ x ∈ 𝒪_Q` along a field embedding `ι`, a pole of order `≥ 2` at `Q`
stays a pole of order `≥ 2` at `Q'`. -/
theorem ord_ge_neg_one_of_liesOver {κ' L' : Type*} [Field κ'] [Field L'] [Algebra κ' L']
    [PerfectField κ'] [IsFunctionField κ' L']
    (ι : L →+* L') {Q : Place κ L} {Q' : Place κ' L'} (hQ : ∀ x, ι x ∈ Q'.1 ↔ x ∈ Q.1) {x : L}
    (hx : -1 ≤ Q'.ord (ι x)) : -1 ≤ Q.ord x := by
  by_contra hlt
  push Not at hlt
  have hx0 : x ≠ 0 := by rintro rfl; rw [Q.ord_zero] at hlt; omega
  obtain ⟨π, hπ⟩ := Q.exists_ord_eq_one
  have hπ0 : π ≠ 0 := by rintro rfl; rw [Q.ord_zero] at hπ; omega
  have hιπ0 : ι π ≠ 0 := (map_ne_zero ι).2 hπ0
  have hιx0 : ι x ≠ 0 := (map_ne_zero ι).2 hx0
  -- `ord_{Q'}(ι π) ≥ 1`
  have hπ1 : 1 ≤ Q'.ord (ι π) := by
    have h1 : 0 ≤ Q'.ord (ι π) :=
      Q'.ord_nonneg_of_mem ((hQ π).2 (Q.mem_of_ord_nonneg (by omega)))
    have h2 : Q'.ord (ι π⁻¹) < 0 := by
      rw [Q'.ord_neg_iff, hQ, ← Q.ord_neg_iff, Q.ord_inv, hπ]; omega
    rw [map_inv₀, Q'.ord_inv] at h2
    omega
  -- `v = (x π²)⁻¹ ∈ 𝒪_Q`
  set v := (x * π ^ 2)⁻¹ with hv
  have hπ2 : π ^ 2 ≠ 0 := pow_ne_zero _ hπ0
  have hvQ : 0 ≤ Q.ord v := by
    rw [hv, Q.ord_inv, Q.ord_mul hx0 hπ2, Q.ord_pow, hπ]; push_cast; omega
  have hv' : 0 ≤ Q'.ord (ι v) := Q'.ord_nonneg_of_mem ((hQ v).2 (Q.mem_of_ord_nonneg hvQ))
  rw [hv, map_inv₀, map_mul, map_pow, Q'.ord_inv, Q'.ord_mul hιx0 (pow_ne_zero _ hιπ0),
    Q'.ord_pow] at hv'
  push_cast at hv'
  omega

end WeilCurves.FunctionField

namespace CurvesJacobian.LocAn

universe u

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  {D : Pi1.Orbifold.GaloisData k t} [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω]
  {K : IntermediateField k Ω} [Algebra.IsAlgebraic k K]

attribute [local instance] isFunctionField_F

omit [CharZero k] [IsAlgClosed Ω] in
/-- Elements of `K` lie in `k̄`. -/
lemma mem_kbar_of_mem_K {x : Ω} (hx : x ∈ K) : x ∈ kbar k Ω := by
  exact mem_algebraicClosure_iff.2
    ((Algebra.IsAlgebraic.isAlgebraic (⟨x, hx⟩ : K)).isIntegral.map K.val).isAlgebraic

omit [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic k K] in
/-- `k̄ ⊆ K̄`. -/
lemma mem_kbarK_of_mem_kbar {x : Ω} (hx : x ∈ kbar k Ω) : x ∈ kbar K Ω :=
  mem_algebraicClosure_iff.2
    ((mem_algebraicClosure_iff.1 hx).isIntegral.tower_top (A := K)).isAlgebraic

omit [CharZero k] [IsAlgClosed Ω] in
/-- **`F_K ⊆ F_{k̄}`.** -/
lemma mem_F_baseChange_of_mem_F_constExt {x : Ω} (hx : x ∈ F (constExt K D)) :
    x ∈ F (baseChange D) := by
  rw [IntermediateField.mem_fixedField_iff] at hx ⊢
  intro σ hσ
  have hfix : ∀ c : K, resK₀ k t σ (algebraMap K Ω c) = algebraMap K Ω c := fun c =>
    σ.commutes ⟨_, (K₀ (kbar k Ω) t).algebraMap_mem ⟨_, mem_kbar_of_mem_K c.2⟩⟩
  obtain ⟨σ', hσ'⟩ := exists_resK_eq (K := K) hfix
  have h1 := hx σ' ((mem_constExt_H D).2 (by rw [hσ']; exact (mem_baseChange_H D).1 hσ))
  have h2 := DFunLike.congr_fun hσ' x
  rw [resK_apply, resK₀_apply] at h2
  rw [← h2, h1]

variable (K D) in
/-- `F_K → F_{k̄}`. -/
def ιK : F (constExt K D) →+* F (baseChange D) where
  toFun u := ⟨u, mem_F_baseChange_of_mem_F_constExt u.2⟩
  map_one' := Subtype.ext rfl
  map_mul' _ _ := Subtype.ext rfl
  map_zero' := Subtype.ext rfl
  map_add' _ _ := Subtype.ext rfl

omit [CharZero k] [IsAlgClosed Ω] in
@[simp]
lemma coe_ιK (u : F (constExt K D)) : ((ιK D K u : F (baseChange D)) : Ω) = u :=
  Subtype.coe_mk _ _

omit [CharZero k] [IsAlgClosed Ω] in
/-- **`F_{k̄} = F_K · k̄`** (infinite Galois theory): every element of `F_{k̄}` is an
`F_K`-linear combination of elements of `k̄`. -/
lemma mem_span_kbar_of_mem_F_baseChange {x : Ω} (hx : x ∈ F (baseChange D)) :
    x ∈ Submodule.span (F (constExt K D)) (kbar k Ω : Set Ω) := by
  set FK := F (constExt K D)
  haveI : IsGalois FK Ω := IsGalois.tower_top_of_isGalois (K₀ K t) FK Ω
  set E : IntermediateField FK Ω := IntermediateField.adjoin FK (kbar k Ω : Set Ω)
  have hxE : x ∈ E := by
    rw [← InfiniteGalois.fixedField_fixingSubgroup E, IntermediateField.mem_fixedField_iff]
    intro σ hσ
    have hσk : ∀ y ∈ kbar k Ω, σ y = y := fun y hy =>
      (IntermediateField.mem_fixingSubgroup_iff _ _).1 hσ y
        (IntermediateField.subset_adjoin FK _ hy)
    let h : Ω ≃ₐ[K₀ k t] Ω := AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) fun y =>
      σ.commutes ⟨y, le_F_constExt D ((F D).algebraMap_mem y)⟩
    have hH : h ∈ D.H := by
      rw [← fixingSubgroup_F D]
      intro y
      exact σ.commutes ⟨y, le_F_constExt D y.2⟩
    exact fixes_F_baseChange D hH hσk hx
  have hE : E.toSubalgebra = Algebra.adjoin FK (kbar k Ω : Set Ω) :=
    IntermediateField.adjoin_toSubalgebra_of_isAlgebraic fun y hy =>
      (((mem_algebraicClosure_iff.1 hy).isIntegral.tower_top (A := K)).tower_top
        (A := FK)).isAlgebraic
  have hx' : x ∈ Subalgebra.toSubmodule (Algebra.adjoin FK (kbar k Ω : Set Ω)) := by
    rw [← hE]; exact hxE
  rw [Algebra.adjoin_eq_span] at hx'
  have hcl : Submonoid.closure (kbar k Ω : Set Ω) = (kbar k Ω).toSubalgebra.toSubmonoid :=
    Submonoid.closure_eq _
  rw [hcl] at hx'
  exact hx'

omit [CharZero k] [IsAlgClosed Ω] in
/-- **Places of `F_K` extend to `F_{k̄}`** (through a valuation ring of `Ω` above them). -/
lemma exists_place_liesOver (Q : Place K (F (constExt K D))) :
    ∃ Q' : Place (kbar k Ω) (F (baseChange D)), ∀ x, ιK D K x ∈ Q'.1 ↔ x ∈ Q.1 := by
  obtain ⟨W, hW⟩ := exists_valuationSubring_liesOver (constExt K D) Q
  have hK : ∀ c : K, algebraMap K Ω c ∈ W := fun c =>
    (hW (algebraMap K (F (constExt K D)) c)).2 (Q.algebraMap_mem c)
  let V : ValuationSubring (F (baseChange D)) := W.comap (algebraMap (F (baseChange D)) Ω)
  have hV : ∀ x, ιK D K x ∈ V ↔ x ∈ Q.1 := fun x => by
    change ((ιK D K x : F (baseChange D)) : Ω) ∈ W ↔ _
    rw [coe_ιK]
    exact hW x
  have hne : V ≠ ⊤ := by
    intro htop
    apply Q.ne_top
    refine top_unique fun x _ => (hV x).1 ?_
    rw [htop]
    trivial
  have hkb : ∀ c : kbar k Ω, algebraMap (kbar k Ω) (F (baseChange D)) c ∈ V := by
    intro c
    change (c : Ω) ∈ W
    exact KummerTheory.Curve.mem_of_isIntegral hK
      ((mem_algebraicClosure_iff.1 c.2).isIntegral.tower_top (A := K))
  exact ⟨⟨V, hne, hkb⟩, hV⟩

omit [CharZero k] [IsAlgClosed Ω] in
/-- `σ ∈ H_K` fixes `F_K` pointwise. -/
lemma apply_eq_of_mem_F_constExt (σ : (constExt K D).H) {x : Ω} (hx : x ∈ F (constExt K D)) :
    (σ : Ω ≃ₐ[K₀ K t] Ω) x = x :=
  (IntermediateField.mem_fixedField_iff _ _).1 hx σ σ.2

set_option synthInstance.maxHeartbeats 400000 in
-- `Module.IsTorsionFree K K̄` is found slowly
/-- **`G_K` is induced by `H_K`** on finite subextensions: if `F_K` has a place of degree `1`,
every `K`-embedding `K' → K̄` of a subextension `K' ⊆ K̄` is the restriction of some
`σ ∈ H_K`. -/
lemma exists_H_restrict {P : Place K (F (constExt K D))} (hP : P.deg = 1)
    {K' : IntermediateField K (kbar K Ω)} (φ : K' →ₐ[K] kbar K Ω) :
    ∃ σ : (constExt K D).H, ∀ y : K',
      (σ : Ω ≃ₐ[K₀ K t] Ω) ((y : kbar K Ω) : Ω) = ((φ y : kbar K Ω) : Ω) := by
  have hsurj : Function.Surjective (hToGk (constExt K D)) :=
    hToGk_surjective (D := constExt K D) fun x hx => by
      obtain ⟨a, ha⟩ := eq_algebraMap_of_isAlgebraic hP hx
      exact ⟨a, ha⟩
  let ψ : Gk K Ω := AlgEquiv.ofBijective (φ.liftNormal (kbar K Ω))
    (Algebra.IsAlgebraic.algHom_bijective _)
  obtain ⟨σ, hσ⟩ := hsurj ψ
  refine ⟨σ, fun y => ?_⟩
  rw [← algebraMap_hToGk_apply, hσ]
  change algebraMap (kbar K Ω) Ω (φ.liftNormal (kbar K Ω) (algebraMap K' (kbar K Ω) y)) = _
  rw [AlgHom.liftNormal_commutes]
  rfl

end CurvesJacobian.LocAn

namespace WeilCurves.FunctionField

/-- The trace-dual basis computes coordinates: `Tr(d_j y) = b_j^*(y)`. -/
theorem trace_dualBasis_mul {K L : Type*} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] {ι : Type*} [Finite ι] [DecidableEq ι]
    (b : Module.Basis ι K L) (j : ι) (y : L) :
    Algebra.trace K L
      ((Algebra.traceForm K L).dualBasis (traceForm_nondegenerate K L) b j * y) = b.repr y j := by
  have := Fintype.ofFinite ι
  conv_lhs => rw [← b.sum_repr y]
  rw [Finset.mul_sum, map_sum]
  have h := fun l => LinearMap.BilinForm.apply_dualBasis_left (traceForm_nondegenerate K L) b j l
  simp only [Algebra.traceForm_apply] at h
  simp only [mul_smul_comm, map_smul, smul_eq_mul, h, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true]

variable {κ L : Type*} [Field κ] [Field L] [Algebra κ L]

/-- The reduced divisor `∑_{Q ∈ T} Q` of a finite set of places. -/
noncomputable def indDiv (T : Finset (Place κ L)) : Divisor κ L := ∑ Q ∈ T, Finsupp.single Q 1

theorem indDiv_apply [DecidableEq (Place κ L)] (T : Finset (Place κ L)) (Q : Place κ L) :
    indDiv T Q = if Q ∈ T then 1 else 0 := by
  classical
  simp only [indDiv, Finsupp.finsetSum_apply, Finsupp.single_apply]
  rw [Finset.sum_ite_eq']

theorem indDiv_nonneg (T : Finset (Place κ L)) (Q : Place κ L) :
    0 ≤ indDiv T Q ∧ indDiv T Q ≤ 1 := by
  classical
  rw [indDiv_apply]
  split_ifs <;> omega

variable [PerfectField κ] [IsFunctionField κ L]

open CurvesJacobian.Kummer in
/-- If `w` has at most a simple pole at `P'` and no other pole, then `τ w` lies in `L(∑_{Q ∈ T} Q)`
for every finite set `T ∋ τ P'`. -/
theorem apply_mem_L_indDiv (τ : constAut κ L) {P' : Place κ L} {w : L} (hwP : -1 ≤ P'.ord w)
    (hwQ : ∀ Q : Place κ L, Q ≠ P' → 0 ≤ Q.ord w) {T : Finset (Place κ L)}
    (hT : placeMap τ P' ∈ T) : (τ : L ≃+* L) w ∈ Divisor.L (indDiv T) := by
  classical
  refine Divisor.mem_L.2 (Or.inr fun Q' => ?_)
  have hQ' : Q' = placeMap τ (placeMap τ⁻¹ Q') := by
    rw [← placeMap_mul, mul_inv_cancel, placeMap_one]
  have hord : Q'.ord ((τ : L ≃+* L) w) = (placeMap τ⁻¹ Q').ord w := by
    conv_lhs => rw [hQ']
    exact ord_placeMap_apply _ _ _
  rw [hord]
  by_cases h : placeMap τ⁻¹ Q' = P'
  · have hQT : Q' ∈ T := by rw [hQ', h]; exact hT
    rw [indDiv_apply, if_pos hQT, h]
    exact hwP
  · have := hwQ _ h
    have := (indDiv_nonneg T Q').1
    omega

end WeilCurves.FunctionField

namespace CurvesJacobian.LocAn

universe u

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  {D : Pi1.Orbifold.GaloisData k t} [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω]
  {K : IntermediateField k Ω} [Algebra.IsAlgebraic k K]

attribute [local instance] isFunctionField_F

omit [IsAlgClosed Ω] in
/-- **Regularity descends**: if `ι x ∈ L(∑_{Q' ∈ T} Q')` for a finite set `T` of places of
`F_{k̄}` above `P`, then `x ∈ F_K` has at most a simple pole at `P` and no other pole. -/
lemma ord_of_mem_L_indDiv {P : Place K (F (constExt K D))}
    {T : Finset (Place (kbar k Ω) (F (baseChange D)))}
    (hT : ∀ Q' ∈ T, ∀ x, ιK D K x ∈ Q'.1 ↔ x ∈ P.1) {x : F (constExt K D)}
    (hx : ιK D K x ∈ Divisor.L (indDiv T)) :
    -1 ≤ P.ord x ∧ ∀ Q : Place K (F (constExt K D)), Q ≠ P → 0 ≤ Q.ord x := by
  classical
  have hord : ∀ Q', -indDiv T Q' ≤ Q'.ord (ιK D K x) := by
    intro Q'
    rcases Divisor.mem_L.1 hx with h0 | h
    · rw [h0, Place.ord_zero]
      have := (indDiv_nonneg T Q').1
      omega
    · exact h Q'
  obtain ⟨P', hP'⟩ := exists_place_liesOver (D := D) P
  refine ⟨ord_ge_neg_one_of_liesOver (ιK D K) hP' (by
    have := hord P'; have := (indDiv_nonneg T P').2; omega), fun Q hQP => ?_⟩
  obtain ⟨Q', hQ'⟩ := exists_place_liesOver (D := D) Q
  have hQ'T : Q' ∉ T := by
    intro hm
    apply hQP
    apply Place.ext
    ext y
    rw [← hQ' y, hT Q' hm y]
  have h := hord Q'
  rw [indDiv_apply, if_neg hQ'T, neg_zero] at h
  exact Q.ord_nonneg_of_mem ((hQ' _).1 (Q'.mem_of_ord_nonneg h))

set_option maxHeartbeats 1000000 in
-- large `simp`/`ring` computations with sums over embeddings
/-- **Descent of a coordinate** (see the module docstring): if `X_{k̄}` has genus `0` and `P` is
a place of degree `1` of `F_K`, there is a non-constant `f ∈ F_K` whose only pole is a pole of
order `≤ 1` at `P`. -/
theorem exists_transcendental_of_genus_baseChange_eq_zero
    (hg : genus (kbar k Ω) (F (baseChange D)) = 0) {P : Place K (F (constExt K D))}
    (hP : P.deg = 1) :
    ∃ f : F (constExt K D), Transcendental K f ∧ -1 ≤ P.ord f ∧
      ∀ Q : Place K (F (constExt K D)), Q ≠ P → 0 ≤ Q.ord f := by
  classical
  -- a place `P'` above `P` and a coordinate `w` of `F_{k̄}` with a simple pole at `P'`
  obtain ⟨P', hP'⟩ := exists_place_liesOver (D := D) P
  obtain ⟨w, -, hwP, hwQ⟩ := exists_adjoin_eq_top_of_genus_eq_zero hg (Place.deg_eq_one P')
  -- `w = ∑ fᵢ cᵢ`
  obtain ⟨n, f, c, hwfc⟩ := Submodule.mem_span_set'.1
    (mem_span_kbar_of_mem_F_baseChange (K := K) (D := D) w.2)
  -- the finite extension `K' = K(cᵢ)`
  let c' : Fin n → kbar K Ω := fun i => ⟨c i, mem_kbarK_of_mem_kbar (c i).2⟩
  let K' : IntermediateField K (kbar K Ω) := IntermediateField.adjoin K (Set.range c')
  haveI : FiniteDimensional K K' := IntermediateField.finiteDimensional_adjoin fun x _ =>
    Algebra.IsIntegral.isIntegral x
  haveI : Module.Free K K' := Module.Free.of_divisionRing K K'
  haveI : Algebra.IsSeparable K K' := Algebra.IsSeparable.of_integral K K'
  let c'' : Fin n → K' := fun i => ⟨c' i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩
  let b := Module.finBasis K K'
  let d := (Algebra.traceForm K K').dualBasis (traceForm_nondegenerate K K') b
  let ev : K' →ₐ[K] Ω := (kbar K Ω).val.comp K'.val
  have hev : ∀ y : K', ev y = ((y : kbar K Ω) : Ω) := fun _ => rfl
  -- every `K`-embedding `K' → K̄` is induced by some `σ ∈ H_K`
  choose σ hσ using fun φ : K' →ₐ[K] kbar K Ω => exists_H_restrict (D := D) hP φ
  -- the functions `g_j ∈ F_K`
  let G : Fin (Module.finrank K K') → Ω := fun j =>
    ∑ i, (f i : Ω) * algebraMap K Ω (b.repr (c'' i) j)
  have hGmem : ∀ j, G j ∈ F (constExt K D) := fun j =>
    sum_mem fun i _ => mul_mem (f i).2 (algebraMap_mem_F_constExt D _)
  have hc : ∀ i, ((c i : Ω)) = ∑ j, algebraMap K Ω (b.repr (c'' i) j) * ev (b j) := by
    intro i
    have h := congrArg ev (b.sum_repr (c'' i))
    rw [map_sum] at h
    simp only [Algebra.smul_def] at h
    exact h.symm
  have hwG : (w : Ω) = ∑ j, ev (b j) * G j := by
    rw [← hwfc]
    simp only [Algebra.smul_def, hc, Finset.mul_sum, G]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
    change (f i : Ω) * _ = _
    ring
  have hσw : ∀ φ, (σ φ : Ω ≃ₐ[K₀ K t] Ω) (w : Ω) =
      ∑ i, (f i : Ω) * ((φ (c'' i) : kbar K Ω) : Ω) := by
    intro φ
    rw [← hwfc, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Algebra.smul_def, map_mul]
    change (σ φ : Ω ≃ₐ[K₀ K t] Ω) (f i : Ω) * (σ φ : Ω ≃ₐ[K₀ K t] Ω) ((c'' i : kbar K Ω) : Ω) = _
    rw [apply_eq_of_mem_F_constExt _ (f i).2, hσ]
  have hGtr : ∀ j, G j =
      ∑ φ, ((φ (d j) : kbar K Ω) : Ω) * (σ φ : Ω ≃ₐ[K₀ K t] Ω) (w : Ω) := by
    intro j
    simp only [hσw, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    have h := trace_eq_sum_embeddings (E := kbar K Ω) (K := K) (L := K') (x := d j * c'' i)
    rw [trace_dualBasis_mul] at h
    have h2 := congrArg (algebraMap (kbar K Ω) Ω) h
    rw [map_sum] at h2
    rw [← IsScalarTower.algebraMap_apply] at h2
    change (f i : Ω) * algebraMap K Ω (b.repr (c'' i) j) = _
    rw [h2, Finset.mul_sum]
    refine Finset.sum_congr rfl fun φ _ => ?_
    rw [map_mul]
    change ((f i : Ω)) * (((φ (d j) : kbar K Ω) : Ω) * ((φ (c'' i) : kbar K Ω) : Ω)) = _
    ring
  -- the action on `F_{k̄}`
  let τ : (K' →ₐ[K] kbar K Ω) → constAut (kbar k Ω) (F (baseChange D)) :=
    fun φ => autF D (hRes K D (σ φ))
  let T : Finset (Place (kbar k Ω) (F (baseChange D))) :=
    Finset.univ.image fun φ => CurvesJacobian.Kummer.placeMap (τ φ) P'
  have hT : ∀ Q' ∈ T, ∀ x, ιK D K x ∈ Q'.1 ↔ x ∈ P.1 := by
    intro Q' hm x
    obtain ⟨φ, -, rfl⟩ := Finset.mem_image.1 hm
    rw [← hP' x, CurvesJacobian.Kummer.mem_placeMap]
    have : (τ φ : F (baseChange D) ≃+* F (baseChange D)).symm (ιK D K x) = ιK D K x := by
      apply (τ φ : F (baseChange D) ≃+* F (baseChange D)).injective
      rw [RingEquiv.apply_symm_apply]
      apply Subtype.ext
      change ((ιK D K x : F (baseChange D)) : Ω) = (σ φ : Ω ≃ₐ[K₀ K t] Ω) (ιK D K x : Ω)
      rw [coe_ιK, apply_eq_of_mem_F_constExt _ x.2]
    rw [this]
  have hGL : ∀ j, ιK D K ⟨G j, hGmem j⟩ ∈ Divisor.L (indDiv T) := by
    intro j
    have : ιK D K ⟨G j, hGmem j⟩ =
        ∑ φ, algebraMap (kbar k Ω) (F (baseChange D))
          ⟨((φ (d j) : kbar K Ω) : Ω), mem_kbar_of_mem_kbarK _⟩ *
          (τ φ : F (baseChange D) ≃+* F (baseChange D)) w := by
      apply Subtype.ext
      rw [coe_ιK]
      change G j = _
      rw [hGtr j, IntermediateField.coe_sum]
      rfl
    rw [this]
    refine sum_mem fun φ _ => ?_
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ _ (apply_mem_L_indDiv (τ φ) hwP.ge hwQ
      (Finset.mem_image.2 ⟨φ, Finset.mem_univ _, rfl⟩))
  -- some `g_j` is not constant
  have hex : ∃ j, Transcendental K (⟨G j, hGmem j⟩ : F (constExt K D)) := by
    by_contra hall
    push Not at hall
    have hconst : ∀ j, ∃ a : K, algebraMap K (F (constExt K D)) a = ⟨G j, hGmem j⟩ := fun j =>
      eq_algebraMap_of_isAlgebraic hP (by simpa [Transcendental] using hall j)
    choose a ha using hconst
    have hGa : ∀ j, G j = algebraMap K Ω (a j) := fun j =>
      (congrArg (fun z : F (constExt K D) => (z : Ω)) (ha j)).symm
    have hwk : (w : Ω) ∈ kbar k Ω := by
      rw [hwG]
      refine sum_mem fun j _ => mul_mem ?_ ?_
      · exact mem_kbar_of_mem_kbarK (K := K) (b j : kbar K Ω)
      · rw [hGa]; exact mem_kbar_of_mem_K (a j).2
    have hwalg : IsAlgebraic (kbar k Ω) w := by
      have : w = algebraMap (kbar k Ω) (F (baseChange D)) ⟨w, hwk⟩ := Subtype.ext rfl
      rw [this]; exact isAlgebraic_algebraMap _
    rw [P'.ord_eq_zero_of_isAlgebraic hwalg] at hwP
    omega
  obtain ⟨j, hj⟩ := hex
  exact ⟨_, hj, ord_of_mem_L_indDiv hT (hGL j)⟩
/-- **Genus `0` descends to `F_K`**: if `X_{k̄}` has genus `0` and `F_K` has a place of degree
`1`, then `F_K` has genus `0` (over `K`). -/
theorem genus_constExt_eq_zero (hg : genus (kbar k Ω) (F (baseChange D)) = 0)
    {P : Place K (F (constExt K D))} (hP : P.deg = 1) : genus K (F (constExt K D)) = 0 := by
  classical
  obtain ⟨f, hft, hfP, hfQ⟩ := exists_transcendental_of_genus_baseChange_eq_zero hg hP
  have hell := ell_zero_eq_one_of_deg_eq_one hP
  have hsum := Place.sum_ord_mul_deg_poles f hft
  have hsub : (Place.finite_setOf_ord_neg (k := K) f).toFinset ⊆ {P} := fun Q hQm ↦ by
    simp only [Set.Finite.mem_toFinset, Set.mem_setOf_eq] at hQm
    rw [Finset.mem_singleton]
    by_contra hne
    exact absurd (hfQ Q hne) (not_le.2 hQm)
  have := finiteDimensional_adjoin hft
  have hpos : 0 < Module.finrank K⟮f⟯ (F (constExt K D)) := Module.finrank_pos
  rcases Finset.subset_singleton_iff.1 hsub with h | h
  · rw [h, Finset.sum_empty] at hsum
    omega
  rw [h, Finset.sum_singleton, hP] at hsum
  have h1 : Module.finrank K⟮f⟯ (F (constExt K D)) = 1 := by
    have : P.ord f = -1 := by push_cast at hsum; omega
    rw [this] at hsum
    push_cast at hsum
    omega
  exact genus_eq_zero_of_finrank_eq_one hell hft h1

