import CurvesJacobian.CuspChar.Count
import CurvesJacobian.CuspChar.Hyperplane
import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.Topology.Algebra.Group.Basic

/-!
# Continuous `ℤ/p`-characters of open subgroups and transport of cusp lines (G2, applied)

Let `Δ` be a topological group, `S` a conjugation-stable set of self-normalising procyclic
subgroups ("cusp groups"), and `H ⊆ Δ` an open subgroup. The continuous characters `H → ℤ/p`
form an `𝔽_p`-vector space `V_p(H)` (`CurvesJacobian.CuspChar.charSpace`). Every cusp `y` of `H`
determines a linear form on `V_p(H)`: evaluation at a generator of `I_y ∩ ⟨a_y⟩` (`I_y = cl⟨a_y⟩`),
which vanishes exactly on the characters unramified at `y`
(`CurvesJacobian.CuspChar.exists_gen`).

Main result (`CurvesJacobian.CuspChar.transport_sameLine`): if a topological isomorphism
`Φ : Δ ≃ₜ* Δ'` is **numerically cuspidal** (`r(H) = r'(Φ H)` for every open `H`), and an element
`b ∈ H` spans the same line as some cusp of `H` (`SameLine`: the characters killing `b` are exactly
those unramified at `y`, and some character does not kill `b`), then `Φ b` spans the same line as
some cusp of `Φ H`. This is the hyperplane-counting step G2 of the replacement proof of
[CombGC] Thm 1.6 (i) used for [AbsTopI] Lemma 4.5 (v) (see `MR3-plan.md`).
-/

namespace CurvesJacobian.CuspChar

open Module

variable {Δ : Type*} [Group Δ] [TopologicalSpace Δ] [IsTopologicalGroup Δ]

section CharSpace

variable (p : ℕ) (H : OpenSubgroup Δ)

/-- The **continuous characters** `H → ℤ/p` (those with open kernel). -/
def charSpace : Submodule (ZMod p) (Additive (H : Subgroup Δ) →+ ZMod p) where
  carrier := {ξ | IsOpen (kerSub (H : Subgroup Δ) ξ : Set Δ)}
  zero_mem' := by
    have : kerSub (H : Subgroup Δ) (0 : Additive (H : Subgroup Δ) →+ ZMod p) = H := by
      ext x
      exact ⟨fun ⟨hx, _⟩ ↦ hx, fun hx ↦ ⟨hx, rfl⟩⟩
    change IsOpen (kerSub (H : Subgroup Δ) 0 : Set Δ)
    rw [this]
    exact H.isOpen
  add_mem' := by
    intro ξ η hξ hη
    refine Subgroup.isOpen_mono (H₁ := kerSub (H : Subgroup Δ) ξ ⊓ kerSub (H : Subgroup Δ) η)
      ?_ (hξ.inter hη)
    rintro x ⟨⟨hx, e1⟩, ⟨_, e2⟩⟩
    exact ⟨hx, by rw [AddMonoidHom.add_apply, e1, e2, add_zero]⟩
  smul_mem' := by
    intro c ξ hξ
    refine Subgroup.isOpen_mono (H₁ := kerSub (H : Subgroup Δ) ξ) ?_ hξ
    rintro x ⟨hx, e⟩
    exact ⟨hx, by rw [AddMonoidHom.smul_apply, e, smul_zero]⟩

variable {p H}

/-- Evaluation of characters at an element of `H`, as a linear form on `charSpace p H`. -/
def evAt (b : Δ) (hb : b ∈ H) : Dual (ZMod p) (charSpace p H) where
  toFun ξ := ξ.1 (Additive.ofMul ⟨b, hb⟩)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

lemma evAt_apply {b : Δ} (hb : b ∈ H) (ξ : charSpace p H) :
    evAt b hb ξ = ξv (H : Subgroup Δ) ξ.1 b := by
  rw [ξv_of_mem hb]
  rfl

end CharSpace

section Gen

variable {p : ℕ} {H : OpenSubgroup Δ}

/-- **A generator of `cl⟨a⟩ ∩ H` for continuous characters.** For `I = cl⟨a⟩` and `H` open, some
`c ∈ I ∩ H` is killed by a continuous character `ξ` iff `ξ` kills `I ∩ H`. -/
lemma exists_gen (a : Δ) :
    ∃ c, c ∈ (Subgroup.zpowers a).topologicalClosure ∧ c ∈ (H : Subgroup Δ) ∧
      ∀ ξ : charSpace p H, ξv (H : Subgroup Δ) ξ.1 c = 0 ↔
        ∀ x ∈ (Subgroup.zpowers a).topologicalClosure, x ∈ (H : Subgroup Δ) →
          ξv (H : Subgroup Δ) ξ.1 x = 0 := by
  -- `⟨a⟩ ∩ H` is cyclic, generated by some `c`
  set Z := Subgroup.zpowers a ⊓ (H : Subgroup Δ)
  have hcyc : IsCyclic (Z.subgroupOf (Subgroup.zpowers a)) := Subgroup.isCyclic _
  obtain ⟨g, hg⟩ := hcyc.exists_generator
  set c : Δ := ((g : Subgroup.zpowers a) : Δ)
  have hcZ : c ∈ Z := by
    have := g.2
    rwa [Subgroup.mem_subgroupOf] at this
  have hZ : ∀ x ∈ Z, x ∈ Subgroup.zpowers c := by
    intro x hx
    have hx' : (⟨x, hx.1⟩ : Subgroup.zpowers a) ∈ Z.subgroupOf (Subgroup.zpowers a) := by
      rw [Subgroup.mem_subgroupOf]
      exact hx
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.1 (hg ⟨_, hx'⟩)
    refine Subgroup.mem_zpowers_iff.2 ⟨n, ?_⟩
    have := congrArg (fun z : Z.subgroupOf (Subgroup.zpowers a) ↦ ((z : Subgroup.zpowers a) : Δ)) hn
    simpa [c] using this
  refine ⟨c, Subgroup.le_topologicalClosure _ hcZ.1, hcZ.2, fun ξ ↦ ⟨fun hc x hx hxH ↦ ?_,
    fun h ↦ h c (Subgroup.le_topologicalClosure _ hcZ.1) hcZ.2⟩⟩
  -- the kernel of `ξ` is an open, hence closed, subgroup containing `⟨a⟩ ∩ H`
  have hopen : IsOpen (kerSub (H : Subgroup Δ) ξ.1 : Set Δ) := ξ.2
  have hclosed := Subgroup.isClosed_of_isOpen _ hopen
  have hZker : (Z : Set Δ) ⊆ kerSub (H : Subgroup Δ) ξ.1 := by
    intro z hz
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hZ z hz)
    refine (kerSub (H : Subgroup Δ) ξ.1).zpow_mem (mem_kerSub_iff.2 ⟨hcZ.2, hc⟩) n
  have hxcl : x ∈ closure (Z : Set Δ) := by
    have := H.isOpen.inter_closure ⟨hxH, hx⟩
    simpa [Z, Set.inter_comm] using this
  exact (mem_kerSub_iff.1 (closure_minimal hZker hclosed hxcl)).2

end Gen

section Transport

variable {Δ' : Type*} [Group Δ'] [TopologicalSpace Δ'] [IsTopologicalGroup Δ']
  {p : ℕ}

/-- The image `Φ(H)` of an open subgroup under a topological isomorphism. -/
def mapOpenSub (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ) : OpenSubgroup Δ' where
  toSubgroup := (H : Subgroup Δ).map Φ.toMulEquiv.toMonoidHom
  isOpen' := Φ.toHomeomorph.isOpenMap _ H.isOpen

omit [IsTopologicalGroup Δ] [IsTopologicalGroup Δ'] in
lemma mem_mapOpenSub {Φ : Δ ≃ₜ* Δ'} {H : OpenSubgroup Δ} {x : Δ} :
    Φ x ∈ (mapOpenSub Φ H : Subgroup Δ') ↔ x ∈ (H : Subgroup Δ) := by
  change Φ x ∈ (H : Subgroup Δ).map Φ.toMulEquiv.toMonoidHom ↔ _
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨y, hy, e⟩
    have : y = x := Φ.injective e
    exact this ▸ hy
  · exact fun hx ↦ ⟨x, hx, rfl⟩

/-- Restriction of `Φ` to `H → Φ(H)`, additively. -/
def resHom (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ) :
    Additive (H : Subgroup Δ) →+ Additive (mapOpenSub Φ H : Subgroup Δ') where
  toFun h := Additive.ofMul ⟨Φ (Additive.toMul h).1, mem_mapOpenSub.2 (Additive.toMul h).2⟩
  map_zero' := by
    apply Additive.toMul.injective
    ext
    simp
  map_add' h k := by
    apply Additive.toMul.injective
    ext
    simp

/-- Pull back a character of `Φ(H)` to `H`. -/
def pullChar (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ)
    (ξ : Additive (mapOpenSub Φ H : Subgroup Δ') →+ ZMod p) :
    Additive (H : Subgroup Δ) →+ ZMod p :=
  ξ.comp (resHom Φ H)

omit [IsTopologicalGroup Δ] [IsTopologicalGroup Δ'] in
lemma ξv_pullChar (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ)
    (ξ : Additive (mapOpenSub Φ H : Subgroup Δ') →+ ZMod p) (x : Δ) :
    ξv (H : Subgroup Δ) (pullChar Φ H ξ) x = ξv (mapOpenSub Φ H : Subgroup Δ') ξ (Φ x) := by
  by_cases hx : x ∈ (H : Subgroup Δ)
  · rw [ξv_of_mem hx, ξv_of_mem (mem_mapOpenSub.2 hx)]
    rfl
  · have hx' : Φ x ∉ (mapOpenSub Φ H : Subgroup Δ') := fun h ↦ hx (mem_mapOpenSub.1 h)
    simp [ξv, hx, hx']

omit [IsTopologicalGroup Δ] [IsTopologicalGroup Δ'] in
lemma kerSub_pullChar (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ)
    (ξ : Additive (mapOpenSub Φ H : Subgroup Δ') →+ ZMod p) :
    kerSub (H : Subgroup Δ) (pullChar Φ H ξ) =
      (kerSub (mapOpenSub Φ H : Subgroup Δ') ξ).comap Φ.toMulEquiv.toMonoidHom := by
  ext x
  simp only [Subgroup.mem_comap, mem_kerSub_iff, ξv_pullChar]
  change _ ↔ Φ x ∈ (mapOpenSub Φ H : Subgroup Δ') ∧ _
  rw [mem_mapOpenSub]
  exact Iff.rfl

omit [IsTopologicalGroup Δ] [IsTopologicalGroup Δ'] in
lemma map_kerSub_pullChar (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ)
    (ξ : Additive (mapOpenSub Φ H : Subgroup Δ') →+ ZMod p) :
    (kerSub (H : Subgroup Δ) (pullChar Φ H ξ)).map Φ.toMulEquiv.toMonoidHom =
      kerSub (mapOpenSub Φ H : Subgroup Δ') ξ := by
  rw [kerSub_pullChar, Subgroup.map_comap_eq_self_of_surjective Φ.surjective]

lemma pullChar_mem (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ)
    {ξ : Additive (mapOpenSub Φ H : Subgroup Δ') →+ ZMod p}
    (hξ : ξ ∈ charSpace p (mapOpenSub Φ H)) : pullChar Φ H ξ ∈ charSpace p H := by
  change IsOpen (kerSub (H : Subgroup Δ) (pullChar Φ H ξ) : Set Δ)
  rw [kerSub_pullChar]
  exact hξ.preimage Φ.continuous

/-- The pull-back of continuous characters along `Φ`, as a linear map. -/
def pullLin (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ) :
    charSpace p (mapOpenSub Φ H) →ₗ[ZMod p] charSpace p H where
  toFun ξ := ⟨pullChar Φ H ξ.1, pullChar_mem Φ H ξ.2⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

lemma pullLin_injective (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ) :
    Function.Injective (pullLin (p := p) Φ H) := by
  intro ξ η h
  apply Subtype.ext
  apply AddMonoidHom.ext
  intro z
  obtain ⟨y, hy⟩ := z
  obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hy
  have := congrArg (fun ζ : charSpace p H ↦ ζ.1 (Additive.ofMul ⟨x, hx⟩)) h
  exact this

lemma pullLin_surjective (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ) :
    Function.Surjective (pullLin (p := p) Φ H) := by
  rintro ⟨ξ, hξ⟩
  -- push `ξ` forward along `Φ⁻¹`
  let back : Additive (mapOpenSub Φ H : Subgroup Δ') →+ Additive (H : Subgroup Δ) :=
    { toFun := fun h ↦ Additive.ofMul ⟨Φ.symm (Additive.toMul h).1, by
        obtain ⟨x, hx, e⟩ := Subgroup.mem_map.1 (Additive.toMul h).2
        have hxe : Φ.symm (Additive.toMul h).1 = x := by
          rw [← e]
          exact Φ.symm_apply_apply x
        rw [hxe]
        exact hx⟩
      map_zero' := by
        apply Additive.toMul.injective
        ext
        simp
      map_add' := fun h k ↦ by
        apply Additive.toMul.injective
        ext
        simp }
  have hcomp : (resHom Φ H).comp back = AddMonoidHom.id _ := by
    ext h
    simp [resHom, back]
  have hcomp' : back.comp (resHom Φ H) = AddMonoidHom.id _ := by
    ext h
    simp [resHom, back]
  refine ⟨⟨ξ.comp back, ?_⟩, ?_⟩
  · change IsOpen (kerSub (mapOpenSub Φ H : Subgroup Δ') (ξ.comp back) : Set Δ')
    have hk : kerSub (mapOpenSub Φ H : Subgroup Δ') (ξ.comp back) =
        (kerSub (H : Subgroup Δ) ξ).comap Φ.symm.toMulEquiv.toMonoidHom := by
      have h0 : pullChar Φ H (ξ.comp back) = ξ := by
        rw [pullChar, AddMonoidHom.comp_assoc, hcomp', AddMonoidHom.comp_id]
      ext y
      rw [Subgroup.mem_comap]
      change _ ↔ Φ.symm y ∈ kerSub (H : Subgroup Δ) ξ
      conv_rhs => rw [← h0, kerSub_pullChar, Subgroup.mem_comap]
      change _ ↔ Φ (Φ.symm y) ∈ _
      rw [Φ.apply_symm_apply]
    rw [hk]
    exact hξ.preimage Φ.symm.continuous
  · apply Subtype.ext
    change pullChar Φ H (ξ.comp back) = ξ
    rw [pullChar, AddMonoidHom.comp_assoc, hcomp', AddMonoidHom.comp_id]

/-- The pull-back of continuous characters along `Φ`, as a linear isomorphism. -/
noncomputable def pullEquiv (Φ : Δ ≃ₜ* Δ') (H : OpenSubgroup Δ) :
    charSpace p (mapOpenSub Φ H) ≃ₗ[ZMod p] charSpace p H :=
  LinearEquiv.ofBijective (pullLin Φ H) ⟨pullLin_injective Φ H, pullLin_surjective Φ H⟩

end Transport

end CurvesJacobian.CuspChar
