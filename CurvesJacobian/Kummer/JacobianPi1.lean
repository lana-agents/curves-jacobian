import CurvesJacobian.Galois.PiCharacters
import ContinuousKummerTheory.Curve.RationalSection

/-!
# The group-theoretic `Π_{J¹}`, the sections `t_x` and the classes `η_D`

Mochizuki, *Absolute anabelian cuspidalizations of proper hyperbolic curves* ([Cusp]), §2
(discussion before Prop. 2.3), as used in [AbsTopIII] Prop. 1.6(ii). Galois model of
`Galois/PiCharacters.lean`: `D : GaloisData k t`, `char k = 0`, `Ω` algebraically closed and
Galois over `k(t)`, `Π_X = H ⧸ ⟨⟨inertia⟩⟩` (`CurvesJacobian.PiX D`), `G_k = Gal(k̄/k)`.
Following [Cusp] §2, `Π_{J¹}` is **constructed group-theoretically** (no étale fundamental group
of the Jacobian or of the torsor `J¹` is used):

* `piXToGk : Π_X →* G_k` (restriction to `k̄`; inertia fixes `k̄`,
  `eq_of_mem_ambientKernel_SAll`), continuous, surjective if `k` is algebraically closed in `F`;
  `piUToPiX : Π_U →* Π_X` with `piXToGk ∘ piUToPiX = piToGk`;
* `DeltaX D = Δ_X = ker(Π_X → G_k)`, `commClosure D = \overline{[Δ_X, Δ_X]}` (closed, normal in
  `Π_X`), `PiJ1 D = Π_{J¹} = Π_X / \overline{[Δ_X, Δ_X]}`, `DeltaAb D = Δ_X^{ab}` (a compact
  Hausdorff commutative topological group);
* the exact sequence `1 → Δ_X^{ab} → Π_{J¹} → G_k → 1`: `deltaAbToPiJ1_injective`,
  `range_deltaAbToPiJ1` (range = kernel), `piJ1ToGk_surjective`; `deltaAbEquivKer` identifies
  `Δ_X^{ab}` with `ker(Π_{J¹} → G_k)` as topological groups;
* given `[Fact (Function.Surjective (piJ1ToGk D))]` (`fact_piJ1ToGk_surjective`), the action of
  `G_k` on `Δ_X^{ab}` by conjugation through any lift (`mulDistribMulAction_deltaAb`,
  `deltaAbToPiJ1_smul`), which is continuous (`continuousSMul_deltaAb`);
* continuous sections `J1Section D` of `Π_{J¹} ↠ G_k`, the difference cocycle
  `σ ↦ s(σ) s'(σ)⁻¹` (`diffCocycle`, a continuous `1`-cocycle) and its class
  `diffClass s s' ∈ H¹(G_k, Δ_X^{ab})` (`ContH1`, written multiplicatively), with
  `diffClass_mul` (`[s − s'] + [s' − s''] = [s − s'']`), `diffClass_self`, `diffClass_swap` and
  `diffClass_eq_one_of_conj` (sections conjugate by `Δ_X^{ab}` have the same class);
* `k`-rational points `RatPoint D` of `X` (places `A ⊇ k` of `Ω` with `κ(A ∩ F) = k`, cusps
  included), the section `xSection x : Gal(κ(A)/k) → Π_X` (`s_x`, descent of `D_A → Π_X`;
  `piXToGk_xSection`, `piUToPiX_ratSectionMap`: it is the image of continuous-kummer-theory's
  `ratSectionMap` for points of `U`), and **`tSection x : J1Section D`** (`t_x`, transported along
  `G_k ≅ Gal(κ(A)/k)`, `kbarEquiv`);
* for a divisor `f : RatPoint D →₀ ℤ` supported on rational points, `etaDiv f x₀ =
  ∑ nᵢ [t_{xᵢ} − t_{x₀}]` (`etaWith` for general families of sections), independent of `x₀` if
  `deg f = 0` (`etaDiv_eq`), and `eta f` (`eta_eq_etaDiv`): the class
  `η_D ∈ H¹(G_k, Δ_X^{ab})` of [Cusp] §2 (comparison of `t_D` with the identity section of
  `Π_{J⁰}`, by additivity of the difference classes).

**Not proved here**: [Cusp] Prop. 2.3(i), "`D` principal ⟺ `η_D = 0`" (equivalently
[AbsTopIII] Prop. 1.6(ii)). It needs the "general nonsense" isomorphism
`H¹(G_k, Δ_X^{ab}) ≅ J(k)^∧` from the Kummer sequences of `J`, mapping `η_D ↦ [D]`, i.e.
divisibility of `J(k̄)` (MR5 plan JAC-4a) and the identification `Δ_X^{ab}/n ≅ J[n]` through the
Weil pairing, compatible with `t_x t_y⁻¹ ↦` the Kummer cocycle of `[x − y]` (JAC-4b).
Distinct `RatPoint`s above the same point of `F` are distinct indices of the divisor group; their
sections `t_x` are `Δ_X^{ab}`-conjugate and have the same difference classes
(`Kummer/TSectionPlace.lean`: `exists_tSection_conj`, `diffClass_tSection_eq_one`).
-/

open KummerTheory Curve AffOrbicurve IsLocalRing

set_option linter.unusedSectionVars false

namespace CurvesJacobian.Kummer

universe u

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  (D : Pi1.Orbifold.GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω]

section PiX

/-- Shortcut instance (the group structure on the quotient `Π_X` is slow to synthesize). -/
noncomputable instance group_piX : Group (PiX D) := QuotientGroup.Quotient.group _

variable {D} in
/-- **The closed normal subgroup generated by all inertia groups fixes `k̄` pointwise.** -/
theorem eq_of_mem_ambientKernel_SAll {σ : Ω ≃ₐ[K₀ k t] Ω}
    (hσ : σ ∈ GaloisPi1.ambientKernel D.H (SAll D)) {x : Ω} (hx : IsAlgebraic k x) :
    σ x = x := by
  let St := MulAction.stabilizer (Ω ≃ₐ[K₀ k t] Ω) x
  have hcl : IsClosed (St : Set (Ω ≃ₐ[K₀ k t] Ω)) :=
    Subgroup.isClosed_of_isOpen _ (stabilizer_isOpen_of_isIntegral x)
  have hle : GaloisPi1.ambientKernel D.H (SAll D) ≤ St := by
    refine Subgroup.topologicalClosure_minimal _ ?_ hcl
    rw [Subgroup.closure_le]
    rintro _ ⟨h, -, s, hs, rfl⟩
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
    obtain ⟨-, W, hk, hinert⟩ := hs
    have hx' : IsAlgebraic k (h⁻¹ x) :=
      (hx.isIntegral.map ((h⁻¹ : Ω ≃ₐ[K₀ k t] Ω).restrictScalars k).toAlgHom).isAlgebraic
    simp only [AlgEquiv.mul_apply]
    rw [inertia_fix_algebraic hk hinert hx']
    exact h.apply_symm_apply x
  exact hle hσ

/-- **The arithmetic quotient `Π_X → G_k`** (restriction to the constants `k̄`). -/
noncomputable def piXToGk : PiX D →* Gk k Ω :=
  QuotientGroup.lift _ (hToGk D) fun σ hσ => by
    ext x
    change algebraMap (kbar k Ω) Ω (hToGk D σ x) = (x : Ω)
    rw [algebraMap_hToGk_apply]
    exact eq_of_mem_ambientKernel_SAll hσ (mem_algebraicClosure_iff.mp x.2)

@[simp]
theorem piXToGk_mk (h : D.H) : piXToGk D (h : PiX D) = hToGk D h := rfl

theorem continuous_piXToGk : Continuous (piXToGk D) :=
  (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr (continuous_hToGk D)

/-- `Π_X → G_k` is surjective when `k` is algebraically closed in `F`. -/
theorem piXToGk_surjective
    (hk : ∀ x : F D, IsAlgebraic k x → x ∈ Set.range (algebraMap k (F D))) :
    Function.Surjective (piXToGk D) := by
  intro g
  obtain ⟨h, rfl⟩ := hToGk_surjective D hk g
  exact ⟨h, rfl⟩

theorem S_subset_SAll : D.S ⊆ SAll D := fun _ hσ =>
  ⟨D.le hσ.1, hσ.2.choose, hσ.2.choose_spec.1, hσ.2.choose_spec.2.2⟩

/-- The projection `Π_U → Π_X` (all inertia groups, cusps included, are killed in `Π_X`). -/
noncomputable def piUToPiX : Pi D →* PiX D :=
  QuotientGroup.map _ _ (MonoidHom.id D.H) fun _ hσ =>
    GaloisPi1.ambientKernel_mono le_rfl (S_subset_SAll D) hσ

@[simp]
theorem piUToPiX_mk (h : D.H) : piUToPiX D (h : Pi D) = (h : PiX D) := rfl

theorem continuous_piUToPiX : Continuous (piUToPiX D) :=
  (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr QuotientGroup.continuous_mk

theorem piXToGk_piUToPiX (x : Pi D) : piXToGk D (piUToPiX D x) = piToGk D x := by
  induction x using QuotientGroup.induction_on with
  | H h => rw [piUToPiX_mk, piXToGk_mk, piToGk_mk]

instance compactSpace_H : CompactSpace D.H := GaloisPi1.compactSpace_of_isClosed _ D.isClosed_H

instance compactSpace_piX : CompactSpace (PiX D) := Quotient.compactSpace

end PiX

section PiJ1

/-- **`Δ_X = ker(Π_X → G_k)`**, the geometric fundamental group of `X`. -/
noncomputable def DeltaX : Subgroup (PiX D) := (piXToGk D).ker

instance normal_deltaX : (DeltaX D).Normal := MonoidHom.normal_ker _

instance isClosed_deltaX : IsClosed (DeltaX D : Set (PiX D)) :=
  (isClosed_singleton (x := (1 : Gk k Ω))).preimage (continuous_piXToGk D)

instance compactSpace_deltaX : CompactSpace (DeltaX D) :=
  isCompact_iff_compactSpace.mp (isClosed_deltaX D).isCompact

/-- The closed commutator subgroup `\overline{[Δ_X, Δ_X]}`, a closed normal subgroup of `Π_X`. -/
noncomputable def commClosure : Subgroup (PiX D) := ⁅DeltaX D, DeltaX D⁆.topologicalClosure

instance normal_commClosure : (commClosure D).Normal :=
  haveI : (⁅DeltaX D, DeltaX D⁆ : Subgroup (PiX D)).Normal := Subgroup.commutator_normal _ _
  Subgroup.is_normal_topologicalClosure _

instance isClosed_commClosure : IsClosed (commClosure D : Set (PiX D)) :=
  Subgroup.isClosed_topologicalClosure _

theorem commClosure_le : commClosure D ≤ DeltaX D :=
  Subgroup.topologicalClosure_minimal _ (Subgroup.commutator_le_left _ _) (isClosed_deltaX D)

/-- **`Π_{J¹} = Π_X / \overline{[Δ_X, Δ_X]}`** ([Cusp] §2: the fundamental group of the torsor
`J¹` of degree-one line bundles, constructed group-theoretically). -/
def PiJ1 : Type u := PiX D ⧸ commClosure D

noncomputable instance group_piJ1 : Group (PiJ1 D) :=
  inferInstanceAs (Group (PiX D ⧸ commClosure D))

instance topologicalSpace_piJ1 : TopologicalSpace (PiJ1 D) :=
  inferInstanceAs (TopologicalSpace (PiX D ⧸ commClosure D))

instance isTopologicalGroup_piJ1 : IsTopologicalGroup (PiJ1 D) :=
  inferInstanceAs (IsTopologicalGroup (PiX D ⧸ commClosure D))

instance t2Space_piJ1 : T2Space (PiJ1 D) :=
  inferInstanceAs (T2Space (PiX D ⧸ commClosure D))

instance compactSpace_piJ1 : CompactSpace (PiJ1 D) :=
  inferInstanceAs (CompactSpace (PiX D ⧸ commClosure D))

/-- `Π_X ↠ Π_{J¹}`. -/
noncomputable def piXToPiJ1 : PiX D →* PiJ1 D := QuotientGroup.mk' (commClosure D)

theorem piXToPiJ1_surjective : Function.Surjective (piXToPiJ1 D) :=
  QuotientGroup.mk'_surjective (commClosure D)

theorem piXToPiJ1_eq_one_iff (x : PiX D) : piXToPiJ1 D x = 1 ↔ x ∈ commClosure D :=
  QuotientGroup.eq_one_iff x

/-- `Π_{J¹} → G_k`. -/
noncomputable def piJ1ToGk : PiJ1 D →* Gk k Ω :=
  QuotientGroup.lift (commClosure D) (piXToGk D) fun _ hx => commClosure_le D hx

@[simp]
theorem piJ1ToGk_piXToPiJ1 (x : PiX D) : piJ1ToGk D (piXToPiJ1 D x) = piXToGk D x := rfl

theorem continuous_piXToPiJ1 : Continuous (piXToPiJ1 D) :=
  QuotientGroup.continuous_mk (N := commClosure D)

theorem isQuotientMap_piXToPiJ1 : Topology.IsQuotientMap (piXToPiJ1 D) :=
  QuotientGroup.isQuotientMap_mk (commClosure D)

theorem continuous_piJ1ToGk : Continuous (piJ1ToGk D) :=
  (isQuotientMap_piXToPiJ1 D).continuous_iff.mpr (continuous_piXToGk D)

/-- `Π_{J¹} → G_k` is surjective when `k` is algebraically closed in `F`. -/
theorem piJ1ToGk_surjective
    (hk : ∀ x : F D, IsAlgebraic k x → x ∈ Set.range (algebraMap k (F D))) :
    Function.Surjective (piJ1ToGk D) := by
  intro g
  obtain ⟨x, rfl⟩ := piXToGk_surjective D hk g
  exact ⟨piXToPiJ1 D x, rfl⟩

instance normal_subgroupOf_commClosure : ((commClosure D).subgroupOf (DeltaX D)).Normal :=
  Subgroup.normal_subgroupOf

/-- **`Δ_X^{ab} = Δ_X / \overline{[Δ_X, Δ_X]}`**. -/
def DeltaAb : Type u := DeltaX D ⧸ (commClosure D).subgroupOf (DeltaX D)

set_option synthInstance.maxHeartbeats 400000 in
-- `group` searches (and rejects) commutative structures on `Π_X`, which is slow
theorem deltaAb_mul_comm (a b : DeltaX D ⧸ (commClosure D).subgroupOf (DeltaX D)) :
    a * b = b * a := by
  induction a using QuotientGroup.induction_on with
  | H a =>
  induction b using QuotientGroup.induction_on with
  | H b =>
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq, Subgroup.mem_subgroupOf]
  refine Subgroup.le_topologicalClosure _ ?_
  have e : (a * b)⁻¹ * (b * a) = b⁻¹ * a⁻¹ * b⁻¹⁻¹ * a⁻¹⁻¹ := by group
  have h := Subgroup.commutator_mem_commutator (b⁻¹ : DeltaX D).2 (a⁻¹ : DeltaX D).2
  rw [commutatorElement_def] at h
  rw [e]
  simp only [Subgroup.coe_mul, Subgroup.coe_inv] at h ⊢
  exact h

/-- `Δ_X^{ab}` is commutative. -/
noncomputable instance commGroup_deltaAb : CommGroup (DeltaAb D) :=
  { toGroup := inferInstanceAs (Group (DeltaX D ⧸ (commClosure D).subgroupOf (DeltaX D)))
    mul_comm := deltaAb_mul_comm D }

instance topologicalSpace_deltaAb : TopologicalSpace (DeltaAb D) :=
  inferInstanceAs (TopologicalSpace (DeltaX D ⧸ (commClosure D).subgroupOf (DeltaX D)))

instance isTopologicalGroup_deltaAb : IsTopologicalGroup (DeltaAb D) :=
  inferInstanceAs (IsTopologicalGroup (DeltaX D ⧸ (commClosure D).subgroupOf (DeltaX D)))

instance compactSpace_deltaAb : CompactSpace (DeltaAb D) :=
  inferInstanceAs (CompactSpace (DeltaX D ⧸ (commClosure D).subgroupOf (DeltaX D)))

/-- `Δ_X ↠ Δ_X^{ab}`. -/
noncomputable def deltaAbMk : DeltaX D →* DeltaAb D :=
  QuotientGroup.mk' ((commClosure D).subgroupOf (DeltaX D))

theorem deltaAbMk_surjective : Function.Surjective (deltaAbMk D) :=
  QuotientGroup.mk'_surjective _

theorem deltaAbMk_eq_one_iff (x : DeltaX D) : deltaAbMk D x = 1 ↔ (x : PiX D) ∈ commClosure D :=
  (QuotientGroup.eq_one_iff x).trans Subgroup.mem_subgroupOf

/-- `Δ_X^{ab} → Π_{J¹}`. -/
noncomputable def deltaAbToPiJ1 : DeltaAb D →* PiJ1 D :=
  QuotientGroup.map ((commClosure D).subgroupOf (DeltaX D)) (commClosure D) (DeltaX D).subtype
    fun _ hx => hx

theorem deltaAbToPiJ1_deltaAbMk (x : DeltaX D) :
    deltaAbToPiJ1 D (deltaAbMk D x) = piXToPiJ1 D (x : PiX D) := rfl

theorem continuous_deltaAbToPiJ1 : Continuous (deltaAbToPiJ1 D) :=
  (QuotientGroup.isQuotientMap_mk ((commClosure D).subgroupOf (DeltaX D))).continuous_iff.mpr
    ((continuous_piXToPiJ1 D).comp continuous_subtype_val)

/-- **`Δ_X^{ab} → Π_{J¹}` is injective.** -/
theorem deltaAbToPiJ1_injective : Function.Injective (deltaAbToPiJ1 D) := by
  refine (injective_iff_map_eq_one _).2 fun y hy => ?_
  obtain ⟨x, rfl⟩ := deltaAbMk_surjective D y
  rw [deltaAbToPiJ1_deltaAbMk, piXToPiJ1_eq_one_iff] at hy
  exact (deltaAbMk_eq_one_iff D x).2 hy

/-- **Exactness in the middle of `1 → Δ_X^{ab} → Π_{J¹} → G_k`.** -/
theorem range_deltaAbToPiJ1 : (deltaAbToPiJ1 D).range = (piJ1ToGk D).ker := by
  ext y
  obtain ⟨x, rfl⟩ := piXToPiJ1_surjective D y
  constructor
  · rintro ⟨z, hz⟩
    obtain ⟨z, rfl⟩ := deltaAbMk_surjective D z
    rw [MonoidHom.mem_ker, ← hz, deltaAbToPiJ1_deltaAbMk, piJ1ToGk_piXToPiJ1]
    exact z.2
  · intro hx
    rw [MonoidHom.mem_ker, piJ1ToGk_piXToPiJ1] at hx
    exact ⟨deltaAbMk D ⟨x, hx⟩, rfl⟩

theorem deltaAbToPiJ1_mem_ker (m : DeltaAb D) : deltaAbToPiJ1 D m ∈ (piJ1ToGk D).ker := by
  rw [← range_deltaAbToPiJ1]
  exact ⟨m, rfl⟩

/-- `Δ_X^{ab} ≅ ker(Π_{J¹} → G_k)` as topological groups (a continuous bijection from a compact
group onto a Hausdorff one). -/
noncomputable def deltaAbEquivKer : DeltaAb D ≃ₜ* (piJ1ToGk D).ker :=
  let f : DeltaAb D →* (piJ1ToGk D).ker :=
    (deltaAbToPiJ1 D).codRestrict _ (deltaAbToPiJ1_mem_ker D)
  have hf : Function.Bijective f := by
    refine ⟨fun a b h => deltaAbToPiJ1_injective D (congrArg Subtype.val h), fun y => ?_⟩
    obtain ⟨m, hm⟩ : (y : PiJ1 D) ∈ (deltaAbToPiJ1 D).range := by
      rw [range_deltaAbToPiJ1]
      exact y.2
    exact ⟨m, Subtype.ext hm⟩
  have hc : Continuous f := (continuous_deltaAbToPiJ1 D).subtype_mk _
  { MulEquiv.ofBijective f hf with
    continuous_toFun := hc
    continuous_invFun :=
      (hc.homeoOfEquivCompactToT2 (f := (MulEquiv.ofBijective f hf).toEquiv)).symm.continuous }

@[simp]
theorem coe_deltaAbEquivKer (m : DeltaAb D) :
    ((deltaAbEquivKer D m : (piJ1ToGk D).ker) : PiJ1 D) = deltaAbToPiJ1 D m := rfl

@[simp]
theorem deltaAbToPiJ1_deltaAbEquivKer_symm (y : (piJ1ToGk D).ker) :
    deltaAbToPiJ1 D ((deltaAbEquivKer D).symm y) = y := by
  rw [← coe_deltaAbEquivKer, ContinuousMulEquiv.apply_symm_apply]

/-- `ker(Π_{J¹} → G_k)` is commutative. -/
theorem ker_mul_comm {x y : PiJ1 D} (hx : x ∈ (piJ1ToGk D).ker) (hy : y ∈ (piJ1ToGk D).ker) :
    x * y = y * x := by
  rw [← range_deltaAbToPiJ1] at hx hy
  obtain ⟨a, rfl⟩ := hx
  obtain ⟨b, rfl⟩ := hy
  rw [← map_mul, mul_comm, map_mul]

/-- **`Π_{J¹} → G_k` is surjective** when `k` is algebraically closed in `F` (completing the exact
sequence `1 → Δ_X^{ab} → Π_{J¹} → G_k → 1`). -/
theorem fact_piJ1ToGk_surjective
    (hk : ∀ x : F D, IsAlgebraic k x → x ∈ Set.range (algebraMap k (F D))) :
    Fact (Function.Surjective (piJ1ToGk D)) :=
  ⟨piJ1ToGk_surjective D hk⟩

end PiJ1

section Action

/-! ### The outer action of `G_k` on `Δ_X^{ab}` -/

variable [hs : Fact (Function.Surjective (piJ1ToGk D))]

/-- A (set-theoretic) lift `G_k → Π_{J¹}`. -/
noncomputable def liftGk (g : Gk k Ω) : PiJ1 D :=
  Function.surjInv (Fact.out : Function.Surjective (piJ1ToGk D)) g

theorem piJ1ToGk_liftGk (g : Gk k Ω) : piJ1ToGk D (liftGk D g) = g :=
  Function.surjInv_eq _ g

theorem conj_mem_ker (p : PiJ1 D) {x : PiJ1 D} (hx : x ∈ (piJ1ToGk D).ker) :
    p * x * p⁻¹ ∈ (piJ1ToGk D).ker :=
  (MonoidHom.normal_ker _).conj_mem x hx p

set_option synthInstance.maxHeartbeats 400000 in
-- `group` searches (and rejects) commutative structures on `Π_{J¹}`, which is slow
/-- Conjugation of the (abelian) kernel only depends on the image in `G_k`. -/
theorem conj_eq_of_eq {p q : PiJ1 D} (h : piJ1ToGk D p = piJ1ToGk D q) {x : PiJ1 D}
    (hx : x ∈ (piJ1ToGk D).ker) : p * x * p⁻¹ = q * x * q⁻¹ := by
  have hq : q⁻¹ * p ∈ (piJ1ToGk D).ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, h, inv_mul_cancel]
  have hc := ker_mul_comm D hq hx
  calc p * x * p⁻¹ = q * (q⁻¹ * p * x) * p⁻¹ := by group
    _ = q * (x * (q⁻¹ * p)) * p⁻¹ := by rw [hc]
    _ = q * x * q⁻¹ := by group

/-- The action of `g ∈ G_k` on `Δ_X^{ab}`: conjugation by any lift of `g` to `Π_{J¹}`. -/
noncomputable def gkSmul (g : Gk k Ω) (m : DeltaAb D) : DeltaAb D :=
  (deltaAbEquivKer D).symm ⟨liftGk D g * deltaAbToPiJ1 D m * (liftGk D g)⁻¹,
    conj_mem_ker D _ (deltaAbToPiJ1_mem_ker D m)⟩

theorem deltaAbToPiJ1_gkSmul (g : Gk k Ω) (m : DeltaAb D) {p : PiJ1 D}
    (hp : piJ1ToGk D p = g) :
    deltaAbToPiJ1 D (gkSmul D g m) = p * deltaAbToPiJ1 D m * p⁻¹ := by
  rw [gkSmul, deltaAbToPiJ1_deltaAbEquivKer_symm]
  exact conj_eq_of_eq D (by rw [piJ1ToGk_liftGk, hp]) (deltaAbToPiJ1_mem_ker D m)

set_option synthInstance.maxHeartbeats 400000 in
-- `group` searches (and rejects) commutative structures on `Π_{J¹}`, which is slow
/-- **`G_k` acts on `Δ_X^{ab}`** by conjugation through lifts to `Π_{J¹}` (well defined since
`Δ_X^{ab}` is abelian). -/
noncomputable instance mulDistribMulAction_deltaAb :
    MulDistribMulAction (Gk k Ω) (DeltaAb D) where
  smul := gkSmul D
  one_smul m := deltaAbToPiJ1_injective D (by
    change deltaAbToPiJ1 D (gkSmul D 1 m) = _
    rw [deltaAbToPiJ1_gkSmul D 1 m (map_one _)]
    group)
  mul_smul g h m := deltaAbToPiJ1_injective D (by
    change deltaAbToPiJ1 D (gkSmul D (g * h) m) = deltaAbToPiJ1 D (gkSmul D g (gkSmul D h m))
    rw [deltaAbToPiJ1_gkSmul D (g * h) m (p := liftGk D g * liftGk D h)
        (by rw [map_mul, piJ1ToGk_liftGk, piJ1ToGk_liftGk]),
      deltaAbToPiJ1_gkSmul D g _ (piJ1ToGk_liftGk D g),
      deltaAbToPiJ1_gkSmul D h _ (piJ1ToGk_liftGk D h)]
    group)
  smul_mul g a b := deltaAbToPiJ1_injective D (by
    change deltaAbToPiJ1 D (gkSmul D g (a * b)) =
      deltaAbToPiJ1 D (gkSmul D g a * gkSmul D g b)
    rw [map_mul, deltaAbToPiJ1_gkSmul D g _ (piJ1ToGk_liftGk D g),
      deltaAbToPiJ1_gkSmul D g _ (piJ1ToGk_liftGk D g),
      deltaAbToPiJ1_gkSmul D g _ (piJ1ToGk_liftGk D g), map_mul]
    group)
  smul_one g := deltaAbToPiJ1_injective D (by
    change deltaAbToPiJ1 D (gkSmul D g 1) = _
    rw [deltaAbToPiJ1_gkSmul D g _ (piJ1ToGk_liftGk D g), map_one]
    group)

/-- **The action of `G_k` on `Δ_X^{ab}`**: `σ • m` is the conjugate of `m` by any lift of `σ`. -/
theorem deltaAbToPiJ1_smul (g : Gk k Ω) (m : DeltaAb D) {p : PiJ1 D}
    (hp : piJ1ToGk D p = g) :
    deltaAbToPiJ1 D (g • m) = p * deltaAbToPiJ1 D m * p⁻¹ :=
  deltaAbToPiJ1_gkSmul D g m hp

instance t2Space_deltaAb : T2Space (DeltaAb D) :=
  (deltaAbEquivKer D).toHomeomorph.isEmbedding.t2Space

/-- **The action of `G_k` on `Δ_X^{ab}` is continuous**: `Π_{J¹} × Δ_X^{ab} → G_k × Δ_X^{ab}` is a
quotient map (a continuous surjection from a compact space onto a Hausdorff one), and the
conjugation action of `Π_{J¹}` is continuous. -/
instance continuousSMul_deltaAb : ContinuousSMul (Gk k Ω) (DeltaAb D) := by
  constructor
  let q : PiJ1 D × DeltaAb D → Gk k Ω × DeltaAb D := Prod.map (piJ1ToGk D) id
  have hc : Continuous q := (continuous_piJ1ToGk D).prodMap continuous_id
  have hq : Topology.IsQuotientMap q :=
    IsClosedMap.isQuotientMap hc.isClosedMap hc
      ((Fact.out : Function.Surjective (piJ1ToGk D)).prodMap Function.surjective_id)
  rw [hq.continuous_iff]
  have hfun : (fun p : Gk k Ω × DeltaAb D => p.1 • p.2) ∘ q = fun p =>
      (deltaAbEquivKer D).symm ⟨p.1 * deltaAbToPiJ1 D p.2 * p.1⁻¹,
        conj_mem_ker D _ (deltaAbToPiJ1_mem_ker D _)⟩ := by
    funext p
    apply deltaAbToPiJ1_injective D
    rw [deltaAbToPiJ1_deltaAbEquivKer_symm]
    exact deltaAbToPiJ1_smul D _ _ rfl
  rw [hfun]
  exact (deltaAbEquivKer D).symm.continuous.comp (Continuous.subtype_mk
    ((continuous_fst.mul ((continuous_deltaAbToPiJ1 D).comp continuous_snd)).mul
      continuous_fst.inv) _)

end Action

section Sections

/-! ### Sections of `Π_{J¹} → G_k` and their difference classes -/

/-- A continuous section of `Π_{J¹} ↠ G_k`. -/
structure J1Section where
  /-- The section, a homomorphism `G_k → Π_{J¹}`. -/
  toHom : Gk k Ω →* PiJ1 D
  /-- The section is continuous. -/
  continuous_toHom : Continuous toHom
  /-- It is a section of `Π_{J¹} ↠ G_k`. -/
  piJ1ToGk_toHom : ∀ g, piJ1ToGk D (toHom g) = g

variable {D}

theorem J1Section.diff_mem_ker (s s' : J1Section D) (g : Gk k Ω) :
    s.toHom g * (s'.toHom g)⁻¹ ∈ (piJ1ToGk D).ker := by
  rw [MonoidHom.mem_ker, map_mul, map_inv, s.piJ1ToGk_toHom, s'.piJ1ToGk_toHom, mul_inv_cancel]

variable [Fact (Function.Surjective (piJ1ToGk D))]

/-- The difference function `σ ↦ s(σ) s'(σ)⁻¹ ∈ Δ_X^{ab}` of two sections. -/
noncomputable def diffFun (s s' : J1Section D) (g : Gk k Ω) : DeltaAb D :=
  (deltaAbEquivKer D).symm ⟨s.toHom g * (s'.toHom g)⁻¹, s.diff_mem_ker s' g⟩

@[simp]
theorem deltaAbToPiJ1_diffFun (s s' : J1Section D) (g : Gk k Ω) :
    deltaAbToPiJ1 D (diffFun s s' g) = s.toHom g * (s'.toHom g)⁻¹ :=
  deltaAbToPiJ1_deltaAbEquivKer_symm D _

set_option synthInstance.maxHeartbeats 400000 in
-- `group` searches (and rejects) commutative structures on `Π_{J¹}`, which is slow
theorem isMulCocycle₁_diffFun (s s' : J1Section D) : groupCohomology.IsMulCocycle₁ (diffFun s s') :=
  fun g h => deltaAbToPiJ1_injective D (by
    rw [map_mul, deltaAbToPiJ1_smul D g _ (s.piJ1ToGk_toHom g), deltaAbToPiJ1_diffFun,
      deltaAbToPiJ1_diffFun, deltaAbToPiJ1_diffFun, map_mul, map_mul]
    group)

theorem continuous_diffFun (s s' : J1Section D) : Continuous (diffFun s s') :=
  (deltaAbEquivKer D).symm.continuous.comp
    ((s.continuous_toHom.mul s'.continuous_toHom.inv).subtype_mk _)

/-- **The difference cocycle** `σ ↦ s(σ) s'(σ)⁻¹` of two sections, a continuous `1`-cocycle of
`G_k` with values in `Δ_X^{ab}`. -/
noncomputable def diffCocycle (s s' : J1Section D) : ContH1.cocycles (Gk k Ω) (DeltaAb D) :=
  ContH1.mkCocycle (diffFun s s') (continuous_diffFun s s') (isMulCocycle₁_diffFun s s')

/-- **The difference class** `[s − s'] ∈ H¹(G_k, Δ_X^{ab})` of two sections. -/
noncomputable def diffClass (s s' : J1Section D) : ContH1 (Gk k Ω) (DeltaAb D) :=
  ContH1.mk (diffCocycle s s')

set_option synthInstance.maxHeartbeats 400000 in
-- `group` searches (and rejects) commutative structures on `Π_{J¹}`, which is slow
theorem diffCocycle_mul (s s' s'' : J1Section D) :
    diffCocycle s s' * diffCocycle s' s'' = diffCocycle s s'' := by
  refine Subtype.ext (funext fun g => deltaAbToPiJ1_injective D ?_)
  change deltaAbToPiJ1 D (diffFun s s' g * diffFun s' s'' g) = deltaAbToPiJ1 D (diffFun s s'' g)
  rw [map_mul, deltaAbToPiJ1_diffFun, deltaAbToPiJ1_diffFun, deltaAbToPiJ1_diffFun]
  group

/-- **Additivity**: `[s − s'] + [s' − s''] = [s − s'']` (written multiplicatively). -/
theorem diffClass_mul (s s' s'' : J1Section D) :
    diffClass s s' * diffClass s' s'' = diffClass s s'' := by
  rw [diffClass, diffClass, diffClass, ← map_mul, diffCocycle_mul]

theorem diffClass_self (s : J1Section D) : diffClass s s = 1 := by
  have h := diffClass_mul s s s
  rwa [mul_eq_right] at h

theorem diffClass_swap (s s' : J1Section D) : diffClass s' s = (diffClass s s')⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, diffClass_mul, diffClass_self]

set_option synthInstance.maxHeartbeats 400000 in
-- `group` searches (and rejects) commutative structures on `Π_{J¹}`, which is slow
/-- **`Δ_X^{ab}`-conjugate sections have the same class**: if `s'(σ) = q s(σ) q⁻¹` with
`q ∈ ker(Π_{J¹} → G_k)`, then `[s − s'] = 0`. -/
theorem diffClass_eq_one_of_conj (s s' : J1Section D) {q : PiJ1 D}
    (hq : q ∈ (piJ1ToGk D).ker) (h : ∀ g, s'.toHom g = q * s.toHom g * q⁻¹) :
    diffClass s s' = 1 := by
  rw [diffClass, ContH1.mk_eq_one_iff]
  refine ⟨(deltaAbEquivKer D).symm ⟨q, hq⟩, fun g => deltaAbToPiJ1_injective D ?_⟩
  change deltaAbToPiJ1 D (g • _ / _) = deltaAbToPiJ1 D (diffFun s s' g)
  rw [map_div, deltaAbToPiJ1_smul D g _ (s.piJ1ToGk_toHom g), deltaAbToPiJ1_diffFun,
    deltaAbToPiJ1_deltaAbEquivKer_symm, h, div_eq_mul_inv]
  group

end Sections

section RationalPoints

/-! ### The section `t_x` of a rational point -/

/-- `Gal(K₁/k) ≅ Gal(K₂/k)` induced by `e : K₁ ≅ K₂` is continuous for the Krull topologies. -/
theorem continuous_autCongr {K₁ K₂ : Type*} [Field K₁] [Field K₂] [Algebra k K₁] [Algebra k K₂]
    (e : K₁ ≃ₐ[k] K₂) : Continuous (AlgEquiv.autCongr e) := by
  refine continuous_of_continuousAt_one (AlgEquiv.autCongr e) ?_
  rw [ContinuousAt, map_one]
  intro U hU
  obtain ⟨E, hE, hEU⟩ := (krullTopology_mem_nhds_one_iff k K₂ U).1 hU
  rw [Filter.mem_map]
  haveI : FiniteDimensional k (E.map e.symm.toAlgHom) :=
    LinearEquiv.finiteDimensional (E.equivMap e.symm.toAlgHom).toLinearEquiv
  refine (krullTopology_mem_nhds_one_iff k K₁ _).2
    ⟨E.map e.symm.toAlgHom, inferInstance, fun σ hσ => hEU ?_⟩
  rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
  intro y hy
  have h := hσ (e.symm y) ((IntermediateField.mem_map _).2 ⟨y, hy, rfl⟩)
  rw [AlgEquiv.autCongr_apply, AlgEquiv.trans_apply, AlgEquiv.trans_apply, h,
    AlgEquiv.apply_symm_apply]

/-- The `k`-algebra structure on `κ(A)` for a place `A ⊇ k` (reduction of `k ⊆ A`). -/
@[implicit_reducible]
noncomputable def resAlg (A : ValuationSubring Ω) (hk : ∀ c : k, algebraMap k Ω c ∈ A) :
    Algebra k (ResidueField A) :=
  ((residue A).comp (toW hk)).toAlgebra

/-- **A `k`-rational point** of the proper curve `X` in the Galois model: a place `A ⊆ Ω`
containing `k` whose restriction to `F` has residue field `k` (`hrat`), with `κ(A)` algebraic over
`k` (both conditions refer to the `k`-algebra structure `resAlg`). Cusps are allowed. -/
structure RatPoint where
  /-- The place of `Ω` (a valuation subring). -/
  A : ValuationSubring Ω
  /-- `A` contains the constants `k`. -/
  hk : ∀ c : k, algebraMap k Ω c ∈ A
  /-- `κ(A)` is algebraic over `k`. -/
  isIntegral : letI := resAlg A hk; Algebra.IsIntegral k (ResidueField A)
  hrat : letI := resAlg A hk; ∀ (a : F D) (ha : (a : Ω) ∈ A),
    ∃ c : k, residue A ⟨_, ha⟩ = algebraMap k (ResidueField A) c

variable {D}

noncomputable instance RatPoint.algebra (x : RatPoint D) : Algebra k (ResidueField x.A) :=
  resAlg x.A x.hk

instance RatPoint.isIntegral' (x : RatPoint D) : Algebra.IsIntegral k (ResidueField x.A) :=
  x.isIntegral

theorem RatPoint.hkres (x : RatPoint D) (c : k) :
    residue x.A ⟨algebraMap k Ω c, x.hk c⟩ = algebraMap k (ResidueField x.A) c := rfl

variable (D) in
/-- `D_A → Π_U → Π_X`. -/
noncomputable def decompToPiX (A : ValuationSubring Ω) : A.decompositionSubgroup (F D) →* PiX D :=
  (piUToPiX D).comp (decompToPi D A)

theorem continuous_decompToPiX (A : ValuationSubring Ω) : Continuous (decompToPiX D A) :=
  (continuous_piUToPiX D).comp (continuous_decompToPi D A)

/-- **Inertia dies in `Π_X`**: every element of `D_A` acting trivially on `κ(A)` lies in the inertia
group of `A`, hence in the kernel of `H → Π_X` (no condition `t ∈ A`: cusps included). -/
theorem ker_decompositionMap_le_ker_decompToPiX (x : RatPoint D) :
    (Decomposition.decompositionMap (F D) x.A x.hk x.hkres).ker ≤ (decompToPiX D x.A).ker := by
  intro σ hσ
  rw [MonoidHom.mem_ker] at hσ
  have hin : ((ofGalF D σ.1 : D.H) : Ω ≃ₐ[K₀ k t] Ω) ∈ SAll D := by
    refine ⟨(ofGalF D σ.1).2, x.A, x.hk, fun a ha => ?_⟩
    have h1 := Decomposition.decompositionMap_residue (F D) x.A x.hk x.hkres σ ⟨a, ha⟩
    rw [hσ, AlgEquiv.one_apply] at h1
    have hm : (σ • (⟨a, ha⟩ : x.A) : x.A) - ⟨a, ha⟩ ∈ maximalIdeal x.A := by
      rw [← residue_eq_zero_iff, map_sub, ← h1, sub_self]
    have hv := (x.A.valuation_lt_one_iff _).mp hm
    rw [ofGalF_apply]
    convert hv using 2
    rw [AddSubgroupClass.coe_sub]
    rfl
  rw [MonoidHom.mem_ker]
  change ((ofGalF D σ.1 : D.H) : PiX D) = 1
  refine (QuotientGroup.eq_one_iff (ofGalF D σ.1)).mpr ?_
  rw [GaloisPi1.kernel, Subgroup.mem_subgroupOf]
  exact Subgroup.le_topologicalClosure _
    (Subgroup.subset_closure ⟨1, D.H.one_mem, _, hin, by simp⟩)

theorem RatPoint.decompositionMap_surjective (x : RatPoint D) :
    Function.Surjective (Decomposition.decompositionMap (F D) x.A x.hk x.hkres) :=
  decompositionMap_surjective_of_rational D x.A x.hk x.hkres x.hrat

/-- **The section `s_x : Gal(κ(A)/k) → Π_X` of a `k`-rational point** (descent of `D_A → Π_X`
along the surjection `D_A ↠ Gal(κ(A)/k)`, whose kernel, the inertia group, dies in `Π_X`). -/
noncomputable def xSection (x : RatPoint D) :
    (ResidueField x.A ≃ₐ[k] ResidueField x.A) →* PiX D :=
  (Decomposition.decompositionMap (F D) x.A x.hk x.hkres).liftOfSurjective
    x.decompositionMap_surjective ⟨decompToPiX D x.A, ker_decompositionMap_le_ker_decompToPiX x⟩

theorem xSection_decompositionMap (x : RatPoint D) (σ : x.A.decompositionSubgroup (F D)) :
    xSection x (Decomposition.decompositionMap (F D) x.A x.hk x.hkres σ) = decompToPiX D x.A σ :=
  MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ σ

theorem continuous_xSection (x : RatPoint D) : Continuous (xSection x) := by
  have hc := Decomposition.continuous_decompositionMap (F D) x.A x.hk x.hkres
  have hq := IsClosedMap.isQuotientMap hc.isClosedMap hc x.decompositionMap_surjective
  rw [hq.continuous_iff]
  have : (xSection x) ∘ (Decomposition.decompositionMap (F D) x.A x.hk x.hkres) =
      decompToPiX D x.A := funext (xSection_decompositionMap x)
  rw [this]
  exact continuous_decompToPiX x.A

/-- **`s_x` is a section of `Π_X ↠ G_k`** under `G_k ≅ Gal(κ(A)/k)` (`kbarEquiv`). -/
theorem piXToGk_xSection (x : RatPoint D) (g : ResidueField x.A ≃ₐ[k] ResidueField x.A) :
    piXToGk D (xSection x g) =
      (kbarEquiv x.A x.hk x.hkres).trans (g.trans (kbarEquiv x.A x.hk x.hkres).symm) := by
  obtain ⟨σ, rfl⟩ := x.decompositionMap_surjective g
  rw [xSection_decompositionMap, decompToPiX, MonoidHom.comp_apply, piXToGk_piUToPiX]
  refine AlgEquiv.ext fun y => ?_
  apply (kbarEquiv x.A x.hk x.hkres).injective
  rw [AlgEquiv.trans_apply, AlgEquiv.trans_apply, AlgEquiv.apply_symm_apply, kbarEquiv_apply,
    kbarEquiv_apply, kbarResidue_piToGk_decompToPi]

/-- **Compatibility with `Π_U`**: for a rational point of `U = Spec R` (`t ∈ A`, `H_L = H`), `s_x`
is the image in `Π_X` of the section `ratSectionMap` of `Π_U`. -/
theorem piUToPiX_ratSectionMap (x : RatPoint D) (hHL : D.HL = D.H) (ht : t ∈ x.A)
    (g : ResidueField x.A ≃ₐ[k] ResidueField x.A) :
    piUToPiX D (ratSectionMap D x.A x.hk x.hkres x.hrat hHL ht g) = xSection x g := by
  obtain ⟨σ, rfl⟩ := x.decompositionMap_surjective g
  rw [ratSectionMap_decompositionMap, xSection_decompositionMap]
  rfl

/-- **The section `t_x : G_k → Π_{J¹}` of a `k`-rational point** ([Cusp] §2, [AbsTopIII]
Prop. 1.6(ii)): `s_x` composed with `G_k ≅ Gal(κ(A)/k)` and `Π_X ↠ Π_{J¹}`. -/
noncomputable def tSection (x : RatPoint D) : J1Section D where
  toHom := (piXToPiJ1 D).comp ((xSection x).comp
    (AlgEquiv.autCongr (kbarEquiv x.A x.hk x.hkres)).toMonoidHom)
  continuous_toHom := (continuous_piXToPiJ1 D).comp
    ((continuous_xSection x).comp (continuous_autCongr _))
  piJ1ToGk_toHom g := by
    rw [MonoidHom.comp_apply, piJ1ToGk_piXToPiJ1, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      piXToGk_xSection]
    refine AlgEquiv.ext fun y => ?_
    simp

theorem tSection_apply (x : RatPoint D) (g : Gk k Ω) :
    (tSection x).toHom g =
      piXToPiJ1 D (xSection x (AlgEquiv.autCongr (kbarEquiv x.A x.hk x.hkres) g)) := rfl

end RationalPoints

section Divisors

/-! ### The class `η_D` of a degree-`0` divisor supported on rational points -/

variable {D} [Fact (Function.Surjective (piJ1ToGk D))] {ι : Type*}

/-- `b ^ (∑ nᵢ) = ∏ b ^ nᵢ`. -/
theorem zpow_finsetSum {G : Type*} [CommGroup G] (b : G) (s : Finset ι) (n : ι → ℤ) :
    b ^ (∑ i ∈ s, n i) = ∏ i ∈ s, b ^ n i := by
  induction s using Finset.cons_induction with
  | empty => simp
  | cons a s ha ih => rw [Finset.sum_cons, Finset.prod_cons, zpow_add, ih]

/-- `∑ nᵢ [sᵢ − s₀] ∈ H¹(G_k, Δ_X^{ab})` for a family of sections `sᵢ` and a base index `i₀`
(written multiplicatively: `∏ [sᵢ − s_{i₀}]^{nᵢ}`). -/
noncomputable def etaWith (s : ι → J1Section D) (f : ι →₀ ℤ) (i₀ : ι) :
    ContH1 (Gk k Ω) (DeltaAb D) :=
  f.prod fun i n => diffClass (s i) (s i₀) ^ n

/-- **Independence of the base point** for `∑ nᵢ = 0`. -/
theorem etaWith_eq (s : ι → J1Section D) (f : ι →₀ ℤ) (hf : (f.sum fun _ n => n) = 0)
    (i₀ i₁ : ι) : etaWith s f i₀ = etaWith s f i₁ := by
  have h : (fun (i : ι) (n : ℤ) => diffClass (s i) (s i₁) ^ n) =
      fun (i : ι) (n : ℤ) => diffClass (s i) (s i₀) ^ n * diffClass (s i₀) (s i₁) ^ n := by
    funext i n
    rw [← mul_zpow, diffClass_mul]
  have h1 : (f.prod fun _ n => diffClass (s i₀) (s i₁) ^ n) = 1 := by
    rw [Finsupp.sum] at hf
    rw [Finsupp.prod, ← zpow_finsetSum, hf, zpow_zero]
  rw [etaWith, etaWith, h, Finsupp.prod_mul, h1, mul_one]

/-- **`η_D` for a divisor `D = ∑ nᵢ xᵢ` supported on `k`-rational points**: `∑ nᵢ [t_{xᵢ} − t_{x₀}]`
for a base point `x₀` (independent of `x₀` when `deg D = 0`, `etaDiv_eq`). -/
noncomputable def etaDiv (f : RatPoint D →₀ ℤ) (x₀ : RatPoint D) : ContH1 (Gk k Ω) (DeltaAb D) :=
  etaWith tSection f x₀

/-- **`η_D` does not depend on the auxiliary point** for `deg D = 0`. -/
theorem etaDiv_eq (f : RatPoint D →₀ ℤ) (hf : (f.sum fun _ n => n) = 0) (x₀ x₁ : RatPoint D) :
    etaDiv f x₀ = etaDiv f x₁ :=
  etaWith_eq _ f hf x₀ x₁

open Classical in
/-- **`η_D ∈ H¹(G_k, Δ_X^{ab})`** of a divisor supported on `k`-rational points, with the base
point taken in the support (`1` for `D = 0`); for `deg D = 0` it equals `etaDiv f x₀` for every
`x₀` (`eta_eq_etaDiv`). -/
noncomputable def eta (f : RatPoint D →₀ ℤ) : ContH1 (Gk k Ω) (DeltaAb D) :=
  if h : f.support.Nonempty then etaDiv f h.choose else 1

theorem eta_eq_etaDiv (f : RatPoint D →₀ ℤ) (hf : (f.sum fun _ n => n) = 0) (x₀ : RatPoint D) :
    eta f = etaDiv f x₀ := by
  unfold eta
  split_ifs with h
  · exact etaDiv_eq f hf _ x₀
  · rw [Finset.not_nonempty_iff_eq_empty, Finsupp.support_eq_empty] at h
    rw [h, etaDiv, etaWith, Finsupp.prod_zero_index]

end Divisors

end CurvesJacobian.Kummer
