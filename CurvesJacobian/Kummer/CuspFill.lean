import CurvesJacobian.Kummer.CuspCentral

/-!
# Filling in the cusp: `Π̂_{g,1} ⧸ ⟨⟨c⟩⟩ ≅ Π̂_{g,0}` and `1 → I_x → Δ^{c-cn}_{U_x} → Δ_X → 1`

[AbsTopIII] Prop. 1.4 (T3 l.1771–1795): for a proper hyperbolic curve `X`, `x ∈ X(k)` and
`U_x = X ∖ {x}`, the kernel of `Δ_{U_x} ↠ Δ_X` is topologically normally generated by the cuspidal
inertia group `I_x`, and the maximal cuspidally central quotient sits in an exact sequence
`1 → I_x → Δ^{c-cn}_{U_x} → Δ_X → 1`. Group-theoretic model (`Δ_{U_x} ≅ Π̂_{g,1}`,
`Δ_X ≅ Π̂_{g,0}`, `I_x = ⟨c⟩‾`):

* `fillHom g : Π_{g,1} →* Π_{g,0}` (`aᵢ ↦ aᵢ`, `bᵢ ↦ bᵢ`, `c ↦ 1`), surjective with kernel
  `⟨⟨c⟩⟩` (`ker_fillHom`); `fillLift` factors homomorphisms killing `c` through it;
* `fillHat g : Π̂_{g,1} →* Π̂_{g,0}`, its completion: continuous, surjective, and
  **`ker_fillHat`**: its kernel is `cuspKernel g`, the closed normal subgroup generated by `c`;
* **`cuspQuotEquiv g : Π̂_{g,1} ⧸ cuspKernel g ≃ₜ* Π̂_{g,0}`** (`cuspQuotEquiv_mk`);
* `ccnFill g : CcnQuot g →* Π̂_{g,0}` and `ccnInertia g : ℤ̂ →* CcnQuot g`, `k ↦ cᵏ`;
  **`map_cuspKernel_eq_range_ccnInertia`**: the image of `cuspKernel g` in `Δ^{c-cn}` is the image
  of `I = ⟨c⟩‾` (conjugates of `c` agree modulo `ccnKernel g`); **`ker_ccnFill`**,
  `ccnFill_surjective` and `ccnInertia_injective` (`g ≥ 1`, in `CuspCentral`) give the exact
  sequence, bundled as **`ccn_exact`**.
-/

open CategoryTheory ProfiniteGrp ProfiniteGrp.ProfiniteCompletion Topology
open Pi1 Pi1.Profinite Pi1.SurfaceGen Pi1.SurfaceGroup

namespace CurvesJacobian.CuspCentral

variable {g : ℕ}

/-! ### The discrete fill map -/

lemma ordProd_one {G : Type*} [Group G] (z : Fin 1 → G) : ordProd z = z 0 := by
  simp [ordProd]

lemma ordProd_zero {G : Type*} [Group G] (z : Fin 0 → G) : ordProd z = 1 := by
  simp [ordProd]

/-- In `Π_{g,1}`: `∏ᵢ [aᵢ, bᵢ] = c⁻¹`. -/
lemma commProd_genA_genB_one :
    commProd (genA (g := g) (r := 1)) genB = (cusp 0)⁻¹ := by
  have h := relation (g := g) (r := 1)
  rw [ordProd_one] at h
  exact eq_inv_of_mul_eq_one_left h

/-- In `Π_{g,0}`: `∏ᵢ [aᵢ, bᵢ] = 1`. -/
lemma commProd_genA_genB_zero : commProd (genA (g := g) (r := 0)) genB = 1 := by
  have h := relation (g := g) (r := 0)
  rwa [ordProd_zero, mul_one] at h

/-- A homomorphism out of `Π_{g,1}` killing `c` factors through `Π_{g,0}`. -/
def fillLift {G : Type*} [Group G] (ρ : SurfaceGroup g 1 →* G) (h : ρ (cusp 0) = 1) :
    SurfaceGroup g 0 →* G :=
  lift (fun i ↦ ρ (genA i)) (fun i ↦ ρ (genB i)) Fin.elim0 (by
    rw [ordProd_zero, mul_one, ← map_commProd, commProd_genA_genB_one, map_inv, h, inv_one])

@[simp] lemma fillLift_genA {G : Type*} [Group G] (ρ : SurfaceGroup g 1 →* G)
    (h : ρ (cusp 0) = 1) (i : Fin g) : fillLift ρ h (genA i) = ρ (genA i) := lift_genA ..

@[simp] lemma fillLift_genB {G : Type*} [Group G] (ρ : SurfaceGroup g 1 →* G)
    (h : ρ (cusp 0) = 1) (i : Fin g) : fillLift ρ h (genB i) = ρ (genB i) := lift_genB ..

variable (g) in
/-- **The fill map** `Π_{g,1} → Π_{g,0}`: `aᵢ ↦ aᵢ`, `bᵢ ↦ bᵢ`, `c ↦ 1`. -/
def fillHom : SurfaceGroup g 1 →* SurfaceGroup g 0 :=
  lift genA genB (fun _ ↦ 1) (by rw [ordProd_one, mul_one, commProd_genA_genB_zero])

@[simp] lemma fillHom_genA (i : Fin g) : fillHom g (genA i) = genA i := lift_genA ..
@[simp] lemma fillHom_genB (i : Fin g) : fillHom g (genB i) = genB i := lift_genB ..
@[simp] lemma fillHom_cusp (j : Fin 1) : fillHom g (cusp j) = 1 := lift_cusp ..

theorem fillLift_comp {G : Type*} [Group G] (ρ : SurfaceGroup g 1 →* G) (h : ρ (cusp 0) = 1) :
    (fillLift ρ h).comp (fillHom g) = ρ := by
  refine hom_ext (fun i ↦ ?_) (fun i ↦ ?_) (fun j ↦ ?_)
  · simp
  · simp
  · obtain rfl : j = 0 := Subsingleton.elim _ _
    simp [h]

variable (g) in
theorem fillHom_surjective : Function.Surjective (fillHom g) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← PresentedGroup.closure_range_of,
    Subgroup.closure_le]
  rintro _ ⟨s, rfl⟩
  cases s with
  | a i => exact ⟨genA i, fillHom_genA i⟩
  | b i => exact ⟨genB i, fillHom_genB i⟩
  | c j => exact j.elim0

variable (g) in
/-- **`ker(Π_{g,1} ↠ Π_{g,0}) = ⟨⟨c⟩⟩`.** -/
theorem ker_fillHom : (fillHom g).ker = Subgroup.normalClosure {cusp 0} := by
  refine le_antisymm (fun x hx ↦ ?_) (Subgroup.normalClosure_le_normal (by simp))
  set N := Subgroup.normalClosure ({cusp 0} : Set (SurfaceGroup g 1))
  have hc : QuotientGroup.mk' N (cusp 0) = 1 :=
    (QuotientGroup.eq_one_iff _).2 (Subgroup.subset_normalClosure rfl)
  rw [← QuotientGroup.eq_one_iff (N := N), ← QuotientGroup.mk'_apply,
    ← fillLift_comp (QuotientGroup.mk' N) hc, MonoidHom.comp_apply, hx, map_one]

/-! ### The profinite fill map -/

variable (g) in
/-- The fill map `Π̂_{g,1} → Π̂_{g,0}` (`Δ_{U_x} ↠ Δ_X`). -/
noncomputable def fillHat : ProfiniteSurfaceGroup g 1 →* ProfiniteSurfaceGroup g 0 :=
  completionMap (fillHom g)

variable (g) in
theorem continuous_fillHat : Continuous (fillHat g) := continuous_completionMap _

@[simp] lemma fillHat_eta (x : SurfaceGroup g 1) :
    fillHat g (etaFn (GrpCat.of (SurfaceGroup g 1)) x) =
      etaFn (GrpCat.of (SurfaceGroup g 0)) (fillHom g x) :=
  completionMap_eta _ _

lemma fillHat_cuspHat : fillHat g (cuspHat g) = 1 := by
  rw [cuspHat, fillHat_eta, fillHom_cusp]
  exact map_one (eta (GrpCat.of (SurfaceGroup g 0))).hom

variable (g) in
theorem fillHat_surjective : Function.Surjective (fillHat g) := by
  have hc : IsClosed (Set.range (fillHat g)) := (isCompact_range (continuous_fillHat g)).isClosed
  have hd : Dense (Set.range (fillHat g)) := by
    refine (denseRange (GrpCat.of (SurfaceGroup g 0))).mono ?_
    rintro _ ⟨y, rfl⟩
    obtain ⟨x, rfl⟩ := fillHom_surjective g y
    exact ⟨_, fillHat_eta x⟩
  rw [← Set.range_eq_univ, ← hc.closure_eq, hd.closure_eq]

instance : IsClosed (cuspKernel g : Set (ProfiniteSurfaceGroup g 1)) :=
  Subgroup.isClosed_topologicalClosure _

instance : IsClosed (ccnKernel g : Set (ProfiniteSurfaceGroup g 1)) :=
  Subgroup.isClosed_topologicalClosure _

/-- For an open normal subgroup `M` of `Ĝ`, the extension of `G → Ĝ ↠ Ĝ ⧸ M` is the projection. -/
lemma liftFinite_mk_comp_eta {G : Type} [Group G] (M : Subgroup (completion (GrpCat.of G)))
    [M.Normal] (hM : IsOpen (M : Set (completion (GrpCat.of G)))) [Finite (_ ⧸ M)]
    (z : completion (GrpCat.of G)) :
    liftFinite ((QuotientGroup.mk' M).comp (eta (GrpCat.of G)).hom) z = (z : _ ⧸ M) := by
  obtain ⟨x, hx, hxz⟩ := exists_etaFn_eq ((QuotientGroup.mk' M).comp (eta (GrpCat.of G)).hom)
    (isOpen_setOf_mk_eq M hM z) rfl
  exact hxz.symm.trans hx

variable (g) in
/-- **`ker(Π̂_{g,1} ↠ Π̂_{g,0}) = cuspKernel g`** ([AbsTopIII] Prop. 1.4(i) in the group-theoretic
model): the kernel of the fill map is the closed normal subgroup generated by `c`. -/
theorem ker_fillHat : (fillHat g).ker = cuspKernel g := by
  refine le_antisymm (fun z hz ↦ ?_) ?_
  · by_contra hzN
    set N := cuspKernel g
    have hNc : IsClosed (N : Set (ProfiniteSurfaceGroup g 1)) :=
      Subgroup.isClosed_topologicalClosure _
    have hW : IsOpen {u : ProfiniteSurfaceGroup g 1 | z * u ∉ N} :=
      hNc.isOpen_compl.preimage (continuous_const.mul continuous_id)
    obtain ⟨U, hU⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hW
      (by simpa using hzN)
    set M := N ⊔ U.toSubgroup
    have hMo : IsOpen (M : Set (ProfiniteSurfaceGroup g 1)) :=
      Subgroup.isOpen_mono le_sup_right U.isOpen
    haveI : Finite (ProfiniteSurfaceGroup g 1 ⧸ M) := Subgroup.quotient_finite_of_isOpen _ hMo
    set ρ := (QuotientGroup.mk' M).comp (eta (GrpCat.of (SurfaceGroup g 1))).hom
    have hρc : ρ (cusp 0) = 1 := by
      rw [MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact Subgroup.mem_sup_left
        (Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure rfl))
    have hzM : (z : ProfiniteSurfaceGroup g 1 ⧸ M) = 1 := by
      rw [← liftFinite_mk_comp_eta M hMo z]
      change liftFinite ρ z = 1
      rw [← fillLift_comp ρ hρc, ← liftFinite_completionMap]
      change liftFinite _ (fillHat g z) = 1
      rw [hz, map_one]
    rw [QuotientGroup.eq_one_iff, ← SetLike.mem_coe, Subgroup.normal_mul] at hzM
    obtain ⟨n, hn, u, hu, rfl⟩ := hzM
    exact hU (U.inv_mem hu) (by simpa using hn)
  · refine Subgroup.topologicalClosure_minimal _
      (Subgroup.normalClosure_le_normal (by simpa using fillHat_cuspHat)) ?_
    rw [MonoidHom.coe_ker]
    exact isClosed_singleton.preimage (continuous_fillHat g)

variable (g) in
/-- **`Π̂_{g,1} ⧸ ⟨⟨c⟩⟩‾ ≃ₜ* Π̂_{g,0}`** via the fill map (`Δ_{U_x} ⧸ ⟨⟨I_x⟩⟩ ≅ Δ_X`). -/
noncomputable def cuspQuotEquiv :
    ProfiniteSurfaceGroup g 1 ⧸ cuspKernel g ≃ₜ* ProfiniteSurfaceGroup g 0 :=
  let e : ProfiniteSurfaceGroup g 1 ⧸ cuspKernel g ≃* ProfiniteSurfaceGroup g 0 :=
    (QuotientGroup.quotientMulEquivOfEq (ker_fillHat g).symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective _ (fillHat_surjective g))
  have hc : Continuous e :=
    (QuotientGroup.isQuotientMap_mk _).continuous_iff.2 (continuous_fillHat g)
  let h := hc.homeoOfEquivCompactToT2 (f := e.toEquiv)
  { e with
    continuous_toFun := h.continuous
    continuous_invFun := h.symm.continuous }

@[simp] theorem cuspQuotEquiv_mk (x : ProfiniteSurfaceGroup g 1) :
    cuspQuotEquiv g (x : ProfiniteSurfaceGroup g 1 ⧸ cuspKernel g) = fillHat g x := rfl

/-! ### The exact sequence `1 → I_x → Δ^{c-cn}_{U_x} → Δ_X → 1` -/

lemma ccnKernel_le_cuspKernel : ccnKernel g ≤ cuspKernel g :=
  Subgroup.topologicalClosure_minimal _ (Subgroup.commutator_le_left _ _) inferInstance

variable (g) in
/-- `Δ^{c-cn}_{U_x} ↠ Δ_X`, induced by the fill map. -/
noncomputable def ccnFill : CcnQuot g →* ProfiniteSurfaceGroup g 0 :=
  QuotientGroup.lift (ccnKernel g) (fillHat g) (by
    rw [ker_fillHat]
    exact ccnKernel_le_cuspKernel)

@[simp] lemma ccnFill_mk (x : ProfiniteSurfaceGroup g 1) :
    ccnFill g (x : CcnQuot g) = fillHat g x := rfl

variable (g) in
theorem continuous_ccnFill : Continuous (ccnFill g) :=
  (QuotientGroup.isQuotientMap_mk _).continuous_iff.2 (continuous_fillHat g)

variable (g) in
theorem ccnFill_surjective : Function.Surjective (ccnFill g) := fun y ↦ by
  obtain ⟨x, rfl⟩ := fillHat_surjective g y
  exact ⟨x, rfl⟩

variable (g) in
/-- `I_x → Δ^{c-cn}_{U_x}`, `k ↦ cᵏ`. -/
noncomputable def ccnInertia : ZHat →* CcnQuot g :=
  (QuotientGroup.mk' (ccnKernel g)).comp (cuspInertia 0)

variable (g) in
theorem continuous_ccnInertia : Continuous (ccnInertia g) :=
  continuous_quotient_mk'.comp (continuous_cuspInertia 0)

variable (g) in
lemma inertia_le_cuspKernel : inertia (g := g) (r := 1) 0 ≤ cuspKernel g :=
  Subgroup.topologicalClosure_mono
    ((Subgroup.zpowers_le).2 (Subgroup.subset_normalClosure rfl))

variable (g) in
theorem ker_ccnFill : (ccnFill g).ker = (cuspKernel g).map (QuotientGroup.mk' (ccnKernel g)) := by
  ext y
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (ccnKernel g) y
  simp only [MonoidHom.mem_ker, QuotientGroup.mk'_apply, ccnFill_mk, Subgroup.mem_map]
  constructor
  · intro hx
    exact ⟨x, (ker_fillHat g) ▸ hx, rfl⟩
  · rintro ⟨x', hx', he⟩
    rw [QuotientGroup.eq] at he
    have h1 : x'⁻¹ * x ∈ (fillHat g).ker := (ker_fillHat g).symm ▸ ccnKernel_le_cuspKernel he
    have h2 : x' ∈ (fillHat g).ker := (ker_fillHat g).symm ▸ hx'
    simpa using (fillHat g).ker.mul_mem h2 h1

variable (g) in
/-- **The image of `⟨⟨c⟩⟩‾` in `Δ^{c-cn}_{U_x}` is the image of `I_x`**: conjugates of `c` agree
modulo `ccnKernel g`. -/
theorem map_cuspKernel_eq_range_ccnInertia :
    (cuspKernel g).map (QuotientGroup.mk' (ccnKernel g)) = (ccnInertia g).range := by
  have hge : (ccnInertia g).range ≤ (cuspKernel g).map (QuotientGroup.mk' (ccnKernel g)) := by
    rintro _ ⟨k, rfl⟩
    refine ⟨cuspInertia 0 k, inertia_le_cuspKernel g ?_, rfl⟩
    rw [← range_cuspInertia]
    exact ⟨k, rfl⟩
  refine le_antisymm ?_ hge
  set R := (ccnInertia g).range
  have hRc : IsClosed (R : Set (CcnQuot g)) := by
    rw [MonoidHom.coe_range]
    exact (isCompact_range (continuous_ccnInertia g)).isClosed
  -- elements of `R` are central
  have hcomm : ∀ y ∈ R, ∀ w : CcnQuot g, w * y = y * w := by
    intro y hy w
    obtain ⟨x, hx, rfl⟩ := hge hy
    obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective (ccnKernel g) w
    exact (mk_mul_comm_of_mem hx v).symm
  let S : Subgroup (ProfiniteSurfaceGroup g 1) := R.comap (QuotientGroup.mk' (ccnKernel g))
  haveI : S.Normal := ⟨fun x hx a ↦ by
    simp only [S, Subgroup.mem_comap, map_mul, map_inv] at hx ⊢
    rwa [hcomm _ hx, mul_inv_cancel_right]⟩
  have hS : cuspKernel g ≤ S := by
    refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_)
      (hRc.preimage continuous_quotient_mk')
    rintro _ rfl
    refine ⟨etaFn (GrpCat.of (Multiplicative ℤ)) (Multiplicative.ofAdd (1 : ℤ)), ?_⟩
    simp only [ccnInertia, MonoidHom.comp_apply, cuspInertia, completionMap_eta, zpowersHom_apply]
    change ((etaFn (GrpCat.of (SurfaceGroup g 1)) (cusp 0 ^ (1 : ℤ)) : CcnQuot g)) = _
    rw [zpow_one]
    rfl
  rintro _ ⟨x, hx, rfl⟩
  exact hS hx

variable (g) in
/-- **The exact sequence `1 → I_x → Δ^{c-cn}_{U_x} → Δ_X → 1`** ([AbsTopIII] Prop. 1.4(ii),
T3 l.1785–1788) in the group-theoretic model `Δ_{U_x} = Π̂_{g+1,1}`, `Δ_X = Π̂_{g+1,0}`,
`I_x = ℤ̂` (via `k ↦ cᵏ`). -/
theorem ccn_exact :
    Function.Injective (ccnInertia (g + 1)) ∧ (ccnInertia (g + 1)).range = (ccnFill (g + 1)).ker ∧
      Function.Surjective (ccnFill (g + 1)) :=
  ⟨ccnInertia_injective, by rw [ker_ccnFill, map_cuspKernel_eq_range_ccnInertia],
    ccnFill_surjective _⟩

end CurvesJacobian.CuspCentral
