import CurvesJacobian.FunctionField.WeilPairingNondeg
import CurvesJacobian.Kummer.JacobianBridgeSurj
import CurvesJacobian.Kummer.BaseChangeFunctionField
import CurvesJacobian.Galois.PicTorsionCount
