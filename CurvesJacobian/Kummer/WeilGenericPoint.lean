import Mathlib.FieldTheory.Galois.Infinite

/-!
# The generic point datum of a curve

Let `Y` be a curve over an algebraically closed field `κ` and `K'` an algebraically closed field
over `κ`. Places of `K(Y)` base change to places of `K(Y_{K'})`: the `κ`-point `x_P` of `P`
gives the `K'`-point `x_P ×_κ K'` (`CurvesJacobian.GenericPoint.bcSec`), and the square

  `Spec K' ⟶ Y_{K'}`, `Spec κ ⟶ Y`

is cartesian, so the ideal sheaf of the base-changed point is the pull-back of that of `x_P`
(`ker_bcSec`). On the preimage `V_{K'}` of an affine neighbourhood `V` of `x_P` on which a
uniformizer `π` cuts out `x_P`, the base-changed ideal is generated by `π`; hence
`ord_{β P}(π) = 1` and `x_P ×_κ K'` is the only point of `Y_{K'}` over `x_P`.
-/

open CategoryTheory Limits AlgebraicGeometry Belyi WeilCurves.FunctionField

universe u

noncomputable section

set_option linter.unusedSectionVars false

namespace CurvesJacobian.GenericPoint

variable (κ : Type u) [Field κ] [IsAlgClosed κ] (Y : Scheme.{u}) [Y.Over (Spec (.of κ))]
  [IsCurveOver κ Y] [IsIntegral Y] (K' : Type u) [Field K'] [IsAlgClosed K'] [Algebra κ K']

/-- The base change `Y_{K'}`. -/
abbrev bcY : Scheme.{u} := pullback (Y ↘ Spec (.of κ)) (specAlgebraMap κ K')

/-- The projection `Y_{K'} ⟶ Y`. -/
abbrev bcFst : bcY κ Y K' ⟶ Y := pullback.fst _ _

instance : IsIntegral (bcY κ Y K') := IsCurveOver.isIntegral K' _

lemma over_bcY : (bcY κ Y K' ↘ Spec (.of K')) = pullback.snd _ _ := rfl

variable {κ Y K'}

/-- The base change `x_P ×_κ K'` of the `κ`-point of a place. -/
def bcSec (P : Place κ Y.functionField) : Spec (.of K') ⟶ bcY κ Y K' :=
  pullback.lift (specAlgebraMap κ K' ≫ placeSection κ Y P) (𝟙 _) (by simp)

@[reassoc (attr := simp)]
lemma bcSec_fst (P : Place κ Y.functionField) :
    bcSec P ≫ bcFst κ Y K' = specAlgebraMap κ K' ≫ placeSection κ Y P :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
lemma bcSec_snd (P : Place κ Y.functionField) :
    bcSec (K' := K') P ≫ pullback.snd _ _ = 𝟙 _ :=
  pullback.lift_snd _ _ _

lemma bcSec_comp (P : Place κ Y.functionField) :
    bcSec P ≫ (bcY κ Y K' ↘ Spec (.of K')) = 𝟙 _ :=
  bcSec_snd P

/-- **Base change of places**: the place of `K(Y_{K'})` at `x_P ×_κ K'`. -/
def β (P : Place κ Y.functionField) : Place K' (bcY κ Y K').functionField :=
  (exists_eq_placeSection (bcSec P) (bcSec_comp P)).choose

lemma placeSection_β (P : Place κ Y.functionField) :
    placeSection K' (bcY κ Y K') (β P) = bcSec P :=
  (exists_eq_placeSection (bcSec P) (bcSec_comp P)).choose_spec.symm

lemma pointOfPlace_β (P : Place κ Y.functionField) :
    pointOfPlace K' (bcY κ Y K') (β P) = bcSec P (IsLocalRing.closedPoint K') := by
  rw [← placeSection_β, placeSection_apply]

lemma bcFst_pointOfPlace_β (P : Place κ Y.functionField) :
    bcFst κ Y K' (pointOfPlace K' (bcY κ Y K') (β P)) = pointOfPlace κ Y P := by
  rw [pointOfPlace_β, ← Scheme.Hom.comp_apply, bcSec_fst, Scheme.Hom.comp_apply,
    placeSection_apply]

/-- The square `Spec K' ⟶ Y_{K'}` over `x_P : Spec κ ⟶ Y` is cartesian. -/
lemma isPullback_bcSec (P : Place κ Y.functionField) :
    IsPullback (bcSec P) (specAlgebraMap κ K') (bcFst κ Y K') (placeSection κ Y P) := by
  have hright : IsPullback (pullback.snd (Y ↘ Spec (.of κ)) (specAlgebraMap κ K'))
      (bcFst κ Y K') (specAlgebraMap κ K') (Y ↘ Spec (.of κ)) :=
    (IsPullback.of_hasPullback _ _).flip
  have houter : IsPullback (bcSec P ≫ pullback.snd _ _) (specAlgebraMap κ K')
      (specAlgebraMap κ K') (placeSection κ Y P ≫ (Y ↘ Spec (.of κ))) := by
    rw [bcSec_snd, placeSection_comp]
    exact IsPullback.of_horiz_isIso ⟨by simp⟩
  exact IsPullback.of_right houter (by simp) hright

instance isClosedImmersion_placeSection (P : Place κ Y.functionField) :
    IsClosedImmersion (placeSection κ Y P) := by
  haveI : IsClosedImmersion (placeSection κ Y P ≫ (Y ↘ Spec (.of κ))) := by
    rw [placeSection_comp]; infer_instance
  exact IsClosedImmersion.of_comp (placeSection κ Y P) (Y ↘ Spec (.of κ))

/-- **The ideal sheaf of the base-changed point is the pull-back of the ideal of `x_P`.** -/
lemma ker_bcSec (P : Place κ Y.functionField) :
    (bcSec (K' := K') P).ker = (placeSection κ Y P).ker.comap (bcFst κ Y K') := by
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion,
    ← (isPullback_bcSec P).isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso]

/-! ### The base-changed uniformizer -/

/-- The preimage `V_{K'}` of an affine open, as an affine open of `Y_{K'}`. -/
def bcAffine (V : Y.affineOpens) : (bcY κ Y K').affineOpens :=
  ⟨bcFst κ Y K' ⁻¹ᵁ V.1, Kummer.isAffineOpen_baseChangeOpen' κ K' V.2⟩

/-- `ι : K(Y) → K(Y_{K'})`, pull-back along the projection. -/
def ι : Y.functionField →+* (bcY κ Y K').functionField :=
  Kummer.functionFieldMap (bcFst κ Y K') (Kummer.fst_genericPoint κ K')

/-- On `V_{K'}`, the ideal of `x_P ×_κ K'` is generated by the pull-back of a uniformizer. -/
lemma ker_bcSec_ideal (P : Place κ Y.functionField) {V : Y.affineOpens} {π : Γ(Y, V.1)}
    (hP : pointOfPlace κ Y P ∈ V.1) (hπ : π ≠ 0) (h1 : ordAt P hP π = 1)
    (hz : ∀ y ∈ V.1, y ∉ Y.basicOpen π → y = pointOfPlace κ Y P) :
    (bcSec (K' := K') P).ker.ideal (bcAffine V) = Ideal.span {(bcFst κ Y K').app V.1 π} := by
  rw [ker_bcSec, Scheme.IdealSheafData.ideal_comap_of_le _ _ V (bcAffine V) le_rfl,
    ker_ideal_eq_span_uniformizer (placeSection κ Y P) (placeSection_apply P) hP hπ h1 hz,
    Ideal.map_span, Set.image_singleton, Scheme.Hom.app_eq_appLE]
  rfl

lemma mem_bcAffine {V : Y.affineOpens} {q : bcY κ Y K'} :
    q ∈ (bcAffine (K' := K') V).1 ↔ bcFst κ Y K' q ∈ V.1 := Iff.rfl

/-- The order of the pulled-back uniformizer: `1` at `β P`, `0` at the other places over
`V_{K'}`. -/
lemma ordAt_bc (P : Place κ Y.functionField) {V : Y.affineOpens} {π : Γ(Y, V.1)}
    (hP : pointOfPlace κ Y P ∈ V.1) (hπ : π ≠ 0) (h1 : ordAt P hP π = 1)
    (hz : ∀ y ∈ V.1, y ∉ Y.basicOpen π → y = pointOfPlace κ Y P)
    (Q : Place K' (bcY κ Y K').functionField)
    (hQ : pointOfPlace K' (bcY κ Y K') Q ∈ (bcAffine (K' := K') V).1) :
    (bcFst κ Y K').app V.1 π ≠ 0 ∧
      ordAt Q hQ ((bcFst κ Y K').app V.1 π) = Finsupp.single (β P) 1 Q := by
  have hdiv := hasDiv_ker_placeSection (β (K' := K') P)
  rw [placeSection_β] at hdiv
  exact hdiv (bcAffine V) _ (ker_bcSec_ideal P hP hπ h1 hz) Q hQ

lemma pointOfPlace_ne_genericPoint {k : Type u} [Field k] [PerfectField k] {X : Scheme.{u}}
    [X.Over (Spec (.of k))] [IsCurveOver k X] [IsIntegral X] (P : Place k X.functionField) :
    pointOfPlace k X P ≠ genericPoint X :=
  ((curvePlaceEquiv k X).symm P).2

/-- **Only one point over `x_P`**: every point of `Y_{K'}` over `x_P` is `x_P ×_κ K'`. -/
theorem eq_pointOfPlace_β (P : Place κ Y.functionField) {q : bcY κ Y K'}
    (hq : bcFst κ Y K' q = pointOfPlace κ Y P) : q = pointOfPlace K' (bcY κ Y K') (β P) := by
  obtain ⟨V, π, hP, hπ, h1, hz⟩ := exists_uniformizer κ P
  have hqV : q ∈ (bcAffine (K' := K') V).1 := by rw [mem_bcAffine, hq]; exact hP
  have hqg : q ≠ genericPoint (bcY κ Y K') := fun h ↦ by
    have := Kummer.fst_genericPoint (X := Y) κ K'
    rw [← h, hq] at this
    exact pointOfPlace_ne_genericPoint P this
  set Q := curvePlaceEquiv K' (bcY κ Y K') ⟨q, hqg⟩
  have hQq : pointOfPlace K' (bcY κ Y K') Q = q := by
    simp [Q, pointOfPlace]
  have hQ : pointOfPlace K' (bcY κ Y K') Q ∈ (bcAffine (K' := K') V).1 := by rw [hQq]; exact hqV
  obtain ⟨h0, hord⟩ := ordAt_bc P hP hπ h1 hz Q hQ
  have hpos : 0 < ordAt Q hQ ((bcFst κ Y K').app V.1 π) := by
    rw [ordAt_pos_iff Q hQ h0, hQq]
    intro hmem
    have hmem' : q ∈ bcFst κ Y K' ⁻¹ᵁ Y.basicOpen π := by
      rw [Scheme.preimage_basicOpen]; exact hmem
    have hyπ : pointOfPlace κ Y P ∉ Y.basicOpen π := by
      rw [← ordAt_pos_iff P hP hπ, h1]; exact one_pos
    exact hyπ (hq ▸ hmem')
  rw [hord, Finsupp.single_apply] at hpos
  split_ifs at hpos with hβ
  · rw [← hQq, hβ]
  · exact absurd hpos (lt_irrefl 0)

/-! ### Orders and values at base-changed places -/

lemma ι_mem_of_mem (Q : Place K' (bcY κ Y K').functionField) {f : Y.functionField}
    (hf : f ∈ stalkValuationSubring (valuationRing_stalk_of_isCurveOver κ Y)
      (bcFst κ Y K' (pointOfPlace K' (bcY κ Y K') Q))) : ι f ∈ Q.1 := by
  obtain ⟨t, rfl⟩ := hf
  rw [place_val_eq]
  exact ⟨_, Kummer.algebraMap_stalkMap _ _ _ t⟩

lemma ι_mem_β (P : Place κ Y.functionField) {f : Y.functionField} (hf : f ∈ P.1) :
    ι f ∈ (β (K' := K') P).1 := by
  apply ι_mem_of_mem
  rw [bcFst_pointOfPlace_β, ← place_val_eq]
  exact hf

lemma ord_ι_β_of_ord_eq_zero (P : Place κ Y.functionField) {u : Y.functionField} (hu : u ≠ 0)
    (h : P.ord u = 0) : (β (K' := K') P).ord (ι u) = 0 := by
  obtain ⟨h1, h2⟩ := (P.ord_eq_zero_iff hu).1 h
  refine ((β P).ord_eq_zero_iff ((map_ne_zero ι).mpr hu)).2 ⟨ι_mem_β P h1, ?_⟩
  rw [← map_inv₀]
  exact ι_mem_β P h2

/-- **`ord_{β P}(ι f) = ord_P f`**. -/
theorem ord_β (P : Place κ Y.functionField) (f : Y.functionField) :
    (β (K' := K') P).ord (ι f) = P.ord f := by
  rcases eq_or_ne f 0 with rfl | hf
  · simp
  obtain ⟨V, π, hP, hπ, h1, hz⟩ := exists_uniformizer κ P
  haveI : Nonempty V.1 := ⟨⟨_, hP⟩⟩
  have hQ : pointOfPlace K' (bcY κ Y K') (β P) ∈ (bcAffine (K' := K') V).1 := by
    rw [mem_bcAffine, bcFst_pointOfPlace_β]; exact hP
  haveI : Nonempty (bcAffine (K' := K') V).1 := ⟨⟨_, hQ⟩⟩
  haveI : Nonempty (bcFst κ Y K' ⁻¹ᵁ V.1) := ⟨⟨_, hQ⟩⟩
  obtain ⟨h0, hord⟩ := ordAt_bc P hP hπ h1 hz (β P) hQ
  rw [Finsupp.single_eq_same] at hord
  set π₀ := Y.germToFunctionField V.1 π
  have hπ₀ : P.ord π₀ = 1 := by rw [← ordAt_eq_ord_germToFunctionField P hP]; exact h1
  have hιπ : (β (K' := K') P).ord (ι π₀) = 1 := by
    rw [ι, Kummer.functionFieldMap_germ, ← hord]
    exact (ordAt_eq_ord_germToFunctionField (β P) hQ _).symm
  obtain ⟨u, hu0, hu, hfu⟩ := eq_zpow_mul_unit P hπ₀ hf
  have hπ0 : π₀ ≠ 0 := by rintro h; rw [h, Place.ord_zero] at hπ₀; exact zero_ne_one hπ₀
  conv_lhs => rw [hfu, map_mul, map_zpow₀]
  rw [(β P).ord_mul (zpow_ne_zero _ ((map_ne_zero ι).mpr hπ0)) ((map_ne_zero ι).mpr hu0),
    (β P).ord_zpow, hιπ, ord_ι_β_of_ord_eq_zero P hu0 hu, mul_one, add_zero]

/-- **No other zeros or poles**: `ι f` has no zeros or poles outside the base-changed places. -/
theorem ord_ι_of_ne_β (Q : Place K' (bcY κ Y K').functionField) {f : Y.functionField}
    (hf : f ≠ 0) (hQ : ∀ P, Q ≠ β P) : Q.ord (ι f) = 0 := by
  haveI := isSeparated_of_over κ Y
  set hX := valuationRing_stalk_of_isCurveOver κ Y
  set z := bcFst κ Y K' (pointOfPlace K' (bcY κ Y K') Q)
  by_cases hz : z = genericPoint Y
  · have htop : stalkValuationSubring hX z = ⊤ := (stalkValuationSubring_eq_top_iff hX z).2 hz
    refine (Q.ord_eq_zero_iff ((map_ne_zero ι).mpr hf)).2 ⟨ι_mem_of_mem Q ?_, ?_⟩
    · rw [htop]; trivial
    · rw [← map_inv₀]; exact ι_mem_of_mem Q (by rw [htop]; trivial)
  · exfalso
    set P := curvePlaceEquiv κ Y ⟨z, hz⟩
    have hPz : pointOfPlace κ Y P = z := by simp [P, pointOfPlace]
    exact hQ P (pointOfPlace_injective K' (bcY κ Y K') (eq_pointOfPlace_β P hPz.symm))

/-- `ι` is compatible with the constants: `ι(c) = c` for `c ∈ κ`. -/
theorem ι_algebraMap (c : κ) :
    ι (K' := K') (algebraMap κ Y.functionField c) =
      algebraMap K' (bcY κ Y K').functionField (algebraMap κ K' c) := by
  change Kummer.functionFieldMap _ _ (Y.presheaf.germ ⊤ (genericPoint Y) trivial
      ((Y ↘ Spec (.of κ)).appTop ((Scheme.ΓSpecIso (.of κ)).inv c))) =
    (bcY κ Y K').presheaf.germ ⊤ (genericPoint _) trivial
      ((bcY κ Y K' ↘ Spec (.of K')).appTop ((Scheme.ΓSpecIso (.of K')).inv (algebraMap κ K' c)))
  have h1 := Kummer.functionFieldMap_germ (bcFst κ Y K') (Kummer.fst_genericPoint κ K') ⊤
    ((Y ↘ Spec (.of κ)).appTop ((Scheme.ΓSpecIso (.of κ)).inv c))
  refine h1.trans ?_
  have h2 : (bcFst κ Y K').app ⊤ ((Y ↘ Spec (.of κ)).appTop ((Scheme.ΓSpecIso (.of κ)).inv c)) =
      (bcY κ Y K' ↘ Spec (.of K')).appTop ((Scheme.ΓSpecIso (.of K')).inv (algebraMap κ K' c)) := by
    rw [over_bcY]
    change (bcFst κ Y K' ≫ (Y ↘ Spec (.of κ))).appTop _ = _
    rw [pullback.condition, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    congr 1
    have := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap κ K'))
    exact (congrArg (fun φ ↦ φ.hom c) this).symm
  rw [h2]
  rfl

/-- **Values at base-changed places**: `(ι f)(β P) = f(P)`. -/
theorem val_β (P : Place κ Y.functionField) {f : Y.functionField} (hf : f ∈ P.1) :
    Place.val (β (K' := K') P) (ι f) = algebraMap κ K' (Place.val P f) := by
  have h := (Place.val_eq_iff P hf (Place.val P f)).mp rfl
  rw [Place.val_eq_iff _ (ι_mem_β P hf), ← ι_algebraMap, ← map_sub, ord_β,
    map_eq_zero_iff _ (ι (κ := κ) (Y := Y) (K' := K')).injective]
  exact h

/-! ### Values via rational points -/

section Value

variable {k : Type u} [Field k] [IsAlgClosed k] {X : Scheme.{u}} [X.Over (Spec (.of k))]
  [IsCurveOver k X] [IsIntegral X]

/-- The structure map `k → 𝒪_{X,x}`. -/
def stalkConst (x : X) : CommRingCat.of k ⟶ X.presheaf.stalk x :=
  (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (X ↘ Spec (CommRingCat.of k)).appTop ≫
    X.presheaf.germ ⊤ x trivial

lemma algebraMap_stalkConst (x : X) (c : k) :
    algebraMap (X.presheaf.stalk x) X.functionField ((stalkConst x).hom c) =
      algebraMap k X.functionField c := by
  change (X.presheaf.germ ⊤ x trivial ≫ X.presheaf.stalkSpecializes _).hom
      (((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (X ↘ Spec (CommRingCat.of k)).appTop).hom c) =
    (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
      (((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (X ↘ Spec (CommRingCat.of k)).appTop).hom c)
  rw [TopCat.Presheaf.germ_stalkSpecializes]

lemma stalkClosedPointTo_stalkConst (s : Spec (.of k) ⟶ X) (hs : s ≫ (X ↘ Spec (.of k)) = 𝟙 _)
    (c : k) :
    (Scheme.stalkClosedPointTo s).hom ((stalkConst (s (IsLocalRing.closedPoint k))).hom c) = c := by
  have h := Scheme.germ_stalkClosedPointTo s ⊤ trivial
  change ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (X ↘ Spec (CommRingCat.of k)).appTop ≫
    X.presheaf.germ ⊤ _ trivial ≫ Scheme.stalkClosedPointTo s).hom c = c
  rw [h]
  have h2 : (X ↘ Spec (CommRingCat.of k)).appTop ≫ s.app ⊤ = (s ≫ (X ↘ Spec (.of k))).appTop :=
    (Scheme.Hom.comp_appTop s _).symm
  simp only [← Category.assoc]
  rw [Category.assoc (Scheme.ΓSpecIso (CommRingCat.of k)).inv, h2, hs]
  simp

/-- **Values via rational points**: for a section `s` through the point of `Q` and
`t ∈ 𝒪_{X, s(pt)}`, the value of `t` at `Q` is `s^♯ t`. -/
theorem val_algebraMap_stalk (Q : Place k X.functionField) (s : Spec (.of k) ⟶ X)
    (hs : s ≫ (X ↘ Spec (.of k)) = 𝟙 _)
    (hx : s (IsLocalRing.closedPoint k) = pointOfPlace k X Q)
    (t : X.presheaf.stalk (s (IsLocalRing.closedPoint k))) :
    Place.val Q (algebraMap _ X.functionField t) = (Scheme.stalkClosedPointTo s).hom t := by
  have hmem : ∀ t' : X.presheaf.stalk (s (IsLocalRing.closedPoint k)),
      algebraMap _ X.functionField t' ∈ Q.1 := fun t' ↦ by
    rw [place_val_eq, ← hx]; exact ⟨t', rfl⟩
  rw [Place.val_eq_iff Q (hmem t)]
  obtain ⟨t', ht'⟩ : ∃ t' : X.presheaf.stalk (s (IsLocalRing.closedPoint k)),
      t' = t - (stalkConst _).hom ((Scheme.stalkClosedPointTo s).hom t) := ⟨_, rfl⟩
  have ht'' : algebraMap _ X.functionField t' = algebraMap _ X.functionField t -
      algebraMap k X.functionField ((Scheme.stalkClosedPointTo s).hom t) := by
    rw [ht', map_sub, algebraMap_stalkConst]
  have hev : (Scheme.stalkClosedPointTo s).hom t' = 0 := by
    rw [ht', map_sub, stalkClosedPointTo_stalkConst s hs, sub_self]
  rw [← ht'']
  by_cases h0 : algebraMap _ X.functionField t' = 0
  · exact Or.inl h0
  · right
    change 0 < Q.ord ((⟨_, hmem t'⟩ : Q.1) : X.functionField)
    rw [Q.ord_pos_iff_mem_maximalIdeal h0, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨w, hw⟩ := hu.exists_right_inv
    obtain ⟨s', hs'⟩ : (w : X.functionField) ∈ stalkValuationSubring
        (valuationRing_stalk_of_isCurveOver k X) (s (IsLocalRing.closedPoint k)) := by
      have h := place_val_eq k X Q
      rw [← hx] at h
      exact h ▸ w.2
    have h1 : t' * s' = 1 := algebraMap_stalk_injective _ (by
      rw [map_mul, map_one, hs']
      exact congrArg Subtype.val hw)
    have := (show IsUnit t' from ⟨⟨t', s', h1, by rw [mul_comm]; exact h1⟩, rfl⟩).map
      (Scheme.stalkClosedPointTo s).hom
    rw [hev] at this
    exact not_isUnit_zero this

end Value

/-! ### The generic point -/

section Generic

variable [Algebra Y.functionField K'] [IsScalarTower κ Y.functionField K']

instance isLocalHom_algebraMap_functionField :
    IsLocalHom (CommRingCat.ofHom (algebraMap Y.functionField K')).hom :=
  ⟨fun a ha ↦ (isUnit_iff_ne_zero).mpr fun h0 ↦ by simp [h0] at ha⟩

/-- `Spec K' ⟶ Spec K(Y) ⟶ Y`. -/
def ptη : Spec (.of K') ⟶ Y :=
  Spec.map (CommRingCat.ofHom (algebraMap Y.functionField K')) ≫ Y.fromSpecStalk (genericPoint Y)

lemma ptη_comp : ptη (Y := Y) (K' := K') ≫ (Y ↘ Spec (.of κ)) =
    specAlgebraMap κ K' := by
  rw [ptη, Category.assoc, ← specMap_algebraMap_functionField, ← Spec.map_comp,
    ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
  rfl

/-- **The generic `K'`-point** `η = (Spec K' → Spec K(Y) → Y) ×_κ K'` of `Y_{K'}`. -/
def secη : Spec (.of K') ⟶ bcY κ Y K' :=
  pullback.lift ptη (𝟙 _) (by rw [ptη_comp, Category.id_comp])

@[reassoc (attr := simp)]
lemma secη_fst : secη (κ := κ) (Y := Y) (K' := K') ≫ bcFst κ Y K' = ptη :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
lemma secη_snd : secη (κ := κ) (Y := Y) (K' := K') ≫ pullback.snd _ _ = 𝟙 _ :=
  pullback.lift_snd _ _ _

/-- The place `η` of `K(Y_{K'})` at the generic `K'`-point. -/
def η : Place K' (bcY κ Y K').functionField :=
  (exists_eq_placeSection (secη (κ := κ) (Y := Y) (K' := K')) secη_snd).choose

lemma placeSection_η :
    placeSection K' (bcY κ Y K') (η (κ := κ) (Y := Y) (K' := K')) = secη :=
  (exists_eq_placeSection _ secη_snd).choose_spec.symm

lemma pointOfPlace_η : pointOfPlace K' (bcY κ Y K') (η (κ := κ) (Y := Y) (K' := K')) =
    secη (IsLocalRing.closedPoint K') := by
  rw [← placeSection_η, placeSection_apply]

lemma bcFst_secη : bcFst κ Y K' (secη (κ := κ) (Y := Y) (K' := K') (IsLocalRing.closedPoint K')) =
    genericPoint Y := by
  rw [← Scheme.Hom.comp_apply, secη_fst, ptη, Scheme.Hom.comp_apply, Spec_closedPoint,
    Scheme.fromSpecStalk_closedPoint]

lemma η_ne_β (P : Place κ Y.functionField) : η (κ := κ) (Y := Y) (K' := K') ≠ β P := by
  intro h
  have h1 := bcFst_pointOfPlace_β (K' := K') P
  rw [← h, pointOfPlace_η, bcFst_secη] at h1
  exact pointOfPlace_ne_genericPoint P h1.symm

/-- `s^♯` for `s = Spec φ ≫ (Spec 𝒪_{Y,ξ} ⟶ Y)` (`ξ` generic) is `φ` on germs. -/
lemma stalkClosedPointTo_ptη (F : Spec (.of K') ⟶ Y) (hF : F = ptη)
    (t : Y.presheaf.stalk (F (IsLocalRing.closedPoint K'))) :
    (Scheme.stalkClosedPointTo F).hom t =
      algebraMap Y.functionField K' (algebraMap _ Y.functionField t) := by
  subst hF
  obtain ⟨U, hU, a, rfl⟩ := Y.presheaf.exists_germ_eq t
  have h := Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk
    (CommRingCat.ofHom (algebraMap Y.functionField K')) U hU
  have h2 := congrArg (fun φ ↦ φ.hom a) h
  refine h2.trans ?_
  change algebraMap Y.functionField K' (Y.presheaf.germ U (genericPoint Y) _ a) = _
  congr 1
  exact (TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _).symm

/-- **The value at the generic point**: `(ι f)(η) = f ∈ K'`. -/
theorem val_η (f : Y.functionField) :
    Place.val (η (κ := κ) (Y := Y) (K' := K')) (ι f) = algebraMap Y.functionField K' f := by
  haveI := isSeparated_of_over κ Y
  set hX := valuationRing_stalk_of_isCurveOver κ Y
  have htop : stalkValuationSubring hX (bcFst κ Y K' (secη (IsLocalRing.closedPoint K'))) = ⊤ :=
    (stalkValuationSubring_eq_top_iff hX _).2 bcFst_secη
  obtain ⟨t, ht⟩ : f ∈ stalkValuationSubring hX
      (bcFst κ Y K' (secη (κ := κ) (Y := Y) (K' := K') (IsLocalRing.closedPoint K'))) := by
    rw [htop]; trivial
  have hι : ι f = algebraMap _ (bcY κ Y K').functionField
      ((bcFst κ Y K').stalkMap (secη (IsLocalRing.closedPoint K')) t) := by
    rw [Kummer.algebraMap_stalkMap, ← ht]; rfl
  rw [hι, val_algebraMap_stalk η secη secη_snd pointOfPlace_η.symm]
  have hc := Scheme.stalkClosedPointTo_comp (secη (κ := κ) (Y := Y) (K' := K')) (bcFst κ Y K')
  have h3 := congrArg (fun φ ↦ φ.hom t) hc
  have h4 : (Scheme.stalkClosedPointTo (secη ≫ bcFst κ Y K')).hom t =
      algebraMap Y.functionField K' f := by
    rw [stalkClosedPointTo_ptη _ secη_fst]
    exact congrArg _ ht
  exact h3.symm.trans h4

/-! ### The action of `Aut(K'/K(Y))` -/

section FFMap

variable {X₁ X₂ X₃ : Scheme.{u}} [IsIntegral X₁] [IsIntegral X₂] [IsIntegral X₃]

lemma functionFieldMap_comp (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
    (hf : f (genericPoint X₁) = genericPoint X₂) (hg : g (genericPoint X₂) = genericPoint X₃)
    (hfg : (f ≫ g) (genericPoint X₁) = genericPoint X₃) :
    Kummer.functionFieldMap (f ≫ g) hfg =
      (Kummer.functionFieldMap f hf).comp (Kummer.functionFieldMap g hg) := by
  ext a
  obtain ⟨U, hU, s, rfl⟩ := X₃.presheaf.exists_germ_eq a
  haveI : Nonempty U := ⟨⟨_, hU⟩⟩
  haveI : Nonempty ((f ≫ g) ⁻¹ᵁ U) := ⟨⟨_, by
    change (f ≫ g) (genericPoint X₁) ∈ U; rw [hfg]; exact hU⟩⟩
  haveI : Nonempty (g ⁻¹ᵁ U) := ⟨⟨_, by change g (genericPoint X₂) ∈ U; rw [hg]; exact hU⟩⟩
  haveI : Nonempty (f ⁻¹ᵁ (g ⁻¹ᵁ U)) := ⟨⟨_, by
    change g (f (genericPoint X₁)) ∈ U; rw [hf, hg]; exact hU⟩⟩
  change Kummer.functionFieldMap (f ≫ g) hfg (X₃.germToFunctionField U s) =
    Kummer.functionFieldMap f hf (Kummer.functionFieldMap g hg (X₃.germToFunctionField U s))
  rw [Kummer.functionFieldMap_germ, Kummer.functionFieldMap_germ, Kummer.functionFieldMap_germ]
  rfl

end FFMap

variable (δ : K' ≃+* K') (hδ : ∀ x, δ (algebraMap Y.functionField K' x) =
  algebraMap Y.functionField K' x)

include hδ in
lemma δ_algebraMap (c : κ) : δ (algebraMap κ K' c) = algebraMap κ K' c := by
  rw [IsScalarTower.algebraMap_apply κ Y.functionField K', hδ]

include hδ in
lemma specMap_δ_comp : Spec.map (CommRingCat.ofHom (δ : K' →+* K')) ≫ specAlgebraMap κ K' =
    specAlgebraMap κ K' := by
  rw [specAlgebraMap, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  ext c
  exact δ_algebraMap δ hδ c

/-- The automorphism `𝟙_Y ×_κ Spec(δ)` of `Y_{K'}`. -/
def actMap : bcY κ Y K' ⟶ bcY κ Y K' :=
  bcMap (Y ↘ Spec (.of κ)) (Spec.map (CommRingCat.ofHom (δ : K' →+* K'))) (specAlgebraMap κ K')
    (specAlgebraMap κ K') (specMap_δ_comp (κ := κ) δ hδ)

@[reassoc (attr := simp)]
lemma actMap_fst : actMap (κ := κ) δ hδ ≫ bcFst κ Y K' = bcFst κ Y K' := bcMap_fst _ _ _ _ _

@[reassoc (attr := simp)]
lemma actMap_snd : actMap (κ := κ) δ hδ ≫ pullback.snd _ _ =
    pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (δ : K' →+* K')) := bcMap_snd _ _ _ _ _

include hδ in
lemma symm_fixes : ∀ x, δ.symm (algebraMap Y.functionField K' x) =
    algebraMap Y.functionField K' x := fun x ↦ by
  rw [RingEquiv.symm_apply_eq, hδ]

lemma actMap_comp_symm : actMap (κ := κ) δ hδ ≫ actMap (κ := κ) δ.symm (symm_fixes δ hδ) = 𝟙 _ := by
  apply pullback.hom_ext
  · simp
  · rw [Category.assoc, actMap_snd, actMap_snd_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    simp

lemma actMap_symm_comp : actMap (κ := κ) δ.symm (symm_fixes δ hδ) ≫ actMap (κ := κ) δ hδ = 𝟙 _ := by
  apply pullback.hom_ext
  · simp
  · rw [Category.assoc, actMap_snd, actMap_snd_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    simp

instance isIso_actMap : IsIso (actMap (κ := κ) δ hδ) :=
  ⟨actMap (κ := κ) δ.symm (symm_fixes δ hδ), actMap_comp_symm δ hδ, actMap_symm_comp δ hδ⟩

lemma actMap_genericPoint :
    actMap (κ := κ) δ hδ (genericPoint (bcY κ Y K')) = genericPoint (bcY κ Y K') :=
  genericPoint_eq_of_isOpenImmersion _

lemma functionFieldMap_eq_id (f : bcY κ Y K' ⟶ bcY κ Y K') (hf : f = 𝟙 _)
    (hg : f (genericPoint _) = genericPoint _) (a : (bcY κ Y K').functionField) :
    Kummer.functionFieldMap f hg a = a := by
  subst hf
  obtain ⟨U, hU, s, rfl⟩ := (bcY κ Y K').presheaf.exists_germ_eq a
  haveI : Nonempty U := ⟨⟨_, hU⟩⟩
  haveI : Nonempty ((𝟙 (bcY κ Y K')) ⁻¹ᵁ U) := ⟨⟨_, hU⟩⟩
  change Kummer.functionFieldMap (𝟙 _) hg ((bcY κ Y K').germToFunctionField U s) =
    (bcY κ Y K').germToFunctionField U s
  rw [Kummer.functionFieldMap_germ]
  rfl

lemma functionFieldMap_congr {f g : bcY κ Y K' ⟶ bcY κ Y K'} (h : f = g)
    (hf : f (genericPoint _) = genericPoint _) (hg : g (genericPoint _) = genericPoint _) :
    Kummer.functionFieldMap f hf = Kummer.functionFieldMap g hg := by
  subst h; rfl

/-- **The semilinear action** `φ_δ = (𝟙_Y ×_κ Spec δ)^*` on `K(Y_{K'})`. -/
def actFF : (bcY κ Y K').functionField ≃+* (bcY κ Y K').functionField where
  toFun := Kummer.functionFieldMap (actMap (κ := κ) δ hδ) (actMap_genericPoint δ hδ)
  invFun := Kummer.functionFieldMap (actMap (κ := κ) δ.symm (symm_fixes δ hδ))
    (actMap_genericPoint δ.symm (symm_fixes δ hδ))
  left_inv a := by
    have h := functionFieldMap_comp (actMap (κ := κ) δ.symm (symm_fixes δ hδ))
      (actMap (κ := κ) δ hδ) (actMap_genericPoint _ _) (actMap_genericPoint _ _)
      (by rw [actMap_symm_comp]; rfl)
    have h2 := congrArg (fun φ ↦ φ a) h
    simp only [RingHom.coe_comp, Function.comp_apply] at h2
    rw [← h2]
    exact functionFieldMap_eq_id _ (actMap_symm_comp δ hδ) _ a
  right_inv a := by
    have h := functionFieldMap_comp (actMap (κ := κ) δ hδ)
      (actMap (κ := κ) δ.symm (symm_fixes δ hδ)) (actMap_genericPoint _ _)
      (actMap_genericPoint _ _) (by rw [actMap_comp_symm]; rfl)
    have h2 := congrArg (fun φ ↦ φ a) h
    simp only [RingHom.coe_comp, Function.comp_apply] at h2
    rw [← h2]
    exact functionFieldMap_eq_id _ (actMap_comp_symm δ hδ) _ a
  map_mul' := map_mul _
  map_add' := map_add _

lemma actFF_apply (a : (bcY κ Y K').functionField) :
    actFF (κ := κ) δ hδ a =
      Kummer.functionFieldMap (actMap (κ := κ) δ hδ) (actMap_genericPoint δ hδ) a := rfl

/-- `φ_δ` fixes `K(Y)`. -/
theorem actFF_ι (f : Y.functionField) : actFF (κ := κ) δ hδ (ι f) = ι f := by
  rw [actFF_apply, ι]
  have h := functionFieldMap_comp (actMap (κ := κ) δ hδ) (bcFst κ Y K')
    (actMap_genericPoint δ hδ) (Kummer.fst_genericPoint κ K')
    (by rw [actMap_fst]; exact Kummer.fst_genericPoint κ K')
  have h2 := congrArg (fun φ ↦ φ f) h
  simp only [RingHom.coe_comp, Function.comp_apply] at h2
  rw [← h2]
  have h3 : Kummer.functionFieldMap (actMap (κ := κ) δ hδ ≫ bcFst κ Y K')
      (by rw [actMap_fst]; exact Kummer.fst_genericPoint κ K') =
      Kummer.functionFieldMap (bcFst κ Y K') (Kummer.fst_genericPoint κ K') := by
    congr 1
    exact actMap_fst δ hδ
  rw [h3]

/-- `φ_δ` is `δ`-semilinear. -/
theorem actFF_algebraMap (c : K') :
    actFF (κ := κ) δ hδ (algebraMap K' (bcY κ Y K').functionField c) =
      algebraMap K' (bcY κ Y K').functionField (δ c) := by
  change Kummer.functionFieldMap (actMap (κ := κ) δ hδ) (actMap_genericPoint δ hδ)
      ((bcY κ Y K').presheaf.germ ⊤ (genericPoint _) trivial
        ((bcY κ Y K' ↘ Spec (.of K')).appTop ((Scheme.ΓSpecIso (.of K')).inv c))) =
    (bcY κ Y K').presheaf.germ ⊤ (genericPoint _) trivial
      ((bcY κ Y K' ↘ Spec (.of K')).appTop ((Scheme.ΓSpecIso (.of K')).inv (δ c)))
  haveI : Nonempty ((actMap (κ := κ) δ hδ) ⁻¹ᵁ ⊤) := ⟨⟨genericPoint _, trivial⟩⟩
  have h1 := Kummer.functionFieldMap_germ (actMap (κ := κ) δ hδ) (actMap_genericPoint δ hδ) ⊤
    ((bcY κ Y K' ↘ Spec (.of K')).appTop ((Scheme.ΓSpecIso (.of K')).inv c))
  refine h1.trans ?_
  have h2 : (actMap (κ := κ) δ hδ).app ⊤
      ((bcY κ Y K' ↘ Spec (.of K')).appTop ((Scheme.ΓSpecIso (.of K')).inv c)) =
      (bcY κ Y K' ↘ Spec (.of K')).appTop ((Scheme.ΓSpecIso (.of K')).inv (δ c)) := by
    rw [over_bcY]
    change (actMap (κ := κ) δ hδ ≫ pullback.snd _ _).appTop _ = _
    rw [actMap_snd, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    congr 1
    have := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (δ : K' →+* K'))
    exact (congrArg (fun φ ↦ φ.hom c) this).symm
  rw [h2]
  rfl

instance isLocalHom_δ : IsLocalHom (CommRingCat.ofHom (δ : K' →+* K')).hom :=
  ⟨fun a ha ↦ (isUnit_iff_ne_zero).mpr fun h0 ↦ by simp [h0] at ha⟩

lemma bcSec_actMap (P : Place κ Y.functionField) :
    bcSec P ≫ actMap (κ := κ) δ hδ = Spec.map (CommRingCat.ofHom (δ : K' →+* K')) ≫ bcSec P := by
  apply pullback.hom_ext
  · rw [Category.assoc, actMap_fst, bcSec_fst, Category.assoc, bcSec_fst, ← Category.assoc,
      specMap_δ_comp δ hδ]
  · simp

lemma secη_actMap :
    secη ≫ actMap (κ := κ) δ hδ = Spec.map (CommRingCat.ofHom (δ : K' →+* K')) ≫ secη := by
  apply pullback.hom_ext
  · rw [Category.assoc, actMap_fst, secη_fst, Category.assoc, secη_fst, ptη,
      ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 3
    ext x
    exact (hδ x).symm
  · simp

lemma actMap_apply_of_comp {s : Spec (.of K') ⟶ bcY κ Y K'}
    (hs : s ≫ actMap (κ := κ) δ hδ = Spec.map (CommRingCat.ofHom (δ : K' →+* K')) ≫ s) :
    actMap (κ := κ) δ hδ (s (IsLocalRing.closedPoint K')) = s (IsLocalRing.closedPoint K') := by
  rw [← Scheme.Hom.comp_apply, hs, Scheme.Hom.comp_apply, Spec_closedPoint]

/-- Places at points fixed by `𝟙 ×_κ Spec δ` are fixed by `φ_δ`. -/
lemma placeTr_actFF_of_fixed (Q : Place K' (bcY κ Y K').functionField)
    (hQ : actMap (κ := κ) δ hδ (pointOfPlace K' (bcY κ Y K') Q) = pointOfPlace K' (bcY κ Y K') Q) :
    placeTr (actFF (κ := κ) δ hδ) δ (actFF_algebraMap δ hδ) Q = Q := by
  set hY' := valuationRing_stalk_of_isCurveOver K' (bcY κ Y K')
  apply Place.ext
  ext x
  rw [mem_placeTr, place_val_eq]
  obtain ⟨a, rfl⟩ := (actFF (κ := κ) δ hδ).surjective x
  rw [RingEquiv.symm_apply_apply, actFF_apply,
    Kummer.functionFieldMap_mem_stalkValuationSubring_iff _ _ hY' hY', hQ]

theorem placeTr_β (P : Place κ Y.functionField) :
    placeTr (actFF (κ := κ) δ hδ) δ (actFF_algebraMap δ hδ) (β P) = β P := by
  refine placeTr_actFF_of_fixed δ hδ _ ?_
  rw [pointOfPlace_β]
  exact actMap_apply_of_comp δ hδ (bcSec_actMap δ hδ P)

theorem placeTr_η :
    placeTr (actFF (κ := κ) δ hδ) δ (actFF_algebraMap δ hδ) η = η := by
  refine placeTr_actFF_of_fixed δ hδ _ ?_
  rw [pointOfPlace_η]
  exact actMap_apply_of_comp δ hδ (secη_actMap δ hδ)

end Generic

/-! ### The datum and nondegeneracy -/

section Datum

variable (κ Y) [CharZero κ]
include κ

omit [IsAlgClosed κ] [IsCurveOver κ Y] in
lemma charZero_functionField : CharZero Y.functionField :=
  charZero_of_injective_algebraMap (algebraMap κ Y.functionField).injective

/-- `K' = K(Y)^alg`. -/
abbrev Kbar := AlgebraicClosure Y.functionField

omit [IsAlgClosed κ] [IsCurveOver κ Y] in
lemma charZero_kbar : CharZero (Kbar Y) :=
  haveI := charZero_functionField κ Y
  charZero_of_injective_algebraMap (algebraMap Y.functionField (Kbar Y)).injective

lemma exists_section : ∃ σ : Spec (.of κ) ⟶ Y, σ ≫ (Y ↘ Spec (.of κ)) = 𝟙 _ := by
  obtain ⟨P⟩ := (inferInstance : Nonempty (Place κ Y.functionField))
  exact ⟨placeSection κ Y P, placeSection_comp P⟩

lemma natCard_picTorsion_bc (n : ℕ) [NeZero n] :
    Nat.card (picTorsion (Kbar Y) (bcY κ Y (Kbar Y)).functionField n) =
      Nat.card (picTorsion κ Y.functionField n) := by
  haveI := charZero_kbar κ Y
  rw [natCard_picTorsion, natCard_picTorsion]
  congr 3
  exact Cusp.curveGenus_baseChange κ (Kbar Y) Y

/-- **The generic point datum of a curve** over an algebraically closed field of
characteristic `0`. -/
def datum : GenericPointDatum κ Y.functionField (Kbar Y) (bcY κ Y (Kbar Y)).functionField :=
  haveI := charZero_functionField κ Y
  haveI := charZero_kbar κ Y
  { j := algebraMap _ _
    ι := ι
    ι_algebraMap c := by
      rw [ι_algebraMap, IsScalarTower.algebraMap_apply κ Y.functionField (Kbar Y) c]
    β := β
    β_injective P P' h := pointOfPlace_injective κ Y (by
      rw [← bcFst_pointOfPlace_β (K' := Kbar Y) P, ← bcFst_pointOfPlace_β (K' := Kbar Y) P', h])
    ord_β := ord_β
    ord_of_notMem Q _ hf hQ := ord_ι_of_ne_β Q hf hQ
    val_β P f hf := by
      rw [val_β P hf, IsScalarTower.algebraMap_apply κ Y.functionField (Kbar Y)]
    η := η
    η_ne := η_ne_β
    val_η := val_η
    act δ hδ := actFF δ hδ
    act_ι := actFF_ι
    act_algebraMap := actFF_algebraMap
    act_β := placeTr_β
    act_η := placeTr_η
    divisible n hn x hx := by
      obtain ⟨σ, hσ⟩ := exists_section κ Y
      obtain ⟨y, hy⟩ := exists_nsmul_eq_picZero_of_charZero Y (Kbar Y) σ hσ hn ⟨x, hx⟩
      exact ⟨y, congrArg Subtype.val hy⟩
    finite n hn := by
      haveI : NeZero n := ⟨hn⟩
      refine Nat.finite_of_card_ne_zero ?_
      rw [natCard_picTorsion]
      exact pow_ne_zero _ hn
    card_le n hn := by
      haveI : NeZero n := ⟨hn⟩
      exact (natCard_picTorsion_bc κ Y n).le
    fixed c hc := (InfiniteGalois.mem_range_algebraMap_iff_fixed c).2 fun f ↦
      hc f.toRingEquiv f.commutes }

/-- **Nondegeneracy of the Weil pairing** for a curve `Y` over an algebraically closed field of
characteristic `0`: if `e_n(a, b) = 1` for all `b ∈ Pic(K(Y))[n]`, then `a = 0`. -/
theorem weilPairing_nondegenerate {n : ℕ} [NeZero n] (a : picTorsion κ Y.functionField n)
    (h : ∀ b, weilPairing n a b = 1) : a = 0 :=
  (datum κ Y).weilPairing_nondegenerate a h

end Datum

end CurvesJacobian.GenericPoint
