import Pi1.Surface.Profinite

/-!
# The maximal cuspidally central quotient of `Π̂_{g,1}` ([AbsTopIII] Prop. 1.4(ii), first part)

[AbsTopIII] Prop. 1.4(ii) (T3 l.1771–1795): for a proper curve `X` and `x ∈ X(k)`,
`U_x = X ∖ {x}`, there is an exact sequence `1 → I_x → Δ^{c-cn}_{U_x} → Δ_X → 1`, where
`Δ_{U_x} ↠ Δ^{c-cn}_{U_x}` is the maximal cuspidally central quotient (the maximal intermediate
quotient `Δ_{U_x} ↠ Q ↠ Δ_X` with `Ker(Q ↠ Δ_X)` central, [Mzk19] Def. 1.1(i)). Group-theoretic
model (`Δ_{U_x} ≅ Π̂_{g,1}`, `Δ_X ≅ Π̂_{g,0}`, `I_x = ⟨c⟩‾` for the cuspidal generator `c`):

* `cuspKernel g`: the closed normal subgroup of `Π̂_{g,1}` topologically normally generated by
  `c` (the kernel of `Π̂_{g,1} ↠ Π̂_{g,0}`, [AbsTopIII] Prop. 1.4(i));
* `ccnKernel g = \overline{[cuspKernel g, Π̂_{g,1}]}` and `CcnQuot g = Π̂_{g,1} ⧸ ccnKernel g`, the
  maximal quotient in which the image of `cuspKernel g` is central (`mk_mul_comm_of_mem`);
* **`ccnInertia_injective`**: for `g ≥ 1`, `ℤ̂ → CcnQuot g`, `k ↦ cᵏ`, is injective, i.e.
  `I_x ↪ Δ^{c-cn}_{U_x}` (the left half of the exact sequence). Proof: the Heisenberg quotients
  of pi1 (`heisX`, `heisY`, `heisT`) send `c` to a central element `heisT⁻¹` of order `n`, so they
  kill `ccnKernel g` (`ccnKernel_le_ker`).
-/

open CategoryTheory ProfiniteGrp ProfiniteGrp.ProfiniteCompletion Topology
open Pi1 Pi1.Profinite Pi1.SurfaceGen Pi1.SurfaceGroup

namespace CurvesJacobian.CuspCentral

variable (g : ℕ)

/-- The cuspidal generator `c ∈ Π̂_{g,1}`. -/
noncomputable abbrev cuspHat : ProfiniteSurfaceGroup g 1 :=
  etaFn (GrpCat.of (SurfaceGroup g 1)) (cusp 0)

/-- The closed normal subgroup of `Π̂_{g,1}` topologically normally generated by the cuspidal
inertia group (the kernel of `Δ_{U_x} ↠ Δ_X`). -/
noncomputable def cuspKernel : Subgroup (ProfiniteSurfaceGroup g 1) :=
  (Subgroup.normalClosure {cuspHat g}).topologicalClosure

instance : (cuspKernel g).Normal :=
  Subgroup.is_normal_topologicalClosure _

/-- `\overline{[N, Π̂_{g,1}]}` for `N = cuspKernel g`. -/
noncomputable def ccnKernel : Subgroup (ProfiniteSurfaceGroup g 1) :=
  (⁅cuspKernel g, ⊤⁆ : Subgroup (ProfiniteSurfaceGroup g 1)).topologicalClosure

instance : (ccnKernel g).Normal :=
  Subgroup.is_normal_topologicalClosure _

/-- **The maximal cuspidally central quotient** `Δ^{c-cn}_{U_x} = Π̂_{g,1} ⧸ ccnKernel g`. -/
abbrev CcnQuot : Type := ProfiniteSurfaceGroup g 1 ⧸ ccnKernel g

variable {g}

/-- The image of `cuspKernel g` in `CcnQuot g` is central. -/
theorem mk_mul_comm_of_mem {x : ProfiniteSurfaceGroup g 1} (hx : x ∈ cuspKernel g)
    (y : ProfiniteSurfaceGroup g 1) :
    (x : CcnQuot g) * (y : CcnQuot g) = (y : CcnQuot g) * (x : CcnQuot g) := by
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, eq_comm, QuotientGroup.eq]
  have h : _ ∈ ccnKernel g := Subgroup.le_topologicalClosure _
    (Subgroup.commutator_mem_commutator (G := ProfiniteSurfaceGroup g 1)
      ((cuspKernel g).inv_mem hx) (Subgroup.mem_top y⁻¹))
  rw [commutatorElement_def] at h
  convert h using 1
  group

/-! ### Heisenberg quotients -/

section Heis

variable (n : ℕ)

lemma heisT_mul_heisX : heisT n * heisX n = heisX n * heisT n := by
  ext p <;> simp [heisT, heisX, Equiv.Perm.mul_apply]

lemma heisT_mul_heisY : heisT n * heisY n = heisY n * heisT n := by
  ext p
  · simp [heisT, heisY, Equiv.Perm.mul_apply]
  · simp only [heisT, heisY, Equiv.Perm.mul_apply, Equiv.coe_fn_mk]
    ring

/-- `a₁ ↦ heisX`, `aᵢ ↦ 1` (`i ≥ 2`). -/
def heisA : Fin (g + 1) → Equiv.Perm (ZMod n × ZMod n) := Fin.cases (heisX n) fun _ ↦ 1

/-- `b₁ ↦ heisY`, `bᵢ ↦ 1` (`i ≥ 2`). -/
def heisB : Fin (g + 1) → Equiv.Perm (ZMod n × ZMod n) := Fin.cases (heisY n) fun _ ↦ 1

lemma commProd_heis : commProd (heisA (g := g) n) (heisB n) = heisT n := by
  simp [commProd, List.ofFn_succ, heisA, heisB, ← heis_comm, mul_assoc]

/-- The Heisenberg quotient `Π_{g+1,1} → Perm((ℤ/n)²)`, `c ↦ heisT⁻¹`. -/
def heisRho : SurfaceGroup (g + 1) 1 →* Equiv.Perm (ZMod n × ZMod n) :=
  lift (heisA n) (heisB n) (fun _ ↦ (commProd (heisA (g := g) n) (heisB n))⁻¹) (by simp [ordProd])

lemma heisRho_cusp : heisRho (g := g) n (cusp 0) = (heisT n)⁻¹ := by
  rw [heisRho, lift_cusp, commProd_heis]

/-- `heisT⁻¹` commutes with the image of `heisRho`. -/
lemma heisRho_cusp_comm (w : SurfaceGroup (g + 1) 1) :
    heisRho (g := g) n (cusp 0) * heisRho n w = heisRho n w * heisRho (g := g) n (cusp 0) := by
  have hT : ∀ i : Fin (g + 1), heisT n * heisA n i = heisA n i * heisT n ∧
      heisT n * heisB n i = heisB n i * heisT n := fun i ↦ by
    refine Fin.cases ⟨heisT_mul_heisX n, heisT_mul_heisY n⟩ (fun i ↦ ?_) i
    simp [heisA, heisB]
  have key : (MulAut.conj (heisRho (g := g) n (cusp 0))).toMonoidHom.comp (heisRho (g := g) n) =
      heisRho (g := g) n := by
    refine hom_ext (fun i ↦ ?_) (fun i ↦ ?_) (fun j ↦ ?_)
    · simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
        heisRho_cusp]
      rw [heisRho, lift_genA, mul_inv_eq_iff_eq_mul, inv_mul_eq_iff_eq_mul, ← mul_assoc,
        (hT i).1, mul_assoc, mul_inv_cancel, mul_one]
    · simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
        heisRho_cusp]
      rw [heisRho, lift_genB, mul_inv_eq_iff_eq_mul, inv_mul_eq_iff_eq_mul, ← mul_assoc,
        (hT i).2, mul_assoc, mul_inv_cancel, mul_one]
    · obtain rfl : j = 0 := Subsingleton.elim _ _
      simp
  have := DFunLike.congr_fun key w
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at this
  conv_rhs => rw [← this]
  group

lemma orderOf_heisRho_cusp [NeZero n] : orderOf (heisRho (g := g) n (cusp 0)) = n := by
  rw [heisRho_cusp, orderOf_inv, orderOf_heisT]

variable [NeZero n]

/-- The continuous extension `Π̂_{g+1,1} → Perm((ℤ/n)²)`. -/
noncomputable abbrev heisRhoHat :
    ProfiniteSurfaceGroup (g + 1) 1 →* Equiv.Perm (ZMod n × ZMod n) :=
  liftFinite (heisRho n)

/-- A subgroup which is a union of fibres of `heisRhoHat n` is closed. -/
lemma isClosed_comap_heisRhoHat (S : Subgroup (Equiv.Perm (ZMod n × ZMod n))) :
    IsClosed ((S.comap (heisRhoHat (g := g) n) : Subgroup _) :
      Set (ProfiniteSurfaceGroup (g + 1) 1)) := by
  refine Subgroup.isClosed_of_isOpen _ ?_
  have : ((S.comap (heisRhoHat (g := g) n) : Subgroup _) :
      Set (ProfiniteSurfaceGroup (g + 1) 1)) =
      ⋃ p ∈ (S : Set (Equiv.Perm (ZMod n × ZMod n))), {x | heisRhoHat n x = p} := by
    ext x
    simp
  rw [this]
  exact isOpen_biUnion fun p _ ↦ isOpen_liftFinite_fiber _ p

/-- **The Heisenberg quotients kill `ccnKernel`.** -/
theorem ccnKernel_le_ker : ccnKernel (g + 1) ≤ (heisRhoHat (g := g) n).ker := by
  set ρ := heisRhoHat (g := g) n
  -- the elements whose image commutes with the whole image of `ρ`
  let C : Subgroup (ProfiniteSurfaceGroup (g + 1) 1) :=
    (Subgroup.centralizer (ρ.range : Set (Equiv.Perm (ZMod n × ZMod n)))).comap ρ
  have hmemC : ∀ z, z ∈ C ↔ ∀ y, ρ y * ρ z = ρ z * ρ y := fun z ↦ by
    simp only [C, Subgroup.mem_comap, Subgroup.mem_centralizer_iff, MonoidHom.coe_range,
      Set.mem_range, forall_exists_index, forall_apply_eq_imp_iff]
  haveI : C.Normal := ⟨fun z hz a ↦ by
    rw [hmemC] at hz ⊢
    intro y
    have h1 := hz a
    have h2 := hz y
    simp only [map_mul, map_inv]
    calc ρ y * (ρ a * ρ z * (ρ a)⁻¹) = ρ y * ρ z := by
          rw [h1, mul_inv_cancel_right]
      _ = ρ z * ρ y := h2
      _ = ρ a * ρ z * (ρ a)⁻¹ * ρ y := by rw [h1, mul_inv_cancel_right]⟩
  have hcC : cuspHat (g + 1) ∈ C := by
    rw [hmemC]
    intro y
    obtain ⟨w, -, hw⟩ := exists_etaFn_eq (heisRho (g := g) n) isOpen_univ (Set.mem_univ y)
    rw [← hw, liftFinite_eta]
    exact (heisRho_cusp_comm n w).symm
  have hNC : cuspKernel (g + 1) ≤ C :=
    Subgroup.topologicalClosure_minimal _
      (Subgroup.normalClosure_le_normal (Set.singleton_subset_iff.2 hcC))
      (isClosed_comap_heisRhoHat n _)
  have hker : IsClosed ((ρ.ker : Subgroup _) : Set (ProfiniteSurfaceGroup (g + 1) 1)) := by
    have := isClosed_comap_heisRhoHat (g := g) n ⊥
    rwa [MonoidHom.comap_bot] at this
  refine Subgroup.topologicalClosure_minimal _ ?_ hker
  rw [Subgroup.commutator_le]
  intro x hx y _
  have hx' := (hmemC x).1 (hNC hx) y
  rw [MonoidHom.mem_ker, commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv,
    ← hx']
  group

end Heis

/-- **`I_x ↪ Δ^{c-cn}_{U_x}`** ([AbsTopIII] Prop. 1.4(ii), left half of the exact sequence): for
`g ≥ 1`, the map `ℤ̂ → Π̂_{g,1} ⧸ \overline{[N, Π̂_{g,1}]}`, `k ↦ cᵏ`, is injective. -/
theorem ccnInertia_injective :
    Function.Injective ((QuotientGroup.mk' (ccnKernel (g + 1))).comp (cuspInertia 0)) := by
  rw [injective_iff_map_eq_one]
  intro x hx
  rw [MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hx
  refine eq_one_of_forall_liftFinite fun P _ _ f ↦ ?_
  set p := f (Multiplicative.ofAdd 1)
  set n := orderOf p
  haveI : NeZero n := ⟨(orderOf_pos p).ne'⟩
  have h1 : liftFinite ((heisRho (g := g) n).comp (zpowersHom _ (cusp 0))) x = 1 := by
    rw [← liftFinite_completionMap]
    exact ccnKernel_le_ker n hx
  obtain ⟨w, -, hf, hg⟩ := exists_etaFn_eq₂ f ((heisRho (g := g) n).comp (zpowersHom _ (cusp 0)))
    isOpen_univ (Set.mem_univ x)
  rw [h1] at hg
  rw [← hf]
  have hw : w = Multiplicative.ofAdd 1 ^ (Multiplicative.toAdd w) := by
    rw [← ofAdd_zsmul, smul_eq_mul, mul_one, ofAdd_toAdd]
  rw [MonoidHom.comp_apply, zpowersHom_apply, map_zpow] at hg
  rw [hw, map_zpow, ← orderOf_dvd_iff_zpow_eq_one]
  have := orderOf_dvd_iff_zpow_eq_one.2 hg
  rwa [orderOf_heisRho_cusp] at this

end CurvesJacobian.CuspCentral
