import CurvesJacobian.Kummer.CuspRigidity
import CurvesJacobian.Cusp.CuspCommensurable

/-!
# [GalSect] Thm. 4.3 with several cusps: filling in the other cusps

[GalSect] Thm. 4.3 (`Galois Sections.txt` l.841–882), proof l.864–868: "By 'filling in' [cf.
Theorem 1.3, (iii)] all of the cusps other than those of interest [i.e., x, y], we may assume,
moreover, that X_K, Y_L satisfy the hypotheses of Lemma 4.2." Here: `U ⊆ U' = X ∖ {x}`,
`V ⊆ V' = Y ∖ {y}` nonempty with finite complements (`X`, `Y` proper of genus `≥ 1` over
algebraically closed fields of characteristic `0`, Galois models as in `Kummer/CuspChern.lean`),
`W₀`, `W₁` places over `x`, `y`, and `α_U : Δ_U ≃ₜ* Δ_V` with `α_U(I_x) = I_y` which is
compatible with filling in the other cusps: `α_U(ker(Δ_U ↠ Δ_{U'})) = ker(Δ_V ↠ Δ_{V'})`. (By
`Cusp.ker_fundamentalGroupMap_homOfLE_eq_cuspInertia` these kernels are the closed normal subgroups
generated by the inertia groups of the cusps other than `x`, `y`; for isomorphisms of arithmetic
fundamental groups over `p`-adic fields this compatibility is [GalSect] Thm. 1.3(iii), cf.
`CuspChar.mem_arithCusps_iff_map_mem_padic`, together with Thm. 1.3(i).)

* `fillOpen hUU'`: `Δ_U ↠ Δ_{U'}`; `map_cuspInertia_fillOpen`: it maps `I_x ⊆ Δ_U` onto
  `I_x ⊆ Δ_{U'}`; `fillOpen_surjective`;
* `fillOpenEquiv`: the induced `Δ_{U'} ≃ₜ* Δ_{V'}`, `map_cuspInertia_fillOpenEquiv`;
* **`rigidity_cuspInertia_fill`** ([GalSect] Thm. 4.3 for `U`): for `i ∈ I_x ⊆ Δ_U`, the natural
  isomorphisms `I_x ≅ Ẑ(1)` (roots of a local coordinate at `x`: the tame character,
  `cuspInertiaZHatEquiv` of `U'` composed with the filling map, which is injective on `I_x`) are
  compatible with `α_U` and `β`, given the debt `DegOneChernPreserved` ([AbsAnab] Lemma 2.5(ii))
  for the filled isomorphism `Δ_X ≃ₜ* Δ_Y`.
-/

open CategoryTheory AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale AffOrbicurve Topology
open Pi1.Orbifold Pi1 CurvesJacobian.Cusp KummerTheory KummerTheory.Curve Pi1.Profinite
open Pi1.SurfaceGroup Pi1.SurfaceGen WeilCurves.FunctionField

namespace CurvesJacobian.CuspRigidity

open ChernClass

universe u v

section FillOpen

variable {k Ω : Type u} [Field k] [IsAlgClosed k] [CharZero k]
  [Field Ω] [Algebra k Ω] [IsSepClosed Ω] {t : Ω} [IsGalois (K₀ k t) Ω] {D : GaloisData k t}
  {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsCurveOver k X] [IsIntegral X]
  {eL : X.functionField ≃+* D.L} {hH : D.H ≤ D.HL}
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)
  {U U' : X.Opens} [Nonempty U] [Nonempty U']

variable (D eL) in
/-- The filling map `Δ_U ↠ Δ_{U'}` for `U ⊆ U'`. -/
noncomputable abbrev fillOpen (hUU' : U ≤ U') :
    π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U') :=
  (fundamentalGroupMap (X.homOfLE hUU') (specPoint_genericL_homOfLE D X eL hUU')).toMonoidHom

omit [IsAlgClosed k] [CharZero k] [X.Over (Spec (.of k))] [IsCurveOver k X] [IsSepClosed Ω]
  [IsGalois (K₀ k t) Ω] in
lemma continuous_fillOpen (hUU' : U ≤ U') : Continuous (fillOpen D eL hUU') :=
  (fundamentalGroupMap (X.homOfLE hUU') (specPoint_genericL_homOfLE D X eL hUU')).continuous

omit [IsAlgClosed k] [CharZero k] [X.Over (Spec (.of k))] [IsCurveOver k X] in
/-- The filling map commutes with the Galois actions at the generic points. -/
lemma fillOpen_chartHom (hUU' : U ≤ U') (σ : D.H) :
    fillOpen D eL hUU' (D.chartHom hH (genericL D X eL U) σ) =
      D.chartHom hH (genericL D X eL U') σ :=
  fundamentalGroupMap_genericL D X eL hH hUU' σ

omit [IsAlgClosed k] [CharZero k] [X.Over (Spec (.of k))] [IsCurveOver k X] in
/-- **The filling map sends the cuspidal inertia group of `W` in `Δ_U` onto that in `Δ_{U'}`.** -/
theorem map_cuspInertia_fillOpen (hUU' : U ≤ U') (W : ValuationSubring Ω) :
    (cuspInertia D X eL hH U W).map (fillOpen D eL hUU') = cuspInertia D X eL hH U' W :=
  Cusp.map_cuspInertia_homOfLE D X eL hH hUU' W

omit [IsAlgClosed k] in
include hk hτ hH in
/-- `Δ_U ↠ Δ_{U'}` is surjective (finite complements). -/
theorem fillOpen_surjective (hUU' : U ≤ U') (hU' : (U' : Set X)ᶜ.Finite) :
    Function.Surjective (fillOpen D eL hUU') := by
  intro b
  obtain ⟨σ, rfl⟩ := (genericL_spec D X eL hk hH hτ U' hU').2 b
  exact ⟨_, fillOpen_chartHom hUU' σ⟩

end FillOpen

section TwoCurves

variable {k Ω : Type u} [Field k] [IsAlgClosed k] [CharZero k]
  [Field Ω] [Algebra k Ω] [IsSepClosed Ω] {t : Ω} [IsGalois (K₀ k t) Ω] {D : GaloisData k t}
  {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsCurveOver k X] [IsIntegral X]
  {eL : X.functionField ≃+* D.L} {hH : D.H ≤ D.HL}
  [Nonempty (⊤ : X.Opens)]
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)
  {U U' : X.Opens} [Nonempty U] [Nonempty U'] {W₀ : ValuationSubring Ω} {x : X} {π : (F D)ˣ}
  {k' Ω' : Type v} [Field k'] [IsAlgClosed k'] [CharZero k']
  [Field Ω'] [Algebra k' Ω'] [IsSepClosed Ω'] {t' : Ω'} [IsGalois (K₀ k' t') Ω']
  {D' : GaloisData k' t'}
  {Y : Scheme.{v}} [Y.Over (Spec (.of k'))] [IsCurveOver k' Y] [IsIntegral Y]
  {eL' : Y.functionField ≃+* D'.L} {hH' : D'.H ≤ D'.HL}
  [Nonempty (⊤ : Y.Opens)]
  (hk' : ∀ c : k', ((eL' (algebraMap k' Y.functionField c) : D'.L) : Ω') = algebraMap k' Ω' c)
  {τ' : Y.functionField} (hτ' : ((eL' τ' : D'.L) : Ω') = t')
  {V V' : Y.Opens} [Nonempty V] [Nonempty V'] {W₁ : ValuationSubring Ω'} {y : Y} {π' : (F D')ˣ}

variable (hH hH') in
/-- **The isomorphism `Δ_{U'} ≃ₜ* Δ_{V'}` induced by `α_U`** when `α_U` is compatible with
filling (`α_U(ker(Δ_U ↠ Δ_{U'})) = ker(Δ_V ↠ Δ_{V'})`). -/
noncomputable def fillOpenEquiv (hUU' : U ≤ U') (hU' : (U' : Set X)ᶜ.Finite)
    (hVV' : V ≤ V') (hV' : (V' : Set Y)ᶜ.Finite)
    (αU : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) ≃ₜ*
      π₁ᵉᵗ(specPoint D'.L Ω' ≫ genericL D' Y eL' V))
    (hker : (fillOpen D eL hUU').ker.map αU.toMulEquiv.toMonoidHom = (fillOpen D' eL' hVV').ker) :
    π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U') ≃ₜ*
      π₁ᵉᵗ(specPoint D'.L Ω' ≫ genericL D' Y eL' V') :=
  inducedContEquiv αU (continuous_fillOpen hUU') (continuous_fillOpen hVV')
    (fillOpen_surjective (hH := hH) hk hτ hUU' hU')
    (fillOpen_surjective (hH := hH') hk' hτ' hVV' hV')
    hker

omit [IsAlgClosed k] [Nonempty (⊤ : X.Opens)] [IsAlgClosed k'] [Nonempty (⊤ : Y.Opens)] in
variable (hH hH') in
lemma fillOpenEquiv_fillOpen (hUU' : U ≤ U') (hU' : (U' : Set X)ᶜ.Finite)
    (hVV' : V ≤ V') (hV' : (V' : Set Y)ᶜ.Finite)
    (αU : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) ≃ₜ*
      π₁ᵉᵗ(specPoint D'.L Ω' ≫ genericL D' Y eL' V))
    (hker : (fillOpen D eL hUU').ker.map αU.toMulEquiv.toMonoidHom = (fillOpen D' eL' hVV').ker)
    (γ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) :
    fillOpenEquiv hH hk hτ hH' hk' hτ' hUU' hU' hVV' hV' αU hker
        (fillOpen D eL hUU' γ) = fillOpen D' eL' hVV' (αU γ) :=
  inducedContEquiv_apply _ _ _ _ _ _ γ

omit [IsAlgClosed k] [Nonempty (⊤ : X.Opens)] [IsAlgClosed k'] [Nonempty (⊤ : Y.Opens)] in
/-- The filled isomorphism maps `I_x ⊆ Δ_{U'}` onto `I_y ⊆ Δ_{V'}`. -/
theorem map_cuspInertia_fillOpenEquiv (hUU' : U ≤ U') (hU' : (U' : Set X)ᶜ.Finite)
    (hVV' : V ≤ V') (hV' : (V' : Set Y)ᶜ.Finite)
    (αU : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) ≃ₜ*
      π₁ᵉᵗ(specPoint D'.L Ω' ≫ genericL D' Y eL' V))
    (hker : (fillOpen D eL hUU').ker.map αU.toMulEquiv.toMonoidHom = (fillOpen D' eL' hVV').ker)
    (hI : (cuspInertia D X eL hH U W₀).map αU.toMulEquiv.toMonoidHom =
      cuspInertia D' Y eL' hH' V W₁) :
    (cuspInertia D X eL hH U' W₀).map
        (fillOpenEquiv hH hk hτ hH' hk' hτ' hUU' hU' hVV' hV' αU hker).toMulEquiv.toMonoidHom =
      cuspInertia D' Y eL' hH' V' W₁ := by
  rw [← map_cuspInertia_fillOpen (hH := hH) hUU' W₀,
    ← map_cuspInertia_fillOpen (hH := hH') hVV' W₁, ← hI, Subgroup.map_map, Subgroup.map_map]
  congr 1
  exact MonoidHom.ext (fillOpenEquiv_fillOpen hH hk hτ hH' hk' hτ' hUU' hU' hVV' hV' αU hker)

include hk hτ hk' hτ' in
/-- **[GalSect] Thm. 4.3 (Rigidity of cuspidal geometric decomposition groups), with the other
cusps filled in** (`Galois Sections.txt` l.841–882): `U ⊆ U' = X ∖ {x}`, `V ⊆ V' = Y ∖ {y}`
(finite complements, genus `≥ 1`), `α_U : Δ_U ≃ₜ* Δ_V` with `α_U(I_x) = I_y`, compatible with
filling in the other cusps, and `β : Ẑ(1) ≅ Ẑ(1)` with levels `β_n`. Then for `i ∈ I_x ⊆ Δ_U`,
the natural isomorphism `I_x ≅ Ẑ(1)` (roots of a local coordinate at `x`) of `α_U(i)` is `β` of
that of `i`, given [AbsAnab] Lemma 2.5(ii) (`DegOneChernPreserved`, debt) for the filled
isomorphism `Δ_X ≃ₜ* Δ_Y`. -/
theorem rigidity_cuspInertia_fill (hgen : 0 < (curveGenus k X).toNat)
    (hUU' : U ≤ U') (hU'x : (U' : Set X)ᶜ = {x}) (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U' : ¬ IsCentredOn D X eL U' W₀) (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω))
    (hgen' : 0 < (curveGenus k' Y).toNat)
    (hVV' : V ≤ V') (hV'y : (V' : Set Y)ᶜ = {y}) (hW₁ : IsCentredOn D' Y eL' ⊤ W₁)
    (hW₁V' : ¬ IsCentredOn D' Y eL' V' W₁) (hπW' : W₁.valuation ((π' : F D') : Ω') < 1)
    (hπ' : ∀ f ∈ F D', W₁.valuation f < 1 → W₁.valuation f ≤ W₁.valuation ((π' : F D') : Ω'))
    (αU : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) ≃ₜ*
      π₁ᵉᵗ(specPoint D'.L Ω' ≫ genericL D' Y eL' V))
    (hI : (cuspInertia D X eL hH U W₀).map αU.toMulEquiv.toMonoidHom =
      cuspInertia D' Y eL' hH' V W₁)
    (hker : (fillOpen D eL hUU').ker.map αU.toMulEquiv.toMonoidHom = (fillOpen D' eL' hVV').ker)
    (β : ZHatOne (F D) Ω ≃* ZHatOne (F D') Ω') (βn : ∀ (n : ℕ) [NeZero n], Mu n Ω ≃* Mu n Ω')
    (hβ : ∀ (n : ℕ) [NeZero n] (z : ZHatOne (F D) Ω),
      ZHatOne.proj (kIdx D' n) (β z) = βn n (ZHatOne.proj (kIdx D n) z))
    (hdeg : DegOneChernPreserved hH hk hτ hH' hk' hτ' hgen hgen'
      (fillEquiv hk hτ hk' hτ' hU'x hW₀ hW₀U' hV'y hW₁ hW₁V'
        (fillOpenEquiv hH hk hτ hH' hk' hτ' hUU' (hU'x ▸ Set.finite_singleton x) hVV'
          (hV'y ▸ Set.finite_singleton y) αU hker)
        (map_cuspInertia_fillOpenEquiv hk hτ hk' hτ' hUU' _ hVV' _ αU hker hI)) βn)
    (i : cuspInertia D X eL hH U W₀) :
    CuspCentral.cuspInertiaZHatEquiv hk' hτ' hgen' V' hV'y hW₁ hW₁V' hπW' hπ'
        ⟨fillOpen D' eL' hVV' (αU i), by
          rw [← map_cuspInertia_fillOpen (hH := hH') hVV' W₁, ← hI]
          exact Subgroup.mem_map_of_mem _ (Subgroup.mem_map_of_mem _ i.2)⟩ =
      β (CuspCentral.cuspInertiaZHatEquiv hk hτ hgen U' hU'x hW₀ hW₀U' hπW hπ
        ⟨fillOpen D eL hUU' i, by
          rw [← map_cuspInertia_fillOpen (hH := hH) hUU' W₀]
          exact Subgroup.mem_map_of_mem _ i.2⟩) := by
  have hU' : (U' : Set X)ᶜ.Finite := hU'x ▸ Set.finite_singleton x
  have hV' : (V' : Set Y)ᶜ.Finite := hV'y ▸ Set.finite_singleton y
  have h := rigidity_cuspInertia_of_map hk hτ hk' hτ' hgen hU'x hW₀ hW₀U' hπW hπ hgen' hV'y hW₁
    hW₁V' hπW' hπ' (fillOpenEquiv hH hk hτ hH' hk' hτ' hUU' hU' hVV' hV' αU hker)
    (map_cuspInertia_fillOpenEquiv hk hτ hk' hτ' hUU' hU' hVV' hV' αU hker hI) β βn hβ hdeg
    ⟨fillOpen D eL hUU' i, by
      rw [← map_cuspInertia_fillOpen (hH := hH) hUU' W₀]
      exact Subgroup.mem_map_of_mem _ i.2⟩
  refine Eq.trans ?_ h
  congr 1
  exact Subtype.ext (fillOpenEquiv_fillOpen hH hk hτ hH' hk' hτ' hUU' hU' hVV' hV' αU hker i).symm

end TwoCurves

end CurvesJacobian.CuspRigidity
