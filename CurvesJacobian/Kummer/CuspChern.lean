/-!
# [AbsTopIII] Prop. 1.4(ii): the cuspidally central extension and the Chern class of `𝒪_X(x)`

[AbsTopIII] Prop. 1.4(ii) (`Topics in Absolute Anabelian Geometry III.txt` l.1771–1802): for a
proper curve `X` over `k` of characteristic `0`, `x ∈ X(k)`, `U_x = X ∖ {x}`, the `E₂`-differential
of the extension `1 → I_x → Δ^{c-cn}_{U_x} → Δ_X → 1` sends `1 ∈ Hom(I_x, I_x)` to an element of
`H²(Δ_X, I_x) = Hom(M_X, I_x)` which "corresponds to the natural isomorphism `M_X ≅ I_x` [relative
to the well-known natural identifications of `I_x`, `M_X` with `Ẑ(1)`]". The identification
`I_x ≅ Ẑ(1)` is the tame character (Prop. 1.4(i); `CuspCentral.cuspInertiaZHatEquiv`); the
identification `M_X = Hom(H²(Δ_X, Ẑ), Ẑ) ≅ Ẑ(1)` is the one of [Mzk19] Prop. 1.2(ii)
(`Absolute Anabelian Cuspidalizations.txt` l.363–371): the unique one sending
`1 ∈ Ẑ ≅ H²(Δ_X, M_X)` to the first Chern class of a line bundle of degree `1`. So the statement
is: **modulo every `n`, the class of the pushout of `Δ^{c-cn}_{U_x}` along
`I_x ≅ Ẑ(1) ↠ μ_n` is the first Chern class of `𝒪_X(x)` in `H²(Δ_X, μ_n)`**. The proof in
[AbsTopIII] refers to [Mzk19] Prop. 1.6(iii) and [Mzk8] = *Galois sections in absolute anabelian
geometry* Lemma 4.2 (`Galois Sections.txt` l.778–811: `π₁` of the `𝔾_m`-torsor `L^×` of
`L = 𝒪(x)` is an extension of `Π_X` by `Ẑ(1)` with class `c₁(L)`, and `Π_{U_x} ↠ Π_{L^×}` induces
`I_x ≅ Ker`), whose input is [Mzk7] Lemmas 4.4, 4.5 (`Topics Surrounding the Anabelian
Geometry of Hyperbolic Curves.txt` l.1592–1699).

We work in the Galois model (`k = k̄`, so `Π = Δ`): `H = Gal(Ω/K(X))`, `ρ : H ↠ Δ_X = π₁ᵉᵗ(X)`
with kernel generated by all inertia groups, and `Ω^{ker ρ}` the function field of the profinite
universal cover `X̃`. In place of the torsor `L^×` we use its function-field incarnation: the
Kummer extension `Ω^{ker ρ}(f^{1/n})` of a function `f` on `X̃` with `div f ≡ x (mod n)`
(on a finite étale cover `Y`, `x_Y = n E + div f`: this is [Mzk7] Lemma 4.4's `P^{⊗n} ≅ L|_Y`).

* `IsChernRep`: `f` represents `𝒪_X(x)` modulo `n` — fixed by `ker ρ`, invariant modulo
  `n`-th powers (`σ f = f g_σⁿ`), its `n`-th roots unramified at the places of `U` and ramified
  at `W₀` like the roots of a uniformiser `π` (the Kummer form of `ord_W f ≡ ord_W(x) mod n`).
* `chernClassX`: **the first Chern class modulo `n`** of `𝒪_X(x)`, the class of
  `a(γ, δ) = g_γ γ(g_δ) / g_{γδ}` (`ChernClass.chernClass`; the boundary of the Kummer sequence on
  `X̃`, [Mzk7] Def. 4.1); `chernClassX_eq`: independent of `f` (`Ω^{ker ρ}` has no unramified
  Kummer extensions, `exists_eq_pow_of_unram`).
* `exists_isChernRep`: representatives exist (genus `≥ 1`), by Kummer theory over `Ω^{ker ρ}`
  applied to the character `ker ρ → I_x → μ_n` given by the exact sequence
  `CuspCentral.cuspCentral_exact_curve`.
* `IsCuspPushout hH U χ Φ Ψ`: `Ψ : Δ_U →* M ×_Φ Δ_X` over the filling map, equal to `χ` on `I_x`,
  i.e. `(Φ, Ψ)` represents the pushout of `1 → I_x → Δ^{c-cn}_U → Δ_X → 1` along `χ`.
  `kummerPushout_isCuspPushout`: the Kummer extension of a representative is such a pushout along
  `χ_n = proj_n ∘ (I_x ≅ Ẑ(1))` with cocycle exactly `a`; `IsCuspPushout.mk_eq_mu`: all cusp
  pushouts along the same `χ` have the same class (relator value, through
  `CuspCentral.exists_cuspCentral_equiv`).
* **`IsCuspPushout.mk_eq_chernClassX`** ([AbsTopIII] Prop. 1.4(ii)): the class of every cusp
  pushout along `χ_n` is `chernClassX`, the first Chern class of `𝒪_X(x)` modulo `n`.
-/


open CategoryTheory AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale AffOrbicurve Topology
open Pi1.Orbifold Pi1 CurvesJacobian.Cusp KummerTheory KummerTheory.Curve Pi1.Profinite
open Pi1.SurfaceGroup Pi1.SurfaceGen

namespace CurvesJacobian.ChernClass

universe u

section Aux

/-- A continuous surjection from a compact space onto a Hausdorff space is a quotient map. -/
lemma isOpen_of_isOpen_preimage {A B : Type*} [TopologicalSpace A] [CompactSpace A]
    [TopologicalSpace B] [T2Space B] {f : A → B} (hf : Continuous f)
    (hs : Function.Surjective f) (S : Set B) (h : IsOpen (f ⁻¹' S)) : IsOpen S := by
  have : f '' (f ⁻¹' Sᶜ) = Sᶜ := Set.image_preimage_eq _ hs
  rw [← isClosed_compl_iff, ← this]
  exact (h.isClosed_compl.isCompact.image hf).isClosed

end Aux


/-! ### The `I`-component in `K ≤ I N` with `I ∩ N = 1` (pure group theory) -/

section Decomp

variable {E : Type*} [Group E] {I N K : Subgroup E} [N.Normal]

/-- The `I`-component of `k ∈ K ≤ I ⊔ N` (`N` normal). -/
noncomputable def projI (hKIN : K ≤ I ⊔ N) (k : K) : I :=
  ⟨(Subgroup.mem_sup_of_normal_right.1 (hKIN k.2)).choose,
    (Subgroup.mem_sup_of_normal_right.1 (hKIN k.2)).choose_spec.1⟩

lemma projI_spec (hKIN : K ≤ I ⊔ N) (k : K) : ∃ m ∈ N, (projI hKIN k : E) * m = k :=
  (Subgroup.mem_sup_of_normal_right.1 (hKIN k.2)).choose_spec.2

/-- Uniqueness of the decomposition `k = i m`. -/
lemma projI_eq (hIN : I ⊓ N = ⊥) (hKIN : K ≤ I ⊔ N) {k : K} {i : E} (hi : i ∈ I) {m : E}
    (hm : m ∈ N) (h : i * m = k) : projI hKIN k = ⟨i, hi⟩ := by
  obtain ⟨m', hm', h'⟩ := projI_spec hKIN k
  apply Subtype.ext
  have hmem : i⁻¹ * (projI hKIN k : E) = m * m'⁻¹ := by
    calc i⁻¹ * (projI hKIN k : E) = i⁻¹ * ((projI hKIN k : E) * m') * m'⁻¹ := by group
      _ = i⁻¹ * (i * m) * m'⁻¹ := by rw [h', h]
      _ = m * m'⁻¹ := by group
  have h1 : i⁻¹ * (projI hKIN k : E) ∈ I ⊓ N :=
    ⟨I.mul_mem (I.inv_mem hi) (projI hKIN k).2, hmem ▸ N.mul_mem hm (N.inv_mem hm')⟩
  rw [hIN, Subgroup.mem_bot, inv_mul_eq_one] at h1
  exact h1.symm

/-- The `I`-component as a homomorphism `K →* I`. -/
noncomputable def projIHom (hIN : I ⊓ N = ⊥) (hKIN : K ≤ I ⊔ N) : K →* I where
  toFun := projI hKIN
  map_one' := projI_eq hIN hKIN I.one_mem N.one_mem (by simp) |>.trans rfl
  map_mul' k₁ k₂ := by
    obtain ⟨m₁, hm₁, h₁⟩ := projI_spec hKIN k₁
    obtain ⟨m₂, hm₂, h₂⟩ := projI_spec hKIN k₂
    refine projI_eq hIN hKIN (I.mul_mem (projI hKIN k₁).2 (projI hKIN k₂).2)
      (N.mul_mem (‹N.Normal›.conj_mem _ hm₁ (projI hKIN k₂ : E)⁻¹) hm₂) ?_
    rw [Subgroup.coe_mul, ← h₁, ← h₂]
    group

lemma projIHom_apply (hIN : I ⊓ N = ⊥) (hKIN : K ≤ I ⊔ N) (k : K) :
    projIHom hIN hKIN k = projI hKIN k := rfl

lemma projIHom_of_mem (hIN : I ⊓ N = ⊥) (hKIN : K ≤ I ⊔ N) {k : K} (hk : (k : E) ∈ I) :
    projIHom hIN hKIN k = ⟨k, hk⟩ :=
  projI_eq hIN hKIN hk N.one_mem (mul_one _)

lemma projIHom_eq_of_mem (hIN : I ⊓ N = ⊥) (hKIN : K ≤ I ⊔ N) {k k' : K}
    (h : (k : E)⁻¹ * k' ∈ N) : projIHom hIN hKIN k' = projIHom hIN hKIN k := by
  obtain ⟨m, hm, hk⟩ := projI_spec hKIN k
  refine projI_eq hIN hKIN (projI hKIN k).2 (N.mul_mem hm h) ?_
  rw [← mul_assoc, hk, mul_inv_cancel_left]

lemma projIHom_mem_iff (hIN : I ⊓ N = ⊥) (hKIN : K ≤ I ⊔ N) (O : Subgroup I) (k : K) :
    projIHom hIN hKIN k ∈ O ↔ ∃ i ∈ O, ∃ m ∈ N, ((i : I) : E) * m = k := by
  constructor
  · intro h
    obtain ⟨m, hm, hk⟩ := projI_spec hKIN k
    exact ⟨_, h, m, hm, hk⟩
  · rintro ⟨i, hi, m, hm, h⟩
    rwa [show projIHom hIN hKIN k = i from projI_eq hIN hKIN i.2 hm h]

end Decomp

/-- A homomorphism to a discrete group with open kernel is continuous. -/
lemma continuous_of_isOpen_ker {G M : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [Group M] [TopologicalSpace M] [DiscreteTopology M] (f : G →* M)
    (h : IsOpen (f.ker : Set G)) : Continuous f := by
  refine continuous_of_continuousAt_one f ?_
  rw [ContinuousAt, map_one, nhds_discrete M, Filter.tendsto_pure]
  exact Filter.mem_of_superset (h.mem_nhds (one_mem _)) fun x hx ↦ hx

section Curve

variable {k Ω : Type u} [Field k] [IsAlgClosed k] [CharZero k]
  [Field Ω] [Algebra k Ω] [IsSepClosed Ω] {t : Ω} [IsGalois (K₀ k t) Ω] (D : GaloisData k t)
  {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsCurveOver k X] [IsIntegral X]
  (eL : X.functionField ≃+* D.L) (hH : D.H ≤ D.HL)
  [Nonempty (⊤ : X.Opens)]

/-- `ρ : H → Δ_X = π₁ᵉᵗ(X)`, the Galois action at the geometric generic point. -/
noncomputable abbrev rhoX : D.H →* π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) :=
  D.chartHom hH (genericL D X eL ⊤)

omit [IsSepClosed Ω] [IsGalois (K₀ k t) Ω] in
/-- Elements of `H` fix the roots of unity (they lie in `k = k̄`). -/
lemma smul_eq_of_pow_eq_one (n : ℕ) [NeZero n] (σ : D.H) {ζ : Ω}
    (hζ : ζ ^ n = 1) : σ • ζ = ζ := by
  haveI : NeZero (n : k) := ⟨Nat.cast_ne_zero.2 (NeZero.ne n)⟩
  obtain ⟨z, hz⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot k n
  obtain ⟨i, -, rfl⟩ :=
    (hz.map_of_injective (algebraMap k Ω).injective).eq_pow_of_pow_eq_one hζ
  rw [← map_pow]
  set c := z ^ i
  change (σ : Ω ≃ₐ[K₀ k t] Ω) (algebraMap k Ω c) = _
  rw [IsScalarTower.algebraMap_apply k (K₀ k t) Ω, AlgEquiv.commutes]

omit [IsAlgClosed k] [CharZero k] [IsSepClosed Ω] in
lemma isOpen_stabilizer (x : Ω) : IsOpen (MulAction.stabilizer D.H x : Set D.H) :=
  (stabilizer_isOpen_of_isIntegral (K := K₀ k t) x).preimage continuous_subtype_val

variable {D eL hH}
variable (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)

omit [IsAlgClosed k] in
include hk hτ in
lemma rhoX_surjective : Function.Surjective (rhoX D eL hH) :=
  (genericL_spec D X eL hk hH hτ ⊤ (by simp)).2

omit [IsAlgClosed k] in
include hk hτ in
/-- Inertia elements of places centred on `X` lie in `ker(H → Δ_X)`. -/
lemma rhoX_eq_one {W : ValuationSubring Ω} (hW : IsCentredOn D X eL ⊤ W) {σ : D.H}
    (hσ : (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W) : rhoX D eL hH σ = 1 := by
  rw [← MonoidHom.mem_ker, (genericL_spec D X eL hk hH hτ ⊤ (by simp)).1,
    GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ (SU_subset_H D X eL ⊤)]
  exact Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure
    ⟨σ.2, W, hW.1, hW.2, hσ⟩)

omit [IsAlgClosed k] in
include hk hτ in
lemma isOpen_of_rhoX (S : Set π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤))
    (h : IsOpen (rhoX D eL hH ⁻¹' S)) : IsOpen S :=
  isOpen_of_isOpen_preimage (D.continuous_chartHom hH _) (rhoX_surjective hk hτ) S h


variable (D eL hH) in
/-- **`f` represents `𝒪_X(x)` modulo `n`** (`x` the point under `W₀`, `U = X ∖ {x}`, `ϖ` a
uniformiser at `x`): `f` is a function on the profinite universal cover `X̃` (fixed by
`ker(H → Δ_X)`), invariant modulo `n`-th powers, with `div f ≡ x (mod n)` on `X̃`, expressed
through Kummer theory at every place: the `n`-th roots of `f` are unramified at the places
centred on `U`, and at `W₀` the inertia acts on them as on the `n`-th roots of `ϖ` (i.e.
`ord_{W₀} f ≡ ord_{W₀} ϖ = 1 mod n`; at the other places over `x` this follows by
conjugation, `IsChernRep.conj`). -/
structure IsChernRep (n : ℕ) (U : X.Opens) [Nonempty U] (W₀ : ValuationSubring Ω) (ϖ : Ω)
    (f : Ω) : Prop extends KummerInv (rhoX D eL hH) n f where
  unram : ∀ W, IsCentredOn D X eL U W → ∀ σ : D.H, (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W →
    ∀ β : Ω, β ^ n = f → σ • β = β
  cusp : ∀ σ : D.H, (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W₀ →
    ∀ β β₀ : Ω, β ^ n = f → β₀ ^ n = ϖ → σ • β / β = σ • β₀ / β₀

variable {n : ℕ} [NeZero n] {U : X.Opens} [Nonempty U] {W₀ : ValuationSubring Ω} {ϖ : Ω}

include hk hτ in
/-- At the conjugate places `h(W₀)` the inertia acts on the roots of `f` as on those of `ϖ`. -/
theorem IsChernRep.conj (hW₀ : IsCentredOn D X eL ⊤ W₀) (hϖ0 : ϖ ≠ 0)
    (hϖ : ∀ σ : D.H, σ • ϖ = ϖ) {f : Ω} (hf : IsChernRep D eL hH n U W₀ ϖ f) (h : D.H) {τ' : D.H}
    (hτ' : (τ' : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W₀) {β β₀ : Ω} (hβ : β ^ n = f)
    (hβ₀ : β₀ ^ n = ϖ) : (h * τ' * h⁻¹) • β / β = τ' • β₀ / β₀ := by
  have hβ0 : β ≠ 0 := ne_zero_of_pow_eq hf.ne hβ
  have hβ₀0 : β₀ ≠ 0 := ne_zero_of_pow_eq hϖ0 hβ₀
  obtain ⟨g, hgfix, hg⟩ := hf.inv h⁻¹
  have hg0 : g ≠ 0 := by
    rintro rfl
    rw [zero_pow (NeZero.ne n), mul_zero, smul_eq_zero_iff_eq] at hg
    exact hf.ne hg
  set θ := τ' • β₀ / β₀ with hθ
  have hθn : θ ^ n = 1 := by
    rw [hθ, div_pow, ← smul_pow', hβ₀, hϖ, div_self hϖ0]
  have hβ₁ : (h⁻¹ • β / g) ^ n = f := by
    rw [div_pow, ← smul_pow', hβ, hg]
    field_simp
  have hc := hf.cusp τ' hτ' _ β₀ hβ₁ hβ₀
  have hτg : τ' • g = g := hgfix τ' (rhoX_eq_one hk hτ hW₀ hτ')
  have h1 : τ' • (h⁻¹ • β) = θ * h⁻¹ • β := by
    rw [hθ, ← hc, smul_div₀', hτg]
    have : h⁻¹ • β ≠ 0 := by rw [ne_eq, smul_eq_zero_iff_eq]; exact hβ0
    field_simp
  rw [mul_smul, mul_smul, h1, smul_mul', smul_eq_of_pow_eq_one D n h hθn, smul_smul,
    mul_inv_cancel, one_smul, mul_div_assoc, div_self hβ0, mul_one]

omit [IsAlgClosed k] in
include hk hτ in
/-- **`Ω^{ker ρ}` has no unramified Kummer extensions**: if the `n`-th roots of
`u ∈ Ω^{ker(H → Δ_X)}` are fixed by all inertia groups of places centred on `X`, then
`u = bⁿ` with `b ∈ Ω^{ker(H → Δ_X)}` (the kernel is topologically generated by inertia). -/
theorem exists_eq_pow_of_unram {u : Ω} (hu0 : u ≠ 0)
    (h : ∀ W, IsCentredOn D X eL ⊤ W → ∀ σ : D.H, (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W →
      ∀ β : Ω, β ^ n = u → σ • β = β) :
    ∃ b, IsFix (rhoX D eL hH) b ∧ b ≠ 0 ∧ u = b ^ n := by
  haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
  obtain ⟨β, hβ⟩ := IsSepClosed.exists_pow_nat_eq u n
  refine ⟨β, fun σ hσ ↦ ?_, ne_zero_of_pow_eq hu0 hβ, hβ.symm⟩
  rw [MonoidHom.mem_ker, ← MonoidHom.mem_ker, (genericL_spec D X eL hk hH hτ ⊤ (by simp)).1,
    GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ (SU_subset_H D X eL ⊤)] at hσ
  have hcl : IsClosed (MulAction.stabilizer D.H β : Set D.H) :=
    Subgroup.isClosed_of_isOpen _ (isOpen_stabilizer D β)
  refine (Subgroup.topologicalClosure_minimal _ ?_ hcl) hσ
  refine Subgroup.closure_le _ |>.2 ?_
  intro c hc
  obtain ⟨a, ha, hac⟩ := Group.mem_conjugatesOfSet_iff.1 hc
  obtain ⟨-, W, hWk, hW, hσW⟩ := ha
  obtain ⟨d, rfl⟩ := isConj_iff.1 hac
  have hcW := GaloisPi1.conj_mem_inertia hσW (d : Ω ≃ₐ[K₀ k t] Ω)
  refine h _ ((isCentredOn_comap_iff D X eL ⊤ (hH d.2) W).2 ⟨hWk, hW⟩) (d * a * d⁻¹) hcW β hβ

include hk hτ in
/-- Two representatives of `𝒪_X(x)` modulo `n` differ by an `n`-th power on `X̃`. -/
theorem IsChernRep.exists_eq_mul_pow (hUx : (U : Set X)ᶜ = {x}) (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U : ¬ IsCentredOn D X eL U W₀) (hϖ0 : ϖ ≠ 0) (hϖ : ∀ σ : D.H, σ • ϖ = ϖ) {f f' : Ω}
    (hf : IsChernRep D eL hH n U W₀ ϖ f) (hf' : IsChernRep D eL hH n U W₀ ϖ f') :
    ∃ b, IsFix (rhoX D eL hH) b ∧ b ≠ 0 ∧ f' = f * b ^ n := by
  haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
  haveI : IsGalois D.L Ω := IsGalois.tower_top_of_isGalois (K₀ k t) D.L Ω
  obtain ⟨b, hb, hb0, hbu⟩ := exists_eq_pow_of_unram hk hτ (n := n) (u := f' / f)
    (div_ne_zero hf'.ne hf.ne) fun W hW σ hσ γ hγ ↦ by
      obtain ⟨β, hβ⟩ := IsSepClosed.exists_pow_nat_eq f n
      have hβ0 := ne_zero_of_pow_eq hf.ne hβ
      have hβ' : (γ * β) ^ n = f' := by rw [mul_pow, hγ, hβ, div_mul_cancel₀ _ hf.ne]
      have hγβ : γ = γ * β / β := by field_simp
      by_cases hWU : IsCentredOn D X eL U W
      · rw [hγβ, smul_div₀', hf.unram W hWU σ hσ β hβ, hf'.unram W hWU σ hσ _ hβ']
      · have hL := comap_algebraMap_eq_of_isCentredOn D X eL hk (V := ⊤) (by simp)
          (by
            intro a ha b hb
            have ha' : a ∈ (U : Set X)ᶜ := ha.2
            have hb' : b ∈ (U : Set X)ᶜ := hb.2
            rw [hUx] at ha' hb'
            exact ha'.trans hb'.symm) hW₀ hW₀U hW hWU
        obtain ⟨ρ, hρ⟩ := exists_algEquiv_comap_eq W₀ W hL
        set h' : Ω ≃ₐ[K₀ k t] Ω := ρ.restrictScalars (K₀ k t)
        have hhL : h' ∈ D.HL := by
          have hcl : IsClosed (D.HL : Set (Ω ≃ₐ[K₀ k t] Ω)) := D.isClosed_HL
          have h := InfiniteGalois.fixingSubgroup_fixedField (⟨D.HL, hcl⟩ : ClosedSubgroup _)
          change h' ∈ (⟨D.HL, hcl⟩ : ClosedSubgroup _).toSubgroup
          rw [← h, IntermediateField.mem_fixingSubgroup_iff]
          intro x hx
          exact ρ.commutes ⟨x, hx⟩
        set h : D.H := ⟨h', D.le hhL⟩
        have hσ' : ((h⁻¹ * σ * h : D.H) : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W₀ := by
          have := (GaloisPi1.mem_inertia_comap_iff h' (σ : Ω ≃ₐ[K₀ k t] Ω)).1 (by
            rw [show W₀.comap (h'.symm : Ω →+* Ω) = W from hρ.symm]; exact hσ)
          simpa using this
        obtain ⟨β₀, hβ₀⟩ := IsSepClosed.exists_pow_nat_eq ϖ n
        have e1 := hf.conj hk hτ hW₀ hϖ0 hϖ h hσ' hβ hβ₀
        have e2 := hf'.conj hk hτ hW₀ hϖ0 hϖ h hσ' hβ' hβ₀
        have hσeq : h * (h⁻¹ * σ * h) * h⁻¹ = σ := by group
        rw [hσeq] at e1 e2
        have hγβ0 : γ * β ≠ 0 := ne_zero_of_pow_eq hf'.ne hβ'
        rw [← e1, div_eq_div_iff hγβ0 hβ0] at e2
        rw [smul_mul'] at e2
        have hσβ : σ • β ≠ 0 := by rw [ne_eq, smul_eq_zero_iff_eq]; exact hβ0
        apply mul_right_cancel₀ (mul_ne_zero hσβ hβ0)
        linear_combination e2
  refine ⟨b, hb, hb0, ?_⟩
  rw [← hbu, mul_div_cancel₀ _ hf.ne]

omit [IsAlgClosed k] [CharZero k] [IsSepClosed Ω] [IsGalois (K₀ k t) Ω]
  [X.Over (Spec (.of k))] [IsCurveOver k X] in
lemma isCentredOn_top {V : X.Opens} [Nonempty V] {W : ValuationSubring Ω}
    (h : IsCentredOn D X eL V W) : IsCentredOn D X eL ⊤ W := by
  refine ⟨h.1, fun a ↦ ?_⟩
  rw [← CurvesJacobian.germToFunctionField_res (homOfLE (le_top : V ≤ ⊤)) a]
  exact h.2 _

variable (hH) in
/-- A set-theoretic section of `H ↠ Δ_X`. -/
noncomputable def sX : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) → D.H :=
  Function.surjInv (rhoX_surjective (hH := hH) hk hτ)

omit [IsAlgClosed k] in
variable (hH) in
lemma rhoX_sX (γ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤)) :
    rhoX D eL hH (sX hH hk hτ γ) = γ :=
  Function.surjInv_eq _ γ

/-- `Δ_X` acts trivially on `μ_n`. -/
noncomputable local instance instTrivMu (n : ℕ) :
    MulDistribMulAction π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Mu n Ω) :=
  Pi1.SurfaceGroup.trivialAction _ _

/-- **The first Chern class modulo `n` of `𝒪_X(x)`**, computed from a representative `f`
(`div f ≡ x mod n` on `X̃`, `IsChernRep`): the class in `H²(Δ_X, μ_n)` of
`a(γ, δ) = g_γ γ(g_δ) / g_{γδ}`, `γ f = f g_γⁿ`. It does not depend on `f`
(`chernClassX_eq`). -/
noncomputable def chernClassX {f : Ω} (hf : IsChernRep D eL hH n U W₀ ϖ f) :
    H2lc π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Mu n Ω) :=
  chernClass (rhoX_sX hH hk hτ) (fun σ _ hζ ↦ smul_eq_of_pow_eq_one D n σ hζ)
    (isOpen_stabilizer D) (isOpen_of_rhoX hk hτ) hf.toKummerInv

include hk hτ in
/-- **The Chern class does not depend on the representative.** -/
theorem chernClassX_eq (hUx : (U : Set X)ᶜ = {x}) (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U : ¬ IsCentredOn D X eL U W₀) (hϖ0 : ϖ ≠ 0) (hϖ : ∀ σ : D.H, σ • ϖ = ϖ) {f f' : Ω}
    (hf : IsChernRep D eL hH n U W₀ ϖ f) (hf' : IsChernRep D eL hH n U W₀ ϖ f') :
    chernClassX hk hτ hf = chernClassX hk hτ hf' := by
  obtain ⟨b, hb, hb0, hfb⟩ := hf.exists_eq_mul_pow hk hτ hUx hW₀ hW₀U hϖ0 hϖ hf'
  subst hfb
  have hs := rhoX_sX hH hk hτ
  have hμ : ∀ (σ : D.H) (ζ : Ω), ζ ^ n = 1 → σ • ζ = ζ :=
    fun σ _ hζ ↦ smul_eq_of_pow_eq_one D n σ hζ
  have hstab := isOpen_stabilizer D
  have hq := isOpen_of_rhoX (hH := hH) hk hτ
  obtain ⟨g, hg, hglc⟩ := exists_isAdm hs hstab hq hf.toKummerInv
  calc chernClassX hk hτ hf = chernClassOf hs hμ hstab hq hf.ne hf.fix hg hglc :=
        (chernClassOf_eq_chernClass hs hμ hstab hq hf.toKummerInv hg hglc).symm
    _ = chernClassOf hs hμ hstab hq hf'.ne hf'.fix (isAdm_mul_pow hg hb hb0)
        ((hglc.comp₂ (isLocallyConstant_smul hs hstab hq hb) (· * ·)).comp₂
          (IsLocallyConstant.const b) (· / ·)) :=
        (chernClassOf_mul_pow hs hμ hstab hq hf.ne hf.fix hg hglc hb hb0).symm
    _ = chernClassX hk hτ hf' := chernClassOf_eq_chernClass hs hμ hstab hq hf'.toKummerInv _ _

/-! ### The Kummer extension as a pushout of `1 → I_x → Δ_{U} → Δ_X → 1` -/

variable (D eL) in
/-- The filling map `Δ_U ↠ Δ_X`. -/
noncomputable abbrev fillX (U : X.Opens) [Nonempty U] :
    π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) :=
  (fundamentalGroupMap (X.homOfLE (le_top : U ≤ ⊤))
    (specPoint_genericL_homOfLE D X eL le_top)).toMonoidHom

variable (hH U) in
/-- **`(Φ, Ψ)` represents the pushout of `1 → I_x → Δ_U → Δ_X → 1` along `χ : I_x → M`**
(`U = X ∖ {x}`, `I_x = cuspInertia U W₀`): `Ψ : Δ_U →* M ×_Φ Δ_X` lies over the filling map and
restricts to `χ` on `I_x`. Since `M ×_Φ Δ_X → Δ_X` has central kernel, `Ψ` factors through the
maximal cuspidally central quotient `Δ^{c-cn}_U`; so this is the pushout of
`1 → I_x → Δ^{c-cn}_U → Δ_X → 1` ([AbsTopIII] Prop. 1.4(ii)). -/
def IsCuspPushout {M : Type*} [CommGroup M] (χ : cuspInertia D X eL hH U W₀ → M)
    (Φ : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M)
    (Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ) : Prop :=
  (∀ γ, (Ψ γ).g = fillX D eL U γ) ∧ ∀ i : cuspInertia D X eL hH U W₀, Ψ i = Twist.incl (χ i)

omit [IsAlgClosed k] [NeZero n] in
include hk hτ in
/-- `ker(H → Δ_U)` fixes the Kummer roots of a representative and lies in `ker(H → Δ_X)`. -/
lemma ker_rhoU_le (hUfin : (U : Set X)ᶜ.Finite) {f : Ω}
    (hf : IsChernRep D eL hH n U W₀ ϖ f) {β : Ω} (hβ : β ^ n = f) :
    (D.chartHom hH (genericL D X eL U)).ker ≤
      (rhoX D eL hH).ker ⊓ MulAction.stabilizer D.H β := by
  rw [(genericL_spec D X eL hk hH hτ U hUfin).1,
    GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ (SU_subset_H D X eL U)]
  have hcl : IsClosed (((rhoX D eL hH).ker ⊓ MulAction.stabilizer D.H β : Subgroup D.H) :
      Set D.H) := by
    rw [Subgroup.coe_inf]
    exact (isClosed_singleton.preimage (D.continuous_chartHom hH _)).inter
      (Subgroup.isClosed_of_isOpen _ (isOpen_stabilizer D β))
  refine Subgroup.topologicalClosure_minimal _ (Subgroup.closure_le _ |>.2 ?_) hcl
  intro c hc
  obtain ⟨a, ha, hac⟩ := Group.mem_conjugatesOfSet_iff.1 hc
  obtain ⟨-, W, hWk, hW, hσW⟩ := ha
  obtain ⟨d, rfl⟩ := isConj_iff.1 hac
  have hcW := GaloisPi1.conj_mem_inertia hσW (d : Ω ≃ₐ[K₀ k t] Ω)
  have hWU := (isCentredOn_comap_iff D X eL U (hH d.2) W).2 ⟨hWk, hW⟩
  have h1 : rhoX D eL hH (d * a * d⁻¹) = 1 := rhoX_eq_one hk hτ (isCentredOn_top hWU) hcW
  have h2 : (d * a * d⁻¹) • β = β := hf.unram _ hWU (d * a * d⁻¹) hcW β hβ
  exact Subgroup.mem_inf.2 ⟨MonoidHom.mem_ker.2 h1, MulAction.mem_stabilizer_iff.2 h2⟩

/-- The Kummer homomorphism `H →* μ_n ×_a Δ_X` of a representative. -/
noncomputable abbrev kummerTwistX {f : Ω} (hf : IsChernRep D eL hH n U W₀ ϖ f) {g}
    (hg : IsAdm (rhoX D eL hH) n (sX hH hk hτ) f g) {β : Ω} (hβ : β ^ n = f) :=
  kummerTwist (rhoX_sX hH hk hτ) (fun σ _ hζ ↦ smul_eq_of_pow_eq_one D n σ hζ) hf.ne hf.fix hg hβ

include hk hτ in
lemma ker_rhoU_le_ker (hUfin : (U : Set X)ᶜ.Finite) {f : Ω}
    (hf : IsChernRep D eL hH n U W₀ ϖ f) {g} (hg : IsAdm (rhoX D eL hH) n (sX hH hk hτ) f g)
    {β : Ω} (hβ : β ^ n = f) :
    (D.chartHom hH (genericL D X eL U)).ker ≤ (kummerTwistX hk hτ hf hg hβ).ker := by
  intro σ hσ
  obtain ⟨h1, h2⟩ := ker_rhoU_le hk hτ hUfin hf hβ hσ
  rw [MonoidHom.mem_ker, kummerTwist_of_mem_ker _ _ _ _ _ hβ h1 1 (by simpa using h2),
    map_one]

/-- **The Kummer pushout** `Δ_U →* μ_n ×_a Δ_X` (descended from `H`). -/
noncomputable def kummerPushout (hUfin : (U : Set X)ᶜ.Finite) {f : Ω}
    (hf : IsChernRep D eL hH n U W₀ ϖ f) {g} (hg : IsAdm (rhoX D eL hH) n (sX hH hk hτ) f g)
    {β : Ω} (hβ : β ^ n = f) :
    π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist (chernCocycle (rhoX_sX hH hk hτ)
      (fun σ _ hζ ↦ smul_eq_of_pow_eq_one D n σ hζ) hf.ne hf.fix hg) :=
  (QuotientGroup.lift _ (kummerTwistX hk hτ hf hg hβ) (ker_rhoU_le_ker hk hτ hUfin hf hg hβ)).comp
    (QuotientGroup.quotientKerEquivOfSurjective _
      (genericL_spec D X eL hk hH hτ U hUfin).2).symm.toMonoidHom

lemma kummerPushout_apply (hUfin : (U : Set X)ᶜ.Finite) {f : Ω}
    (hf : IsChernRep D eL hH n U W₀ ϖ f) {g} (hg : IsAdm (rhoX D eL hH) n (sX hH hk hτ) f g)
    {β : Ω} (hβ : β ^ n = f) (σ : D.H) :
    kummerPushout hk hτ hUfin hf hg hβ (D.chartHom hH (genericL D X eL U) σ) =
      kummerTwistX hk hτ hf hg hβ σ := by
  have h : (QuotientGroup.quotientKerEquivOfSurjective (D.chartHom hH (genericL D X eL U))
      (genericL_spec D X eL hk hH hτ U hUfin).2).symm (D.chartHom hH (genericL D X eL U) σ) =
      (σ : D.H ⧸ (D.chartHom hH (genericL D X eL U)).ker) := (MulEquiv.symm_apply_eq _).2 rfl
  simp only [kummerPushout, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, h]
  rfl

/-! ### The tame character and the cusp pushouts -/

variable (D) in
/-- `n` as a Kummer index of `F`. -/
def kIdx (n : ℕ) [NeZero n] : KummerIndex (F D) := ⟨n, Nat.cast_ne_zero.2 (NeZero.ne n)⟩

variable {x : X} {π : (F D)ˣ}

variable (hH n U) in
/-- `χ_n : I_x ≅ Ẑ(1) ↠ μ_n` (the natural identification of [AbsTopIII] Prop. 1.4(i), modulo
`n`). -/
noncomputable def chiN (hgen : 0 < (curveGenus k X).toNat) (hUx : (U : Set X)ᶜ = {x})
    (hW₀ : IsCentredOn D X eL ⊤ W₀) (hW₀U : ¬ IsCentredOn D X eL U W₀)
    (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω))
    (i : cuspInertia D X eL hH U W₀) : Mu n Ω :=
  ZHatOne.proj (kIdx D n) (CuspCentral.cuspInertiaZHatEquiv hk hτ hgen U hUx hW₀ hW₀U hπW hπ i)

include hk hτ in
/-- **The Kummer extension of a representative of `𝒪_X(x)` mod `n` is a pushout of
`1 → I_x → Δ_U → Δ_X → 1` along `χ_n`.** -/
theorem kummerPushout_isCuspPushout (hgen : 0 < (curveGenus k X).toNat)
    (hUx : (U : Set X)ᶜ = {x}) (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U : ¬ IsCentredOn D X eL U W₀) (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω))
    {f : Ω} (hf : IsChernRep D eL hH n U W₀ ((π : F D) : Ω) f) {g}
    (hg : IsAdm (rhoX D eL hH) n (sX hH hk hτ) f g) {β : Ω} (hβ : β ^ n = f) :
    IsCuspPushout hH U (chiN hH hk hτ n U hgen hUx hW₀ hW₀U hπW hπ) _
      (kummerPushout hk hτ (hUx ▸ Set.finite_singleton x) hf hg hβ) := by
  have hUfin : (U : Set X)ᶜ.Finite := hUx ▸ Set.finite_singleton x
  refine ⟨fun γ ↦ ?_, fun i ↦ ?_⟩
  · obtain ⟨σ, rfl⟩ := (genericL_spec D X eL hk hH hτ U hUfin).2 γ
    rw [kummerPushout_apply, kummerTwist_g]
    exact (fundamentalGroupMap_genericL D X eL hH le_top σ).symm
  · obtain ⟨σ, rfl⟩ := CuspCentral.inertiaToCusp_surjective D eL hH U W₀ i
    have h1 : ((CuspCentral.inertiaToCusp D eL hH U W₀ σ : cuspInertia D X eL hH U W₀) :
        π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) = D.chartHom hH (genericL D X eL U) σ := rfl
    rw [h1, kummerPushout_apply, chiN, CuspCentral.cuspInertiaZHatEquiv_inertiaToCusp]
    haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
    obtain ⟨β₀, hβ₀⟩ := IsSepClosed.exists_pow_nat_eq ((π : F D) : Ω) n
    have hπ0 : ((π : F D) : Ω) ≠ 0 := by simp
    have hβ₀0 : β₀ ≠ 0 := ne_zero_of_pow_eq hπ0 hβ₀
    have hc := hf.cusp σ σ.2 β β₀ hβ hβ₀
    have hval := val_proj_tameChar hW₀.1 π σ (kIdx D n) (Units.mk0 β₀ hβ₀0)
      (Units.ext (by
        simp only [Units.val_pow_eq_pow_val, Units.val_mk0, Units.coe_map, MonoidHom.coe_coe]
        exact hβ₀))
    refine kummerTwist_of_mem_ker _ _ _ _ _ hβ (rhoX_eq_one hk hτ hW₀ σ.2) _ ?_
    refine Eq.trans ?_ (congrArg (· * β) hval.symm)
    have hβ0 := ne_zero_of_pow_eq hf.ne hβ
    simp only [Units.val_mk0]
    change (σ : D.H) • β = (σ : D.H) • β₀ / β₀ * β
    rw [← hc]
    field_simp

/-! ### Uniqueness of the class of a cusp pushout -/

/-- A locally constant trivial-action cocycle of `Δ_X` as an element of `Z²_lc`. -/
def toCocyclesX {M : Type*} [CommGroup M] [MulDistribMulAction
    π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M]
    (htriv : ∀ (γ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤)) (m : M), γ • m = m)
    {Φ : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M} (hΦ : IsLocallyConstant Φ.1) :
    H2lc.cocycles π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M :=
  ⟨Φ.1, hΦ, fun a b c ↦ by rw [htriv]; exact TrivCocycle.cond Φ.2 a b c⟩

omit [NeZero n] in
include hk hτ in
/-- **The class of a cusp pushout is determined by `χ`**: under `H²(Δ_X, M) ≅ M` (relator value,
transported along `Δ_X ≅ Π̂_{g,0}` of `exists_cuspCentral_equiv`) every cusp pushout along `χ`
goes to `χ(c)⁻¹`, `c ∈ I_x` the image of the cusp generator. Hence two cusp pushouts along the
same `χ` have the same class. -/
theorem IsCuspPushout.mk_eq {M : Type} [CommGroup M] [Finite M]
    [MulDistribMulAction π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M]
    (htriv : ∀ (γ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤)) (m : M), γ • m = m)
    (hgen : 0 < (curveGenus k X).toNat) (hUx : (U : Set X)ᶜ = {x})
    (hW₀ : IsCentredOn D X eL ⊤ W₀) (hW₀U : ¬ IsCentredOn D X eL U W₀)
    {χ : cuspInertia D X eL hH U W₀ → M}
    {Φ Φ' : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M}
    {Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ}
    {Ψ' : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ'}
    (hΦ : IsLocallyConstant Φ.1) (hΦ' : IsLocallyConstant Φ'.1)
    (h : IsCuspPushout hH U χ Φ Ψ) (h' : IsCuspPushout hH U χ Φ' Ψ') :
    (QuotientGroup.mk (toCocyclesX htriv hΦ) : H2lc _ M) =
      QuotientGroup.mk (toCocyclesX htriv hΦ') := by
  obtain ⟨Θ, Θ₀, hI, hfill, -, -⟩ :=
    CuspCentral.exists_cuspCentral_equiv D eL hH hk hτ U hUx hW₀ hW₀U
  revert Θ Θ₀
  generalize (curveGenus k X).toNat = G at hgen ⊢
  obtain ⟨g, rfl⟩ : ∃ g', G = g' + 1 := ⟨_, (Nat.succ_pred_eq_of_pos hgen).symm⟩
  intro Θ Θ₀ hI hfill
  have hc : Θ.symm (CuspCentral.cuspHat (g + 1)) ∈ cuspInertia D X eL hH U W₀ := by
    have : CuspCentral.cuspHat (g + 1) ∈ inertia (g := g + 1) (r := 1) 0 :=
      Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers _)
    rw [← hI] at this
    obtain ⟨y, hy, hyc⟩ := this
    rw [← hyc]
    have : Θ.symm (Θ.toMulEquiv.toMonoidHom y) = y := Θ.symm_apply_apply y
    rw [this]
    exact hy
  set i₀ : cuspInertia D X eL hH U W₀ := ⟨_, hc⟩
  set e := h2EquivOfContinuousMulEquiv g.succ_pos Θ₀ htriv
  -- the value of `e` on the class of any cusp pushout
  have key : ∀ {Φ : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M}
      {Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ}
      (hΦ : IsLocallyConstant Φ.1), IsCuspPushout hH U χ Φ Ψ →
      e (QuotientGroup.mk (toCocyclesX htriv hΦ)) = (χ i₀)⁻¹ := by
    intro Φ Ψ hΦ h
    let φ := Θ₀.symm.toMulEquiv.toMonoidHom
    let η := (ProfiniteGrp.ProfiniteCompletion.eta (GrpCat.of (SurfaceGroup (g + 1) 1))).hom
    let a₁ : Fin (g + 1) → ProfiniteSurfaceGroup (g + 1) 1 := fun i ↦ η (genA i)
    let b₁ : Fin (g + 1) → ProfiniteSurfaceGroup (g + 1) 1 := fun i ↦ η (genB i)
    have hcomm : commProd a₁ b₁ = (CuspCentral.cuspHat (g + 1))⁻¹ := by
      simp only [a₁, b₁]
      rw [← map_commProd, CuspCentral.commProd_genA_genB_one, map_inv]
      rfl
    have hfill' : ∀ γ, fillX D eL U γ = Θ₀.symm (CuspCentral.fillHat (g + 1) (Θ γ)) :=
      fun γ ↦ (ContinuousMulEquiv.eq_symm_apply Θ₀).2 (hfill γ)
    have hX : ∀ i, (Ψ (Θ.symm (a₁ i))).g = φ (genAhat i) := fun i ↦ by
      rw [h.1, hfill', ContinuousMulEquiv.apply_symm_apply]
      simp only [a₁, η, φ]
      erw [CuspCentral.fillHat_eta, CuspCentral.fillHom_genA]
      rfl
    have hY : ∀ i, (Ψ (Θ.symm (b₁ i))).g = φ (genBhat i) := fun i ↦ by
      rw [h.1, hfill', ContinuousMulEquiv.apply_symm_apply]
      simp only [b₁, η, φ]
      erw [CuspCentral.fillHat_eta, CuspCentral.fillHom_genB]
      rfl
    have hAB : commProd (fun i ↦ φ (genAhat (g := g + 1) i)) (fun i ↦ φ (genBhat i)) = 1 := by
      rw [← map_commProd, commProd_genAhat, map_one]
    have hrel := commProd_eq_incl_relVal hAB Φ _ _ hX hY
    have hL : commProd (fun i ↦ Ψ (Θ.symm (a₁ i))) (fun i ↦ Ψ (Θ.symm (b₁ i))) =
        Twist.incl (χ i₀)⁻¹ := by
      have := map_commProd (Ψ.comp Θ.symm.toMulEquiv.toMonoidHom) a₁ b₁
      change Ψ (Θ.symm (commProd a₁ b₁)) =
        commProd (fun i ↦ Ψ (Θ.symm (a₁ i))) (fun i ↦ Ψ (Θ.symm (b₁ i))) at this
      rw [← this, hcomm, map_inv, map_inv, map_inv]
      congr 1
      exact h.2 i₀
    rw [hL] at hrel
    have hrel' := (Twist.incl_injective hrel).symm
    rw [← relVal_comap φ commProd_genAhat Φ] at hrel'
    exact hrel'
  exact e.injective ((key hΦ h).trans (key hΦ' h').symm)

/-- Pushing a twisted product forward along a coefficient homomorphism. -/
def twistMap {G M M' : Type*} [Group G] [CommGroup M] [CommGroup M'] (e : M →* M')
    (Φ : TrivCocycle G M) : Twist Φ →* Twist (⟨e ∘ Φ.1, TrivCocycle.map_mem e Φ.2⟩ :
      TrivCocycle G M') where
  toFun x := ⟨e x.m, x.g⟩
  map_one' := by
    ext
    · change e (Φ.1 (1, 1))⁻¹ = (e (Φ.1 (1, 1)))⁻¹
      rw [map_inv]
    · rfl
  map_mul' x y := by
    ext
    · change e (x.m * y.m * Φ.1 (x.g, y.g)) = e x.m * e y.m * e (Φ.1 (x.g, y.g))
      rw [map_mul, map_mul]
    · rfl

omit [IsAlgClosed k] [CharZero k] [X.Over (Spec (.of k))] [IsCurveOver k X] [NeZero n] in
/-- Cusp pushouts are compatible with change of coefficients. -/
lemma IsCuspPushout.map {M M' : Type*} [CommGroup M] [CommGroup M'] (e : M →* M')
    {χ : cuspInertia D X eL hH U W₀ → M}
    {Φ : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) M}
    {Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ}
    (h : IsCuspPushout hH U χ Φ Ψ) :
    IsCuspPushout hH U (fun i ↦ e (χ i)) _ ((twistMap e Φ).comp Ψ) := by
  refine ⟨fun γ ↦ h.1 γ, fun i ↦ ?_⟩
  rw [MonoidHom.comp_apply, h.2 i]
  ext
  · change e (χ i * (Φ.1 (1, 1))⁻¹) = e (χ i) * (e (Φ.1 (1, 1)))⁻¹
    rw [map_mul, map_inv]
  · rfl

omit [NeZero n] in
include hk hτ in
/-- `IsCuspPushout.mk_eq` for `μ_n(Ω)` (in any universe), through `Shrink`. -/
theorem IsCuspPushout.mk_eq_mu [NeZero n] (hgen : 0 < (curveGenus k X).toNat)
    (hUx : (U : Set X)ᶜ = {x}) (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U : ¬ IsCentredOn D X eL U W₀) {χ : cuspInertia D X eL hH U W₀ → Mu n Ω}
    {Φ Φ' : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Mu n Ω)}
    {Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ}
    {Ψ' : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ'}
    (hΦ : IsLocallyConstant Φ.1) (hΦ' : IsLocallyConstant Φ'.1)
    (h : IsCuspPushout hH U χ Φ Ψ) (h' : IsCuspPushout hH U χ Φ' Ψ') :
    (QuotientGroup.mk (toCocyclesX (fun _ _ ↦ rfl) hΦ) : H2lc _ (Mu n Ω)) =
      QuotientGroup.mk (toCocyclesX (fun _ _ ↦ rfl) hΦ') := by
  let e : Mu n Ω ≃* Shrink.{0} (Mu n Ω) := Shrink.mulEquiv.symm
  haveI : Finite (Shrink.{0} (Mu n Ω)) := Finite.of_equiv _ (equivShrink _)
  letI : MulDistribMulAction π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Shrink.{0} (Mu n Ω)) :=
    Pi1.SurfaceGroup.trivialAction _ _
  have he := (h.map e.toMonoidHom).mk_eq hk hτ (fun _ _ ↦ rfl) hgen hUx hW₀ hW₀U
    (hΦ.comp e) (hΦ'.comp e) (h'.map e.toMonoidHom)
  obtain ⟨y, hy, hye⟩ := QuotientGroup.eq.1 he
  apply QuotientGroup.eq.2
  refine ⟨fun γ ↦ e.symm (y γ), hy.comp _, ?_⟩
  funext p
  obtain ⟨γ, δ⟩ := p
  have := congrFun hye (γ, δ)
  apply e.injective
  change e (e.symm (y δ) / e.symm (y (γ * δ)) * e.symm (y γ)) = e ((Φ.1 (γ, δ))⁻¹ * Φ'.1 (γ, δ))
  change y δ / y (γ * δ) * y γ = (e (Φ.1 (γ, δ)))⁻¹ * e (Φ'.1 (γ, δ)) at this
  simp only [map_mul, map_div, map_inv, MulEquiv.apply_symm_apply]
  exact this

include hk hτ in
/-- **[AbsTopIII] Prop. 1.4(ii), comparison with the Chern class**: the class in `H²(Δ_X, μ_n)`
of the pushout of `1 → I_x → Δ^{c-cn}_{U_x} → Δ_X → 1` along the natural `I_x ≅ Ẑ(1) ↠ μ_n`
(any `(Φ, Ψ)` with `IsCuspPushout`) is the first Chern class modulo `n` of `𝒪_X(x)`. -/
theorem IsCuspPushout.mk_eq_chernClassX (hgen : 0 < (curveGenus k X).toNat)
    (hUx : (U : Set X)ᶜ = {x}) (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U : ¬ IsCentredOn D X eL U W₀) (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω))
    {Φ : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Mu n Ω)}
    {Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ} (hΦ : IsLocallyConstant Φ.1)
    (h : IsCuspPushout hH U (chiN hH hk hτ n U hgen hUx hW₀ hW₀U hπW hπ) Φ Ψ) {f : Ω}
    (hf : IsChernRep D eL hH n U W₀ ((π : F D) : Ω) f) :
    QuotientGroup.mk (toCocyclesX (fun _ _ ↦ rfl) hΦ) = chernClassX hk hτ hf := by
  haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
  have hs := rhoX_sX hH hk hτ
  have hμ : ∀ (σ : D.H) (ζ : Ω), ζ ^ n = 1 → σ • ζ = ζ :=
    fun σ _ hζ ↦ smul_eq_of_pow_eq_one D n σ hζ
  have hstab := isOpen_stabilizer D
  have hq := isOpen_of_rhoX (hH := hH) hk hτ
  obtain ⟨g, hg, hglc⟩ := exists_isAdm hs hstab hq hf.toKummerInv
  obtain ⟨β, hβ⟩ := IsSepClosed.exists_pow_nat_eq f n
  have hK := kummerPushout_isCuspPushout hk hτ hgen hUx hW₀ hW₀U hπW hπ hf hg hβ
  refine (h.mk_eq_mu hk hτ hgen hUx hW₀ hW₀U hΦ
    (chernCocycles hs hμ hstab hq hf.ne hf.fix hg hglc).2.1 hK).trans ?_
  exact chernClassOf_eq_chernClass hs hμ hstab hq hf.toKummerInv hg hglc

/-! ### Existence of a representative of `𝒪_X(x)` modulo `n` -/

/-- `χ_n` as a continuous homomorphism. -/
noncomputable def chiNHom (hgen : 0 < (curveGenus k X).toNat) (hUx : (U : Set X)ᶜ = {x})
    (hW₀ : IsCentredOn D X eL ⊤ W₀) (hW₀U : ¬ IsCentredOn D X eL U W₀)
    (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω)) :
    cuspInertia D X eL hH U W₀ →* Mu n Ω :=
  (ZHatOne.proj (kIdx D n)).comp
    (CuspCentral.cuspInertiaZHatEquiv hk hτ hgen U hUx hW₀ hW₀U hπW hπ).toMulEquiv.toMonoidHom

include hk hτ in
/-- **The character `ψ` of `ker(H → Δ_X)`** (`X` of genus `≥ 1`): by the exact sequence
`1 → I_x → Δ^{c-cn}_{U} → Δ_X → 1` (`cuspCentral_exact_curve`) and `I_x ≅ Ẑ(1)`, the
`I_x`-component composed with `χ_n` is a continuous character of `ker(H → Δ_X)`, invariant under
conjugation by `H`, trivial on the inertia of the places of `U` and equal to the tame character
on `I_{W₀}`. -/
theorem exists_psi (hgen : 0 < (curveGenus k X).toNat) (hUx : (U : Set X)ᶜ = {x})
    (hW₀ : IsCentredOn D X eL ⊤ W₀) (hW₀U : ¬ IsCentredOn D X eL U W₀)
    (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω)) :
    ∃ ψ : (rhoX D eL hH).ker →* Mu n Ω, Continuous ψ ∧
      (∀ (h : D.H) (σ : (rhoX D eL hH).ker),
        ψ ⟨h⁻¹ * σ * h, (rhoX D eL hH).normal_ker.conj_mem' _ σ.2 h⟩ = ψ σ) ∧
      (∀ W, IsCentredOn D X eL U W → ∀ σ : D.H,
        (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W → ∀ hσ, ψ ⟨σ, hσ⟩ = 1) ∧
      (∀ σ : inertiaH D W₀, ∀ hσ, ψ ⟨σ, hσ⟩ = ZHatOne.proj (kIdx D n) (tameChar hW₀.1 π σ)) := by
  have hUfin : (U : Set X)ᶜ.Finite := hUx ▸ Set.finite_singleton x
  obtain ⟨hIN, hIK, hKIN, -⟩ :=
    CuspCentral.cuspCentral_exact_curve D eL hH hk hτ hgen U hUx hW₀ hW₀U
  let ρU := D.chartHom hH (genericL D X eL U)
  let I := cuspInertia D X eL hH U W₀
  let K := (fillX D eL U).ker
  let N' : Subgroup π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) :=
    (⁅K, ⊤⁆ : Subgroup _).topologicalClosure
  haveI : N'.Normal := Subgroup.is_normal_topologicalClosure _
  let χ := chiNHom (hH := hH) hk hτ (n := n) hgen hUx hW₀ hW₀U hπW hπ
  let p := projIHom (K := K) hIN hKIN
  -- `ρ_U` maps `ker ρ_X` into `K`
  have hρK : ∀ σ : (rhoX D eL hH).ker, ρU σ ∈ K := fun σ ↦ by
    change fillX D eL U (ρU σ) = 1
    exact (fundamentalGroupMap_genericL D X eL hH le_top σ).trans σ.2
  let ρK : (rhoX D eL hH).ker →* K := (ρU.comp (rhoX D eL hH).ker.subtype).codRestrict K hρK
  let ψ : (rhoX D eL hH).ker →* Mu n Ω := χ.comp (p.comp ρK)
  -- conjugation invariance
  have hconj : ∀ (h : D.H) (σ : (rhoX D eL hH).ker),
      ψ ⟨h⁻¹ * σ * h, (rhoX D eL hH).normal_ker.conj_mem' _ σ.2 h⟩ = ψ σ := fun h σ ↦ by
    change χ (p (ρK _)) = χ (p (ρK σ))
    congr 1
    refine projIHom_eq_of_mem hIN hKIN ?_
    change (ρU σ)⁻¹ * ρU (h⁻¹ * σ * h) ∈ N'
    rw [map_mul, map_mul, map_inv]
    have hm := Subgroup.le_topologicalClosure _ (Subgroup.commutator_mem_commutator
      (K.inv_mem (hρK σ)) (Subgroup.mem_top ((ρU h)⁻¹)))
    rw [commutatorElement_def, inv_inv, inv_inv] at hm
    convert hm using 1
    group
  -- values on inertia
  have hψU : ∀ W, IsCentredOn D X eL U W → ∀ σ : D.H,
      (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W → ∀ hσ, ψ ⟨σ, hσ⟩ = 1 := by
    intro W hW σ hσW hσ
    have h1 : ρU σ = 1 := by
      rw [← MonoidHom.mem_ker, (genericL_spec D X eL hk hH hτ U hUfin).1,
        GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ (SU_subset_H D X eL U)]
      exact Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure
        ⟨σ.2, W, hW.1, hW.2, hσW⟩)
    have h2 : ρK ⟨σ, hσ⟩ = 1 := Subtype.ext h1
    change χ (p (ρK ⟨σ, hσ⟩)) = 1
    rw [h2, map_one, map_one]
  have hψ₀ : ∀ σ : inertiaH D W₀, ∀ hσ,
      ψ ⟨σ, hσ⟩ = ZHatOne.proj (kIdx D n) (tameChar hW₀.1 π σ) := by
    intro σ hσ
    have hmem : ((ρK ⟨σ, hσ⟩ : K) : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) ∈ I :=
      (CuspCentral.inertiaToCusp D eL hH U W₀ σ).2
    change χ (p (ρK ⟨σ, hσ⟩)) = _
    rw [show p (ρK ⟨σ, hσ⟩) = CuspCentral.inertiaToCusp D eL hH U W₀ σ from
      projIHom_of_mem hIN hKIN hmem]
    change ZHatOne.proj (kIdx D n) (CuspCentral.cuspInertiaZHatEquiv hk hτ hgen U hUx hW₀ hW₀U
      hπW hπ (CuspCentral.inertiaToCusp D eL hH U W₀ σ)) = _
    rw [CuspCentral.cuspInertiaZHatEquiv_inertiaToCusp]
  -- continuity: the kernel of `ψ` is closed of finite index
  have hIc : IsCompact (I : Set π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) := by
    change IsCompact (SetLike.coe (cuspInertia D X eL hH U W₀))
    rw [CuspCentral.cuspInertia_eq_map D eL hH U W₀, Subgroup.coe_map]
    exact (isClosed_inertiaH D W₀).isCompact.image (D.continuous_chartHom hH _)
  haveI : CompactSpace I := isCompact_iff_compactSpace.1 hIc
  have hχc : Continuous χ :=
    (ZHatOne.continuous_proj _).comp (CuspCentral.cuspInertiaZHatEquiv hk hτ hgen U hUx hW₀ hW₀U
      hπW hπ).continuous
  have hS : IsClosed {e : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) |
      ∃ i ∈ χ.ker, ∃ m ∈ N', ((i : I) : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) * m = e} := by
    have h1 : IsCompact (χ.ker : Set I) :=
      (isClosed_singleton.preimage hχc).isCompact
    have h2 : IsCompact (N' : Set π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) :=
      (Subgroup.isClosed_topologicalClosure _).isCompact
    have h3 := (h1.prod h2).image (f := fun q : I × π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) ↦
      (q.1 : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) * q.2)
      ((continuous_subtype_val.comp continuous_fst).mul continuous_snd)
    convert h3.isClosed using 1
    ext e
    simp only [Set.mem_setOf_eq, Set.mem_image, Set.mem_prod, SetLike.mem_coe, Prod.exists]
    constructor
    · rintro ⟨i, hi, m, hm, rfl⟩
      exact ⟨i, m, ⟨hi, hm⟩, rfl⟩
    · rintro ⟨i, m, ⟨hi, hm⟩, rfl⟩
      exact ⟨i, hi, m, hm, rfl⟩
  have hker : (ψ.ker : Set (rhoX D eL hH).ker) =
      (fun σ : (rhoX D eL hH).ker ↦ ρU σ) ⁻¹' {e | ∃ i ∈ χ.ker, ∃ m ∈ N',
        ((i : I) : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) * m = e} := by
    ext σ
    simp only [SetLike.mem_coe, MonoidHom.mem_ker, Set.mem_preimage, Set.mem_setOf_eq]
    exact projIHom_mem_iff hIN hKIN χ.ker (ρK σ)
  have hψc : Continuous ψ := by
    refine continuous_of_isOpen_ker ψ (Subgroup.isOpen_of_isClosed_of_finiteIndex _ ?_)
    rw [hker]
    exact hS.preimage ((D.continuous_chartHom hH _).comp continuous_subtype_val)
  exact ⟨ψ, hψc, hconj, hψU, hψ₀⟩

include hk hτ in
/-- **A representative of `𝒪_X(x)` modulo `n` exists** (`X` of genus `≥ 1`): by Kummer theory
over `Ω^{ker(H → Δ_X)}` the character `ψ` of `exists_psi` is `σ ↦ σ(α)/α`, and `f = αⁿ` is a
representative. -/
theorem exists_isChernRep (hgen : 0 < (curveGenus k X).toNat) (hUx : (U : Set X)ᶜ = {x})
    (hW₀ : IsCentredOn D X eL ⊤ W₀) (hW₀U : ¬ IsCentredOn D X eL U W₀)
    (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω)) :
    ∃ f, IsChernRep D eL hH n U W₀ ((π : F D) : Ω) f := by
  haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
  obtain ⟨ψ, hψc, hconj, hψU, hψ₀⟩ := exists_psi hk hτ (n := n) hgen hUx hW₀ hW₀U hπW hπ
  -- Kummer theory over `Ω^{ker ρ_X}`
  let NX : Subgroup (Ω ≃ₐ[K₀ k t] Ω) := (rhoX D eL hH).ker.map D.H.subtype
  have hkc : IsClosed ((rhoX D eL hH).ker : Set D.H) :=
    isClosed_singleton.preimage (D.continuous_chartHom hH _)
  have hNXc : IsClosed (NX : Set (Ω ≃ₐ[K₀ k t] Ω)) := by
    have : (NX : Set (Ω ≃ₐ[K₀ k t] Ω)) = Subtype.val '' ((rhoX D eL hH).ker : Set D.H) :=
      Subgroup.coe_map _ _
    rw [this]
    exact (hkc.isCompact.image continuous_subtype_val).isClosed
  let Lt : IntermediateField (K₀ k t) Ω := IntermediateField.fixedField NX
  have hfixLt : Lt.fixingSubgroup = NX := InfiniteGalois.fixingSubgroup_fixedField ⟨NX, hNXc⟩
  haveI : IsGalois Lt Ω := IsGalois.tower_top_of_isGalois (K₀ k t) Lt Ω
  have hmemNX : ∀ τ : Ω ≃ₐ[Lt] Ω, τ.restrictScalars (K₀ k t) ∈ NX := fun τ ↦ by
    rw [← hfixLt, IntermediateField.mem_fixingSubgroup_iff]
    intro y hy
    exact τ.commutes ⟨y, hy⟩
  have hNXH : ∀ τ' ∈ NX, ∃ h : τ' ∈ D.H, (⟨τ', h⟩ : D.H) ∈ (rhoX D eL hH).ker := by
    rintro τ' ⟨σ, hσ, rfl⟩
    exact ⟨σ.2, hσ⟩
  let res : (Ω ≃ₐ[Lt] Ω) →* (Ω ≃ₐ[K₀ k t] Ω) :=
    { toFun := fun τ ↦ τ.restrictScalars (K₀ k t), map_one' := rfl, map_mul' := fun _ _ ↦ rfl }
  have hres : Continuous res := CurvesJacobian.Kummer.continuous_of_apply_eq res fun _ _ ↦ rfl
  let toKer : (Ω ≃ₐ[Lt] Ω) →* (rhoX D eL hH).ker :=
    { toFun := fun τ ↦ ⟨⟨res τ, (hNXH _ (hmemNX τ)).1⟩, (hNXH _ (hmemNX τ)).2⟩
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl }
  have htoKer : Continuous toKer := (hres.subtype_mk _).subtype_mk _
  have hact : ∀ (τ : Ω ≃ₐ[Lt] Ω) (ζ : Mu n Ω), τ • ζ = ζ := fun τ ζ ↦ by
    refine Mu.ext (Units.ext ?_)
    have hζ : ((Mu.val ζ : Ωˣ) : Ω) ^ n = 1 := by
      rw [← Units.val_pow_eq_pow_val, Mu.val_pow_n, Units.val_one]
    exact smul_eq_of_pow_eq_one D n (toKer τ : D.H) hζ
  let c : ContH1.cocycles (Ω ≃ₐ[Lt] Ω) (Mu n Ω) :=
    ⟨fun τ ↦ ψ (toKer τ), hψc.comp htoKer, fun τ τ' ↦ by
      simp only [map_mul, hact]
      exact mul_comm _ _⟩
  haveI : NeZero ((n : Lt)) := ⟨Nat.cast_ne_zero.2 (NeZero.ne n)⟩
  obtain ⟨a, α, hα, hαc⟩ := CurvesJacobian.Kummer.exists_root_of_triv c hact
  -- the Kummer character of `α` on `ker ρ_X` is `ψ`
  have hσα : ∀ σ : (rhoX D eL hH).ker,
      (σ : D.H) • (α : Ω) = ((Mu.val (ψ σ) : Ωˣ) : Ω) * α := fun σ ↦ by
    have hσNX : ((σ : D.H) : Ω ≃ₐ[K₀ k t] Ω) ∈ NX := ⟨σ, σ.2, rfl⟩
    let τσ : Ω ≃ₐ[Lt] Ω :=
      { ((σ : D.H) : Ω ≃ₐ[K₀ k t] Ω) with
        commutes' := fun y ↦ (IntermediateField.mem_fixedField_iff _ _).1 y.2 _ hσNX }
    have hτσ : toKer τσ = σ := Subtype.ext (Subtype.ext (AlgEquiv.ext fun _ ↦ rfl))
    have := hαc τσ
    change ((Mu.val (ψ (toKer τσ)) : Ωˣ) : Ω) * α = τσ α at this
    rw [hτσ] at this
    exact this.symm
  have hαf : (α : Ω) ^ n = ((a : Lt) : Ω) := by
    have := congrArg Units.val hα
    simpa using this
  have hα0 : (α : Ω) ≠ 0 := α.ne_zero
  have hroot : ∀ β : Ω, β ^ n = ((a : Lt) : Ω) → (β / α) ^ n = 1 := fun β hβ ↦ by
    rw [div_pow, hβ, ← hαf, div_self (pow_ne_zero _ hα0)]
  have hfixa : ∀ σ ∈ (rhoX D eL hH).ker, σ • ((a : Lt) : Ω) = ((a : Lt) : Ω) := fun σ hσ ↦
    (IntermediateField.mem_fixedField_iff _ _).1 (a : Lt).2 _ ⟨σ, hσ, rfl⟩
  refine ⟨((a : Lt) : Ω), ⟨⟨by simp, hfixa, fun h ↦ ?_⟩, ?_, ?_⟩⟩
  · -- invariance modulo `n`-th powers
    refine ⟨h • (α : Ω) / α, fun σ hσ ↦ ?_, ?_⟩
    · have hc := hconj h ⟨σ, hσ⟩
      have h1 : σ • h • (α : Ω) = ((Mu.val (ψ ⟨σ, hσ⟩) : Ωˣ) : Ω) * h • (α : Ω) := by
        have e1 : σ • h • (α : Ω) = h • ((h⁻¹ * σ * h) • (α : Ω)) := by
          rw [smul_smul, smul_smul, ← mul_assoc, ← mul_assoc, mul_inv_cancel, one_mul]
        rw [e1]
        have e2 := hσα ⟨h⁻¹ * σ * h, (rhoX D eL hH).normal_ker.conj_mem' _ hσ h⟩
        change (h⁻¹ * σ * h) • (α : Ω) = _ at e2
        rw [e2, hc, smul_mul', smul_eq_of_pow_eq_one D n h (by
          rw [← Units.val_pow_eq_pow_val, Mu.val_pow_n, Units.val_one])]
      rw [smul_div₀', h1, hσα ⟨σ, hσ⟩]
      have hψ0 : ((Mu.val (ψ ⟨σ, hσ⟩) : Ωˣ) : Ω) ≠ 0 := Units.ne_zero _
      field_simp
    · rw [← hαf, smul_pow', div_pow]
      field_simp
  · -- unramified at the places of `U`
    intro W hW σ hσW β hβ
    have hσ : σ ∈ (rhoX D eL hH).ker := rhoX_eq_one hk hτ (isCentredOn_top hW) hσW
    have h1 := hσα ⟨σ, hσ⟩
    rw [hψU W hW σ hσW hσ, map_one, Units.val_one, one_mul] at h1
    have h2 := smul_eq_of_pow_eq_one D n σ (hroot β hβ)
    rw [smul_div₀', h1, div_left_inj' hα0] at h2
    exact h2
  · -- the tame character at `W₀`
    intro σ hσW β β₀ hβ hβ₀
    have hσ : σ ∈ (rhoX D eL hH).ker := rhoX_eq_one hk hτ hW₀ hσW
    have h1 := hσα ⟨σ, hσ⟩
    rw [hψ₀ ⟨σ, hσW⟩ hσ] at h1
    have hπ0 : ((π : F D) : Ω) ≠ 0 := by simp
    have hβ₀0 : β₀ ≠ 0 := ne_zero_of_pow_eq hπ0 hβ₀
    have hval := val_proj_tameChar hW₀.1 π ⟨σ, hσW⟩ (kIdx D n) (Units.mk0 β₀ hβ₀0)
      (Units.ext (by
        simp only [Units.val_pow_eq_pow_val, Units.val_mk0, Units.coe_map, MonoidHom.coe_coe]
        exact hβ₀))
    have h2 := smul_eq_of_pow_eq_one D n σ (hroot β hβ)
    have hβ0 : β ≠ 0 := ne_zero_of_pow_eq (by simp) hβ
    rw [smul_div₀', div_eq_iff ((smul_ne_zero_iff_ne σ).2 hα0)] at h2
    simp only [Units.val_mk0] at hval
    rw [h2]
    change β / α * ((⟨σ, hσ⟩ : (rhoX D eL hH).ker) : D.H) • (α : Ω) / β = _
    rw [h1]
    refine (congrArg (fun z : Ω ↦ β / α * (z * α) / β) hval).trans ?_
    change β / α * ((σ : Ω ≃ₐ[K₀ k t] Ω) β₀ / β₀ * α) / β = (σ : Ω ≃ₐ[K₀ k t] Ω) β₀ / β₀
    field_simp

omit [IsAlgClosed k] [CharZero k] [IsSepClosed Ω] [IsGalois (K₀ k t) Ω] [NeZero n] in
lemma smul_uniformiser (π : (F D)ˣ) (σ : D.H) : σ • ((π : F D) : Ω) = ((π : F D) : Ω) :=
  (IntermediateField.mem_fixedField_iff _ _).1 (π : F D).2 σ σ.2

include hk hτ in
/-- **[AbsTopIII] Prop. 1.4(ii)** (T3 l.1771–1802) for a proper curve `X` of genus `≥ 1` over
`k = k̄` of characteristic `0`, `x ∈ X`, `U = X ∖ {x}`, a place `W₀` over `x`, a uniformiser `π`
at `x` and `n ≥ 1`: there is a class `c ∈ H²(Δ_X, μ_n)` such that
* `c` is the first Chern class modulo `n` of `𝒪_X(x)` (`chernClassX` of every representative
  `f`, `div f ≡ x mod n` on the universal cover; representatives exist), i.e. under
  [Mzk19] Prop. 1.2(ii) `c` is the image of `1` under `M_X/n ≅ μ_n`;
* the extension `1 → I_x → Δ^{c-cn}_U → Δ_X → 1`, pushed out along the natural
  `I_x ≅ Ẑ(1) ↠ μ_n` (`chiN`, [AbsTopIII] Prop. 1.4(i)), exists as a locally constant twisted
  product, and **every** such pushout has class `c`.
So the class of the cuspidally central extension corresponds to the natural isomorphism
`M_X ≅ Ẑ(1) ≅ I_x`, modulo every `n`. -/
theorem cuspCentral_class_eq_chernClass (hgen : 0 < (curveGenus k X).toNat)
    (hUx : (U : Set X)ᶜ = {x}) (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U : ¬ IsCentredOn D X eL U W₀) (hπW : W₀.valuation ((π : F D) : Ω) < 1)
    (hπ : ∀ f ∈ F D, W₀.valuation f < 1 → W₀.valuation f ≤ W₀.valuation ((π : F D) : Ω)) :
    ∃ c : H2lc π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Mu n Ω),
      (∃ f, IsChernRep D eL hH n U W₀ ((π : F D) : Ω) f) ∧
      (∀ f (hf : IsChernRep D eL hH n U W₀ ((π : F D) : Ω) f), chernClassX hk hτ hf = c) ∧
      (∃ (Φ : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Mu n Ω))
        (Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ),
        IsLocallyConstant Φ.1 ∧
          IsCuspPushout hH U (chiN hH hk hτ n U hgen hUx hW₀ hW₀U hπW hπ) Φ Ψ) ∧
      ∀ (Φ : TrivCocycle π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) (Mu n Ω))
        (Ψ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) →* Twist Φ) (hΦ : IsLocallyConstant Φ.1),
        IsCuspPushout hH U (chiN hH hk hτ n U hgen hUx hW₀ hW₀U hπW hπ) Φ Ψ →
          QuotientGroup.mk (toCocyclesX (fun _ _ ↦ rfl) hΦ) = c := by
  haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
  obtain ⟨f, hf⟩ := exists_isChernRep hk hτ (n := n) hgen hUx hW₀ hW₀U hπW hπ
  have hπ0 : ((π : F D) : Ω) ≠ 0 := by simp
  refine ⟨chernClassX hk hτ hf, ⟨f, hf⟩, fun f' hf' ↦
    chernClassX_eq hk hτ hUx hW₀ hW₀U hπ0 (smul_uniformiser π) hf' hf, ?_,
    fun Φ Ψ hΦ h ↦ h.mk_eq_chernClassX hk hτ hgen hUx hW₀ hW₀U hπW hπ hΦ hf⟩
  obtain ⟨g, hg, hglc⟩ := exists_isAdm (rhoX_sX hH hk hτ) (isOpen_stabilizer D)
    (isOpen_of_rhoX (hH := hH) hk hτ) hf.toKummerInv
  obtain ⟨β, hβ⟩ := IsSepClosed.exists_pow_nat_eq f n
  exact ⟨_, _, (chernCocycles (rhoX_sX hH hk hτ) (fun σ _ hζ ↦ smul_eq_of_pow_eq_one D n σ hζ)
    (isOpen_stabilizer D) (isOpen_of_rhoX (hH := hH) hk hτ) hf.ne hf.fix hg hglc).2.1,
    kummerPushout_isCuspPushout hk hτ hgen hUx hW₀ hW₀U hπW hπ hf hg hβ⟩

end Curve

end CurvesJacobian.ChernClass
