import CurvesJacobian.Cusp.HemiPi1
import CurvesJacobian.Cusp.EllipticMulByN

/-!
# The punctured hemi-elliptic orbicurve `U_X = [(E ∖ E[N]) / ±1]`, Galois form (MR8)

Let `E` be an elliptic curve over a field `K` of characteristic `0`, `N ≥ 1`, `Ω = K(Ē)^alg`,
`x ∈ K(Ē)` the Weierstrass coordinate and `C = [(E ∖ {O}) / ±1]` with Galois data `hemiData E`
(`CurvesJacobian.Cusp.HemiPi1`). The open sub-orbicurve `U_X = [(E ∖ E[N]) / ±1]` of `C`
([AbsTopII] Cor. 3.3 (iii), IUT I Def. 3.1 (b), Rem. 3.1.7 (i)) has coarse space
`(E ∖ E[N]) / ±1 ⊆ 𝔸¹ ∖ {x(E[N] ∖ O)}`, an affine curve with coordinate
`τ = x + 1/ΨSq_N(x)` (`ΨSq_N(x) = ψ_N²`, `ψ_N` the division polynomial). We work in the Galois
form `π₁ = H ⧸ ⟨⟨S⟩⟩` (pi1's `equivPi1`, SGA 1 V.8.2):

* `CurvesJacobian.Cusp.tauN₃`; `isIntegral_xN_tauN₃` (`x` is a root of `(X - τ) ΨSq_N(X) + 1`,
  leading coefficient `N²`), `transcendental_tauN₃`;
* `CurvesJacobian.Cusp.hemiDataN E N : GaloisData K τ`: `H` is the stabilizer of `x` in
  `Gal(Ω / K(τ))` (`= Gal(Ω / K(x))`), `H_L = Gal(Ω / K(Ē))`; `L` is the same subfield of `Ω`
  as for `hemiData E` (`mem_hemiDataN_L_iff`); `hemiHEquivN : H_τ ≃ₜ* H_x`,
  `hemiAZEquivN : A ≃* ℤ/2`, `index_range_orbiIncl_hemiN : [Π_{U_X} : Π_U] = 2`;
* `mem_range_germ_VNE_iff`: `Γ(E ∖ E[N]) ⊆ K(Ē)` is the integral closure of `K[τ]`; hence
  `sectionsVNEHemiAlgEquiv : Γ(E ∖ E[N]) ≃ₐ[K] R` and `hemiRNEquiv : K[E][1/ψ_N] ≃ₐ[K] R`,
  compatible with the embeddings into `Ω` (`algebraMap_sectionsVNEHemiAlgEquiv`,
  `algebraMap_hemiRNEquiv`); so `hemiPiUXEquivN : etalePi1 R A Ω ≃ₜ* H_τ ⧸ ⟨⟨S_τ⟩⟩` is the Galois
  form of `Π_{U_X}`;
* `hemiFillN : Π_{U_X} = H_τ ⧸ ⟨⟨S_τ⟩⟩ ↠ Π_C = H_x ⧸ ⟨⟨S_x⟩⟩` (`hemiHEquivN_mem_S`: `S_τ ⊆ S_x`,
  as `x` is integral over `K[τ]`), surjective (`hemiFillN_surjective`), compatible with
  `A ≅ ℤ/2` (`orbiProj_hemiFillN`), with the projections to `Gal(K̄ / K)`
  (`piConstC_hemiFillN`) and with the orbifold extensions (`hemiFillLN : Π_U ↠ Π_X`,
  `hemiFillN_orbiIncl`); its kernel is the closed normal subgroup generated by the images of
  `S_x ∖ S_τ`, the inertia at the places over `E[N] ∖ {O}` (`ker_hemiFillN`); on étale
  fundamental groups: `hemiFillEtN`.

Generic tools: `stabCEquiv₃` (`Gal(Ω / k(t))_s ≃ₜ* Gal(Ω / k(s))` for `t ∈ k(s)`),
`continuous_of_apply_eq₃`, `pi1Hom₃` and `ker_pi1Hom₃_eq` (functoriality of `H ⧸ ⟨⟨S⟩⟩` across
Galois groups).
-/

open CategoryTheory AlgebraicGeometry Polynomial Belyi Pi1.Orbifold AffOrbicurve Topology

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section GenericIntegral

/-- **Transitivity of integrality** through an algebra all of whose elements are integral. -/
lemma isIntegral_trans_of_forall₃ {R S B : Type*} [CommRing R] [CommRing S] [CommRing B]
    [Algebra R B] [Algebra S B] (hS : ∀ s : S, IsIntegral R (algebraMap S B s)) {z : B}
    (hz : IsIntegral S z) : IsIntegral R z := by
  let φ : S →+* integralClosure R B :=
    (algebraMap S B).codRestrict (integralClosure R B).toSubring hS
  obtain ⟨p, hpm, hp⟩ := hz
  have hc : (algebraMap (integralClosure R B) B).comp φ = algebraMap S B :=
    RingHom.ext fun _ => rfl
  have hz' : IsIntegral (integralClosure R B) z := by
    refine ⟨p.map φ, hpm.map φ, ?_⟩
    rw [eval₂_map, hc]
    exact hp
  exact isIntegral_trans z hz'

/-- If `P(x) ≠ 0`, then `x` is integral over `K[x + 1/P(x)]`: it is a root of
`(X - τ) P(X) + 1`. -/
lemma isIntegral_adjoin_add_inv₃ {K F : Type*} [Field K] [Field F] [Algebra K F] (P : K[X])
    (x : F) (hP : aeval x P ≠ 0) :
    IsIntegral (Algebra.adjoin K {x + (aeval x P)⁻¹}) x := by
  have hP0 : P ≠ 0 := by
    rintro rfl
    exact hP (map_zero _)
  let A := Algebra.adjoin K {x + (aeval x P)⁻¹}
  let τA : A := ⟨x + (aeval x P)⁻¹, Algebra.subset_adjoin rfl⟩
  have hP₁ : (P * C P.leadingCoeff⁻¹).Monic := monic_mul_leadingCoeff_inv hP0
  have hm : ((X - C τA) * (P * C P.leadingCoeff⁻¹).map (algebraMap K A)).Monic :=
    (monic_X_sub_C τA).mul (hP₁.map _)
  have hdeg : 0 < ((X - C τA) * (P * C P.leadingCoeff⁻¹).map (algebraMap K A)).degree := by
    rw [← natDegree_pos_iff_degree_pos, (monic_X_sub_C τA).natDegree_mul (hP₁.map _),
      natDegree_X_sub_C]
    omega
  refine ⟨(X - C τA) * (P * C P.leadingCoeff⁻¹).map (algebraMap K A) +
    C (algebraMap K A P.leadingCoeff⁻¹), hm.add_of_left (degree_C_le.trans_lt hdeg), ?_⟩
  have e1 : (algebraMap A F).comp (algebraMap K A) = algebraMap K F :=
    (IsScalarTower.algebraMap_eq K A F).symm
  rw [eval₂_add, eval₂_mul, eval₂_sub, eval₂_X, eval₂_C, eval₂_map, e1, eval₂_C,
    ← RingHom.comp_apply, e1, ← aeval_def, map_mul, aeval_C]
  change (x - (x + (aeval x P)⁻¹)) * (aeval x P * algebraMap K F P.leadingCoeff⁻¹) +
    algebraMap K F P.leadingCoeff⁻¹ = 0
  rw [show x - (x + (aeval x P)⁻¹) = -(aeval x P)⁻¹ by ring, neg_mul, ← mul_assoc,
    inv_mul_cancel₀ hP, one_mul, neg_add_cancel]

/-- If `x` is transcendental and integral over `K[τ]`, then `τ` is transcendental. -/
lemma transcendental_of_isIntegral_adjoin₃ {K F : Type*} [Field K] [Field F] [Algebra K F]
    {x τ : F} (hx : Transcendental K x) (h : IsIntegral (Algebra.adjoin K {τ}) x) :
    Transcendental K τ := by
  intro hτ
  apply hx
  have hle : Algebra.adjoin K {τ} ≤ integralClosure K F :=
    Algebra.adjoin_le (Set.singleton_subset_iff.2 hτ.isIntegral)
  have hS : ∀ s : Algebra.adjoin K {τ}, IsIntegral K (algebraMap _ F s) := fun s =>
    (mem_integralClosure_iff _ _).1 (hle s.2)
  exact (isIntegral_trans_of_forall₃ hS h).isAlgebraic

/-- An element integral over `k[t]` lies in every valuation subring containing `k` and `t`. -/
lemma mem_valuationSubring_of_isIntegral_adjoin₃ {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω]
    (W : ValuationSubring Ω) (hk : ∀ c : k, algebraMap k Ω c ∈ W) {t : Ω} (ht : t ∈ W)
    {a : Ω} (ha : IsIntegral (Algebra.adjoin k {t}) a) : a ∈ W := by
  have hle : ∀ s : Algebra.adjoin k {t}, (s : Ω) ∈ W := by
    rintro ⟨s, hs⟩
    change s ∈ W
    induction hs using Algebra.adjoin_induction with
    | mem w hw =>
      rw [Set.mem_singleton_iff] at hw
      subst hw
      exact ht
    | algebraMap c => exact hk c
    | add w v _ _ hw hv => exact add_mem hw hv
    | mul w v _ _ hw hv => exact mul_mem hw hv
  let φ : Algebra.adjoin k {t} →+* W := (algebraMap _ Ω).codRestrict W.toSubring hle
  obtain ⟨p, hpm, hp⟩ := ha
  have hc : (algebraMap W Ω).comp φ = algebraMap (Algebra.adjoin k {t}) Ω :=
    RingHom.ext fun _ => rfl
  have hW : IsIntegral W a := by
    refine ⟨p.map φ, hpm.map φ, ?_⟩
    rw [eval₂_map, hc]
    exact hp
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := W) (K := Ω)).1 hW
  rw [← hy]
  exact y.2

end GenericIntegral

section GenericGalois

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω]

/-- The automorphisms of `Ω` over `k(t)` fixing `s`. -/
def stabSub₃ (t s : Ω) : Subgroup (Ω ≃ₐ[K₀ k t] Ω) where
  carrier := {σ | σ s = s}
  mul_mem' {a b} ha hb := by
    have ha' : a s = s := ha
    have hb' : b s = s := hb
    change (a * b) s = s
    rw [AlgEquiv.mul_apply, hb', ha']
  one_mem' := rfl
  inv_mem' {a} ha := by
    have ha' : a s = s := ha
    change a⁻¹ s = s
    calc a⁻¹ s = a⁻¹ (a s) := by rw [ha']
      _ = s := by rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]

lemma mem_stabSub₃ {t s : Ω} (σ : Ω ≃ₐ[K₀ k t] Ω) : σ ∈ stabSub₃ t s ↔ σ s = s := Iff.rfl

/-- An automorphism over `k(t)` fixing `s` fixes `k(s)`. -/
lemma fix_of_fix₃ {t s : Ω} (σ : Ω ≃ₐ[K₀ k t] Ω) (hσ : σ s = s) (a : K₀ k s) :
    σ (a : Ω) = a := by
  have h : (σ.restrictScalars k).toAlgHom.comp (K₀ k s).val = (K₀ k s).val :=
    IntermediateField.adjoin_algHom_ext k fun x hx => by
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact hσ
  exact DFunLike.congr_fun h a

/-- An automorphism over `k(t)` fixing `s`, as an automorphism over `k(s)`. -/
def liftK₃ {t s : Ω} (σ : Ω ≃ₐ[K₀ k t] Ω) (hσ : σ s = s) : Ω ≃ₐ[K₀ k s] Ω :=
  AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) fun a => fix_of_fix₃ σ hσ a

@[simp] lemma liftK₃_apply {t s : Ω} (σ : Ω ≃ₐ[K₀ k t] Ω) (hσ : σ s = s) (a : Ω) :
    liftK₃ σ hσ a = σ a := rfl

lemma liftK₃_inv_apply {t s : Ω} (σ : Ω ≃ₐ[K₀ k t] Ω) (hσ : σ s = s) (a : Ω) :
    (liftK₃ σ hσ)⁻¹ a = σ⁻¹ a := by
  apply (liftK₃ σ hσ).injective
  rw [liftK₃_apply σ hσ (σ⁻¹ a), ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply,
    ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]

/-- An automorphism over `k(s)`, as an automorphism over `k(t)` for `t ∈ k(s)`. -/
def restrictK₃ {t s : Ω} (hts : t ∈ K₀ k s) (σ : Ω ≃ₐ[K₀ k s] Ω) : Ω ≃ₐ[K₀ k t] Ω :=
  AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) fun a =>
    σ.commutes ⟨a, IntermediateField.adjoin_simple_le_iff.2 hts a.2⟩

@[simp] lemma restrictK₃_apply {t s : Ω} (hts : t ∈ K₀ k s) (σ : Ω ≃ₐ[K₀ k s] Ω) (a : Ω) :
    restrictK₃ hts σ a = σ a := rfl

lemma restrictK₃_mem {t s : Ω} (hts : t ∈ K₀ k s) (σ : Ω ≃ₐ[K₀ k s] Ω) :
    restrictK₃ hts σ ∈ stabSub₃ t s :=
  σ.commutes ⟨s, IntermediateField.mem_adjoin_simple_self k s⟩

/-- **`Gal(Ω / k(t))_s ≅ Gal(Ω / k(s))`** for `t ∈ k(s)`: the stabilizer of `s` in
`Gal(Ω / k(t))` is the group of automorphisms fixing `k(s)`. -/
def stabEquiv₃ {t s : Ω} (hts : t ∈ K₀ k s) : stabSub₃ (k := k) t s ≃* (Ω ≃ₐ[K₀ k s] Ω) where
  toFun σ := liftK₃ σ.1 σ.2
  invFun σ := ⟨restrictK₃ hts σ, restrictK₃_mem hts σ⟩
  left_inv _ := Subtype.ext (AlgEquiv.ext fun _ => rfl)
  right_inv _ := AlgEquiv.ext fun _ => rfl
  map_mul' σ τ := AlgEquiv.ext fun a => by
    rw [AlgEquiv.mul_apply, liftK₃_apply, liftK₃_apply, liftK₃_apply, Subgroup.coe_mul,
      AlgEquiv.mul_apply]

@[simp] lemma stabEquiv₃_apply {t s : Ω} (hts : t ∈ K₀ k s) (σ : stabSub₃ (k := k) t s)
    (a : Ω) : stabEquiv₃ hts σ a = (σ : Ω ≃ₐ[K₀ k t] Ω) a := rfl

@[simp] lemma stabEquiv₃_symm_apply {t s : Ω} (hts : t ∈ K₀ k s) (σ : Ω ≃ₐ[K₀ k s] Ω)
    (a : Ω) : ((stabEquiv₃ hts).symm σ : Ω ≃ₐ[K₀ k t] Ω) a = σ a := rfl

/-- **Continuity criterion for maps to Galois groups**: a homomorphism `f : X → Gal(Ω / F₂)`
which agrees pointwise on `Ω` with a continuous homomorphism `u : X → Gal(Ω / F₁)`, `Ω / F₁`
algebraic, is continuous. -/
lemma continuous_of_apply_eq₃ {F₁ F₂ X : Type*} [Field F₁] [Field F₂] [Algebra F₁ Ω]
    [Algebra F₂ Ω] [Algebra.IsAlgebraic F₁ Ω] [Group X] [TopologicalSpace X]
    [IsTopologicalGroup X] (u : X →* (Ω ≃ₐ[F₁] Ω)) (hu : Continuous u)
    (f : X →* (Ω ≃ₐ[F₂] Ω)) (h : ∀ x a, f x a = u x a) : Continuous f := by
  refine continuous_of_continuousAt_one f ?_
  rw [ContinuousAt, map_one]
  intro s hs
  obtain ⟨E, hE, hEs⟩ := (krullTopology_mem_nhds_one_iff _ _ s).1 hs
  have hfg : E.toSubalgebra.FG := Subalgebra.fg_of_fg_toSubmodule (Module.Finite.iff_fg.1 hE)
  obtain ⟨T, hTfin, hT⟩ := IntermediateField.fg_def.1 (E.fg_of_fg_toSubalgebra hfg)
  haveI : Finite T := hTfin.to_subtype
  have hint : ∀ x ∈ T, IsIntegral F₁ x := fun x _ =>
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  haveI := IntermediateField.finiteDimensional_adjoin hint
  have hU : ((IntermediateField.adjoin F₁ T).fixingSubgroup : Set (Ω ≃ₐ[F₁] Ω)) ∈ 𝓝 1 :=
    (krullTopology_mem_nhds_one_iff _ _ _).2 ⟨_, inferInstance, subset_rfl⟩
  have h1 : Filter.Tendsto u (𝓝 1) (𝓝 1) := by
    simpa using hu.tendsto (1 : X)
  refine Filter.mem_map.2 (Filter.mem_of_superset (h1 hU) fun x hx => hEs ?_)
  have hσ' : u x ∈ (IntermediateField.adjoin F₁ T).fixingSubgroup := hx
  rw [IntermediateField.mem_fixingSubgroup_iff] at hσ'
  change f x ∈ E.fixingSubgroup
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro a ha
  rw [← hT] at ha
  exact (IntermediateField.forall_mem_adjoin_smul_eq_self_iff (F := F₂) (S := T) (f x)).2
    (fun y hy => by
      rw [AlgEquiv.smul_def, h]
      exact hσ' y (IntermediateField.subset_adjoin _ _ hy)) a ha

/-- **`Gal(Ω / k(t))_s ≅ Gal(Ω / k(s))`** as topological groups (`t ∈ k(s)`). -/
def stabCEquiv₃ {t s : Ω} [Algebra.IsAlgebraic (K₀ k t) Ω] [Algebra.IsAlgebraic (K₀ k s) Ω]
    (hts : t ∈ K₀ k s) : stabSub₃ (k := k) t s ≃ₜ* (Ω ≃ₐ[K₀ k s] Ω) where
  toMulEquiv := stabEquiv₃ hts
  continuous_toFun := continuous_of_apply_eq₃ (stabSub₃ t s).subtype continuous_subtype_val
    (stabEquiv₃ hts).toMonoidHom fun σ a => by
      rw [MulEquiv.coe_toMonoidHom, stabEquiv₃_apply]
      rfl
  continuous_invFun := continuous_induced_rng.2 (continuous_of_apply_eq₃ (MonoidHom.id _)
    continuous_id ((stabSub₃ t s).subtype.comp (stabEquiv₃ hts).symm.toMonoidHom) fun σ a => by
      rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Subgroup.coe_subtype,
        stabEquiv₃_symm_apply]
      rfl)

end GenericGalois

section TopEquiv

/-- `⊤ ≅ G` as topological groups. -/
def topCEquiv₃ (G : Type*) [Group G] [TopologicalSpace G] : (⊤ : Subgroup G) ≃ₜ* G where
  toMulEquiv := Subgroup.topEquiv
  continuous_toFun := continuous_subtype_val
  continuous_invFun := continuous_induced_rng.2 continuous_id

end TopEquiv

section GenericPi1

variable {Ω P₁ P₂ : Type u} [Field Ω] [Field P₁] [Field P₂] [Algebra P₁ Ω] [Algebra P₂ Ω]
  {H₁ : Subgroup (Ω ≃ₐ[P₁] Ω)} {H₂ : Subgroup (Ω ≃ₐ[P₂] Ω)}
  {S₁ : Set (Ω ≃ₐ[P₁] Ω)} {S₂ : Set (Ω ≃ₐ[P₂] Ω)}

/-- **Functoriality of `H ⧸ ⟨⟨S⟩⟩` across Galois groups**: a continuous homomorphism `f : H₁ → H₂`
mapping `S₁ ⊆ H₁` into `S₂` maps `⟨⟨S₁⟩⟩` into `⟨⟨S₂⟩⟩`. -/
lemma kernel_le_comap_of_hom₃ (f : H₁ →* H₂) (hf : Continuous f) (hS₁ : S₁ ⊆ H₁)
    (hfS : ∀ s (hs : s ∈ S₁), ((f ⟨s, hS₁ hs⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂) :
    GaloisPi1.kernel H₁ S₁ ≤ (GaloisPi1.kernel H₂ S₂).comap f := by
  have hΓ : Subgroup.closure (GaloisPi1.conjSet H₁ S₁) ≤ H₁ := by
    rw [Subgroup.closure_le]
    rintro _ ⟨h, hh, s, hs, rfl⟩
    exact H₁.mul_mem (H₁.mul_mem hh (hS₁ hs)) (H₁.inv_mem hh)
  have hmap : ∀ g (hg : g ∈ Subgroup.closure (GaloisPi1.conjSet H₁ S₁)) (hgH : g ∈ H₁),
      ((f ⟨g, hgH⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ Subgroup.closure (GaloisPi1.conjSet H₂ S₂) := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      intro hgH
      obtain ⟨h, hh, s, hs, rfl⟩ := hg
      have he : (⟨h * s * h⁻¹, hgH⟩ : H₁) = ⟨h, hh⟩ * ⟨s, hS₁ hs⟩ * (⟨h, hh⟩ : H₁)⁻¹ := rfl
      rw [he, map_mul, map_mul, map_inv]
      exact Subgroup.subset_closure ⟨_, (f ⟨h, hh⟩).2, _, hfS s hs, rfl⟩
    | one =>
      intro hgH
      have he : (⟨1, hgH⟩ : H₁) = 1 := rfl
      rw [he, map_one]
      exact Subgroup.one_mem _
    | mul a b ha hb iha ihb =>
      intro hgH
      have he : (⟨a * b, hgH⟩ : H₁) = ⟨a, hΓ ha⟩ * ⟨b, hΓ hb⟩ := rfl
      rw [he, map_mul]
      exact Subgroup.mul_mem _ (iha (hΓ ha)) (ihb (hΓ hb))
    | inv a ha iha =>
      intro hgH
      have he : (⟨a⁻¹, hgH⟩ : H₁) = (⟨a, hΓ ha⟩ : H₁)⁻¹ := rfl
      rw [he, map_inv]
      exact Subgroup.inv_mem _ (iha (hΓ ha))
  intro x hx
  rw [GaloisPi1.kernel, Subgroup.mem_subgroupOf] at hx
  rw [Subgroup.mem_comap, GaloisPi1.kernel, Subgroup.mem_subgroupOf]
  have hxT : x ∈ closure (Subtype.val ⁻¹'
      (Subgroup.closure (GaloisPi1.conjSet H₁ S₁) : Set (Ω ≃ₐ[P₁] Ω)) : Set H₁) := by
    rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
    rw [GaloisPi1.ambientKernel, ← SetLike.mem_coe, Subgroup.topologicalClosure_coe] at hx
    have hsub : (Subgroup.closure (GaloisPi1.conjSet H₁ S₁) : Set (Ω ≃ₐ[P₁] Ω)) ⊆
        Subtype.val '' (Subtype.val ⁻¹'
          (Subgroup.closure (GaloisPi1.conjSet H₁ S₁) : Set (Ω ≃ₐ[P₁] Ω)) : Set H₁) :=
      fun y hy => ⟨⟨y, hΓ hy⟩, hy, rfl⟩
    exact closure_mono hsub hx
  have hfT : f '' (Subtype.val ⁻¹'
      (Subgroup.closure (GaloisPi1.conjSet H₁ S₁) : Set (Ω ≃ₐ[P₁] Ω)) : Set H₁) ⊆ Subtype.val ⁻¹'
      (Subgroup.closure (GaloisPi1.conjSet H₂ S₂) : Set (Ω ≃ₐ[P₂] Ω)) := by
    rintro _ ⟨y, hy, rfl⟩
    exact hmap y.1 hy y.2
  have h1 : f x ∈ closure (f '' (Subtype.val ⁻¹'
      (Subgroup.closure (GaloisPi1.conjSet H₁ S₁) : Set (Ω ≃ₐ[P₁] Ω)) : Set H₁)) :=
    image_closure_subset_closure_image hf ⟨x, hxT, rfl⟩
  have h2 := ((closure_mono hfT).trans (continuous_subtype_val.closure_preimage_subset _)) h1
  rw [GaloisPi1.ambientKernel, ← SetLike.mem_coe, Subgroup.topologicalClosure_coe]
  exact h2

variable [IsGalois P₁ Ω] [IsGalois P₂ Ω]

/-- The continuous homomorphism `H₁ ⧸ ⟨⟨S₁⟩⟩ → H₂ ⧸ ⟨⟨S₂⟩⟩` induced by `f`. -/
def pi1Hom₃ (hH₁ : IsClosed (H₁ : Set (Ω ≃ₐ[P₁] Ω))) (hH₂ : IsClosed (H₂ : Set (Ω ≃ₐ[P₂] Ω)))
    (f : H₁ →* H₂) (hf : Continuous f) (hS₁ : S₁ ⊆ H₁)
    (hfS : ∀ s (hs : s ∈ S₁), ((f ⟨s, hS₁ hs⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂) :
    GaloisPi1.pi1 H₁ S₁ hH₁ →ₜ* GaloisPi1.pi1 H₂ S₂ hH₂ where
  toMonoidHom := QuotientGroup.map _ _ f (kernel_le_comap_of_hom₃ f hf hS₁ hfS)
  continuous_toFun := by
    change Continuous (QuotientGroup.map (GaloisPi1.kernel H₁ S₁) (GaloisPi1.kernel H₂ S₂) f
      (kernel_le_comap_of_hom₃ f hf hS₁ hfS))
    rw [(QuotientGroup.isQuotientMap_mk (GaloisPi1.kernel H₁ S₁)).continuous_iff]
    exact QuotientGroup.continuous_mk.comp hf

lemma pi1Hom₃_mk (hH₁ : IsClosed (H₁ : Set (Ω ≃ₐ[P₁] Ω)))
    (hH₂ : IsClosed (H₂ : Set (Ω ≃ₐ[P₂] Ω))) (f : H₁ →* H₂) (hf : Continuous f)
    (hS₁ : S₁ ⊆ H₁) (hfS : ∀ s (hs : s ∈ S₁), ((f ⟨s, hS₁ hs⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂)
    (x : H₁) :
    pi1Hom₃ hH₁ hH₂ f hf hS₁ hfS (QuotientGroup.mk x : H₁ ⧸ GaloisPi1.kernel H₁ S₁) =
      (QuotientGroup.mk (f x) : H₂ ⧸ GaloisPi1.kernel H₂ S₂) := rfl

lemma pi1Hom₃_surjective (hH₁ : IsClosed (H₁ : Set (Ω ≃ₐ[P₁] Ω)))
    (hH₂ : IsClosed (H₂ : Set (Ω ≃ₐ[P₂] Ω))) (f : H₁ →* H₂) (hf : Continuous f)
    (hS₁ : S₁ ⊆ H₁) (hfS : ∀ s (hs : s ∈ S₁), ((f ⟨s, hS₁ hs⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂)
    (hsurj : Function.Surjective f) : Function.Surjective (pi1Hom₃ hH₁ hH₂ f hf hS₁ hfS) := by
  intro y
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective (s := GaloisPi1.kernel H₂ S₂) y
  obtain ⟨x, rfl⟩ := hsurj g
  exact ⟨QuotientGroup.mk x, rfl⟩


/-- **The kernel of the transported filling map**: for `f : H₁ ≅ H₂` (with continuous inverse
`f'`) mapping `S₁` into `S₂ ⊆ H₂`, the kernel of `H₁ ⧸ ⟨⟨S₁⟩⟩ ↠ H₂ ⧸ ⟨⟨S₂⟩⟩` is the closed
normal subgroup generated by the images of the elements of `f⁻¹(S₂) ∖ S₁`. -/
theorem ker_pi1Hom₃_eq (hH₁ : IsClosed (H₁ : Set (Ω ≃ₐ[P₁] Ω)))
    (hH₂ : IsClosed (H₂ : Set (Ω ≃ₐ[P₂] Ω))) (f : H₁ →* H₂) (hf : Continuous f)
    (hS₁ : S₁ ⊆ H₁) (hfS : ∀ s (hs : s ∈ S₁), ((f ⟨s, hS₁ hs⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂)
    (hS₂ : S₂ ⊆ H₂) (f' : H₂ →* H₁) (hf' : Continuous f') (hff' : ∀ x, f (f' x) = x)
    (hf'f : ∀ x, f' (f x) = x) :
    (pi1Hom₃ hH₁ hH₂ f hf hS₁ hfS).toMonoidHom.ker =
      (Subgroup.normalClosure ((QuotientGroup.mk' (GaloisPi1.kernel H₁ S₁) :
        H₁ →* GaloisPi1.pi1 H₁ S₁ hH₁) '' (Subtype.val ⁻¹'
          ({σ | ∃ h : σ ∈ H₁, ((f ⟨σ, h⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂} \ S₁) :
            Set H₁))).topologicalClosure := by
  have hSS' : S₁ ⊆ {σ | ∃ h : σ ∈ H₁, ((f ⟨σ, h⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂} :=
    fun s hs => ⟨hS₁ hs, hfS s hs⟩
  have hS'H : {σ | ∃ h : σ ∈ H₁, ((f ⟨σ, h⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂} ⊆ H₁ :=
    fun _ hσ => hσ.1
  rw [← GaloisPi1.ker_pi1Map_eq hH₁ hSS' hS'H]
  have h1 := kernel_le_comap_of_hom₃ (S₂ := S₂) f hf hS'H fun s hs => hs.2
  have h2 := kernel_le_comap_of_hom₃
    (S₂ := {σ | ∃ h : σ ∈ H₁, ((f ⟨σ, h⟩ : H₂) : Ω ≃ₐ[P₂] Ω) ∈ S₂}) f' hf' hS₂ fun s hs =>
      ⟨(f' ⟨s, hS₂ hs⟩).2, by
        have he : (⟨((f' ⟨s, hS₂ hs⟩ : H₁) : Ω ≃ₐ[P₁] Ω), (f' ⟨s, hS₂ hs⟩).2⟩ : H₁) =
          f' ⟨s, hS₂ hs⟩ := rfl
        rw [he, hff']
        exact hs⟩
  ext y
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective y
  rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
  change (QuotientGroup.mk (f a) : H₂ ⧸ GaloisPi1.kernel H₂ S₂) = 1 ↔
    (QuotientGroup.mk (Subgroup.inclusion le_rfl a) : H₁ ⧸ GaloisPi1.kernel H₁ _) = 1
  rw [QuotientGroup.eq_one_iff, QuotientGroup.eq_one_iff]
  have he : Subgroup.inclusion (le_refl H₁) a = a := rfl
  rw [he]
  constructor
  · intro ha
    have := h2 ha
    rwa [Subgroup.mem_comap, hf'f] at this
  · intro ha
    exact h1 ha

end GenericPi1

section GenericCompat

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t₁ t₂ : Ω}
  (D₁ : GaloisData k t₁) (D₂ : GaloisData k t₂) [IsGalois (K₀ k t₁) Ω] [IsGalois (K₀ k t₂) Ω]
  (f : D₁.H →* D₂.H) (hf : Continuous f) (hfS : ∀ s (hs : s ∈ D₁.S),
    ((f ⟨s, D₁.le (D₁.S_subset_HL hs)⟩ : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.S)

/-- The map `Π₁ → Π₂` of orbifold fundamental groups induced by `f : H₁ → H₂`. -/
abbrev orbiHom₃ : GaloisPi1.pi1 D₁.H D₁.S D₁.isClosed_H →ₜ* GaloisPi1.pi1 D₂.H D₂.S D₂.isClosed_H :=
  pi1Hom₃ _ _ f hf (fun _ hs => D₁.le (D₁.S_subset_HL hs)) hfS

/-- Compatibility of `orbiHom₃` with the projections to `A`. -/
lemma orbiProj_orbiHom₃ (eA : D₁.A →* D₂.A) (he : ∀ h : D₁.H, eA (h : D₁.A) = (f h : D₂.A))
    (y : GaloisPi1.pi1 D₁.H D₁.S D₁.isClosed_H) :
    orbiProj D₂ (orbiHom₃ D₁ D₂ f hf hfS y) = eA (orbiProj D₁ y) := by
  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective y
  exact (he h).symm

/-- Compatibility of `orbiHom₃` with the projections to `Gal(k̄ / k)`. -/
lemma piConstC_orbiHom₃ (he : ∀ h : D₁.H, galResConst t₂ (f h : Ω ≃ₐ[K₀ k t₂] Ω) =
      galResConst t₁ (h : Ω ≃ₐ[K₀ k t₁] Ω))
    (y : GaloisPi1.pi1 D₁.H D₁.S D₁.isClosed_H) :
    piConstC D₂ (orbiHom₃ D₁ D₂ f hf hfS y) = piConstC D₁ y := by
  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective y
  exact he h

/-- Compatibility of `orbiHom₃` with the orbifold extensions `ι : Π_{X,i} → Π_{C,i}`. -/
lemma orbiIncl_orbiHom₃ (fL : D₁.HL →* D₂.HL) (hfL : Continuous fL) (hfLS : ∀ s (hs : s ∈ D₁.S),
      ((fL ⟨s, D₁.S_subset_HL hs⟩ : D₂.HL) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.S)
    (hc : ∀ (n : D₁.HL) (a : Ω), ((fL n : D₂.HL) : Ω ≃ₐ[K₀ k t₂] Ω) a =
      ((f (Subgroup.inclusion D₁.le n) : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) a)
    (y : GaloisPi1.pi1 D₁.HL D₁.S D₁.isClosed_HL) :
    orbiHom₃ D₁ D₂ f hf hfS (orbiIncl D₁ y) =
      orbiIncl D₂ (pi1Hom₃ _ _ fL hfL D₁.S_subset_HL hfLS y) := by
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective y
  have hn : Subgroup.inclusion D₂.le (fL n) = f (Subgroup.inclusion D₁.le n) :=
    Subtype.ext (AlgEquiv.ext (hc n))
  exact congrArg (QuotientGroup.mk (s := GaloisPi1.kernel D₂.H D₂.S)) hn.symm

end GenericCompat

section Hemi

variable {K : Type u} [Field K] [CharZero K] (E : WeierstrassCurve K) [E.IsElliptic] (N : ℕ)
  [NeZero N]

/-! ### The coordinate `τ = x + 1/ΨSq_N(x)` -/

/-- `ΨSq_N(x) = ψ_N² ∈ K(Ē)`. -/
def psiSqN₃ : (curveE E).functionField := aeval (xN E) (E.ΨSq N)

lemma psiSqN₃_ne_zero : psiSqN₃ E N ≠ 0 := fun h =>
  transcendental_xN E ⟨E.ΨSq N, E.ΨSq_ne_zero (intCast_N_ne_zero (K := K) N), h⟩

/-- **The coordinate `τ = x + 1/ΨSq_N(x)`** of the coarse space `U_X / ±1 ⊆ 𝔸¹`. -/
def tauN₃ : (curveE E).functionField := xN E + (psiSqN₃ E N)⁻¹

/-- **`x` is integral over `K[τ]`**: a root of `(X - τ) ΨSq_N(X) + 1`. -/
theorem isIntegral_xN_tauN₃ : IsIntegral (Algebra.adjoin K {tauN₃ E N}) (xN E) :=
  isIntegral_adjoin_add_inv₃ (E.ΨSq N) (xN E) (psiSqN₃_ne_zero E N)

/-- **`τ` is transcendental over `K`.** -/
theorem transcendental_tauN₃ : Transcendental K (tauN₃ E N) :=
  transcendental_of_isIntegral_adjoin₃ (transcendental_xN E) (isIntegral_xN_tauN₃ E N)

instance isGalois_K₀_tauN₃ :
    IsGalois (K₀ K (coordT (tauN₃ E N))) (FFClosure (curveE E)) :=
  isGalois_K₀_algebraicClosure (k := K) _ (transcendental_tauN₃ E N)

omit [NeZero N] in
lemma coordT_tauN₃ : coordT (tauN₃ E N) =
    coordT (xN E) + (aeval (coordT (xN E)) (E.ΨSq N))⁻¹ := by
  change algebraMap (curveE E).functionField (FFClosure (curveE E)) (xN E + (psiSqN₃ E N)⁻¹) =
    algebraMap _ _ (xN E) + (aeval (algebraMap (curveE E).functionField (FFClosure (curveE E))
      (xN E)) (E.ΨSq N))⁻¹
  rw [map_add, map_inv₀, psiSqN₃]
  congr 2
  exact (aeval_algHom_apply (IsScalarTower.toAlgHom K (curveE E).functionField
    (FFClosure (curveE E))) (xN E) (E.ΨSq N)).symm

omit [NeZero N] in
/-- `τ ∈ K(x)`. -/
lemma coordT_tauN₃_mem : coordT (tauN₃ E N) ∈ K₀ K (coordT (xN E)) := by
  rw [coordT_tauN₃]
  refine add_mem (IntermediateField.mem_adjoin_simple_self K _) (inv_mem ?_)
  exact IntermediateField.algebra_adjoin_le_adjoin K _ (aeval_mem_adjoin_singleton K _)

/-- `x` is integral over `K[τ]`, inside `Ω`. -/
theorem isIntegral_coordT_xN₃ :
    IsIntegral (A₀ K (coordT (tauN₃ E N))) (coordT (xN E)) :=
  (isIntegral_iff_one (curveGaloisData K (transcendental_tauN₃ E N)) (curveE E)
    (curveEquivL K (transcendental_tauN₃ E N)) (curveEquivL_algebraMap K _)
    (curveEquivL_τ K _) (xN E)).1 (isIntegral_xN_tauN₃ E N)

/-! ### The Galois data -/

omit [CharZero K] in
/-- Membership in `H_L = Gal(Ω / K(X))` for the curve Galois data. -/
lemma mem_curveHL_iff₃ {X : Scheme.{u}} [X.Over (Spec (.of K))] [IsIntegral X]
    [WeilCurves.FunctionField.IsFunctionField K X.functionField] {τ : X.functionField}
    (hτ : Transcendental K τ) (σ : FFClosure X ≃ₐ[K₀ K (coordT τ)] FFClosure X) :
    σ ∈ (curveGaloisData K hτ).HL ↔
      ∀ z : X.functionField, σ (algebraMap _ (FFClosure X) z) = algebraMap _ (FFClosure X) z := by
  change σ ∈ (imageL (k := K) τ).fixingSubgroup ↔ _
  rw [IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h z
    exact h _ ((mem_imageL_iff _).2 ⟨z, rfl⟩)
  · rintro h _ ⟨z, rfl⟩
    exact h z

/-- **The Galois data of the punctured hemi-elliptic orbicurve `[(E ∖ E[N]) / ±1]`** with
coordinate `τ`: `H = Gal(Ω / K(x))` (the stabilizer of `x` in `Gal(Ω / K(τ))`),
`H_L = Gal(Ω / K(Ē))`. -/
def hemiDataN : GaloisData K (coordT (tauN₃ E N)) where
  H := stabSub₃ (coordT (tauN₃ E N)) (coordT (xN E))
  HL := (curveGaloisData K (transcendental_tauN₃ E N)).HL
  le σ hσ := (mem_curveHL_iff₃ (transcendental_tauN₃ E N) σ).1 hσ (xN E)
  isOpen_HL := (curveGaloisData K (transcendental_tauN₃ E N)).isOpen_HL
  conj_mem h hh n hn := by
    have hn' := (mem_curveHL_iff₃ (transcendental_tauN₃ E N) n).1 hn
    have hm : liftK₃ n (hn' (xN E)) ∈ (hemiData E).HL :=
      (mem_curveHL_iff₃ (transcendental_xN E) _).2 fun z => by
        rw [liftK₃_apply]
        exact hn' z
    have hc := (mem_curveHL_iff₃ (transcendental_xN E) _).1
      ((hemiHL_normal E).conj_mem _ hm (liftK₃ h hh))
    refine (mem_curveHL_iff₃ (transcendental_tauN₃ E N) _).2 fun z => ?_
    have hz := hc z
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, liftK₃_inv_apply, liftK₃_apply,
      liftK₃_apply] at hz
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply]
    exact hz
  transcendental := (curveGaloisData K (transcendental_tauN₃ E N)).transcendental

lemma hemiDataN_H : (hemiDataN E N).H = stabSub₃ (coordT (tauN₃ E N)) (coordT (xN E)) := rfl

lemma mem_hemiDataN_HL_iff (σ : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))]
    FFClosure (curveE E)) : σ ∈ (hemiDataN E N).HL ↔
      ∀ z : (curveE E).functionField, σ (algebraMap _ _ z) = algebraMap _ _ z :=
  mem_curveHL_iff₃ (transcendental_tauN₃ E N) σ

lemma mem_hemiData_HL_iff (σ : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))]
    FFClosure (curveE E)) : σ ∈ (hemiData E).HL ↔
      ∀ z : (curveE E).functionField, σ (algebraMap _ _ z) = algebraMap _ _ z :=
  mem_curveHL_iff₃ (transcendental_xN E) σ

/-- **`L` is `K(Ē)`**, the same subfield of `Ω` as for `hemiData E`. -/
lemma hemiDataN_L : (hemiDataN E N).L = imageL (k := K) (tauN₃ E N) :=
  curveGaloisData_L K (transcendental_tauN₃ E N)

lemma mem_hemiDataN_L_iff (a : FFClosure (curveE E)) :
    a ∈ (hemiDataN E N).L ↔ a ∈ (hemiData E).L := by
  have h2 : (hemiData E).L = imageL (k := K) (xN E) := curveGaloisData_L K (transcendental_xN E)
  rw [hemiDataN_L, h2, mem_imageL_iff, mem_imageL_iff]

/-! ### `H_τ ≅ Gal(Ω / K(x)) = (hemiData E).H` and `A ≅ ℤ/2` -/

/-- **`H_τ ≅ H_x`** as topological groups: both are the automorphisms of `Ω` fixing `K(x)`. -/
def hemiHEquivN : (hemiDataN E N).H ≃ₜ* (hemiData E).H :=
  (stabCEquiv₃ (coordT_tauN₃_mem E N)).trans (topCEquiv₃ _).symm

@[simp] lemma hemiHEquivN_apply (h : (hemiDataN E N).H) (a : FFClosure (curveE E)) :
    ((hemiHEquivN E N h : (hemiData E).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) a =
      (h : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) a := rfl

@[simp] lemma hemiHEquivN_symm_apply (h : (hemiData E).H) (a : FFClosure (curveE E)) :
    (((hemiHEquivN E N).symm h : (hemiDataN E N).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) a =
      (h : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) a := rfl

/-- `H_τ → H_x` as a homomorphism. -/
def hemiHHomN : (hemiDataN E N).H →* (hemiData E).H := (hemiHEquivN E N).toMulEquiv.toMonoidHom

lemma hemiHHomN_apply (h : (hemiDataN E N).H) (a : FFClosure (curveE E)) :
    ((hemiHHomN E N h : (hemiData E).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) a =
      (h : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) a := rfl

lemma continuous_hemiHHomN : Continuous (hemiHHomN E N) := (hemiHEquivN E N).continuous_toFun

lemma hemiHHomN_surjective : Function.Surjective (hemiHHomN E N) := (hemiHEquivN E N).surjective

lemma mem_HL_hemiHEquivN (h : (hemiDataN E N).H) :
    hemiHEquivN E N h ∈ (hemiData E).HL.subgroupOf (hemiData E).H ↔
      h ∈ (hemiDataN E N).HL.subgroupOf (hemiDataN E N).H := by
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf, mem_hemiData_HL_iff,
    mem_hemiDataN_HL_iff]
  simp only [hemiHEquivN_apply]

lemma map_HL_hemiHEquivN :
    ((hemiDataN E N).HL.subgroupOf (hemiDataN E N).H).map
      (hemiHEquivN E N).toMulEquiv.toMonoidHom = (hemiData E).HL.subgroupOf (hemiData E).H := by
  ext y
  constructor
  · rintro ⟨h, hh, rfl⟩
    exact (mem_HL_hemiHEquivN E N h).2 hh
  · intro hy
    refine ⟨(hemiHEquivN E N).symm y, (mem_HL_hemiHEquivN E N _).1 ?_, ?_⟩
    · rwa [ContinuousMulEquiv.apply_symm_apply]
    · exact (hemiHEquivN E N).apply_symm_apply y

/-- **`A_τ ≅ A_x`**: `H_τ ⧸ H_L ≅ Gal(K(Ē) / K(x))`. -/
def hemiAEquivN₃ : (hemiDataN E N).A ≃* (hemiData E).A :=
  QuotientGroup.congr _ _ (hemiHEquivN E N).toMulEquiv (map_HL_hemiHEquivN E N)

lemma hemiAEquivN₃_mk (h : (hemiDataN E N).H) :
    hemiAEquivN₃ E N (h : (hemiDataN E N).A) = (hemiHHomN E N h : (hemiData E).A) := rfl

/-- **`A ≅ ℤ/2`.** -/
def hemiAZEquivN : (hemiDataN E N).A ≃* Multiplicative (ZMod 2) :=
  (hemiAEquivN₃ E N).trans (hemiAEquiv E)

theorem card_hemiAN : Nat.card (hemiDataN E N).A = 2 :=
  (Nat.card_congr (hemiAEquivN₃ E N).toEquiv).trans (card_hemiA E)

/-- **`[Π_{U_X} : Π_U] = 2`.** -/
theorem index_range_orbiIncl_hemiN : (orbiIncl (hemiDataN E N)).toMonoidHom.range.index = 2 :=
  (Nat.card_congr (orbiQuotEquiv (hemiDataN E N)).toEquiv).trans (card_hemiAN E N)

/-- **`Π_{U_X} = π₁ᵉᵗ([Spec K[E][1/ψ_N] / ±1]) ≅ H_τ ⧸ ⟨⟨S_τ⟩⟩`** (pi1's `equivPi1`, the Galois
form of the orbifold fundamental group). -/
abbrev hemiPiUXEquivN : etalePi1 (hemiDataN E N).R (hemiDataN E N).A (FFClosure (curveE E)) ≃ₜ*
    GaloisPi1.pi1 (hemiDataN E N).H (hemiDataN E N).S (hemiDataN E N).isClosed_H :=
  (hemiDataN E N).equivPi1

/-! ### `S_τ ⊆ S_x` and the filling map `Π_{U_X} ↠ Π_C` -/

/-- **`S_τ ⊆ S_x`**: a place of `Ω` centered on `Spec K[τ]` is centered on `Spec K[x]` (`x` is
integral over `K[τ]`), with the same inertia. -/
theorem mem_S_of_apply_eqN (s : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))]
    FFClosure (curveE E)) (hs : s ∈ (hemiDataN E N).S)
    (σ : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E))
    (hσ : ∀ a, σ a = s a) : σ ∈ (hemiData E).S := by
  obtain ⟨hsL, W, hk, ht, hI⟩ := hs
  refine ⟨?_, W, hk, mem_valuationSubring_of_isIntegral_adjoin₃ W hk ht
    (isIntegral_coordT_xN₃ E N), fun a ha => ?_⟩
  · rw [mem_hemiData_HL_iff]
    intro z
    rw [hσ]
    exact (mem_hemiDataN_HL_iff E N s).1 hsL z
  · rw [hσ]
    exact hI a ha

theorem hemiHEquivN_mem_S (s : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))]
    FFClosure (curveE E)) (hs : s ∈ (hemiDataN E N).S) :
    ((hemiHHomN E N ⟨s, (hemiDataN E N).le ((hemiDataN E N).S_subset_HL hs)⟩ :
      (hemiData E).H) : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) ∈
      (hemiData E).S :=
  mem_S_of_apply_eqN E N s hs _ fun a => hemiHHomN_apply E N _ a

/-- **The filling map `Π_{U_X} = H_τ ⧸ ⟨⟨S_τ⟩⟩ ↠ Π_C = H_x ⧸ ⟨⟨S_x⟩⟩`** (filling in the cusps
`E[N] ∖ {O}` of `U_X = (E ∖ E[N]) / ±1` inside `C = (E ∖ {O}) / ±1`). -/
def hemiFillN : GaloisPi1.pi1 (hemiDataN E N).H (hemiDataN E N).S (hemiDataN E N).isClosed_H →ₜ*
    GaloisPi1.pi1 (hemiData E).H (hemiData E).S (hemiData E).isClosed_H :=
  orbiHom₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N)
    (continuous_hemiHHomN E N) (fun s hs => hemiHEquivN_mem_S E N s hs)

lemma hemiFillN_mk (h : (hemiDataN E N).H) :
    hemiFillN E N (QuotientGroup.mk h : _ ⧸ GaloisPi1.kernel (hemiDataN E N).H (hemiDataN E N).S) =
      (QuotientGroup.mk (hemiHEquivN E N h) : _ ⧸ GaloisPi1.kernel (hemiData E).H (hemiData E).S) :=
  rfl

/-- **`Π_{U_X} ↠ Π_C` is surjective.** -/
theorem hemiFillN_surjective : Function.Surjective (hemiFillN E N) :=
  pi1Hom₃_surjective _ _ (hemiHHomN E N) (continuous_hemiHHomN E N) _
    (fun s hs => hemiHEquivN_mem_S E N s hs) (hemiHHomN_surjective E N)

/-- **Compatibility with `A ≅ ℤ/2`**: `orbiProj ∘ hemiFillN = hemiAEquivN₃ ∘ orbiProj`. -/
theorem orbiProj_hemiFillN (y : GaloisPi1.pi1 (hemiDataN E N).H (hemiDataN E N).S
    (hemiDataN E N).isClosed_H) :
    orbiProj (hemiData E) (hemiFillN E N y) = hemiAEquivN₃ E N (orbiProj (hemiDataN E N) y) :=
  orbiProj_orbiHom₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N)
    (continuous_hemiHHomN E N) (fun s hs => hemiHEquivN_mem_S E N s hs)
    (hemiAEquivN₃ E N).toMonoidHom (fun h => hemiAEquivN₃_mk E N h) y

/-- **Compatibility with the projections to `Gal(K̄ / K)`.** -/
theorem piConstC_hemiFillN (y : GaloisPi1.pi1 (hemiDataN E N).H (hemiDataN E N).S
    (hemiDataN E N).isClosed_H) :
    piConstC (hemiData E) (hemiFillN E N y) = piConstC (hemiDataN E N) y :=
  piConstC_orbiHom₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N)
    (continuous_hemiHHomN E N) (fun s hs => hemiHEquivN_mem_S E N s hs)
    (fun h => AlgEquiv.ext fun c => Subtype.ext (by
    rw [galResConst_apply, galResConst_apply]
    exact hemiHHomN_apply E N h c)) y

/-- **The filling map on étale fundamental groups** `π₁([U / ±1]) ↠ π₁([X / ±1])`, through
`equivPi1`. -/
def hemiFillEtN : etalePi1 (hemiDataN E N).R (hemiDataN E N).A (FFClosure (curveE E)) →ₜ*
    etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)) :=
  ((ContinuousMonoidHom.toContinuousMonoidHom (hemiData E).equivPi1.symm).comp
    (hemiFillN E N)).comp (ContinuousMonoidHom.toContinuousMonoidHom (hemiDataN E N).equivPi1)

theorem hemiFillEtN_surjective : Function.Surjective (hemiFillEtN E N) :=
  (hemiData E).equivPi1.symm.surjective.comp
    ((hemiFillN_surjective E N).comp (hemiDataN E N).equivPi1.surjective)

/-! ### `Π_U = H_{L,τ} ⧸ ⟨⟨S_τ⟩⟩ ↠ Π_X = H_{L,x} ⧸ ⟨⟨S_x⟩⟩` -/

/-- `H_{L,τ} = H_{L,x}` (both `Gal(Ω / K(Ē))`). -/
def hemiHLHomN : (hemiDataN E N).HL →* (hemiData E).HL :=
  MonoidHom.codRestrict ((hemiData E).H.subtype.comp
    ((hemiHHomN E N).comp (Subgroup.inclusion (hemiDataN E N).le)))
    (hemiData E).HL fun n => by
      rw [mem_hemiData_HL_iff]
      intro z
      exact (mem_hemiDataN_HL_iff E N n.1).1 n.2 z

lemma hemiHLHomN_apply (n : (hemiDataN E N).HL) (a : FFClosure (curveE E)) :
    ((hemiHLHomN E N n : (hemiData E).HL) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) a =
      (n : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) a := rfl

lemma continuous_hemiHLHomN : Continuous (hemiHLHomN E N) :=
  continuous_induced_rng.2 (continuous_of_apply_eq₃ (hemiDataN E N).HL.subtype
    continuous_subtype_val ((hemiData E).HL.subtype.comp (hemiHLHomN E N))
    fun n a => hemiHLHomN_apply E N n a)

lemma hemiHLHomN_surjective : Function.Surjective (hemiHLHomN E N) := by
  intro m
  have hm : (((hemiHEquivN E N).symm ⟨m.1, Subgroup.mem_top _⟩ : (hemiDataN E N).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) ∈
      (hemiDataN E N).HL := by
    rw [mem_hemiDataN_HL_iff]
    intro z
    rw [hemiHEquivN_symm_apply]
    exact (mem_hemiData_HL_iff E m.1).1 m.2 z
  refine ⟨⟨_, hm⟩, Subtype.ext (AlgEquiv.ext fun a => ?_)⟩
  rw [hemiHLHomN_apply]
  exact hemiHEquivN_symm_apply E N _ a

/-- **The filling map `Π_U = π₁(E ∖ E[N]) ↠ Π_X = π₁(E ∖ {O})`** (Galois form). -/
def hemiFillLN : GaloisPi1.pi1 (hemiDataN E N).HL (hemiDataN E N).S (hemiDataN E N).isClosed_HL
    →ₜ* GaloisPi1.pi1 (hemiData E).HL (hemiData E).S (hemiData E).isClosed_HL :=
  pi1Hom₃ _ _ (hemiHLHomN E N) (continuous_hemiHLHomN E N) (hemiDataN E N).S_subset_HL
    fun s hs => mem_S_of_apply_eqN E N s hs _ fun a => hemiHLHomN_apply E N _ a

theorem hemiFillLN_surjective : Function.Surjective (hemiFillLN E N) :=
  pi1Hom₃_surjective _ _ (hemiHLHomN E N) (continuous_hemiHLHomN E N) _
    (fun s hs => mem_S_of_apply_eqN E N s hs _ fun a => hemiHLHomN_apply E N _ a)
    (hemiHLHomN_surjective E N)

/-- **Compatibility with the orbifold extensions**: `hemiFillN ∘ ι_U = ι_C ∘ hemiFillLN`. -/
theorem hemiFillN_orbiIncl (y : GaloisPi1.pi1 (hemiDataN E N).HL (hemiDataN E N).S
    (hemiDataN E N).isClosed_HL) :
    hemiFillN E N (orbiIncl (hemiDataN E N) y) = orbiIncl (hemiData E) (hemiFillLN E N y) :=
  orbiIncl_orbiHom₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N)
    (continuous_hemiHHomN E N) (fun s hs => hemiHEquivN_mem_S E N s hs)
    (hemiHLHomN E N) (continuous_hemiHLHomN E N)
    (fun s hs => mem_S_of_apply_eqN E N s hs _ fun a => hemiHLHomN_apply E N _ a)
    (fun n a => (hemiHLHomN_apply E N n a).trans
      (hemiHHomN_apply E N (Subgroup.inclusion (hemiDataN E N).le n) a).symm) y

/-! ### `R ≅ Γ(E ∖ E[N]) ≅ K[E][1/ψ_N]` -/

lemma psiNX_ne_zero₃ : psiNX E N ≠ 0 := fun h =>
  psiN_ne_zero_of_neZero E N ((sectionsXEAlgEquiv E).symm.injective (h.trans (map_zero _).symm))

instance nonempty_VNE₃ : Nonempty (VNE E N) := by
  have h : ((VNE E N : (curveE E).Opens) : Set (curveE E)).Nonempty := by
    by_contra h
    exact psiNX_ne_zero₃ E N ((basicOpen_eq_bot_iff _).1
      ((TopologicalSpace.Opens.not_nonempty_iff_eq_bot _).1 h))
  exact h.to_subtype

instance isFractionRing_VNE₃ : IsFractionRing Γ(curveE E, VNE E N) (curveE E).functionField :=
  functionField_isFractionRing_of_isAffineOpen (curveE E) (VNE E N) (isAffineOpen_VNE E N)

instance isIntegrallyClosed_VNE₃ : IsIntegrallyClosed Γ(curveE E, VNE E N) :=
  isIntegrallyClosed_of_isLocalization Γ(curveE E, VNE E N) (Submonoid.powers (psiNX E N))
    (powers_le_nonZeroDivisors_of_noZeroDivisors (psiNX_ne_zero₃ E N))

/-- The restriction `Γ(E ∖ {O}) → Γ(E ∖ E[N])` is compatible with the germs. -/
lemma germ_VNE_algebraMap₃ (a : Γ(curveE E, XE E)) :
    algebraMap Γ(curveE E, VNE E N) (curveE E).functionField
      (algebraMap Γ(curveE E, XE E) Γ(curveE E, VNE E N) a) =
      algebraMap Γ(curveE E, XE E) (curveE E).functionField a :=
  germToFunctionField_res (homOfLE (VNE_le_XE E N)) a

lemma germ_algebraMap_VNE₃ (c : K) :
    algebraMap Γ(curveE E, VNE E N) (curveE E).functionField (algebraMap K _ c) =
      algebraMap K (curveE E).functionField c :=
  (algebraMap_functionField_eq_germ K (curveE E) (VNE E N) c).symm

omit [NeZero N] in
lemma germ_psiNX_sq₃ :
    algebraMap Γ(curveE E, XE E) (curveE E).functionField (psiNX E N) ^ 2 = psiSqN₃ E N := by
  rw [← map_pow, psiNX, ← map_pow, psiN_sq, AdjoinRoot.algebraMap_eq,
    sectionsXEAlgEquiv_symm_apply, coordToXE_of, germ_polyToXE]
  rfl

/-- `1/ψ_N ∈ Γ(E ∖ E[N])`. -/
abbrev invPsiV₃ : Γ(curveE E, VNE E N) := IsLocalization.Away.invSelf (psiNX E N)

lemma germ_invPsiV₃ :
    algebraMap Γ(curveE E, VNE E N) (curveE E).functionField (invPsiV₃ E N) =
      (algebraMap Γ(curveE E, XE E) (curveE E).functionField (psiNX E N))⁻¹ := by
  refine (eq_inv_of_mul_eq_one_right ?_)
  rw [← germ_VNE_algebraMap₃ E N, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]

lemma germ_invPsiV₃_sq :
    algebraMap Γ(curveE E, VNE E N) (curveE E).functionField (invPsiV₃ E N) ^ 2 =
      (psiSqN₃ E N)⁻¹ := by
  rw [germ_invPsiV₃, inv_pow, germ_psiNX_sq₃]

/-- `τ = x + (1/ψ_N)² ∈ Γ(E ∖ E[N])`. -/
lemma germ_tauV₃ : algebraMap Γ(curveE E, VNE E N) (curveE E).functionField
    (algebraMap Γ(curveE E, XE E) Γ(curveE E, VNE E N) (xX E) + invPsiV₃ E N ^ 2) =
      tauN₃ E N := by
  rw [map_add, map_pow, germ_VNE_algebraMap₃, germ_xX, germ_invPsiV₃_sq]
  rfl

/-- Elements of `K[x]` are integral over `K[τ]`. -/
lemma isIntegral_adjoin_xN_tauN₃ (s : Algebra.adjoin K {xN E}) :
    IsIntegral (Algebra.adjoin K {tauN₃ E N})
      (algebraMap (Algebra.adjoin K {xN E}) (curveE E).functionField s) := by
  have hle : Algebra.adjoin K {xN E} ≤
      (integralClosure (Algebra.adjoin K {tauN₃ E N}) (curveE E).functionField).restrictScalars K :=
    Algebra.adjoin_le (Set.singleton_subset_iff.2 (isIntegral_xN_tauN₃ E N))
  exact hle s.2

/-- **`Γ(E ∖ E[N]) ⊆ K(Ē)` is the integral closure of `K[τ]`.** -/
theorem mem_range_germ_VNE_iff (z : (curveE E).functionField) :
    z ∈ Set.range (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField) ↔
      IsIntegral (Algebra.adjoin K {tauN₃ E N}) z := by
  constructor
  · rintro ⟨s, rfl⟩
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (psiNX E N) s
    have hz := congrArg (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField) ha
    rw [map_mul, map_pow, germ_VNE_algebraMap₃, germ_VNE_algebraMap₃] at hz
    have hg : algebraMap Γ(curveE E, XE E) (curveE E).functionField (psiNX E N) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 (psiNX_ne_zero₃ E N)
    have hs : algebraMap Γ(curveE E, VNE E N) (curveE E).functionField s =
        algebraMap Γ(curveE E, XE E) (curveE E).functionField a *
          algebraMap Γ(curveE E, VNE E N) (curveE E).functionField (invPsiV₃ E N) ^ n := by
      rw [← hz, germ_invPsiV₃, mul_assoc, ← mul_pow, mul_inv_cancel₀ hg, one_pow, mul_one]
    rw [hs]
    have ha' : IsIntegral (Algebra.adjoin K {tauN₃ E N})
        (algebraMap Γ(curveE E, XE E) (curveE E).functionField a) :=
      isIntegral_trans_of_forall₃ (isIntegral_adjoin_xN_tauN₃ E N)
        ((mem_range_germ_XE_iff E _).1 ⟨a, rfl⟩)
    have hτ : IsIntegral (Algebra.adjoin K {tauN₃ E N}) (tauN₃ E N) :=
      isIntegral_algebraMap (x := (⟨tauN₃ E N, Algebra.subset_adjoin rfl⟩ :
        Algebra.adjoin K {tauN₃ E N}))
    have hx : IsIntegral (Algebra.adjoin K {tauN₃ E N}) (xN E) := isIntegral_xN_tauN₃ E N
    have hinv : IsIntegral (Algebra.adjoin K {tauN₃ E N})
        (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField (invPsiV₃ E N)) := by
      refine IsIntegral.of_pow two_pos ?_
      rw [germ_invPsiV₃_sq]
      have he : (psiSqN₃ E N)⁻¹ = tauN₃ E N - xN E := by
        rw [tauN₃]
        ring
      rw [he]
      exact hτ.sub hx
    exact ha'.mul (hinv.pow n)
  · intro hz
    have hle : (Algebra.adjoin K {tauN₃ E N}).toSubring ≤
        (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField).range := by
      intro w hw
      change w ∈ Algebra.adjoin K {tauN₃ E N} at hw
      induction hw using Algebra.adjoin_induction with
      | mem w hw =>
        rw [Set.mem_singleton_iff] at hw
        subst hw
        exact ⟨_, germ_tauV₃ E N⟩
      | algebraMap c => exact ⟨algebraMap K _ c, germ_algebraMap_VNE₃ E N c⟩
      | add w v _ _ hw hv => exact add_mem hw hv
      | mul w v _ _ hw hv => exact mul_mem hw hv
    let e := RingEquiv.ofBijective
      (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField).rangeRestrict
      ⟨fun a b h => IsFractionRing.injective Γ(curveE E, VNE E N) (curveE E).functionField
        (congrArg Subtype.val h), RingHom.rangeRestrict_surjective _⟩
    let g : Algebra.adjoin K {tauN₃ E N} →+* Γ(curveE E, VNE E N) :=
      (e.symm : _ →+* _).comp (Subring.inclusion hle)
    obtain ⟨p, hpm, hp⟩ := hz
    have hint : IsIntegral Γ(curveE E, VNE E N) z := by
      refine ⟨p.map g, hpm.map g, ?_⟩
      rw [eval₂_map]
      have hc : (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField).comp g =
          algebraMap (Algebra.adjoin K {tauN₃ E N}) (curveE E).functionField := by
        refine RingHom.ext fun w => ?_
        have h1 : e (e.symm (Subring.inclusion hle w)) = Subring.inclusion hle w :=
          e.apply_symm_apply _
        exact congrArg Subtype.val h1
      rw [hc]
      exact hp
    exact IsIntegrallyClosed.isIntegral_iff.1 hint

/-- `K(Ē) ≃ L` for the Galois data `hemiDataN E N`. -/
def hemiEquivLN : (curveE E).functionField ≃+* (hemiDataN E N).L :=
  curveEquivL K (transcendental_tauN₃ E N)

lemma hemiEquivLN_apply (z : (curveE E).functionField) :
    ((hemiEquivLN E N z : (hemiDataN E N).L) : FFClosure (curveE E)) =
      algebraMap (curveE E).functionField (FFClosure (curveE E)) z := rfl

lemma hemiEquivLN_algebraMap (c : K) :
    ((hemiEquivLN E N (algebraMap K (curveE E).functionField c) : (hemiDataN E N).L) :
      FFClosure (curveE E)) = algebraMap K (FFClosure (curveE E)) c :=
  curveEquivL_algebraMap K (transcendental_tauN₃ E N) c

lemma hemiEquivLN_tauN₃ :
    ((hemiEquivLN E N (tauN₃ E N) : (hemiDataN E N).L) : FFClosure (curveE E)) =
      coordT (tauN₃ E N) := rfl

/-- **`Γ(E ∖ E[N]) ≅ R`** (the integral closure of `K[τ]` in `L`), as rings. -/
def sectionsVNERingEquiv : Γ(curveE E, VNE E N) ≃+* (hemiDataN E N).R :=
  ringEquivOfRangeEq ((hemiEquivLN E N).toRingHom.comp
      (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField))
    (algebraMap (hemiDataN E N).R (hemiDataN E N).L)
    ((hemiEquivLN E N).injective.comp
      (IsFractionRing.injective Γ(curveE E, VNE E N) (curveE E).functionField))
    (hemiDataN E N).algebraMap_L_injective
    fun y => by
      rw [mem_range_algebraMap_L_iff]
      constructor
      · rintro ⟨a, rfl⟩
        exact (isIntegral_iff_one (hemiDataN E N) (curveE E) (hemiEquivLN E N)
          (hemiEquivLN_algebraMap E N) (hemiEquivLN_tauN₃ E N) _).1
          ((mem_range_germ_VNE_iff E N _).1 ⟨a, rfl⟩)
      · intro h
        have h' : IsIntegral (A₀ K (coordT (tauN₃ E N)))
            ((hemiEquivLN E N ((hemiEquivLN E N).symm y) : (hemiDataN E N).L) :
              FFClosure (curveE E)) := by
          rwa [RingEquiv.apply_symm_apply]
        obtain ⟨a, ha⟩ := (mem_range_germ_VNE_iff E N _).2
          ((isIntegral_iff_one (hemiDataN E N) (curveE E) (hemiEquivLN E N)
            (hemiEquivLN_algebraMap E N) (hemiEquivLN_tauN₃ E N) _).2 h')
        refine ⟨a, ?_⟩
        change hemiEquivLN E N (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField a) = y
        rw [ha, RingEquiv.apply_symm_apply]

lemma algebraMap_sectionsVNERingEquiv (s : Γ(curveE E, VNE E N)) :
    algebraMap (hemiDataN E N).R (FFClosure (curveE E)) (sectionsVNERingEquiv E N s) =
      algebraMap (curveE E).functionField (FFClosure (curveE E))
        (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField s) := by
  unfold sectionsVNERingEquiv
  exact congrArg (fun y : (hemiDataN E N).L => (y : FFClosure (curveE E)))
    (ringEquivOfRangeEq_apply _ (algebraMap (hemiDataN E N).R (hemiDataN E N).L) _ _ _ s)

/-- **`Γ(E ∖ E[N]) ≃ₐ[K] R`**, compatible with the embeddings into `Ω`
(`algebraMap_sectionsVNEHemiAlgEquiv`). -/
def sectionsVNEHemiAlgEquiv : Γ(curveE E, VNE E N) ≃ₐ[K] (hemiDataN E N).R :=
  AlgEquiv.ofRingEquiv (f := sectionsVNERingEquiv E N) fun c => CoordRing.ext (by
    rw [algebraMap_sectionsVNERingEquiv, germ_algebraMap_VNE₃,
      ← IsScalarTower.algebraMap_apply K (curveE E).functionField (FFClosure (curveE E)),
      ← IsScalarTower.algebraMap_apply K (hemiDataN E N).R (FFClosure (curveE E))])

lemma algebraMap_sectionsVNEHemiAlgEquiv (s : Γ(curveE E, VNE E N)) :
    algebraMap (hemiDataN E N).R (FFClosure (curveE E)) (sectionsVNEHemiAlgEquiv E N s) =
      algebraMap (curveE E).functionField (FFClosure (curveE E))
        (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField s) :=
  algebraMap_sectionsVNERingEquiv E N s

/-- The restriction `Γ(E ∖ {O}) → Γ(E ∖ E[N])` is `K`-linear. -/
lemma algebraMap_VNE_algebraMap₃ (c : K) :
    algebraMap Γ(curveE E, XE E) Γ(curveE E, VNE E N) (algebraMap K _ c) =
      algebraMap K Γ(curveE E, VNE E N) c := by
  apply IsFractionRing.injective Γ(curveE E, VNE E N) (curveE E).functionField
  rw [germ_VNE_algebraMap₃, germ_algebraMap_XE, germ_algebraMap_VNE₃]

/-- **`Γ(E ∖ E[N]) ≃ₐ[K] K[E][1/ψ_N]`** (`sectionsVNEEquiv` as a `K`-algebra isomorphism). -/
def sectionsVNEAlgEquiv₃ : Γ(curveE E, VNE E N) ≃ₐ[K] coverRingN E N :=
  AlgEquiv.ofRingEquiv (f := sectionsVNEEquiv E N) fun c => by
    rw [← algebraMap_VNE_algebraMap₃, sectionsVNEEquiv_algebraMap, AlgEquiv.commutes,
      ← IsScalarTower.algebraMap_apply]

/-- **`K[E][1/ψ_N] ≃ₐ[K] R`**: the ring `R` of the Galois data `hemiDataN E N` is the coordinate
ring of `E ∖ E[N]`. -/
def hemiRNEquiv : coverRingN E N ≃ₐ[K] (hemiDataN E N).R :=
  (sectionsVNEAlgEquiv₃ E N).symm.trans (sectionsVNEHemiAlgEquiv E N)

/-- `K(Ē) ≃ K(E)` maps the germ of `s ∈ Γ(E ∖ E[N])` to the image of `s ∈ K[E][1/ψ_N]`. -/
lemma funFieldEquivE_germ_VNE (s : Γ(curveE E, VNE E N)) :
    funFieldEquivE E (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField s) =
      algebraMap (coverRingN E N) E.toAffine.FunctionField (sectionsVNEEquiv E N s) := by
  have h : ((funFieldEquivE E).toRingHom.comp
      (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField)) =
      (algebraMap (coverRingN E N) E.toAffine.FunctionField).comp
        (sectionsVNEEquiv E N).toRingHom := by
    refine IsLocalization.ringHom_ext (Submonoid.powers (psiNX E N)) (RingHom.ext fun a => ?_)
    change funFieldEquivE E (algebraMap Γ(curveE E, VNE E N) (curveE E).functionField
      (algebraMap Γ(curveE E, XE E) Γ(curveE E, VNE E N) a)) =
      algebraMap (coverRingN E N) E.toAffine.FunctionField (sectionsVNEEquiv E N
        (algebraMap Γ(curveE E, XE E) Γ(curveE E, VNE E N) a))
    rw [germ_VNE_algebraMap₃, funFieldEquivE_germ, sectionsVNEEquiv_algebraMap, ιN_algebraMap]
  exact RingHom.congr_fun h s

/-- **Compatibility of `hemiRNEquiv` with the embeddings**
`K[E][1/ψ_N] ⊆ K(E) ≃ K(Ē) ⊆ Ω` and `R ⊆ Ω`. -/
theorem algebraMap_hemiRNEquiv (b : coverRingN E N) :
    algebraMap (hemiDataN E N).R (FFClosure (curveE E)) (hemiRNEquiv E N b) =
      embE E (algebraMap (coverRingN E N) E.toAffine.FunctionField b) := by
  change algebraMap (hemiDataN E N).R (FFClosure (curveE E))
    (sectionsVNEHemiAlgEquiv E N ((sectionsVNEAlgEquiv₃ E N).symm b)) = _
  rw [algebraMap_sectionsVNEHemiAlgEquiv]
  have hb : b = sectionsVNEEquiv E N ((sectionsVNEAlgEquiv₃ E N).symm b) :=
    ((sectionsVNEAlgEquiv₃ E N).apply_symm_apply b).symm
  conv_rhs => rw [hb, ← funFieldEquivE_germ_VNE]
  change _ = algebraMap (curveE E).functionField (FFClosure (curveE E))
    ((funFieldEquivE E).symm (funFieldEquivE E _))
  rw [RingEquiv.symm_apply_apply]

/-- The elements of `H_τ` corresponding to inertia elements of `S_x`, i.e. `S_x` seen in
`Gal(Ω / K(τ))`; `S_x ∖ S_τ` consists of inertia elements at the places over the cusps
`E[N] ∖ {O}` of `U_X` filled in by `C`. -/
def hemiSxN : Set (FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) :=
  {σ | ∃ h : σ ∈ (hemiDataN E N).H, ((hemiHHomN E N ⟨σ, h⟩ : (hemiData E).H) :
    FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) ∈ (hemiData E).S}

lemma S_subset_hemiSxN : (hemiDataN E N).S ⊆ hemiSxN E N :=
  fun s hs => ⟨_, hemiHEquivN_mem_S E N s hs⟩

/-- **The kernel of the filling map `Π_{U_X} ↠ Π_C`** is the closed normal subgroup generated by
the images of the inertia elements `S_x ∖ S_τ` (at the places over `E[N] ∖ {O}`). -/
theorem ker_hemiFillN : (hemiFillN E N).toMonoidHom.ker =
    (Subgroup.normalClosure ((QuotientGroup.mk' (GaloisPi1.kernel (hemiDataN E N).H
      (hemiDataN E N).S) : (hemiDataN E N).H →* GaloisPi1.pi1 (hemiDataN E N).H
        (hemiDataN E N).S (hemiDataN E N).isClosed_H) ''
      (Subtype.val ⁻¹' (hemiSxN E N \ (hemiDataN E N).S) :
        Set (hemiDataN E N).H))).topologicalClosure :=
  ker_pi1Hom₃_eq _ _ (hemiHHomN E N) (continuous_hemiHHomN E N) _
    (fun s hs => hemiHEquivN_mem_S E N s hs)
    (fun _ hs => (hemiData E).le ((hemiData E).S_subset_HL hs))
    (hemiHEquivN E N).symm.toMulEquiv.toMonoidHom (hemiHEquivN E N).symm.continuous_toFun
    (fun x => (hemiHEquivN E N).apply_symm_apply x) (fun x => (hemiHEquivN E N).symm_apply_apply x)

end Hemi

