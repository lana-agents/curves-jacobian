import CurvesJacobian.Cusp.ArithmeticFillObj
import CurvesJacobian.Cusp.NonRationalFill
import CurvesJacobian.Cusp.CuspTerminalFew
import CurvesJacobian.Cusp.CuspDegreeEq
import CurvesJacobian.Cusp.TorsionFree

/-!
# Filling in a cusp as an elementary operation of type `•`

[AbsTopI] Definition 4.2 (iii) (c) (`Topics in Absolute Anabelian Geometry I.txt`,
l.3009–3015): an elementary operation `Π_j ⇝ Π_{j+1}` of type `•` is a surjection whose kernel is
topologically normally generated (in `Δ_j`, `Belyi.Anabelian.ChainObj.deltaNormalClosure`) by a
cuspidal decomposition group `C` in `Δ_j` which lies in a normal open torsion-free subgroup of
`Δ_j`. On the curve side ([AbsTopI] Definition 4.2 (i) (c), l.2901–2906) this is the filling of a
single *rational* point.

For a hyperbolic curve `C` over a number field `K` with a cusp, and `U' = U ∪ {x}` (`x` a
`K`-rational point of `X̄`) such that `(X̄, U')` is still hyperbolic with a cusp,
the filling map `fillMap : Π_U ↠ Π_{U'}` is such an operation from the trivial chain object
`Π₀ = Π_U` to `fillChainObj` (`CurvesJacobian.Cusp.fillElemOp`). The commensurable terminality
of cuspidal inertia groups ([AbsTopI] Lemma 4.1 (i), l.2742–2745;
`CurvesJacobian.Cusp.commensurator_cuspInertia_of_hyperbolic`) identifies the cuspidal inertia
group `I ∈ arithCusps` with its commensurator in `Δ_U`; it is nontrivial since `U_Ω` has at least
two cusps (`U'` has one).

## Main results

* `commensurator_map_inf_range`: for an injective `φ : P →* G` and `J ≤ P` commensurably
  terminal, `Comm_G(φ J) ⊓ φ(P) = φ J`;
* `commensurator_inf_of_mem_arithCusps`: every `I ∈ arithCusps` equals `Comm_Π(I) ⊓ Δ`;
  `arithCusps_ne_bot`: it is nontrivial if `U_Ω` has at least two cusps;
* `conjClosureIn D C`: the closed subgroup generated by the `D`-conjugates of `C`;
  `map_topologicalClosure_normalClosure_eq`: the image of a closed normal closure under a closed
  continuous homomorphism `φ` is `conjClosureIn φ(P) φ(C)`;
* `exists_fillCusp`: for rational `x` the kernel of `Π_U ↠ Π_{U'}` is
  `deltaNormalClosure` of one cuspidal inertia group (via `ker_fillMap_eq_map`);
* `fillElemOp`: the operation `Π_U ⇝ Π_{U'}` of type `•` (`fillElemOp_kind`).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi Belyi.Anabelian
open Pi1.Orbifold AffOrbicurve

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section Group

variable {P G : Type*} [Group P] [Group G]

/-- A subgroup is contained in its commensurator. -/
lemma le_commensurator_self (H : Subgroup G) : H ≤ Subgroup.Commensurable.commensurator H := by
  intro γ hγ
  rw [Subgroup.Commensurable.commensurator_mem_iff, conjAct_smul_eq_map]
  have e : H.map (MulAut.conj γ).toMonoidHom = H := by
    ext x
    simp only [Subgroup.mem_map, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact mul_mem (mul_mem hγ hy) (inv_mem hγ)
    · intro hx
      exact ⟨γ⁻¹ * x * γ, mul_mem (mul_mem (inv_mem hγ) hx) hγ, by group⟩
  rw [e]

/-- **Commensurators along an embedding**: if `φ : P ↪ G` and `J ≤ P` is commensurably terminal
in `P`, then the elements of `φ(P)` commensurating `φ(J)` are exactly `φ(J)`. -/
lemma commensurator_map_inf_range {φ : P →* G} (hφ : Function.Injective φ) {J : Subgroup P}
    (hJ : Subgroup.Commensurable.commensurator J = J) :
    Subgroup.Commensurable.commensurator (J.map φ) ⊓ φ.range = J.map φ := by
  apply le_antisymm
  · rintro x ⟨hx, p, rfl⟩
    change φ p ∈ Subgroup.Commensurable.commensurator (J.map φ) at hx
    rw [Subgroup.Commensurable.commensurator_mem_iff, conjAct_smul_eq_map] at hx
    have e : (J.map φ).map (MulAut.conj (φ p)).toMonoidHom =
        (J.map (MulAut.conj p).toMonoidHom).map φ := by
      rw [Subgroup.map_map, Subgroup.map_map]
      congr 1
      ext q
      simp
    rw [e] at hx
    have hp : p ∈ Subgroup.Commensurable.commensurator J := by
      rw [Subgroup.Commensurable.commensurator_mem_iff, conjAct_smul_eq_map]
      obtain ⟨h1, h2⟩ := hx
      rw [Subgroup.relIndex_map_map_of_injective _ _ hφ] at h1 h2
      exact ⟨h1, h2⟩
    rw [hJ] at hp
    exact Subgroup.mem_map_of_mem φ hp
  · refine le_inf (le_commensurator_self _) ?_
    rintro _ ⟨j, -, rfl⟩
    exact ⟨j, rfl⟩

variable [TopologicalSpace P] [TopologicalSpace G] [IsTopologicalGroup P] [IsTopologicalGroup G]

/-- The closed subgroup generated by the `D`-conjugates of `C` (for a chain object and
`D = Δ_j` this is `Belyi.Anabelian.ChainObj.deltaNormalClosure`). -/
def conjClosureIn (D C : Subgroup G) : Subgroup G :=
  (Subgroup.closure {x | ∃ d ∈ D, ∃ c ∈ C, d * c * d⁻¹ = x}).topologicalClosure

lemma _root_.Belyi.Anabelian.ChainObj.deltaNormalClosure_eq_conjClosureIn
    {E : CuspidalExt.{u}} (A : ChainObj E) (C : Subgroup A.grp) :
    A.deltaNormalClosure C = conjClosureIn A.Delta C := rfl

/-- `conjClosureIn` along a continuous closed homomorphism. -/
lemma map_conjClosureIn (φ : P →* G) (hc : Continuous φ) (hcl : IsClosedMap φ)
    (D C : Subgroup P) :
    (conjClosureIn D C).map φ = conjClosureIn (D.map φ) (C.map φ) := by
  apply SetLike.coe_injective
  rw [Subgroup.coe_map, conjClosureIn, conjClosureIn, Subgroup.topologicalClosure_coe,
    Subgroup.topologicalClosure_coe, ← hcl.closure_image_eq_of_continuous hc, ← Subgroup.coe_map,
    MonoidHom.map_closure]
  congr 3
  ext y
  constructor
  · rintro ⟨_, ⟨d, hd, c, hc, rfl⟩, rfl⟩
    exact ⟨φ d, ⟨d, hd, rfl⟩, φ c, ⟨c, hc, rfl⟩, by simp⟩
  · rintro ⟨_, ⟨d, hd, rfl⟩, _, ⟨c, hc, rfl⟩, rfl⟩
    exact ⟨d * c * d⁻¹, ⟨d, hd, c, hc, rfl⟩, by simp⟩

/-- `conjClosureIn` along an isomorphism of topological groups. -/
lemma map_conjClosureIn_equiv (e : P ≃ₜ* G) (D C : Subgroup P) :
    (conjClosureIn D C).map e.toMulEquiv.toMonoidHom =
      conjClosureIn (D.map e.toMulEquiv.toMonoidHom) (C.map e.toMulEquiv.toMonoidHom) :=
  map_conjClosureIn _ e.continuous e.toHomeomorph.isClosedMap D C

/-- The closed normal closure is `conjClosureIn ⊤`. -/
lemma topologicalClosure_normalClosure_eq_conjClosureIn (C : Subgroup P) :
    (Subgroup.normalClosure (C : Set P)).topologicalClosure = conjClosureIn ⊤ C := by
  rw [conjClosureIn, Subgroup.normalClosure]
  congr 2
  ext y
  rw [Group.mem_conjugatesOfSet_iff]
  simp only [isConj_iff, Set.mem_setOf_eq, Subgroup.mem_top, true_and, SetLike.mem_coe]
  constructor
  · rintro ⟨c, hc, d, rfl⟩
    exact ⟨d, c, hc, rfl⟩
  · rintro ⟨d, c, hc, rfl⟩
    exact ⟨c, hc, d, rfl⟩

/-- The image of a closed normal closure under a continuous closed homomorphism `φ` is the
closed subgroup generated by the `φ(P)`-conjugates of the image. -/
lemma map_topologicalClosure_normalClosure_eq (φ : P →* G) (hc : Continuous φ)
    (hcl : IsClosedMap φ) (C : Subgroup P) :
    (Subgroup.normalClosure (C : Set P)).topologicalClosure.map φ =
      conjClosureIn φ.range (C.map φ) := by
  rw [topologicalClosure_normalClosure_eq_conjClosureIn, map_conjClosureIn φ hc hcl,
    ← MonoidHom.range_eq_map]

end Group

/-- The image of a subgroup in the trivial chain object `Π₀ = Π` is the subgroup itself. -/
lemma ChainObj.image_base {E : CuspidalExt.{u}} (I : Subgroup E.Pi) :
    (ChainObj.base E).image I = I := by
  ext x
  constructor
  · rintro ⟨⟨y, _⟩, hy, rfl⟩
    exact hy
  · intro hx
    exact ⟨⟨x, trivial⟩, hx, rfl⟩

section Arith

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty)

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- `π₁ᵉᵗ(U_Ω) → Π_U` is injective. -/
lemma geomToPi_injective : Function.Injective (geomToPi Ω C hc) := fun _ _ hab ↦
  (basePointEquiv Ω C hc).injective
    ((kerProjGkEquivGeom Ω C hc).symm.injective (Subtype.ext hab))

/-- The image of `π₁ᵉᵗ(U_Ω) → Π_U` is `Δ_U`. -/
lemma range_geomToPi : (geomToPi Ω C hc).range = (projGk Ω C hc).toMonoidHom.ker := by
  ext x
  constructor
  · rintro ⟨γ, rfl⟩
    exact geomToPi_mem_ker Ω C hc γ
  · intro hx
    refine ⟨(basePointEquiv Ω C hc).symm (kerProjGkEquivGeom Ω C hc ⟨x, hx⟩), ?_⟩
    change ((kerProjGkEquivGeom Ω C hc).symm (basePointEquiv Ω C hc
      ((basePointEquiv Ω C hc).symm (kerProjGkEquivGeom Ω C hc ⟨x, hx⟩))) :
        π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) = x
    rw [ContinuousMulEquiv.apply_symm_apply, ContinuousMulEquiv.symm_apply_apply]

/-- The conjugate `g · geomToPi(-) · g⁻¹` of `π₁ᵉᵗ(U_Ω) → Π_U` also has image `Δ_U`. -/
lemma range_conj_geomToPi (g : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) :
    ((MulAut.conj g).toMonoidHom.comp (geomToPi Ω C hc)).range =
      (projGk Ω C hc).toMonoidHom.ker := by
  ext x
  constructor
  · rintro ⟨γ, rfl⟩
    exact (MonoidHom.normal_ker _).conj_mem _ (geomToPi_mem_ker Ω C hc γ) g
  · intro hx
    have hy : g⁻¹ * x * g ∈ (projGk Ω C hc).toMonoidHom.ker := by
      simpa using (MonoidHom.normal_ker _).conj_mem _ hx g⁻¹
    rw [← range_geomToPi Ω C hc] at hy
    obtain ⟨γ, hγ⟩ := hy
    refine ⟨γ, ?_⟩
    change g * geomToPi Ω C hc γ * g⁻¹ = x
    rw [hγ]
    group

omit [Algebra.IsAlgebraic K Ω] in
/-- **The cuspidal inertia groups of `π₁ᵉᵗ(U_Ω)` are commensurably terminal** ([AbsTopI]
Lemma 4.1 (i)): `U_Ω` is hyperbolic, so it has at least three cusps or genus at least one. -/
lemma geomCusps_commensurator {I₀} (hI₀ : I₀ ∈ geomCusps Ω C) :
    Subgroup.Commensurable.commensurator I₀ = I₀ := by
  obtain ⟨W, hkW, hWU, rfl⟩ := hI₀
  have hfin := compl_finite_baseChangeOpen K Ω C.nonempty
  have hhyp : 2 < 2 * (curveGenus Ω (geomCurve Ω C)).toNat +
      Nat.card ((geomOpen Ω C : Set (geomCurve Ω C))ᶜ : Set (geomCurve Ω C)) :=
    isHyperbolic_baseChange Ω C
  refine commensurator_cuspInertia_of_hyperbolic (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C)) (curveGaloisData_H_le Ω _)
    (curveEquivL_algebraMap Ω _) (curveEquivL_τ Ω _) hfin ?_ hkW hWU
  by_cases h3 : 2 < Nat.card ((geomOpen Ω C : Set (geomCurve Ω C))ᶜ : Set (geomCurve Ω C))
  · exact Or.inl h3
  · exact Or.inr (by omega)

omit [NumberField K] [Algebra.IsAlgebraic K Ω] in
/-- The cuspidal inertia groups of `π₁ᵉᵗ(U_Ω)` are nontrivial if `U_Ω` has at least two cusps. -/
lemma geomCusps_ne_bot
    (h2 : 1 < Nat.card ((geomOpen Ω C : Set (geomCurve Ω C))ᶜ : Set (geomCurve Ω C)))
    {I₀} (hI₀ : I₀ ∈ geomCusps Ω C) : I₀ ≠ ⊥ := by
  obtain ⟨W, hkW, hWU, rfl⟩ := hI₀
  exact cuspInertia_ne_bot (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C)) (curveGaloisData_H_le Ω _)
    (curveEquivL_algebraMap Ω _) (curveEquivL_τ Ω _)
    (compl_finite_baseChangeOpen K Ω C.nonempty) h2 hkW hWU

/-- **The cuspidal inertia groups of `Π_U` are nontrivial** if `U_Ω` has at least two cusps. -/
theorem arithCusps_ne_bot
    (h2 : 1 < Nat.card ((geomOpen Ω C : Set (geomCurve Ω C))ᶜ : Set (geomCurve Ω C)))
    {I} (hI : I ∈ arithCusps Ω C hc) : I ≠ ⊥ := by
  obtain ⟨I₀, hI₀, g, rfl⟩ := hI
  have hψ : Function.Injective ((MulAut.conj g).toMonoidHom.comp (geomToPi Ω C hc)) :=
    (MulAut.conj g).injective.comp (geomToPi_injective Ω C hc)
  rw [Subgroup.map_map, Ne, Subgroup.map_eq_bot_iff_of_injective _ hψ]
  exact geomCusps_ne_bot Ω C h2 hI₀

/-- **A cuspidal inertia group of `Π_U` is its own commensurator in `Δ_U`** ([AbsTopI]
Lemma 4.1 (i)). -/
theorem commensurator_inf_of_mem_arithCusps {I} (hI : I ∈ arithCusps Ω C hc) :
    Subgroup.Commensurable.commensurator I ⊓ (projGk Ω C hc).toMonoidHom.ker = I := by
  obtain ⟨I₀, hI₀, g, rfl⟩ := hI
  have hψ : Function.Injective ((MulAut.conj g).toMonoidHom.comp (geomToPi Ω C hc)) :=
    (MulAut.conj g).injective.comp (geomToPi_injective Ω C hc)
  rw [Subgroup.map_map, ← range_conj_geomToPi Ω C hc g]
  exact commensurator_map_inf_range hψ (geomCusps_commensurator Ω C hI₀)

variable {U' : C.Xbar.Opens} (h : C.U ≤ U') (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)
  (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
    2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U')
  {x : C.Xbar} (hxU' : x ∈ U') (hxU : x ∉ C.U) (hx : (U' : Set C.Xbar) \ C.U ⊆ {x})
  (hxr : IsIso ((C.Xbar ↘ Spec (.of K)).residueFieldMap x))

omit [NumberField K] [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
include h hc' hxU' hxU in
/-- If `U ⊊ U'` and `U'` has a cusp, then `U_Ω` has at least two geometric cusps. -/
lemma one_lt_card_geomOpen_compl :
    1 < Nat.card ((geomOpen Ω C : Set (geomCurve Ω C))ᶜ : Set (geomCurve Ω C)) := by
  have hfin := compl_finite_baseChangeOpen K Ω C.nonempty
  obtain ⟨z, hz⟩ := compl_nonempty_baseChangeOpen (k := K) (Ω := Ω) hc'
  obtain ⟨y, hy⟩ := Scheme.Pullback.exists_preimage_pullback (f := C.Xbar ↘ Spec (.of K))
    (g := specAlgebraMap K Ω) x (Classical.arbitrary _) (Subsingleton.elim _ _)
  have hyU' : y ∈ baseChangeOpen K Ω U' := by
    change (pullback.fst (C.Xbar ↘ Spec (.of K)) (specAlgebraMap K Ω)) y ∈ U'
    rw [hy.1]
    exact hxU'
  have hyU : y ∉ geomOpen Ω C := by
    change (pullback.fst (C.Xbar ↘ Spec (.of K)) (specAlgebraMap K Ω)) y ∉ C.U
    rw [hy.1]
    exact hxU
  have hzU : z ∉ geomOpen Ω C := fun hz' ↦ hz (baseChangeOpen_mono K Ω h hz')
  rw [Nat.card_coe_set_eq, Set.one_lt_ncard_iff hfin]
  exact ⟨y, z, hyU, hzU, fun hyz ↦ hz (hyz ▸ hyU')⟩

/-- `π₁ᵉᵗ(U_Ω) → Π_U` is a closed map (a homeomorphism onto the closed subgroup `Δ_U`). -/
lemma isClosedMap_geomToPi : IsClosedMap (geomToPi Ω C hc) := by
  have hcl : IsClosed (SetLike.coe (projGk Ω C hc).toMonoidHom.ker) := by
    have e : SetLike.coe (projGk Ω C hc).toMonoidHom.ker = (projGk Ω C hc) ⁻¹' {1} := rfl
    rw [e]
    exact isClosed_singleton.preimage (projGk Ω C hc).continuous
  have h1 : IsClosedMap (Subtype.val : (projGk Ω C hc).toMonoidHom.ker → _) :=
    hcl.isClosedEmbedding_subtypeVal.isClosedMap
  exact h1.comp ((kerProjGkEquivGeom Ω C hc).symm.toHomeomorph.isClosedMap.comp
    (basePointEquiv Ω C hc).toHomeomorph.isClosedMap)

include hc' hxU' hxU hx hxr in
/-- **Filling in a rational cusp** ([AbsTopI] Definition 4.2 (i) (c), (iii) (c)): for
`U' = U ∪ {x}` with `x` a `K`-rational point, the kernel of `Π_U ↠ Π_{U'}` is topologically
normally generated *in `Δ_U`* by a single cuspidal inertia group (the images in `Δ_U ≅ π₁(U_Ω)`
of the inertia groups of the unique geometric point over `x`). -/
lemma exists_fillCusp : ∃ I ∈ arithCusps Ω C hc, (fillMap Ω C hc h).toMonoidHom.ker =
    (ChainObj.base (arithmeticExt Ω C hc)).deltaNormalClosure I := by
  haveI : Nonempty (baseChangeOpen K Ω U') :=
    (nonempty_baseChangeOpen K Ω (C.nonempty.mono h)).to_subtype
  obtain ⟨y, hy⟩ := Scheme.Pullback.exists_preimage_pullback (f := C.Xbar ↘ Spec (.of K))
    (g := specAlgebraMap K Ω) x (Classical.arbitrary _) (Subsingleton.elim _ _)
  have hyU' : y ∈ baseChangeOpen K Ω U' := by
    change (pullback.fst (C.Xbar ↘ Spec (.of K)) (specAlgebraMap K Ω)) y ∈ U'
    rw [hy.1]
    exact hxU'
  have hyU : y ∉ geomOpen Ω C := by
    change (pullback.fst (C.Xbar ↘ Spec (.of K)) (specAlgebraMap K Ω)) y ∉ C.U
    rw [hy.1]
    exact hxU
  obtain ⟨W₀, -, hW₀V, hW₀U⟩ := exists_isCentredOn_not_isCentredOn (geomData Ω C)
    (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C))
    (compl_finite_baseChangeOpen K Ω C.nonempty) hyU' hyU
  refine ⟨_, mem_arithCusps Ω C hc hW₀V.1 hW₀U, ?_⟩
  rw [ker_fillMap_eq_map Ω C hc h hc' (subsingleton_baseChangeOpen_diff K Ω hx) hW₀V hW₀U,
    map_topologicalClosure_normalClosure_eq _ (continuous_geomToPi Ω C hc)
      (isClosedMap_geomToPi Ω C hc), range_geomToPi]
  rfl

/-- **The cusp filled in by `U ⊆ U' = U ∪ {x}`** (`x` rational): a cuspidal inertia group
`C ∈ arithCusps` topologically normally generating `ker(Π_U ↠ Π_{U'})` in `Δ_U`. -/
def fillCusp : Subgroup (arithmeticExt Ω C hc).Pi :=
  (exists_fillCusp Ω C hc h hc' hxU' hxU hx hxr).choose

lemma fillCusp_mem : fillCusp Ω C hc h hc' hxU' hxU hx hxr ∈ arithCusps Ω C hc :=
  (exists_fillCusp Ω C hc h hc' hxU' hxU hx hxr).choose_spec.1

lemma ker_fillMap_eq_fillCusp : (fillMap Ω C hc h).toMonoidHom.ker =
    (ChainObj.base (arithmeticExt Ω C hc)).deltaNormalClosure
      (fillCusp Ω C hc h hc' hxU' hxU hx hxr) :=
  (exists_fillCusp Ω C hc h hc' hxU' hxU hx hxr).choose_spec.2

/-- `fillCusp` is a cuspidal decomposition group in `Δ_U` ([AbsTopI] Definition 4.2 (iii),
(3Π)). -/
lemma isCuspidal_fillCusp :
    (ChainObj.base (arithmeticExt Ω C hc)).IsCuspidal
      (fillCusp Ω C hc h hc' hxU' hxU hx hxr) := by
  refine ⟨fillCusp Ω C hc h hc' hxU' hxU hx hxr, fillCusp_mem Ω C hc h hc' hxU' hxU hx hxr, ?_, ?_⟩
  · rw [ChainObj.image_base]
    exact arithCusps_ne_bot Ω C hc (one_lt_card_geomOpen_compl Ω C h hc' hxU' hxU)
      (fillCusp_mem Ω C hc h hc' hxU' hxU hx hxr)
  · rw [ChainObj.image_base]
    exact (commensurator_inf_of_mem_arithCusps Ω C hc
      (fillCusp_mem Ω C hc h hc' hxU' hxU hx hxr)).symm

/-- `fillCusp` lies in a normal open torsion-free subgroup of `Δ_U`. -/
lemma inTorsionFreeNormalOpen_fillCusp :
    (ChainObj.base (arithmeticExt Ω C hc)).InTorsionFreeNormalOpen
      (fillCusp Ω C hc h hc' hxU' hxU hx hxr) :=
  arithmeticExt_inTorsionFreeNormalOpen Ω C hc
    (arithCusps_le Ω C hc (fillCusp_mem Ω C hc h hc' hxU' hxU hx hxr))

/-- **Filling in a cusp is an elementary operation of type `•`** ([AbsTopI] Definition 4.2 (iii)
(c)): for `U' = U ∪ {x}` (`x` a closed point of `X̄`) with `(X̄, U')` hyperbolic with a cusp,
`fillMap : Π_U ↠ Π_{U'}` with the cuspidal decomposition group `fillCusp`. -/
def fillElemOp :
    ElemOp (ChainObj.base (arithmeticExt Ω C hc)) (fillChainObj Ω C hc h hc' hyp) :=
  .decusp (fillMap Ω C hc h) (fillMap_surjective Ω C hc h hc')
    (fillCusp Ω C hc h hc' hxU' hxU hx hxr) (isCuspidal_fillCusp Ω C hc h hc' hxU' hxU hx hxr)
    (inTorsionFreeNormalOpen_fillCusp Ω C hc h hc' hxU' hxU hx hxr)
    (ker_fillMap_eq_fillCusp Ω C hc h hc' hxU' hxU hx hxr) (fillMap_compat Ω C hc h hc' hyp)

lemma fillElemOp_kind : (fillElemOp Ω C hc h hc' hyp hxU' hxU hx hxr).kind = .decusp := rfl

end Arith

end CurvesJacobian.Cusp
