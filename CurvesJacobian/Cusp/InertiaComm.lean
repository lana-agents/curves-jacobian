import CurvesJacobian.Cusp.LineBranch

/-!
# Inertia groups are abelian

Let `k` have characteristic `0`, `u ∈ Ω` be transcendental over `k`, `Ω / k(u)` Galois, and `W` a
valuation subring of `Ω` with `k ⊆ W` and `u` in its maximal ideal. Any two elements of the
inertia group of `W` commute (`CurvesJacobian.Cusp.inertia_commute`): on every finite Galois
subextension `N` their restrictions lie in the inertia group of the centre of `W` on the
normalization of `k[u]` in `N`, which is cyclic (pi1's `AffOrbicurve.isCyclic_inertia_coordRing`,
tame ramification), and `Ω` is the union of such `N`.

Consequently the inertia group of a place over a cusp of `ℙ¹ ∖ {0, 1, ∞}` in `π₁ᵉᵗ`
(`CurvesJacobian.Cusp.lineInertia`) is abelian (`CurvesJacobian.Cusp.lineInertia_comm`).
-/

open AffOrbicurve IntermediateField Polynomial CategoryTheory AlgebraicGeometry
open IntermediateField.algebraAdjoinAdjoin

universe u

namespace CurvesJacobian.Cusp

variable {k Ω : Type u} [Field k] [CharZero k] [Field Ω] [Algebra k Ω]

set_option synthInstance.maxHeartbeats 400000 in
-- instances on `coordRing k u N` and its Galois group are slow to synthesize
/-- **Inertia elements commute.** -/
theorem inertia_commute {u : Ω} [IsGalois (K₀ k u) Ω] (hu : Transcendental k u)
    {W : ValuationSubring Ω} (hW : IsCentered k u W) (hWu : W.valuation u < 1)
    {σ τ : Ω ≃ₐ[K₀ k u] Ω} (hσ : σ ∈ GaloisPi1.inertia W) (hτ : τ ∈ GaloisPi1.inertia W) :
    σ * τ = τ * σ := by
  ext z
  let E := IntermediateField.adjoin (K₀ k u) {z}
  haveI : FiniteDimensional (K₀ k u) E :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral z)
  let N := normalClosure (K₀ k u) E Ω
  haveI : FiniteDimensional (K₀ k u) N := normalClosure.is_finiteDimensional _ _ _
  haveI : IsGalois (K₀ k u) N := IsGalois.normalClosure _ _ _
  have hzN : z ∈ N := IntermediateField.le_normalClosure E (mem_adjoin_simple_self _ z)
  haveI := isSeparable_of_charZero N
  let cX := coordRingMap hu N X
  have hcX : toΩ u N cX = u := by rw [toΩ_apply, coordRingMap_apply, aeval_X]
  have hu0 : u ≠ 0 := fun h ↦ hu (h ▸ isAlgebraic_zero)
  have hne : centerIdeal hW N ≠ ⊥ := by
    intro h
    have hmem : cX ∈ centerIdeal hW N := (mem_centerIdeal hW).2 (by rw [hcX]; exact hWu)
    rw [h, Ideal.mem_bot] at hmem
    exact hu0 (by rw [← hcX, hmem, map_zero])
  haveI := isMaximal_centerIdeal hu hW N hne
  have hcyc := isCyclic_inertia_coordRing u N hu (centerIdeal hW N) hne
  letI := hcyc.commGroup
  have hc := mul_comm (⟨_, restrictNormal_mem_inertia hW N hσ⟩ :
      (centerIdeal hW N).inertia (N ≃ₐ[K₀ k u] N))
    ⟨_, restrictNormal_mem_inertia hW N hτ⟩
  have := congrArg (fun ρ : (centerIdeal hW N).inertia (N ≃ₐ[K₀ k u] N) ↦
    (((ρ : N ≃ₐ[K₀ k u] N) ⟨z, hzN⟩ : N) : Ω)) hc
  simp only [Subgroup.coe_mul, AlgEquiv.mul_apply, coe_restrictNormal_apply] at this
  exact this

/-- **Inertia elements over a cusp of `ℙ¹ ∖ {0, 1, ∞}` commute.** -/
theorem inertia_commute_of_cusp {t : Ω} [IsGalois (K₀ k t) Ω] (ht : Transcendental k t)
    (j : Fin 3) {W : ValuationSubring Ω} (hWk : ∀ c : k, algebraMap k Ω c ∈ W)
    (hWj : W.valuation (cuspCoord j t) < 1) {σ τ : Ω ≃ₐ[K₀ k t] Ω}
    (hσ : σ ∈ GaloisPi1.inertia W) (hτ : τ ∈ GaloisPi1.inertia W) : σ * τ = τ * σ := by
  have hu : Transcendental k (cuspCoord j t) := transcendental_cuspCoord ht j
  have hK : K₀ k (cuspCoord j t) = K₀ k t := K₀_cuspCoord ht j
  haveI : IsGalois (K₀ k (cuspCoord j t)) Ω := hK ▸ inferInstance
  have hW : IsCentered k (cuspCoord j t) W := ⟨hWk, (W.valuation_le_one_iff _).1 hWj.le⟩
  have h := inertia_commute hu hW hWj (σ := algEquivOfK₀Eq hK.symm σ)
    (τ := algEquivOfK₀Eq hK.symm τ) hσ hτ
  ext z
  have := congrArg (fun ρ : Ω ≃ₐ[K₀ k (cuspCoord j t)] Ω ↦ ρ z) h
  simpa [AlgEquiv.mul_apply] using this

variable [IsSepClosed Ω] {t : Ω} [IsGalois (K₀ k t) Ω]

/-- **The inertia group of a place over a cusp is abelian.** -/
theorem lineInertia_comm (ht : Transcendental k t) (j : Fin 3) {W : ValuationSubring Ω}
    (hWk : ∀ c : k, algebraMap k Ω c ∈ W) (hWj : W.valuation (cuspCoord j t) < 1) :
    ∀ a ∈ lineInertia ht W, ∀ b ∈ lineInertia ht W, a * b = b * a := by
  let S := lineGalois ht '' GaloisPi1.inertia (P := K₀ k t) W
  have hS : ∀ a ∈ S, ∀ b ∈ S, a * b = b * a := by
    rintro _ ⟨σ, hσ, rfl⟩ _ ⟨τ, hτ, rfl⟩
    rw [← map_mul, ← map_mul, inertia_commute_of_cusp ht j hWk hWj hσ hτ]
  -- the subgroup generated by `S` is abelian
  have h1 : Subgroup.closure S ≤ Subgroup.centralizer S :=
    (Subgroup.closure_le _).2 fun a ha b hb ↦ hS b hb a ha
  have h2 : Subgroup.closure S ≤ Subgroup.centralizer (Subgroup.closure S : Set _) :=
    (Subgroup.closure_le _).2 fun a ha b hb ↦ (h1 hb a ha).symm
  let G := (Subgroup.closure S).commGroupTopologicalClosure fun x y ↦
    Subtype.ext (h2 y.2 x x.2)
  intro a ha b hb
  exact congrArg Subtype.val (@mul_comm (lineInertia ht W) G.toCommMagma ⟨a, ha⟩ ⟨b, hb⟩)

end CurvesJacobian.Cusp
