import Pi1.Surface.FiniteLifts

/-!
# `Π_V` of a Belyi-type chain has an infinite cusp image (MR8, round 28, N5)

For a Belyi-type chain `c` (type-chain `⋏, ⋎, •^l, ⋏, •^r, ⋎`) of the arithmetic cuspidal
extension `Π_X ↠ G_K` of an affine hyperbolic curve over a number field, with a terminal
isomorphism to the trivial chain, the hypothesis `hV : (c.objN (l + r + 3) _).HasInfCusp` of
`PiChain.IsBelyiType.nonempty_geomModel`, `exists_candidate_fill(_toG)` and `exists_cover_fill`
is derived (`PiChain.IsBelyiType.hasInfCusp_V₃`) from the rel-isom-DGC over number fields and
**one remaining input**, the model independence of cusps (`ModelCuspIndep₂`: two geometric models
of the same chain object have the same cuspidal inertia groups up to commensurability). Without
that input, `PiChain.IsBelyiType.hasInfCusp_V₂` derives `hV` from `CuspSurj₂` of the source of
the last `•` (every cusp of every geometric model comes from a cusp of `Π_X`).

## The argument

Let `φ : A ↠ B` be the last operation `•` (`B = Π_V` if `r ≥ 1`; if `r = 0`, `l ≥ 1`, then
`Π_V ↪ B` is the following `⋏`; if `l = r = 0`, `Π_V` is linked to `Π₀ ≅ Π_X` by `⋏`, `⋎`, `⋏`
and the cusps of `Π_X` are infinite, `not_commensurable_bot_of_mem_arithCusps₂`). Take a model
`(Y, ι)` of `A` with `ker φ ⊆ ι(Π_Y)` (a full model, `GeomModel.exists_full`, if `r ≥ 1`; one with
`ι(Π_Y) ⊆ φ⁻¹(Π_V)` if `r = 0`, `GeomModel.exists_range_le₂`). Suppose no cusp of `Π_X` has
infinite image in `B`. If every cusp of `Y` comes from a cusp of `Π_X` (`ModelCS₂`), then `φ ∘ ι`
kills every cuspidal inertia group of `Π_Y` (`GeomModel.le_dcN_of_not_hasInfCusp₂`: their images
are finite, and `Δ_X` is torsion-free), so `ι⁻¹(ker φ)` is the closed normal subgroup generated by
**all** cuspidal inertia groups (`GeomModel.ker_le_map_closure₂`, `GeomModel.false_of_le_dcN₂`),
i.e. the kernel of `π₁ᵉᵗ(U_Ω) ↠ π₁ᵉᵗ(X̄_{Y,Ω})` (`comap_allCuspsClosure₂`, from the filling
formula `ker_fundamentalGroupMap_homOfLE_eq_cuspInertia` with `V = X̄`, cf. [AbsTopI] Lemma 4.1 (v),
`Topics in Absolute Anabelian Geometry I.txt` l.2753–2771). Hence `Δ_Y / ι⁻¹(ker φ)` is the
geometric fundamental group of the **proper** curve `X̄_Y`, `≅ Π̂_{g,0}`
(`etaleFundamentalGroup_equiv_profiniteSurfaceGroup_zero_of_isAlgClosed`), and via
`Π_V ↪ Π_n ≅ Π_X` (`PiChain.belyiEmb`, over `G_K` up to conjugation) it is isomorphic to an open
subgroup of the free profinite group `Δ_X ≅ Π̂_{g₀,r₀}`, `r₀ ≥ 1`. Open subgroups of free profinite
groups have finite lifts (pi1's `HasFiniteLifts.of_isOpen_of_continuousMulEquiv`), `Π̂_{g,0}` with
`g ≥ 1` does not (`not_hasFiniteLifts_completion_ulift₂`, the `D₄`-obstruction of pi1's
`Pi1.SurfaceGroup.not_hasFiniteLifts` in any universe), and `Π̂_{0,0} = 1` would make `Δ_X`
finite: `false_of_ker_eq_allCuspsClosure₂`.

## Cusp bookkeeping

`ModelCS₂` holds for the base model (`modelCS_base₂`) and is preserved by `GeomModel.map`,
`GeomModel.comap` and `GeomModel.decusp` (`modelCS_map₂`, `modelCS_comap₂`, `modelCS_decusp₂`);
the constructions `GeomModel.ofSub` and `GeomModel.exists_enlarge` are existential, so their
models are compared with the old ones through `CuspCompat₂` (`modelCS_of_cuspCompat₂`). Given
`ModelCuspIndep₂`, every object of a chain without `⊚` up to an object all of whose predecessors
have an infinite cusp image satisfies `CuspSurj₂` (`PiChain.cuspSurj_le₂`).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi
  Belyi.Anabelian Pi1.Profinite PreGaloisCategory ProfiniteGrp ProfiniteGrp.ProfiniteCompletion
open Pi1.Orbifold AffOrbicurve

universe u v

noncomputable section

namespace CurvesJacobian.Cusp

/-! ### `Π̂_{g,0}`, `g ≥ 1`, does not have finite lifts (universe-polymorphic form) -/

section FiniteLifts

open Pi1 Pi1.SurfaceGen Pi1.SurfaceGroup

/-- **The `D₄`-obstruction** (as in pi1's `Pi1.SurfaceGroup.not_hasFiniteLifts`): a group with
elements `aᵢ, bᵢ` satisfying
`∏ᵢ [aᵢ, bᵢ] = 1` and a continuous `φ : P → D₂` with `a₁ ↦ r`, `b₁ ↦ s`, `aᵢ, bᵢ ↦ 1` (`i ≥ 2`)
does not have finite lifts. -/
theorem not_hasFiniteLifts_of_klein₂ {P : Type*} [Group P] [TopologicalSpace P] {g : ℕ}
    (hg : 0 < g) (a b : Fin g → P) (hrel : commProd a b = 1) (φ : P →* DihedralGroup 2)
    (hφ : ∀ d, IsOpen (φ ⁻¹' {d})) (ha : ∀ i, φ (a i) = kleinA hg i)
    (hb : ∀ i, φ (b i) = kleinB hg i) : ¬ HasFiniteLifts.{0} P := by
  intro h
  obtain ⟨ψ, -, hψ⟩ := h (DihedralGroup 4) (DihedralGroup 2) dihedralRed dihedralRed_surjective
    φ hφ
  have hred : ∀ x, dihedralRed (ψ x) = φ x := fun x ↦ DFunLike.congr_fun hψ x
  have hrel' := congrArg ψ hrel
  rw [map_one, map_commProd, commProd, prod_ofFn_eq_of_eq_one _ ⟨0, hg⟩] at hrel'
  · rw [commutator_eq_of_dihedralRed _ _ (by rw [hred, ha]; simp [kleinA])
      (by rw [hred, hb]; simp [kleinB])] at hrel'
    exact absurd hrel' (by decide)
  · intro i hi
    exact commutator_eq_one_of_dihedralRed_eq_one _ _ (by rw [hred, ha]; simp [kleinA, hi])

/-- **`Π̂_{g,0}` (in any universe) does not have finite lifts for `g ≥ 1`.** -/
theorem not_hasFiniteLifts_completion_ulift₂ {g : ℕ} (hg : 0 < g) :
    ¬ HasFiniteLifts.{0} (completion (GrpCat.of (ULift.{v} (SurfaceGroup g 0)))) := by
  let up : SurfaceGroup g 0 →* ULift.{v} (SurfaceGroup g 0) := MulEquiv.ulift.symm.toMonoidHom
  let E : SurfaceGroup g 0 →* completion (GrpCat.of (ULift.{v} (SurfaceGroup g 0))) :=
    (eta (GrpCat.of (ULift.{v} (SurfaceGroup g 0)))).hom.comp up
  let f : ULift.{v} (SurfaceGroup g 0) →* ULift.{v} (DihedralGroup 2) :=
    (MulEquiv.ulift.symm.toMonoidHom.comp (kleinHom hg)).comp MulEquiv.ulift.toMonoidHom
  let φ : completion (GrpCat.of (ULift.{v} (SurfaceGroup g 0))) →* DihedralGroup 2 :=
    MulEquiv.ulift.toMonoidHom.comp (liftFinite f)
  have hφE : ∀ x, φ (E x) = kleinHom hg x := fun x ↦ by
    change MulEquiv.ulift (liftFinite f (etaFn _ (up x))) = _
    rw [liftFinite_eta]
    rfl
  have hrel : commProd (fun i ↦ E (genA i)) (fun i ↦ E (genB i)) = 1 := by
    have h := congrArg E (relation (g := g) (r := 0))
    rw [map_mul, map_one, map_commProd, map_ordProd, ordProd, List.ofFn_zero, List.prod_nil,
      mul_one] at h
    exact h
  refine not_hasFiniteLifts_of_klein₂ hg _ _ hrel φ (fun d ↦ ?_) (fun i ↦ ?_) (fun i ↦ ?_)
  · have e : φ ⁻¹' {d} = {x | liftFinite f x = ULift.up d} := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq]
      constructor
      · intro hx
        exact ULift.ext _ _ hx
      · intro hx
        exact congrArg ULift.down hx
    rw [e]
    exact isOpen_liftFinite_fiber f _
  · rw [hφE]
    exact lift_genA _ _ _ _ i
  · rw [hφE]
    exact lift_genB _ _ _ _ i

/-- **`Π̂_{0,0}` is trivial.** -/
theorem eq_one_completion_ulift_zero₂
    (x : completion (GrpCat.of (ULift.{v} (SurfaceGroup 0 0)))) : x = 1 := by
  have h1 : ∀ y : ULift.{v} (SurfaceGroup 0 0), y = 1 := fun y ↦ by
    have hid : MonoidHom.id (SurfaceGroup 0 0) = 1 :=
      hom_ext (fun i ↦ i.elim0) (fun i ↦ i.elim0) (fun j ↦ j.elim0)
    exact ULift.ext _ _ (DFunLike.congr_fun hid y.down)
  have hr : Set.range (etaFn (GrpCat.of (ULift.{v} (SurfaceGroup 0 0)))) = {1} := by
    ext z
    constructor
    · rintro ⟨y, rfl⟩
      rw [h1 y]
      exact map_one (eta (GrpCat.of (ULift.{v} (SurfaceGroup 0 0)))).hom
    · intro hz
      rw [Set.mem_singleton_iff] at hz
      exact ⟨1, hz ▸ map_one (eta (GrpCat.of (ULift.{v} (SurfaceGroup 0 0)))).hom⟩
  have hd := denseRange (GrpCat.of (ULift.{v} (SurfaceGroup 0 0)))
  rw [DenseRange, hr] at hd
  have := hd.closure_eq
  rw [isClosed_singleton.closure_eq] at this
  have hx : x ∈ (Set.univ : Set (completion (GrpCat.of (ULift.{v} (SurfaceGroup 0 0))))) :=
    Set.mem_univ x
  rw [← this] at hx
  exact hx

end FiniteLifts

/-! ### An open subgroup of a free profinite group is not a proper surface group -/

section Abstract

open Pi1 Pi1.SurfaceGroup

/-- **No open subgroup of a free profinite group is a quotient `G ↠ Π̂_{g,0}` in the following
sense**: if `κ : G → P` and `ψ : G ↠ Q ≅ Π̂_{g,0}` have the same kernel, `G` compact, `P ≅ F̂(α)`
torsion-free and nontrivial, then the image of `κ` is not open. -/
theorem false_of_isOpen_range_of_ker_eq₂ {G Q P : Type*} [Group G] [TopologicalSpace G]
    [CompactSpace G] [Group Q] [TopologicalSpace Q] [CompactSpace Q] [T2Space Q] [Group P]
    [TopologicalSpace P] [IsTopologicalGroup P] [T2Space P] [CompactSpace P] {α : Type*}
    (eP : P ≃ₜ* FreeHat α) (htf : ∀ x : P, IsOfFinOrder x → x = 1) (hnt : ∃ x : P, x ≠ 1)
    {g : ℕ} (eQ : Q ≃ₜ* completion (GrpCat.of (ULift.{v} (SurfaceGroup g 0))))
    (ψ : G →ₜ* Q) (hψ : Function.Surjective ψ) (κ : G →ₜ* P)
    (hker : κ.toMonoidHom.ker = ψ.toMonoidHom.ker) (hopen : IsOpen (Set.range κ)) : False := by
  let O : Subgroup P := κ.toMonoidHom.range
  have hO : IsOpen (O : Set P) := by
    rw [MonoidHom.coe_range]
    exact hopen
  let κO : G →ₜ* O :=
    { toMonoidHom := κ.toMonoidHom.rangeRestrict
      continuous_toFun := continuous_induced_rng.2 κ.continuous }
  have hκO : Function.Surjective κO := κ.toMonoidHom.rangeRestrict_surjective
  have hkerO : ψ.toMonoidHom.ker = κO.toMonoidHom.ker := by
    rw [← hker]
    ext x
    simp only [MonoidHom.mem_ker]
    exact ⟨fun h ↦ Subtype.ext h, fun h ↦ congrArg Subtype.val h⟩
  let e : Q ≃ₜ* O := contMulEquivOfKerEq ψ hψ κO hkerO hκO
  rcases Nat.eq_zero_or_pos g with rfl | hg
  · -- `Q` is trivial, so `{1}` is open in `P`, and `P` is finite
    have hQ : ∀ q : Q, q = 1 := fun q ↦
      eQ.injective ((eq_one_completion_ulift_zero₂ (eQ q)).trans (map_one eQ).symm)
    have hO1 : (O : Set P) = {1} := by
      ext x
      constructor
      · intro hx
        have h1 : (⟨x, hx⟩ : O) = e (e.symm ⟨x, hx⟩) := (e.apply_symm_apply _).symm
        rw [hQ (e.symm ⟨x, hx⟩), map_one] at h1
        exact congrArg Subtype.val h1
      · intro hx
        rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact O.one_mem
    rw [hO1] at hO
    haveI : DiscreteTopology P := discreteTopology_of_isOpen_singleton_one hO
    haveI : Finite P := finite_of_compact_of_discrete
    obtain ⟨x, hx⟩ := hnt
    exact hx (htf x (isOfFinOrder_of_finite x))
  · have h1 : HasFiniteLifts.{0} O := HasFiniteLifts.of_isOpen_of_continuousMulEquiv α eP O hO
    exact not_hasFiniteLifts_completion_ulift₂ hg (h1.of_continuousMulEquiv (e.symm.trans eQ))

end Abstract


/-! ### Filling in all cusps of an affine hyperbolic curve -/

section Proper

variable {M : Type u} [Field M] [NumberField M] (Ω : Type u) [Field Ω] [Algebra M Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic M Ω] [CharZero Ω] (C : HypCurve M)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty)

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **The closed normal subgroup of `Π_U` generated by all cuspidal inertia groups** (the kernel
of `Π_U ↠ Π_{X̄}`, filling in all cusps). -/
def allCuspsClosure₂ : Subgroup π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec M Ω Γ(C.Xbar, C.U)) :=
  (Subgroup.normalClosure (⋃ I ∈ arithCusps Ω C hc, (I : Set _))).topologicalClosure

instance nonempty_top_geomCurve₂ : Nonempty (⊤ : (geomCurve Ω C).Opens) :=
  ⟨⟨(Classical.arbitrary (geomOpen Ω C)).1, trivial⟩⟩

/-- `π₁ᵉᵗ(U_Ω) → π₁ᵉᵗ(X̄_Ω)` at the geometric generic points (filling in all cusps). -/
def geomFillTop₂ : π₁ᵉᵗ(specPoint (geomData Ω C).L (FFClosure (geomCurve Ω C)) ≫
    genericL (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
      (geomOpen Ω C)) →ₜ*
    π₁ᵉᵗ(specPoint (geomData Ω C).L (FFClosure (geomCurve Ω C)) ≫
      genericL (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C)) ⊤) :=
  fundamentalGroupMap ((geomCurve Ω C).homOfLE le_top)
    (specPoint_genericL_homOfLE (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) le_top)

omit [NumberField M] [Algebra.IsAlgebraic M Ω] in
/-- **Every place `W ⊇ Ω` is centred on `X̄_Ω`.** -/
lemma isCentredOn_top₂ {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hkW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W) :
    IsCentredOn (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C)) ⊤
      W := by
  by_contra hW
  obtain ⟨y, hy, -⟩ := exists_notMem_of_not_isCentredOn (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C)) ⊤ hkW hW
  exact hy trivial

omit [NumberField M] [Algebra.IsAlgebraic M Ω] in
/-- **The kernel of filling in all cusps** (`ker_fundamentalGroupMap_homOfLE_eq_cuspInertia` with
`V = X̄`): the closed normal subgroup generated by the cuspidal inertia groups of all places over
cusps. -/
theorem ker_geomFillTop₂ : (geomFillTop₂ Ω C).toMonoidHom.ker =
    (Subgroup.normalClosure (⋃ (W : ValuationSubring (FFClosure (geomCurve Ω C)))
      (_ : IsCentredOn (geomData Ω C) (geomCurve Ω C)
        (curveEquivL Ω (transcendental_geomCoord Ω C)) ⊤ W ∧
        ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
          (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W),
        (geomCuspInertia Ω C W : Set _))).topologicalClosure :=
  ker_fundamentalGroupMap_homOfLE_eq_cuspInertia (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveGaloisData_H_le Ω (transcendental_geomCoord Ω C))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C))
    (curveEquivL_τ Ω (transcendental_geomCoord Ω C))
    (compl_finite_baseChangeOpen M Ω C.nonempty) (by simp) le_top

omit [NumberField M] [Algebra.IsAlgebraic M Ω] in
/-- `π₁ᵉᵗ(U_Ω) ↠ π₁ᵉᵗ(X̄_Ω)` is surjective. -/
theorem geomFillTop₂_surjective : Function.Surjective (geomFillTop₂ Ω C) := by
  intro y
  obtain ⟨σ, rfl⟩ := (genericL_spec (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C))
    (curveGaloisData_H_le Ω (transcendental_geomCoord Ω C))
    (curveEquivL_τ Ω (transcendental_geomCoord Ω C)) ⊤ (by simp)).2 y
  exact ⟨_, fundamentalGroupMap_genericL (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveGaloisData_H_le Ω (transcendental_geomCoord Ω C)) le_top σ⟩

omit [NumberField M] [Algebra.IsAlgebraic M Ω] in
/-- **`π₁ᵉᵗ(X̄_Ω) ≃ₜ* Π̂_{g,0}`** at the geometric generic point. -/
theorem nonempty_geomTop_equiv₂ :
    Nonempty (π₁ᵉᵗ(specPoint (geomData Ω C).L (FFClosure (geomCurve Ω C)) ≫
      genericL (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
        ⊤) ≃ₜ* completion (GrpCat.of (ULift.{u} (Pi1.SurfaceGroup
          (curveGenus Ω (geomCurve Ω C)).toNat 0)))) := by
  obtain ⟨e⟩ := etaleFundamentalGroup_equiv_profiniteSurfaceGroup_zero_of_isAlgClosed (k := Ω)
    (X := geomCurve Ω C) ((specPoint (geomData Ω C).L (FFClosure (geomCurve Ω C)) ≫
      genericL (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
        ⊤) ≫ (asIso (⊤ : (geomCurve Ω C).Opens).ι).hom)
  exact ⟨(fundamentalGroupEquivOfIso (asIso (⊤ : (geomCurve Ω C).Opens).ι) _).trans e⟩

/-- **`geomToPi⁻¹(⟨⟨all cusps⟩⟩) = ker(π₁ᵉᵗ(U_Ω) ↠ π₁ᵉᵗ(X̄_Ω))`.** -/
theorem comap_allCuspsClosure₂ :
    (allCuspsClosure₂ Ω C hc).comap (geomToPi Ω C hc) = (geomFillTop₂ Ω C).toMonoidHom.ker := by
  rw [ker_geomFillTop₂]
  apply le_antisymm
  · -- `⟨⟨all cusps⟩⟩ ⊆ geomToPi(N_G)`
    have hcl : IsClosed (SetLike.coe (Subgroup.map (geomToPi Ω C hc)
        (Subgroup.normalClosure (⋃ (W : ValuationSubring
        (FFClosure (geomCurve Ω C))) (_ : IsCentredOn (geomData Ω C) (geomCurve Ω C)
          (curveEquivL Ω (transcendental_geomCoord Ω C)) ⊤ W ∧
          ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
            (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W),
          (geomCuspInertia Ω C W : Set _))).topologicalClosure)) := by
      rw [Subgroup.coe_map]
      exact isClosedMap_geomToPi Ω C hc _ (Subgroup.isClosed_topologicalClosure _)
    have hle : allCuspsClosure₂ Ω C hc ≤ (Subgroup.normalClosure (⋃ (W : ValuationSubring
        (FFClosure (geomCurve Ω C))) (_ : IsCentredOn (geomData Ω C) (geomCurve Ω C)
          (curveEquivL Ω (transcendental_geomCoord Ω C)) ⊤ W ∧
          ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
            (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W),
          (geomCuspInertia Ω C W : Set _))).topologicalClosure.map (geomToPi Ω C hc) := by
      refine Subgroup.topologicalClosure_minimal _ ?_ hcl
      rw [Subgroup.normalClosure, Subgroup.closure_le]
      intro x hx
      obtain ⟨a, ha, hax⟩ := Group.mem_conjugatesOfSet_iff.1 hx
      obtain ⟨c, rfl⟩ := isConj_iff.1 hax
      obtain ⟨I, hI⟩ := Set.mem_iUnion.1 ha
      obtain ⟨hI, haI⟩ := Set.mem_iUnion.1 hI
      have hI' := map_conj_mem_arithCusps Ω C hc hI c
      obtain ⟨W, hW, hWe⟩ := (mem_arithCusps_iff Ω C hc).1 hI'
      have hmem : c * a * c⁻¹ ∈ I.map (MulAut.conj c).toMonoidHom := ⟨a, haI, rfl⟩
      rw [hWe, arithInertia_eq_map_geom Ω C hc hW.1] at hmem
      refine Subgroup.map_mono (Subgroup.le_topologicalClosure _) ?_
      exact Subgroup.map_mono (fun z hz ↦ Subgroup.subset_normalClosure
        (Set.mem_iUnion₂.2 ⟨W, ⟨isCentredOn_top₂ Ω C hW.1,
          fun h ↦ hW.2 ((isCentredOn_geomOpen_iff Ω C hc W).1 h).2⟩, hz⟩)) hmem
    intro σ hσ
    obtain ⟨τ, hτ, hτσ⟩ := hle hσ
    rwa [geomToPi_injective Ω C hc hτσ] at hτ
  · -- `N_G ⊆ geomToPi⁻¹(⟨⟨all cusps⟩⟩)`
    refine closure_normalClosure_le_comap (geomToPi Ω C hc) (continuous_geomToPi Ω C hc) ?_
    intro s hs
    obtain ⟨W, ⟨hWt, hWU⟩, hsW⟩ := Set.mem_iUnion₂.1 hs
    exact Set.mem_iUnion₂.2 ⟨_, mem_arithCusps Ω C hc hWt.1 hWU, ⟨s, hsW, rfl⟩⟩

end Proper

/-! ### The contradiction: `Δ_C / ⟨⟨all cusps⟩⟩` is not open in `Δ_X` -/

section Arith

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **`Δ_X ≃ₜ* F̂(α)`** for an affine hyperbolic curve `X` (with a cusp). -/
theorem exists_kerProjGk_equiv_freeHat₂ :
    ∃ α : Type u, Nonempty ((projGk Ω CX hcX).toMonoidHom.ker ≃ₜ* FreeHat α) := by
  obtain ⟨e⟩ := nonempty_kerProjGk_equiv Ω CX hcX
  have hr : 0 < Nat.card ((baseChangeOpen K Ω CX.U : Set (baseChange K Ω CX.Xbar))ᶜ : Set _) :=
    haveI := (compl_finite_baseChangeOpen K Ω CX.nonempty).to_subtype
    Nat.card_pos_iff.2 ⟨(compl_nonempty_baseChangeOpen K Ω hcX).to_subtype, inferInstance⟩
  obtain ⟨r, hr'⟩ : ∃ r, Nat.card ((baseChangeOpen K Ω CX.U :
      Set (baseChange K Ω CX.Xbar))ᶜ : Set _) = r + 1 := ⟨_, (Nat.succ_pred_eq_of_pos hr).symm⟩
  rw [hr'] at e
  exact ⟨_, ⟨e.trans (surfaceCompletionEquivFreeHat _ r)⟩⟩

variable {M : Type u} [Field M] [NumberField M] [Algebra M Ω] [Algebra.IsAlgebraic M Ω]

variable (C : HypCurve M) (hc : (C.U : Set C.Xbar)ᶜ.Nonempty)
  (κ : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec M Ω Γ(C.Xbar, C.U)) →ₜ*
      π₁ᵉᵗ(basePoint Ω CX hcX ≫ baseChangeSpec K Ω Γ(CX.Xbar, CX.U)))
  (hΔ : ∀ σ ∈ (projGk Ω C hc).toMonoidHom.ker, κ σ ∈ (projGk Ω CX hcX).toMonoidHom.ker)

/-- `κ ∘ geomToPi : π₁ᵉᵗ(U_{C,Ω}) → Δ_X`. -/
def kappaGeom₂ : π₁ᵉᵗ(specPoint (geomData Ω C).L (FFClosure (geomCurve Ω C)) ≫
    genericL (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
      (geomOpen Ω C)) →ₜ* (projGk Ω CX hcX).toMonoidHom.ker where
  toMonoidHom := (κ.toMonoidHom.comp (geomToPi Ω C hc)).codRestrict
    (projGk Ω CX hcX).toMonoidHom.ker fun γ ↦ hΔ (geomToPi Ω C hc γ) (geomToPi_mem_ker Ω C hc γ)
  continuous_toFun := continuous_induced_rng.2 (κ.continuous.comp (continuous_geomToPi Ω C hc))

omit [Algebra.IsAlgebraic K Ω] in
lemma coe_kappaGeom₂ (γ) : (kappaGeom₂ C hc κ hΔ γ : π₁ᵉᵗ(basePoint Ω CX hcX ≫
    baseChangeSpec K Ω Γ(CX.Xbar, CX.U))) = κ (geomToPi Ω C hc γ) := rfl

omit [Algebra.IsAlgebraic K Ω] in
lemma ker_kappaGeom₂
    (hker : ∀ σ ∈ (projGk Ω C hc).toMonoidHom.ker, κ σ = 1 ↔ σ ∈ allCuspsClosure₂ Ω C hc) :
    (kappaGeom₂ C hc κ hΔ).toMonoidHom.ker = (geomFillTop₂ Ω C).toMonoidHom.ker := by
  rw [← comap_allCuspsClosure₂ Ω C hc]
  ext γ
  rw [MonoidHom.mem_ker, Subgroup.mem_comap, ← hker _ (geomToPi_mem_ker Ω C hc γ)]
  exact ⟨fun h ↦ (coe_kappaGeom₂ C hc κ hΔ γ).symm.trans (congrArg Subtype.val h),
    fun h ↦ Subtype.ext ((coe_kappaGeom₂ C hc κ hΔ γ).trans h)⟩

omit [Algebra.IsAlgebraic K Ω] in
lemma range_kappaGeom₂ : Set.range (kappaGeom₂ C hc κ hΔ) =
    {x : (projGk Ω CX hcX).toMonoidHom.ker | ∃ σ ∈ (projGk Ω C hc).toMonoidHom.ker, κ σ = x} := by
  refine Set.ext fun x ↦ ?_
  constructor
  · rintro ⟨γ, rfl⟩
    exact ⟨_, geomToPi_mem_ker Ω C hc γ, (coe_kappaGeom₂ C hc κ hΔ γ).symm⟩
  · rintro ⟨σ, hσ, hσx⟩
    rw [← range_geomToPi Ω C hc] at hσ
    obtain ⟨γ, rfl⟩ := hσ
    exact ⟨γ, Subtype.ext ((coe_kappaGeom₂ C hc κ hΔ γ).trans hσx)⟩

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
lemma isClosed_kerProjGk₂ : IsClosed (SetLike.coe (projGk Ω CX hcX).toMonoidHom.ker) := by
  have e : SetLike.coe (projGk Ω CX hcX).toMonoidHom.ker = (projGk Ω CX hcX) ⁻¹' {1} := rfl
  rw [e]
  exact isClosed_singleton.preimage (projGk Ω CX hcX).continuous

include hΔ in
/-- **Filling in all cusps of a curve over a number field never gives an open subgroup of
`Δ_X`** (`Δ_X` of the affine curve `X` is free, while `Δ` of a proper curve of genus `g ≥ 1` is
`Π̂_{g,0}`, which does not have finite lifts, and for `g = 0` it is trivial). Let `C` be an affine
hyperbolic curve over a number field `M ⊆ Ω` and
`κ : Π_C → Π_X` continuous, mapping `Δ_C` into `Δ_X`, whose kernel on `Δ_C` is the closed
normal subgroup generated by all cuspidal inertia groups. Then `κ(Δ_C)` is not open in `Δ_X`. -/
theorem false_of_ker_eq_allCuspsClosure₂
    (hker : ∀ σ ∈ (projGk Ω C hc).toMonoidHom.ker, κ σ = 1 ↔ σ ∈ allCuspsClosure₂ Ω C hc)
    (hopen : IsOpen {x : (projGk Ω CX hcX).toMonoidHom.ker |
      ∃ σ ∈ (projGk Ω C hc).toMonoidHom.ker, κ σ = x}) : False := by
  obtain ⟨α, ⟨eP⟩⟩ := exists_kerProjGk_equiv_freeHat₂ (Ω := Ω) (CX := CX) (hcX := hcX)
  obtain ⟨eQ⟩ := nonempty_geomTop_equiv₂ Ω C
  haveI : CompactSpace (projGk Ω CX hcX).toMonoidHom.ker :=
    isCompact_iff_compactSpace.mp (isClosed_kerProjGk₂ (Ω := Ω) (CX := CX) (hcX := hcX)).isCompact
  have hopen' : IsOpen (Set.range (kappaGeom₂ C hc κ hΔ)) := by
    rw [range_kappaGeom₂]
    exact hopen
  have htf : ∀ x : (projGk Ω CX hcX).toMonoidHom.ker, IsOfFinOrder x → x = 1 := fun x hx ↦
    Delta_eq_one_of_isOfFinOrder Ω CX hcX hx
  have hnt : ∃ x : (projGk Ω CX hcX).toMonoidHom.ker, x ≠ 1 :=
    Subgroup.ne_bot_iff_exists_ne_one.1 (arithmeticExt Ω CX hcX).nontrivial_delta
  exact false_of_isOpen_range_of_ker_eq₂ eP htf hnt eQ (geomFillTop₂ Ω C)
    (geomFillTop₂_surjective Ω C) (kappaGeom₂ C hc κ hΔ) (ker_kappaGeom₂ C hc κ hΔ hker) hopen'

end Arith

/-! ### Operations `•` filling in all cusps of a full model -/

section Model

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty} {A B : ChainObj (arithmeticExt Ω CX hcX)}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- The point `Spec Ω ⟶ Spec K`. -/
local notation "sK" => Spec.map (CommRingCat.ofHom (algebraMap K Ω))

namespace GeomModel

variable (D : GeomModel Ω CX hcX A) (φ : A.grp →ₜ* B.grp)
  (κ : D.Pi →ₜ* π₁ᵉᵗ(basePoint Ω CX hcX ≫ baseChangeSpec K Ω Γ(CX.Xbar, CX.U)))

/-- `κ` maps `Δ_Y` into `Δ_X`. -/
lemma kappa_mem_ker₂
    (hk2 : ∃ g : π₁ᵉᵗ(sK), ∀ σ, projGk Ω CX hcX (κ σ) = g * toGk A (D.ι σ) * g⁻¹)
    {σ : D.Pi} (hσ : σ ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker) :
    κ σ ∈ (projGk Ω CX hcX).toMonoidHom.ker := by
  obtain ⟨g, hg⟩ := hk2
  have h1 : σ ∈ A.Delta.comap (D.ι : D.Pi →* A.grp) := by
    rw [D.comap_Delta]
    exact hσ
  have h2 : toGk A (D.ι σ) = 1 := h1
  change projGk Ω CX hcX (κ σ) = 1
  rw [hg, h2, mul_one, mul_inv_cancel]

/-- `κ` reflects `Δ`: `κ σ ∈ Δ_X` implies `σ ∈ Δ_Y`. -/
lemma mem_ker_of_kappa₂
    (hk2 : ∃ g : π₁ᵉᵗ(sK), ∀ σ, projGk Ω CX hcX (κ σ) = g * toGk A (D.ι σ) * g⁻¹)
    {σ : D.Pi} (hσ : κ σ ∈ (projGk Ω CX hcX).toMonoidHom.ker) :
    σ ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker := by
  obtain ⟨g, hg⟩ := hk2
  have h1 : projGk Ω CX hcX (κ σ) = 1 := hσ
  rw [hg] at h1
  have h2 : toGk A (D.ι σ) = 1 := by
    have h3 := congrArg (fun z ↦ g⁻¹ * z * g) h1
    simpa [mul_assoc] using h3
  have h4 : D.ι σ ∈ A.Delta := h2
  rw [← D.comap_Delta]
  exact h4

/-- **If no cuspidal inertia group of `Π_X` has infinite image in `B` and every cusp of the model
`Y` of `A` comes from a cusp of `Π_X`, then `φ ∘ ι` kills every cuspidal inertia group of `Π_Y`**:
their images are finite, hence torsion (and `κ` maps them into the torsion-free `Δ_X`). -/
theorem le_dcN_of_not_hasInfCusp₂ (hk1 : ∀ σ, κ σ = 1 ↔ φ (D.ι σ) = 1)
    (hk2 : ∃ g : π₁ᵉᵗ(sK), ∀ σ, projGk Ω CX hcX (κ σ) = g * toGk A (D.ι σ) * g⁻¹)
    (hcompat : ChainObj.Compat A B φ) (hB : ¬ B.HasInfCusp)
    (hCS : ∀ J ∈ arithCusps Ω D.Y D.hY, ∃ I ∈ (arithmeticExt Ω CX hcX).cusps,
      ((A.image I).comap (D.ι : D.Pi →* A.grp)).Commensurable J)
    {J : Subgroup D.Pi} (hJ : J ∈ arithCusps Ω D.Y D.hY) : J ≤ D.dcN φ := by
  obtain ⟨I, hI, hIJ⟩ := hCS J hJ
  have hfinB : (B.image I).Commensurable ⊥ := by
    by_contra h
    exact hB ⟨I, hI, h⟩
  have hR := D.index_range_ne_zero
  have h2 : (((A.image I).comap (D.ι : D.Pi →* A.grp)).map
      (D.dcPhi φ : D.Pi →* B.grp)).Commensurable ((A.image I).map (φ : A.grp →* B.grp)) := by
    have e : ((A.image I).comap (D.ι : D.Pi →* A.grp)).map (D.dcPhi φ : D.Pi →* B.grp) =
        (((A.image I).comap (D.ι : D.Pi →* A.grp)).map (D.ι : D.Pi →* A.grp)).map
          (φ : A.grp →* B.grp) := by
      rw [Subgroup.map_map]
      rfl
    rw [e, Subgroup.map_comap_eq]
    exact (Subgroup.commensurable_inf_of_index_ne_zero hR (A.image I)).map'
      (φ : A.grp →* B.grp)
  have h3 : (J.map (D.dcPhi φ : D.Pi →* B.grp)).Commensurable ⊥ :=
    (hIJ.symm.map' (D.dcPhi φ : D.Pi →* B.grp)).trans
      (h2.trans ((hcompat.image_commensurable I).symm.trans hfinB))
  haveI : Finite (J.map (D.dcPhi φ : D.Pi →* B.grp)) :=
    (Subgroup.finite_of_commensurable_bot h3).to_subtype
  intro j hj
  change φ (D.ι j) = 1
  have hmem : φ (D.ι j) ∈ J.map (D.dcPhi φ : D.Pi →* B.grp) := ⟨j, hj, rfl⟩
  obtain ⟨n, hn, hpow⟩ := isOfFinOrder_iff_pow_eq_one.1
    ((J.map (D.dcPhi φ : D.Pi →* B.grp)).subtype.isOfFinOrder
      (isOfFinOrder_of_finite (⟨φ (D.ι j), hmem⟩ : J.map (D.dcPhi φ : D.Pi →* B.grp))))
  have hpow' : φ (D.ι (j ^ n)) = 1 := by
    rw [map_pow, map_pow]
    exact hpow
  have hκpow : κ j ^ n = 1 := by
    rw [← map_pow]
    exact (hk1 _).2 hpow'
  have hjΔ : j ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker := arithCusps_le Ω D.Y D.hY hJ hj
  have hκ1 : κ j = 1 := by
    have h5 := Delta_eq_one_of_isOfFinOrder Ω CX hcX
      (δ := ⟨κ j, kappa_mem_ker₂ D κ hk2 hjΔ⟩)
      (((Subgroup.subtype_injective _).isOfFinOrder_iff
        (f := ((projGk Ω CX hcX).toMonoidHom.ker).subtype)).1
        (isOfFinOrder_iff_pow_eq_one.2 ⟨n, hn, hκpow⟩))
    exact congrArg Subtype.val h5
  exact (hk1 j).1 hκ1

/-- **The kernel of `•` on a model containing it is generated by cuspidal inertia groups**:
`ker φ ⊆ ι(⟨⟨cuspidal inertia groups of Π_Y inside ι⁻¹(ker φ)⟩⟩)` (as in
`GeomModel.exists_fill_of_decusp`). -/
theorem ker_le_map_closure₂ (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    {C : Subgroup A.grp} (hC : A.IsCuspidal C) (htf : A.InTorsionFreeNormalOpen C)
    (hker : (φ : A.grp →* B.grp).ker = A.deltaNormalClosure C)
    (hKP : (φ : A.grp →* B.grp).ker ≤ (D.ι : D.Pi →* A.grp).range) :
    (φ : A.grp →* B.grp).ker ≤
      ((Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω D.Y D.hY ∧ I ≤ D.dcN φ),
        (I : Set D.Pi))).topologicalClosure).map (D.ι : D.Pi →* A.grp) := by
  have hC0 : C.comap (D.ι : D.Pi →* A.grp) ∈ arithCusps Ω D.Y D.hY :=
    D.comap_mem_arithCusps_of_isCuspidal hC htf
  have hCr : C ≤ (D.ι : D.Pi →* A.grp).range := fun c hc ↦ hKP (by
    rw [hker]
    refine Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨1, A.Delta.one_mem, c, hc,
      by group⟩))
  have hRc : IsClosed (((((Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω D.Y D.hY ∧
      I ≤ D.dcN φ), (I : Set D.Pi))).topologicalClosure).map
        (D.ι : D.Pi →* A.grp)) : Subgroup A.grp) : Set A.grp) := by
    rw [Subgroup.coe_map]
    exact D.ι.continuous.isClosedMap _ (Subgroup.isClosed_topologicalClosure _)
  rw [hker]
  refine Subgroup.topologicalClosure_minimal _ ?_ hRc
  rw [Subgroup.closure_le]
  rintro _ ⟨d, hd, c, hc, rfl⟩
  obtain ⟨σ, rfl⟩ := hCr hc
  let g : D.Nrm := ⟨d, D.Delta_le_Nrm hd⟩
  refine ⟨D.conjPi g σ, ?_, D.ι_conjPi g σ⟩
  have hcusp : (C.comap (D.ι : D.Pi →* A.grp)).map (D.conjPi g).toMulEquiv.toMonoidHom ∈
      arithCusps Ω D.Y D.hY := (D.map_conjPi_mem_arithCusps_iff (hDGC D.M) g).2 hC0
  have hle : (C.comap (D.ι : D.Pi →* A.grp)).map (D.conjPi g).toMulEquiv.toMonoidHom ≤
      D.dcN φ := by
    rintro _ ⟨τ, hτ, rfl⟩
    change D.ι (D.conjPi g τ) ∈ (φ : A.grp →* B.grp).ker
    rw [D.ι_conjPi, hker]
    exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨d, hd, D.ι τ, hτ, rfl⟩)
  refine Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure ?_)
  exact Set.mem_iUnion₂.2 ⟨_, ⟨hcusp, hle⟩, ⟨σ, hc, rfl⟩⟩

/-- **An operation `•` killing every cusp of a model cannot be followed by an open embedding into
`Π_X` over `G_K`.** Let `φ : A ↠ B` be of type `•`, `D` a model of `A` with `ker φ ⊆ ι(Π_Y)` such
that `ι⁻¹(ker φ)` contains every cuspidal inertia group of `Π_Y`, and `κ : Π_Y → Π_X` with open
image, `ker κ = ker (φ ∘ ι)`, over `G_K` up to conjugation (e.g. `Π_Y → B ⊇ Π_V ↪ Π_X`). Then
`ι⁻¹(ker φ)` is the closed normal subgroup generated by all cuspidal inertia groups of `Π_Y`, so
`κ(Δ_Y) ≅ Δ_Y / ⟨⟨cusps⟩⟩ ≅ Π̂_{g,0}` would be open in the free `Δ_X`
(`false_of_ker_eq_allCuspsClosure₂`). -/
theorem false_of_le_dcN₂ (hk1 : ∀ σ, κ σ = 1 ↔ φ (D.ι σ) = 1)
    (hk2 : ∃ g : π₁ᵉᵗ(sK), ∀ σ, projGk Ω CX hcX (κ σ) = g * toGk A (D.ι σ) * g⁻¹)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    {C : Subgroup A.grp} (hC : A.IsCuspidal C) (htf : A.InTorsionFreeNormalOpen C)
    (hker : (φ : A.grp →* B.grp).ker = A.deltaNormalClosure C)
    (hKP : (φ : A.grp →* B.grp).ker ≤ (D.ι : D.Pi →* A.grp).range)
    (hall : ∀ J ∈ arithCusps Ω D.Y D.hY, J ≤ D.dcN φ) (hk3 : IsOpen (Set.range κ)) : False := by
  -- `ι⁻¹(ker φ)` is the closed normal subgroup generated by all cusps
  have hN : D.dcN φ = allCuspsClosure₂ Ω D.Y D.hY := by
    apply le_antisymm
    · rw [D.dcN_eq_closure φ (D.ker_le_map_closure₂ φ hDGC hC htf hker hKP)]
      refine Subgroup.topologicalClosure_mono (Subgroup.normalClosure_mono ?_)
      intro x hx
      obtain ⟨I, hI, hxI⟩ := Set.mem_iUnion₂.1 hx
      exact Set.mem_iUnion₂.2 ⟨I, hI.1, hxI⟩
    · haveI : (D.dcN φ).Normal := Subgroup.Normal.comap (MonoidHom.normal_ker _) _
      refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) ?_
      · intro x hx
        obtain ⟨I, hI, hxI⟩ := Set.mem_iUnion₂.1 hx
        exact hall I hI hxI
      · have e : (D.dcN φ : Set D.Pi) = (D.dcPhi φ) ⁻¹' {1} := rfl
        rw [e]
        exact isClosed_singleton.preimage (D.dcPhi φ).continuous
  have hker' : ∀ σ ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker,
      κ σ = 1 ↔ σ ∈ allCuspsClosure₂ Ω D.Y D.hY := fun σ _ ↦ by
    rw [← hN, hk1]
    rfl
  refine false_of_ker_eq_allCuspsClosure₂ D.Y D.hY κ (fun σ hσ ↦ kappa_mem_ker₂ D κ hk2 hσ)
    hker' ?_
  have hset : {x : (projGk Ω CX hcX).toMonoidHom.ker |
      ∃ σ ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker, κ σ = x} =
      Subtype.val ⁻¹' Set.range κ := by
    refine Set.ext fun x ↦ ⟨?_, ?_⟩
    · rintro ⟨σ, -, hσx⟩
      exact ⟨σ, hσx⟩
    · rintro ⟨σ, hσ⟩
      refine ⟨σ, mem_ker_of_kappa₂ D κ hk2 ?_, hσ⟩
      rw [hσ]
      exact x.2
  rw [hset]
  exact hk3.preimage continuous_subtype_val

end GeomModel

end Model

/-! ### Belyi-type chains -/

section Chain

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **Every cusp of the geometric model `D` of `A` comes from a cusp of `Π_X`**: for every
cuspidal inertia group `J` of `Π_Y` there is a cuspidal inertia group `I` of `Π_X` with
`ι⁻¹(ρ_A(I))` commensurable with `J` (the converse of the field `GeomModel.cusp`). -/
def ModelCS₂ {A : ChainObj (arithmeticExt Ω CX hcX)} (D : GeomModel Ω CX hcX A) : Prop :=
  ∀ J ∈ arithCusps Ω D.Y D.hY, ∃ I ∈ (arithmeticExt Ω CX hcX).cusps,
    ((A.image I).comap (D.ι : D.Pi →* A.grp)).Commensurable J

variable (Ω CX hcX) in
/-- **Every cusp of every geometric model of `A` comes from a cusp of `Π_X`** (`ModelCS₂` for all
models). For the objects of the geometric Belyi chain this is the cusp bookkeeping of
`BelyiData.cuspMatchW`; for the objects of an arbitrary chain without `⊚` it follows from the
model independence of cusps (`CuspCompat₂`, `cuspSurj_of_cuspCompat₂`). -/
def CuspSurj₂ (A : ChainObj (arithmeticExt Ω CX hcX)) : Prop :=
  ∀ D : GeomModel Ω CX hcX A, ModelCS₂ D

/-- **The source of an operation of type `•` has an infinite cusp image.** -/
theorem _root_.Belyi.Anabelian.ElemOp.hasInfCusp_of_decusp₂ {E : CuspidalExt.{u + 1}}
    {A B : ChainObj E} (o : ElemOp A B) (ho : o.kind = .decusp) : A.HasInfCusp := by
  match o, ho with
  | .decusp _ _ _ cusp tf _ _, _ => exact ChainObj.hasInfCusp_of_isCuspidal cusp tf
  | .cover .., h => exact absurd h (by simp [ElemOp.kind])
  | .quot .., h => exact absurd h (by simp [ElemOp.kind])
  | .deorb .., h => exact absurd h (by simp [ElemOp.kind])

/-- **Geometric models of the objects `Π₀, …, Πₙ` of a chain** without `⊚` up to `n`, all of whose
objects up to `n` have an infinite cusp image. -/
theorem _root_.Belyi.Anabelian.PiChain.nonempty_geomModel_le₂
    (c : PiChain (arithmeticExt Ω CX hcX))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k) :
    ∀ (n : ℕ) (hn : n ≤ c.len), (∀ j (hj : j < n), (c.opN j (by omega)).kind ≠ .deorb) →
      (∀ j (hj : j ≤ n), (c.objN j (by omega)).HasInfCusp) →
      Nonempty (GeomModel Ω CX hcX (c.objN n hn))
  | 0, hn, _, _ => by
    obtain ⟨e, he⟩ := c.obj_zero
    have h0 : Nonempty (GeomModel Ω CX hcX (c.obj 0)) :=
      ⟨(GeomModel.base Ω CX hcX).ofCover (ContinuousMonoidHom.toContinuousMonoidHom e)
        e.injective (by
          convert isOpen_univ
          exact Set.eq_univ_of_forall fun x ↦ ⟨e.symm x, e.apply_symm_apply x⟩) he⟩
    have e0 : c.objN 0 hn = c.obj 0 := congrArg c.obj (Fin.ext (by simp))
    rw [e0]
    exact h0
  | n + 1, hn, hk, hinf => by
    obtain ⟨D⟩ := c.nonempty_geomModel_le₂ hDGC n (by omega) (fun j hj ↦ hk j (by omega))
      (fun j hj ↦ hinf j (by omega))
    exact nonempty_geomModel_of_elemOp (c.opN n (by omega)) D hDGC (hk n (by omega))
      (hinf (n + 1) le_rfl)

variable {c : PiChain (arithmeticExt Ω CX hcX)} {l r : ℕ}

/-- **The source of the last `•` and all earlier objects have an infinite cusp image** (`r ≥ 1`). -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.hasInfCusp_le₂ (hc : c.IsBelyiType l r)
    (hr : 0 < r) (j : ℕ) (hj : j ≤ l + r + 2) :
    (c.objN j (by have := hc.len_eq; omega)).HasInfCusp := by
  have hlen := hc.len_eq
  have hkind : (c.opN (l + r + 2) (by omega)).kind = .decusp := by
    rw [c.kind_opN_congr (b := l + 3 + (r - 1)) (by omega) _ (by omega)]
    exact hc.2.2.2.2.2.1 (r - 1) (by omega)
  have htop := (c.opN (l + r + 2) (by omega)).hasInfCusp_of_decusp₂ hkind
  have down : ∀ n k (hk : k ≤ c.len), k + n = l + r + 2 → (c.objN k hk).HasInfCusp := by
    intro n
    induction n with
    | zero =>
      intro k hk hkn
      exact (c.objN_congr_iff ChainObj.HasInfCusp (by omega) _ _).2 htop
    | succ n ih =>
      intro k hk hkn
      exact (c.opN k (by omega)).hasInfCusp_source (hc.kind_ne_deorb k (by omega))
        (ih (k + 1) (by omega) (by omega))
  exact down (l + r + 2 - j) j _ (by omega)

/-- **A `•` from a full model whose target embeds openly into `Π_X` over `G_K`**: if every cusp of
the full model comes from a cusp of `Π_X`, some cuspidal inertia group of `Π_X` has infinite image
in the target. -/
theorem _root_.Belyi.Anabelian.ElemOp.hasInfCusp_target_of_full₂
    {A B : ChainObj (arithmeticExt Ω CX hcX)} (o : ElemOp A B) (ho : o.kind = .decusp)
    (D : GeomModel Ω CX hcX A) (hfull : Function.Surjective D.ι)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hCS : CuspSurj₂ Ω CX hcX A)
    (emb : B.grp →ₜ* (arithmeticExt Ω CX hcX).Pi) (hinj : Function.Injective emb)
    (hopen : IsOpen (Set.range emb))
    (hG : ∃ g, ∀ y, (arithmeticExt Ω CX hcX).pr (emb y) = g * B.toG y * g⁻¹) :
    B.HasInfCusp := by
  by_contra hB
  match o, ho with
  | .decusp φ surj C cusp tf ker compat, _ =>
    obtain ⟨g, hg⟩ := hG
    let κ : D.Pi →ₜ* π₁ᵉᵗ(basePoint Ω CX hcX ≫ baseChangeSpec K Ω Γ(CX.Xbar, CX.U)) :=
      emb.comp (D.dcPhi φ)
    have hk1 : ∀ σ, κ σ = 1 ↔ φ (D.ι σ) = 1 := fun σ ↦
      ⟨fun h ↦ hinj (h.trans (map_one emb).symm), fun h ↦ by
        change emb (φ (D.ι σ)) = 1
        rw [h]
        exact map_one emb⟩
    have hk2 : ∃ g' : π₁ᵉᵗ(Spec.map (CommRingCat.ofHom (algebraMap K Ω))), ∀ σ,
        projGk Ω CX hcX (κ σ) = g' * toGk A (D.ι σ) * g'⁻¹ := by
      refine ⟨g, fun σ ↦ ?_⟩
      change (arithmeticExt Ω CX hcX).pr (emb (φ (D.ι σ))) = _
      rw [hg, ChainObj.toG_apply_of_compat compat]
      rfl
    have hk3 : IsOpen (Set.range κ) := by
      have e : Set.range κ = Set.range emb := by
        refine Set.ext fun x ↦ ⟨fun ⟨σ, hσ⟩ ↦ ⟨_, hσ⟩, fun ⟨y, hy⟩ ↦ ?_⟩
        obtain ⟨a, rfl⟩ := surj y
        obtain ⟨σ, rfl⟩ := hfull a
        exact ⟨σ, hy⟩
      rw [e]
      exact hopen
    have hKP : (φ : A.grp →* B.grp).ker ≤ (D.ι : D.Pi →* A.grp).range := fun x _ ↦ hfull x
    exact D.false_of_le_dcN₂ φ κ hk1 hk2 hDGC cusp tf ker hKP
      (fun J hJ ↦ D.le_dcN_of_not_hasInfCusp₂ φ κ hk1 hk2 compat hB (hCS D) hJ) hk3
  | .cover .., h => exact absurd h (by simp [ElemOp.kind])
  | .quot .., h => exact absurd h (by simp [ElemOp.kind])
  | .deorb .., h => exact absurd h (by simp [ElemOp.kind])

/-- **`Π_V` of a Belyi-type chain with a terminal isomorphism has an infinite cusp image** (case
`r ≥ 1`), provided every cusp of every geometric model of the source `Π_{l+r+2}` of the last `•`
comes from a cusp of `Π_X` (`CuspSurj₂`). -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.hasInfCusp_V_of_cuspSurj₂
    (hc : c.IsBelyiType l r) (hr : 0 < r) (t : c.TerminalIso (PiChain.trivial _))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hCS : CuspSurj₂ Ω CX hcX (c.objN (l + r + 2) (by have := hc.len_eq; omega))) :
    (c.objN (l + r + 3) (by have := hc.len_eq; omega)).HasInfCusp := by
  have hlen := hc.len_eq
  have hkind : (c.opN (l + r + 2) (by omega)).kind = .decusp := by
    rw [c.kind_opN_congr (b := l + 3 + (r - 1)) (by omega) _ (by omega)]
    exact hc.2.2.2.2.2.1 (r - 1) (by omega)
  obtain ⟨D₀⟩ := c.nonempty_geomModel_le₂ hDGC (l + r + 2) (by omega)
    (fun j _ ↦ hc.kind_ne_deorb j (by omega)) (fun j hj ↦ hc.hasInfCusp_le₂ hr j hj)
  obtain ⟨D, hD⟩ := D₀.exists_full hDGC
    (hc.isTorsionFree_Delta_run t (l + r + 2) (by omega) (by omega))
  exact (c.opN (l + r + 2) (by omega)).hasInfCusp_target_of_full₂ hkind D hD hDGC hCS
    (PiChain.belyiEmb hc t) (PiChain.belyiEmb_injective hc t) (PiChain.isOpen_range_belyiEmb hc t)
    (PiChain.exists_pr_belyiEmb hc t)

end Chain

/-! ### Cusps of `Π_X` are infinite; the case `r = 0` -/

section ZeroRun

/-- **Lifting through an injective continuous homomorphism** from a compact group. -/
def liftInj₂ {P V B : Type*} [Group P] [TopologicalSpace P] [Group V] [TopologicalSpace V]
    [CompactSpace V] [Group B] [TopologicalSpace B] [T2Space B] (ψ : V →ₜ* B)
    (hinj : Function.Injective ψ) (f : P →ₜ* B) (hf : ∀ x, f x ∈ Set.range ψ) : P →ₜ* V where
  toFun x := (hf x).choose
  map_one' := hinj (by rw [(hf 1).choose_spec, map_one, map_one])
  map_mul' a b := hinj (by rw [(hf (a * b)).choose_spec, map_mul, map_mul, (hf a).choose_spec,
    (hf b).choose_spec])
  continuous_toFun := by
    refine (ψ.continuous.isClosedEmbedding hinj).isEmbedding.continuous_iff.2 ?_
    exact f.continuous.congr fun x ↦ ((hf x).choose_spec).symm

lemma liftInj₂_spec {P V B : Type*} [Group P] [TopologicalSpace P] [Group V] [TopologicalSpace V]
    [CompactSpace V] [Group B] [TopologicalSpace B] [T2Space B] (ψ : V →ₜ* B)
    (hinj : Function.Injective ψ) (f : P →ₜ* B) (hf : ∀ x, f x ∈ Set.range ψ) (x : P) :
    ψ (liftInj₂ ψ hinj f hf x) = f x :=
  (hf x).choose_spec

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **Cuspidal inertia groups of an affine hyperbolic curve are infinite** (also with a single
cusp: they are nontrivial by `cuspInertia_fill_ne_bot`, and `Δ` is torsion-free). -/
theorem not_commensurable_bot_of_mem_arithCusps₂ {I} (hI : I ∈ arithCusps Ω CX hcX) :
    ¬ I.Commensurable ⊥ := by
  obtain ⟨I₀, ⟨W, hkW, hWU, rfl⟩, g, rfl⟩ := hI
  have hne : geomCuspInertia Ω CX W ≠ ⊥ :=
    cuspInertia_fill_ne_bot Ω CX (le_refl CX.U) hcX (isHyperbolic_baseChange Ω CX) hkW hWU
  have hψ : Function.Injective ((MulAut.conj g).toMonoidHom.comp (geomToPi Ω CX hcX)) :=
    (MulAut.conj g).injective.comp (geomToPi_injective Ω CX hcX)
  have hne' : ((geomCuspInertia Ω CX W).map (geomToPi Ω CX hcX)).map
      (MulAut.conj g).toMonoidHom ≠ ⊥ := by
    rw [Subgroup.map_map, Ne, Subgroup.map_eq_bot_iff_of_injective _ hψ]
    exact hne
  intro hfin
  apply hne'
  haveI : Finite (((geomCuspInertia Ω CX W).map (geomToPi Ω CX hcX)).map
      (MulAut.conj g).toMonoidHom) := (Subgroup.finite_of_commensurable_bot hfin).to_subtype
  refine eq_bot_iff.2 fun x hx ↦ Subgroup.mem_bot.2 ?_
  have hxΔ : x ∈ (projGk Ω CX hcX).toMonoidHom.ker :=
    arithCusps_le Ω CX hcX ⟨_, ⟨W, hkW, hWU, rfl⟩, g, rfl⟩ hx
  have hfo : IsOfFinOrder x := (Subgroup.subtype _).isOfFinOrder
    (isOfFinOrder_of_finite (⟨x, hx⟩ : ((geomCuspInertia Ω CX W).map
      (geomToPi Ω CX hcX)).map (MulAut.conj g).toMonoidHom))
  have h1 := Delta_eq_one_of_isOfFinOrder Ω CX hcX (δ := ⟨x, hxΔ⟩)
    (((Subgroup.subtype_injective _).isOfFinOrder_iff
      (f := ((projGk Ω CX hcX).toMonoidHom.ker).subtype)).1 hfo)
  exact congrArg Subtype.val h1

/-- **A curve with a cusp has a cuspidal inertia group** (as `exists_mem_arithCusps`). -/
theorem exists_mem_arithCusps₂ : ∃ I, I ∈ arithCusps Ω CX hcX := by
  obtain ⟨y, hy⟩ := compl_nonempty_baseChangeOpen (k := K) (Ω := Ω) hcX
  haveI : Nonempty (⊤ : (geomCurve Ω CX).Opens) := ⟨⟨y, trivial⟩⟩
  obtain ⟨W₀, -, hW₀V, hW₀U⟩ := exists_isCentredOn_not_isCentredOn (geomData Ω CX)
    (geomCurve Ω CX) (curveEquivL Ω (transcendental_geomCoord Ω CX))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω CX)) (V := ⊤)
    (compl_finite_baseChangeOpen K Ω CX.nonempty) trivial hy
  exact ⟨_, mem_arithCusps Ω CX hcX hW₀V.1 hW₀U⟩

/-- **The trivial chain object `Π_X` has an infinite cusp image.** -/
theorem hasInfCusp_base₂ : (ChainObj.base (arithmeticExt Ω CX hcX)).HasInfCusp := by
  obtain ⟨I, hI⟩ := exists_mem_arithCusps₂ (Ω := Ω) (CX := CX) (hcX := hcX)
  refine ⟨I, hI, fun h ↦ not_commensurable_bot_of_mem_arithCusps₂ hI ?_⟩
  have e : (ChainObj.base (arithmeticExt Ω CX hcX)).image I = I := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨⟨x, trivial⟩, hx, rfl⟩
  rw [e] at h
  exact h

/-- **The first object of a chain has an infinite cusp image.** -/
theorem _root_.Belyi.Anabelian.PiChain.hasInfCusp_obj_zero₂ (c : PiChain (arithmeticExt Ω CX hcX))
    (h0 : 0 ≤ c.len) : (c.objN 0 h0).HasInfCusp := by
  obtain ⟨e, he⟩ := c.obj_zero
  have h := (ChainObj.hasInfCusp_iff_of_compat he e.injective).2 hasInfCusp_base₂
  have e0 : c.objN 0 h0 = c.obj 0 := congrArg c.obj (Fin.ext (by simp))
  rw [e0]
  exact h

end ZeroRun

/-! ### Models inside a prescribed open subgroup, and the case `r = 0` -/

section ZeroRunChain

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **A model whose image contains the kernel of a `•` and lies in a given open subgroup**: for
`φ : A ↠ B` of type `•` and an open `S ⊇ ker φ`, some geometric model `(Y, ι)` of `A` has
`ker φ ⊆ ι(Π_Y) ⊆ S` (option (Q) with `P' = (J' · U) ∩ (ker φ · W)`, `W ⊆ S` open normal,
`J' = J ∩ (ker φ · W)`). -/
theorem GeomModel.exists_range_le₂ {A B : ChainObj (arithmeticExt Ω CX hcX)}
    (D : GeomModel Ω CX hcX A)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (φ : A.grp →ₜ* B.grp) {C : Subgroup A.grp} (htf : A.InTorsionFreeNormalOpen C)
    (hker : (φ : A.grp →* B.grp).ker = A.deltaNormalClosure C) (S : Subgroup A.grp)
    (hSo : IsOpen (S : Set A.grp)) (hkerS : (φ : A.grp →* B.grp).ker ≤ S) :
    ∃ D' : GeomModel Ω CX hcX A, (φ : A.grp →* B.grp).ker ≤ (D'.ι : D'.Pi →* A.grp).range ∧
      (D'.ι : D'.Pi →* A.grp).range ≤ S := by
  obtain ⟨J, hJΔ, hCJ, hJn, hJo, hJtf⟩ := htf
  obtain ⟨W, hW⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hSo S.one_mem
  let W' : Subgroup A.grp := W.toOpenSubgroup.toSubgroup
  haveI hWn : W'.Normal := W.isNormal'
  let N' : Subgroup A.grp := (φ : A.grp →* B.grp).ker ⊔ W'
  haveI hN'n : N'.Normal := Subgroup.sup_normal _ _
  have hN'o : IsOpen (N' : Set A.grp) := Subgroup.isOpen_mono le_sup_right W.toOpenSubgroup.isOpen
  have hN'S : N' ≤ S := sup_le hkerS fun x hx ↦ hW hx
  have hCker : C ≤ (φ : A.grp →* B.grp).ker := fun c hc ↦ by
    rw [hker]
    exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨1, A.Delta.one_mem, c, hc,
      by group⟩)
  let J' : Subgroup A.grp := J ⊓ N'
  have hJ'Δ : J' ≤ A.Delta := inf_le_left.trans hJΔ
  have hCJ' : C ≤ J' := le_inf hCJ (hCker.trans le_sup_left)
  have hJ'n : ∀ d ∈ A.Delta, ∀ n ∈ J', d * n * d⁻¹ ∈ J' := fun d hd n hn ↦
    ⟨hJn d hd n hn.1, hN'n.conj_mem n hn.2 d⟩
  have hJ'o : IsOpen ((J'.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta) := by
    have e : ((J'.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta) =
        ((J.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta) ∩
          (Subtype.val ⁻¹' (N' : Set A.grp)) := by
      ext x
      simp only [SetLike.mem_coe, Subgroup.mem_subgroupOf, Set.mem_inter_iff, Set.mem_preimage]
      exact Iff.rfl
    rw [e]
    exact hJo.inter (hN'o.preimage continuous_subtype_val)
  obtain ⟨P', hP'o, hP'n, hP'J⟩ := A.exists_open_inf_Delta_eq hJ'Δ hJ'n hJ'o
  let P'' : Subgroup A.grp := P' ⊓ N'
  have hP''o : IsOpen (P'' : Set A.grp) := by
    rw [Subgroup.coe_inf]
    exact hP'o.inter hN'o
  have hP''n : A.Delta ≤ Subgroup.normalizer (P'' : Set A.grp) :=
    Belyi.Anabelian.le_normalizer_of_forall_conj_mem fun d hd n hn ↦
      ⟨(Subgroup.mem_set_normalizer_iff.1 (hP'n hd) n).1 hn.1, hN'n.conj_mem n hn.2 d⟩
  have htfP : IsTorsionFreeSubgroup (P'' ⊓ A.Delta) := fun x hx hfin ↦ by
    have hx' : x ∈ P' ⊓ A.Delta := ⟨hx.1.1, hx.2⟩
    rw [hP'J] at hx'
    exact hJtf x hx'.1 hfin
  obtain ⟨D', hD'⟩ := D.exists_enlarge hDGC P'' hP''o hP''n htfP
  have hmem : ∀ x, x ∈ (D'.ι : D'.Pi →* A.grp).range ↔ x ∈ P'' := fun x ↦ by
    rw [← SetLike.mem_coe, MonoidHom.coe_range, ← SetLike.mem_coe]
    exact Iff.of_eq (congrArg (x ∈ ·) hD')
  refine ⟨D', fun x hx ↦ (hmem x).2 ?_, fun x hx ↦ hN'S ((hmem x).1 hx).2⟩
  have hxJ' : x ∈ J' := by
    rw [hker] at hx
    exact A.deltaNormalClosure_le hJ'Δ hJ'n hJ'o hCJ' hx
  have hxP' : x ∈ P' ⊓ A.Delta := by
    rw [hP'J]
    exact hxJ'
  exact ⟨hxP'.1, hxJ'.2⟩

/-- **A `•` followed by an open embedding `Π_{V'} ↪ B` (type `⋏`) and `Π_{V'} ↪ Π_X` over `G_K`**:
if every cusp of every model of the source comes from a cusp of `Π_X`, some cuspidal inertia group
of `Π_X` has infinite image in `B`. -/
theorem _root_.Belyi.Anabelian.ElemOp.hasInfCusp_target_of_cover₂
    {A B V' : ChainObj (arithmeticExt Ω CX hcX)} (o : ElemOp A B) (ho : o.kind = .decusp)
    (D₀ : GeomModel Ω CX hcX A)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hCS : CuspSurj₂ Ω CX hcX A) (ψ : V'.grp →ₜ* B.grp) (hψinj : Function.Injective ψ)
    (hψopen : IsOpen (Set.range ψ)) (hψc : ChainObj.Compat V' B ψ)
    (emb : V'.grp →ₜ* (arithmeticExt Ω CX hcX).Pi) (hinj : Function.Injective emb)
    (hopen : IsOpen (Set.range emb))
    (hG : ∃ g, ∀ y, (arithmeticExt Ω CX hcX).pr (emb y) = g * V'.toG y * g⁻¹) :
    B.HasInfCusp := by
  by_contra hB
  match o, ho with
  | .decusp φ surj C cusp tf ker compat, _ =>
    obtain ⟨g, hg⟩ := hG
    let S : Subgroup A.grp := (ψ : V'.grp →* B.grp).range.comap (φ : A.grp →* B.grp)
    have hSo : IsOpen (S : Set A.grp) := by
      rw [Subgroup.coe_comap, MonoidHom.coe_range]
      exact hψopen.preimage φ.continuous
    have hkerS : (φ : A.grp →* B.grp).ker ≤ S := fun x hx ↦ ⟨1, by
      rw [map_one]
      exact hx.symm⟩
    obtain ⟨D, hKP, hRS⟩ := D₀.exists_range_le₂ hDGC φ tf ker S hSo hkerS
    have hf : ∀ σ, D.dcPhi φ σ ∈ Set.range ψ := fun σ ↦ hRS ⟨σ, rfl⟩
    let κ₀ : D.Pi →ₜ* V'.grp := liftInj₂ ψ hψinj (D.dcPhi φ) hf
    have hκ₀ : ∀ σ, ψ (κ₀ σ) = φ (D.ι σ) := liftInj₂_spec ψ hψinj (D.dcPhi φ) hf
    let κ : D.Pi →ₜ* π₁ᵉᵗ(basePoint Ω CX hcX ≫ baseChangeSpec K Ω Γ(CX.Xbar, CX.U)) :=
      emb.comp κ₀
    have hk1 : ∀ σ, κ σ = 1 ↔ φ (D.ι σ) = 1 := fun σ ↦ by
      rw [← hκ₀]
      constructor
      · intro h
        have h1 : κ₀ σ = 1 := hinj (h.trans (map_one emb).symm)
        rw [h1]
        exact map_one ψ
      · intro h
        have h1 : κ₀ σ = 1 := hψinj (h.trans (map_one ψ).symm)
        change emb (κ₀ σ) = 1
        rw [h1]
        exact map_one emb
    have hk2 : ∃ g' : π₁ᵉᵗ(Spec.map (CommRingCat.ofHom (algebraMap K Ω))), ∀ σ,
        projGk Ω CX hcX (κ σ) = g' * toGk A (D.ι σ) * g'⁻¹ := by
      refine ⟨g, fun σ ↦ ?_⟩
      change (arithmeticExt Ω CX hcX).pr (emb (κ₀ σ)) = _
      rw [hg, ← ChainObj.toG_apply_of_compat hψc, hκ₀, ChainObj.toG_apply_of_compat compat]
      rfl
    have hk3 : IsOpen (Set.range κ) := by
      have hR : ((κ₀ : D.Pi →* V'.grp).range : Set V'.grp) = ψ ⁻¹' (D.dcPB φ : Set B.grp) := by
        refine Set.ext fun y ↦ ⟨?_, ?_⟩
        · rintro ⟨σ, rfl⟩
          exact ⟨D.ι σ, ⟨σ, rfl⟩, (hκ₀ σ).symm⟩
        · rintro ⟨_, ⟨σ, rfl⟩, hσ⟩
          exact ⟨σ, hψinj ((hκ₀ σ).trans hσ)⟩
      have hRo : IsOpen ((κ₀ : D.Pi →* V'.grp).range : Set V'.grp) := by
        rw [hR]
        exact (D.isOpen_dcPB φ surj).preimage ψ.continuous
      have h1 := isOpen_map_of_isOpen_range emb hopen hRo
      have e : Set.range κ =
          SetLike.coe (Subgroup.map (emb : V'.grp →* (arithmeticExt Ω CX hcX).Pi)
            (κ₀ : D.Pi →* V'.grp).range) := by
        refine Set.ext fun x ↦ ⟨?_, ?_⟩
        · rintro ⟨σ, rfl⟩
          exact ⟨κ₀ σ, ⟨σ, rfl⟩, rfl⟩
        · rintro ⟨_, ⟨σ, rfl⟩, rfl⟩
          exact ⟨σ, rfl⟩
      rw [e]
      exact h1
    exact D.false_of_le_dcN₂ φ κ hk1 hk2 hDGC cusp tf ker hKP
      (fun J hJ ↦ D.le_dcN_of_not_hasInfCusp₂ φ κ hk1 hk2 compat hB (hCS D) hJ) hk3
  | .cover .., h => exact absurd h (by simp [ElemOp.kind])
  | .quot .., h => exact absurd h (by simp [ElemOp.kind])
  | .deorb .., h => exact absurd h (by simp [ElemOp.kind])

/-- **The `⋏` after the first run, when `r = 0`**: `Π_{V'} ⊆ B` has an infinite cusp image. -/
theorem _root_.Belyi.Anabelian.ElemOp.hasInfCusp_of_decusp_cover₂
    {A B V' : ChainObj (arithmeticExt Ω CX hcX)} (o : ElemOp A B) (ho : o.kind = .decusp)
    (o' : ElemOp B V') (ho' : o'.kind = .cover)
    (D₀ : GeomModel Ω CX hcX A)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hCS : CuspSurj₂ Ω CX hcX A) (emb : V'.grp →ₜ* (arithmeticExt Ω CX hcX).Pi)
    (hinj : Function.Injective emb) (hopen : IsOpen (Set.range emb))
    (hG : ∃ g, ∀ y, (arithmeticExt Ω CX hcX).pr (emb y) = g * V'.toG y * g⁻¹) :
    V'.HasInfCusp := by
  match o', ho' with
  | .cover ψ inj op compat, _ =>
    exact (ChainObj.hasInfCusp_iff_of_compat compat inj).2
      (o.hasInfCusp_target_of_cover₂ ho D₀ hDGC hCS ψ inj op compat emb hinj hopen hG)
  | .quot .., h => exact absurd h (by simp [ElemOp.kind])
  | .decusp .., h => exact absurd h (by simp [ElemOp.kind])
  | .deorb .., h => exact absurd h (by simp [ElemOp.kind])

end ZeroRunChain

/-! ### `Π_V` has an infinite cusp image -/

section Main

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **All objects up to the source of a `•` have an infinite cusp image** (in a chain without `⊚`
up to there). -/
theorem _root_.Belyi.Anabelian.PiChain.hasInfCusp_le_of_decusp₂ {E : CuspidalExt.{u + 1}}
    (c : PiChain E) (k : ℕ) (hk : k < c.len) (hkind : (c.opN k hk).kind = .decusp)
    (hnd : ∀ j (hj : j < k), (c.opN j (by omega)).kind ≠ .deorb) (j : ℕ) (hj : j ≤ k) :
    (c.objN j (by omega)).HasInfCusp := by
  have htop := (c.opN k hk).hasInfCusp_of_decusp₂ hkind
  have down : ∀ n i (hi : i ≤ c.len), i + n = k → (c.objN i hi).HasInfCusp := by
    intro n
    induction n with
    | zero =>
      intro i hi hin
      exact (c.objN_congr_iff ChainObj.HasInfCusp (by omega) _ _).2 htop
    | succ n ih =>
      intro i hi hin
      exact (c.opN i (by omega)).hasInfCusp_source (hnd i (by omega))
        (ih (i + 1) (by omega) (by omega))
  exact down (k - j) j _ (by omega)

variable {c : PiChain (arithmeticExt Ω CX hcX)} {l : ℕ}

/-- **`Π_V` has an infinite cusp image for Belyi-type chains `⋏, ⋎, ⋏, ⋎`** (`l = r = 0`):
`Π_V` is linked to `Π₀ ≅ Π_X` by open embeddings compatible with the rigidifying homomorphisms,
and the cuspidal inertia groups of `Π_X` are infinite. -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.hasInfCusp_V_zero_zero₂
    (hc : c.IsBelyiType 0 0) :
    (c.objN (0 + 0 + 3) (by have := hc.len_eq; omega)).HasInfCusp := by
  have hlen := hc.len_eq
  have h0 := c.hasInfCusp_obj_zero₂ (Nat.zero_le _)
  have h1 := (c.opN 0 (by omega)).hasInfCusp_target (Or.inl hc.2.1) h0
  have h2 := (c.opN 1 (by omega)).hasInfCusp_target (Or.inr hc.2.2.1) h1
  exact (c.opN 2 (by omega)).hasInfCusp_target (Or.inl hc.2.2.2.2.1) h2

/-- **`Π_V` has an infinite cusp image when the final run is empty** (`r = 0`, `l ≥ 1`), provided
every cusp of every geometric model of the source `Π_{l+1}` of the last `•` comes from a cusp of
`Π_X`. -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.hasInfCusp_V_zero₂ (hc : c.IsBelyiType l 0)
    (t : c.TerminalIso (PiChain.trivial _))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k) (hl : 0 < l)
    (hCS : CuspSurj₂ Ω CX hcX (c.objN (l + 1) (by have := hc.len_eq; omega))) :
    (c.objN (l + 0 + 3) (by have := hc.len_eq; omega)).HasInfCusp := by
  have hlen := hc.len_eq
  have hkind : (c.opN (l + 1) (by omega)).kind = .decusp := by
    rw [c.kind_opN_congr (b := 2 + (l - 1)) (by omega) _ (by omega)]
    exact hc.2.2.2.1 (l - 1) (by omega)
  obtain ⟨D₀⟩ := c.nonempty_geomModel_le₂ hDGC (l + 1) (by omega)
    (fun j _ ↦ hc.kind_ne_deorb j (by omega))
    (fun j hj ↦ c.hasInfCusp_le_of_decusp₂ (l + 1) (by omega) hkind
      (fun j' _ ↦ hc.kind_ne_deorb j' (by omega)) j hj)
  exact (c.opN (l + 1) (by omega)).hasInfCusp_of_decusp_cover₂ hkind (c.opN (l + 2) (by omega))
    hc.2.2.2.2.1 D₀ hDGC hCS (PiChain.belyiEmb hc t) (PiChain.belyiEmb_injective hc t)
    (PiChain.isOpen_range_belyiEmb hc t) (PiChain.exists_pr_belyiEmb hc t)

/-- In a Belyi-type chain with `r = 0`, `l ≥ 1`, the objects up to the source `Π_{l+1}` of the
last `•` have an infinite cusp image. -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.hasInfCusp_le_zero₂ (hc : c.IsBelyiType l 0)
    (hl : 0 < l) (j : ℕ) (hj : j ≤ l + 1) :
    (c.objN j (by have := hc.len_eq; omega)).HasInfCusp := by
  have hlen := hc.len_eq
  have hkind : (c.opN (l + 1) (by omega)).kind = .decusp := by
    rw [c.kind_opN_congr (b := 2 + (l - 1)) (by omega) _ (by omega)]
    exact hc.2.2.2.1 (l - 1) (by omega)
  exact c.hasInfCusp_le_of_decusp₂ (l + 1) (by omega) hkind
    (fun j' _ ↦ hc.kind_ne_deorb j' (by omega)) j hj

/-- **`Π_V` of a Belyi-type chain with a terminal isomorphism has an infinite cusp image**
(the hypothesis `hV` of `PiChain.IsBelyiType.nonempty_geomModel`, `exists_candidate_fill`,
`exists_cover_fill`), assuming the rel-isom-DGC over number fields and that every cusp of every
geometric model of the source of the last `•` comes from a cusp of `Π_X` (`CuspSurj₂`, required
for the objects all of whose predecessors have an infinite cusp image). -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.hasInfCusp_V₂ {r : ℕ}
    (hc : c.IsBelyiType l r) (t : c.TerminalIso (PiChain.trivial _))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hCS : ∀ j (hj : j ≤ c.len), (∀ i (hi : i ≤ j), (c.objN i (by omega)).HasInfCusp) →
      CuspSurj₂ Ω CX hcX (c.objN j hj)) :
    (c.objN (l + r + 3) (by have := hc.len_eq; omega)).HasInfCusp := by
  have hlen := hc.len_eq
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · rcases Nat.eq_zero_or_pos l with rfl | hl
    · exact hc.hasInfCusp_V_zero_zero₂
    · exact hc.hasInfCusp_V_zero₂ t hDGC hl
        (hCS _ _ fun i hi ↦ hc.hasInfCusp_le_zero₂ hl i hi)
  · exact hc.hasInfCusp_V_of_cuspSurj₂ hr t hDGC
      (hCS _ _ fun i hi ↦ hc.hasInfCusp_le₂ hr i hi)

end Main

/-! ### Cusp bookkeeping along the model constructions -/

section CuspBook

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **Model independence of cusps** (the remaining input): every cuspidal inertia group of the
second model is, inside `A`, commensurable with one of the first model. -/
def CuspCompat₂ {A : ChainObj (arithmeticExt Ω CX hcX)} (D₁ D₂ : GeomModel Ω CX hcX A) : Prop :=
  ∀ J₂ ∈ arithCusps Ω D₂.Y D₂.hY, ∃ J₁ ∈ arithCusps Ω D₁.Y D₁.hY,
    (J₂.map (D₂.ι : D₂.Pi →* A.grp)).Commensurable (J₁.map (D₁.ι : D₁.Pi →* A.grp))

/-- `ModelCS₂` is transported along `CuspCompat₂`. -/
theorem modelCS_of_cuspCompat₂ {A : ChainObj (arithmeticExt Ω CX hcX)}
    {D₁ D₂ : GeomModel Ω CX hcX A} (h₁ : ModelCS₂ D₁) (h : CuspCompat₂ D₁ D₂) : ModelCS₂ D₂ := by
  intro J₂ hJ₂
  obtain ⟨J₁, hJ₁, hJJ⟩ := h J₂ hJ₂
  obtain ⟨I, hI, hIJ⟩ := h₁ J₁ hJ₁
  refine ⟨I, hI, ?_⟩
  have hR₁ := D₁.index_range_ne_zero
  have hR₂ := D₂.index_range_ne_zero
  -- `ι₁(J₁) ∼ ρ_A(I)`
  have h1 : (J₁.map (D₁.ι : D₁.Pi →* A.grp)).Commensurable (A.image I) := by
    have := hIJ.symm.map' (D₁.ι : D₁.Pi →* A.grp)
    rw [Subgroup.map_comap_eq] at this
    exact this.trans (Subgroup.commensurable_inf_of_index_ne_zero hR₁ _)
  have h2 : (J₂.map (D₂.ι : D₂.Pi →* A.grp)).Commensurable (A.image I) := hJJ.trans h1
  have h3 := (Subgroup.commensurable_comap_iff hR₂).2 h2
  rw [Subgroup.comap_map_eq_self_of_injective (f := (D₂.ι : D₂.Pi →* A.grp)) D₂.inj] at h3
  exact h3.symm

/-- **The base model `X` has only cusps of `Π_X`.** -/
theorem modelCS_base₂ : ModelCS₂ (GeomModel.base Ω CX hcX) := by
  intro J hJ
  refine ⟨J, hJ, ?_⟩
  have e : ((ChainObj.base (arithmeticExt Ω CX hcX)).image J).comap
      ((GeomModel.base Ω CX hcX).ι : (GeomModel.base Ω CX hcX).Pi →*
        (ChainObj.base (arithmeticExt Ω CX hcX)).grp) = J := by
    ext x
    constructor
    · rintro ⟨y, hy, hyx⟩
      have hyx' : (y : (arithmeticExt Ω CX hcX).Pi) = x := hyx
      rw [← hyx']
      exact hy
    · intro hx
      exact ⟨⟨x, trivial⟩, hx, rfl⟩
  rw [e]

variable {A B : ChainObj (arithmeticExt Ω CX hcX)} (D : GeomModel Ω CX hcX A)

/-- **`ModelCS₂` along `GeomModel.map`** (`ι' = φ ∘ ι`, `φ : A ↪ B`). -/
theorem modelCS_map₂ (φ : A.grp →ₜ* B.grp) (hinj : Function.Injective φ)
    (hφ : IsOpen (Set.range φ)) (hG : ∀ a, B.toG (φ a) = A.toG a)
    (hN : B.Delta ≤ Subgroup.normalizer (Set.range (φ ∘ D.ι)))
    (hI : ∀ I ∈ (arithmeticExt Ω CX hcX).cusps,
      (B.image I).Commensurable ((A.image I).map (φ : A.grp →* B.grp)))
    (h : ModelCS₂ D) : ModelCS₂ (D.map φ hinj hφ hG hN hI) := by
  intro J hJ
  obtain ⟨I, hI', hIJ⟩ := h J hJ
  refine ⟨I, hI', ?_⟩
  have h1 : ((B.image I).comap ((φ : A.grp →* B.grp).comp (D.ι : D.Pi →* A.grp))).Commensurable
      ((A.image I).comap (D.ι : D.Pi →* A.grp)) := by
    have := ((hI I hI').comap' (φ : A.grp →* B.grp)).comap' (D.ι : D.Pi →* A.grp)
    rwa [Subgroup.comap_map_eq_self_of_injective (f := (φ : A.grp →* B.grp)) hinj,
      Subgroup.comap_comap] at this
  exact h1.trans hIJ

/-- **`ModelCS₂` along `GeomModel.comap`** (`φ ∘ ι' = ι`, `φ : B ↪ A`). -/
theorem modelCS_comap₂ (φ : B.grp →ₜ* A.grp) (hinj : Function.Injective φ)
    (hle : Set.range D.ι ⊆ Set.range φ) (hG : ∀ b, A.toG (φ b) = B.toG b)
    (hN : B.Delta ≤ Subgroup.normalizer (φ ⁻¹' Set.range D.ι))
    (hI : ∀ I ∈ (arithmeticExt Ω CX hcX).cusps,
      (A.image I).Commensurable ((B.image I).map (φ : B.grp →* A.grp)))
    (h : ModelCS₂ D) : ModelCS₂ (D.comap φ hinj hle hG hN hI) := by
  intro J hJ
  obtain ⟨I, hI', hIJ⟩ := h J hJ
  refine ⟨I, hI', ?_⟩
  have e1 : (D.ι : D.Pi →* A.grp) =
      (φ : B.grp →* A.grp).comp (D.comapι φ hinj hle : D.Pi →* B.grp) :=
    MonoidHom.ext fun σ ↦ (D.φ_comapι φ hinj hle σ).symm
  have h1 : ((B.image I).comap (D.comapι φ hinj hle : D.Pi →* B.grp)).Commensurable
      ((A.image I).comap (D.ι : D.Pi →* A.grp)) := by
    have := ((hI I hI').comap' (φ : B.grp →* A.grp)).comap' (D.comapι φ hinj hle : D.Pi →* B.grp)
    rw [Subgroup.comap_map_eq_self_of_injective (f := (φ : B.grp →* A.grp)) hinj,
      Subgroup.comap_comap, ← e1] at this
    exact this.symm
  exact h1.trans hIJ

/-- **`ModelCS₂` along `GeomModel.decusp`**: every cusp of the filled curve is the image of a cusp
of `Y` (`exists_map_eq_of_conjInduced_fill`), and `ι_B⁻¹(φ(S)) = fill(ι⁻¹(S))`. -/
theorem modelCS_decusp₂ (φ : A.grp →ₜ* B.grp) (hsurj : Function.Surjective φ)
    (hcompat : ChainObj.Compat A B φ)
    (hKP : (φ : A.grp →* B.grp).ker ≤ (D.ι : D.Pi →* A.grp).range)
    {U' : D.Y.Xbar.Opens} (h : D.Y.U ≤ U') (hc' : (U' : Set D.Y.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral D.M D.Y.Xbar
      2 < 2 * Anabelian.curveGenus D.M D.Y.Xbar + cuspDegree D.M D.Y.Xbar U')
    (hkerf : (fillMap Ω D.Y D.hY h).toMonoidHom.ker = D.dcN φ) (hCS : ModelCS₂ D) :
    ModelCS₂ (D.decusp φ hsurj hcompat hKP h hc' hyp hkerf) := by
  intro J' hJ'
  haveI : Nonempty (baseChangeOpen D.M Ω U') :=
    (nonempty_baseChangeOpen D.M Ω (D.Y.nonempty.mono h)).to_subtype
  obtain ⟨J, hJ, rfl⟩ := exists_map_eq_of_conjInduced_fill Ω D.Y D.hY h hc' hyp
    (D.dcFill h hc' hyp : D.Pi →* D.dcPi h hc' hyp)
    (isConjInduced_fillPiHom Ω D.Y D.hY h hc' hyp) hJ'
  obtain ⟨I, hI, hIJ⟩ := hCS J hJ
  refine ⟨I, hI, ?_⟩
  have h1 := (hcompat.image_commensurable I).comap'
    (D.dcIota φ h hc' hyp hkerf : D.dcPi h hc' hyp →* B.grp)
  rw [D.comap_dcIota_map φ hKP h hc' hyp hkerf] at h1
  exact h1.trans (hIJ.map' (D.dcFill h hc' hyp : D.Pi →* D.dcPi h hc' hyp))

end CuspBook

/-! ### Reduction of `CuspSurj₂` to the model independence of cusps -/

section Reduction

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty}

attribute [local instance] isAlgClosure_of_isAlgebraic

variable (Ω CX hcX) in
/-- **Model independence of cusps** for all chain objects of `Π_X ↠ G_K`: any two geometric
models of the same chain object have the same cuspidal inertia groups up to commensurability
(inside the chain object). This is the remaining input of `PiChain.IsBelyiType.hasInfCusp_V₃`;
it is expected to follow from the rel-isom-DGC applied to the covers of the two models attached
to the common open subgroup `ι₁(Π_{Y₁}) ∩ ι₂(Π_{Y₂})`. -/
def ModelCuspIndep₂ : Prop :=
  ∀ (A : ChainObj (arithmeticExt Ω CX hcX)) (D₁ D₂ : GeomModel Ω CX hcX A), CuspCompat₂ D₁ D₂

variable {A B : ChainObj (arithmeticExt Ω CX hcX)}

/-- `ModelCS₂` along `GeomModel.ofCover`, given model independence of cusps. -/
theorem modelCS_ofCover₂ (hMI : ModelCuspIndep₂ Ω CX hcX) (D : GeomModel Ω CX hcX A)
    (φ : B.grp →ₜ* A.grp) (hinj : Function.Injective φ) (hφ : IsOpen (Set.range φ))
    (hC : ChainObj.Compat B A φ) (h : ModelCS₂ D) : ModelCS₂ (D.ofCover φ hinj hφ hC) := by
  unfold GeomModel.ofCover
  exact modelCS_comap₂ _ _ _ _ _ _ _ (modelCS_of_cuspCompat₂ h (hMI _ _ _))

/-- `ModelCS₂` along `GeomModel.ofQuot`, given model independence of cusps. -/
theorem modelCS_ofQuot₂ (hMI : ModelCuspIndep₂ Ω CX hcX) (D : GeomModel Ω CX hcX A)
    (φ : A.grp →ₜ* B.grp) (hinj : Function.Injective φ) (hφ : IsOpen (Set.range φ))
    (hC : ChainObj.Compat A B φ) (h : ModelCS₂ D) : ModelCS₂ (D.ofQuot φ hinj hφ hC) := by
  unfold GeomModel.ofQuot
  exact modelCS_map₂ _ _ _ _ _ _ _ (modelCS_of_cuspCompat₂ h (hMI _ _ _))

/-- **A model with only cusps of `Π_X` across an elementary operation other than `⊚`** (given
model independence of cusps; for `•` the target must have an infinite cusp image). -/
theorem exists_modelCS_of_elemOp₂ (hMI : ModelCuspIndep₂ Ω CX hcX) (o : ElemOp A B)
    (D : GeomModel Ω CX hcX A) (hD : ModelCS₂ D)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k) (ho : o.kind ≠ .deorb)
    (hB : B.HasInfCusp) : ∃ D' : GeomModel Ω CX hcX B, ModelCS₂ D' := by
  match o, ho with
  | .cover φ inj op compat, _ => exact ⟨_, modelCS_ofCover₂ hMI D φ inj op compat hD⟩
  | .quot φ inj op compat, _ => exact ⟨_, modelCS_ofQuot₂ hMI D φ inj op compat hD⟩
  | .decusp φ surj C cusp tf ker compat, _ =>
    obtain ⟨J, hJΔ, hCJ, hJn, hJo, hJtf⟩ := id tf
    obtain ⟨P', hP'o, hP'n, hP'J⟩ := A.exists_open_inf_Delta_eq hJΔ hJn hJo
    have htfP : IsTorsionFreeSubgroup (P' ⊓ A.Delta) := by
      rw [hP'J]
      exact hJtf
    obtain ⟨D', hD'⟩ := D.exists_enlarge hDGC P' hP'o hP'n htfP
    have hJr : J ≤ (D'.ι : D'.Pi →* A.grp).range := fun x hx ↦ by
      have hx' : x ∈ (P' : Set A.grp) := (hP'J ▸ inf_le_left : J ≤ P') hx
      rw [← hD'] at hx'
      obtain ⟨σ, rfl⟩ := hx'
      exact ⟨σ, rfl⟩
    have hKP : (φ : A.grp →* B.grp).ker ≤ (D'.ι : D'.Pi →* A.grp).range :=
      fun x hx ↦ hJr ((ker ▸ A.deltaNormalClosure_le hJΔ hJn hJo hCJ) hx)
    obtain ⟨U', h, hc', hyp, hkerf⟩ := D'.exists_fill_of_decusp hDGC φ surj cusp tf ker compat
      hB hJΔ hCJ hJn hJo hJr
    exact ⟨_, modelCS_decusp₂ D' φ surj compat hKP h hc' hyp hkerf
      (modelCS_of_cuspCompat₂ hD (hMI _ D D'))⟩
  | .deorb .., h => exact absurd rfl h

/-- **Models with only cusps of `Π_X` of the objects `Π₀, …, Πₙ` of a chain** (no `⊚` up to `n`,
all objects up to `n` with an infinite cusp image), given model independence of cusps. -/
theorem _root_.Belyi.Anabelian.PiChain.exists_modelCS_le₂ (hMI : ModelCuspIndep₂ Ω CX hcX)
    (c : PiChain (arithmeticExt Ω CX hcX))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k) :
    ∀ (n : ℕ) (hn : n ≤ c.len), (∀ j (hj : j < n), (c.opN j (by omega)).kind ≠ .deorb) →
      (∀ j (hj : j ≤ n), (c.objN j (by omega)).HasInfCusp) →
      ∃ D : GeomModel Ω CX hcX (c.objN n hn), ModelCS₂ D
  | 0, hn, _, _ => by
    obtain ⟨e, he⟩ := c.obj_zero
    have h0 : ∃ D : GeomModel Ω CX hcX (c.obj 0), ModelCS₂ D :=
      ⟨_, modelCS_ofCover₂ hMI (GeomModel.base Ω CX hcX)
        (ContinuousMonoidHom.toContinuousMonoidHom e) e.injective (by
          convert isOpen_univ
          exact Set.eq_univ_of_forall fun x ↦ ⟨e.symm x, e.apply_symm_apply x⟩) he
        modelCS_base₂⟩
    have e0 : c.objN 0 hn = c.obj 0 := congrArg c.obj (Fin.ext (by simp))
    rw [e0]
    exact h0
  | n + 1, hn, hk, hinf => by
    obtain ⟨D, hD⟩ := c.exists_modelCS_le₂ hMI hDGC n (by omega) (fun j hj ↦ hk j (by omega))
      (fun j hj ↦ hinf j (by omega))
    exact exists_modelCS_of_elemOp₂ hMI (c.opN n (by omega)) D hD hDGC (hk n (by omega))
      (hinf (n + 1) le_rfl)

/-- **`CuspSurj₂` for the objects of a chain** (no `⊚` up to `n`, all objects up to `n` with an
infinite cusp image), given model independence of cusps. -/
theorem _root_.Belyi.Anabelian.PiChain.cuspSurj_le₂ (hMI : ModelCuspIndep₂ Ω CX hcX)
    (c : PiChain (arithmeticExt Ω CX hcX))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k) (n : ℕ) (hn : n ≤ c.len)
    (hk : ∀ j (hj : j < n), (c.opN j (by omega)).kind ≠ .deorb)
    (hinf : ∀ j (hj : j ≤ n), (c.objN j (by omega)).HasInfCusp) :
    CuspSurj₂ Ω CX hcX (c.objN n hn) := by
  obtain ⟨D, hD⟩ := c.exists_modelCS_le₂ hMI hDGC n hn hk hinf
  exact fun D' ↦ modelCS_of_cuspCompat₂ hD (hMI _ D D')

variable {c : PiChain (arithmeticExt Ω CX hcX)} {l r : ℕ}

/-- **`Π_V` of a Belyi-type chain with a terminal isomorphism has an infinite cusp image**
(discharging `hV`), assuming the rel-isom-DGC over number fields and the model independence of
cusps (`ModelCuspIndep₂`). -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.hasInfCusp_V₃ (hc : c.IsBelyiType l r)
    (t : c.TerminalIso (PiChain.trivial _))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hMI : ModelCuspIndep₂ Ω CX hcX) :
    (c.objN (l + r + 3) (by have := hc.len_eq; omega)).HasInfCusp :=
  hc.hasInfCusp_V₂ t hDGC fun j hj hinf ↦
    c.cuspSurj_le₂ hMI hDGC j hj (fun i hi ↦ hc.kind_ne_deorb i (by omega)) hinf

/-- **Geometric models of all objects of a Belyi-type chain with a terminal isomorphism**, without
the hypothesis `hV` (given the model independence of cusps). -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.nonempty_geomModel₂ (hc : c.IsBelyiType l r)
    (t : c.TerminalIso (PiChain.trivial _))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hMI : ModelCuspIndep₂ Ω CX hcX) (j : Fin (c.len + 1)) :
    Nonempty (GeomModel Ω CX hcX (c.obj j)) :=
  hc.nonempty_geomModel hDGC (hc.hasInfCusp_V₃ t hDGC hMI) j

/-- **Full models of the objects of the final run**, without the hypothesis `hV` (given the model
independence of cusps). -/
theorem _root_.Belyi.Anabelian.PiChain.IsBelyiType.exists_full_geomModel₂
    (hc : c.IsBelyiType l r) (t : c.TerminalIso (PiChain.trivial _))
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (hMI : ModelCuspIndep₂ Ω CX hcX) (k : ℕ) (hk1 : l + 3 ≤ k) (hk2 : k ≤ l + r + 3) :
    ∃ D : GeomModel Ω CX hcX (c.objN k (by have := hc.len_eq; omega)),
      Function.Surjective D.ι :=
  hc.exists_full_geomModel t hDGC (hc.hasInfCusp_V₃ t hDGC hMI) k hk1 hk2

end Reduction

end CurvesJacobian.Cusp
