import CurvesJacobian.Cusp.InertiaEtale
import Pi1.FundamentalGroup.GenericPoint

/-!
# Galois inertia at the cusps of `ℙ¹ ∖ {0, 1, ∞}` and unramified branches

Let `U = Spec k[t, 1/(t(t-1))] = ℙ¹ ∖ {0, 1, ∞}` (`CurvesJacobian.Cusp.lineRing`), `k`
algebraically closed of characteristic `0`, `Ω` a separably closed Galois extension of
`k(t) = K₀ k t`, and `η : Spec Ω ⟶ Spec k(t) ⟶ U` the geometric generic point
(`CurvesJacobian.Cusp.lineGen`). `Gal(Ω / k(t))` acts on `π₁ᵉᵗ(U, η)`
(`CurvesJacobian.Cusp.lineGalois`, pi1's `FiniteEtale.galoisAction`), and for a place `W ⊇ k` of
`Ω` the **inertia group of `W` in `π₁ᵉᵗ(U, η)`** is the closed subgroup generated by the images
of the inertia elements (`CurvesJacobian.Cusp.lineInertia`).

The cusps `0, 1, ∞` are indexed by `j : Fin 3`, with local coordinates `t`, `t - 1` and
`2 / (2t - 1)` (`CurvesJacobian.Cusp.cuspCoord`). A **branch at the cusp `j`** of a finite étale
`Y ⟶ U` (`CurvesJacobian.Cusp.CuspBranch`) is: an algebra `A` of finite type, étale over `k[s]`
for an element `s ∈ A`, a `k`-point `ε` of `A` with `ε(s) = 0`, and a morphism
`Spec A[1/s] ⟶ Y` over `U`, where `t` corresponds to `s`, `1 + s`, resp. `1/2 + 1/s`
(`CurvesJacobian.Cusp.CuspRel`). Over `ℂ`, a branch is an unramified point of the
compactification of `Y` over the cusp, and the circle around the cusp lifts to a closed loop.

**Main result** (`CurvesJacobian.Cusp.nonempty_cuspBranch_of_fixed`): if the inertia group of a
place `W` over the cusp `j` fixes a point of the fibre of `Y` at `η`, then `Y` has a branch at
`j`. The point is a map `φ : Γ(Y) → Ω` fixed by `I_W`; the field `N` it generates is fixed by
`I_W`, so the normalization of `k[u]` (`u` the local coordinate) in `N` is étale over `k[u]` near
the centre of `W` (`CurvesJacobian.Cusp.exists_etale_away_of_inertia_le`), and `φ(Γ(Y))` lies in
its localization at `u` and a function not vanishing at the centre (`Γ(Y)` is integral over `U`).
-/

open CategoryTheory AlgebraicGeometry Polynomial AffOrbicurve IntermediateField
open IntermediateField.algebraAdjoinAdjoin

universe u

noncomputable section

namespace CurvesJacobian.Cusp

/-! ### The line `ℙ¹ ∖ {0, 1, ∞}` -/

section Line

variable (k : Type u) [Field k]

/-- The coordinate ring `k[t, 1/(t(t-1))]` of `ℙ¹ ∖ {0, 1, ∞}`. -/
abbrev lineRing : Type u := Localization.Away (X * (X - 1) : k[X])

/-- The coordinate `t ∈ k[t, 1/(t(t-1))]`. -/
def lineT : lineRing k := algebraMap k[X] (lineRing k) X

variable {k} {F : Type u} [CommRing F] [Algebra k F]

/-- `k[t, 1/(t(t-1))] → F`, `t ↦ a`, for `a (a - 1)` a unit. -/
def lineLift (a : F) (ha : IsUnit (a * (a - 1))) : lineRing k →ₐ[k] F :=
  IsLocalization.Away.liftAlgHom (X * (X - 1) : k[X]) (f := aeval a) (by simpa using ha)

@[simp]
lemma lineLift_lineT (a : F) (ha : IsUnit (a * (a - 1))) : lineLift a ha (lineT k) = a := by
  simp [lineLift, lineT]

/-- `k`-algebra maps out of `k[t, 1/(t(t-1))]` are determined by the image of `t`. -/
lemma lineRing_algHom_ext {f g : lineRing k →ₐ[k] F} (h : f (lineT k) = g (lineT k)) : f = g := by
  refine AlgHom.coe_ringHom_injective (IsLocalization.ringHom_ext
    (Submonoid.powers (X * (X - 1) : k[X])) (Polynomial.ringHom_ext (fun c ↦ ?_) ?_))
  · simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe]
    change f (algebraMap k[X] _ (algebraMap k k[X] c)) = g (algebraMap k[X] _ (algebraMap k k[X] c))
    rw [← IsScalarTower.algebraMap_apply k k[X] (lineRing k), AlgHom.commutes, AlgHom.commutes]
  · exact h

omit [Algebra k F] in
/-- Ring maps out of `k[t, 1/(t(t-1))]` are determined by `k` and the image of `t`. -/
lemma lineRing_ringHom_ext {f g : lineRing k →+* F}
    (hC : ∀ c : k, f (algebraMap k _ c) = g (algebraMap k _ c))
    (h : f (lineT k) = g (lineT k)) : f = g := by
  refine IsLocalization.ringHom_ext (Submonoid.powers (X * (X - 1) : k[X]))
    (Polynomial.ringHom_ext (fun c ↦ ?_) ?_)
  · simp only [RingHom.coe_comp, Function.comp_apply]
    change f (algebraMap k[X] _ (algebraMap k k[X] c)) = g (algebraMap k[X] _ (algebraMap k k[X] c))
    rw [← IsScalarTower.algebraMap_apply k k[X] (lineRing k)]
    exact hC c
  · exact h

end Line

/-! ### The cusps and their local coordinates -/

section Cusp

variable {K : Type u} [Field K]

/-- The relation between the coordinate `T` of `ℙ¹ ∖ {0, 1, ∞}` and a local coordinate `s` at
the cusp `j`: `T = s` at `0`, `T = 1 + s` at `1`, `T = 1/2 + 1/s` (i.e. `2Ts = s + 2`) at `∞`. -/
def CuspRel {A : Type*} [CommRing A] (j : Fin 3) (T s : A) : Prop :=
  ![T = s, T = 1 + s, 2 * T * s = s + 2] j

/-- `K[X] → A` étale implies `K[X₀] → A` (`MvPolynomial (Fin 1)`) étale, `X₀ ↦ s`. -/
lemma etale_mvAeval_of_etale_aeval {A : Type u} [CommRing A] [Algebra K A] {s : A}
    (h : (aeval (R := K) s).toRingHom.Etale) :
    (MvPolynomial.aeval (R := K) fun _ : Fin 1 ↦ s).toRingHom.Etale := by
  let e := MvPolynomial.uniqueAlgEquiv K (Fin 1)
  have he : (MvPolynomial.aeval (R := K) fun _ : Fin 1 ↦ s) = (aeval s).comp e.toAlgHom :=
    MvPolynomial.algHom_ext fun i ↦ by simp [e]
  have h' := RingHom.Etale.stableUnderComposition e.toAlgHom.toRingHom (aeval (R := K) s).toRingHom
    (RingHom.Etale.of_bijective e.bijective) h
  rw [he]
  exact h'

/-- **A branch at the cusp `j`** of `q : Y ⟶ Spec R`, `T ∈ R` the coordinate: a finite type
`K`-algebra `A`, étale over `K[s]`, with a `K`-point `ε` at `s = 0`, and a morphism
`m : Spec A[1/s] ⟶ Y` over `Spec R`, where `R ⟶ A[1/s]` sends `T` to the expression of
`CuspRel j` in `s`. -/
structure CuspBranch (K : Type u) [Field K] {R : Type u} [CommRing R] [Algebra K R] (T : R)
    {Y : Scheme.{u}} (q : Y ⟶ Spec (.of R)) (j : Fin 3) : Type (u + 1) where
  /-- The étale neighbourhood of the point over the cusp. -/
  A : Type u
  [commRing : CommRing A]
  [algebra : Algebra K A]
  [finiteType : Algebra.FiniteType K A]
  /-- The local coordinate. -/
  s : A
  etale : (MvPolynomial.aeval (R := K) fun _ : Fin 1 ↦ s).toRingHom.Etale
  /-- The point over the cusp. -/
  pt : A →ₐ[K] K
  pt_s : pt s = 0
  /-- `R → A[1/s]`. -/
  θ : R →ₐ[K] Localization.Away s
  rel : CuspRel j (θ T) (algebraMap A (Localization.Away s) s)
  /-- The branch, a morphism to `Y` over `Spec R`. -/
  m : Spec (.of (Localization.Away s)) ⟶ Y
  hm : m ≫ q = Spec.map (CommRingCat.ofHom θ.toRingHom)

attribute [instance] CuspBranch.commRing CuspBranch.algebra CuspBranch.finiteType

variable {K : Type u} [Field K] [CharZero K]

/-- The polynomial `G = (X - 1)(X + 1)(X + 2)(X - 2)`, whose zeros (besides `s = 0`) are removed
near every cusp so that `t`, `1/t`, `1/(t-1)` become regular in the local coordinate `s`. -/
def cuspPoly : K[X] := (X - 1) * (X + 1) * (X + 2) * (X - 2)

lemma cuspPoly_eval_zero : (cuspPoly (K := K)).eval 0 ≠ 0 := by
  simp [cuspPoly]

/-- The localization `K[s, 1/(s G(s))]`. -/
abbrev cuspLocal (K : Type u) [Field K] [CharZero K] : Type u :=
  Localization.Away (X * cuspPoly (K := K))

/-- Divisors of `X G` are units in `K[s, 1/(s G(s))]`. -/
lemma isUnit_cuspLocal_of_dvd {p : K[X]} (h : p ∣ X * cuspPoly) :
    IsUnit (algebraMap K[X] (cuspLocal K) p) :=
  isUnit_of_dvd_unit (map_dvd _ h) (IsLocalization.Away.algebraMap_isUnit _)

/-- The image `e_j` of `t` in `K[s, 1/(s G(s))]`: `s`, `1 + s`, `(s + 2)/(2s)`. -/
def cuspT (j : Fin 3) : cuspLocal K :=
  ![algebraMap K[X] _ X, algebraMap K[X] _ (1 + X),
    algebraMap K[X] _ (C 2⁻¹ * (X + 2) * cuspPoly) *
      IsLocalization.Away.invSelf (X * cuspPoly (K := K))] j

lemma isUnit_cuspT (j : Fin 3) : IsUnit (cuspT (K := K) j * (cuspT j - 1)) := by
  have hX : IsUnit (algebraMap K[X] (cuspLocal K) X) :=
    isUnit_cuspLocal_of_dvd (Dvd.intro _ rfl)
  have hm1 : IsUnit (algebraMap K[X] (cuspLocal K) (X - 1)) :=
    isUnit_cuspLocal_of_dvd (Dvd.intro (X * ((X + 1) * (X + 2) * (X - 2))) (by
      unfold cuspPoly; ring))
  have hp1 : IsUnit (algebraMap K[X] (cuspLocal K) (X + 1)) :=
    isUnit_cuspLocal_of_dvd (Dvd.intro (X * ((X - 1) * (X + 2) * (X - 2))) (by
      unfold cuspPoly; ring))
  have hp2 : IsUnit (algebraMap K[X] (cuspLocal K) (X + 2)) :=
    isUnit_cuspLocal_of_dvd (Dvd.intro (X * ((X - 1) * (X + 1) * (X - 2))) (by
      unfold cuspPoly; ring))
  have hm2 : IsUnit (algebraMap K[X] (cuspLocal K) (X - 2)) :=
    isUnit_cuspLocal_of_dvd (Dvd.intro (X * ((X - 1) * (X + 1) * (X + 2))) (by
      unfold cuspPoly; ring))
  have hG : IsUnit (algebraMap K[X] (cuspLocal K) cuspPoly) :=
    isUnit_cuspLocal_of_dvd (Dvd.intro_left _ rfl)
  fin_cases j
  · simp only [cuspT, Fin.zero_eta, Matrix.cons_val_zero]
    rw [← map_one (algebraMap K[X] (cuspLocal K)), ← map_sub]
    exact hX.mul hm1
  · simp only [cuspT, Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero]
    rw [← map_one (algebraMap K[X] (cuspLocal K)), ← map_sub, add_sub_cancel_left, add_comm]
    exact hp1.mul hX
  · -- `e (e - 1) = -a² (s + 2)(s - 2) G² w²` with `a = 1/2`, `w = (s G)⁻¹`
    change IsUnit (algebraMap K[X] _ (C 2⁻¹ * (X + 2) * cuspPoly) *
      IsLocalization.Away.invSelf (X * cuspPoly (K := K)) *
      (algebraMap K[X] _ (C 2⁻¹ * (X + 2) * cuspPoly) *
        IsLocalization.Away.invSelf (X * cuspPoly (K := K)) - 1))
    have hinv := IsLocalization.Away.mul_invSelf (S := cuspLocal K) (X * cuspPoly (K := K))
    have hw : IsUnit (IsLocalization.Away.invSelf (S := cuspLocal K) (X * cuspPoly (K := K))) :=
      IsUnit.of_mul_eq_one_right _ hinv
    have h2a : algebraMap K[X] (cuspLocal K) (C 2⁻¹) * 2 = 1 := by
      rw [← map_ofNat (algebraMap K[X] (cuspLocal K)) 2, ← map_mul, ← C_ofNat, ← C_mul,
        inv_mul_cancel₀ two_ne_zero, C_1, map_one]
    have ha : IsUnit (algebraMap K[X] (cuspLocal K) (C 2⁻¹)) := IsUnit.of_mul_eq_one _ h2a
    set w := IsLocalization.Away.invSelf (S := cuspLocal K) (X * cuspPoly (K := K))
    set a := algebraMap K[X] (cuspLocal K) (C 2⁻¹)
    set G := algebraMap K[X] (cuspLocal K) cuspPoly
    rw [map_mul] at hinv
    simp only [map_mul, map_add, map_sub, map_ofNat] at hinv hp2 hm2 ⊢
    set x := algebraMap K[X] (cuspLocal K) X
    have key : a * (x + 2) * G * w * (a * (x + 2) * G * w - 1) =
        -(a ^ 2) * ((x + 2) * (x - 2)) * G ^ 2 * w ^ 2 := by
      linear_combination (a * (x + 2) * G ^ 2 * w ^ 2 * x) * h2a + (a * (x + 2) * G * w) * hinv
    rw [key]
    exact ((((ha.pow 2).neg).mul (hp2.mul hm2)).mul (hG.pow 2)).mul (hw.pow 2)

/-- The relation `CuspRel j` between the images of `t` and `s` under any algebra map out of
`K[s, 1/(s G(s))]`. -/
lemma cuspRel_cuspT {B : Type*} [CommRing B] [Algebra K B] (κ : cuspLocal K →ₐ[K] B)
    (j : Fin 3) : CuspRel j (κ (cuspT j)) (κ (algebraMap K[X] _ X)) := by
  have h0 : CuspRel 0 (κ (cuspT 0)) (κ (algebraMap K[X] _ X)) := rfl
  have h1 : CuspRel 1 (κ (cuspT 1)) (κ (algebraMap K[X] _ X)) := by
    change κ (algebraMap K[X] _ (1 + X)) = 1 + κ (algebraMap K[X] _ X)
    rw [map_add, map_one, map_add, map_one]
  have h2 : CuspRel 2 (κ (cuspT 2)) (κ (algebraMap K[X] _ X)) := by
    change 2 * κ (algebraMap K[X] _ (C 2⁻¹ * (X + 2) * cuspPoly) *
      IsLocalization.Away.invSelf (X * cuspPoly (K := K))) * κ (algebraMap K[X] _ X) =
        κ (algebraMap K[X] _ X) + 2
    have hinv := congrArg κ
      (IsLocalization.Away.mul_invSelf (S := cuspLocal K) (X * cuspPoly (K := K)))
    have hC : κ (algebraMap K[X] (cuspLocal K) (C 2⁻¹)) * 2 = 1 := by
      rw [← map_ofNat κ 2, ← map_mul, ← map_ofNat (algebraMap K[X] (cuspLocal K)) 2, ← map_mul,
        ← C_ofNat, ← C_mul, inv_mul_cancel₀ two_ne_zero, C_1, map_one, map_one]
    simp only [map_mul, map_one, map_add, map_ofNat] at hinv hC ⊢
    linear_combination (κ (algebraMap K[X] (cuspLocal K) X) + 2) * hC +
      (2 * κ (algebraMap K[X] (cuspLocal K) (C 2⁻¹)) * (κ (algebraMap K[X] (cuspLocal K) X) + 2))
        * hinv
  fin_cases j
  exacts [h0, h1, h2]

end Cusp


/-! ### The geometric generic point and the Galois action -/

section Galois

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}

lemma ne_algebraMap_of_transcendental (ht : Transcendental k t) (c : k) :
    t ≠ algebraMap k Ω c :=
  fun h ↦ ht (h ▸ isAlgebraic_algebraMap c)

/-- `t ∈ k(t)`. -/
def tK₀ (k : Type u) [Field k] [Algebra k Ω] (t : Ω) : K₀ k t :=
  ⟨t, IntermediateField.mem_adjoin_simple_self k t⟩

lemma isUnit_tK₀ (ht : Transcendental k t) : IsUnit (tK₀ k t * (tK₀ k t - 1)) := by
  refine isUnit_iff_ne_zero.2 (mul_ne_zero (fun h ↦ ?_) (sub_ne_zero.2 fun h ↦ ?_))
  · exact ne_algebraMap_of_transcendental ht 0 (by simpa [tK₀] using congrArg Subtype.val h)
  · exact ne_algebraMap_of_transcendental ht 1 (by simpa [tK₀] using congrArg Subtype.val h)

/-- `k[t, 1/(t(t-1))] → k(t)`. -/
def lineToK₀ (ht : Transcendental k t) : lineRing k →ₐ[k] K₀ k t :=
  lineLift (tK₀ k t) (isUnit_tK₀ ht)

/-- `k[t, 1/(t(t-1))] → Ω`. -/
def lineToΩ (ht : Transcendental k t) : lineRing k →ₐ[k] Ω :=
  (IsScalarTower.toAlgHom k (K₀ k t) Ω).comp (lineToK₀ ht)

@[simp]
lemma lineToΩ_lineT (ht : Transcendental k t) : lineToΩ ht (lineT k) = t := by
  simp [lineToΩ, lineToK₀, tK₀]

/-- **The geometric generic point** `η : Spec Ω ⟶ Spec k(t) ⟶ ℙ¹ ∖ {0, 1, ∞}`. -/
def lineGen (ht : Transcendental k t) : Spec (.of Ω) ⟶ Spec (.of (lineRing k)) :=
  Spec.map (CommRingCat.ofHom (algebraMap (K₀ k t) Ω)) ≫
    Spec.map (CommRingCat.ofHom (lineToK₀ ht).toRingHom)

lemma lineGen_eq (ht : Transcendental k t) :
    lineGen ht = Spec.map (CommRingCat.ofHom (lineToΩ ht).toRingHom) := by
  rw [lineGen, ← Spec.map_comp]
  rfl

variable [IsSepClosed Ω] [IsGalois (K₀ k t) Ω]

/-- **The Galois action** `Gal(Ω / k(t)) → π₁ᵉᵗ(ℙ¹ ∖ {0, 1, ∞}, η)`. -/
def lineGalois (ht : Transcendental k t) : (Ω ≃ₐ[K₀ k t] Ω) →* π₁ᵉᵗ(lineGen ht) :=
  FiniteEtale.galoisAction (K₀ k t) (Spec.map (CommRingCat.ofHom (lineToK₀ ht).toRingHom)) rfl

/-- **The inertia group of a place `W` of `Ω` in `π₁ᵉᵗ(ℙ¹ ∖ {0, 1, ∞}, η)`**: the closed subgroup
generated by the images of the inertia elements of `W`. -/
def lineInertia (ht : Transcendental k t) (W : ValuationSubring Ω) : Subgroup π₁ᵉᵗ(lineGen ht) :=
  (Subgroup.closure (lineGalois ht '' GaloisPi1.inertia (P := K₀ k t) W)).topologicalClosure

end Galois

/-! ### Local coordinates at the cusps -/

section Coord

variable {k Ω : Type u} [Field k] [CharZero k] [Field Ω] [Algebra k Ω] {t : Ω}

/-- **The local coordinate at the cusp `j`**: `t`, `t - 1`, `2 / (2t - 1)`. -/
def cuspCoord (j : Fin 3) (t : Ω) : Ω := ![t, t - 1, 2 / (2 * t - 1)] j

omit [CharZero k] in
lemma charZero_of_charZero (k Ω : Type u) [Field k] [CharZero k] [Field Ω] [Algebra k Ω] :
    CharZero Ω :=
  charZero_of_injective_algebraMap (algebraMap k Ω).injective

lemma two_mul_sub_one_ne_zero (ht : Transcendental k t) : 2 * t - 1 ≠ 0 := by
  haveI := charZero_of_charZero k Ω
  intro h
  apply ne_algebraMap_of_transcendental ht (2⁻¹)
  rw [map_inv₀, map_ofNat]
  have h2 : (2 : Ω) ≠ 0 := two_ne_zero
  field_simp
  linear_combination h

lemma cuspCoord_ne_zero (ht : Transcendental k t) (j : Fin 3) : cuspCoord j t ≠ 0 := by
  haveI := charZero_of_charZero k Ω
  fin_cases j
  · simpa [cuspCoord] using ne_algebraMap_of_transcendental ht 0
  · simpa [cuspCoord, sub_eq_zero] using ne_algebraMap_of_transcendental ht 1
  · simp [cuspCoord, two_mul_sub_one_ne_zero ht]

omit [CharZero k] in
lemma cuspCoord_mem (j : Fin 3) : cuspCoord j t ∈ K₀ k t := by
  have ht := IntermediateField.mem_adjoin_simple_self k t
  fin_cases j
  · exact ht
  · exact sub_mem ht (one_mem _)
  · exact div_mem (ofNat_mem _ 2) (sub_mem (mul_mem (ofNat_mem _ 2) ht) (one_mem _))

/-- `t = 1/2 + 1/u` for `u = 2/(2t - 1)`. -/
lemma eq_of_cuspCoord_two (ht : Transcendental k t) :
    t = (cuspCoord 2 t + 2) / (2 * cuspCoord 2 t) := by
  haveI := charZero_of_charZero k Ω
  have h := two_mul_sub_one_ne_zero ht
  have hu : cuspCoord 2 t = 2 / (2 * t - 1) := rfl
  rw [hu, eq_div_iff (mul_ne_zero two_ne_zero (div_ne_zero two_ne_zero h)), div_add' _ _ _ h,
    mul_div_assoc', mul_div_assoc', div_left_inj' h]
  ring

lemma mem_K₀_cuspCoord (ht : Transcendental k t) (j : Fin 3) : t ∈ K₀ k (cuspCoord j t) := by
  have h0 : t ∈ K₀ k (cuspCoord 0 t) := IntermediateField.mem_adjoin_simple_self k t
  have h1 : t ∈ K₀ k (cuspCoord 1 t) := by
    have hu := IntermediateField.mem_adjoin_simple_self k (cuspCoord 1 t)
    have key := add_mem hu (one_mem (K₀ k (cuspCoord 1 t)))
    rwa [show cuspCoord 1 t + 1 = t from sub_add_cancel t 1] at key
  have h2 : t ∈ K₀ k (cuspCoord 2 t) := by
    have hu := IntermediateField.mem_adjoin_simple_self k (cuspCoord 2 t)
    have key := div_mem (add_mem hu (ofNat_mem (K₀ k (cuspCoord 2 t)) 2))
      (mul_mem (ofNat_mem (K₀ k (cuspCoord 2 t)) 2) hu)
    rwa [← eq_of_cuspCoord_two ht] at key
  fin_cases j
  exacts [h0, h1, h2]

lemma K₀_cuspCoord (ht : Transcendental k t) (j : Fin 3) : K₀ k (cuspCoord j t) = K₀ k t :=
  le_antisymm (IntermediateField.adjoin_simple_le_iff.2 (cuspCoord_mem j))
    (IntermediateField.adjoin_simple_le_iff.2 (mem_K₀_cuspCoord ht j))

lemma transcendental_cuspCoord (ht : Transcendental k t) (j : Fin 3) :
    Transcendental k (cuspCoord j t) := by
  intro hu
  haveI : FiniteDimensional k (K₀ k (cuspCoord j t)) :=
    IntermediateField.adjoin.finiteDimensional hu.isIntegral
  have h := (Algebra.IsAlgebraic.isAlgebraic (R := k)
    (⟨t, mem_K₀_cuspCoord ht j⟩ : K₀ k (cuspCoord j t)))
  exact ht ((isAlgebraic_algebraMap_iff (algebraMap (K₀ k (cuspCoord j t)) Ω).injective).2 h)

lemma isUnit_aeval_cuspCoord (ht : Transcendental k t) (j : Fin 3) :
    IsUnit (aeval (cuspCoord j t) (X * cuspPoly (K := k))) := by
  refine isUnit_iff_ne_zero.2 fun h ↦ transcendental_cuspCoord ht j ⟨X * cuspPoly, ?_, h⟩
  exact mul_ne_zero X_ne_zero fun h0 ↦ cuspPoly_eval_zero (K := k) (by rw [h0, eval_zero])

end Coord

/-! ### From a fixed point of inertia to a branch -/

section Branch

variable {k Ω : Type u} [Field k] [CharZero k] [Field Ω] [Algebra k Ω] {t : Ω}

/-- `k[s, 1/(s G(s))] → Ω`, `s ↦ u_j`. -/
def cuspToΩ (ht : Transcendental k t) (j : Fin 3) : cuspLocal k →ₐ[k] Ω :=
  IsLocalization.Away.liftAlgHom (X * cuspPoly) (f := aeval (cuspCoord j t))
    (isUnit_aeval_cuspCoord ht j)

lemma cuspToΩ_algebraMap (ht : Transcendental k t) (j : Fin 3) (p : k[X]) :
    cuspToΩ ht j (algebraMap k[X] _ p) = aeval (cuspCoord j t) p := by
  simp [cuspToΩ, IsLocalization.Away.liftAlgHom_apply]

lemma cuspToΩ_cuspT (ht : Transcendental k t) (j : Fin 3) : cuspToΩ ht j (cuspT j) = t := by
  haveI := charZero_of_charZero k Ω
  have h0 : cuspToΩ ht 0 (cuspT 0) = t := by
    change cuspToΩ ht 0 (algebraMap k[X] _ X) = t
    rw [cuspToΩ_algebraMap, aeval_X]
    rfl
  have h1 : cuspToΩ ht 1 (cuspT 1) = t := by
    change cuspToΩ ht 1 (algebraMap k[X] _ (1 + X)) = t
    rw [cuspToΩ_algebraMap, map_add, map_one, aeval_X]
    exact add_sub_cancel 1 t
  have h2 : cuspToΩ ht 2 (cuspT 2) = t := by
    have hinv := congrArg (cuspToΩ ht 2)
      (IsLocalization.Away.mul_invSelf (S := cuspLocal k) (X * cuspPoly (K := k)))
    rw [map_mul, map_one, cuspToΩ_algebraMap] at hinv
    change cuspToΩ ht 2 (algebraMap k[X] _ (C 2⁻¹ * (X + 2) * cuspPoly) *
      IsLocalization.Away.invSelf (X * cuspPoly (K := k))) = t
    rw [map_mul, cuspToΩ_algebraMap]
    have hu0 := cuspCoord_ne_zero ht 2
    have ht2 := eq_of_cuspCoord_two ht
    set w := cuspToΩ ht 2 (IsLocalization.Away.invSelf (S := cuspLocal k) (X * cuspPoly (K := k)))
    set u := cuspCoord 2 t
    conv_rhs => rw [ht2]
    simp only [map_mul, map_add, aeval_C, aeval_X, map_ofNat, map_inv₀] at hinv ⊢
    rw [eq_div_iff (mul_ne_zero two_ne_zero hu0)]
    linear_combination (u + 2) * hinv
  fin_cases j
  exacts [h0, h1, h2]

/-- `k[t, 1/(t(t-1))] → k[s, 1/(s G(s))]`, `t ↦ e_j`. -/
def cuspLine (j : Fin 3) : lineRing k →ₐ[k] cuspLocal k :=
  lineLift (cuspT j) (isUnit_cuspT j)

lemma cuspToΩ_comp_cuspLine (ht : Transcendental k t) (j : Fin 3) :
    (cuspToΩ ht j).comp (cuspLine j) = lineToΩ ht :=
  lineRing_algHom_ext (by simp [cuspLine, cuspToΩ_cuspT ht j])

/-- The ring map `Γ(Y) → Ω` of a geometric point `y : Spec Ω ⟶ Y`. -/
def pointRingHom {Y : Scheme.{u}} (y : Spec (.of Ω) ⟶ Y) : Γ(Y, ⊤) →+* Ω :=
  (Scheme.ΓSpecIso (.of Ω)).hom.hom.comp y.appTop.hom

omit [CharZero k] [Algebra k Ω] in
lemma pointRingHom_comp {Y Z : Scheme.{u}} (y : Spec (.of Ω) ⟶ Y) (f : Y ⟶ Z) :
    pointRingHom (y ≫ f) = (pointRingHom y).comp f.appTop.hom := by
  simp [pointRingHom, RingHom.comp_assoc]

omit [CharZero k] [Algebra k Ω] in
lemma pointRingHom_specMap {R : CommRingCat.{u}} (g : R ⟶ .of Ω) :
    pointRingHom (Spec.map g) = g.hom.comp (Scheme.ΓSpecIso R).hom.hom := by
  have h := Scheme.ΓSpecIso_naturality g
  rw [pointRingHom, ← CommRingCat.hom_comp, h, CommRingCat.hom_comp]

omit [CharZero k] [Algebra k Ω] in
lemma pointRingHom_specMap_comp {Y : Scheme.{u}} (y : Spec (.of Ω) ⟶ Y) (σ : Ω →+* Ω) :
    pointRingHom (Spec.map (CommRingCat.ofHom σ) ≫ y) = σ.comp (pointRingHom y) := by
  rw [pointRingHom_comp, pointRingHom_specMap, pointRingHom, RingHom.comp_assoc]
  have h := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom σ)
  rfl

omit [CharZero k] [Algebra k Ω] in
/-- Lifting along an injective ring map with large enough range. -/
lemma exists_comp_eq_of_forall_mem_range {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    {ι : A →+* B} (hι : Function.Injective ι) {f : C →+* B} (h : ∀ c, f c ∈ ι.range) :
    ∃ ψ : C →+* A, ι.comp ψ = f := by
  let e : A ≃+* ι.range := RingEquiv.ofBijective ι.rangeRestrict
    ⟨fun a b hab ↦ hι (congrArg Subtype.val hab), ι.rangeRestrict_surjective⟩
  refine ⟨e.symm.toRingHom.comp (f.codRestrict ι.range h), RingHom.ext fun c ↦ ?_⟩
  have : ι (e.symm (f.codRestrict ι.range h c)) = (e (e.symm (f.codRestrict ι.range h c)) : B) :=
    rfl
  simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, this,
    RingEquiv.apply_symm_apply, RingHom.codRestrict_apply]

omit [CharZero k] in
/-- **A `k`-point at a maximal ideal** of an algebra of finite type over an algebraically closed
field (Hilbert's Nullstellensatz). -/
lemma exists_algHom_ker_eq [IsAlgClosed k] {A : Type u} [CommRing A] [Algebra k A]
    [Algebra.FiniteType k A] (P : Ideal A) [P.IsMaximal] :
    ∃ ε : A →ₐ[k] k, RingHom.ker ε = P := by
  letI := Ideal.Quotient.field P
  haveI : Algebra.FiniteType k (A ⧸ P) := Algebra.FiniteType.of_surjective
    (Ideal.Quotient.mkₐ k P) Ideal.Quotient.mk_surjective
  haveI : Module.Finite k (A ⧸ P) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ P)
  have hb := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := A ⧸ P)
  let e : k ≃ₐ[k] A ⧸ P := AlgEquiv.ofBijective (Algebra.ofId k (A ⧸ P)) hb
  refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k P), ?_⟩
  ext a
  simp only [RingHom.mem_ker, AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
    AlgEquiv.coe_toAlgHom, map_eq_zero_iff _ e.symm.injective, Ideal.Quotient.eq_zero_iff_mem]

omit [CharZero k] in
lemma isUnit_mk_mul_sub_one (ht : Transcendental k t) {E : IntermediateField k Ω} (h : t ∈ E) :
    IsUnit ((⟨t, h⟩ : E) * (⟨t, h⟩ - 1)) := by
  refine isUnit_iff_ne_zero.2 (mul_ne_zero (fun h0 ↦ ?_) (sub_ne_zero.2 fun h1 ↦ ?_))
  · exact ne_algebraMap_of_transcendental ht 0 (by simpa using congrArg Subtype.val h0)
  · exact ne_algebraMap_of_transcendental ht 1 (by simpa using congrArg Subtype.val h1)

omit [CharZero k] in
/-- The automorphism of `Ω / k(t)` underlying an automorphism of `Ω / k(u)`, when
`k(u) = k(t)`. -/
def algEquivOfK₀Eq {u : Ω} (h : K₀ k u = K₀ k t) (σ : Ω ≃ₐ[K₀ k u] Ω) : Ω ≃ₐ[K₀ k t] Ω :=
  { σ.toRingEquiv with
    commutes' := fun c ↦ σ.commutes ⟨c.1, by rw [h]; exact c.2⟩ }

omit [CharZero k] in
@[simp]
lemma algEquivOfK₀Eq_apply {u : Ω} (h : K₀ k u = K₀ k t) (σ : Ω ≃ₐ[K₀ k u] Ω) (z : Ω) :
    algEquivOfK₀Eq h σ z = σ z := rfl

omit [CharZero k] in
/-- A constant `c ≠ 0` has valuation `1` at a place containing `k`. -/
lemma valuation_algebraMap_eq_one {W : ValuationSubring Ω} (hWk : ∀ c : k, algebraMap k Ω c ∈ W)
    {c : k} (hc : c ≠ 0) : W.valuation (algebraMap k Ω c) = 1 := by
  refine le_antisymm ((W.valuation_le_one_iff _).2 (hWk c)) ?_
  have h1 : W.valuation (algebraMap k Ω c) * W.valuation (algebraMap k Ω c⁻¹) = 1 := by
    rw [← map_mul, ← map_mul, mul_inv_cancel₀ hc, map_one, map_one]
  have h2 := (W.valuation_le_one_iff _).2 (hWk c⁻¹)
  calc (1 : _) = W.valuation (algebraMap k Ω c) * W.valuation (algebraMap k Ω c⁻¹) := h1.symm
    _ ≤ W.valuation (algebraMap k Ω c) * 1 := mul_le_mul_right h2 _
    _ = _ := mul_one _

variable [IsSepClosed Ω] [IsGalois (K₀ k t) Ω]

omit [CharZero k] in
/-- **The ring map of a fixed point.** A point `x` of the fibre of `Y` at `η` fixed by the
inertia group of `W` is a ring map `φ : Γ(Y) → Ω` over `R → Ω`, fixed by the inertia elements. -/
lemma exists_fixed_ringHom (ht : Transcendental k t) (W : ValuationSubring Ω)
    (Y : FiniteEtale (Spec (.of (lineRing k))))
    (x : (FiniteEtale.fiber (lineGen ht)).obj Y)
    (hx : ∀ σ ∈ GaloisPi1.inertia (P := K₀ k t) W, (lineGalois ht σ).hom.app Y x = x) :
    ∃ φ : Γ(Y.left, ⊤) →+* Ω,
      φ.comp (Y.hom.appTop.hom.comp (Scheme.ΓSpecIso (.of (lineRing k))).inv.hom) =
        (lineToΩ ht).toRingHom ∧
      ∀ σ ∈ GaloisPi1.inertia (P := K₀ k t) W, ∀ b, σ (φ b) = φ b := by
  let y : Spec (.of Ω) ⟶ Y.left := (FiniteEtale.fiberObjEquivHom (lineGen ht) Y x).left
  have hy : y ≫ Y.hom = lineGen ht := Over.w (FiniteEtale.fiberObjEquivHom (lineGen ht) Y x)
  refine ⟨pointRingHom y, ?_, fun σ hσ b ↦ ?_⟩
  · have h : (pointRingHom y).comp Y.hom.appTop.hom =
        (lineToΩ ht).toRingHom.comp (Scheme.ΓSpecIso (.of (lineRing k))).hom.hom :=
      ((pointRingHom_comp y Y.hom).symm.trans
        (congrArg pointRingHom (hy.trans (lineGen_eq ht)))).trans (pointRingHom_specMap _)
    refine RingHom.ext fun r ↦ ?_
    have h' := RingHom.congr_fun h ((Scheme.ΓSpecIso (.of (lineRing k))).inv.hom r)
    have e : (Scheme.ΓSpecIso (.of (lineRing k))).hom.hom
        ((Scheme.ΓSpecIso (.of (lineRing k))).inv.hom r) = r := by simp
    exact h'.trans (congrArg (fun z ↦ (lineToΩ ht) z) e)
  · have h1 := FiniteEtale.galoisAction_hom_app_left (K₀ k t)
      (Spec.map (CommRingCat.ofHom (lineToK₀ ht).toRingHom)) rfl σ Y x
    have h2 : Spec.map (CommRingCat.ofHom (σ : Ω →+* Ω)) ≫ y = y :=
      h1.symm.trans
        (congrArg (fun z ↦ (FiniteEtale.fiberObjEquivHom (lineGen ht) Y z).left) (hx σ hσ))
    have h3 := congrArg pointRingHom h2
    rw [pointRingHom_specMap_comp] at h3
    exact RingHom.congr_fun h3 b

omit [IsSepClosed Ω] [IsGalois (K₀ k t) Ω] in
/-- **The field of a fixed ring map.** For `ρ : R → B` finite and `φ : B → Ω` over `R → Ω` fixed
by the inertia elements of `W`, the field `N = k(u)(φ(B))` is finite over `k(u)`
(`u = u_j` the local coordinate) and fixed by the inertia group of `W` over `k(u)`. -/
lemma exists_intermediateField_of_fixed (ht : Transcendental k t) (j : Fin 3)
    (W : ValuationSubring Ω) {B : Type u} [CommRing B] (ρ : lineRing k →+* B) (hρ : ρ.Finite)
    (φ : B →+* Ω) (hφρ : φ.comp ρ = (lineToΩ ht).toRingHom)
    (hfix : ∀ σ ∈ GaloisPi1.inertia (P := K₀ k t) W, ∀ b, σ (φ b) = φ b) :
    ∃ N : IntermediateField (K₀ k (cuspCoord j t)) Ω, FiniteDimensional (K₀ k (cuspCoord j t)) N ∧
      (∀ b, φ b ∈ N) ∧
      ∀ σ ∈ GaloisPi1.inertia (P := K₀ k (cuspCoord j t)) W, σ ∈ N.fixingSubgroup := by
  classical
  set u := cuspCoord j t
  have hK : K₀ k u = K₀ k t := K₀_cuspCoord ht j
  have htu : t ∈ K₀ k u := mem_K₀_cuspCoord ht j
  let lam : lineRing k →ₐ[k] K₀ k u := lineLift ⟨t, htu⟩ (isUnit_mk_mul_sub_one ht htu)
  have hlam : (IsScalarTower.toAlgHom k (K₀ k u) Ω).comp lam = lineToΩ ht :=
    lineRing_algHom_ext (by simp [lam])
  have hφρ' : ∀ r, φ (ρ r) = algebraMap (K₀ k u) Ω (lam r) := by
    intro r
    rw [← RingHom.comp_apply φ ρ, hφρ, ← hlam]
    rfl
  letI : Algebra (lineRing k) B := ρ.toAlgebra
  haveI : Module.Finite (lineRing k) B := hρ
  obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := lineRing k) (M := B)
  let N : IntermediateField (K₀ k u) Ω :=
    IntermediateField.adjoin (K₀ k u) ((fun b ↦ φ b) '' (S : Set B))
  have hint : ∀ b, IsIntegral (K₀ k u) (φ b) := by
    intro b
    obtain ⟨p, hp, hpb⟩ := hρ.to_isIntegral b
    refine ⟨p.map lam.toRingHom, hp.map _, ?_⟩
    rw [eval₂_map]
    have : (algebraMap (K₀ k u) Ω).comp lam.toRingHom = φ.comp ρ :=
      RingHom.ext fun r ↦ (hφρ' r).symm
    rw [this, ← Polynomial.hom_eval₂, hpb, map_zero]
  haveI : FiniteDimensional (K₀ k u) N := IntermediateField.finiteDimensional_adjoin
    (fun z hz ↦ by obtain ⟨b, -, rfl⟩ := hz; exact hint b)
  have hφN : ∀ b, φ b ∈ N := by
    intro b
    have hb : b ∈ Submodule.span (lineRing k) (S : Set B) := hS ▸ Submodule.mem_top
    induction hb using Submodule.span_induction with
    | mem z hz => exact IntermediateField.subset_adjoin _ _ ⟨z, hz, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add z w _ _ hz hw => rw [map_add]; exact add_mem hz hw
    | smul r z _ hz =>
      rw [Algebra.smul_def, map_mul]
      refine mul_mem ?_ hz
      change φ (ρ r) ∈ N
      rw [hφρ' r]
      exact N.algebraMap_mem _
  refine ⟨N, inferInstance, hφN, fun σ hσ ↦ ?_⟩
  have hσ' : algEquivOfK₀Eq hK σ ∈ GaloisPi1.inertia (P := K₀ k t) W := hσ
  have hle : N ≤ IntermediateField.fixedField (Subgroup.zpowers σ) := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨b, -, rfl⟩
    rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
    intro g hg
    have hs : σ ∈ MulAction.stabilizer (Ω ≃ₐ[K₀ k u] Ω) (φ b) := hfix _ hσ' b
    exact (Subgroup.zpowers_le.2 hs hg : g ∈ MulAction.stabilizer _ _)
  exact (IntermediateField.le_iff_le _ _).1 hle (Subgroup.mem_zpowers σ)

omit [CharZero k] [IsSepClosed Ω] [IsGalois (K₀ k t) Ω] in
lemma coordRingMap_C {u : Ω} (hu : Transcendental k u) (N : IntermediateField (K₀ k u) Ω)
    (c : k) : coordRingMap hu N (C c) = algebraMap k (coordRing k u N) c := by
  change (ringMap u bot_le) ((coordRingBotEquiv hu) (algebraMap k k[X] c)) = _
  rw [AlgEquiv.commutes, AlgHom.commutes]

set_option maxHeartbeats 2000000 in
-- many instances on localizations of `coordRing k u N`
set_option synthInstance.maxHeartbeats 400000 in
omit [IsSepClosed Ω] in
/-- **The ring-theoretic branch.** In the situation of `exists_intermediateField_of_fixed`, if `W`
lies over the cusp `j`, the normalization of `k[u]` in `N` is étale over `k[u]` near the centre
of `W`; localizing gives `A`, `s = u`, the point `ε` (the centre), `θ : R → A[1/s]` and
`ψ : B → A[1/s]` over `θ`. -/
lemma exists_branch_ring [IsAlgClosed k] (ht : Transcendental k t) (j : Fin 3)
    {W : ValuationSubring Ω} (hWk : ∀ c : k, algebraMap k Ω c ∈ W)
    (hWj : W.valuation (cuspCoord j t) < 1)
    {B : Type u} [CommRing B] (ρ : lineRing k →+* B) (hρ : ρ.Finite)
    (φ : B →+* Ω) (hφρ : φ.comp ρ = (lineToΩ ht).toRingHom)
    (N : IntermediateField (K₀ k (cuspCoord j t)) Ω) [FiniteDimensional (K₀ k (cuspCoord j t)) N]
    (hφN : ∀ b, φ b ∈ N)
    (hNfix : ∀ σ ∈ GaloisPi1.inertia (P := K₀ k (cuspCoord j t)) W, σ ∈ N.fixingSubgroup) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra k A) (_ : Algebra.FiniteType k A) (s : A)
      (_ : (MvPolynomial.aeval (R := k) fun _ : Fin 1 ↦ s).toRingHom.Etale)
      (ε : A →ₐ[k] k) (_ : ε s = 0)
      (θ : lineRing k →ₐ[k] Localization.Away s)
      (_ : CuspRel j (θ (lineT k)) (algebraMap A (Localization.Away s) s))
      (ψ : B →+* Localization.Away s), ψ.comp ρ = θ.toRingHom := by
  classical
  have hu : Transcendental k (cuspCoord j t) := transcendental_cuspCoord ht j
  have hK : K₀ k (cuspCoord j t) = K₀ k t := K₀_cuspCoord ht j
  haveI : IsGalois (K₀ k (cuspCoord j t)) Ω := hK ▸ inferInstance
  have hu0 : (cuspCoord j t) ≠ 0 := cuspCoord_ne_zero ht j
  have huW : (cuspCoord j t) ∈ W := (W.valuation_le_one_iff _).1 hWj.le
  have hW : IsCentered k (cuspCoord j t) W := ⟨hWk, huW⟩
  haveI := isSeparable_of_charZero N
  -- the centre of `W` on `N`
  let cX := coordRingMap hu N X
  have hcX : toΩ (cuspCoord j t) N cX = (cuspCoord j t) := by
    rw [toΩ_apply, coordRingMap_apply, aeval_X]
  have hcXmem : cX ∈ centerIdeal hW N := (mem_centerIdeal hW).2 (by rw [hcX]; exact hWj)
  have hne : centerIdeal hW N ≠ ⊥ := by
    intro h
    rw [h, Ideal.mem_bot] at hcXmem
    exact hu0 (by rw [← hcX, hcXmem, map_zero])
  let cG := coordRingMap hu N cuspPoly
  have hcG : cG ∉ centerIdeal hW N := by
    rw [mem_centerIdeal]
    intro hlt
    obtain ⟨q, hq⟩ := X_dvd_sub_C (p := (cuspPoly : k[X]))
    rw [coeff_zero_eq_eval_zero] at hq
    have hG : toΩ (cuspCoord j t) N cG = algebraMap k Ω ((cuspPoly : k[X]).eval 0) +
        (cuspCoord j t) * toΩ (cuspCoord j t) N
        (coordRingMap hu N q) := by
      have h' := congrArg (aeval (cuspCoord j t)) hq
      rw [map_sub, aeval_C, map_mul, aeval_X] at h'
      rw [toΩ_apply, toΩ_apply, coordRingMap_apply, coordRingMap_apply]
      linear_combination h'
    have hqW : W.valuation (toΩ (cuspCoord j t) N (coordRingMap hu N q)) ≤ 1 :=
      valuation_le_one hW _
    have hc1 := valuation_algebraMap_eq_one hWk (cuspPoly_eval_zero (K := k))
    have hlt' : W.valuation (algebraMap k Ω ((cuspPoly : k[X]).eval 0)) < 1 := by
      have e : algebraMap k Ω ((cuspPoly : k[X]).eval 0) =
          toΩ (cuspCoord j t) N cG -
            (cuspCoord j t) * toΩ (cuspCoord j t) N (coordRingMap hu N q) := by
        rw [hG]; ring
      rw [e]
      refine lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt hlt ?_)
      rw [map_mul]
      calc W.valuation (cuspCoord j t) * W.valuation (toΩ (cuspCoord j t) N (coordRingMap hu N q))
          ≤ W.valuation (cuspCoord j t) * 1 := mul_le_mul_right hqW _
        _ < 1 := by rw [mul_one]; exact hWj
    rw [hc1] at hlt'
    exact lt_irrefl _ hlt'
  -- the étale neighbourhood `A = coordRing[1/r]`
  obtain ⟨r, hr, hrG, hrEt⟩ := exists_etale_away_of_inertia_le hu hW N hne hNfix cG hcG
  haveI hPmax := isMaximal_centerIdeal hu hW N hne
  haveI : Algebra.FiniteType k (coordRing k (cuspCoord j t) N) :=
    finiteType_ring (cuspCoord j t) hu N
  have hr0 : r ≠ 0 := fun h ↦ hr (h ▸ zero_mem _)
  let A := Localization.Away r
  have hrnz : Submonoid.powers r ≤ nonZeroDivisors (coordRing k (cuspCoord j t) N) :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hr0
  haveI : IsDomain A := IsLocalization.isDomain_localization hrnz
  haveI : Algebra.FiniteType k A :=
    Algebra.FiniteType.trans (S := coordRing k (cuspCoord j t) N) inferInstance
    (IsLocalization.finiteType_of_monoid_fg (Submonoid.powers r) A)
  have hinjCA : Function.Injective (algebraMap (coordRing k (cuspCoord j t) N) A) :=
    IsLocalization.injective A hrnz
  let s : A := algebraMap (coordRing k (cuspCoord j t) N) A cX
  have htoΩinj : Function.Injective (toΩ (cuspCoord j t) N) :=
    fun a b h ↦ Subtype.val_injective (Subtype.val_injective h)
  have hcX0 : cX ≠ 0 := fun h ↦ hu0 (by rw [← hcX, h, map_zero])
  have hs0 : s ≠ 0 := fun h ↦ hcX0 (hinjCA (h.trans (map_zero _).symm))
  -- `ι₁ : A → Ω`, `ι : A[1/s] → Ω`
  have hunit_r : IsUnit (toΩ (cuspCoord j t) N r) :=
    isUnit_iff_ne_zero.2 (fun h ↦ hr0 (htoΩinj (h.trans (map_zero _).symm)))
  let ι₁ : A →+* Ω := IsLocalization.Away.lift r hunit_r
  have hι₁ : ∀ c, ι₁ (algebraMap (coordRing k (cuspCoord j t) N) A c) =
      toΩ (cuspCoord j t) N c :=
    IsLocalization.Away.lift_eq r hunit_r
  have hι₁inj : Function.Injective ι₁ :=
    (IsLocalization.lift_injective_iff (M := Submonoid.powers r) (S := A) _).2
      fun a b ↦ ⟨fun h ↦ by rw [hinjCA h], fun h ↦ by rw [htoΩinj h]⟩
  let As := Localization.Away s
  have hsnz : Submonoid.powers s ≤ nonZeroDivisors A :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hs0
  have hinjAAs : Function.Injective (algebraMap A As) := IsLocalization.injective As hsnz
  have hι₁s : ι₁ s = (cuspCoord j t) := by rw [hι₁, hcX]
  have hunit_s : IsUnit (ι₁ s) := by rw [hι₁s]; exact isUnit_iff_ne_zero.2 hu0
  let ι : As →+* Ω := IsLocalization.Away.lift s hunit_s
  have hι : ∀ a, ι (algebraMap A As a) = ι₁ a := IsLocalization.Away.lift_eq s hunit_s
  have hιinj : Function.Injective ι :=
    (IsLocalization.lift_injective_iff (M := Submonoid.powers s) (S := As) _).2
      fun a b ↦ ⟨fun h ↦ by rw [hinjAAs h], fun h ↦ by rw [hι₁inj h]⟩
  have hιk : ∀ c : k, ι (algebraMap k As c) = algebraMap k Ω c := by
    intro c
    rw [IsScalarTower.algebraMap_apply k A As, hι, IsScalarTower.algebraMap_apply k
      (coordRing k (cuspCoord j t) N) A, hι₁]
    rfl
  -- polynomials in `s`
  have hagree : ∀ p : k[X], aeval (algebraMap A As s) p =
      algebraMap A As (algebraMap (coordRing k (cuspCoord j t) N) A (coordRingMap hu N p)) := by
    intro p
    have e : (aeval (algebraMap A As s)).toRingHom = (algebraMap A As).comp
        ((algebraMap (coordRing k (cuspCoord j t) N) A).comp (coordRingMap hu N)) := by
      refine Polynomial.ringHom_ext (fun c ↦ ?_) ?_
      · simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_C, RingHom.coe_comp,
          Function.comp_apply, coordRingMap_C]
        rw [← IsScalarTower.algebraMap_apply k (coordRing k (cuspCoord j t) N) A,
          ← IsScalarTower.algebraMap_apply k A As]
      · simp [s, cX]
    exact RingHom.congr_fun e p
  have hagree' : ∀ p : k[X], aeval s p =
      algebraMap (coordRing k (cuspCoord j t) N) A (coordRingMap hu N p) := by
    intro p
    apply hinjAAs
    rw [← Polynomial.aeval_algebraMap_apply]
    exact hagree p
  -- étaleness over `k[s]`
  have het : (aeval (R := k) s).toRingHom.Etale := by
    have e : (aeval (R := k) s).toRingHom =
        (algebraMap (coordRing k (cuspCoord j t) N) A).comp (coordRingMap hu N) :=
      RingHom.ext fun p ↦ hagree' p
    rw [e]
    exact hrEt
  -- the point `ε`
  obtain ⟨ε₀, hε₀⟩ := exists_algHom_ker_eq (k := k) (centerIdeal hW N)
  have hε₀r : IsUnit (ε₀ r) :=
    isUnit_iff_ne_zero.2 fun h ↦ hr (hε₀ ▸ (RingHom.mem_ker).2 h)
  let ε : A →ₐ[k] k := IsLocalization.Away.liftAlgHom r (f := ε₀) hε₀r
  have hεs : ε s = 0 := by
    change IsLocalization.Away.lift r hε₀r (algebraMap _ A cX) = 0
    rw [IsLocalization.Away.lift_eq]
    exact (RingHom.mem_ker).1 (hε₀ ▸ hcXmem)
  -- `θ : R → A[1/s]`
  have hsAs : IsUnit (algebraMap A As s) := IsLocalization.Away.algebraMap_isUnit s
  have hGAs : IsUnit (algebraMap A As (algebraMap (coordRing k (cuspCoord j t) N) A cG)) :=
    hrG.map _
  have hXG : IsUnit (aeval (algebraMap A As s) (X * cuspPoly (K := k))) := by
    rw [map_mul, aeval_X, hagree]
    exact hsAs.mul hGAs
  let κ : cuspLocal k →ₐ[k] As :=
    IsLocalization.Away.liftAlgHom (X * cuspPoly) (f := aeval (algebraMap A As s)) hXG
  have hκ : ∀ p, κ (algebraMap k[X] _ p) = aeval (algebraMap A As s) p := fun p ↦
    IsLocalization.Away.lift_eq _ hXG p
  let θ : lineRing k →ₐ[k] As := κ.comp (cuspLine j)
  have hrel : CuspRel j (θ (lineT k)) (algebraMap A As s) := by
    have h := cuspRel_cuspT κ j
    have hθT : θ (lineT k) = κ (cuspT j) := by simp [θ, cuspLine]
    rw [hκ, aeval_X] at h
    rwa [hθT]
  -- `ι ∘ θ = (R → Ω)`
  have hικ : ι.comp κ.toRingHom = (cuspToΩ ht j).toRingHom := by
    refine IsLocalization.ringHom_ext (Submonoid.powers (X * cuspPoly (K := k)))
      (Polynomial.ringHom_ext (fun c ↦ ?_) ?_)
    · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [hκ, cuspToΩ_algebraMap, aeval_C, aeval_C, hιk]
    · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [hκ, cuspToΩ_algebraMap, aeval_X, aeval_X, hι, hι₁s]
  have hιθ : ι.comp θ.toRingHom = (lineToΩ ht).toRingHom := by
    rw [← cuspToΩ_comp_cuspLine ht j]
    change ι.comp (κ.toRingHom.comp (cuspLine j).toRingHom) = _
    rw [← RingHom.comp_assoc, hικ]
    rfl
  -- `φ(B) ⊆ ι(A[1/s])`
  letI : Algebra (cuspLocal k) Ω := (cuspToΩ ht j).toRingHom.toAlgebra
  letI : Algebra k[X] Ω := (aeval (cuspCoord j t)).toRingHom.toAlgebra
  haveI : IsScalarTower k[X] (cuspLocal k) Ω :=
    IsScalarTower.of_algebraMap_eq fun p ↦ (cuspToΩ_algebraMap ht j p).symm
  have hrange : ∀ b, φ b ∈ ι.range := by
    intro b
    have hintL : IsIntegral (cuspLocal k) (φ b) := by
      obtain ⟨p, hp, hpb⟩ := hρ.to_isIntegral b
      refine ⟨p.map (cuspLine j).toRingHom, hp.map _, ?_⟩
      rw [eval₂_map]
      have e : (algebraMap (cuspLocal k) Ω).comp (cuspLine j).toRingHom = φ.comp ρ := by
        rw [hφρ, ← cuspToΩ_comp_cuspLine ht j]
        rfl
      rw [e, ← Polynomial.hom_eval₂, hpb, map_zero]
    obtain ⟨⟨_, n, rfl⟩, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      (Submonoid.powers (X * cuspPoly (K := k))) (φ b) hintL
    have hz : ((X * cuspPoly (K := k)) ^ n : k[X]) • φ b =
        aeval (cuspCoord j t) (X * cuspPoly (K := k)) ^ n * φ b := by
      rw [Algebra.smul_def, ← map_pow]
      rfl
    rw [Submonoid.smul_def] at hm
    simp only at hm
    rw [hz] at hm
    let a₀ : A₀ k (cuspCoord j t) :=
      ⟨(cuspCoord j t), Algebra.self_mem_adjoin_singleton k (cuspCoord j t)⟩
    letI : Algebra k[X] (A₀ k (cuspCoord j t)) := (aeval a₀).toRingHom.toAlgebra
    haveI : IsScalarTower k[X] (A₀ k (cuspCoord j t)) Ω :=
      IsScalarTower.of_algebraMap_eq fun p ↦ by
      change aeval (cuspCoord j t) p = ((aeval a₀ p : A₀ k (cuspCoord j t)) : Ω)
      rw [← Subalgebra.val_apply, ← Polynomial.aeval_algHom_apply]
      rfl
    have hzA := hm.tower_top (A := A₀ k (cuspCoord j t))
    have hdN : aeval (cuspCoord j t) (X * cuspPoly (K := k)) ∈ N := by
      rw [← coordRingMap_apply hu N]
      exact ((coordRingMap hu N (X * cuspPoly)) : N).2
    have hzN : aeval (cuspCoord j t) (X * cuspPoly (K := k)) ^ n * φ b ∈ N :=
      mul_mem (pow_mem hdN n) (hφN b)
    haveI : IsScalarTower (A₀ k (cuspCoord j t)) N Ω :=
      IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
    have hzN' : IsIntegral (A₀ k (cuspCoord j t))
        (⟨aeval (cuspCoord j t) (X * cuspPoly (K := k)) ^ n * φ b, hzN⟩ : N) :=
      (isIntegral_algebraMap_iff (algebraMap N Ω).injective).1 hzA
    let a : coordRing k (cuspCoord j t) N := ⟨⟨_, hzN⟩, hzN'⟩
    have ha : toΩ (cuspCoord j t) N a =
        aeval (cuspCoord j t) (X * cuspPoly (K := k)) ^ n * φ b := rfl
    have hd0 : aeval (cuspCoord j t) (X * cuspPoly (K := k)) ≠ 0 :=
      (isUnit_aeval_cuspCoord ht j).ne_zero
    have hc : IsUnit (algebraMap A As (algebraMap (coordRing k (cuspCoord j t) N) A
        (coordRingMap hu N (X * cuspPoly)))) := by
      rw [← hagree]
      exact hXG
    have hιc : ι (algebraMap A As (algebraMap (coordRing k (cuspCoord j t) N) A
        (coordRingMap hu N (X * cuspPoly)))) = aeval (cuspCoord j t) (X * cuspPoly (K := k)) := by
      rw [hι, hι₁, toΩ_apply, coordRingMap_apply]
    refine ⟨algebraMap A As (algebraMap (coordRing k (cuspCoord j t) N) A a) *
      ((hc.unit⁻¹ ^ n : Asˣ) : As),
      ?_⟩
    have hιinv : ι ((hc.unit⁻¹ : Asˣ) : As) =
        (aeval (cuspCoord j t) (X * cuspPoly (K := k)))⁻¹ := by
      rw [← hιc]
      refine eq_inv_of_mul_eq_one_left ?_
      rw [← map_mul, hc.val_inv_mul, map_one]
    rw [map_mul, hι, hι₁, ha, Units.val_pow_eq_pow_val, map_pow, hιinv, inv_pow,
      mul_comm (aeval (cuspCoord j t) _ ^ n), mul_assoc, mul_inv_cancel₀ (pow_ne_zero n hd0),
      mul_one]
  obtain ⟨ψ, hψ⟩ := exists_comp_eq_of_forall_mem_range hιinj hrange
  refine ⟨A, inferInstance, inferInstance, inferInstance, s, etale_mvAeval_of_etale_aeval het, ε,
    hεs, θ, hrel, ψ, ?_⟩
  refine RingHom.ext fun r' ↦ hιinj ?_
  rw [← RingHom.comp_apply ι, ← RingHom.comp_assoc, hψ, hφρ, ← hιθ]
  rfl

/-- **A fixed point of inertia gives a branch.** If the inertia group of a place `W ⊇ k` of `Ω`
over the cusp `j` (`v_W(u_j) < 1`) fixes a point of the fibre of `Y` at the geometric generic
point, then `Y` has a branch at `j` (an unramified point over the cusp). -/
theorem nonempty_cuspBranch_of_fixed [IsAlgClosed k] (ht : Transcendental k t) (j : Fin 3)
    {W : ValuationSubring Ω} (hWk : ∀ c : k, algebraMap k Ω c ∈ W)
    (hWj : W.valuation (cuspCoord j t) < 1)
    (Y : FiniteEtale (Spec (.of (lineRing k))))
    (x : (FiniteEtale.fiber (lineGen ht)).obj Y)
    (hx : ∀ σ ∈ GaloisPi1.inertia (P := K₀ k t) W, (lineGalois ht σ).hom.app Y x = x) :
    Nonempty (CuspBranch k (lineT k) Y.hom j) := by
  obtain ⟨φ, hφρ, hfix⟩ := exists_fixed_ringHom ht W Y x hx
  have hYfin : IsFinite Y.hom := inferInstance
  have hρ : (Y.hom.appTop.hom.comp (Scheme.ΓSpecIso (.of (lineRing k))).inv.hom).Finite :=
    (@Scheme.Hom.finite_appTop _ (Spec (.of (lineRing k))) Y.hom inferInstance hYfin).comp
      (RingHom.Finite.of_surjective _
        (Scheme.ΓSpecIso (.of (lineRing k))).commRingCatIsoToRingEquiv.symm.surjective)
  obtain ⟨N, hNfd, hφN, hNfix⟩ := exists_intermediateField_of_fixed ht j W _ hρ φ hφρ hfix
  obtain ⟨A, _, _, _, s, het, ε, hεs, θ, hrel, ψ, hψ⟩ :=
    exists_branch_ring ht j hWk hWj _ hρ φ hφρ N hφN hNfix
  have hYaff : IsAffineHom Y.hom := inferInstance
  have hYleft : IsAffine Y.left :=
    @isAffine_of_isAffineHom _ (Spec (.of (lineRing k))) Y.hom hYaff inferInstance
  refine ⟨CuspBranch.mk A s het ε hεs θ hrel
    (Spec.map (CommRingCat.ofHom ψ) ≫ Y.left.isoSpec.inv) ?_⟩
  have e1 : Y.left.isoSpec.inv ≫ Y.hom =
      Spec.map Y.hom.appTop ≫ (Spec (.of (lineRing k))).isoSpec.inv :=
    (@Scheme.isoSpec_inv_naturality Y.left (Spec (.of (lineRing k))) hYleft inferInstance
      Y.hom).symm
  calc (Spec.map (CommRingCat.ofHom ψ) ≫ Y.left.isoSpec.inv) ≫ Y.hom
      = Spec.map (CommRingCat.ofHom ψ) ≫ (Y.left.isoSpec.inv ≫ Y.hom) := Category.assoc _ _ _
    _ = Spec.map (CommRingCat.ofHom ψ) ≫ (Spec.map Y.hom.appTop ≫
          (Spec (.of (lineRing k))).isoSpec.inv) :=
        congrArg (fun g ↦ Spec.map (CommRingCat.ofHom ψ) ≫ g) e1
    _ = Spec.map (CommRingCat.ofHom ψ) ≫ (Spec.map Y.hom.appTop ≫
          Spec.map (Scheme.ΓSpecIso (.of (lineRing k))).inv) := by
        rw [Scheme.isoSpec_Spec_inv]; rfl
    _ = Spec.map ((Scheme.ΓSpecIso (.of (lineRing k))).inv ≫ Y.hom.appTop ≫
          CommRingCat.ofHom ψ) := by
        simp only [Spec.map_comp, Category.assoc]; rfl
    _ = Spec.map (CommRingCat.ofHom θ.toRingHom) :=
        congrArg Spec.map (CommRingCat.hom_ext (RingHom.ext fun r ↦ RingHom.congr_fun hψ r))

end Branch

