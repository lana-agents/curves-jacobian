import CurvesJacobian.Cusp.HemiPuncturedN
import CurvesJacobian.Cusp.HemiConstRing

/-!
# `Π_{U_V} = fill⁻¹(Π_V)` for the hemi-elliptic orbicurve, Galois form (MR8)

Let `E` be an elliptic curve over a field `K` of characteristic `0`, `N ≥ 1`,
`Ω = K(Ē)^alg`, and `M ⊆ K̄` a finite Galois extension of `K` inside the algebraic closure of
`K` in `Ω`. Write `C = [(E ∖ {O}) / ±1]` (`hemiData E`, coordinate `x`),
`U_X = [(E ∖ E[N]) / ±1]` (`hemiDataN E N`, coordinate `τ = x + 1/ΨSq_N(x)`), `V = X_M`
(`hemiDataM E M`) and `U_V = (E ∖ E[N])_M` ([AbsTopII] Cor. 3.3 (iii), IUT I Def. 3.1 (b),
Rem. 3.1.7 (i)). We work in the Galois form `π₁ = H ⧸ ⟨⟨S⟩⟩` (SGA 1 V.8.2, pi1's `equivPi1`).

Generic results (for Galois data `D₁, D₂` over `k(t₁), k(t₂)`, a map `f : H₁ → H₂` mapping
`S₁` into `S₂`, and open normal subgroups `U_i ⊇ S_i` with `f⁻¹(H_{L,2} ⊓ U₂) = H_{L,1} ⊓ U₁`):

* `CurvesJacobian.Cusp.mk_mem_range_infInclC₃_iff`: the class of `h ∈ H` lies in the image of
  `Π_V = (H_L ⊓ U) ⧸ ⟨⟨S⟩⟩` in `Π_C = H ⧸ ⟨⟨S⟩⟩` iff `h ∈ H_L ⊓ U`;
* `comap_range_infInclC₃_orbiHom₃`: the preimage of `Π_{V,2}` under `Π₁ → Π₂` is `Π_{V,1}`;
* `fillInf₃ : Π_{V,1} → Π_{V,2}` with `orbiHom₃ ∘ infInclC₃ = infInclC₃ ∘ fillInf₃`,
  surjective for `f` surjective, with kernel generated by the images of `f⁻¹(S₂) ∖ S₁`
  (`ker_fillInf₃`);
* `quotientComapEquiv₃`: `G ⧸ π⁻¹(V) ≃* P ⧸ V` for `π : G ↠ P`;
* `locCoordEquiv₃ : B₀[1/ψ] ≃ₐ[k] CoordRing k t F` for an injective `φ₀ : B₀ → Ω` from an
  integrally closed domain with `φ₀(B₀) ⊆ F`, `φ₀(B₀)` and `φ₀(ψ)⁻¹` integral over `k[t]`,
  `k[t]` inside the image of `B₀[1/ψ]` and `F` the field of fractions of `φ₀(B₀)`.

For the hemi-elliptic orbicurve:

* `CurvesJacobian.Cusp.hemiDataNM E N M := galoisDataConst₃ (hemiDataN E N) M`, the Galois data
  of `U_V` with `H_L = Gal(Ω / K(Ē)) ⊓ Gal(Ω / M)`, the same inertia as `hemiDataN E N`
  (`hemiDataNM_S`), function field `K(Ē) · M` (`hemiDataNM_L`); `Π_{U_V} ↪ Π_{U_X}` is an open
  embedding with normal image (`hemiPuncturedConst`), of index `2 · [M : K]` when `K` is a
  number field (`index_range_infInclC₃_hemiN_numberField`, from `range_piConstX_hemiN`);
* the restriction to the constants is the same at `τ` and at `x` (`galResConst_hemiHHomN`),
  so `Gal(Ω / M)` at `τ` corresponds to `Gal(Ω / M)` at `x` (`mem_constFixer₃_hemiHHomN`);
* **the fibre square** (`comap_hemiFillN_range`): under the filling map
  `hemiFillN : Π_{U_X} ↠ Π_C`, the preimage of `Π_V` is exactly `Π_{U_V}`; the induced map
  `hemiFillNM : Π_{U_V} → Π_V` is surjective (`hemiFillNM_surjective`), compatible with the
  inclusions (`hemiFillN_infInclC₃`), with kernel the closed normal subgroup generated by the
  inertia over `E[N] ∖ {O}` (`ker_hemiFillNM`, cf. `ker_hemiFillN`), and
  `hemiFillQuotEquivNM : Π_{U_X} ⧸ Π_{U_V} ≃* Π_C ⧸ Π_V` (`hemiFillQuotEquivNM_mk`);
* **the ring of `U_V`**: `hemiRNMEquiv : M[E][1/ψ_N] ≃ₐ[K] (hemiDataNM E N M).R`
  (`coverRingN (E.baseChange M) N = Γ((E ∖ E[N])_M)`), compatible with the embeddings into `Ω`
  (`algebraMap_hemiRNMEquiv`), restricting to `hemiConstREquiv` on `M[E]`
  (`algebraMap_hemiRNMEquiv_algebraMap`), with `1/ψ_N ↦ φ(ψ_N)⁻¹` and `x + (1/ψ_N)² ↦ τ`.
-/

open CategoryTheory AlgebraicGeometry Polynomial Belyi Pi1.Orbifold AffOrbicurve Topology

universe u

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace CurvesJacobian.Cusp

section GenericRange

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} [IsGalois (K₀ k t) Ω]
  (D : GaloisData k t) (U : Subgroup (Ω ≃ₐ[K₀ k t] Ω))
  (hUo : IsOpen (U : Set (Ω ≃ₐ[K₀ k t] Ω))) (hUn : U.Normal)

/-- The image of `Π_V` in `Π_C` is the image of `H_L ⊓ U`. -/
theorem range_infInclC₃_eq_map :
    (infInclC₃ D U hUo hUn).toMonoidHom.range =
      ((D.HL ⊓ U).subgroupOf D.H).map (QuotientGroup.mk' (GaloisPi1.kernel D.H D.S)) := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective x
    exact ⟨Subgroup.inclusion (galoisDataInf₃ D U hUo hUn).le x,
      Subgroup.mem_subgroupOf.2 x.2, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨QuotientGroup.mk (⟨x, Subgroup.mem_subgroupOf.1 hx⟩ :
      (galoisDataInf₃ D U hUo hUn).HL), rfl⟩

variable {D U} in
omit [IsGalois (K₀ k t) Ω] in
include hUo hUn in
/-- `⟨⟨S⟩⟩ ≤ H_L ⊓ U` for `S ⊆ U`. -/
lemma kernel_le_inf₃ (hSU : D.S ⊆ U) :
    GaloisPi1.kernel D.H D.S ≤ (D.HL ⊓ U).subgroupOf D.H := by
  have h := kernel_le_subgroupOf (galoisDataInf₃ D U hUo hUn)
  rwa [galoisDataInf₃_S D U hUo hUn hSU] at h

variable {D U hUo hUn} in
/-- **Membership in `Π_V`**: the class of `h ∈ H` lies in the image of `Π_V` iff
`h ∈ H_L ⊓ U`. -/
theorem mk_mem_range_infInclC₃_iff (hSU : D.S ⊆ U) (h : D.H) :
    (QuotientGroup.mk h : GaloisPi1.pi1 D.H D.S D.isClosed_H) ∈
      (infInclC₃ D U hUo hUn).toMonoidHom.range ↔ (h : Ω ≃ₐ[K₀ k t] Ω) ∈ D.HL ⊓ U := by
  rw [range_infInclC₃_eq_map]
  constructor
  · rintro ⟨g, hg, he⟩
    have hk : g⁻¹ * h ∈ GaloisPi1.kernel D.H D.S := QuotientGroup.eq.1 he
    have h2 := ((D.HL ⊓ U).subgroupOf D.H).mul_mem hg (kernel_le_inf₃ hUo hUn hSU hk)
    rw [mul_inv_cancel_left] at h2
    exact Subgroup.mem_subgroupOf.1 h2
  · intro hh
    exact ⟨h, Subgroup.mem_subgroupOf.2 hh, rfl⟩

end GenericRange

section GenericFibre

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t₁ t₂ : Ω}
  (D₁ : GaloisData k t₁) (D₂ : GaloisData k t₂)
  (f : D₁.H →* D₂.H) (hf : Continuous f) (hfS : ∀ s (hs : s ∈ D₁.S),
    ((f ⟨s, D₁.le (D₁.S_subset_HL hs)⟩ : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.S)
  (U₁ : Subgroup (Ω ≃ₐ[K₀ k t₁] Ω)) (hUo₁ : IsOpen (U₁ : Set (Ω ≃ₐ[K₀ k t₁] Ω)))
  (hUn₁ : U₁.Normal)
  (U₂ : Subgroup (Ω ≃ₐ[K₀ k t₂] Ω)) (hUo₂ : IsOpen (U₂ : Set (Ω ≃ₐ[K₀ k t₂] Ω)))
  (hUn₂ : U₂.Normal)
  (hfU : ∀ h : D₁.H, ((f h : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.HL ⊓ U₂ ↔
    (h : Ω ≃ₐ[K₀ k t₁] Ω) ∈ D₁.HL ⊓ U₁)

/-- The map `H_{L,1} ⊓ U₁ → H_{L,2} ⊓ U₂` induced by `f`. -/
def fillInfHom₃ : (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL →* (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).HL :=
  MonoidHom.codRestrict (D₂.H.subtype.comp (f.comp
    (Subgroup.inclusion (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le)))
    (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).HL fun n =>
      (hfU (Subgroup.inclusion (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le n)).2 n.2

lemma fillInfHom₃_coe (n : (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL) :
    ((fillInfHom₃ D₁ D₂ f U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU n :
      (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).HL) : Ω ≃ₐ[K₀ k t₂] Ω) =
      ((f (Subgroup.inclusion (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le n) : D₂.H) :
        Ω ≃ₐ[K₀ k t₂] Ω) := rfl

include hf in
lemma continuous_fillInfHom₃ : Continuous (fillInfHom₃ D₁ D₂ f U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU) :=
  continuous_induced_rng.2 ((continuous_subtype_val.comp hf).comp
    (continuous_inclusion (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le))

section Inv

variable (f' : D₂.H →* D₁.H) (hff' : ∀ x, f (f' x) = x)

/-- The inverse map `H_{L,2} ⊓ U₂ → H_{L,1} ⊓ U₁`. -/
def fillInfInvHom₃ :
    (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).HL →* (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL :=
  MonoidHom.codRestrict (D₁.H.subtype.comp (f'.comp
    (Subgroup.inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le)))
    (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL fun n => by
      have he : f (f' (Subgroup.inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le n)) =
          Subgroup.inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le n := hff' _
      have hm : ((f (f' (Subgroup.inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le n)) : D₂.H) :
          Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.HL ⊓ U₂ := by
        rw [he]
        exact n.2
      exact (hfU _).1 hm

end Inv

variable [IsGalois (K₀ k t₁) Ω] [IsGalois (K₀ k t₂) Ω]

include hfU in
/-- **The fibre square**: the preimage of `Π_{V,2}` under `Π₁ → Π₂` is `Π_{V,1}`. -/
theorem comap_range_infInclC₃_orbiHom₃ (hSU₁ : D₁.S ⊆ U₁) (hSU₂ : D₂.S ⊆ U₂) :
    (infInclC₃ D₂ U₂ hUo₂ hUn₂).toMonoidHom.range.comap
      (orbiHom₃ D₁ D₂ f hf hfS).toMonoidHom = (infInclC₃ D₁ U₁ hUo₁ hUn₁).toMonoidHom.range := by
  ext y
  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective y
  rw [Subgroup.mem_comap]
  have e : (orbiHom₃ D₁ D₂ f hf hfS).toMonoidHom
      (QuotientGroup.mk h : D₁.H ⧸ GaloisPi1.kernel D₁.H D₁.S) =
      (QuotientGroup.mk (f h) : D₂.H ⧸ GaloisPi1.kernel D₂.H D₂.S) := rfl
  rw [e, mk_mem_range_infInclC₃_iff hSU₂, mk_mem_range_infInclC₃_iff hSU₁, hfU]

/-- **The induced map `Π_{V,1} = (H_{L,1} ⊓ U₁) ⧸ ⟨⟨S₁⟩⟩ → Π_{V,2}`.** -/
def fillInf₃ (hSU₂ : D₂.S ⊆ U₂) :
    GaloisPi1.pi1 (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).S
      (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).isClosed_HL →ₜ*
    GaloisPi1.pi1 (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).HL (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).S
      (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).isClosed_HL :=
  pi1Hom₃ _ _ (fillInfHom₃ D₁ D₂ f U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU)
    (continuous_fillInfHom₃ D₁ D₂ f hf U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU)
    (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).S_subset_HL
    fun s hs => S_inf_supset₃ hSU₂ (hfS s (S_inf_subset₃ D₁ U₁ hUo₁ hUn₁ hs))

/-- **Compatibility**: `(Π₁ → Π₂) ∘ (Π_{V,1} → Π₁) = (Π_{V,2} → Π₂) ∘ (Π_{V,1} → Π_{V,2})`. -/
theorem orbiHom₃_infInclC₃ (hSU₂ : D₂.S ⊆ U₂)
    (y : GaloisPi1.pi1 (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).S
      (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).isClosed_HL) :
    orbiHom₃ D₁ D₂ f hf hfS (infInclC₃ D₁ U₁ hUo₁ hUn₁ y) =
      infInclC₃ D₂ U₂ hUo₂ hUn₂ (fillInf₃ D₁ D₂ f hf hfS U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU hSU₂ y) := by
  obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective y
  rfl

/-- `Π_{V,1} → Π_{V,2}` is surjective if `f` is. -/
theorem fillInf₃_surjective (hSU₂ : D₂.S ⊆ U₂) (hsurj : Function.Surjective f) :
    Function.Surjective (fillInf₃ D₁ D₂ f hf hfS U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU hSU₂) := by
  refine pi1Hom₃_surjective _ _ _ _ _ _ fun m => ?_
  obtain ⟨h, hh⟩ := hsurj ⟨m.1, (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le m.2⟩
  have hm : ((f h : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.HL ⊓ U₂ := by
    rw [hh]
    exact m.2
  refine ⟨⟨h.1, (hfU h).1 hm⟩, Subtype.ext ?_⟩
  rw [fillInfHom₃_coe]
  exact congrArg Subtype.val hh

/-- **The kernel of `Π_{V,1} ↠ Π_{V,2}`** (for `f` bijective): the closed normal subgroup
generated by the images of the elements of `(H_{L,1} ⊓ U₁) ∩ f⁻¹(S₂) ∖ S₁`. -/
theorem ker_fillInf₃ (f' : D₂.H →* D₁.H) (hf' : Continuous f') (hff' : ∀ x, f (f' x) = x)
    (hf'f : ∀ x, f' (f x) = x) (hSU₁ : D₁.S ⊆ U₁) (hSU₂ : D₂.S ⊆ U₂) :
    (fillInf₃ D₁ D₂ f hf hfS U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU hSU₂).toMonoidHom.ker =
      (Subgroup.normalClosure ((QuotientGroup.mk' (GaloisPi1.kernel
        (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).S) :
          (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL →* GaloisPi1.pi1 _ _
            (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).isClosed_HL) ''
        (Subtype.val ⁻¹' ({σ | ∃ h : σ ∈ D₁.H, ((f ⟨σ, h⟩ : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.S} \
          D₁.S) : Set (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL))).topologicalClosure := by
  have hset : ({σ | ∃ h : σ ∈ (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL,
      ((fillInfHom₃ D₁ D₂ f U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU ⟨σ, h⟩ :
        (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).HL) : Ω ≃ₐ[K₀ k t₂] Ω) ∈
        (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).S} \ (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).S) ∩
        (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL =
      ({σ | ∃ h : σ ∈ D₁.H, ((f ⟨σ, h⟩ : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.S} \ D₁.S) ∩
        (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL := by
    rw [galoisDataInf₃_S D₁ U₁ hUo₁ hUn₁ hSU₁, galoisDataInf₃_S D₂ U₂ hUo₂ hUn₂ hSU₂]
    ext σ
    constructor
    · rintro ⟨⟨⟨h, hs⟩, hn⟩, hL⟩
      exact ⟨⟨⟨(galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le h, hs⟩, hn⟩, hL⟩
    · rintro ⟨⟨⟨_, hs⟩, hn⟩, hL⟩
      exact ⟨⟨⟨hL, hs⟩, hn⟩, hL⟩
  have hpre : (Subtype.val ⁻¹' ({σ | ∃ h : σ ∈ (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL,
      ((fillInfHom₃ D₁ D₂ f U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU ⟨σ, h⟩ :
        (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).HL) : Ω ≃ₐ[K₀ k t₂] Ω) ∈
        (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).S} \ (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).S) :
          Set (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).HL) =
      Subtype.val ⁻¹' ({σ | ∃ h : σ ∈ D₁.H, ((f ⟨σ, h⟩ : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) ∈ D₂.S} \
        D₁.S) := by
    ext σ
    have h := congrArg (fun T : Set (Ω ≃ₐ[K₀ k t₁] Ω) => σ.1 ∈ T) hset
    simp only [Set.mem_inter_iff, eq_iff_iff] at h
    simp only [Set.mem_preimage]
    exact ⟨fun h1 => (h.1 ⟨h1, σ.2⟩).1, fun h1 => (h.2 ⟨h1, σ.2⟩).1⟩
  rw [← hpre]
  exact ker_pi1Hom₃_eq _ _ _ _ _ _ (fun _ hs => (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).S_subset_HL hs)
    (fillInfInvHom₃ D₁ D₂ f U₁ hUo₁ hUn₁ U₂ hUo₂ hUn₂ hfU f' hff')
    (continuous_induced_rng.2 ((continuous_subtype_val.comp hf').comp
      (continuous_inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le)))
    (fun x => Subtype.ext (show ((f (f' (Subgroup.inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le
        x)) : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) =
        ((Subgroup.inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le x : D₂.H) : Ω ≃ₐ[K₀ k t₂] Ω) from
      congrArg Subtype.val (hff' (Subgroup.inclusion (galoisDataInf₃ D₂ U₂ hUo₂ hUn₂).le x))))
    (fun x => Subtype.ext (show ((f' (f (Subgroup.inclusion (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le
        x)) : D₁.H) : Ω ≃ₐ[K₀ k t₁] Ω) =
        ((Subgroup.inclusion (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le x : D₁.H) : Ω ≃ₐ[K₀ k t₁] Ω) from
      congrArg Subtype.val (hf'f (Subgroup.inclusion (galoisDataInf₃ D₁ U₁ hUo₁ hUn₁).le x))))

end GenericFibre

section GenericQuot

/-- **`G ⧸ π⁻¹(V) ≃* P ⧸ V`** for a surjective `π : G →* P` and `V ⊴ P`. -/
def quotientComapEquiv₃ {G P : Type*} [Group G] [Group P] {π : G →* P}
    (hπ : Function.Surjective π) (V : Subgroup P) [V.Normal] : G ⧸ V.comap π ≃* P ⧸ V :=
  (QuotientGroup.quotientMulEquivOfEq (by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
    rfl)).trans
    (QuotientGroup.quotientKerEquivOfSurjective ((QuotientGroup.mk' V).comp π)
      ((QuotientGroup.mk'_surjective V).comp hπ))

lemma quotientComapEquiv₃_mk {G P : Type*} [Group G] [Group P] {π : G →* P}
    (hπ : Function.Surjective π) (V : Subgroup P) [V.Normal] (x : G) :
    quotientComapEquiv₃ hπ V (QuotientGroup.mk x) = QuotientGroup.mk (π x) := rfl

end GenericQuot

section GenericLoc

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} {B₀ : Type*} [CommRing B₀]
  (φ₀ : B₀ →+* Ω) (ψ : B₀) (hψ : φ₀ ψ ≠ 0)

/-- The extension `B₀[1/ψ] → Ω` of `φ₀ : B₀ → Ω` (for `φ₀(ψ) ≠ 0`). -/
def locLift₃ : Localization.Away ψ →+* Ω := IsLocalization.Away.lift ψ (Ne.isUnit hψ)

lemma locLift₃_algebraMap (a : B₀) :
    locLift₃ φ₀ ψ hψ (algebraMap B₀ (Localization.Away ψ) a) = φ₀ a :=
  IsLocalization.Away.lift_eq _ _ a

lemma locLift₃_invSelf : locLift₃ φ₀ ψ hψ (IsLocalization.Away.invSelf ψ) = (φ₀ ψ)⁻¹ := by
  apply eq_inv_of_mul_eq_one_right
  rw [← locLift₃_algebraMap φ₀ ψ hψ, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]

lemma locLift₃_add_pow (b₁ : B₀) (n : ℕ) :
    locLift₃ φ₀ ψ hψ (algebraMap B₀ (Localization.Away ψ) b₁ +
      IsLocalization.Away.invSelf ψ ^ n) = φ₀ b₁ + (φ₀ ψ)⁻¹ ^ n := by
  rw [map_add, map_pow, locLift₃_algebraMap, locLift₃_invSelf]

include hψ in
lemma ne_zero_of_locLift₃ : ψ ≠ 0 := fun h0 => hψ (by rw [h0, map_zero])

/-- `B₀[1/ψ] → Ω` is injective if `φ₀` is. -/
theorem locLift₃_injective [IsDomain B₀] (hφ₀ : Function.Injective φ₀) :
    Function.Injective (locLift₃ φ₀ ψ hψ) := by
  have hinj : Function.Injective (algebraMap B₀ (Localization.Away ψ)) :=
    IsLocalization.injective _
      (powers_le_nonZeroDivisors_of_noZeroDivisors (ne_zero_of_locLift₃ φ₀ ψ hψ))
  unfold locLift₃ IsLocalization.Away.lift
  rw [IsLocalization.lift_injective_iff]
  intro a b
  exact ⟨fun h => by rw [hinj h], fun h => by rw [hφ₀ h]⟩

/-- Every value of `B₀[1/ψ] → Ω` is `φ₀(a) · φ₀(ψ)⁻ⁿ`. -/
lemma locLift₃_eq (b : Localization.Away ψ) :
    ∃ (a : B₀) (n : ℕ), locLift₃ φ₀ ψ hψ b = φ₀ a * (φ₀ ψ)⁻¹ ^ n := by
  obtain ⟨p, h⟩ := IsLocalization.surj (Submonoid.powers ψ) b
  obtain ⟨n, hn⟩ := p.2.2
  refine ⟨p.1, n, ?_⟩
  rw [← hn] at h
  have h1 := congrArg (locLift₃ φ₀ ψ hψ) h
  rw [map_mul, locLift₃_algebraMap, locLift₃_algebraMap, map_pow] at h1
  rw [← h1, inv_pow, mul_assoc, mul_inv_cancel₀ (pow_ne_zero n hψ), mul_one]

variable (F : IntermediateField (K₀ k t) Ω) (hL : ∀ a, φ₀ a ∈ F)
  (hI : ∀ a, IsIntegral (A₀ k t) (φ₀ a)) (hInv : IsIntegral (A₀ k t) (φ₀ ψ)⁻¹)

include hL hI hInv in
lemma locLift₃_mem (b : Localization.Away ψ) :
    locLift₃ φ₀ ψ hψ b ∈ F ∧ IsIntegral (A₀ k t) (locLift₃ φ₀ ψ hψ b) := by
  obtain ⟨a, n, h⟩ := locLift₃_eq φ₀ ψ hψ b
  rw [h]
  exact ⟨mul_mem (hL a) (pow_mem (inv_mem (hL ψ)) n), (hI a).mul (hInv.pow n)⟩

/-- `B₀[1/ψ] → CoordRing k t F`. -/
def locCoordHom₃ : Localization.Away ψ →+* CoordRing k t F where
  toFun b := CoordRing.mk (locLift₃ φ₀ ψ hψ b) (locLift₃_mem φ₀ ψ hψ F hL hI hInv b).1
    (locLift₃_mem φ₀ ψ hψ F hL hI hInv b).2
  map_one' := CoordRing.ext (by simp only [CoordRing.algebraMap_mk, map_one])
  map_mul' a b := CoordRing.ext (by simp only [CoordRing.algebraMap_mk, map_mul])
  map_zero' := CoordRing.ext (by simp only [CoordRing.algebraMap_mk, map_zero])
  map_add' a b := CoordRing.ext (by simp only [CoordRing.algebraMap_mk, map_add])

lemma algebraMap_locCoordHom₃ (b : Localization.Away ψ) :
    algebraMap (CoordRing k t F) Ω (locCoordHom₃ φ₀ ψ hψ F hL hI hInv b) =
      locLift₃ φ₀ ψ hψ b := rfl

/-- **Surjectivity criterion**: if `B₀` is integrally closed, `φ₀` injective, `k[t]` lies in the
image of `B₀[1/ψ]`, and every element of `F` is a quotient of values of `φ₀`, then
`B₀[1/ψ] → CoordRing k t F` is surjective. -/
theorem locCoordHom₃_surjective [IsDomain B₀] [IsIntegrallyClosed B₀] (hφ₀ : Function.Injective φ₀)
    (hk : ∀ c : k, ∃ b, φ₀ b = algebraMap k Ω c)
    (ht : ∃ (b₁ : B₀) (n : ℕ), φ₀ b₁ + (φ₀ ψ)⁻¹ ^ n = t)
    (hfrac : ∀ z ∈ F, ∃ d b : B₀, φ₀ d ≠ 0 ∧ φ₀ d * z = φ₀ b) :
    Function.Surjective (locCoordHom₃ φ₀ ψ hψ F hL hI hInv) := by
  intro r
  have hle := powers_le_nonZeroDivisors_of_noZeroDivisors (ne_zero_of_locLift₃ φ₀ ψ hψ)
  haveI : IsDomain (Localization.Away ψ) := IsLocalization.isDomain_localization hle
  haveI : IsIntegrallyClosed (Localization.Away ψ) :=
    isIntegrallyClosed_of_isLocalization _ _ hle
  have hA : ∀ a : A₀ k t, algebraMap (A₀ k t) Ω a ∈ (locLift₃ φ₀ ψ hψ).range := by
    rintro ⟨a, ha⟩
    change a ∈ (locLift₃ φ₀ ψ hψ).range
    induction ha using Algebra.adjoin_induction with
    | mem w hw =>
      rw [Set.mem_singleton_iff] at hw
      obtain ⟨b₁, n, hb⟩ := ht
      exact ⟨_, (locLift₃_add_pow φ₀ ψ hψ b₁ n).trans (hb.trans hw.symm)⟩
    | algebraMap c =>
      obtain ⟨b, hb⟩ := hk c
      exact ⟨_, (locLift₃_algebraMap φ₀ ψ hψ b).trans hb⟩
    | add w v _ _ hw hv => exact add_mem hw hv
    | mul w v _ _ hw hv => exact mul_mem hw hv
  obtain ⟨d, b, hd, hdb⟩ := hfrac _ (CoordRing.algebraMap_mem r)
  have hd' : locLift₃ φ₀ ψ hψ (algebraMap B₀ (Localization.Away ψ) d) ≠ 0 := by
    rw [locLift₃_algebraMap]
    exact hd
  have hdb' : locLift₃ φ₀ ψ hψ (algebraMap B₀ (Localization.Away ψ) d) *
      algebraMap (CoordRing k t F) Ω r =
      locLift₃ φ₀ ψ hψ (algebraMap B₀ (Localization.Away ψ) b) := by
    rw [locLift₃_algebraMap, locLift₃_algebraMap]
    exact hdb
  obtain ⟨y, hy⟩ := mem_range_of_isIntegral₃ (locLift₃ φ₀ ψ hψ) (locLift₃_injective φ₀ ψ hψ hφ₀)
    hA (CoordRing.isIntegral_algebraMap r) hd' hdb'
  exact ⟨y, CoordRing.ext hy⟩

/-- **`B₀[1/ψ] ≃ₐ[k] CoordRing k t F`** under the hypotheses of `locCoordHom₃_surjective`. -/
def locCoordEquiv₃ [IsDomain B₀] [IsIntegrallyClosed B₀] [Algebra k B₀]
    (hφ₀ : Function.Injective φ₀)
    (hk : ∀ c : k, ∃ b, φ₀ b = algebraMap k Ω c)
    (ht : ∃ (b₁ : B₀) (n : ℕ), φ₀ b₁ + (φ₀ ψ)⁻¹ ^ n = t)
    (hfrac : ∀ z ∈ F, ∃ d b : B₀, φ₀ d ≠ 0 ∧ φ₀ d * z = φ₀ b)
    (hcomm : ∀ c : k, φ₀ (algebraMap k B₀ c) = algebraMap k Ω c) :
    Localization.Away ψ ≃ₐ[k] CoordRing k t F :=
  AlgEquiv.ofRingEquiv (f := RingEquiv.ofBijective (locCoordHom₃ φ₀ ψ hψ F hL hI hInv)
    ⟨fun _ _ h => locLift₃_injective φ₀ ψ hψ hφ₀ (congrArg (algebraMap (CoordRing k t F) Ω) h),
      locCoordHom₃_surjective φ₀ ψ hψ F hL hI hInv hφ₀ hk ht hfrac⟩) fun c => CoordRing.ext (by
    change locLift₃ φ₀ ψ hψ (algebraMap k (Localization.Away ψ) c) = _
    rw [IsScalarTower.algebraMap_apply k B₀ (Localization.Away ψ), locLift₃_algebraMap, hcomm,
      ← IsScalarTower.algebraMap_apply])

lemma algebraMap_locCoordEquiv₃ [IsDomain B₀] [IsIntegrallyClosed B₀] [Algebra k B₀]
    (hφ₀ : Function.Injective φ₀) (hk : ∀ c : k, ∃ b, φ₀ b = algebraMap k Ω c)
    (ht : ∃ (b₁ : B₀) (n : ℕ), φ₀ b₁ + (φ₀ ψ)⁻¹ ^ n = t)
    (hfrac : ∀ z ∈ F, ∃ d b : B₀, φ₀ d ≠ 0 ∧ φ₀ d * z = φ₀ b)
    (hcomm : ∀ c : k, φ₀ (algebraMap k B₀ c) = algebraMap k Ω c) (b : Localization.Away ψ) :
    algebraMap (CoordRing k t F) Ω
      (locCoordEquiv₃ φ₀ ψ hψ F hL hI hInv hφ₀ hk ht hfrac hcomm b) = locLift₃ φ₀ ψ hψ b := rfl

end GenericLoc

section Hemi

variable {K : Type u} [Field K] [CharZero K] (E : WeierstrassCurve K) [E.IsElliptic] (N : ℕ)
  [NeZero N] (M : IntermediateField K (ConstField₂ K (FFClosure (curveE E))))

/-- **The restriction to the constants is the same at `τ` and at `x`.** -/
lemma galResConst_hemiHHomN (h : (hemiDataN E N).H) :
    galResConst (coordT (xN E)) ((hemiHHomN E N h : (hemiData E).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) =
      galResConst (coordT (tauN₃ E N)) (h :
        FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) :=
  AlgEquiv.ext fun c => Subtype.ext (by
    rw [galResConst_apply, galResConst_apply]
    exact hemiHHomN_apply E N h c)

/-- **`Gal(Ω / M)` at `τ` and at `x` correspond under `H_τ ≅ H_x`.** -/
lemma mem_constFixer₃_hemiHHomN (h : (hemiDataN E N).H) :
    ((hemiHHomN E N h : (hemiData E).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) ∈
        constFixer₃ (coordT (xN E)) M ↔
      (h : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) ∈
        constFixer₃ (coordT (tauN₃ E N)) M := by
  change galResConst _ _ ∈ M.fixingSubgroup ↔ galResConst _ _ ∈ M.fixingSubgroup
  rw [galResConst_hemiHHomN]

lemma mem_HL_hemiHHomN (h : (hemiDataN E N).H) :
    ((hemiHHomN E N h : (hemiData E).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) ∈ (hemiData E).HL ↔
      (h : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) ∈
        (hemiDataN E N).HL := by
  rw [mem_hemiData_HL_iff, mem_hemiDataN_HL_iff]
  simp only [hemiHHomN_apply]

/-- `H_τ ≅ H_x` maps `H_{L,τ} ⊓ Gal(Ω / M)` onto `H_{L,x} ⊓ Gal(Ω / M)`. -/
lemma mem_inf_hemiHHomN (h : (hemiDataN E N).H) :
    ((hemiHHomN E N h : (hemiData E).H) :
      FFClosure (curveE E) ≃ₐ[K₀ K (coordT (xN E))] FFClosure (curveE E)) ∈
        (hemiData E).HL ⊓ constFixer₃ (coordT (xN E)) M ↔
      (h : FFClosure (curveE E) ≃ₐ[K₀ K (coordT (tauN₃ E N))] FFClosure (curveE E)) ∈
        (hemiDataN E N).HL ⊓ constFixer₃ (coordT (tauN₃ E N)) M :=
  Subgroup.mem_inf.trans ((and_congr (mem_HL_hemiHHomN E N h)
    (mem_constFixer₃_hemiHHomN E N M h)).trans Subgroup.mem_inf.symm)

variable [FiniteDimensional K M] [IsGalois K M]

/-- **The Galois data of `U_V = (E ∖ E[N])_M`** inside `U_X = [(E ∖ E[N]) / ±1]`:
`H = Gal(Ω / K(x))` (inside `Gal(Ω / K(τ))`), `H_L = Gal(Ω / K(Ē)) ⊓ Gal(Ω / M)`. -/
abbrev hemiDataNM : GaloisData K (coordT (tauN₃ E N)) := galoisDataConst₃ (hemiDataN E N) M

lemma hemiDataNM_H : (hemiDataNM E N M).H = (hemiDataN E N).H := rfl

lemma hemiDataNM_HL :
    (hemiDataNM E N M).HL = (hemiDataN E N).HL ⊓ constFixer₃ (coordT (tauN₃ E N)) M := rfl

/-- **Same inertia** as `hemiDataN E N`. -/
theorem hemiDataNM_S : (hemiDataNM E N M).S = (hemiDataN E N).S :=
  galoisDataInf₃_S _ _ _ _ (S_subset_constFixer₃ _ M)

/-- **`L_{U_V} = K(Ē) · M`.** -/
theorem hemiDataNM_L : (hemiDataNM E N M).L =
    (hemiDataN E N).L ⊔ IntermediateField.adjoin (K₀ K (coordT (tauN₃ E N))) (constSet₃ M) :=
  L_galoisDataConst₃ _ M

/-- **`Π_{U_V} ↪ Π_U ↪ Π_{U_X}`**: open embeddings, compatible, with `Π_{U_V}` normal in
`Π_{U_X}` and compatible with the projections to `Gal(K̄ / K)`. -/
theorem hemiPuncturedConst :
    IsOpenEmbedding (infInclX₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
      (constFixer₃_normal M)) ∧
      IsOpenEmbedding (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M)) ∧
      (∀ x, orbiIncl (hemiDataN E N) (infInclX₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M) x) =
          infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M) (constFixer₃_normal M) x) ∧
      (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M)).toMonoidHom.range.Normal ∧
      (piConstC (hemiDataN E N)).comp (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M)).toMonoidHom = piConstX (hemiDataNM E N M) ∧
      (piConstX (hemiDataNM E N M)).range =
        (piConstX (hemiDataN E N)).range ⊓ M.fixingSubgroup := by
  have hSU := S_subset_constFixer₃ (hemiDataN E N) M
  exact ⟨isOpenEmbedding_infInclX₃ hSU, isOpenEmbedding_infInclC₃ hSU,
    orbiIncl_infInclX₃ _ _ _ _, range_infInclC₃_normal hSU,
    piConstC_comp_infInclC₃ _ M, range_piConstX_inf₃ _ M⟩

lemma piConstX_hemiFillLN (y : GaloisPi1.pi1 (hemiDataN E N).HL (hemiDataN E N).S
    (hemiDataN E N).isClosed_HL) :
    piConstX (hemiData E) (hemiFillLN E N y) = piConstX (hemiDataN E N) y := by
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective y
  exact AlgEquiv.ext fun c => Subtype.ext (hemiHLHomN_apply E N n c)

/-- `im(Π_U → Gal(K̄ / K)) = im(Π_X → Gal(K̄ / K))`. -/
theorem range_piConstX_hemiN_eq :
    (piConstX (hemiDataN E N)).range = (piConstX (hemiData E)).range := by
  ext g
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨hemiFillLN E N y, piConstX_hemiFillLN E N y⟩
  · rintro ⟨x, rfl⟩
    obtain ⟨y, rfl⟩ := hemiFillLN_surjective E N x
    exact ⟨y, (piConstX_hemiFillLN E N y).symm⟩

/-- **Geometric connectedness of `E ∖ E[N]`, for `K` a number field**: `Π_U → Gal(K̄ / K)` is
surjective. -/
theorem range_piConstX_hemiN [NumberField K] : (piConstX (hemiDataN E N)).range = ⊤ := by
  rw [range_piConstX_hemiN_eq, range_piConstX_hemi]

/-- **`[Π_{U_X} : Π_{U_V}] = 2 · [M : K]`**, given surjectivity of `Π_U → Gal(K̄ / K)`. -/
theorem index_range_infInclC₃_hemiN_of_top (hgeom : (piConstX (hemiDataN E N)).range = ⊤) :
    (piConstX (hemiDataNM E N M)).range = M.fixingSubgroup ∧
      (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M)).toMonoidHom.range.index = 2 * Module.finrank K M := by
  refine ⟨range_piConstX_inf₃_of_top _ M hgeom, ?_⟩
  rw [index_range_infInclC₃_of_top _ M hgeom, ← index_range_orbiIncl (hemiDataN E N),
    index_range_orbiIncl_hemiN]

/-- **For `K` a number field** (e.g. `F_mod`): the image of `Π_{U_V}` in `Gal(K̄ / K)` is
`Gal(K̄ / M)` and `[Π_{U_X} : Π_{U_V}] = 2 · [M : K]`. -/
theorem index_range_infInclC₃_hemiN_numberField [NumberField K] :
    (piConstX (hemiDataNM E N M)).range = M.fixingSubgroup ∧
      (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M)).toMonoidHom.range.index = 2 * Module.finrank K M :=
  index_range_infInclC₃_hemiN_of_top E N M (range_piConstX_hemiN E N)

/-! ### The fibre square `Π_{U_V} = fill⁻¹(Π_V)` -/

/-- **[AbsTopII] Cor. 3.3 (iii): `Π_{U_V} = fill⁻¹(Π_V)`.** Under the filling map
`hemiFillN : Π_{U_X} ↠ Π_C`, the preimage of `Π_V` (`V = X_M`) is `Π_{U_V}`. -/
theorem comap_hemiFillN_range :
    (infInclC₃ (hemiData E) _ (isOpen_constFixer₃ M)
      (constFixer₃_normal M)).toMonoidHom.range.comap (hemiFillN E N).toMonoidHom =
      (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M)).toMonoidHom.range :=
  comap_range_infInclC₃_orbiHom₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N)
    (continuous_hemiHHomN E N) (fun s hs => hemiHEquivN_mem_S E N s hs) (constFixer₃ _ M)
    (isOpen_constFixer₃ M) (constFixer₃_normal M) (constFixer₃ _ M) (isOpen_constFixer₃ M)
    (constFixer₃_normal M) (mem_inf_hemiHHomN E N M) (S_subset_constFixer₃ _ M)
    (S_subset_constFixer₃ _ M)

/-- **The induced map `Π_{U_V} → Π_V`** (filling in the cusps over `E[N] ∖ {O}` of
`U_V = (E ∖ E[N])_M` in `V = (E ∖ {O})_M`). -/
def hemiFillNM :
    GaloisPi1.pi1 (hemiDataNM E N M).HL (hemiDataNM E N M).S (hemiDataNM E N M).isClosed_HL →ₜ*
      GaloisPi1.pi1 (hemiDataM E M).HL (hemiDataM E M).S (hemiDataM E M).isClosed_HL :=
  fillInf₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N) (continuous_hemiHHomN E N)
    (fun s hs => hemiHEquivN_mem_S E N s hs) (constFixer₃ _ M) (isOpen_constFixer₃ M)
    (constFixer₃_normal M) (constFixer₃ _ M) (isOpen_constFixer₃ M) (constFixer₃_normal M)
    (mem_inf_hemiHHomN E N M)
    (S_subset_constFixer₃ _ M)

/-- **Compatibility**: `hemiFillN ∘ (Π_{U_V} → Π_{U_X}) = (Π_V → Π_C) ∘ hemiFillNM`. -/
theorem hemiFillN_infInclC₃ (y : GaloisPi1.pi1 (hemiDataNM E N M).HL (hemiDataNM E N M).S
    (hemiDataNM E N M).isClosed_HL) :
    hemiFillN E N (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
      (constFixer₃_normal M) y) =
      infInclC₃ (hemiData E) _ (isOpen_constFixer₃ M) (constFixer₃_normal M)
        (hemiFillNM E N M y) :=
  orbiHom₃_infInclC₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N) (continuous_hemiHHomN E N)
    (fun s hs => hemiHEquivN_mem_S E N s hs) (constFixer₃ _ M) (isOpen_constFixer₃ M)
    (constFixer₃_normal M) (constFixer₃ _ M) (isOpen_constFixer₃ M) (constFixer₃_normal M)
    (mem_inf_hemiHHomN E N M)
    (S_subset_constFixer₃ _ M) y

/-- **`Π_{U_V} ↠ Π_V` is surjective.** -/
theorem hemiFillNM_surjective : Function.Surjective (hemiFillNM E N M) :=
  fillInf₃_surjective (hemiDataN E N) (hemiData E) (hemiHHomN E N) (continuous_hemiHHomN E N)
    (fun s hs => hemiHEquivN_mem_S E N s hs) (constFixer₃ _ M) (isOpen_constFixer₃ M)
    (constFixer₃_normal M) (constFixer₃ _ M) (isOpen_constFixer₃ M) (constFixer₃_normal M)
    (mem_inf_hemiHHomN E N M)
    (S_subset_constFixer₃ _ M) (hemiHHomN_surjective E N)

/-- **The kernel of `Π_{U_V} ↠ Π_V`** is the closed normal subgroup generated by the images of
the inertia elements `S_x ∖ S_τ` (at the places over `E[N] ∖ {O}`) lying in `Π_{U_V}`
(cf. `ker_hemiFillN`). -/
theorem ker_hemiFillNM : (hemiFillNM E N M).toMonoidHom.ker =
    (Subgroup.normalClosure ((QuotientGroup.mk' (GaloisPi1.kernel (hemiDataNM E N M).HL
      (hemiDataNM E N M).S) : (hemiDataNM E N M).HL →* GaloisPi1.pi1 (hemiDataNM E N M).HL
        (hemiDataNM E N M).S (hemiDataNM E N M).isClosed_HL) ''
      (Subtype.val ⁻¹' (hemiSxN E N \ (hemiDataN E N).S) :
        Set (hemiDataNM E N M).HL))).topologicalClosure :=
  ker_fillInf₃ (hemiDataN E N) (hemiData E) (hemiHHomN E N) (continuous_hemiHHomN E N)
    (fun s hs => hemiHEquivN_mem_S E N s hs) (constFixer₃ _ M) (isOpen_constFixer₃ M)
    (constFixer₃_normal M) (constFixer₃ _ M) (isOpen_constFixer₃ M) (constFixer₃_normal M)
    (mem_inf_hemiHHomN E N M)
    (hemiHEquivN E N).symm.toMulEquiv.toMonoidHom (hemiHEquivN E N).symm.continuous_toFun
    (fun x => (hemiHEquivN E N).apply_symm_apply x) (fun x => (hemiHEquivN E N).symm_apply_apply x)
    (S_subset_constFixer₃ _ M) (S_subset_constFixer₃ _ M)

/-- **`Π_{U_X} ⧸ Π_{U_V} ≃* Π_C ⧸ Π_V`**, induced by the filling map. -/
def hemiFillQuotEquivNM :
    letI := range_infInclC₃_normal (hUo := isOpen_constFixer₃ M) (hUn := constFixer₃_normal M)
      (S_subset_constFixer₃ (hemiDataN E N) M)
    letI := range_infInclC₃_normal (hUo := isOpen_constFixer₃ M) (hUn := constFixer₃_normal M)
      (S_subset_constFixer₃ (hemiData E) M)
    GaloisPi1.pi1 (hemiDataN E N).H (hemiDataN E N).S (hemiDataN E N).isClosed_H ⧸
      (infInclC₃ (hemiDataN E N) _ (isOpen_constFixer₃ M)
        (constFixer₃_normal M)).toMonoidHom.range ≃*
      GaloisPi1.pi1 (hemiData E).H (hemiData E).S (hemiData E).isClosed_H ⧸
        (infInclC₃ (hemiData E) _ (isOpen_constFixer₃ M)
          (constFixer₃_normal M)).toMonoidHom.range :=
  letI := range_infInclC₃_normal (hUo := isOpen_constFixer₃ M) (hUn := constFixer₃_normal M)
    (S_subset_constFixer₃ (hemiDataN E N) M)
  letI := range_infInclC₃_normal (hUo := isOpen_constFixer₃ M) (hUn := constFixer₃_normal M)
    (S_subset_constFixer₃ (hemiData E) M)
  (QuotientGroup.quotientMulEquivOfEq (comap_hemiFillN_range E N M).symm).trans
    (quotientComapEquiv₃ (hemiFillN_surjective E N) _)

lemma hemiFillQuotEquivNM_mk (y : GaloisPi1.pi1 (hemiDataN E N).H (hemiDataN E N).S
    (hemiDataN E N).isClosed_H) :
    hemiFillQuotEquivNM E N M (QuotientGroup.mk y) = QuotientGroup.mk (hemiFillN E N y) := rfl



/-! ### The ring of `U_V`: `(hemiDataNM E N M).R ≅ M[E][1/ψ_N]` -/

/-- `φ : M[E] → Ω` (`m ↦ m`, `x ↦ x`, `y ↦ y`), from `hemiConstREquiv`. -/
abbrev hemiPhiNM : (E.baseChange M).toAffine.CoordinateRing →+* FFClosure (curveE E) :=
  constRingPhi₃ (hemiData E) M E (hemiREquiv E) (hemiREquiv_of₃ E)

lemma hemiPhiNM_of (p : M[X]) :
    hemiPhiNM E M (AdjoinRoot.of (E.baseChange M).toAffine.polynomial p) =
      p.eval₂ (constι₃ M) (coordT (xN E)) :=
  constRingPhi₃_of _ _ _ _ _ p

omit [CharZero K] [E.IsElliptic] [NeZero N] [FiniteDimensional K M] [IsGalois K M] in
/-- `ψ_N² = ΨSq_N(x)` in `F[W]`. -/
lemma psiN_sq_of₃ {F : Type*} [Field F] (W : WeierstrassCurve F) :
    psiN W N ^ 2 = AdjoinRoot.of W.toAffine.polynomial (W.ΨSq N) := by
  rw [psiN_sq, AdjoinRoot.algebraMap_eq]

omit [NeZero N] in
/-- `φ(ψ_N)² = ΨSq_N(x)`. -/
lemma hemiPhiNM_psiN_sq : hemiPhiNM E M (psiN (E.baseChange M) N) ^ 2 =
    aeval (coordT (xN E)) (E.ΨSq N) := by
  have h : (E.baseChange M).ΨSq (N : ℤ) = (E.ΨSq N).map (algebraMap K M) :=
    WeierstrassCurve.map_ΨSq _ _ _
  rw [← map_pow, psiN_sq_of₃ N (E.baseChange M), hemiPhiNM_of, h, eval₂_map,
    constι₃_comp_algebraMap, ← aeval_def]

omit [FiniteDimensional K M] [IsGalois K M] in
lemma aeval_coordT_ΨSq_ne_zero : aeval (coordT (xN E)) (E.ΨSq N) ≠ 0 := by
  have h : aeval (coordT (xN E)) (E.ΨSq N) = coordT (psiSqN₃ E N) :=
    aeval_algHom_apply (IsScalarTower.toAlgHom K (curveE E).functionField
      (FFClosure (curveE E))) (xN E) (E.ΨSq N)
  rw [h]
  exact (map_ne_zero (algebraMap (curveE E).functionField (FFClosure (curveE E)))).2
    (psiSqN₃_ne_zero E N)

lemma hemiPhiNM_psiN_ne_zero : hemiPhiNM E M (psiN (E.baseChange M) N) ≠ 0 := fun h0 =>
  aeval_coordT_ΨSq_ne_zero E N (by rw [← hemiPhiNM_psiN_sq E N M, h0, zero_pow two_ne_zero])

/-- `L_V = K(Ē) · M ⊆ L_{U_V}` (they are the same subfield of `Ω`). -/
lemma mem_hemiDataNM_L_of (z : FFClosure (curveE E)) (hz : z ∈ (hemiDataM E M).L) :
    z ∈ (hemiDataNM E N M).L := by
  have hz' : z ∈ IntermediateField.fixedField (hemiDataM E M).HL := hz
  change z ∈ IntermediateField.fixedField (hemiDataNM E N M).HL
  refine (IntermediateField.mem_fixedField_iff _ _).2 fun σ hσ => ?_
  have hm := (mem_inf_hemiHHomN E N M (⟨σ, (hemiDataNM E N M).le hσ⟩ : (hemiDataN E N).H)).2 hσ
  have h1 := (IntermediateField.mem_fixedField_iff _ _).1 hz' _ hm
  exact (hemiHHomN_apply E N _ z).symm.trans h1

/-- `L_{U_V} ⊆ L_V`. -/
lemma mem_hemiDataM_L_of (z : FFClosure (curveE E)) (hz : z ∈ (hemiDataNM E N M).L) :
    z ∈ (hemiDataM E M).L := by
  have hz' : z ∈ IntermediateField.fixedField (hemiDataNM E N M).HL := hz
  change z ∈ IntermediateField.fixedField (hemiDataM E M).HL
  refine (IntermediateField.mem_fixedField_iff _ _).2 fun σ hσ => ?_
  have he : hemiHHomN E N ((hemiHEquivN E N).symm (⟨σ, Subgroup.mem_top σ⟩ : (hemiData E).H)) =
      ⟨σ, Subgroup.mem_top σ⟩ := (hemiHEquivN E N).apply_symm_apply _
  have hm := (mem_inf_hemiHHomN E N M
    ((hemiHEquivN E N).symm (⟨σ, Subgroup.mem_top σ⟩ : (hemiData E).H))).1 (by
      rw [he]
      exact hσ)
  have h1 := (IntermediateField.mem_fixedField_iff _ _).1 hz' _ hm
  exact (hemiHEquivN_symm_apply E N _ z).symm.trans h1

omit [FiniteDimensional K M] [IsGalois K M] in
/-- Integral over `K[x]` implies integral over `K[τ]`. -/
lemma isIntegral_tau_of_isIntegral_x {z : FFClosure (curveE E)}
    (hz : IsIntegral (A₀ K (coordT (xN E))) z) : IsIntegral (A₀ K (coordT (tauN₃ E N))) z := by
  have hle : A₀ K (coordT (xN E)) ≤
      (integralClosure (A₀ K (coordT (tauN₃ E N))) (FFClosure (curveE E))).restrictScalars K :=
    Algebra.adjoin_le (Set.singleton_subset_iff.2 (isIntegral_coordT_xN₃ E N))
  exact isIntegral_trans_of_forall₃ (fun s => hle s.2) hz

/-- `φ(ψ_N)⁻¹` is integral over `K[τ]`: its square is `τ - x`. -/
lemma isIntegral_hemiPhiNM_inv :
    IsIntegral (A₀ K (coordT (tauN₃ E N))) (hemiPhiNM E M (psiN (E.baseChange M) N))⁻¹ := by
  have hτ : IsIntegral (A₀ K (coordT (tauN₃ E N))) (coordT (tauN₃ E N)) :=
    isIntegral_algebraMap (x := (⟨coordT (tauN₃ E N), Algebra.subset_adjoin
      (Set.mem_singleton _)⟩ : A₀ K (coordT (tauN₃ E N))))
  have h2 : (hemiPhiNM E M (psiN (E.baseChange M) N))⁻¹ ^ 2 =
      coordT (tauN₃ E N) - coordT (xN E) := by
    rw [inv_pow, hemiPhiNM_psiN_sq, coordT_tauN₃, add_sub_cancel_left]
  refine IsIntegral.of_pow two_pos ?_
  rw [h2]
  exact hτ.sub (isIntegral_coordT_xN₃ E N)

omit [CharZero K] [E.IsElliptic] [NeZero N] [FiniteDimensional K M] [IsGalois K M] in
lemma tau_aux₃ {F : Type*} [Field F] {x' x τ p a : F} (hx : x' = x) (hp : p ^ 2 = a)
    (hτ : τ = x + a⁻¹) : x' + p⁻¹ ^ 2 = τ := by
  rw [hx, inv_pow, hp, hτ]

omit [NeZero N] in
/-- `τ = φ(x) + φ(ψ_N)⁻²`. -/
lemma hemiPhiNM_tau : hemiPhiNM E M (AdjoinRoot.of (E.baseChange M).toAffine.polynomial X) +
    (hemiPhiNM E M (psiN (E.baseChange M) N))⁻¹ ^ 2 = coordT (tauN₃ E N) :=
  tau_aux₃ ((hemiPhiNM_of E M X).trans (eval₂_X _ _)) (hemiPhiNM_psiN_sq E N M)
    (coordT_tauN₃ E N)

/-- Constants: `c = φ(c)`. -/
lemma hemiPhiNM_const (c : K) :
    hemiPhiNM E M (AdjoinRoot.of (E.baseChange M).toAffine.polynomial (C (algebraMap K M c))) =
      algebraMap K (FFClosure (curveE E)) c :=
  (hemiPhiNM_of E M _).trans (eval₂_C _ _)

lemma hemiPhiNM_algebraMap (c : K) :
    hemiPhiNM E M (algebraMap K (E.baseChange M).toAffine.CoordinateRing c) =
      algebraMap K (FFClosure (curveE E)) c := by
  change algebraMap (hemiDataM E M).R (FFClosure (curveE E))
    (constRingPsi₃ (hemiData E) M E (hemiREquiv E) (hemiREquiv_of₃ E) (algebraMap K _ c)) = _
  rw [constRingPsi₃_algebraMap, ← IsScalarTower.algebraMap_apply]

/-- **`M[E][1/ψ_N] ≃ₐ[K] R_{U_V}`**: the ring `R` (the integral closure of `K[τ]` in
`L = K(Ē) · M`) of the Galois data `hemiDataNM E N M` of `U_V = (E ∖ E[N])_M` is the coordinate
ring `Γ((E ∖ E[N])_M) = M[E][1/ψ_N]` (`coverRingN` of `E.baseChange M`). -/
def hemiRNMEquiv : coverRingN (E.baseChange M) N ≃ₐ[K] (hemiDataNM E N M).R :=
  locCoordEquiv₃ (hemiPhiNM E M) (psiN (E.baseChange M) N) (hemiPhiNM_psiN_ne_zero E N M)
    (hemiDataNM E N M).L (fun _ => mem_hemiDataNM_L_of E N M _ (CoordRing.algebraMap_mem _))
    (fun _ => isIntegral_tau_of_isIntegral_x E N (CoordRing.isIntegral_algebraMap _))
    (isIntegral_hemiPhiNM_inv E N M)
    (constRingPhi₃_injective (hemiData E) M E (hemiREquiv E) (hemiREquiv_of₃ E))
    (fun c => ⟨_, hemiPhiNM_const E M c⟩) ⟨_, 2, hemiPhiNM_tau E N M⟩
    (fun z hz => exists_mul_eq_constRingPhi₃ (hemiData E) M E (hemiREquiv E) (hemiREquiv_of₃ E)
      (mem_hemiDataM_L_of E N M z hz))
    (hemiPhiNM_algebraMap E M)

/-- **Compatibility with the embeddings into `Ω`**: `hemiRNMEquiv` is `φ` on `M[E][1/ψ_N]`. -/
theorem algebraMap_hemiRNMEquiv (b : coverRingN (E.baseChange M) N) :
    algebraMap (hemiDataNM E N M).R (FFClosure (curveE E)) (hemiRNMEquiv E N M b) =
      locLift₃ (hemiPhiNM E M) (psiN (E.baseChange M) N) (hemiPhiNM_psiN_ne_zero E N M) b := rfl

/-- On `M[E] ⊆ M[E][1/ψ_N]`, `hemiRNMEquiv` is `hemiConstREquiv` (the ring of `V = X_M`). -/
theorem algebraMap_hemiRNMEquiv_algebraMap (a : (E.baseChange M).toAffine.CoordinateRing) :
    algebraMap (hemiDataNM E N M).R (FFClosure (curveE E))
      (hemiRNMEquiv E N M (algebraMap _ (coverRingN (E.baseChange M) N) a)) =
      algebraMap (hemiDataM E M).R (FFClosure (curveE E)) (hemiConstREquiv E M a) :=
  locLift₃_algebraMap (hemiPhiNM E M) (psiN (E.baseChange M) N) (hemiPhiNM_psiN_ne_zero E N M) a

/-- `1/ψ_N ↦ φ(ψ_N)⁻¹`. -/
theorem algebraMap_hemiRNMEquiv_invSelf :
    algebraMap (hemiDataNM E N M).R (FFClosure (curveE E))
      (hemiRNMEquiv E N M (IsLocalization.Away.invSelf (psiN (E.baseChange M) N))) =
      (algebraMap (hemiDataM E M).R (FFClosure (curveE E))
        (hemiConstREquiv E M (psiN (E.baseChange M) N)))⁻¹ :=
  locLift₃_invSelf (hemiPhiNM E M) (psiN (E.baseChange M) N) (hemiPhiNM_psiN_ne_zero E N M)

/-- `τ = x + (1/ψ_N)² ↦ τ`. -/
theorem algebraMap_hemiRNMEquiv_tau :
    algebraMap (hemiDataNM E N M).R (FFClosure (curveE E))
      (hemiRNMEquiv E N M (algebraMap _ (coverRingN (E.baseChange M) N)
        (AdjoinRoot.of (E.baseChange M).toAffine.polynomial X) +
          IsLocalization.Away.invSelf (psiN (E.baseChange M) N) ^ 2)) = coordT (tauN₃ E N) :=
  (locLift₃_add_pow (hemiPhiNM E M) (psiN (E.baseChange M) N) (hemiPhiNM_psiN_ne_zero E N M)
    (AdjoinRoot.of (E.baseChange M).toAffine.polynomial X) 2).trans (hemiPhiNM_tau E N M)

end Hemi

