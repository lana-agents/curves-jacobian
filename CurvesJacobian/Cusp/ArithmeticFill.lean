import CurvesJacobian.Cusp.ArithmeticExt
import CurvesJacobian.Cusp.SingleCusp

/-!
# Filling in one cusp on the arithmetic fundamental group (MR8.3, task 2 (iv))

[AbsTopI] Definition 4.2 (iii) (`Topics in Absolute Anabelian Geometry I.txt` l.3011–3014): an
operation of type `•` is a surjection `Π_j ↠ Π_{j+1}` "whose kernel is topologically normally
generated by a cuspidal decomposition group". Here, for a hyperbolic curve `C` over a number field
`K` (`U ⊆ X̄`, `Π_U = π₁ᵉᵗ(U, x)` of `CurvesJacobian.Cusp.arithmeticExt`) and an open
`U' ⊇ U` with a cusp:

* `specTensorIso_hom_ι_fst`, `specTensorIso_hom_ι_snd`, `specTensorIso_hom_homOfLE`: the
  identification `Spec (Ω ⊗ Γ(U)) ≅ U_Ω` is compatible with `U ⊆ U'`;
* `fillMap : Π_U → Π_{U'}` (at the image `fillPoint` of the base point), a map over `G_K`
  (`projGkFill_fillMap`);
* `geomToPi_eq`, `continuous_geomToPi`: the embedding `π₁ᵉᵗ(U_Ω, generic point) → Π_U`;
* **`ker_fillMap_eq_map`, `ker_fillMap_eq_normalClosure`**: if `U'_Ω ∖ U_Ω` has at most one point
  (e.g. `U' = U ∪ {x}`, `x` a `K`-rational point) and `W₀` is a place over it, then
  `ker(Π_U → Π_{U'})` is the closed normal subgroup of `Π_U` generated by the single cuspidal
  inertia group `geomToPi (cuspInertia U_Ω W₀) ∈ arithCusps` (`mem_arithCusps`). Proof: the
  kernel lies in `Δ_U` (map over `G_K`); `Δ ≅ π₁ᵉᵗ(U_Ω, x)` on both sides (homotopy exact
  sequence, injectivity of `π₁ᵉᵗ(U'_Ω) → Π_{U'}`); move the base point to the generic point by an
  isomorphism of fibre functors (`CurvesJacobian.Cusp.BasePointChange`) and apply
  `ker_fundamentalGroupMap_homOfLE_eq_normalClosure` (`CurvesJacobian.Cusp.SingleCusp`).

Not yet done: deriving the subsingleton hypothesis from `U' ∖ U = {x}` with `x` rational (the
fibre of `X̄_Ω → X̄` over a rational point is one point), the Galois-conjugacy of the geometric
cusps over a non-rational `x`, and the commensurator condition of `ChainObj.IsCuspidal`.
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi Belyi.Anabelian
open scoped TensorProduct

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section Square

set_option backward.isDefEq.respectTransparency false in
@[reassoc]
lemma pullback_congrHom_hom_snd {C : Type*} [Category C] {X Y Z : C} {f₁ f₂ : X ⟶ Z}
    {g₁ g₂ : Y ⟶ Z} (h₁ : f₁ = f₂) (h₂ : g₁ = g₂) [HasPullback f₁ g₁] [HasPullback f₂ g₂] :
    (pullback.congrHom h₁ h₂).hom ≫ pullback.snd f₂ g₂ = pullback.snd f₁ g₁ := by
  simp [pullback.congrHom, pullback.map]

set_option backward.isDefEq.respectTransparency false in
@[reassoc]
lemma pullback_congrHom_hom_fst {C : Type*} [Category C] {X Y Z : C} {f₁ f₂ : X ⟶ Z}
    {g₁ g₂ : Y ⟶ Z} (h₁ : f₁ = f₂) (h₂ : g₁ = g₂) [HasPullback f₁ g₁] [HasPullback f₂ g₂] :
    (pullback.congrHom h₁ h₂).hom ≫ pullback.fst f₂ g₂ = pullback.fst f₁ g₁ := by
  simp [pullback.congrHom, pullback.map]

variable (k : Type u) [Field k] (Ω : Type u) [Field Ω] [Algebra k Ω]
  {X : Scheme.{u}} [X.Over (Spec (.of k))]

set_option backward.isDefEq.respectTransparency false in
lemma specTensorIso_hom_ι_fst {U : X.Opens} (hU : IsAffineOpen U) :
    (specTensorIsoBaseChangeOpen k Ω hU).hom ≫ (baseChangeOpen k Ω U).ι ≫
      pullback.fst (X ↘ Spec (.of k)) (specAlgebraMap k Ω) =
    baseChangeSpec k Ω Γ(X, U) ≫ hU.fromSpec := by
  simp only [specTensorIsoBaseChangeOpen, pullbackMapIsoSpec, Iso.trans_hom, Iso.symm_hom,
      asIso_hom,
    Category.assoc, pullbackRestrictIsoRestrict_hom_ι_assoc, pullbackSymmetry_hom_comp_fst_assoc,
    pullbackRightPullbackFstIso_inv_snd_fst, limit.lift_π_assoc, cospan_right,
        PullbackCone.mk_π_app,
    IsAffineOpen.isoSpec_inv_ι, baseChangeSpec, AlgHom.toRingHom_eq_coe]
  erw [pullback_congrHom_hom_snd_assoc, pullbackSpecIso_inv_snd_assoc]

set_option backward.isDefEq.respectTransparency false in
lemma specTensorIso_hom_ι_snd {U : X.Opens} (hU : IsAffineOpen U) :
    (specTensorIsoBaseChangeOpen k Ω hU).hom ≫ (baseChangeOpen k Ω U).ι ≫
      pullback.snd (X ↘ Spec (.of k)) (specAlgebraMap k Ω) =
    Spec.map (CommRingCat.ofHom (algebraMap Ω (Ω ⊗[k] Γ(X, U)))) := by
  simp only [specTensorIsoBaseChangeOpen, pullbackMapIsoSpec, Iso.trans_hom, Iso.symm_hom,
      asIso_hom,
    Category.assoc, pullbackRestrictIsoRestrict_hom_ι_assoc, pullbackSymmetry_hom_comp_fst_assoc,
    pullbackRightPullbackFstIso_inv_snd_snd, pullbackSymmetry_hom_comp_snd, limit.lift_π,
        PullbackCone.mk_π_app,
    Category.comp_id]
  erw [pullback_congrHom_hom_fst, pullbackSpecIso_inv_fst]
  rfl

/-- Restriction of sections `Γ(X, U') → Γ(X, U)` for `U ≤ U'`, as a `k`-algebra map. -/
def resAlg {U U' : X.Opens} (h : U ≤ U') : Γ(X, U') →ₐ[k] Γ(X, U) :=
  { (Scheme.Hom.appLE (𝟙 X) U' U h).hom with
    commutes' := fun c ↦ congrArg (fun φ : k →+* Γ(X, U) ↦ φ c)
      (appLE_comp_algebraMap (𝟙 X) k U' U h) }

lemma baseChangeOpen_mono {U U' : X.Opens} (h : U ≤ U') :
    baseChangeOpen k Ω U ≤ baseChangeOpen k Ω U' := fun _ hx ↦ h hx

/-- `Ω ⊗ Γ(X, U') → Ω ⊗ Γ(X, U)`. -/
def tensorRes {U U' : X.Opens} (h : U ≤ U') : Ω ⊗[k] Γ(X, U') →ₐ[Ω] Ω ⊗[k] Γ(X, U) :=
  Algebra.TensorProduct.map (AlgHom.id Ω Ω) (resAlg k h)

lemma specMap_tensorRes_baseChangeSpec {U U' : X.Opens} (h : U ≤ U') :
    Spec.map (CommRingCat.ofHom (tensorRes k Ω h).toRingHom) ≫ baseChangeSpec k Ω Γ(X, U') =
      baseChangeSpec k Ω Γ(X, U) ≫ Spec.map (CommRingCat.ofHom (resAlg k h).toRingHom) := by
  simp only [baseChangeSpec, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2

set_option backward.isDefEq.respectTransparency false in
/-- **The square** `Spec (Ω ⊗ Γ(U)) ≅ U_Ω ⊆ U'_Ω ≅ Spec (Ω ⊗ Γ(U'))`. -/
lemma specTensorIso_hom_homOfLE {U U' : X.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U')
    (h : U ≤ U') :
    (specTensorIsoBaseChangeOpen k Ω hU).hom ≫
        (baseChange k Ω X).homOfLE (baseChangeOpen_mono k Ω h) =
      Spec.map (CommRingCat.ofHom (tensorRes k Ω h).toRingHom) ≫
        (specTensorIsoBaseChangeOpen k Ω hU').hom := by
  rw [← cancel_mono (baseChangeOpen k Ω U').ι]
  apply pullback.hom_ext
  · simp only [Category.assoc, Scheme.homOfLE_ι, specTensorIso_hom_ι_fst]
    rw [← Category.assoc, specMap_tensorRes_baseChangeSpec, Category.assoc]
    congr 1
    have := IsAffineOpen.SpecMap_appLE_fromSpec (𝟙 X) hU' hU h
    rw [Category.comp_id] at this
    rw [show CommRingCat.ofHom (resAlg k h).toRingHom = Scheme.Hom.appLE (𝟙 X) U' U h from rfl]
    exact this.symm
  · simp only [Category.assoc, Scheme.homOfLE_ι, specTensorIso_hom_ι_snd, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    congr 2
    ext a
    simp

end Square

lemma coe_continuousSubgroupCongr_symm {G : Type*} [Group G] [TopologicalSpace G]
    {H H' : Subgroup G} (h : H = H') (z : H') :
    (((continuousSubgroupCongr h).symm z : H) : G) = z := by
  subst h
  rfl

section Arith

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
  (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)

attribute [local instance] isAlgClosure_of_isAlgebraic

include h hc' in
/-- An open `U' ⊇ U` with a cusp is affine. -/
lemma isAffineOpen_of_le : IsAffineOpen U' := by
  haveI := IsCurveOver.isIntegral K C.Xbar
  haveI : Nonempty U' := (C.nonempty.mono h).to_subtype
  have hne : U' ≠ ⊤ := fun h' ↦ by
    obtain ⟨x, hx⟩ := hc'
    exact hx (h' ▸ trivial)
  obtain ⟨τ, hτ, hU⟩ := exists_chartOne_eq K U'
    (C.cusps_finite.subset (Set.compl_subset_compl.2 h)) hne
  rw [hU]
  exact isAffineOpen_chartOne hτ

omit [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
include h hc' in
lemma isIntegral_specTensor_of_le : IsIntegral (Spec (.of (Ω ⊗[K] Γ(C.Xbar, U')))) :=
  isIntegral_spec_tensor K Ω (isAffineOpen_of_le C h hc') (C.nonempty.mono h)

/-- The base point of `U'_Ω`: the image of the base point of `U_Ω`. -/
def fillPoint : Spec (.of Ω) ⟶ Spec (.of (Ω ⊗[K] Γ(C.Xbar, U'))) :=
  basePoint Ω C hc ≫ Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom)

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
lemma fillPoint_spec :
    (basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) ≫
        Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom) =
      fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U') := by
  rw [fillPoint, Category.assoc, Category.assoc, specMap_tensorRes_baseChangeSpec]

/-- **Filling in cusps on the arithmetic fundamental group**: `Π_U → Π_{U'}`, induced by
`Spec Γ(U) → Spec Γ(U')`. -/
def fillMap : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →ₜ*
    π₁ᵉᵗ(fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U')) :=
  fundamentalGroupMap (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) (fillPoint_spec Ω C hc
      h)

omit [NumberField K] in
lemma specMap_resAlg_structure :
    Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, U'))) =
      Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, C.U))) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  ext c
  exact (resAlg K h).commutes c

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
lemma fillPoint_spec₂ :
    (fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U')) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, U'))) =
      Spec.map (CommRingCat.ofHom (algebraMap K Ω)) := by
  rw [← fillPoint_spec, Category.assoc, specMap_resAlg_structure]
  exact basePoint_spec₂ Ω C hc

/-- The projection `Π_{U'} → G_K`. -/
def projGkFill : π₁ᵉᵗ(fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U')) →ₜ*
    π₁ᵉᵗ(Spec.map (CommRingCat.ofHom (algebraMap K Ω))) :=
  fundamentalGroupMap (Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, U'))))
    (fillPoint_spec₂ Ω C hc h)

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
/-- `fillMap` is a map over `G_K`. -/
lemma projGkFill_fillMap (γ) : projGkFill Ω C hc h (fillMap Ω C hc h γ) = projGk Ω C hc γ := by
  change ((projGkFill Ω C hc h).comp (fillMap Ω C hc h)) γ = _
  rw [projGkFill, fillMap, ← fundamentalGroupMap_comp _ _ _ _
    (by rw [specMap_resAlg_structure]; exact basePoint_spec₂ Ω C hc)]
  exact congrArg (· γ) (fundamentalGroupMap_congr (specMap_resAlg_structure C h) _ _)

omit [NumberField K] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
include h in
lemma nonempty_fillOpen : Nonempty (baseChangeOpen K Ω U') :=
  (nonempty_baseChangeOpen K Ω (C.nonempty.mono h)).to_subtype

/-- `geomToPi` is `π₁ᵉᵗ(U_Ω, generic) ≃ π₁ᵉᵗ(U_Ω, x) ≃ π₁ᵉᵗ(Spec (Ω ⊗ Γ(U)), x) → Π_U`. -/
lemma geomToPi_eq (g) :
    geomToPi Ω C hc g = fundamentalGroupMap (baseChangeSpec K Ω Γ(C.Xbar, C.U)) rfl
      ((fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc))
        (basePoint Ω C hc)).symm (basePointEquiv Ω C hc g)) := by
  haveI := isIntegral_specSections C hc
  haveI := isIntegral_specTensor Ω C hc
  change ((kerProjGkEquivGeom Ω C hc).symm (basePointEquiv Ω C hc g)).1 = _
  rw [kerProjGkEquivGeom, ContinuousMulEquiv.symm_trans_apply,
    ContinuousMulEquiv.symm_trans_apply, coe_continuousSubgroupCongr_symm,
    ContinuousMulEquiv.symm_symm, geomFundamentalGroupEquivKer_apply]

lemma continuous_geomToPi : Continuous (geomToPi Ω C hc) := by
  have hc1 := (fundamentalGroupMap (baseChangeSpec K Ω Γ(C.Xbar, C.U))
    (rfl : basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U) = _)).continuous
  have hc2 := (fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc))
    (basePoint Ω C hc)).symm.continuous
  have hc3 := (basePointEquiv Ω C hc).continuous
  refine (hc1.comp (hc2.comp hc3)).congr fun g ↦ ?_
  exact (geomToPi_eq Ω C hc g).symm

/-- Abbreviation: the cuspidal inertia group `cuspInertia U_Ω W` at the generic point. -/
abbrev geomCuspInertia (W : ValuationSubring (FFClosure (geomCurve Ω C))) :=
  cuspInertia (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveGaloisData_H_le Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W

include hc' in
/-- **Filling in one cusp, arithmetically** (MR8.3 task 2 (iv); [AbsTopI] Definition 4.2 (iii),
l.3011–3014). Let `U ⊆ U'` be opens of `X̄` (both with a cusp) such that `U'_Ω ∖ U_Ω` has at most
one point (e.g. `U' = U ∪ {x}` for a `K`-rational point `x`), and `W₀` a place of `K(X̄_Ω)^alg`
centred on `U'_Ω` but not on `U_Ω`. Then the kernel of `Π_U → Π_{U'}` is the image in
`Δ_U ⊆ Π_U` of the closed normal subgroup of `π₁ᵉᵗ(U_Ω)` generated by `cuspInertia U_Ω W₀`. -/
theorem ker_fillMap_eq_map [Nonempty (baseChangeOpen K Ω U')]
    (hsub : ((baseChangeOpen K Ω U' : Set (geomCurve Ω C)) \ (geomOpen Ω C)).Subsingleton)
    {W₀ : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW₀V : IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W₀)
    (hW₀U : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W₀) :
    (fillMap Ω C hc h).toMonoidHom.ker =
      (Subgroup.normalClosure (geomCuspInertia Ω C W₀ : Set _)).topologicalClosure.map
        (geomToPi Ω C hc) := by
  haveI := isIntegral_specSections C hc
  haveI := isIntegral_specTensor Ω C hc
  haveI := isIntegral_specTensor_of_le Ω C h hc'
  have hmono := baseChangeOpen_mono K Ω h
  let β := fundamentalGroupMap (baseChangeSpec K Ω Γ(C.Xbar, C.U)) (rfl : basePoint Ω C hc ≫ _ = _)
  let β' := fundamentalGroupMap (baseChangeSpec K Ω Γ(C.Xbar, U'))
    (rfl : fillPoint Ω C hc h ≫ _ = _)
  let ψ := fundamentalGroupMap (Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom))
    (rfl : basePoint Ω C hc ≫ _ = fillPoint Ω C hc h)
  have hy : (basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom) ≫
      (geomCurve Ω C).homOfLE hmono = fillPoint Ω C hc h ≫ (specTensorIsoBaseChangeOpen K Ω
      (isAffineOpen_of_le C h hc')).hom := by
    rw [Category.assoc, specTensorIso_hom_homOfLE, fillPoint, Category.assoc]
  let ι := fundamentalGroupMap (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom (rfl :
      basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom = _)
  let ι' := fundamentalGroupMap (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_of_le C h hc')).hom
      (rfl : fillPoint Ω C hc h ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_of_le C h
      hc')).hom = _)
  let ψg := fundamentalGroupMap ((geomCurve Ω C).homOfLE hmono) hy
  have E1 : ∀ δ, fillMap Ω C hc h (β δ) = β' (ψ δ) := by
    intro δ
    have c1 := fundamentalGroupMap_comp (baseChangeSpec K Ω Γ(C.Xbar, C.U))
      (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) (rfl : basePoint Ω C hc ≫ _ = _)
      (fillPoint_spec Ω C hc h) ((Category.assoc _ _ _).symm.trans (fillPoint_spec Ω C hc h))
    have c2 := fundamentalGroupMap_comp
      (Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom))
      (baseChangeSpec K Ω Γ(C.Xbar, U')) (rfl : basePoint Ω C hc ≫ _ = fillPoint Ω C hc h) rfl
      (Category.assoc _ _ _).symm
    have c3 := fundamentalGroupMap_congr (specMap_tensorRes_baseChangeSpec K Ω h).symm
      ((Category.assoc (basePoint Ω C hc) _ _).symm.trans (fillPoint_spec Ω C hc h))
      (Category.assoc (basePoint Ω C hc) _ _).symm
    have := congrArg (fun φ : _ →ₜ* _ ↦ φ δ) (c1.symm.trans (c3.trans c2))
    exact this
  have E2 : ∀ δ, ψg (ι δ) = ι' (ψ δ) := by
    intro δ
    have c1 := fundamentalGroupMap_comp (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C
        hc)).hom ((geomCurve Ω C).homOfLE hmono)
      (rfl : basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom = _)
          hy ((Category.assoc _ _ _).symm.trans hy)
    have c2 := fundamentalGroupMap_comp
      (Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom)) (specTensorIsoBaseChangeOpen K Ω
          (isAffineOpen_of_le C h hc')).hom
      (rfl : basePoint Ω C hc ≫ _ = fillPoint Ω C hc h) rfl (Category.assoc _ _ _).symm
    have c3 := fundamentalGroupMap_congr
      (specTensorIso_hom_homOfLE K Ω (isAffineOpen_U C hc) (isAffineOpen_of_le C h hc') h)
      ((Category.assoc (basePoint Ω C hc) _ _).symm.trans hy) (Category.assoc (basePoint Ω C hc) _
          _).symm
    exact congrArg (fun φ : _ →ₜ* _ ↦ φ δ) (c1.symm.trans (c3.trans c2))
  have E3 := ker_fundamentalGroupMap_eq_map ((geomCurve Ω C).homOfLE hmono)
    (specPoint_genericL_homOfLE (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) hmono) hy (basePointIso Ω C hc)
  have E4 := ker_fundamentalGroupMap_homOfLE_eq_normalClosure (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C))
    (hk := curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C))
    (hH := curveGaloisData_H_le Ω (transcendental_geomCoord Ω C))
    (hτ := curveEquivL_τ Ω (transcendental_geomCoord Ω C))
    (compl_finite_baseChangeOpen K Ω C.nonempty)
    (compl_finite_baseChangeOpen K Ω (C.nonempty.mono h)) hmono hsub hW₀V hW₀U
  have hιe : ∀ δ, fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C
      hc)) (basePoint Ω C hc) δ = ι δ := fun _ ↦ rfl
  ext γ
  rw [MonoidHom.mem_ker, Subgroup.mem_map]
  constructor
  · intro hγ
    change fillMap Ω C hc h γ = 1 at hγ
    have hG : γ ∈ (toGaloisGroup (Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, C.U))))
        (basePoint_spec₂ Ω C hc)).ker := by
      rw [← ker_projGk, MonoidHom.mem_ker]
      change projGk Ω C hc γ = 1
      rw [← projGkFill_fillMap Ω C hc h, hγ, map_one]
    obtain ⟨δ, hδ⟩ := (bijective_toKerToGaloisGroup (basePoint Ω C hc) (basePoint_spec₁ Ω C hc)
      (basePoint_spec₂ Ω C hc)).2 ⟨γ, hG⟩
    have hδ' : β δ = γ := congrArg Subtype.val hδ
    have hψ : ψ δ = 1 := fundamentalGroupMap_baseChange_injective (fillPoint Ω C hc h)
      (by rw [← E1, hδ', hγ]; exact (map_one _).symm)
    have hg : ι δ ∈ ψg.toMonoidHom.ker := by
      rw [MonoidHom.mem_ker]
      change ψg (ι δ) = 1
      rw [E2, hψ]
      exact map_one _
    rw [E3, E4] at hg
    obtain ⟨g, hg, hgι⟩ := Subgroup.mem_map.1 hg
    refine ⟨g, hg, ?_⟩
    rw [geomToPi_eq]
    change β ((fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc))
        (basePoint Ω C hc)).symm (basePointEquiv Ω C hc g)) = γ
    have : basePointEquiv Ω C hc g = ι δ := hgι
    rw [this, ← hιe, ContinuousMulEquiv.symm_apply_apply, hδ']
  · rintro ⟨g, hg, rfl⟩
    let δ := (fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc))
        (basePoint Ω C hc)).symm (basePointEquiv Ω C hc g)
    have hιδ : ι δ = basePointEquiv Ω C hc g := by
      rw [← hιe, ContinuousMulEquiv.apply_symm_apply]
    have hker : ι δ ∈ ψg.toMonoidHom.ker := by
      rw [E3, E4]
      exact Subgroup.mem_map.2 ⟨g, hg, hιδ.symm⟩
    have hψ : ψ δ = 1 := by
      refine (fundamentalGroupMap_bijective_of_isIso (specTensorIsoBaseChangeOpen K Ω
          (isAffineOpen_of_le C h hc')).hom rfl).1 ?_
      change ι' (ψ δ) = ι' 1
      rw [← E2, show ι' 1 = 1 from map_one _]
      exact hker
    change fillMap Ω C hc h (geomToPi Ω C hc g) = 1
    rw [geomToPi_eq]
    change fillMap Ω C hc h (β δ) = 1
    rw [E1, hψ]
    exact map_one _

include hc' in
/-- **Filling in one cusp, arithmetically: normal generation by one cuspidal inertia group.**
Under the hypotheses of `ker_fillMap_eq_map`, the kernel of `Π_U → Π_{U'}` is the closed normal
subgroup of `Π_U` generated by the single cuspidal inertia group
`I = geomToPi (cuspInertia U_Ω W₀)` (an element of `arithCusps`, `mem_arithCusps`). -/
theorem ker_fillMap_eq_normalClosure [Nonempty (baseChangeOpen K Ω U')]
    (hsub : ((baseChangeOpen K Ω U' : Set (geomCurve Ω C)) \ (geomOpen Ω C)).Subsingleton)
    {W₀ : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW₀V : IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W₀)
    (hW₀U : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W₀) :
    (fillMap Ω C hc h).toMonoidHom.ker =
      (Subgroup.normalClosure
        ((geomCuspInertia Ω C W₀).map (geomToPi Ω C hc) : Set _)).topologicalClosure := by
  have E := ker_fillMap_eq_map Ω C hc h hc' hsub hW₀V hW₀U
  apply le_antisymm
  · rw [E, Subgroup.map_le_iff_le_comap]
    apply Subgroup.topologicalClosure_minimal
    · rw [← Subgroup.map_le_iff_le_comap]
      refine le_trans ?_ (Subgroup.le_topologicalClosure _)
      rw [Subgroup.map_le_iff_le_comap]
      refine Subgroup.normalClosure_le_normal fun s hs ↦ ?_
      exact Subgroup.subset_normalClosure ⟨s, hs, rfl⟩
    · exact (Subgroup.isClosed_topologicalClosure _).preimage (continuous_geomToPi Ω C hc)
  · apply Subgroup.topologicalClosure_minimal
    · refine Subgroup.normalClosure_le_normal ?_
      rintro _ ⟨s, hs, rfl⟩
      rw [E]
      exact ⟨s, Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure hs), rfl⟩
    · exact isClosed_singleton.preimage (fillMap Ω C hc h).continuous

/-- The cuspidal inertia group `geomToPi (cuspInertia U_Ω W₀)` is one of the cuspidal inertia
groups of `arithmeticExt` (with `g = 1`). -/
lemma mem_arithCusps {W₀ : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hk : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W₀)
    (hW₀U : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W₀) :
    (geomCuspInertia Ω C W₀).map (geomToPi Ω C hc) ∈ arithCusps Ω C hc :=
  ⟨_, ⟨W₀, hk, hW₀U, rfl⟩, 1, by ext; simp⟩

end Arith

