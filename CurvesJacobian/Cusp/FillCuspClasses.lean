import CurvesJacobian.Cusp.FillByKernel
import CurvesJacobian.Cusp.DupDecomp
import CurvesJacobian.Cusp.Cor38Unique

/-!
# Cusps killed and cusps surviving under a filling `Π_U ↠ Π_{U'}` ([AbsTopII] Cor 3.4, step G3)

Let `C` be a hyperbolic curve over a number field `K` with open `U ⊆ X̄`, `U ⊆ U'` an open with a
cusp, and `fillMap : Π_U ↠ Π_{U'}` the filling map with kernel `N`.

* **`ker_fillMap_eq_closure_killedCusps₂`**: `N` is the closed normal subgroup generated by the
  cuspidal inertia groups `J ∈ arithCusps` with `J ⊆ N` (the generators of
  `ker_fillMap_eq_map_iUnion` are such cusps).
* **`exists_conj_eq_of_not_le_ker_fillMap₂`**: if `X̄_Ω ∖ U'_Ω` has at most one point, the cuspidal
  inertia groups not contained in `N` are all `Π_U`-conjugate: their places are not centred on
  `U'_Ω` (`arithInertia_le_ker_fillMap_of_isCentredOn₂`), so they lie over the unique point of
  `X̄_Ω ∖ U'_Ω`, restrict to the same place of `K(X̄_Ω)` and are conjugate under
  `Gal(K(X̄_Ω)^alg / K(X̄_Ω))` (`exists_comap_eq_of_not_isCentredOn₂`).
* **`exists_mem_arithCusps_not_le_ker_fillMap₂`**: if `(X̄, U')` is hyperbolic, some cuspidal
  inertia group survives (`false_of_le_ker`).
* The case `U = E ∖ E[2] ⊆ U' = E ∖ {O}` of an elliptic curve `E`, with the filling map
  `cor38Fill` (`..._VE₂`).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale PreGaloisCategory
  Belyi Belyi.Anabelian
open Pi1.Orbifold AffOrbicurve

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section Fill

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
  (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)

attribute [local instance] isAlgClosure_of_isAlgebraic

include h in
/-- A place `W ⊇ Ω` not centred on `U'_Ω` lies over a cusp of `U`. -/
lemma isCuspPlace_of_not_isCentredOn_fill₂ [Nonempty (baseChangeOpen K Ω U')]
    {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hkW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (hW : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W) :
    IsCuspPlace Ω C hc W :=
  ⟨hkW, fun hall ↦ hW (isCentredOn_mono Ω C (baseChangeOpen_mono K Ω h)
    ((isCentredOn_geomOpen_iff Ω C hc W).2 ⟨hkW, hall⟩))⟩

include hc' in
/-- The inertia group of a cusp place centred on `U'_Ω` lies in the filling kernel. -/
lemma arithInertia_le_ker_fillMap_of_isCentredOn₂ [Nonempty (baseChangeOpen K Ω U')]
    {W : ValuationSubring (FFClosure (geomCurve Ω C))} (hW : IsCuspPlace Ω C hc W)
    (hWV : IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W) :
    arithInertia Ω C hc W ≤ (fillMap Ω C hc h).toMonoidHom.ker := by
  have e : arithInertia Ω C hc W = (geomCuspInertia Ω C W).map (geomToPi Ω C hc) :=
    (map_geomCuspInertia Ω C hc hW.1).symm
  rw [e]
  exact geomCuspInertia_map_le_ker Ω C hc h hc' hWV
    fun h' ↦ hW.2 ((isCentredOn_geomOpen_iff Ω C hc W).1 h').2

include hc' in
/-- **(A1) The filling kernel is generated by the cusps it contains**: `ker(Π_U ↠ Π_{U'})` is
the closed normal subgroup generated by the cuspidal inertia groups of `Π_U` contained in it. -/
theorem ker_fillMap_eq_closure_killedCusps₂ [Nonempty (baseChangeOpen K Ω U')] :
    (fillMap Ω C hc h).toMonoidHom.ker =
      (Subgroup.normalClosure (⋃ (J) (_ : J ∈ arithCusps Ω C hc ∧
        J ≤ (fillMap Ω C hc h).toMonoidHom.ker),
          (J : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))))).topologicalClosure
    := by
  apply le_antisymm
  · haveI := Subgroup.is_normal_topologicalClosure (Subgroup.normalClosure (⋃ (J) (_ :
      J ∈ arithCusps Ω C hc ∧ J ≤ (fillMap Ω C hc h).toMonoidHom.ker),
        (J : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)))))
    refine ker_fillMap_le_of_forall Ω C hc h hc' _ (Subgroup.isClosed_topologicalClosure _)
      fun W hW y hy hyU' hyU ↦ ?_
    have hWU : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
        (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W := fun h' ↦
      hyU ((isCentredOn_baseChangeOpen_iff_mem Ω C hc C.U le_rfl hc hW hy).1 h')
    have hJ : (geomCuspInertia Ω C W).map (geomToPi Ω C hc) ∈ arithCusps Ω C hc :=
      (mem_arithCusps_iff Ω C hc).2 ⟨W, ⟨hW, fun hall ↦
        hWU ((isCentredOn_geomOpen_iff Ω C hc W).2 ⟨hW, hall⟩)⟩, map_geomCuspInertia Ω C hc hW⟩
    have hk := map_geomCuspInertia_le_ker_fillMap_of_mem Ω C hc h hc' hW hWU hy hyU'
    intro s hs
    exact Subgroup.le_topologicalClosure _
      (Subgroup.subset_normalClosure (Set.mem_iUnion₂.2 ⟨_, ⟨hJ, hk⟩, hs⟩))
  · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) ?_
    · intro s hs
      obtain ⟨J, ⟨-, hJ⟩, hs⟩ := Set.mem_iUnion₂.1 hs
      exact hJ hs
    · exact isClosed_singleton.preimage (fillMap Ω C hc h).continuous

/-- **Places over the unique point outside `U'_Ω` are conjugate**: if `X̄_Ω ∖ U'_Ω` has at most
one point, two places `W, W' ⊇ Ω` not centred on `U'_Ω` are conjugate by an element `n` over
`K(X̄)` whose image in `Π_U` lies in `Δ_U` (generalises `exists_comap_eq_of_isCuspPlace₂`, the
case `U' = U`). -/
theorem exists_comap_eq_of_not_isCentredOn₂ [Nonempty (baseChangeOpen K Ω U')]
    (h1 : ((baseChangeOpen K Ω U' : Set (geomCurve Ω C))ᶜ : Set (geomCurve Ω C)).Subsingleton)
    {W W' : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hkW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (hkW' : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W')
    (hW : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W)
    (hW' : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W') :
    ∃ n : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C),
      projGk Ω C hc (arithAction Ω C hc n) = 1 ∧
        W' = W.comap (n.symm : FFClosure (geomCurve Ω C) →+* FFClosure (geomCurve Ω C)) := by
  haveI : Nonempty (⊤ : (geomCurve Ω C).Opens) :=
    ⟨⟨(Nonempty.some (inferInstance : Nonempty (geomOpen Ω C))).1, trivial⟩⟩
  have hL : W.comap (algebraMap (geomData Ω C).L (FFClosure (geomCurve Ω C))) =
      W'.comap (algebraMap (geomData Ω C).L (FFClosure (geomCurve Ω C))) :=
    comap_algebraMap_eq_of_isCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C))
      (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C)) (by simp)
      (h1.anti fun _ hx ↦ hx.2) (isCentredOn_top_geom₂ Ω C hkW) hW
      (isCentredOn_top_geom₂ Ω C hkW') hW'
  haveI : IsGalois (geomData Ω C).L (FFClosure (geomCurve Ω C)) :=
    IsGalois.tower_top_of_isGalois (K₀ Ω (coordT (geomCoord Ω C))) (geomData Ω C).L
      (FFClosure (geomCurve Ω C))
  obtain ⟨σ, hσ⟩ := exists_algEquiv_comap_eq W W' hL
  have hσL : σ.restrictScalars (K₀ Ω (coordT (geomCoord Ω C))) ∈ (geomData Ω C).HL := by
    have hcl : IsClosed ((geomData Ω C).HL : Set (FFClosure (geomCurve Ω C) ≃ₐ[K₀ Ω
        (coordT (geomCoord Ω C))] FFClosure (geomCurve Ω C))) := (geomData Ω C).isClosed_HL
    have h := InfiniteGalois.fixingSubgroup_fixedField
      (⟨(geomData Ω C).HL, hcl⟩ : ClosedSubgroup _)
    change σ.restrictScalars _ ∈ (⟨(geomData Ω C).HL, hcl⟩ : ClosedSubgroup _).toSubgroup
    rw [← h, IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact σ.commutes ⟨x, hx⟩
  refine ⟨toArithAut Ω C hc ⟨σ.restrictScalars _, (geomData Ω C).le hσL⟩, ?_, ?_⟩
  · rw [← geomToPi_chartHom]
    exact geomToPi_mem_ker Ω C hc _
  · have hinv : ∀ z, (toArithAut Ω C hc ⟨σ.restrictScalars _, (geomData Ω C).le hσL⟩).symm z =
        σ.symm z := fun z ↦ by
      apply (toArithAut Ω C hc ⟨σ.restrictScalars _, (geomData Ω C).le hσL⟩).injective
      rw [AlgEquiv.apply_symm_apply]
      exact (σ.apply_symm_apply z).symm
    rw [hσ]
    ext z
    simp only [ValuationSubring.mem_comap, RingHom.coe_coe, hinv]

/-- Conjugating a place by `τ` over `K(X̄)` conjugates its inertia group by `arithAction τ`. -/
lemma arithInertia_comap_symm₂ {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hkW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (τ : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C))
    (hkW' : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈
      W.comap (τ.symm : FFClosure (geomCurve Ω C) →+* FFClosure (geomCurve Ω C))) :
    arithInertia Ω C hc (W.comap (τ.symm : FFClosure (geomCurve Ω C) →+*
        FFClosure (geomCurve Ω C))) =
      (arithInertia Ω C hc W).map (MulAut.conj (arithAction Ω C hc τ)).toMonoidHom := by
  have a1 : arithInertia Ω C hc (W.comap (τ.symm : FFClosure (geomCurve Ω C) →+*
      FFClosure (geomCurve Ω C))) = (geomCuspInertia Ω C (W.comap (τ.symm :
        FFClosure (geomCurve Ω C) →+* FFClosure (geomCurve Ω C)))).map (geomToPi Ω C hc) :=
    (map_geomCuspInertia Ω C hc hkW').symm
  have a2 : arithInertia Ω C hc W = (geomCuspInertia Ω C W).map (geomToPi Ω C hc) :=
    (map_geomCuspInertia Ω C hc hkW).symm
  rw [a1, a2]
  exact map_geomCuspInertia_comap Ω C hc hkW τ hkW'

include hc' in
/-- **(A2) The surviving cusps form one conjugacy class**: if `X̄_Ω ∖ U'_Ω` has at most one point,
any two cuspidal inertia groups of `Π_U` not contained in `ker(Π_U ↠ Π_{U'})` are
`Π_U`-conjugate. -/
theorem exists_conj_eq_of_not_le_ker_fillMap₂ [Nonempty (baseChangeOpen K Ω U')]
    (h1 : ((baseChangeOpen K Ω U' : Set (geomCurve Ω C))ᶜ : Set (geomCurve Ω C)).Subsingleton)
    {J J' : Subgroup π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))}
    (hJ : J ∈ arithCusps Ω C hc) (hJ' : J' ∈ arithCusps Ω C hc)
    (hJk : ¬ J ≤ (fillMap Ω C hc h).toMonoidHom.ker)
    (hJk' : ¬ J' ≤ (fillMap Ω C hc h).toMonoidHom.ker) :
    ∃ v, J' = J.map (MulAut.conj v).toMonoidHom := by
  obtain ⟨W, hW, rfl⟩ := (mem_arithCusps_iff Ω C hc).1 hJ
  obtain ⟨W', hW', rfl⟩ := (mem_arithCusps_iff Ω C hc).1 hJ'
  have hnc : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W := fun hV ↦
    hJk (arithInertia_le_ker_fillMap_of_isCentredOn₂ Ω C hc h hc' hW hV)
  have hnc' : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W' := fun hV ↦
    hJk' (arithInertia_le_ker_fillMap_of_isCentredOn₂ Ω C hc h hc' hW' hV)
  obtain ⟨n, -, hn⟩ := exists_comap_eq_of_not_isCentredOn₂ Ω C hc h1 hW.1 hW'.1 hnc hnc'
  subst hn
  exact ⟨arithAction Ω C hc n, arithInertia_comap_symm₂ Ω C hc hW.1 n hW'.1⟩

include hc' in
/-- **(A3) Some cusp survives the filling** when `(X̄, U')` is hyperbolic: a place centred on `X̄_Ω`
at a point outside `U'_Ω` has inertia group not contained in `ker(Π_U ↠ Π_{U'})`. -/
theorem exists_mem_arithCusps_not_le_ker_fillMap₂ [Nonempty (baseChangeOpen K Ω U')]
    (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
      2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U') :
    ∃ J ∈ arithCusps Ω C hc, ¬ J ≤ (fillMap Ω C hc h).toMonoidHom.ker := by
  obtain ⟨x, hx⟩ := compl_nonempty_baseChangeOpen K Ω hc'
  haveI : Nonempty (⊤ : (geomCurve Ω C).Opens) :=
    ⟨⟨(Nonempty.some (inferInstance : Nonempty (geomOpen Ω C))).1, trivial⟩⟩
  obtain ⟨W, -, hWV, hWU⟩ := exists_isCentredOn_not_isCentredOn (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C)) (V := ⊤)
    (compl_finite_baseChangeOpen K Ω (C.nonempty.mono h)) trivial hx
  have hW : IsCuspPlace Ω C hc W := isCuspPlace_of_not_isCentredOn_fill₂ Ω C hc h hWV.1 hWU
  refine ⟨_, (mem_arithCusps_iff Ω C hc).2 ⟨W, hW, rfl⟩, fun hle ↦ ?_⟩
  have hle' : (geomCuspInertia Ω C W).map (geomToPi Ω C hc) ≤
      (fillMap Ω C hc h).toMonoidHom.ker := by
    have e : (geomCuspInertia Ω C W).map (geomToPi Ω C hc) = arithInertia Ω C hc W :=
      map_geomCuspInertia Ω C hc hW.1
    rw [e]
    exact hle
  have hhyp := isHyperbolic_baseChange Ω (fillCurve C h hyp)
  exact false_of_le_ker Ω C hc h hc' hhyp hWV.1 hWU 1
    (by rw [Subgroup.relIndex_self]; exact one_ne_zero) (map_conj_le_of_le_normal 1 hle')

end Fill

section Cor38

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (CX : HypCurve K)
  (hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty) (UX : CX.Xbar.Opens) (hUX : UX ≤ CX.U)
  (hne : (UX : Set CX.Xbar).Nonempty)
  (α₀ : fiber (basePoint Ω CX hcX) ≅
    fiber (fillPoint Ω (subCurve CX UX hUX hne) (compl_nonempty_of_le hUX hcX) hUX))

/-- `cor38Fill` and `fillMap` have the same kernel. -/
lemma ker_cor38Fill₂ : (cor38Fill Ω CX hcX UX hUX hne α₀).ker =
    (fillMap Ω (subCurve CX UX hUX hne) (compl_nonempty_of_le hUX hcX) hUX).toMonoidHom.ker := by
  ext x
  have e := cor38Fill_eq_iff Ω CX hcX UX hUX hne α₀ x 1
  have h1 : fillMap Ω (subCurve CX UX hUX hne) (compl_nonempty_of_le hUX hcX) hUX 1 = 1 :=
    map_one _
  have h0 : cor38Fill Ω CX hcX UX hUX hne α₀ 1 = 1 := map_one _
  exact ⟨fun hx ↦ MonoidHom.mem_ker.2 ((e.1 ((MonoidHom.mem_ker.1 hx).trans h0.symm)).trans h1),
    fun hx ↦ MonoidHom.mem_ker.2 ((e.2 ((MonoidHom.mem_ker.1 hx).trans h1.symm)).trans h0)⟩

end Cor38

section Elliptic

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (E : WeierstrassCurve K) [E.IsElliptic]
  (hcX : ((hypCurveX E).U : Set (hypCurveX E).Xbar)ᶜ.Nonempty)
  (hne : ((VE E : (curveE E).Opens) : Set (curveE E)).Nonempty)
  (α₀ : fiber (basePoint Ω (hypCurveX E) hcX) ≅
    fiber (fillPoint Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
      (compl_nonempty_of_le (VE_le_XE E) hcX) (VE_le_XE E)))

attribute [local instance] isAlgClosure_of_isAlgebraic

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
/-- `(E ∖ {O})_Ω ⊆ Ē_Ω` has (at most) one cusp, as a hypothesis on `U_Ω ⊆ U'_Ω` for
`U = E ∖ E[2]`. -/
lemma subsingleton_compl_baseChangeOpen_XE₂ :
    ((baseChangeOpen K Ω (XE E) : Set (baseChange K Ω (curveE E)))ᶜ :
      Set (baseChange K Ω (curveE E))).Subsingleton := by
  have := card_compl_baseChangeOpen_XE E Ω
  rw [Nat.card_eq_one_iff_unique] at this
  exact fun a ha b hb ↦ congrArg Subtype.val (this.1.elim ⟨a, ha⟩ ⟨b, hb⟩)

/-- **(A1) for `E ∖ E[2] ⊆ E ∖ {O}`**: `ker(Π_{E∖E[2]} ↠ Π_{E∖O})` is the closed normal subgroup
generated by the cuspidal inertia groups it contains. -/
theorem ker_cor38Fill_eq_closure_killedCusps_VE₂ :
    (cor38Fill Ω (hypCurveX E) hcX (VE E) (VE_le_XE E) hne α₀).ker =
      (Subgroup.normalClosure (⋃ (J : Subgroup (arithmeticExt Ω
        (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
        (compl_nonempty_of_le (VE_le_XE E) hcX)).Pi) (_ : J ∈ arithCusps Ω
        (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
        (compl_nonempty_of_le (VE_le_XE E) hcX) ∧
        J ≤ (cor38Fill Ω (hypCurveX E) hcX (VE E) (VE_le_XE E) hne α₀).ker),
          (J : Set _))).topologicalClosure := by
  haveI : Nonempty (baseChangeOpen K Ω (hypCurveX E).U : (geomCurve Ω
      (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)).Opens) :=
    (nonempty_baseChangeOpen K Ω ((VE_nonempty E).mono (VE_le_XE E))).to_subtype
  rw [ker_cor38Fill₂]
  exact ker_fillMap_eq_closure_killedCusps₂ Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
    (compl_nonempty_of_le (VE_le_XE E) hcX) (U' := (hypCurveX E).U) (VE_le_XE E) hcX

/-- **(A2) for `E ∖ E[2] ⊆ E ∖ {O}`**: the cuspidal inertia groups of `Π_{E∖E[2]}` not killed in
`Π_{E∖O}` are all conjugate. -/
theorem exists_conj_eq_of_not_le_ker_cor38Fill_VE₂
    {J J' : Subgroup (arithmeticExt Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
      (compl_nonempty_of_le (VE_le_XE E) hcX)).Pi}
    (hJ : J ∈ arithCusps Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
      (compl_nonempty_of_le (VE_le_XE E) hcX))
    (hJ' : J' ∈ arithCusps Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
      (compl_nonempty_of_le (VE_le_XE E) hcX))
    (hJk : ¬ J ≤ (cor38Fill Ω (hypCurveX E) hcX (VE E) (VE_le_XE E) hne α₀).ker)
    (hJk' : ¬ J' ≤ (cor38Fill Ω (hypCurveX E) hcX (VE E) (VE_le_XE E) hne α₀).ker) :
    ∃ v, J' = J.map (MulAut.conj v).toMonoidHom := by
  haveI : Nonempty (baseChangeOpen K Ω (hypCurveX E).U : (geomCurve Ω
      (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)).Opens) :=
    (nonempty_baseChangeOpen K Ω ((VE_nonempty E).mono (VE_le_XE E))).to_subtype
  rw [ker_cor38Fill₂] at hJk hJk'
  exact exists_conj_eq_of_not_le_ker_fillMap₂ Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
    (compl_nonempty_of_le (VE_le_XE E) hcX) (U' := (hypCurveX E).U) (VE_le_XE E) hcX
    (subsingleton_compl_baseChangeOpen_XE₂ Ω E) hJ hJ' hJk hJk'

/-- **(A3) for `E ∖ E[2] ⊆ E ∖ {O}`**: some cuspidal inertia group of `Π_{E∖E[2]}` is not killed
in `Π_{E∖O}`. -/
theorem exists_mem_arithCusps_not_le_ker_cor38Fill_VE₂ :
    ∃ J ∈ arithCusps Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
      (compl_nonempty_of_le (VE_le_XE E) hcX),
      ¬ J ≤ (cor38Fill Ω (hypCurveX E) hcX (VE E) (VE_le_XE E) hne α₀).ker := by
  haveI : Nonempty (baseChangeOpen K Ω (hypCurveX E).U : (geomCurve Ω
      (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)).Opens) :=
    (nonempty_baseChangeOpen K Ω ((VE_nonempty E).mono (VE_le_XE E))).to_subtype
  rw [ker_cor38Fill₂]
  exact exists_mem_arithCusps_not_le_ker_fillMap₂ Ω (subCurve (hypCurveX E) (VE E) (VE_le_XE E) hne)
    (compl_nonempty_of_le (VE_le_XE E) hcX) (U' := (hypCurveX E).U) (VE_le_XE E) hcX
    (hypCurveX E).hyperbolic

end Elliptic

end CurvesJacobian.Cusp
