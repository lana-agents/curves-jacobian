import CurvesJacobian.Cusp.EtLocTerminal
import CurvesJacobian.Cusp.HemiInvolutionGen

/-!
# `Π_C` as a chain object; [AbsTopII] Cor. 3.3 (i) for the hemi-elliptic core (MR8)

Let `E` be an elliptic curve over a number field `K`, `X = E ∖ {O}`, `Π_X ↠ G_K` the arithmetic
fundamental group of `X` (`arithmeticExt Ω' (hypCurveX E) _`, a `CuspidalExt.{u+1}`) and
`C = [X / ±1]` the hemi-elliptic orbicurve, with `Π_C = etalePi1 R A Ω` (in `Type u`),
`Π_X ↪ Π_C` (`hemiPiXEmb`, open of index `2`) and `Π_C → G_K` (`hemiPrC`).

* `CurvesJacobian.Cusp.hemiCoreGrp₄`: `Π_C⁺ = ULift Π_C` as a `ProfiniteGrp.{u+1}`, with
  `hemiCoreEmb₄ : Π_X → Π_C⁺` and `hemiCorePr₄ : Π_C⁺ → G_K`.
* **`Δ_C` is slim** (`CurvesJacobian.Cusp.isSlim_ker_hemiPrC₄`), from the generic
  `CurvesJacobian.Cusp.isSlim_of_involutions₄`: if `X ⊆ Q` has index `2`, `D = X ∩ Δ` is slim,
  torsion-free and nontrivial and `Δ` is topologically generated by involutions outside `X`,
  then `Δ` is slim. (An element `z ∈ Δ` centralising an open subgroup centralises `D`, as `D` is
  slim; so `z² = 1`; if `z ∉ X`, every involution of `Δ` outside `X` is `z` (`D` torsion-free),
  so `Δ ⊆ {1, z}`, contradicting `D ≠ 1`.) Input: `hemi_hgen` (`HemiInvolutionGen`).
* `CurvesJacobian.Cusp.hemiCObj`: `Π_C⁺` as the target of an operation of type `⋎` from the
  base object `Π_X` (`ChainObj.postObj`), and `CurvesJacobian.Cusp.hemiCoreChain`: the
  length-one chain `Π_X ⇝ Π_C` of type `[⋎]` (`hemiCoreChain_typeChain`, `hemiCoreChain_last`).
* **[AbsTopII] Cor. 3.3 (i) for `X = E ∖ {O}`, modulo debt D-c**
  (`Topics in Absolute Anabelian Geometry II.txt` l.4440–4447): `hemi_cor33i`: if `Π_C` is
  self-commensurating over `G_K` (`ChainObj.SelfComm`, hypothesis `hC`, debt D-c: to be
  proved from the relative isomorphism version of the Grothendieck conjecture and the core
  property of `C`), then `Π_X ⇝ Π_C` is a terminal object of `ÉtLoc(Π_X)`;
  `hemi_cor33i_of_selfCommX`: the same with `hC` reduced to open injections with image in `Π_X`
  (`ChainObj.selfComm_of_open`).
-/

open CategoryTheory AlgebraicGeometry Pi1.Profinite Pi1.Orbifold Belyi Belyi.Anabelian Topology

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section GroupTheory

variable {Q : Type*} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]

/-- An element normalising a slim subgroup `D` and centralising an open subgroup of `D`
centralises `D`. -/
lemma commute_of_isSlim₄ {D : Subgroup Q} (hD : IsSlim D) {z : Q}
    (hn : ∀ a ∈ D, z * a * z⁻¹ ∈ D) (U : OpenSubgroup D) (hz : ∀ u ∈ U, z * (u : Q) = u * z)
    (a : Q) (ha : a ∈ D) : z * a = a * z := by
  let c : D →* D := (MulAut.conj (⟨a, ha⟩ : D)).toMonoidHom
  have hcc : Continuous c := by
    change Continuous fun x : D => (⟨a, ha⟩ : D) * x * (⟨a, ha⟩ : D)⁻¹
    exact (continuous_const.mul continuous_id).mul continuous_const
  let V : OpenSubgroup D := U ⊓ U.comap c hcc
  have hw : a⁻¹ * (z * a * z⁻¹) ∈ D := D.mul_mem (D.inv_mem ha) (hn a ha)
  have h1 := hD V ⟨_, hw⟩ (fun v hv => by
    have hv1 : z * (v : Q) = v * z := hz v hv.1
    have hv2 : z * (a * v * a⁻¹) = (a * v * a⁻¹) * z := hz (c v) hv.2
    apply Subtype.ext
    change a⁻¹ * (z * a * z⁻¹) * v = v * (a⁻¹ * (z * a * z⁻¹))
    refine inv_mul_comm_of_conj_eq₄ ?_
    have e1 : z⁻¹ * (v : Q) * z = v := by
      rw [mul_assoc, ← hv1, ← mul_assoc, inv_mul_cancel, one_mul]
    have e2 : z * (a * v * a⁻¹) * z⁻¹ = a * v * a⁻¹ := by
      rw [hv2, mul_assoc, mul_inv_cancel, mul_one]
    calc a * v * a⁻¹ = z * (a * v * a⁻¹) * z⁻¹ := e2.symm
      _ = z * a * (z⁻¹ * v * z) * a⁻¹ * z⁻¹ := by rw [e1]; group
      _ = (z * a * z⁻¹) * v * (z * a * z⁻¹)⁻¹ := by group)
  have h2 : a = z * a * z⁻¹ := inv_mul_eq_one.1 (congrArg Subtype.val h1)
  calc z * a = z * a * z⁻¹ * z := by group
    _ = a * z := by rw [← h2]

/-- **Slimness from generation by involutions outside an index-`2` subgroup.** Let `X ⊆ Q` have
index `2` and `Δ ⊆ Q` be normal, with `D = X ∩ Δ` slim, torsion-free and nontrivial. If `Δ` is
topologically generated by the involutions of `Δ` not in `X`, then `Δ` is slim. -/
theorem isSlim_of_involutions₄ [T2Space Q] {Δ X : Subgroup Q} (hX : X.index = 2)
    (hΔ : Δ.Normal) (hD : IsSlim (X ⊓ Δ : Subgroup Q)) (htf : IsTorsionFreeSubgroup (X ⊓ Δ))
    (hne : X ⊓ Δ ≠ ⊥)
    (hgen : Δ ≤ (Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X}).topologicalClosure) :
    IsSlim Δ := by
  intro U z hz
  haveI hXn : X.Normal := Subgroup.normal_of_index_eq_two hX
  let ι : (X ⊓ Δ : Subgroup Q) →* Δ := Subgroup.inclusion inf_le_right
  have hι : Continuous ι := continuous_induced_rng.2 continuous_subtype_val
  have hz' : ∀ u ∈ U.comap ι hι, (z : Q) * u = u * z := fun u hu =>
    congrArg Subtype.val (hz (ι u) hu)
  have hn : ∀ a ∈ X ⊓ Δ, (z : Q) * a * (z : Q)⁻¹ ∈ X ⊓ Δ := fun a ha =>
    ⟨hXn.conj_mem a ha.1 z, hΔ.conj_mem a ha.2 z⟩
  have hc : ∀ a ∈ X ⊓ Δ, (z : Q) * a = a * z := commute_of_isSlim₄ hD hn _ hz'
  have hz2 : (z : Q) ^ 2 = 1 := by
    have hm : (z : Q) ^ 2 ∈ X ⊓ Δ := ⟨Subgroup.sq_mem_of_index_two hX _, Δ.pow_mem z.2 2⟩
    have := hD ⊤ ⟨_, hm⟩ (fun u _ => Subtype.ext (by
      change (z : Q) ^ 2 * u = u * (z : Q) ^ 2
      calc (z : Q) ^ 2 * u = z * (z * u) := by rw [pow_two, mul_assoc]
        _ = z * (u * z) := by rw [hc u u.2]
        _ = (z * u) * z := by rw [mul_assoc]
        _ = u * z * z := by rw [hc u u.2]
        _ = u * (z : Q) ^ 2 := by rw [pow_two, mul_assoc]))
    exact congrArg Subtype.val this
  apply Subtype.ext
  change (z : Q) = 1
  by_cases hzX : (z : Q) ∈ X
  · have := hD ⊤ ⟨z, hzX, z.2⟩ (fun u _ => Subtype.ext (hc u u.2))
    exact congrArg Subtype.val this
  · exfalso
    have hτ : ∀ τ ∈ {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X}, τ = z := by
      rintro τ ⟨hτΔ, hτ2, hτX⟩
      have hdX : (z : Q)⁻¹ * τ ∈ X := (Subgroup.mul_mem_iff_of_index_two hX).2
        (iff_of_false (fun h => hzX (X.inv_mem_iff.1 h)) hτX)
      have hdΔ : (z : Q)⁻¹ * τ ∈ Δ := Δ.mul_mem (Δ.inv_mem z.2) hτΔ
      obtain ⟨d, hdX', hdΔ', hτd⟩ : ∃ d, d ∈ X ∧ d ∈ Δ ∧ τ = z * d :=
        ⟨(z : Q)⁻¹ * τ, hdX, hdΔ, by group⟩
      have hcd : (z : Q) * d = d * z := hc d ⟨hdX', hdΔ'⟩
      have hd2 : d ^ 2 = 1 := by
        rw [hτd] at hτ2
        calc d ^ 2 = (z : Q) ^ 2 * d ^ 2 := by rw [hz2, one_mul]
          _ = z * (z * d) * d := by rw [pow_two, pow_two]; group
          _ = z * (d * z) * d := by rw [hcd]
          _ = (z * d) ^ 2 := by rw [pow_two]; group
          _ = 1 := hτ2
      have hd1 : d = 1 := htf d ⟨hdX', hdΔ'⟩ (isOfFinOrder_iff_pow_eq_one.2 ⟨2, two_pos, hd2⟩)
      rw [hτd, hd1, mul_one]
    have hcl : Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X} ≤ Subgroup.zpowers (z : Q) :=
      (Subgroup.closure_le _).2 fun τ hτ' => by
        rw [hτ τ hτ']
        exact Subgroup.mem_zpowers _
    have hfin : ∀ y ∈ Subgroup.zpowers (z : Q), y = 1 ∨ y = z := by
      intro y hy
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
      have h2 : (z : Q) ^ (2 : ℤ) = 1 := by rw [zpow_two, ← pow_two]; exact hz2
      rw [zpow_eq_zpow_emod k h2]
      rcases Int.emod_two_eq_zero_or_one k with h | h
      · left
        rw [h, zpow_zero]
      · right
        rw [h, zpow_one]
    have hclosed : IsClosed ((Subgroup.zpowers (z : Q) : Subgroup Q) : Set Q) := by
      refine Set.Finite.isClosed (Set.Finite.subset (Set.toFinite {1, (z : Q)}) ?_)
      intro y hy
      rcases hfin y hy with h | h
      · exact Or.inl h
      · exact Or.inr h
    have hΔle : Δ ≤ Subgroup.zpowers (z : Q) :=
      hgen.trans (Subgroup.topologicalClosure_minimal _ hcl hclosed)
    refine hne ((Subgroup.eq_bot_iff_forall _).2 fun y hy => ?_)
    rcases hfin y (hΔle hy.2) with h | h
    · exact h
    · exact absurd (h ▸ hy.1) hzX

end GroupTheory

section Transport

variable {P Q G : Type*} [Group P] [TopologicalSpace P] [IsTopologicalGroup P] [CompactSpace P]
  [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q] [T2Space Q]
  [Group G] [TopologicalSpace G] [T2Space G]

omit [IsTopologicalGroup P] [CompactSpace P] in
lemma _root_.ContinuousMonoidHom.isClosed_ker₄ (f : P →ₜ* G) :
    IsClosed ((f.toMonoidHom.ker : Subgroup P) : Set P) :=
  isClosed_singleton.preimage f.continuous

omit [IsTopologicalGroup P] [IsTopologicalGroup Q] in
/-- Slimness is transported along an injective continuous homomorphism of a compact group. -/
theorem isSlim_map₄ (f : P →ₜ* Q) (hf : Function.Injective f) {A : Subgroup P}
    (hA : IsClosed (A : Set P)) (h : IsSlim A) : IsSlim (A.map f.toMonoidHom) := by
  haveI : CompactSpace A := isCompact_iff_compactSpace.mp hA.isCompact
  let g : A →ₜ* A.map f.toMonoidHom :=
    ⟨(f.toMonoidHom.comp A.subtype).codRestrict _ fun x => ⟨x, x.2, rfl⟩,
      (f.continuous.comp continuous_subtype_val).subtype_mk _⟩
  have hg : Function.Bijective g := by
    refine ⟨fun x y hxy => Subtype.ext (hf (congrArg Subtype.val hxy)), fun y => ?_⟩
    obtain ⟨x, hx, hxy⟩ := y.2
    exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  exact IsSlim.of_continuousMulEquiv (continuousMulEquivOfBijective g hg) h

omit [IsTopologicalGroup P] [IsTopologicalGroup Q] [CompactSpace P] [T2Space Q] [T2Space G] in
lemma ker_comp_symm₄ (e : P ≃ₜ* Q) (f : P →ₜ* G) :
    (f.comp (ContinuousMonoidHom.toContinuousMonoidHom e.symm)).toMonoidHom.ker =
      f.toMonoidHom.ker.map (ContinuousMonoidHom.toContinuousMonoidHom e).toMonoidHom := by
  ext y
  constructor
  · intro hy
    exact ⟨e.symm y, hy, e.apply_symm_apply y⟩
  · rintro ⟨x, hx, rfl⟩
    change f (e.symm (e x)) = 1
    rw [ContinuousMulEquiv.symm_apply_apply]
    exact hx

omit [IsTopologicalGroup P] [IsTopologicalGroup Q] in
/-- Slimness of the kernel is transported along an isomorphism of the source. -/
theorem isSlim_ker_comp_symm₄ (e : P ≃ₜ* Q) (f : P →ₜ* G) (h : IsSlim f.toMonoidHom.ker) :
    IsSlim (f.comp (ContinuousMonoidHom.toContinuousMonoidHom e.symm)).toMonoidHom.ker := by
  rw [ker_comp_symm₄]
  exact isSlim_map₄ _ e.injective f.isClosed_ker₄ h

omit [IsTopologicalGroup P] [IsTopologicalGroup Q] [CompactSpace P] [T2Space Q] [T2Space G] in
lemma ker_comp_symm_ne_bot₄ (e : P ≃ₜ* Q) (f : P →ₜ* G) (h : f.toMonoidHom.ker ≠ ⊥) :
    (f.comp (ContinuousMonoidHom.toContinuousMonoidHom e.symm)).toMonoidHom.ker ≠ ⊥ := by
  rw [ker_comp_symm₄, Ne, Subgroup.map_eq_bot_iff_of_injective _ e.injective]
  exact h

end Transport

/-! ### `Δ_C` is slim and nontrivial -/

section Hemi

variable {K : Type u} [Field K] [NumberField K] (E : WeierstrassCurve K) [E.IsElliptic]
  (Ω' : Type u) [Field Ω'] [Algebra K Ω'] [IsAlgClosed Ω'] [Algebra.IsAlgebraic K Ω']
  [CharZero Ω']


/-- `Π_X ∩ Δ_C = Δ_X` is nontrivial. -/
theorem hemiCore_inf_ne_bot₄ :
    (hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker ≠ ⊥ := by
  rw [hemi_range_inf_ker, Ne,
    Subgroup.map_eq_bot_iff_of_injective _ (hemi_arith_orbiEmb E Ω').1.injective]
  exact (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).nontrivial_delta

/-- `Π_X ∩ Δ_C = Δ_X` is slim. -/
theorem isSlim_hemiCore_inf₄ :
    IsSlim ((hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker :
      Subgroup (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)))) := by
  rw [hemi_range_inf_ker]
  exact isSlim_map₄ (hemiPiXEmb E Ω') (hemi_arith_orbiEmb E Ω').1.injective
    (ContinuousMonoidHom.isClosed_ker₄ (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).pr)
    (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).slim_delta

/-- **`Δ_C` is slim** (`C` the hemi-elliptic orbicurve): `Δ_X` is slim and torsion-free, and
`Δ_C` is generated by involutions outside `Π_X` (`hemi_hgen`). -/
theorem isSlim_ker_hemiPrC₄ : IsSlim (hemiPrC E Ω').toMonoidHom.ker :=
  isSlim_of_involutions₄ (hemi_arith_orbiEmb E Ω').2.2.1 (hemiPrC E Ω').toMonoidHom.normal_ker
    (isSlim_hemiCore_inf₄ E Ω')
    (isTorsionFreeSubgroup_hemi_range_inf E Ω') (hemiCore_inf_ne_bot₄ E Ω') (hemi_hgen E Ω')

/-- **`Δ_C` is nontrivial.** -/
theorem ker_hemiPrC_ne_bot₄ : (hemiPrC E Ω').toMonoidHom.ker ≠ ⊥ := fun h =>
  hemiCore_inf_ne_bot₄ E Ω' (eq_bot_mono inf_le_right h)

end Hemi

/-! ### `Π_C⁺ = ULift Π_C` as a `ProfiniteGrp.{u+1}` -/

section Lift

variable {K : Type u} [Field K] [NumberField K] (E : WeierstrassCurve K) [E.IsElliptic]

/-- `Π_C ≃ₜ* ULift Π_C`. -/
def hemiCoreULiftEquiv₄ : etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)) ≃ₜ*
    ULift.{u + 1} (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E))) :=
  ⟨MulEquiv.ulift.symm, continuous_uliftUp, continuous_uliftDown⟩

/-- **`Π_C⁺`**: the étale fundamental group `Π_C` of the hemi-elliptic orbicurve, lifted to a
profinite group in `Type (u+1)` (the universe of `Π_X` and `G_K` in `arithmeticExt`). -/
def hemiCoreGrp₄ : ProfiniteGrp.{u + 1} :=
  ProfiniteGrp.ofContinuousMulEquiv
    (G := etalePi1Profinite (hemiData E).R (hemiData E).A (FFClosure (curveE E)))
    (hemiCoreULiftEquiv₄ E)

/-- `Π_C ≃ₜ* Π_C⁺`. -/
def hemiCoreEquiv₄ :
    etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)) ≃ₜ* hemiCoreGrp₄ E :=
  hemiCoreULiftEquiv₄ E

variable (Ω' : Type u) [Field Ω'] [Algebra K Ω'] [IsAlgClosed Ω'] [Algebra.IsAlgebraic K Ω']
  [CharZero Ω']

/-- `Π_X ↪ Π_C⁺`. -/
def hemiCoreEmb₄ :
    (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Pi →ₜ* hemiCoreGrp₄ E :=
  (ContinuousMonoidHom.toContinuousMonoidHom (hemiCoreEquiv₄ E)).comp (hemiPiXEmb E Ω')

/-- `Π_C⁺ → G_K`. -/
def hemiCorePr₄ : hemiCoreGrp₄ E →ₜ* (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).G :=
  (hemiPrC E Ω').comp (ContinuousMonoidHom.toContinuousMonoidHom (hemiCoreEquiv₄ E).symm)

lemma hemiCorePr₄_hemiCoreEmb₄ (x : (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Pi) :
    hemiCorePr₄ E Ω' (hemiCoreEmb₄ E Ω' x) =
      (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).pr x := by
  change hemiPrC E Ω' ((hemiCoreEquiv₄ E).symm (hemiCoreEquiv₄ E (hemiPiXEmb E Ω' x))) = _
  rw [ContinuousMulEquiv.symm_apply_apply]
  exact hemiPrC_hemiPiXEmb E Ω' x

lemma isOpenEmbedding_hemiCoreEmb₄ : IsOpenEmbedding (hemiCoreEmb₄ E Ω') :=
  (hemiCoreEquiv₄ E).toHomeomorph.isOpenEmbedding.comp (hemi_arith_orbiEmb E Ω').1

lemma isOpen_range_hemiCorePr₄ : IsOpen (Set.range (hemiCorePr₄ E Ω')) := by
  have h : Set.range (hemiCorePr₄ E Ω') = Set.univ := Set.eq_univ_of_forall fun g => by
    obtain ⟨x, rfl⟩ := (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).pr_surjective g
    exact ⟨hemiCoreEmb₄ E Ω' x, hemiCorePr₄_hemiCoreEmb₄ E Ω' x⟩
  rw [h]
  exact isOpen_univ

theorem isSlim_ker_hemiCorePr₄ : IsSlim (hemiCorePr₄ E Ω').toMonoidHom.ker :=
  isSlim_ker_comp_symm₄ (hemiCoreEquiv₄ E) (hemiPrC E Ω') (isSlim_ker_hemiPrC₄ E Ω')

theorem ker_hemiCorePr₄_ne_bot : (hemiCorePr₄ E Ω').toMonoidHom.ker ≠ ⊥ :=
  ker_comp_symm_ne_bot₄ (hemiCoreEquiv₄ E) (hemiPrC E Ω') (ker_hemiPrC_ne_bot₄ E Ω')

/-! ### The chain `Π_X ⇝ Π_C` -/

/-- **`Π_C` as a chain object of `ÉtLoc(Π_X)`**: the target of the operation of type `⋎` along
`Π_X ↪ Π_C⁺` from the base object (rigidification `ρ = (Π_X ↪ Π_C⁺)`). -/
def hemiCObj : ChainObj (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)) :=
  (ChainObj.base (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E))).postObj
    (hemiCoreEmb₄ E Ω') (isOpenEmbedding_hemiCoreEmb₄ E Ω').isOpen_range
    (hemiCorePr₄ E Ω') (hemiCorePr₄_hemiCoreEmb₄ E Ω') (isOpen_range_hemiCorePr₄ E Ω')
    (isSlim_ker_hemiCorePr₄ E Ω') (ker_hemiCorePr₄_ne_bot E Ω')

/-- The operation `Π_X ⇝ Π_C` of type `⋎`. -/
def hemiCoreOp₄ :
    ElemOp (ChainObj.base (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E))) (hemiCObj E Ω') :=
  ElemOp.ofQuot (ChainObj.base (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)))
    (hemiCoreEmb₄ E Ω')
    (isOpenEmbedding_hemiCoreEmb₄ E Ω').isOpen_range
    (hemiCorePr₄ E Ω') (hemiCorePr₄_hemiCoreEmb₄ E Ω') (isOpen_range_hemiCorePr₄ E Ω')
    (isSlim_ker_hemiCorePr₄ E Ω') (ker_hemiCorePr₄_ne_bot E Ω')
    (isOpenEmbedding_hemiCoreEmb₄ E Ω').injective

/-- **The length-one chain `Π_X ⇝ Π_C`** of type `⋎` ([AbsTopII] Cor. 3.3 (i)). -/
def hemiCoreChain : PiChain (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)) :=
  (OpPath.single (hemiCoreOp₄ E Ω')).toPiChain

lemma hemiCoreChain_len : (hemiCoreChain E Ω').len = 1 := rfl

lemma hemiCoreChain_typeChain : (hemiCoreChain E Ω').typeChain = [OpKind.quot] := by
  change List.ofFn (fun j : Fin 1 => ((hemiCoreChain E Ω').op j).kind) = [OpKind.quot]
  rw [List.ofFn_succ, List.ofFn_zero]
  rfl

lemma hemiCoreChain_last : (hemiCoreChain E Ω').last = hemiCObj E Ω' := rfl

lemma hemiCObj_grp : (hemiCObj E Ω').grp = hemiCoreGrp₄ E := rfl

lemma hemiCObj_toG : (hemiCObj E Ω').toG = hemiCorePr₄ E Ω' := rfl

/-! ### [AbsTopII] Cor. 3.3 (i) for `X = E ∖ {O}`, modulo debt D-c -/

/-- **[AbsTopII] Cor. 3.3 (i) for `X = E ∖ {O}` and its `K`-core, the hemi-elliptic orbicurve
`C = [X / ±1]`, modulo debt D-c.** The length-one chain `Π_X ⇝ Π_C` of type `⋎` is a terminal
object of `ÉtLoc(Π_X)`, provided `Π_C` is self-commensurating over `G_K` (hypothesis `hC`,
**debt D-c**: to be proved from the relative isomorphism version of the Grothendieck conjecture
and the core property of `C`; not proved here). -/
theorem hemi_cor33i (hC : (hemiCoreChain E Ω').last.SelfComm) :
    (hemiCoreChain E Ω').IsTerminalEtLoc :=
  PiChain.isTerminalEtLoc_of_selfComm _ (fun t ht => by
    rw [hemiCoreChain_typeChain] at ht
    exact List.mem_singleton.1 ht) hC

/-- **[AbsTopII] Cor. 3.3 (i) for `X = E ∖ {O}`, with debt D-c reduced to `Π_X`**: it suffices
that any two open injections `f₁, f₂ : P ↪ Π_C⁺` with image in `Π_X` whose composites with
`Π_C⁺ → G_K` differ by conjugation in `G_K` differ by an inner automorphism of `Π_C⁺`
(hypothesis `hC`, debt D-c; `ChainObj.selfComm_of_open`). -/
theorem hemi_cor33i_of_selfCommX
    (hC : ∀ (P : Type (u + 1)) [Group P] [TopologicalSpace P] [IsTopologicalGroup P]
      [CompactSpace P] (f₁ f₂ : P →ₜ* hemiCoreGrp₄ E),
      Function.Injective f₁ → IsOpen (Set.range f₁) →
      Function.Injective f₂ → IsOpen (Set.range f₂) →
      Set.range f₁ ⊆ Set.range (hemiCoreEmb₄ E Ω') → Set.range f₂ ⊆ Set.range (hemiCoreEmb₄ E Ω') →
      ∀ g : (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).G,
      (∀ x, hemiCorePr₄ E Ω' (f₂ x) = g * hemiCorePr₄ E Ω' (f₁ x) * g⁻¹) →
      ∃ γ : hemiCoreGrp₄ E, ∀ x, f₂ x = γ * f₁ x * γ⁻¹) :
    (hemiCoreChain E Ω').IsTerminalEtLoc :=
  hemi_cor33i E Ω' (ChainObj.selfComm_of_open (hemiCObj E Ω')
    (hemiCoreEmb₄ E Ω').toMonoidHom.range (isOpenEmbedding_hemiCoreEmb₄ E Ω').isOpen_range
    fun P _ _ _ _ f₁ f₂ hi₁ ho₁ hi₂ ho₂ hr₁ hr₂ g hg => hC P f₁ f₂ hi₁ ho₁ hi₂ ho₂ hr₁ hr₂ g hg)

end Lift

