import CurvesJacobian.Cusp.ModelEnlarge
import CurvesJacobian.Cusp.FillByKernel
import CurvesJacobian.Cusp.FillElemOp
import CurvesJacobian.Cusp.DecuspNormalizer

/-!
# Geometric models across operations of type `•` (MR8 (A4))

[AbsTopI] Definition 4.2 (iii) (c) and Theorem 4.7 (i) (`Topics in Absolute Anabelian Geometry
I.txt` l.3009–3015, l.3500–3510): an operation `φ : A ↠ B` of type `•` has kernel
`K = deltaNormalClosure C`, the closed subgroup generated by the `Δ_A`-conjugates of a cuspidal
decomposition group `C ⊆ J`, `J ⊴ Δ_A` open and torsion-free; it corresponds to the filling of a
single rational cusp ([AbsTopI] Lemma 4.1 (v), l.2753–2771).

For a geometric model `D` of `A` (`CurvesJacobian.Cusp.GeomModel`) we construct a geometric model
of `B` (`GeomModel.exists_decusp`), assuming the rel-isom-DGC over number fields (`hDGC`, the only
DGC input) and that some cuspidal decomposition group of `Π_X` has an infinite image in `B` (`hB`;
in a Belyi chain this holds since the last object of the run of `•`'s embeds openly into `Π_X`).

1. `P' = J · U` (`U ⊴ A` open with `U ∩ Δ_A ⊆ J`) is open in `A`, normalised by `Δ_A`, with
   `P' ∩ Δ_A = J` torsion-free and `K ⊆ J ⊆ P'` (`ChainObj.exists_open_inf_Delta_eq`,
   `ChainObj.deltaNormalClosure_le`); by option (Q) (`GeomModel.exists_enlarge`) there is a
   model `(Z, ι')` of `A` with `ι'(Π_Z) = P'`.
2. `N = ι'⁻¹(K)` is the closed normal subgroup generated by the cuspidal inertia groups
   `ι'⁻¹(d C d⁻¹)` (`d ∈ Δ_A`) of `Π_Z` (`GeomModel.comap_mem_arithCusps_of_isCuspidal`, the
   semilinear action `GeomModel.map_conjPi_mem_arithCusps_iff`), and the cusp of `hB` survives;
   so `N` is the kernel of the filling `Π_Z ↠ Π_{Z'}` of an open `U' ⊇ U_Z` with a cusp
   (`CurvesJacobian.Cusp.exists_fill_ker_eq`), hyperbolic since `Δ_B` is not commutative.
3. `Π_{Z'} ≅ Π_Z / N ≅ φ(P') ⊆ B` gives the model `(Z', ι_B)` of `B`; the projection to `G_K`
   and the cusp compatibility come from those of `(Z, ι')` (as in `GeomModel.enlarge`).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi Belyi.Anabelian
  Pi1.Profinite PreGaloisCategory

universe u

noncomputable section

namespace Belyi.Anabelian.ChainObj

variable {E : CuspidalExt.{u}} (A : ChainObj E)

lemma isClosed_Delta : IsClosed (A.Delta : Set A.grp) := by
  have e : (A.Delta : Set A.grp) = A.toG ⁻¹' {1} := rfl
  rw [e]
  exact isClosed_singleton.preimage A.toG.continuous

variable {J : Subgroup A.grp} (hJ : J ≤ A.Delta) (hn : ∀ d ∈ A.Delta, ∀ n ∈ J, d * n * d⁻¹ ∈ J)
  (ho : IsOpen ((J.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta))

include hJ ho in
/-- A subgroup of `Δ_j` open in `Δ_j` is closed in `Π_j`. -/
lemma isClosed_of_isOpen_subgroupOf_Delta : IsClosed (J : Set A.grp) := by
  have h1 : IsClosed ((J.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta) :=
    Subgroup.isClosed_of_isOpen _ ho
  have h2 := A.isClosed_Delta.isClosedEmbedding_subtypeVal.isClosedMap _ h1
  have e : Subtype.val '' ((J.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta) = J := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨⟨x, hJ hx⟩, hx, rfl⟩
  convert h2
  exact e.symm

include hJ hn ho in
/-- **The kernel of `•` lies in `J`**: `deltaNormalClosure C ≤ J` for `C ≤ J`, `J` normalised
by `Δ_j` and open in `Δ_j`. -/
lemma deltaNormalClosure_le {C : Subgroup A.grp} (hCJ : C ≤ J) : A.deltaNormalClosure C ≤ J := by
  refine Subgroup.topologicalClosure_minimal _ ?_ (A.isClosed_of_isOpen_subgroupOf_Delta hJ ho)
  rw [Subgroup.closure_le]
  rintro _ ⟨d, hd, c, hc, rfl⟩
  exact hn d hd c (hCJ hc)

include hJ hn ho in
/-- **An open subgroup of `Π_j` normalised by `Δ_j` meeting `Δ_j` in `J`**: `P' = J · U` for an
open normal `U ⊴ Π_j` with `U ∩ Δ_j ⊆ J`. -/
theorem exists_open_inf_Delta_eq :
    ∃ P' : Subgroup A.grp, IsOpen (P' : Set A.grp) ∧
      A.Delta ≤ Subgroup.normalizer (P' : Set A.grp) ∧ P' ⊓ A.Delta = J := by
  obtain ⟨t, ht, htJ⟩ := isOpen_induced_iff.1 ho
  have h1 : (1 : A.grp) ∈ t := by
    have h : (1 : A.Delta) ∈ ((J.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta) :=
      (J.subgroupOf A.Delta).one_mem
    rw [← htJ] at h
    exact h
  obtain ⟨U, hU⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one ht h1
  let V : Subgroup A.grp := U.toOpenSubgroup.toSubgroup
  haveI hVn : V.Normal := U.isNormal'
  have hVo : IsOpen (V : Set A.grp) := U.toOpenSubgroup.isOpen
  have hVJ : ∀ v ∈ V, v ∈ A.Delta → v ∈ J := fun v hv hvΔ ↦ by
    have h : (⟨v, hvΔ⟩ : A.Delta) ∈ Subtype.val ⁻¹' t := hU hv
    rw [htJ] at h
    exact h
  refine ⟨J ⊔ V, Subgroup.isOpen_mono le_sup_right hVo, ?_, ?_⟩
  · refine le_normalizer_of_forall_conj_mem fun d hd x hx ↦ ?_
    obtain ⟨j, hj, v, hv, rfl⟩ := Subgroup.mem_sup_of_normal_right.1 hx
    refine Subgroup.mem_sup_of_normal_right.2
      ⟨d * j * d⁻¹, hn d hd j hj, d * v * d⁻¹, hVn.conj_mem v hv d, by group⟩
  · apply le_antisymm
    · rintro x ⟨hx, hxΔ⟩
      obtain ⟨j, hj, v, hv, rfl⟩ := Subgroup.mem_sup_of_normal_right.1 hx
      have hvΔ : v ∈ A.Delta := by
        have := A.Delta.mul_mem (A.Delta.inv_mem (hJ hj)) hxΔ
        rwa [inv_mul_cancel_left] at this
      exact J.mul_mem hj (hVJ v hv hvΔ)
    · exact le_inf le_sup_left hJ

end Belyi.Anabelian.ChainObj

namespace CurvesJacobian.Cusp.GeomModel

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty} {A B : ChainObj (arithmeticExt Ω CX hcX)}

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- The point `Spec Ω ⟶ Spec K`. -/
local notation "sK" => Spec.map (CommRingCat.ofHom (algebraMap K Ω))

/-! ### The data: a model `(Z, ι')` of `A` and `φ : A ↠ B` with kernel inside `ι'(Π_Z)` -/

variable (D : GeomModel Ω CX hcX A) (φ : A.grp →ₜ* B.grp) (hsurj : Function.Surjective φ)
  (hcompat : ChainObj.Compat A B φ)
  (hKP : (φ : A.grp →* B.grp).ker ≤ (D.ι : D.Pi →* A.grp).range)

/-- `Φ = φ ∘ ι' : Π_Z → B`. -/
def dcPhi : D.Pi →ₜ* B.grp := φ.comp D.ι

lemma dcPhi_apply (σ : D.Pi) : D.dcPhi φ σ = φ (D.ι σ) := rfl

/-- `N = ι'⁻¹(ker φ) = ker Φ`. -/
abbrev dcN : Subgroup D.Pi := (φ : A.grp →* B.grp).ker.comap (D.ι : D.Pi →* A.grp)

lemma ker_dcPhi : (D.dcPhi φ).toMonoidHom.ker = D.dcN φ := by
  ext σ
  rfl

/-- `P_B = φ(ι'(Π_Z)) ⊆ B`. -/
abbrev dcPB : Subgroup B.grp := (D.ι : D.Pi →* A.grp).range.map (φ : A.grp →* B.grp)

/-- `Φ : Π_Z ↠ P_B`. -/
def dcPhiB : D.Pi →ₜ* D.dcPB φ where
  toMonoidHom := (D.dcPhi φ).toMonoidHom.codRestrict (D.dcPB φ)
    fun σ ↦ ⟨D.ι σ, ⟨σ, rfl⟩, rfl⟩
  continuous_toFun := continuous_induced_rng.2 (D.dcPhi φ).continuous

lemma coe_dcPhiB (σ : D.Pi) : (D.dcPhiB φ σ : B.grp) = φ (D.ι σ) := rfl

lemma dcPhiB_surjective : Function.Surjective (D.dcPhiB φ) := by
  rintro ⟨_, ⟨_, ⟨σ, rfl⟩, rfl⟩⟩
  exact ⟨σ, rfl⟩

lemma ker_dcPhiB : (D.dcPhiB φ).toMonoidHom.ker = D.dcN φ := by
  ext σ
  rw [MonoidHom.mem_ker]
  constructor
  · intro h
    exact congrArg Subtype.val h
  · intro h
    exact Subtype.ext h

/-! ### The filling and the model of `B` -/

variable {U' : D.Y.Xbar.Opens} (h : D.Y.U ≤ U') (hc' : (U' : Set D.Y.Xbar)ᶜ.Nonempty)
  (hyp : haveI := IsCurveOver.isIntegral D.M D.Y.Xbar
    2 < 2 * Anabelian.curveGenus D.M D.Y.Xbar + cuspDegree D.M D.Y.Xbar U')
  (hkerf : (fillMap Ω D.Y D.hY h).toMonoidHom.ker = D.dcN φ)

/-- **The filled curve `Z' = (X̄_Z, U')`** over the field of definition of `D`. -/
abbrev dcCurve : HypCurve D.M := fillCurve D.Y h hyp

/-- `Π_{Z'}` (at the base point of `Z'`). -/
abbrev dcPi := π₁ᵉᵗ(basePoint Ω (D.dcCurve h hyp) hc' ≫
  baseChangeSpec D.M Ω Γ((D.dcCurve h hyp).Xbar, (D.dcCurve h hyp).U))

/-- `Π_Z ↠ Π_{Z'}` (`CurvesJacobian.Cusp.fillPiHom`). -/
abbrev dcFill : D.Pi →ₜ* D.dcPi h hc' hyp := fillPiHom Ω D.Y D.hY h hc' hyp

lemma dcFill_surjective : Function.Surjective (D.dcFill h hc' hyp) :=
  surjective_of_conjInduced_fill Ω _ _ _ _ _ (isConjInduced_fillPiHom Ω _ _ _ _ _)

include hkerf in
lemma ker_dcFill : (D.dcFill h hc' hyp).toMonoidHom.ker = (D.dcPhiB φ).toMonoidHom.ker :=
  ((ker_eq_ker_fillMap_of_conjInduced Ω _ _ _ _ _ _ (isConjInduced_fillPiHom Ω _ _ _ _ _)).trans
    hkerf).trans (D.ker_dcPhiB φ).symm

/-- **`Π_{Z'} ≃ₜ* P_B`**, with `dcEquiv ∘ fill = Φ`. -/
def dcEquiv : D.dcPi h hc' hyp ≃ₜ* D.dcPB φ :=
  contMulEquivOfKerEq (D.dcFill h hc' hyp) (D.dcFill_surjective h hc' hyp) (D.dcPhiB φ)
    (D.ker_dcFill φ h hc' hyp hkerf) (D.dcPhiB_surjective φ)

lemma dcEquiv_dcFill (σ : D.Pi) :
    D.dcEquiv φ h hc' hyp hkerf (D.dcFill h hc' hyp σ) = D.dcPhiB φ σ :=
  contMulEquivOfKerEq_apply _ _ _ _ _ σ

/-- **`ι_B : Π_{Z'} ≃ P_B ⊆ B`.** -/
def dcIota : D.dcPi h hc' hyp →ₜ* B.grp where
  toMonoidHom := (D.dcPB φ).subtype.comp (D.dcEquiv φ h hc' hyp hkerf).toMulEquiv.toMonoidHom
  continuous_toFun := continuous_subtype_val.comp (D.dcEquiv φ h hc' hyp hkerf).continuous

lemma dcIota_dcFill (σ : D.Pi) :
    D.dcIota φ h hc' hyp hkerf (D.dcFill h hc' hyp σ) = φ (D.ι σ) :=
  congrArg Subtype.val (D.dcEquiv_dcFill φ h hc' hyp hkerf σ)

lemma dcIota_injective : Function.Injective (D.dcIota φ h hc' hyp hkerf) := fun _ _ hab ↦
  (D.dcEquiv φ h hc' hyp hkerf).injective (Subtype.ext hab)

lemma range_dcIota : Set.range (D.dcIota φ h hc' hyp hkerf) = (D.dcPB φ : Set B.grp) := by
  ext x
  constructor
  · rintro ⟨σ, rfl⟩
    exact (D.dcEquiv φ h hc' hyp hkerf σ).2
  · intro hx
    exact ⟨(D.dcEquiv φ h hc' hyp hkerf).symm ⟨x, hx⟩,
      congrArg Subtype.val ((D.dcEquiv φ h hc' hyp hkerf).apply_symm_apply ⟨x, hx⟩)⟩

include hsurj in
lemma isOpen_dcPB : IsOpen (D.dcPB φ : Set B.grp) := by
  refine isOpen_map_of_isOpen_range φ ?_ (O := (D.ι : D.Pi →* A.grp).range) ?_
  · rw [hsurj.range_eq]
    exact isOpen_univ
  · rw [MonoidHom.coe_range]
    exact D.isOpen_range

include hsurj hcompat in
/-- `Δ_B = φ(Δ_A)`. -/
lemma exists_Delta_of_mem {b : B.grp} (hb : b ∈ B.Delta) : ∃ a ∈ A.Delta, φ a = b := by
  obtain ⟨a, rfl⟩ := hsurj b
  refine ⟨a, ?_, rfl⟩
  have h1 := ChainObj.toG_apply_of_compat hcompat a
  change A.toG a = 1
  rw [← h1]
  exact hb

include hsurj hcompat in
lemma Delta_le_normalizer_dcPB : B.Delta ≤ Subgroup.normalizer (D.dcPB φ : Set B.grp) := by
  refine Belyi.Anabelian.le_normalizer_of_forall_conj_mem fun b hb y hy ↦ ?_
  obtain ⟨a, ha, rfl⟩ := exists_Delta_of_mem φ hsurj hcompat hb
  obtain ⟨_, ⟨σ, rfl⟩, rfl⟩ := hy
  have h1 := (Subgroup.mem_set_normalizer_iff.1 (D.normal ha) (D.ι σ)).1 ⟨σ, rfl⟩
  obtain ⟨τ, hτ⟩ := h1
  refine ⟨D.ι τ, ⟨τ, rfl⟩, ?_⟩
  change φ (D.ι τ) = φ a * φ (D.ι σ) * (φ a)⁻¹
  rw [hτ, map_mul, map_mul, map_inv]

include hcompat in
/-- **`ι_B` lies over `res : G_M → G_K` up to conjugation.** -/
theorem exists_toGk_dcIota : ∃ g₀ : π₁ᵉᵗ(sK), ∀ σ,
    toGk B (D.dcIota φ h hc' hyp hkerf σ) =
      g₀ * resGal K Ω D.M (projGk Ω (D.dcCurve h hyp) hc' σ) * g₀⁻¹ := by
  have hF : Spec.map (CommRingCat.ofHom (resAlg D.M h).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap D.M Γ(D.Y.Xbar, U'))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K D.M)) =
      Spec.map (CommRingCat.ofHom (algebraMap D.M Γ(D.Y.Xbar, D.Y.U))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K D.M)) :=
    (Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) (specMap_resAlg_structure _ _))
  obtain ⟨c, hc⟩ := exists_resGal_projGk_conj_of_conjInduced Ω (K := K) (K₁ := D.M) (K₂ := D.M)
    (C₁ := D.Y) (C₂ := D.dcCurve h hyp) D.hY hc' _ hF
    (isConjInduced_fillPiHom Ω D.Y D.hY h hc' hyp)
  refine ⟨D.g₀ * c⁻¹, fun σ ↦ ?_⟩
  obtain ⟨γ, rfl⟩ := D.dcFill_surjective h hc' hyp σ
  have h1 : toGk B (D.dcIota φ h hc' hyp hkerf (D.dcFill h hc' hyp γ)) = toGk A (D.ι γ) := by
    rw [dcIota_dcFill]
    exact ChainObj.toG_apply_of_compat hcompat (D.ι γ)
  refine (h1.trans (D.toG_ι γ)).trans ?_
  exact Eq.trans (by group) (congrArg (fun z ↦ (D.g₀ * c⁻¹) * z * (D.g₀ * c⁻¹)⁻¹) (hc γ).symm)

include hKP in
/-- **Preimages under `ι_B` of images under `φ`**: `ι_B⁻¹(φ(S)) = fill(ι'⁻¹(S))`. -/
theorem comap_dcIota_map (S : Subgroup A.grp) :
    (S.map (φ : A.grp →* B.grp)).comap (D.dcIota φ h hc' hyp hkerf : D.dcPi h hc' hyp →* B.grp) =
      (S.comap (D.ι : D.Pi →* A.grp)).map (D.dcFill h hc' hyp : D.Pi →* D.dcPi h hc' hyp) := by
  have hk : ∀ τ, D.dcFill h hc' hyp τ = 1 ↔ τ ∈ D.dcN φ := fun τ ↦
    Subgroup.ext_iff.1 ((D.ker_dcFill φ h hc' hyp hkerf).trans (D.ker_dcPhiB φ)) τ
  ext x
  obtain ⟨σ, rfl⟩ := D.dcFill_surjective h hc' hyp x
  have e1 : (D.dcIota φ h hc' hyp hkerf : D.dcPi h hc' hyp →* B.grp) (D.dcFill h hc' hyp σ) =
      φ (D.ι σ) := D.dcIota_dcFill φ h hc' hyp hkerf σ
  rw [Subgroup.mem_comap, e1, Subgroup.mem_map, Subgroup.mem_map]
  constructor
  · rintro ⟨s, hs, hsσ⟩
    have hsσ' : φ s = φ (D.ι σ) := hsσ
    have hker : s⁻¹ * D.ι σ ∈ (φ : A.grp →* B.grp).ker := by
      change φ (s⁻¹ * D.ι σ) = 1
      rw [map_mul, map_inv, hsσ', inv_mul_cancel]
    obtain ⟨n, hn⟩ := hKP hker
    have hn' : D.ι n = s⁻¹ * D.ι σ := hn
    have hnN : n ∈ D.dcN φ := by
      change D.ι n ∈ (φ : A.grp →* B.grp).ker
      rw [hn']
      exact hker
    refine ⟨σ * n⁻¹, ?_, ?_⟩
    · change D.ι (σ * n⁻¹) ∈ S
      have e2 : D.ι (σ * n⁻¹) = s := by
        rw [map_mul, map_inv, hn']
        group
      rw [e2]
      exact hs
    · change D.dcFill h hc' hyp (σ * n⁻¹) = D.dcFill h hc' hyp σ
      rw [map_mul, map_inv, (hk n).2 hnN, inv_one, mul_one]
  · rintro ⟨τ, hτ, hτσ⟩
    have hτσ' : D.dcFill h hc' hyp τ = D.dcFill h hc' hyp σ := hτσ
    refine ⟨D.ι τ, hτ, ?_⟩
    have h1 : D.dcFill h hc' hyp (τ⁻¹ * σ) = 1 := by
      rw [map_mul, map_inv, hτσ', inv_mul_cancel]
    have h2 : φ (D.ι (τ⁻¹ * σ)) = 1 := (hk _).1 h1
    rw [map_mul, map_inv, map_mul, map_inv] at h2
    change φ (D.ι τ) = φ (D.ι σ)
    exact inv_mul_eq_one.1 h2

include hcompat hKP in
/-- **Cusp compatibility of `ι_B`.** For a cuspidal inertia group `I` of `Π_X`,
`ρ_B(I) ∼ φ(ρ_A(I))` (`Compat.image_commensurable`), `ι_B⁻¹(φ(ρ_A(I))) = fill(ι'⁻¹(ρ_A(I)))`
(`GeomModel.comap_dcIota_map`), and `ι'⁻¹(ρ_A(I))` is finite or commensurable with a cuspidal
inertia group of `Π_Z` (`GeomModel.cusp`), which `fill` kills or maps onto a cuspidal inertia
group of `Π_{Z'}` (`le_ker_or_map_mem_arithCusps_of_conjInduced_fill`). -/
theorem dcIota_cusp : ∀ I ∈ (arithmeticExt Ω CX hcX).cusps,
    ((B.image I).comap
        (D.dcIota φ h hc' hyp hkerf : D.dcPi h hc' hyp →* B.grp)).Commensurable ⊥ ∨
      ∃ J ∈ arithCusps Ω (D.dcCurve h hyp) hc',
        ((B.image I).comap
          (D.dcIota φ h hc' hyp hkerf : D.dcPi h hc' hyp →* B.grp)).Commensurable J := by
  intro I hI
  haveI : Nonempty (baseChangeOpen D.M Ω U') :=
    (nonempty_baseChangeOpen D.M Ω (D.Y.nonempty.mono h)).to_subtype
  have h1 := (hcompat.image_commensurable I).comap'
    (D.dcIota φ h hc' hyp hkerf : D.dcPi h hc' hyp →* B.grp)
  rw [D.comap_dcIota_map φ hKP h hc' hyp hkerf] at h1
  rcases D.cusp I hI with hb | ⟨J, hJ, hc⟩
  · left
    have h2 := hb.map' (D.dcFill h hc' hyp : D.Pi →* D.dcPi h hc' hyp)
    rw [Subgroup.map_bot] at h2
    exact h1.trans h2
  · rcases le_ker_or_map_mem_arithCusps_of_conjInduced_fill Ω D.Y D.hY h hc' hyp
        (D.dcFill h hc' hyp : D.Pi →* D.dcPi h hc' hyp)
        (isConjInduced_fillPiHom Ω D.Y D.hY h hc' hyp) hJ with hk | hm
    · left
      have h2 := hc.map' (D.dcFill h hc' hyp : D.Pi →* D.dcPi h hc' hyp)
      have hb : J.map (D.dcFill h hc' hyp : D.Pi →* D.dcPi h hc' hyp) = ⊥ :=
        eq_bot_iff.2 fun x hx ↦ by
          obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.1 hx
          exact Subgroup.mem_bot.2 (hk hz)
      exact h1.trans (hb ▸ h2)
    · exact Or.inr ⟨_, hm, h1.trans (hc.map' _)⟩

/-- **The geometric model of `B` across `•`**: the filled curve `Z'` with `ι_B : Π_{Z'} ≃ P_B`. -/
def decusp : GeomModel Ω CX hcX B where
  M := D.M
  Y := D.dcCurve h hyp
  hY := hc'
  ι := D.dcIota φ h hc' hyp hkerf
  inj := D.dcIota_injective φ h hc' hyp hkerf
  isOpen_range := by
    rw [range_dcIota]
    exact D.isOpen_dcPB φ hsurj
  normal := by
    rw [range_dcIota]
    exact D.Delta_le_normalizer_dcPB φ hsurj hcompat
  toG_eq := D.exists_toGk_dcIota φ hcompat h hc' hyp hkerf
  cusp := D.dcIota_cusp φ hcompat hKP h hc' hyp hkerf

/-! ### The hypotheses of the filling, from the operation of type `•` -/

/-- **`N` is generated by cuspidal inertia groups**: if every element of `ker φ` lies in the
closed subgroup generated by `ι'`-images of cuspidal inertia groups of `Π_Z` inside `N`, then
`N` is the closed normal subgroup generated by the cuspidal inertia groups it contains. -/
theorem dcN_eq_closure
    (hgen : (φ : A.grp →* B.grp).ker ≤ ((Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω D.Y
      D.hY ∧ I ≤ D.dcN φ), (I : Set D.Pi))).topologicalClosure).map (D.ι : D.Pi →* A.grp)) :
    D.dcN φ = (Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω D.Y D.hY ∧ I ≤ D.dcN φ),
      (I : Set D.Pi))).topologicalClosure := by
  apply le_antisymm
  · intro σ hσ
    obtain ⟨τ, hτ, hτσ⟩ := hgen hσ
    rwa [D.inj hτσ] at hτ
  · haveI : (D.dcN φ).Normal := Subgroup.Normal.comap (MonoidHom.normal_ker _) _
    refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) ?_
    · intro x hx
      obtain ⟨I, hx⟩ := Set.mem_iUnion.1 hx
      obtain ⟨hI, hx⟩ := Set.mem_iUnion.1 hx
      exact hI.2 hx
    · have e : (D.dcN φ : Set D.Pi) = (D.dcPhi φ) ⁻¹' {1} := rfl
      rw [e]
      exact isClosed_singleton.preimage (D.dcPhi φ).continuous

/-! ### The model across `•` -/

include hsurj hcompat in
/-- **`Δ_B` is not commutative on `φ(J)`** for `J` open in `Δ_A` (slimness and nontriviality of
`Δ_B`). -/
theorem exists_not_commute_map {J : Subgroup A.grp}
    (ho : IsOpen ((J.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta)) :
    ∃ j₁ ∈ J, ∃ j₂ ∈ J, φ j₁ * φ j₂ ≠ φ j₂ * φ j₁ := by
  refine by_contra fun hcon' ↦ ?_
  have hcon : ∀ j₁ ∈ J, ∀ j₂ ∈ J, φ j₁ * φ j₂ = φ j₂ * φ j₁ := fun j₁ h₁ j₂ h₂ ↦
    by_contra fun hne ↦ hcon' ⟨j₁, h₁, j₂, h₂, hne⟩
  haveI : CompactSpace A.Delta := isCompact_iff_compactSpace.mp A.isClosed_Delta.isCompact
  have hmem : ∀ x ∈ A.Delta, φ x ∈ (B.toG : B.grp →* (arithmeticExt Ω CX hcX).G).ker :=
      fun x hx ↦ by
    change B.toG (φ x) = 1
    rw [ChainObj.toG_apply_of_compat hcompat]
    exact hx
  let φΔ : A.Delta →ₜ* (B.toG : B.grp →* (arithmeticExt Ω CX hcX).G).ker :=
    { toMonoidHom := ((φ : A.grp →* B.grp).comp A.Delta.subtype).codRestrict
        (B.toG : B.grp →* (arithmeticExt Ω CX hcX).G).ker fun x ↦ hmem x.1 x.2
      continuous_toFun := continuous_induced_rng.2 (φ.continuous.comp continuous_subtype_val) }
  have hφΔ : Function.Surjective φΔ := fun b ↦ by
    obtain ⟨a, ha, hab⟩ := exists_Delta_of_mem φ hsurj hcompat b.2
    exact ⟨⟨a, ha⟩, Subtype.ext hab⟩
  have hO := isOpen_map_of_isOpen_range φΔ (by rw [hφΔ.range_eq]; exact isOpen_univ) ho
  let O : OpenSubgroup (B.toG : B.grp →* (arithmeticExt Ω CX hcX).G).ker :=
    ⟨(J.subgroupOf A.Delta).map
      (φΔ : A.Delta →* (B.toG : B.grp →* (arithmeticExt Ω CX hcX).G).ker), hO⟩
  have hO1 : ∀ z ∈ (O : Subgroup (B.toG : B.grp →* (arithmeticExt Ω CX hcX).G).ker), z = 1 := by
    rintro _ ⟨x, hx, rfl⟩
    refine B.slim_delta O _ fun u hu ↦ ?_
    obtain ⟨y, hy, rfl⟩ := hu
    exact Subtype.ext (hcon x.1 hx y.1 hy)
  apply B.nontrivial_delta
  refine eq_bot_iff.2 fun z hz ↦ Subgroup.mem_bot.2 ?_
  have := B.slim_delta O ⟨z, hz⟩ fun u hu ↦ by rw [hO1 u hu, one_mul, mul_one]
  exact congrArg Subtype.val this

/-- **The filling across `•` for a model whose image contains `J`.** Let `φ : A ↠ B` be an
operation of type `•` (`ker φ = deltaNormalClosure C`, `C ⊆ J ⊴ Δ_A`, `J` open in `Δ_A`) such
that some cuspidal decomposition group of `Π_X` has infinite image in `B`, and let `D` be a model
of `A` with `J ⊆ ι(Π_Y)`. Then `ι⁻¹(ker φ)` is the kernel of the filling `Π_Y ↠ Π_{Y'}` of an open
`U' ⊇ U_Y` with a cusp, `(X̄_Y, U')` hyperbolic (the input of `GeomModel.decusp`). -/
theorem exists_fill_of_decusp (D : GeomModel Ω CX hcX A)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (φ : A.grp →ₜ* B.grp) (hsurj : Function.Surjective φ) {C : Subgroup A.grp}
    (hC : A.IsCuspidal C) (htf : A.InTorsionFreeNormalOpen C)
    (hker : (φ : A.grp →* B.grp).ker = A.deltaNormalClosure C)
    (hcompat : ChainObj.Compat A B φ)
    (hB : ∃ I ∈ (arithmeticExt Ω CX hcX).cusps, ¬ (B.image I).Commensurable ⊥)
    {J : Subgroup A.grp} (hJΔ : J ≤ A.Delta) (hCJ : C ≤ J)
    (hJn : ∀ d ∈ A.Delta, ∀ n ∈ J, d * n * d⁻¹ ∈ J)
    (hJo : IsOpen ((J.subgroupOf A.Delta : Subgroup A.Delta) : Set A.Delta))
    (hJr : J ≤ (D.ι : D.Pi →* A.grp).range) :
    ∃ (U' : D.Y.Xbar.Opens) (h : D.Y.U ≤ U') (_ : (U' : Set D.Y.Xbar)ᶜ.Nonempty)
      (_ : haveI := IsCurveOver.isIntegral D.M D.Y.Xbar
        2 < 2 * Anabelian.curveGenus D.M D.Y.Xbar + cuspDegree D.M D.Y.Xbar U'),
      (fillMap Ω D.Y D.hY h).toMonoidHom.ker = D.dcN φ := by
  have hKJ : (φ : A.grp →* B.grp).ker ≤ J :=
    hker ▸ A.deltaNormalClosure_le hJΔ hJn hJo hCJ
  -- the kernel is generated by the cuspidal inertia groups `ι⁻¹(d C d⁻¹)`
  have hC0 : C.comap (D.ι : D.Pi →* A.grp) ∈ arithCusps Ω D.Y D.hY :=
    D.comap_mem_arithCusps_of_isCuspidal hC htf
  have hgen : (φ : A.grp →* B.grp).ker ≤
      ((Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω D.Y D.hY ∧ I ≤ D.dcN φ),
        (I : Set D.Pi))).topologicalClosure).map (D.ι : D.Pi →* A.grp) := by
    have hRc : IsClosed (((((Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω D.Y D.hY ∧
        I ≤ D.dcN φ), (I : Set D.Pi))).topologicalClosure).map
          (D.ι : D.Pi →* A.grp)) : Subgroup A.grp) : Set A.grp) := by
      rw [Subgroup.coe_map]
      exact D.ι.continuous.isClosedMap _ (Subgroup.isClosed_topologicalClosure _)
    rw [hker]
    refine Subgroup.topologicalClosure_minimal _ ?_ hRc
    rw [Subgroup.closure_le]
    rintro _ ⟨d, hd, c, hc, rfl⟩
    obtain ⟨σ, rfl⟩ := hJr (hCJ hc)
    let g : D.Nrm := ⟨d, D.Delta_le_Nrm hd⟩
    refine ⟨D.conjPi g σ, ?_, D.ι_conjPi g σ⟩
    have hcusp : (C.comap (D.ι : D.Pi →* A.grp)).map (D.conjPi g).toMulEquiv.toMonoidHom ∈
        arithCusps Ω D.Y D.hY := (D.map_conjPi_mem_arithCusps_iff (hDGC D.M) g).2 hC0
    have hle : (C.comap (D.ι : D.Pi →* A.grp)).map (D.conjPi g).toMulEquiv.toMonoidHom ≤
        D.dcN φ := by
      rintro _ ⟨τ, hτ, rfl⟩
      change D.ι (D.conjPi g τ) ∈ (φ : A.grp →* B.grp).ker
      rw [D.ι_conjPi, hker]
      exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨d, hd, D.ι τ, hτ, rfl⟩)
    refine Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure ?_)
    exact Set.mem_iUnion₂.2 ⟨_, ⟨hcusp, hle⟩, ⟨σ, hc, rfl⟩⟩
  -- the cusp of `hB` survives
  have hne : ∃ I ∈ arithCusps Ω D.Y D.hY, ¬ I ≤ D.dcN φ := by
    obtain ⟨I₁, hI₁, hinf⟩ := hB
    have hR := D.index_range_ne_zero
    have h2 : ((A.image I₁).map (φ : A.grp →* B.grp)).Commensurable
        (((A.image I₁).comap (D.ι : D.Pi →* A.grp)).map (D.dcPhi φ : D.Pi →* B.grp)) := by
      have e : ((A.image I₁).comap (D.ι : D.Pi →* A.grp)).map (D.dcPhi φ : D.Pi →* B.grp) =
          (((A.image I₁).comap (D.ι : D.Pi →* A.grp)).map (D.ι : D.Pi →* A.grp)).map
            (φ : A.grp →* B.grp) := by
        rw [Subgroup.map_map]
        rfl
      rw [e, Subgroup.map_comap_eq]
      exact ((Subgroup.commensurable_inf_of_index_ne_zero hR _).map' _).symm
    have h1 := (hcompat.image_commensurable I₁).trans h2
    rcases D.cusp I₁ hI₁ with hb | ⟨J₁, hJ₁, hc⟩
    · have h3 := hb.map' (D.dcPhi φ : D.Pi →* B.grp)
      rw [Subgroup.map_bot] at h3
      exact absurd (h1.trans h3) hinf
    · refine ⟨J₁, hJ₁, fun hle ↦ hinf ?_⟩
      have hb : J₁.map (D.dcPhi φ : D.Pi →* B.grp) = ⊥ :=
        eq_bot_iff.2 fun x hx ↦ by
          obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.1 hx
          exact Subgroup.mem_bot.2 (hle hz)
      exact h1.trans (hb ▸ hc.map' _)
  -- the filling
  obtain ⟨U', h, hc', -, hkerf⟩ := exists_fill_ker_eq Ω D.Y D.hY (D.dcN φ)
    (D.dcN_eq_closure φ hgen) hne
  -- hyperbolicity
  obtain ⟨j₁, hj₁, j₂, hj₂, hj⟩ := exists_not_commute_map φ hsurj hcompat hJo
  have hlift : ∀ j ∈ J, ∃ a ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker, D.ι a = j := fun j hj ↦ by
    obtain ⟨a, ha⟩ := hJr hj
    refine ⟨a, ?_, ha⟩
    rw [← D.comap_Delta]
    change D.ι a ∈ A.Delta
    rw [show D.ι a = j from ha]
    exact hJΔ hj
  obtain ⟨a, ha, rfl⟩ := hlift j₁ hj₁
  obtain ⟨b, hb, rfl⟩ := hlift j₂ hj₂
  have hyp : haveI := IsCurveOver.isIntegral D.M D.Y.Xbar
      2 < 2 * Anabelian.curveGenus D.M D.Y.Xbar + cuspDegree D.M D.Y.Xbar U' := by
    refine two_lt_of_not_commute_fillMap Ω D.Y D.hY h hc' ⟨a, ha, b, hb, fun hc ↦ hj ?_⟩
    have h1 : (fillMap Ω D.Y D.hY h).toMonoidHom (a * b) =
        (fillMap Ω D.Y D.hY h).toMonoidHom (b * a) :=
      (map_mul _ a b).trans (hc.trans (map_mul _ b a).symm)
    have h2 : (D.dcPhi φ).toMonoidHom (a * b) = (D.dcPhi φ).toMonoidHom (b * a) :=
      (MonoidHom.eq_iff _).2 ((hkerf.trans (D.ker_dcPhi φ).symm).le ((MonoidHom.eq_iff _).1 h1))
    exact (map_mul _ a b).symm.trans (h2.trans (map_mul _ b a))
  exact ⟨U', h, hc', hyp, hkerf⟩

/-- **Geometric models across `•`** (MR8 (A4)). Let `φ : A ↠ B` be an operation of type `•`
(`ker φ = deltaNormalClosure C`, `C` a cuspidal decomposition group in a normal open torsion-free
`J ⊴ Δ_A`) such that some cuspidal decomposition group of `Π_X` has infinite image in `B`. If `A`
has a geometric model, so has `B` (assuming the rel-isom-DGC over number fields): enlarge the
model to `P' ⊇ J` (`GeomModel.exists_enlarge`) and fill (`GeomModel.exists_fill_of_decusp`). -/
theorem exists_decusp (D : GeomModel Ω CX hcX A)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k)
    (φ : A.grp →ₜ* B.grp) (hsurj : Function.Surjective φ) {C : Subgroup A.grp}
    (hC : A.IsCuspidal C) (htf : A.InTorsionFreeNormalOpen C)
    (hker : (φ : A.grp →* B.grp).ker = A.deltaNormalClosure C)
    (hcompat : ChainObj.Compat A B φ)
    (hB : ∃ I ∈ (arithmeticExt Ω CX hcX).cusps, ¬ (B.image I).Commensurable ⊥) :
    Nonempty (GeomModel Ω CX hcX B) := by
  obtain ⟨J, hJΔ, hCJ, hJn, hJo, hJtf⟩ := id htf
  obtain ⟨P', hP'o, hP'n, hP'J⟩ := A.exists_open_inf_Delta_eq hJΔ hJn hJo
  have htfP : IsTorsionFreeSubgroup (P' ⊓ A.Delta) := by
    rw [hP'J]
    exact hJtf
  obtain ⟨D', hD'⟩ := D.exists_enlarge hDGC P' hP'o hP'n htfP
  have hJr : J ≤ (D'.ι : D'.Pi →* A.grp).range := fun x hx ↦ by
    have hx' : x ∈ (P' : Set A.grp) := (hP'J ▸ inf_le_left : J ≤ P') hx
    rw [← hD'] at hx'
    obtain ⟨σ, rfl⟩ := hx'
    exact ⟨σ, rfl⟩
  have hKP : (φ : A.grp →* B.grp).ker ≤ (D'.ι : D'.Pi →* A.grp).range :=
    fun x hx ↦ hJr ((hker ▸ A.deltaNormalClosure_le hJΔ hJn hJo hCJ) hx)
  obtain ⟨U', h, hc', hyp, hkerf⟩ := D'.exists_fill_of_decusp hDGC φ hsurj hC htf hker hcompat
    hB hJΔ hCJ hJn hJo hJr
  exact ⟨D'.decusp φ hsurj hcompat hKP h hc' hyp hkerf⟩

/-- **Geometric models across an elementary operation of type `•`** (`GeomModel.exists_decusp`). -/
theorem exists_of_elemOp_decusp (D : GeomModel Ω CX hcX A)
    (hDGC : ∀ (k : Type u) [Field k] [NumberField k], RelIsomDGC.Exists k) (o : ElemOp A B)
    (ho : o.kind = .decusp)
    (hB : ∃ I ∈ (arithmeticExt Ω CX hcX).cusps, ¬ (B.image I).Commensurable ⊥) :
    Nonempty (GeomModel Ω CX hcX B) := by
  match o, ho with
  | .decusp φ surj _ cusp tf ker compat, _ =>
    exact D.exists_decusp hDGC φ surj cusp tf ker compat hB
  | .cover .., h => exact absurd h (by simp [ElemOp.kind])
  | .quot .., h => exact absurd h (by simp [ElemOp.kind])
  | .deorb .., h => exact absurd h (by simp [ElemOp.kind])

end CurvesJacobian.Cusp.GeomModel
