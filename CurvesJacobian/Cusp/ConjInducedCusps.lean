import CurvesJacobian.Cusp.CoverCuspComap

/-!
# Cusps and Galois projections for homomorphisms induced by morphisms of schemes

`AlgebraicGeometry.FiniteEtale.IsConjInduced h φ` says that `φ : π₁ᵉᵗ(x) → π₁ᵉᵗ(y)` is
`π₁ᵉᵗ(h)` followed by some change of base point. Two such maps differ by an inner automorphism
of the target (`isConjInduced_iff_exists_conj`), so every statement proved in this project for
one particular choice of change of base point (`coverPiHom`, `fillMap`) holds for all of them.

* **Finite étale covers** (`F : Spec Γ(U') ⟶ Spec Γ(U)` finite étale, `C'` over `K' ⊇ K`): if
  `φ : Π_{U'} →* Π_U` is induced by `F`, then `φ = conj t ∘ coverPiHom F`
  (`exists_eq_conj_coverPiHom`), so
  - every cuspidal inertia group of `Π_{U'}` maps with finite index into one of `Π_U`
    (`exists_arithCusps_map_le_of_conjInduced`);
  - preimages of cuspidal inertia groups are cuspidal inertia groups if `F` lies over
    `Spec K' ⟶ Spec K` (`comap_mem_arithCusps_of_conjInduced`);
  - `φ` is injective with open image of finite index (`injective_of_conjInduced_cover`,
    `isOpen_range_of_conjInduced_cover`, `finiteIndex_range_of_conjInduced_cover`).
* **Galois projections** (`exists_resGal_projGk_conj_of_conjInduced`): for curves `C₁` over
  `K₁` and `C₂` over `K₂` with `K ⊆ Kᵢ ⊆ Ω` and `F : Spec Γ(U₁) ⟶ Spec Γ(U₂)` over `Spec K`,
  a map `φ` induced by `F` satisfies `res ∘ pr₂ ∘ φ = conj c ∘ res ∘ pr₁` for some `c ∈ G_K`.
* **Fillings** (`U ⊆ U'`, the curve `fillCurve C h hyp = (X̄, U')`): if
  `φ : Π_U →* Π_{U'}` is induced by `Spec Γ(U) ⟶ Spec Γ(U')`, then after the change of base
  point `fillTransport` it is `conj t ∘ fillMap` (`exists_fillTransport_conj_of_conjInduced`), so
  - `φ` is surjective (`surjective_of_conjInduced_fill`);
  - `ker φ` is the closed normal subgroup generated by the cuspidal inertia groups it contains
    (`ker_eq_closure_cusps_of_conjInduced_fill`);
  - every cuspidal inertia group of `Π_U` is killed by `φ` or maps onto a cuspidal inertia group
    of `Π_{U'}` (`le_ker_or_map_mem_arithCusps_of_conjInduced_fill`), and every cuspidal inertia
    group of `Π_{U'}` arises in this way (`exists_map_eq_of_conjInduced_fill`).
  The map `fillPiHom` (`fillMap` followed by the inverse change of base point) is an example
  (`isConjInduced_fillPiHom`).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi
  Belyi.Anabelian PreGaloisCategory
open Pi1.Orbifold AffOrbicurve

universe u

noncomputable section

set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

namespace CurvesJacobian.Cusp

/-! ### Finite étale covers -/

section Cover

variable {K : Type u} [Field K] [CharZero K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω]
  {K' : Type u} [Field K'] [CharZero K'] [Algebra K' Ω] [Algebra.IsAlgebraic K' Ω]
  (C : HypCurve K) (hc : (C.U : Set C.Xbar)ᶜ.Nonempty)
  (C' : HypCurve K') (hc' : (C'.U : Set C'.Xbar)ᶜ.Nonempty)
  (F : Spec Γ(C'.Xbar, C'.U) ⟶ Spec Γ(C.Xbar, C.U)) [IsSlimGk K Ω] [IsSlimGk K' Ω]

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **A map induced by `F` is `coverPiHom F` up to an inner automorphism.** -/
theorem exists_eq_conj_coverPiHom
    {φ : π₁ᵉᵗ(basePoint Ω C' hc' ≫ baseChangeSpec K' Ω Γ(C'.Xbar, C'.U)) →
      π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))} (H : IsConjInduced F φ) :
    ∃ t : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)), ∀ σ, φ σ =
      t * (show π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) from
        coverPiHom Ω C hc C' hc' F σ) * t⁻¹ := by
  obtain ⟨t, ht⟩ := (isConjInduced_iff_exists_conj F (coverFib Ω C hc C' hc' F) φ).1 H
  exact ⟨t, fun σ ↦ (ht σ).trans rfl⟩

variable [IsFiniteEtale F]

/-- **(K1 a) Every cuspidal inertia group of `Π_{U'}` maps, with finite index, into a cuspidal
inertia group of `Π_U`**, under any map induced by `F`. -/
theorem exists_arithCusps_map_le_of_conjInduced' (hσ : CoverConst Ω C hc C' hc' F)
    (φ : π₁ᵉᵗ(basePoint Ω C' hc' ≫ baseChangeSpec K' Ω Γ(C'.Xbar, C'.U)) →*
      π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) (H : IsConjInduced F φ)
    {J} (hJ : J ∈ arithCusps Ω C' hc') :
    ∃ I ∈ arithCusps Ω C hc, J.map φ ≤ I ∧ (J.map φ).relIndex I ≠ 0 := by
  obtain ⟨t, ht⟩ := exists_eq_conj_coverPiHom Ω C hc C' hc' F H
  obtain ⟨I, hI, hle, hfin⟩ := exists_arithCusps_map_coverPiHom' Ω C hc C' hc' F hσ hJ
  have e : J.map φ = (J.map (coverPiHom Ω C hc C' hc' F).toMonoidHom).map
      (MulAut.conj t).toMonoidHom := by
    rw [Subgroup.map_map]
    exact congrArg (fun f ↦ J.map f) (MonoidHom.ext fun σ ↦ ht σ)
  refine ⟨_, map_conj_mem_arithCusps Ω C hc hI t, ?_, ?_⟩
  · rw [e]
    exact Subgroup.map_mono hle
  · rw [e, Subgroup.relIndex_map_map_of_injective _ _ (MulAut.conj t).injective]
    exact hfin

/-- **(K1 a)** over number fields. -/
theorem exists_arithCusps_map_le_of_conjInduced [NumberField K]
    (φ : π₁ᵉᵗ(basePoint Ω C' hc' ≫ baseChangeSpec K' Ω Γ(C'.Xbar, C'.U)) →*
      π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) (H : IsConjInduced F φ)
    {J} (hJ : J ∈ arithCusps Ω C' hc') :
    ∃ I ∈ arithCusps Ω C hc, J.map φ ≤ I ∧ (J.map φ).relIndex I ≠ 0 :=
  haveI : Algebra.IsAlgebraic ℚ Ω := Algebra.IsAlgebraic.trans ℚ K Ω
  exists_arithCusps_map_le_of_conjInduced' Ω C hc C' hc' F
    (coverConst_of_isAlgebraic Ω C hc C' hc' F) φ H hJ

variable [Algebra K K'] [IsScalarTower K K' Ω] in
/-- **(K1 b) Preimages of cuspidal inertia groups of `Π_U` under a map induced by `F` (lying
over `Spec K' ⟶ Spec K`) are cuspidal inertia groups of `Π_{U'}`.** -/
theorem comap_mem_arithCusps_of_conjInduced [Module.Finite K K']
    (hF : F ≫ Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, C.U))) =
      Spec.map (CommRingCat.ofHom (algebraMap K' Γ(C'.Xbar, C'.U))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K K')))
    (φ : π₁ᵉᵗ(basePoint Ω C' hc' ≫ baseChangeSpec K' Ω Γ(C'.Xbar, C'.U)) →*
      π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) (H : IsConjInduced F φ)
    {I} (hI : I ∈ arithCusps Ω C hc) :
    I.comap φ ∈ arithCusps Ω C' hc' := by
  obtain ⟨t, ht⟩ := exists_eq_conj_coverPiHom Ω C hc C' hc' F H
  have key : I.comap φ = (I.map (MulAut.conj t⁻¹).toMonoidHom).comap
      (coverPiHom Ω C hc C' hc' F).toMonoidHom := by
    ext σ
    change φ σ ∈ I ↔
      coverPiHom Ω C hc C' hc' F σ ∈ I.map (MulAut.conj t⁻¹).toMonoidHom
    rw [ht σ]
    constructor
    · intro hσ
      refine ⟨_, hσ, ?_⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      group
    · rintro ⟨x, hx, hxσ⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at hxσ
      rw [← hxσ]
      have e2 : t * (t⁻¹ * x * t⁻¹⁻¹) * t⁻¹ = x := by group
      change t * (t⁻¹ * x * t⁻¹⁻¹) * t⁻¹ ∈ I
      rw [e2]
      exact hx
  rw [key]
  exact comap_coverPiHom_mem_arithCusps Ω C hc C' hc' F hF
    (map_conj_mem_arithCusps Ω C hc hI t⁻¹)

/-- **(K1 c) A map induced by a finite étale `F` is injective.** -/
theorem injective_of_conjInduced_cover
    {φ : π₁ᵉᵗ(basePoint Ω C' hc' ≫ baseChangeSpec K' Ω Γ(C'.Xbar, C'.U)) →
      π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))} (H : IsConjInduced F φ) :
    Function.Injective φ := by
  obtain ⟨t, ht⟩ := exists_eq_conj_coverPiHom Ω C hc C' hc' F H
  intro a b hab
  apply coverPiHom_injective Ω C hc C' hc' F
  rw [ht a, ht b] at hab
  exact mul_left_cancel (mul_right_cancel hab)

/-- **(K1 c) A map induced by a finite étale `F` has open image.** -/
theorem isOpen_range_of_conjInduced_cover
    {φ : π₁ᵉᵗ(basePoint Ω C' hc' ≫ baseChangeSpec K' Ω Γ(C'.Xbar, C'.U)) →
      π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))} (H : IsConjInduced F φ) :
    IsOpen (Set.range φ) := by
  obtain ⟨t, ht⟩ := exists_eq_conj_coverPiHom Ω C hc C' hc' F H
  have e : φ = conjCMEquiv t ∘ coverPiHom Ω C hc C' hc' F := funext fun σ ↦ (ht σ).trans rfl
  rw [e, Set.range_comp]
  exact (conjCMEquiv t).toHomeomorph.isOpenMap _ (isOpen_range_coverPiHom Ω C hc C' hc' F)

/-- **(K1 c) A map induced by a finite étale `F` has image of finite index.** -/
theorem finiteIndex_range_of_conjInduced_cover
    (φ : π₁ᵉᵗ(basePoint Ω C' hc' ≫ baseChangeSpec K' Ω Γ(C'.Xbar, C'.U)) →*
      π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) (H : IsConjInduced F φ) :
    φ.range.FiniteIndex := by
  refine Belyi.Anabelian.finiteIndex_of_isOpen ?_
  rw [MonoidHom.coe_range]
  exact isOpen_range_of_conjInduced_cover Ω C hc C' hc' F H

end Cover

/-! ### Galois projections -/

section Proj

variable (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {K : Type u} [Field K] [Algebra K Ω]
  {K₁ : Type u} [Field K₁] [CharZero K₁] [Algebra K K₁] [Algebra K₁ Ω]
  [IsScalarTower K K₁ Ω]
  {K₂ : Type u} [Field K₂] [CharZero K₂] [Algebra K K₂] [Algebra K₂ Ω]
  [IsScalarTower K K₂ Ω]
  {C₁ : HypCurve K₁} (hc₁ : (C₁.U : Set C₁.Xbar)ᶜ.Nonempty)
  {C₂ : HypCurve K₂} (hc₂ : (C₂.U : Set C₂.Xbar)ᶜ.Nonempty)
  (F : Spec Γ(C₁.Xbar, C₁.U) ⟶ Spec Γ(C₂.Xbar, C₂.U))

/-- The base point of `Π_{U₁}` lies over the point `Spec Ω ⟶ Spec K`. -/
lemma basePoint_spec_tower₁ :
    (basePoint Ω C₁ hc₁ ≫ baseChangeSpec K₁ Ω Γ(C₁.Xbar, C₁.U)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K₁ Γ(C₁.Xbar, C₁.U))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K K₁)) =
      Spec.map (CommRingCat.ofHom (algebraMap K Ω)) := by
  rw [← Category.assoc, basePoint_spec₂, specMap_algebraMap_tower]

/-- **(K0) Galois projections of induced maps**: if `F : Spec Γ(U₁) ⟶ Spec Γ(U₂)` lies over
`Spec K` and `φ : Π_{U₁} → Π_{U₂}` is induced by `F`, then
`res_{K₂} ∘ pr₂ ∘ φ = conj c ∘ res_{K₁} ∘ pr₁` for some `c ∈ G_K`. -/
theorem exists_resGal_projGk_conj_of_conjInduced
    (hF : F ≫ Spec.map (CommRingCat.ofHom (algebraMap K₂ Γ(C₂.Xbar, C₂.U))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K K₂)) =
      Spec.map (CommRingCat.ofHom (algebraMap K₁ Γ(C₁.Xbar, C₁.U))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K K₁)))
    {φ : π₁ᵉᵗ(basePoint Ω C₁ hc₁ ≫ baseChangeSpec K₁ Ω Γ(C₁.Xbar, C₁.U)) →
      π₁ᵉᵗ(basePoint Ω C₂ hc₂ ≫ baseChangeSpec K₂ Ω Γ(C₂.Xbar, C₂.U))}
    (H : IsConjInduced F φ) :
    ∃ c : π₁ᵉᵗ(Spec.map (CommRingCat.ofHom (algebraMap K Ω))), ∀ σ,
      resGal K Ω K₂ (projGk Ω C₂ hc₂ (φ σ)) =
        c * resGal K Ω K₁ (projGk Ω C₁ hc₁ σ) * c⁻¹ := by
  obtain ⟨γ, hγ⟩ := H
  have hx₁ := basePoint_spec_tower₁ Ω hc₁ (K := K)
  have hx₂ := basePoint_spec_tower₁ Ω hc₂ (K := K)
  have hx₁F' : (basePoint Ω C₁ hc₁ ≫ baseChangeSpec K₁ Ω Γ(C₁.Xbar, C₁.U)) ≫ F ≫
      Spec.map (CommRingCat.ofHom (algebraMap K₂ Γ(C₂.Xbar, C₂.U))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K K₂)) =
      Spec.map (CommRingCat.ofHom (algebraMap K Ω)) := by
    rw [hF]
    exact hx₁
  have hx₁F : ((basePoint Ω C₁ hc₁ ≫ baseChangeSpec K₁ Ω Γ(C₁.Xbar, C₁.U)) ≫ F) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K₂ Γ(C₂.Xbar, C₂.U))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K K₂)) =
      Spec.map (CommRingCat.ofHom (algebraMap K Ω)) :=
    (Category.assoc _ _ _).trans hx₁F'
  refine ⟨fiberIsoMap _ hx₁F hx₂ γ, fun σ ↦ ?_⟩
  have c1 := DFunLike.congr_fun (fundamentalGroupMap_comp
    (Spec.map (CommRingCat.ofHom (algebraMap K₂ Γ(C₂.Xbar, C₂.U))))
    (Spec.map (CommRingCat.ofHom (algebraMap K K₂))) (basePoint_spec₂ Ω C₂ hc₂)
    (sM_sKM (K := K) (Ω := Ω) K₂) hx₂) (φ σ)
  have c2 := DFunLike.congr_fun (fundamentalGroupMap_comp
    (Spec.map (CommRingCat.ofHom (algebraMap K₁ Γ(C₁.Xbar, C₁.U))))
    (Spec.map (CommRingCat.ofHom (algebraMap K K₁))) (basePoint_spec₂ Ω C₁ hc₁)
    (sM_sKM (K := K) (Ω := Ω) K₁) hx₁) σ
  have c3 := fundamentalGroupMap_autContinuousMulEquivOfIso _ hx₁F hx₂ γ
    (fundamentalGroupMap F rfl σ)
  have c4 := DFunLike.congr_fun (fundamentalGroupMap_comp F _ rfl hx₁F hx₁F') σ
  have c5 := DFunLike.congr_fun (fundamentalGroupMap_congr hF hx₁F' hx₁) σ
  calc resGal K Ω K₂ (projGk Ω C₂ hc₂ (φ σ))
      = fundamentalGroupMap _ hx₂ (φ σ) := c1.symm
    _ = fundamentalGroupMap _ hx₂ (autContinuousMulEquivOfIso γ (fundamentalGroupMap F rfl σ)) :=
        congrArg _ (hγ σ)
    _ = autContinuousMulEquivOfIso (fiberIsoMap _ hx₁F hx₂ γ)
          (fundamentalGroupMap _ hx₁ σ) := c3.trans (congrArg _ (c4.symm.trans c5))
    _ = _ := by
        refine (Aut_conjAut_eq _ _).trans ?_
        rw [c2]
        rfl

end Proj

/-! ### Fillings -/

section Fill

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
  (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)
  (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
    2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U')

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **The canonical map `Π_U → Π_{U'}` at the base point of `fillCurve`**: `fillMap` followed
by the change of base point inverse to `fillTransport`. -/
def fillPiHom : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →ₜ*
    π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U')) :=
  (ContinuousMonoidHom.toContinuousMonoidHom (autContinuousMulEquivOfIso
    (fiberIsoMap (baseChangeSpec K Ω Γ(C.Xbar, U')) rfl rfl
      (fillAlpha Ω C hc h hc' hyp)).symm)).comp (fillMap Ω C hc h)

/-- `fillPiHom` is induced by `Spec Γ(U) ⟶ Spec Γ(U')`. -/
theorem isConjInduced_fillPiHom :
    IsConjInduced (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom))
      (fillPiHom Ω C hc h hc' hyp) :=
  (isConjInduced_iff _ (fillPoint_spec Ω C hc h) _).2 ⟨_, fun _ ↦ rfl⟩

/-- `fillTransport ∘ fillPiHom = fillMap`. -/
lemma fillTransport_fillPiHom (σ) :
    fillTransport Ω C hc h hc' hyp (fillPiHom Ω C hc h hc' hyp σ) = fillMap Ω C hc h σ := by
  change (fiberIsoMap (baseChangeSpec K Ω Γ(C.Xbar, U')) rfl rfl
      (fillAlpha Ω C hc h hc' hyp)).conjAut ((fiberIsoMap (baseChangeSpec K Ω Γ(C.Xbar, U')) rfl
        rfl (fillAlpha Ω C hc h hc' hyp)).symm.conjAut (fillMap Ω C hc h σ)) = _
  rw [← Iso.trans_conjAut, Iso.symm_self_id, Iso.conjAut_apply]
  ext
  simp

/-- **A map induced by `Spec Γ(U) ⟶ Spec Γ(U')` is `fillMap` up to the change of base point
`fillTransport` and an inner automorphism.** -/
theorem exists_fillTransport_conj_of_conjInduced
    {φ : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →
      π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U'))}
    (H : IsConjInduced (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) φ) :
    ∃ t : π₁ᵉᵗ(fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U')), ∀ σ,
      fillTransport Ω C hc h hc' hyp (φ σ) = t * fillMap Ω C hc h σ * t⁻¹ := by
  obtain ⟨γ, hγ⟩ := (isConjInduced_iff _ (fillPoint_spec Ω C hc h) φ).1 H
  refine ⟨γ ≪≫ fiberIsoMap (baseChangeSpec K Ω Γ(C.Xbar, U')) rfl rfl
    (fillAlpha Ω C hc h hc' hyp), fun σ ↦ ?_⟩
  rw [hγ σ]
  change (fiberIsoMap (baseChangeSpec K Ω Γ(C.Xbar, U')) rfl rfl
      (fillAlpha Ω C hc h hc' hyp)).conjAut (γ.conjAut (fillMap Ω C hc h σ)) = _
  rw [← Iso.trans_conjAut, Aut_conjAut_eq]

/-- **(K2 a) A map induced by `Spec Γ(U) ⟶ Spec Γ(U')` is surjective.** -/
theorem surjective_of_conjInduced_fill
    {φ : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →
      π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U'))}
    (H : IsConjInduced (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) φ) :
    Function.Surjective φ := by
  obtain ⟨t, ht⟩ := exists_fillTransport_conj_of_conjInduced Ω C hc h hc' hyp H
  intro y
  obtain ⟨σ, hσ⟩ := fillMap_surjective Ω C hc h hc'
    (t⁻¹ * fillTransport Ω C hc h hc' hyp y * t)
  refine ⟨σ, (fillTransport Ω C hc h hc' hyp).injective ?_⟩
  rw [ht, hσ]
  group

/-- The kernel of a map induced by `Spec Γ(U) ⟶ Spec Γ(U')` is the kernel of `fillMap`. -/
theorem ker_eq_ker_fillMap_of_conjInduced
    (φ : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →*
      π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
    (H : IsConjInduced (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) φ) :
    φ.ker = (fillMap Ω C hc h).toMonoidHom.ker := by
  obtain ⟨t, ht⟩ := exists_fillTransport_conj_of_conjInduced Ω C hc h hc' hyp H
  ext σ
  rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
  constructor
  · intro hσ
    have e := ht σ
    rw [hσ, map_one] at e
    exact conj_eq_one_iff.1 e.symm
  · intro hσ
    apply (fillTransport Ω C hc h hc' hyp).injective
    rw [ht, map_one]
    exact conj_eq_one_iff.2 hσ

variable [Nonempty (baseChangeOpen K Ω U')]

/-- **(K2 b) The kernel of a map induced by `Spec Γ(U) ⟶ Spec Γ(U')` is the closed normal
subgroup generated by the cuspidal inertia groups it contains.** -/
theorem ker_eq_closure_cusps_of_conjInduced_fill
    (φ : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →*
      π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
    (H : IsConjInduced (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) φ) :
    φ.ker = (Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω C hc ∧ I ≤ φ.ker),
      (I : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))))).topologicalClosure
      := by
  rw [ker_eq_ker_fillMap_of_conjInduced Ω C hc h hc' hyp φ H]
  apply le_antisymm
  · refine (ker_fillMap_eq_map_iUnion Ω C hc h hc').le.trans ?_
    rw [Subgroup.map_le_iff_le_comap]
    apply Subgroup.topologicalClosure_minimal
    · rw [← Subgroup.map_le_iff_le_comap]
      refine le_trans ?_ (Subgroup.le_topologicalClosure _)
      rw [Subgroup.map_le_iff_le_comap]
      refine Subgroup.normalClosure_le_normal fun x hx ↦ ?_
      obtain ⟨W, hW, hxW⟩ := Set.mem_iUnion₂.1 hx
      refine Subgroup.subset_normalClosure (Set.mem_iUnion₂.2
        ⟨(geomCuspInertia Ω C W).map (geomToPi Ω C hc),
          ⟨mem_arithCusps Ω C hc hW.1.1 hW.2, ?_⟩, ⟨x, hxW, rfl⟩⟩)
      rintro _ ⟨y, hy, rfl⟩
      rw [ker_fillMap_eq_map_iUnion Ω C hc h hc']
      exact ⟨y, Subgroup.le_topologicalClosure _
        (Subgroup.subset_normalClosure (Set.mem_iUnion₂.2 ⟨W, hW, hy⟩)), rfl⟩
    · exact (Subgroup.isClosed_topologicalClosure _).preimage (continuous_geomToPi Ω C hc)
  · apply Subgroup.topologicalClosure_minimal
    · refine Subgroup.normalClosure_le_normal fun x hx ↦ ?_
      obtain ⟨I, hI, hxI⟩ := Set.mem_iUnion₂.1 hx
      exact hI.2 hxI
    · exact isClosed_singleton.preimage (fillMap Ω C hc h).continuous

/-- **(K2 c) Every cuspidal inertia group of `Π_U` is killed by a map induced by
`Spec Γ(U) ⟶ Spec Γ(U')`, or maps onto a cuspidal inertia group of `Π_{U'}`** (according as its
place is centred on `U'_Ω` or not). -/
theorem le_ker_or_map_mem_arithCusps_of_conjInduced_fill
    (φ : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →*
      π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
    (H : IsConjInduced (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) φ)
    {I} (hI : I ∈ arithCusps Ω C hc) :
    I ≤ φ.ker ∨ I.map φ ∈ arithCusps Ω (fillCurve C h hyp) hc' := by
  obtain ⟨t, ht⟩ := exists_fillTransport_conj_of_conjInduced Ω C hc h hc' hyp H
  obtain ⟨_, ⟨W, hkW, hWU, rfl⟩, g, rfl⟩ := hI
  by_cases hV : IsCentredOn (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W
  · left
    rw [ker_eq_ker_fillMap_of_conjInduced Ω C hc h hc' hyp φ H]
    rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    have hx' : geomToPi Ω C hc x ∈ (fillMap Ω C hc h).toMonoidHom.ker := by
      rw [ker_fillMap_eq_map_iUnion Ω C hc h hc']
      exact ⟨x, Subgroup.le_topologicalClosure _
        (Subgroup.subset_normalClosure (Set.mem_iUnion₂.2 ⟨W, ⟨hV, hWU⟩, hx⟩)), rfl⟩
    exact (MonoidHom.normal_ker _).conj_mem _ hx' g
  · right
    obtain ⟨s, hs⟩ := fillTransport_geomToPi Ω C hc h hc' hyp (fillAlpha Ω C hc h hc' hyp)
    have hs' : ∀ z, fillTransport Ω C hc h hc' hyp (geomToPi Ω (fillCurve C h hyp) hc' z) =
        s * geomToPiFill Ω C hc h hc' z * s⁻¹ := hs
    obtain ⟨g', hg'⟩ : ∃ g' : π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫
        baseChangeSpec K Ω Γ((fillCurve C h hyp).Xbar, (fillCurve C h hyp).U)),
        fillTransport Ω C hc h hc' hyp g' = t * fillMap Ω C hc h g * s⁻¹ :=
      (fillTransport Ω C hc h hc' hyp).surjective _
    have hmap := map_cuspInertia_homOfLE (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C))
      (curveGaloisData_H_le Ω (transcendental_geomCoord Ω C)) (baseChangeOpen_mono K Ω h) W
    have hf : (φ.comp (MulAut.conj g).toMonoidHom).comp (geomToPi Ω C hc) =
        ((MulAut.conj g').toMonoidHom.comp (geomToPi Ω (fillCurve C h hyp) hc')).comp
          (geomFill Ω C h).toMonoidHom := by
      refine MonoidHom.ext fun x ↦ (fillTransport Ω C hc h hc' hyp).injective ?_
      change fillTransport Ω C hc h hc' hyp (φ (g * geomToPi Ω C hc x * g⁻¹)) =
        fillTransport Ω C hc h hc' hyp
          (g' * geomToPi Ω (fillCurve C h hyp) hc' (geomFill Ω C h x) * g'⁻¹)
      have e1 : fillTransport Ω C hc h hc' hyp (φ (g * geomToPi Ω C hc x * g⁻¹)) =
          t * (fillMap Ω C hc h g * geomToPiFill Ω C hc h hc' (geomFill Ω C h x) *
            (fillMap Ω C hc h g)⁻¹) * t⁻¹ := by
        rw [ht, map_mul, map_mul, map_inv, fillMap_geomToPi]
      have e2 : fillTransport Ω C hc h hc' hyp
          (g' * geomToPi Ω (fillCurve C h hyp) hc' (geomFill Ω C h x) * g'⁻¹) =
          (t * fillMap Ω C hc h g * s⁻¹) * (s * geomToPiFill Ω C hc h hc' (geomFill Ω C h x) *
            s⁻¹) * (t * fillMap Ω C hc h g * s⁻¹)⁻¹ := by
        rw [map_mul, map_mul, map_inv, hg', hs']
      rw [e1, e2]
      group
    refine ⟨_, ⟨W, hkW, hV, rfl⟩, g', ?_⟩
    change _ = ((cuspInertia (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C))
      (curveGaloisData_H_le Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W).map
        (geomToPi Ω (fillCurve C h hyp) hc')).map (MulAut.conj g').toMonoidHom
    refine Eq.trans ?_ (congrArg (fun J ↦ (J.map (geomToPi Ω (fillCurve C h hyp) hc')).map
      (MulAut.conj g').toMonoidHom) hmap)
    refine ((Subgroup.map_map _ _ _).trans (Subgroup.map_map _ _ _)).trans
      (Eq.trans ?_ ((Subgroup.map_map _ _ _).trans (Subgroup.map_map _ _ _)).symm)
    exact congrArg (fun f ↦ Subgroup.map f (geomCuspInertia Ω C W)) hf

/-- **(K2 d) Every cuspidal inertia group of `Π_{U'}` is the image of a cuspidal inertia group
of `Π_U`** under a map induced by `Spec Γ(U) ⟶ Spec Γ(U')`. -/
theorem exists_map_eq_of_conjInduced_fill
    (φ : π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) →*
      π₁ᵉᵗ(basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
    (H : IsConjInduced (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) φ)
    {J} (hJ : J ∈ arithCusps Ω (fillCurve C h hyp) hc') :
    ∃ I ∈ arithCusps Ω C hc, I.map φ = J := by
  obtain ⟨t, ht⟩ := exists_fillTransport_conj_of_conjInduced Ω C hc h hc' hyp H
  obtain ⟨I, hI, hIJ⟩ := exists_mem_arithCusps_map_fillMap Ω C hc h hc' hyp
    (fillAlpha Ω C hc h hc' hyp) hJ
  obtain ⟨s, hs⟩ := fillMap_surjective Ω C hc h hc' t⁻¹
  refine ⟨I.map (MulAut.conj s).toMonoidHom, map_conj_mem_arithCusps Ω C hc hI s, ?_⟩
  apply Subgroup.map_injective (f := (fillTransport Ω C hc h hc' hyp).toMulEquiv.toMonoidHom)
    (fillTransport Ω C hc h hc' hyp).injective
  refine Eq.trans ?_ hIJ
  rw [Subgroup.map_map, Subgroup.map_map]
  refine congrArg (fun f ↦ I.map f) (MonoidHom.ext fun x ↦ ?_)
  change fillTransport Ω C hc h hc' hyp (φ (s * x * s⁻¹)) = fillMap Ω C hc h x
  rw [ht, map_mul, map_mul, map_inv, hs]
  group

end Fill

