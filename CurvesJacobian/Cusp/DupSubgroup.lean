import CurvesJacobian.Cusp.EllipticGalois
import CurvesJacobian.Cusp.EllipticGenusOne
import Belyi.Anabelian.ChainTransport

/-!
# The `[2]`-subgroup of `Π_{E∖O}` is group-theoretic on `Δ` ([AbsTopII] Cor 3.4, step G1)

Let `E` be an elliptic curve over a number field `K` with `K`-rational `E[2]`, `X = E ∖ {O}`,
`Π = Π_X`, `Δ = ker(Π ↠ G_K)`, and let `Π_U ⊆ Π` (`dupPiU`) be the image of `π₁(E ∖ E[2])` under
`[2] : E ∖ E[2] → E ∖ {O}` (`coverXMorK`, Galois with group `E[2]`, `isGalois_coverXMorK`). Let
`Δ^{(2)}` (`dupSqClosure Δ`) be the closed subgroup topologically generated by the squares of
elements of `Δ`.

Main results:
* `dupPiU_index`, `sq_mem_dupPiU`: `Π_U` is normal and open of index `4` in `Π`, and `g² ∈ Π_U`
  for every `g ∈ Π` (the automorphism group of the cover consists of the four translations by
  `E[2]`, `card_aut_coverXMorK`, all of them involutions, `aut_coverXMorK_mul_self`);
* `Delta_sup_dupPiU`: `Δ · Π_U = Π` (`Π_U ↠ G_K`, `E ∖ E[2]` is geometrically connected);
* `dupPiU_inf_Delta`: **`Π_U ⊓ Δ = Δ^{(2)}`**, given that `Δ ≅ Π̂_{1,1}` (genus `1`, one cusp
  of `X_{\bar K}`: `curveGenus_baseChange_curveE`, `card_compl_baseChangeOpen_XE`);
* `map_dupPiU_inf_Delta`: an isomorphism `Φ : Π_{X₁} ≅ Π_{X₂}` of cuspidal extensions maps
  `Π_{U₁} ⊓ Δ₁` onto `Π_{U₂} ⊓ Δ₂`.

The group-theoretic core is `inf_eq_dupSqClosure`: for a closed normal `Δ ⊴ Π` topologically
generated by two elements and a closed normal `H ⊴ Π` of index `4` with `g² ∈ H` for all `g` and
`Δ H = Π`, one has `H ∩ Δ = Δ^{(2)}`.

`Topics in Absolute Anabelian Geometry II.txt` l.4540–4600 (Cor 3.4).

The genus of `Ē_{\bar K}` is `1` and `Ē_{\bar K} ∖ X_{\bar K}` has exactly one point
(`EllipticGenusOne.lean`), so `Δ ≅ Π̂_{1,1} = F̂₂` (`nonempty_kerProjGk_equiv`).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale PreGaloisCategory
  Belyi Belyi.Anabelian ProfiniteGrp ProfiniteGrp.ProfiniteCompletion Topology

universe u

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace CurvesJacobian.Cusp

/-! ### The closed subgroup generated by squares -/

section Squares

variable {P : Type*} [Group P] [TopologicalSpace P] [IsTopologicalGroup P]

/-- `D^{(2)}`: the closed subgroup topologically generated by the squares of elements of `D`. -/
def dupSqClosure (D : Subgroup P) : Subgroup P :=
  (Subgroup.closure {x | ∃ d ∈ D, d ^ 2 = x}).topologicalClosure

lemma sq_mem_dupSqClosure {D : Subgroup P} {d : P} (hd : d ∈ D) : d ^ 2 ∈ dupSqClosure D :=
  Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ⟨d, hd, rfl⟩)

lemma dupSqClosure_le {D H : Subgroup P} (hH : IsClosed (H : Set P))
    (hsq : ∀ d ∈ D, d ^ 2 ∈ H) : dupSqClosure D ≤ H :=
  Subgroup.topologicalClosure_minimal _
    ((Subgroup.closure_le H).2 (by rintro _ ⟨d, hd, rfl⟩; exact hsq d hd)) hH

lemma isClosed_dupSqClosure (D : Subgroup P) : IsClosed (dupSqClosure D : Set P) :=
  Subgroup.isClosed_topologicalClosure _

omit [TopologicalSpace P] [IsTopologicalGroup P] in
lemma closure_sq_normal (D : Subgroup P) [hD : D.Normal] :
    (Subgroup.closure {x | ∃ d ∈ D, d ^ 2 = x}).Normal := by
  refine ⟨fun n hn g ↦ ?_⟩
  induction hn using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨d, hd, rfl⟩ := hx
    exact Subgroup.subset_closure ⟨g * d * g⁻¹, hD.conj_mem d hd g, by rw [pow_two, pow_two]; group⟩
  | one => simp
  | mul x y _ _ hx hy =>
    rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
    exact mul_mem hx hy
  | inv x _ hx =>
    rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
    exact inv_mem hx

instance dupSqClosure_normal (D : Subgroup P) [D.Normal] : (dupSqClosure D).Normal :=
  haveI := closure_sq_normal D
  Subgroup.is_normal_topologicalClosure _

/-- Four elements `1, u, v, uv` with `u² = v² = (uv)² = 1` form a subgroup. -/
lemma closure_pair_subset {Q : Type*} [Group Q] {u v : Q} (hu : u * u = 1) (hv : v * v = 1)
    (huv : u * v * (u * v) = 1) :
    ∀ z ∈ Subgroup.closure ({u, v} : Set Q), z ∈ ({1, u, v, u * v} : Set Q) := by
  have hu' : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu
  have hv' : v⁻¹ = v := inv_eq_of_mul_eq_one_right hv
  have hvu : v * u = u * v := by
    calc v * u = u⁻¹ * (u * v * (u * v)) * v⁻¹ := by group
      _ = u * v := by rw [huv, hu', hv', mul_one]
  have huu : ∀ w, u * (u * w) = w := fun w ↦ by rw [← mul_assoc, hu, one_mul]
  have hvv : ∀ w, v * (v * w) = w := fun w ↦ by rw [← mul_assoc, hv, one_mul]
  have hvuw : ∀ w, v * (u * w) = u * (v * w) := fun w ↦ by rw [← mul_assoc, hvu, mul_assoc]
  intro z hz
  induction hz using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · simp
    · simp
  | one => simp
  | mul x y _ _ hx hy =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy ⊢
    rcases hx with rfl | rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl | rfl <;>
      simp [mul_assoc, hu, hv, hvu, huu, hvuw]
  | inv x _ hx =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    rcases hx with rfl | rfl | rfl | rfl <;> simp [hu', hv', hvu]

/-- **`[D : D^{(2)}] ≤ 4`** if `D` is closed, normal and topologically generated by two elements. -/
theorem relIndex_dupSqClosure_le {D : Subgroup P} [D.Normal] {a b : P}
    (hgen : (Subgroup.closure ({a, b} : Set P)).topologicalClosure = D) :
    (dupSqClosure D).relIndex D ≤ 4 ∧ (dupSqClosure D).relIndex D ≠ 0 := by
  haveI : IsClosed (dupSqClosure D : Set P) := isClosed_dupSqClosure D
  have hmem : ∀ x ∈ Subgroup.closure ({a, b} : Set P), x ∈ D := fun x hx ↦
    hgen ▸ Subgroup.le_topologicalClosure _ hx
  have ha : a ∈ D := hmem a (Subgroup.subset_closure (by simp))
  have hb : b ∈ D := hmem b (Subgroup.subset_closure (by simp))
  have hq : ∀ d ∈ D, (QuotientGroup.mk' (dupSqClosure D) d) *
      (QuotientGroup.mk' (dupSqClosure D) d) = 1 := fun d hd ↦ by
    rw [← map_mul, ← pow_two, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact sq_mem_dupSqClosure hd
  have huv := hq (a * b) (mul_mem ha hb)
  rw [map_mul] at huv
  have hF := closure_pair_subset (hq a ha) (hq b hb) huv
  set F : Set (P ⧸ dupSqClosure D) := {1, QuotientGroup.mk' (dupSqClosure D) a,
    QuotientGroup.mk' (dupSqClosure D) b,
    QuotientGroup.mk' (dupSqClosure D) a * QuotientGroup.mk' (dupSqClosure D) b} with hFdef
  have hcl : IsClosed ((QuotientGroup.mk' (dupSqClosure D)) ⁻¹' F) :=
    (Set.toFinite F).isClosed.preimage QuotientGroup.continuous_mk
  have hsub : (Subgroup.closure ({a, b} : Set P) : Set P) ⊆
      (QuotientGroup.mk' (dupSqClosure D)) ⁻¹' F := by
    intro x hx
    apply hF
    have h1 := Subgroup.mem_map_of_mem (QuotientGroup.mk' (dupSqClosure D)) hx
    rwa [MonoidHom.map_closure, Set.image_pair] at h1
  have hD : (D : Set P) ⊆ (QuotientGroup.mk' (dupSqClosure D)) ⁻¹' F := by
    intro x hx
    have hx' : x ∈ (Subgroup.closure ({a, b} : Set P)).topologicalClosure := hgen.symm ▸ hx
    have h := closure_minimal hsub hcl
    rw [← Subgroup.topologicalClosure_coe] at h
    exact h hx'
  let φ : D →* P ⧸ dupSqClosure D := (QuotientGroup.mk' (dupSqClosure D)).comp D.subtype
  have hker : (dupSqClosure D).subgroupOf D = φ.ker := by
    ext x
    simp [φ, Subgroup.mem_subgroupOf, QuotientGroup.eq_one_iff]
  have hrange : ∀ z ∈ φ.range, z ∈ F := by
    rintro _ ⟨x, rfl⟩
    exact hD x.2
  let ι : φ.range → F := fun z ↦ ⟨z.1, hrange z.1 z.2⟩
  have hι : Function.Injective ι := fun z w h ↦ Subtype.ext (by
    have h' := congrArg Subtype.val h
    exact h')
  haveI : Finite F := Set.toFinite F
  haveI : Finite φ.range := Finite.of_injective ι hι
  have hidx : (dupSqClosure D).relIndex D = Nat.card φ.range := by
    rw [Subgroup.relIndex, hker, Subgroup.index_ker]
  have hF4 : Nat.card F ≤ 4 := by
    rw [Nat.card_coe_set_eq, hFdef]
    refine (Set.ncard_insert_le _ _).trans ?_
    refine (Nat.add_le_add_right (Set.ncard_insert_le _ _) 1).trans ?_
    refine (Nat.add_le_add_right (Nat.add_le_add_right (Set.ncard_insert_le _ _) 1) 1).trans ?_
    rw [Set.ncard_singleton]
  refine ⟨hidx ▸ (Nat.card_le_card_of_injective ι hι).trans hF4, ?_⟩
  rw [hidx]
  exact Nat.card_pos.ne'

/-- **The group-theoretic core of [AbsTopII] Cor 3.4 (G1)**: let `D ⊴ P` be closed and
topologically generated by two elements, and `H ⊴ P` closed of index `4` with `g² ∈ H` for all
`g` and `D ⊔ H = P`. Then `H ⊓ D = D^{(2)}`. -/
theorem inf_eq_dupSqClosure {D H : Subgroup P} [D.Normal] [H.Normal] (hD : IsClosed (D : Set P))
    (hH : IsClosed (H : Set P)) (hidx : H.index = 4) (hsq : ∀ g : P, g ^ 2 ∈ H)
    (hsup : D ⊔ H = ⊤) {a b : P}
    (hgen : (Subgroup.closure ({a, b} : Set P)).topologicalClosure = D) :
    H ⊓ D = dupSqClosure D := by
  obtain ⟨h4, h0⟩ := relIndex_dupSqClosure_le hgen
  have hle : dupSqClosure D ≤ H ⊓ D :=
    le_inf (dupSqClosure_le hH fun d _ ↦ hsq d) (dupSqClosure_le hD fun d hd ↦ pow_mem hd 2)
  have hHD : (H ⊓ D).relIndex D = 4 := by
    rw [Subgroup.inf_relIndex_right, ← Subgroup.relIndex_sup_right, hsup,
      Subgroup.relIndex_top_right, hidx]
  have hmul := Subgroup.relIndex_mul_relIndex _ _ _ hle (inf_le_right : H ⊓ D ≤ D)
  rw [hHD] at hmul
  have h1 : (dupSqClosure D).relIndex (H ⊓ D) = 1 := by omega
  exact le_antisymm (Subgroup.relIndex_eq_one.1 h1) hle

/-- `D^{(2)}` is transported by isomorphisms of topological groups. -/
theorem map_dupSqClosure {Q : Type*} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    (e : P ≃ₜ* Q) (D : Subgroup P) :
    (dupSqClosure D).map e.toMulEquiv.toMonoidHom =
      dupSqClosure (D.map e.toMulEquiv.toMonoidHom) := by
  apply SetLike.coe_injective
  have hc : ⇑e.toMulEquiv.toMonoidHom = ⇑e.toHomeomorph := rfl
  rw [Subgroup.coe_map, dupSqClosure, dupSqClosure, Subgroup.topologicalClosure_coe,
    Subgroup.topologicalClosure_coe, hc, Homeomorph.image_closure, ← hc, ← Subgroup.coe_map,
    MonoidHom.map_closure]
  congr 3
  ext y
  constructor
  · rintro ⟨_, ⟨d, hd, rfl⟩, rfl⟩
    exact ⟨e d, ⟨d, hd, rfl⟩, (map_pow _ d 2).symm⟩
  · rintro ⟨_, ⟨d, hd, rfl⟩, rfl⟩
    exact ⟨d ^ 2, ⟨d, hd, rfl⟩, map_pow _ d 2⟩

end Squares

/-! ### Topological generation of `Π̂_{1,1}` by two elements -/

section Rank

/-- The generator `a₀` of `Π_{1,1}`. -/
def surfA₂ : ULift.{u} (Pi1.SurfaceGroup 1 1) :=
  ULift.up ((Pi1.SurfaceGroup.freeEquiv (g := 1) (r := 0)).symm
    (FreeGroup.of (Pi1.SurfaceGen.a 0)))

/-- The generator `b₀` of `Π_{1,1}`. -/
def surfB₂ : ULift.{u} (Pi1.SurfaceGroup 1 1) :=
  ULift.up ((Pi1.SurfaceGroup.freeEquiv (g := 1) (r := 0)).symm
    (FreeGroup.of (Pi1.SurfaceGen.b 0)))

/-- The two generators `a₀, b₀` of `Π_{1,1} ≅ F₂` generate it. -/
lemma closure_surfaceGen_eq_top :
    Subgroup.closure ({surfA₂.{u}, surfB₂.{u}} : Set (ULift.{u} (Pi1.SurfaceGroup 1 1))) = ⊤ := by
  let ψ : FreeGroup (Pi1.SurfaceGen 1 0) ≃* ULift.{u} (Pi1.SurfaceGroup 1 1) :=
    (Pi1.SurfaceGroup.freeEquiv (g := 1) (r := 0)).symm.trans MulEquiv.ulift.symm
  have hrange : Set.range (FreeGroup.of : Pi1.SurfaceGen 1 0 → _) =
      {FreeGroup.of (Pi1.SurfaceGen.a 0), FreeGroup.of (Pi1.SurfaceGen.b 0)} := by
    ext z
    constructor
    · rintro ⟨s, rfl⟩
      rcases s with i | i | i
      · left; rw [Subsingleton.elim i 0]
      · right; rw [Subsingleton.elim i 0]; rfl
      · exact i.elim0
    · rintro (rfl | rfl)
      · exact ⟨_, rfl⟩
      · exact ⟨_, rfl⟩
  have h := congrArg (Subgroup.map ψ.toMonoidHom) (FreeGroup.closure_range_of (Pi1.SurfaceGen 1 0))
  rw [MonoidHom.map_closure, hrange, Set.image_pair,
    Subgroup.map_top_of_surjective _ ψ.surjective] at h
  exact h

/-- The profinite completion of a group generated by `x, y` is topologically generated by
their images. -/
lemma dense_closure_etaFn {G : Type u} [Group G] {x y : G}
    (h : Subgroup.closure ({x, y} : Set G) = ⊤) :
    Dense ((Subgroup.closure ({etaFn (GrpCat.of G) x, etaFn (GrpCat.of G) y} :
      Set (completion (GrpCat.of G))) : Set (completion (GrpCat.of G)))) := by
  have e : Subgroup.closure ({etaFn (GrpCat.of G) x, etaFn (GrpCat.of G) y} :
      Set (completion (GrpCat.of G))) = (Subgroup.closure ({x, y} : Set G)).map
        (eta (GrpCat.of G)).hom := by
    rw [MonoidHom.map_closure, Set.image_pair]
    rfl
  rw [e, h, ← MonoidHom.range_eq_map, MonoidHom.coe_range]
  exact denseRange (GrpCat.of G)

/-- **A closed subgroup `D ≅ Π̂_{1,1}` is topologically generated by two elements.** -/
theorem exists_topGen_of_equiv {P : Type*} [Group P] [TopologicalSpace P]
    [IsTopologicalGroup P] {D : Subgroup P} (hD : IsClosed (D : Set P)) {g r : ℕ}
    (e : D ≃ₜ* completion (GrpCat.of (ULift.{u} (Pi1.SurfaceGroup g r))))
    (hg : g = 1) (hr : r = 1) :
    ∃ a b : P, (Subgroup.closure ({a, b} : Set P)).topologicalClosure = D := by
  subst hg hr
  have hdense := dense_closure_etaFn closure_surfaceGen_eq_top
  set T : Set (completion (GrpCat.of (ULift.{u} (Pi1.SurfaceGroup 1 1)))) :=
    SetLike.coe (Subgroup.closure ({etaFn (GrpCat.of _) surfA₂.{u},
      etaFn (GrpCat.of _) surfB₂.{u}} : Set (completion (GrpCat.of (ULift.{u}
        (Pi1.SurfaceGroup 1 1)))))) with hT
  refine ⟨(e.symm (etaFn (GrpCat.of _) surfA₂.{u}) : P),
    (e.symm (etaFn (GrpCat.of _) surfB₂.{u}) : P), ?_⟩
  have hmap : (Subgroup.closure ({(e.symm (etaFn (GrpCat.of _) surfA₂.{u}) : P),
      (e.symm (etaFn (GrpCat.of _) surfB₂.{u}) : P)} : Set P) : Set P) =
      Subtype.val '' (e.symm '' T) := by
    rw [hT, ← Subgroup.coe_subtype, ← Set.image_comp, ← MonoidHom.coe_coe e.symm,
      ← MonoidHom.coe_comp, ← Subgroup.coe_map, MonoidHom.map_closure, Set.image_pair]
    rfl
  apply SetLike.coe_injective
  rw [Subgroup.topologicalClosure_coe, hmap]
  apply subset_antisymm
  · refine closure_minimal ?_ hD
    rintro _ ⟨z, _, rfl⟩
    exact z.2
  · intro d hd
    have h1 : Dense (e.symm '' T) :=
      e.symm.toHomeomorph.surjective.denseRange.dense_image e.symm.continuous hdense
    have h2 : (⟨d, hd⟩ : D) ∈ closure (e.symm '' T) := h1.closure_eq ▸ Set.mem_univ _
    exact image_closure_subset_closure_image continuous_subtype_val ⟨_, h2, rfl⟩

end Rank

/-! ### Galois objects whose automorphisms are involutions -/

section GaloisInvolution

variable {C : Type*} [Category C] [GaloisCategory C] (F : C ⥤ FintypeCat.{u}) [FiberFunctor F]

/-- If every automorphism of the Galois object `A` is an involution, then `σ² ∈ Stab(x)` for
every `σ ∈ Aut F` and every point `x` of the fibre of `A`. -/
theorem sq_mem_stabilizer_of_mul_self (A : C) [IsGalois A] (hA : ∀ a : Aut A, a * a = 1)
    (x : F.obj A) (σ : Aut F) : σ ^ 2 ∈ MulAction.stabilizer (Aut F) x := by
  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq (Aut A) x (σ • x)
  have h2 : F.map a.hom (F.map a.hom x) = x := by
    have h := congrArg (fun b : Aut A ↦ F.map b.hom x) (hA a)
    have e1 : (1 : Aut A).hom = 𝟙 A := rfl
    simp only [Aut.Aut_mul_def, Iso.trans_hom, Functor.map_comp, FintypeCat.comp_apply, e1] at h
    exact h.trans (by simp)
  rw [MulAction.mem_stabilizer_iff, pow_two, mul_smul, ← ha]
  change σ • F.map a.hom x = x
  rw [mulAction_naturality, ← ha]
  exact h2

/-- The stabiliser of a point of the fibre of a Galois object `A` has index `|Aut A|`. -/
theorem index_stabilizer_of_isGalois (A : C) [IsGalois A] (x : F.obj A) :
    (MulAction.stabilizer (Aut F) x).index = Nat.card (Aut A) := by
  rw [MulAction.index_stabilizer_of_transitive]
  exact (Nat.card_congr (evaluationEquivOfIsGalois F A x)).symm

end GaloisInvolution

/-! ### `Aut([2] : E ∖ E[2] → E ∖ {O})` = the four translations by `E[2]`, all involutions -/

section AutE

open Polynomial WeierstrassCurve.Affine WeierstrassCurve.Affine.CoordinateRing

variable {K : Type u} [Field K] [CharZero K] {E : WeierstrassCurve K} [E.IsElliptic]
  {e₁ e₂ e₃ : K} (he : E.Ψ₂Sq = C 4 * ((X - C e₁) * (X - C e₂) * (X - C e₃)))

open Classical in
lemma tau2_mul_self (i : Fin 4) : tau2 he i * tau2 he i = 1 := by
  have h : twoTorsionPt he i + twoTorsionPt he i = 0 := by
    rw [← two_nsmul]
    exact mem_torsion_iff.1 (twoTorsionPt_mem he i)
  rw [tau2, ← translateAut_add, h, translateAut_zero]

lemma sigma2_sigma2 (i : Fin 4) (b : coverRingE E) : sigma2 he i (sigma2 he i b) = b := by
  apply IsFractionRing.injective (coverRingE E) E.toAffine.FunctionField
  have h1 := algebraMap_restrictRingEquiv (dupHom E) (dupHom_isIntegral E)
    (tau2 he i).toRingEquiv (tau2_dupHom he i)
  change algebraMap _ _ (restrictRingEquiv _ _ _ _ (restrictRingEquiv _ _ _ _ b)) = _
  rw [h1, h1]
  change (tau2 he i * tau2 he i) _ = _
  rw [tau2_mul_self]
  rfl

lemma rhoV_hom_comp_self (i : Fin 4) : (rhoV he i).hom ≫ (rhoV he i).hom = 𝟙 _ := by
  ext x
  simp [rhoV, sigma2_sigma2]

/-- The translation by the `i`-th point of `E[2]` as an automorphism of the cover `[2]`. -/
def dupAut (i : Fin 4) : Aut (coverObj (coverXMorK E)) :=
  autOfRingIso (CommRingCat.ofHom (coverXHom E)) (rhoV he i) (rhoV_comm he i)

lemma dupAut_mul_self (i : Fin 4) : dupAut he i * dupAut he i = 1 := by
  apply Iso.ext
  refine MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
  change Spec.map (rhoV he i).hom ≫ Spec.map (rhoV he i).hom = 𝟙 _
  rw [← Spec.map_comp, rhoV_hom_comp_self, Spec.map_id]

lemma dupAut_injective : Function.Injective (dupAut he) := by
  intro i j hij
  have h : Spec.map (rhoV he i).hom = Spec.map (rhoV he j).hom := by
    rw [← autOfRingIso_hom_left _ (rhoV he i) (rhoV_comm he i),
      ← autOfRingIso_hom_left _ (rhoV he j) (rhoV_comm he j)]
    exact congrArg (fun e : Aut (coverObj (coverXMorK E)) ↦ e.hom.left) hij
  exact rhoV_injective he (Iso.ext (Spec.map_injective h))

variable (E) in
/-- `Aut([2])` is finite with at most `4` elements: it embeds into the geometric generic fibre. -/
theorem card_aut_coverXMorK_le : Finite (Aut (coverObj (coverXMorK E))) ∧
    Nat.card (Aut (coverObj (coverXMorK E))) ≤ 4 := by
  obtain ⟨hfin, hcard⟩ := finite_card_fibre_le E
  haveI : IsConnected (coverObj (coverXMorK E)) :=
    (isConnected_iff_connectedSpace (coverObj (coverXMorK E))).2
      (inferInstanceAs (ConnectedSpace (Spec Γ(curveE E, VE E))))
  obtain ⟨x⟩ := nonempty_fiber_of_isConnected (fiber (Spec.map (zetaE E)))
    (coverObj (coverXMorK E))
  have hw : ∀ y : (fiber (Spec.map (zetaE E))).obj (coverObj (coverXMorK E)),
      CommRingCat.ofHom (coverXHom E) ≫
        Spec.preimage (fiberObjEquivHom (Spec.map (zetaE E)) _ y).left = zetaE E := fun y ↦ by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage]
    exact w_left (fiberObjEquivHom (Spec.map (zetaE E)) _ y)
  let ev : Aut (coverObj (coverXMorK E)) → {g : Γ(curveE E, VE E) ⟶ CommRingCat.of (OmegaE E) //
      CommRingCat.ofHom (coverXHom E) ≫ g = zetaE E} := fun a ↦
    ⟨Spec.preimage (fiberObjEquivHom (Spec.map (zetaE E)) _
      ((fiber (Spec.map (zetaE E))).map a.hom x)).left, hw _⟩
  have hev : Function.Injective ev := by
    intro a b hab
    apply evaluation_aut_injective_of_isConnected (fiber (Spec.map (zetaE E))) _ x
    have h : (fiberObjEquivHom (Spec.map (zetaE E)) _
          ((fiber (Spec.map (zetaE E))).map a.hom x)).left =
        (fiberObjEquivHom (Spec.map (zetaE E)) _
          ((fiber (Spec.map (zetaE E))).map b.hom x)).left := by
      rw [← Spec.map_preimage (fiberObjEquivHom (Spec.map (zetaE E)) _
          ((fiber (Spec.map (zetaE E))).map a.hom x)).left,
        ← Spec.map_preimage (fiberObjEquivHom (Spec.map (zetaE E)) _
          ((fiber (Spec.map (zetaE E))).map b.hom x)).left]
      exact congrArg (fun g ↦ Spec.map g.1) hab
    exact (fiberObjEquivHom (Spec.map (zetaE E)) _).injective (Over.OverMorphism.ext h)
  exact ⟨Finite.of_injective ev hev, (Nat.card_le_card_of_injective ev hev).trans hcard⟩

/-- **The automorphisms of `[2] : E ∖ E[2] → E ∖ {O}` are exactly the four translations.** -/
theorem dupAut_bijective : Function.Bijective (dupAut he) := by
  obtain ⟨hfin, hcard⟩ := card_aut_coverXMorK_le E
  exact (dupAut_injective he).bijective_of_nat_card_le (by simpa using hcard)

include he in
/-- `|Aut([2])| = 4`. -/
theorem card_aut_coverXMorK : Nat.card (Aut (coverObj (coverXMorK E))) = 4 := by
  rw [← Nat.card_congr (Equiv.ofBijective _ (dupAut_bijective he))]
  simp

include he in
/-- **Every automorphism of `[2]` is an involution** (`T + T = 0` for `T ∈ E[2]`). -/
theorem aut_coverXMorK_mul_self (a : Aut (coverObj (coverXMorK E))) : a * a = 1 := by
  obtain ⟨i, rfl⟩ := (dupAut_bijective he).2 a
  exact dupAut_mul_self he i

end AutE

/-! ### `Π_U` in `Π_{E∖O}`: index `4`, squares, and `Δ · Π_U = Π` -/

section PiU

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (E : WeierstrassCurve K) [E.IsElliptic]

attribute [local instance] isAlgClosure_of_isAlgebraic

lemma hcV_dup : ((hypCurveV E).U : Set (hypCurveV E).Xbar)ᶜ.Nonempty :=
  (compl_XE_nonempty E).mono (Set.compl_subset_compl.2 (VE_le_XE E))

/-- **`Π_U ⊆ Π_{E∖O}`**: the image of `π₁(E ∖ E[2]) → π₁(E ∖ {O})` under `[2]`. -/
abbrev dupPiU : Subgroup (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Pi :=
  cor37bPiV Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveV E) (hcV_dup E) (coverXMorK E)

/-- `MulEquiv` images preserve the index. -/
lemma index_map_mulEquiv₂ {G G' : Type*} [Group G] [Group G'] (e : G ≃* G') (H : Subgroup G) :
    (H.map e.toMonoidHom).index = H.index :=
  Subgroup.index_map_equiv H e

lemma dupPiU_eq_map : dupPiU Ω E =
    (fundamentalGroupMap (coverXMorK E) rfl).toMonoidHom.range.map
      (autContinuousMulEquivOfIso (coverFib Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveV E)
        (hcV_dup E) (coverXMorK E))).toMulEquiv.toMonoidHom := by
  ext z
  constructor
  · rintro ⟨σ, rfl⟩
    exact ⟨_, ⟨σ, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨σ, rfl⟩, rfl⟩
    exact ⟨σ, rfl⟩

open Polynomial in
/-- **`[Π : Π_U] = 4`**. -/
theorem dupPiU_index {e₁ e₂ e₃ : K} (he : E.Ψ₂Sq = C 4 * ((X - C e₁) * (X - C e₂) * (X - C e₃))) :
    (dupPiU Ω E).index = 4 := by
  haveI := isIntegral_specSections (hypCurveX E) (compl_XE_nonempty E)
  haveI := isGalois_coverXMorK he
  rw [dupPiU_eq_map, index_map_mulEquiv₂, range_fundamentalGroupMap_of_isFiniteEtale',
    index_stabilizer_of_isGalois, card_aut_coverXMorK he]

open Polynomial in
/-- **`g² ∈ Π_U` for every `g ∈ Π`** (`Π/Π_U ≅ E[2]` has exponent `2`). -/
theorem sq_mem_dupPiU {e₁ e₂ e₃ : K} (he : E.Ψ₂Sq = C 4 * ((X - C e₁) * (X - C e₂) * (X - C e₃)))
    (g : (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Pi) : g ^ 2 ∈ dupPiU Ω E := by
  haveI := isIntegral_specSections (hypCurveX E) (compl_XE_nonempty E)
  haveI := isGalois_coverXMorK he
  rw [dupPiU_eq_map, range_fundamentalGroupMap_of_isFiniteEtale']
  obtain ⟨s, rfl⟩ := (autContinuousMulEquivOfIso (coverFib Ω (hypCurveX E) (compl_XE_nonempty E)
    (hypCurveV E) (hcV_dup E) (coverXMorK E))).surjective g
  refine ⟨s ^ 2, sq_mem_stabilizer_of_mul_self _ _ (aut_coverXMorK_mul_self he) _ s, ?_⟩
  exact map_pow _ s 2

/-- `Π_U` is open, hence closed. -/
theorem isClosed_dupPiU : IsClosed (SetLike.coe (dupPiU Ω E)) := by
  have h := isOpen_range_coverPiHom Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveV E)
    (hcV_dup E) (coverXMorK E)
  exact Subgroup.isClosed_of_isOpen _ h

open Polynomial in
/-- `Π_U ⊴ Π`. -/
theorem dupPiU_normal {e₁ e₂ e₃ : K}
    (he : E.Ψ₂Sq = C 4 * ((X - C e₁) * (X - C e₂) * (X - C e₃))) : (dupPiU Ω E).Normal :=
  cor37b_normal Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveV E) (hcV_dup E) (coverXMorK E)
    (galoisBelyiInputE he).isGalois

omit [NumberField K] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
/-- `G_K → G_K` induced by `K = K` is surjective. -/
lemma galoisMap_self_surjective : Function.Surjective (galoisMap K K Ω) := by
  have e : Spec.map (CommRingCat.ofHom (algebraMap K K)) = 𝟙 _ := by
    rw [Algebra.algebraMap_self]
    exact Spec.map_id _
  intro σ
  refine ⟨σ, ?_⟩
  change fundamentalGroupMap _ (specMap_algebraMap_tower K K Ω) σ = σ
  rw [fundamentalGroupMap_congr e _ (Category.comp_id _), fundamentalGroupMap_id]
  rfl

open Polynomial in
/-- **`Π_U ↠ G_K`**: `E ∖ E[2]` is geometrically connected over `K`. -/
theorem pr_dupPiU_surjective {e₁ e₂ e₃ : K}
    (he : E.Ψ₂Sq = C 4 * ((X - C e₁) * (X - C e₂) * (X - C e₃)))
    (y : (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).G) :
    ∃ h ∈ dupPiU Ω E, (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr h = y := by
  obtain ⟨z, hz⟩ := (autContinuousMulEquivOfIso (coverG Ω (hypCurveX E) (compl_XE_nonempty E)
    (hypCurveV E) (hcV_dup E) (coverXMorK E) (strictlyBelyiInputEK he).hFV)).surjective y
  obtain ⟨w, hw⟩ := galoisMap_self_surjective Ω z
  obtain ⟨γ, hγ⟩ := (arithmeticExt Ω (hypCurveV E) (hcV_dup E)).pr_surjective w
  refine ⟨_, ⟨γ, rfl⟩, ?_⟩
  change (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr
    (coverPiHom Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveV E) (hcV_dup E) (coverXMorK E) γ)
    = y
  rw [pr_coverPiHom Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveV E) (hcV_dup E)
    (coverXMorK E) (strictlyBelyiInputEK he).hFV, hγ, ← hz, ← hw]
  rfl

open Polynomial in
/-- **`Δ · Π_U = Π`**. -/
theorem Delta_sup_dupPiU {e₁ e₂ e₃ : K}
    (he : E.Ψ₂Sq = C 4 * ((X - C e₁) * (X - C e₂) * (X - C e₃))) :
    (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta ⊔ dupPiU Ω E = ⊤ := by
  refine eq_top_iff.2 fun g _ ↦ ?_
  obtain ⟨h, hh, hpr⟩ := pr_dupPiU_surjective Ω E he
    ((arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr g)
  have hd : g * h⁻¹ ∈ (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta := by
    change (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr (g * h⁻¹) = 1
    rw [map_mul, map_inv, hpr, mul_inv_cancel]
  have := Subgroup.mul_mem_sup hd hh
  rwa [inv_mul_cancel_right] at this

/-- `Δ` is closed. -/
theorem isClosed_Delta₂ (A : CuspidalExt) : IsClosed (A.Delta : Set A.Pi) :=
  isClosed_singleton.preimage A.pr.continuous

instance Delta_normal₂ (A : CuspidalExt) : A.Delta.Normal :=
  MonoidHom.normal_ker _

/-- **[AbsTopII] Cor 3.4, step G1: `Π_U ⊓ Δ = Δ^{(2)}`** for `X = E ∖ {O}` with `K`-rational
`E[2]` (`Ē_{\bar K}` has genus `1` and `X_{\bar K}` one cusp, so that `Δ ≅ Π̂_{1,1}`). -/
theorem dupPiU_inf_Delta (hE : E.Ψ₂Sq.Splits) :
    dupPiU Ω E ⊓ (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta =
      dupSqClosure (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta := by
  obtain ⟨e₁, e₂, e₃, he⟩ := exists_roots_of_splits E hE
  haveI := dupPiU_normal Ω E he
  obtain ⟨e⟩ := nonempty_kerProjGk_equiv Ω (hypCurveX E) (compl_XE_nonempty E)
  obtain ⟨a, b, hab⟩ := exists_topGen_of_equiv
    (D := (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta)
    (isClosed_Delta₂ _) e (curveGenus_baseChange_curveE E Ω)
    (card_compl_baseChangeOpen_XE E Ω)
  exact inf_eq_dupSqClosure (isClosed_Delta₂ _) (isClosed_dupPiU Ω E) (dupPiU_index Ω E he)
    (sq_mem_dupPiU Ω E he) (Delta_sup_dupPiU Ω E he) hab

end PiU

/-! ### Transport along isomorphisms of cuspidal extensions -/

/-- An isomorphism of cuspidal extensions maps `Δ` onto `Δ`. -/
theorem _root_.Belyi.Anabelian.CuspidalExt.Iso.map_Delta₂ {A B : CuspidalExt} (Φ : A.Iso B) :
    A.Delta.map Φ.pi.toMulEquiv.toMonoidHom = B.Delta := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    change B.pr (Φ.pi x) = 1
    rw [Φ.pr_comm]
    rw [show A.pr x = 1 from hx, map_one]
  · intro hy
    refine ⟨Φ.pi.symm y, ?_, Φ.pi.apply_symm_apply y⟩
    change A.pr (Φ.pi.symm y) = 1
    apply Φ.g.injective
    rw [← Φ.pr_comm, Φ.pi.apply_symm_apply, map_one]
    exact hy

/-- **An isomorphism of cuspidal extensions maps `Δ^{(2)}` onto `Δ^{(2)}`.** -/
theorem _root_.Belyi.Anabelian.CuspidalExt.Iso.map_dupSqClosure₂ {A B : CuspidalExt} (Φ : A.Iso B) :
    (dupSqClosure A.Delta).map Φ.pi.toMulEquiv.toMonoidHom = dupSqClosure B.Delta := by
  rw [CurvesJacobian.Cusp.map_dupSqClosure, Φ.map_Delta₂]

section Transport

variable {K₁ : Type u} [Field K₁] [NumberField K₁] (Ω₁ : Type u) [Field Ω₁] [Algebra K₁ Ω₁]
  [IsAlgClosed Ω₁] [Algebra.IsAlgebraic K₁ Ω₁] [CharZero Ω₁] (E₁ : WeierstrassCurve K₁)
  [E₁.IsElliptic]
  {K₂ : Type u} [Field K₂] [NumberField K₂] (Ω₂ : Type u) [Field Ω₂] [Algebra K₂ Ω₂]
  [IsAlgClosed Ω₂] [Algebra.IsAlgebraic K₂ Ω₂] [CharZero Ω₂] (E₂ : WeierstrassCurve K₂)
  [E₂.IsElliptic]

/-- **[AbsTopII] Cor 3.4 (G1), transport**: an isomorphism `Φ : Π_{X₁} ≅ Π_{X₂}` of cuspidal
extensions (`X_i = E_i ∖ {O}`, `E_i[2]` rational) maps
`Π_{U₁} ⊓ Δ₁` onto `Π_{U₂} ⊓ Δ₂`. -/
theorem map_dupPiU_inf_Delta
    (Φ : (arithmeticExt Ω₁ (hypCurveX E₁) (compl_XE_nonempty E₁)).Iso
      (arithmeticExt Ω₂ (hypCurveX E₂) (compl_XE_nonempty E₂)))
    (hE₁ : E₁.Ψ₂Sq.Splits) (hE₂ : E₂.Ψ₂Sq.Splits) :
    (dupPiU Ω₁ E₁ ⊓ (arithmeticExt Ω₁ (hypCurveX E₁) (compl_XE_nonempty E₁)).Delta).map
        Φ.pi.toMulEquiv.toMonoidHom =
      dupPiU Ω₂ E₂ ⊓ (arithmeticExt Ω₂ (hypCurveX E₂) (compl_XE_nonempty E₂)).Delta := by
  rw [dupPiU_inf_Delta Ω₁ E₁ hE₁, dupPiU_inf_Delta Ω₂ E₂ hE₂,
    Φ.map_dupSqClosure₂]

end Transport

end CurvesJacobian.Cusp
