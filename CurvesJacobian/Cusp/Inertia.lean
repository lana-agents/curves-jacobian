import CurvesJacobian.Galois.EtalePi1Open

/-!
# Cuspidal inertia subgroups of `π₁ᵉᵗ(U)` and filling in cusps (MR8.3, [AbsTopI] Lemma 4.1 (v))

[AbsTopI] Definition 4.2 (iii) (`Topics in Absolute Anabelian Geometry I.txt` l.3011–3014): an
operation of type `•` is a surjection `Π_j ↠ Π_{j+1}` "with kernel topologically normally
generated by a cuspidal decomposition group"; the geometric input ([AbsTopI] Lemma 4.1 (v)) is
that filling in cusps `U ⊆ V` kills exactly the closed normal subgroup generated by the inertia
groups of the cusps `V ∖ U`.

Setting of `CurvesJacobian/Galois/EtalePi1Open.lean` (`k` algebraically closed of characteristic
`0`, Galois data `D` with `H = H_L`, `X` a curve over `k` with `eL : K(X) ≃ L`). For a place
`W ⊇ k` of `Ω`:

* `CurvesJacobian.Cusp.IsCentredOn D X eL U W`: `W` is centred on `U`, i.e. `eL(Γ(U, 𝒪_X)) ⊆ W`;
* `CurvesJacobian.Cusp.cuspInertia D X eL hH U W ⊆ π₁ᵉᵗ(U)`: the subgroup generated by the images
  of the inertia elements of `W` under the Galois action `H → π₁ᵉᵗ(U)` at the generic point; for
  `W` not centred on `U` (a place over a cusp of `U`) this is a cuspidal inertia group;
* `CurvesJacobian.Cusp.cusps D X eL hH U`: the set of these, for places over the cusps of `U`;
* `CurvesJacobian.Cusp.ker_fundamentalGroupMap_homOfLE_eq_cuspInertia`: **filling in cusps** —
  for `U ⊆ V` (nonempty, finite complements) the kernel of `π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(V)` is the closed normal
  subgroup generated by the cuspidal inertia groups `cuspInertia U W` of the places `W` centred on
  `V` but not on `U` (the places over `V ∖ U`).
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale
open Pi1.Orbifold AffOrbicurve

universe u

noncomputable section

namespace CurvesJacobian.Cusp

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} (D : GaloisData k t)
  (X : Scheme.{u}) [X.Over (Spec (CommRingCat.of k))] [IsIntegral X]
  (eL : X.functionField ≃+* D.L)

/-- A place `W ⊇ k` of `Ω` is **centred on** the open `U` if `eL(Γ(U, 𝒪_X)) ⊆ W`. -/
def IsCentredOn (U : X.Opens) [Nonempty U] (W : ValuationSubring Ω) : Prop :=
  (∀ c : k, algebraMap k Ω c ∈ W) ∧ ∀ a : Γ(X, U), ((eL (X.germToFunctionField U a) : D.L) : Ω) ∈ W

omit [X.Over (Spec (CommRingCat.of k))] in
/-- `S_U` is the set of inertia elements (in `H`) of the places centred on `U`. -/
lemma mem_SU_iff (U : X.Opens) [Nonempty U] (σ : Ω ≃ₐ[K₀ k t] Ω) :
    σ ∈ SU D X eL U ↔ σ ∈ D.H ∧ ∃ W, IsCentredOn D X eL U W ∧ σ ∈ GaloisPi1.inertia W := by
  simp only [SU, IsCentredOn, Set.mem_setOf_eq, and_assoc]

variable [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] (hH : D.H ≤ D.HL)

/-- **The cuspidal inertia group** of the place `W` in `π₁ᵉᵗ(U)`: the subgroup generated by the
images of the inertia elements of `W` under the Galois action `H → π₁ᵉᵗ(U)`. -/
def cuspInertia (U : X.Opens) [Nonempty U] (W : ValuationSubring Ω) :
    Subgroup π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) :=
  Subgroup.closure (D.chartHom hH (genericL D X eL U) ''
    (Subtype.val ⁻¹' GaloisPi1.inertia W : Set D.H))

/-- **The cuspidal inertia groups of `π₁ᵉᵗ(U)`**: `cuspInertia U W` for the places `W ⊇ k` not
centred on `U` (the places over the cusps `X ∖ U`). -/
def cusps (U : X.Opens) [Nonempty U] : Set (Subgroup π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) :=
  {I | ∃ W : ValuationSubring Ω, (∀ c : k, algebraMap k Ω c ∈ W) ∧ ¬ IsCentredOn D X eL U W ∧
    I = cuspInertia D X eL hH U W}

variable [IsAlgClosed k] [CharZero k] [IsCurveOver k X]
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)

omit [IsAlgClosed k] in
include hk hτ in
/-- **Filling in cusps** ([AbsTopI] Lemma 4.1 (v)): for `U ⊆ V` nonempty opens of `X` with finite
complements, the kernel of `π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(V)` is the closed normal subgroup generated by the
cuspidal inertia groups of the places centred on `V` but not on `U`. -/
theorem ker_fundamentalGroupMap_homOfLE_eq_cuspInertia {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hU : (U : Set X)ᶜ.Finite) (hV : (V : Set X)ᶜ.Finite) (h : U ≤ V) :
    (fundamentalGroupMap (X.homOfLE h) (specPoint_genericL_homOfLE D X eL h)).toMonoidHom.ker =
      (Subgroup.normalClosure (⋃ (W : ValuationSubring Ω)
        (_ : IsCentredOn D X eL V W ∧ ¬ IsCentredOn D X eL U W),
          (cuspInertia D X eL hH U W : Set _))).topologicalClosure := by
  rw [ker_fundamentalGroupMap_homOfLE D X eL hk hH hτ hU hV h]
  have hU' := genericL_spec D X eL hk hH hτ U hU
  -- Elements of `S_U` act trivially on `π₁ᵉᵗ(U)`.
  have htriv : ∀ σ : D.H, (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ SU D X eL U →
      D.chartHom hH (genericL D X eL U) σ = 1 := fun σ hσU ↦ by
    rw [← MonoidHom.mem_ker, hU'.1, GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _
      (SU_subset_H D X eL U)]
    exact Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure hσU)
  congr 1
  apply le_antisymm
  · refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨σ, ⟨hσV, hσU⟩, rfl⟩
    obtain ⟨-, W, hW, hσW⟩ := (mem_SU_iff D X eL V _).1 hσV
    have hWU : ¬ IsCentredOn D X eL U W := fun hWU ↦
      hσU ((mem_SU_iff D X eL U _).2 ⟨σ.2, W, hWU, hσW⟩)
    refine Subgroup.subset_normalClosure (Set.mem_iUnion₂.2 ⟨W, ⟨hW, hWU⟩, ?_⟩)
    exact Subgroup.subset_closure ⟨σ, hσW, rfl⟩
  · refine Subgroup.normalClosure_le_normal ?_
    intro g hg
    obtain ⟨W, ⟨hWV, hWU⟩, hgW⟩ := Set.mem_iUnion₂.1 hg
    refine (Subgroup.closure_le _).2 ?_ hgW
    rintro _ ⟨σ, hσW, rfl⟩
    by_cases hσU : (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ SU D X eL U
    · rw [htriv σ hσU]
      exact Subgroup.one_mem _
    · exact Subgroup.subset_normalClosure
        ⟨σ, ⟨(mem_SU_iff D X eL V _).2 ⟨σ.2, W, hWV, hσW⟩, hσU⟩, rfl⟩

omit [IsAlgClosed k] in
include hk hτ in
/-- The cuspidal inertia groups of the places over `V ∖ U` lie in the kernel of
`π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(V)`. -/
theorem cuspInertia_le_ker {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hU : (U : Set X)ᶜ.Finite) (hV : (V : Set X)ᶜ.Finite) (h : U ≤ V) {W : ValuationSubring Ω}
    (hWV : IsCentredOn D X eL V W) (hWU : ¬ IsCentredOn D X eL U W) :
    cuspInertia D X eL hH U W ≤ (fundamentalGroupMap (X.homOfLE h)
      (specPoint_genericL_homOfLE D X eL h)).toMonoidHom.ker := by
  rw [ker_fundamentalGroupMap_homOfLE_eq_cuspInertia D X eL hH hk hτ hU hV h]
  intro g hg
  exact Subgroup.le_topologicalClosure _
    (Subgroup.subset_normalClosure (Set.mem_iUnion₂.2 ⟨W, ⟨hWV, hWU⟩, hg⟩))

end CurvesJacobian.Cusp
