import CurvesJacobian.Cusp.HemiSemiElliptic
import CurvesJacobian.Cusp.CurveInertiaIsoAny

/-!
# `Δ_C` is generated by involutions outside `Π_X` (step (D-b) of [AbsTopII] Cor. 3.3 (ii))

Let `E` be an elliptic curve over a number field `K`, `X = E ∖ {O}`, `C = [X / ±1]` the
hemi-elliptic orbicurve (`CurvesJacobian.Cusp.hemiData`), `Π_C = etalePi1 R A Ω ≅ H ⧸ ⟨⟨S⟩⟩`
(`H = Gal(Ω / K(x))`), `Δ_C = ker (Π_C → G_K)` (`hemiPrC`) and `Π_X ↪ Π_C` (`hemiPiXEmb`).
We prove (`CurvesJacobian.Cusp.hemi_hgen`) that `Δ_C` is topologically generated by the
involutions of `Δ_C` not in `Π_X`, the hypothesis `hgen` of `hemi_semiElliptic_iff`, and deduce
the unconditional **[AbsTopII] Cor. 3.3 (ii)** for `C` (`hemi_semiElliptic_iff'`).

## Proof (route 1: `π₁ᵉᵗ(𝔸¹_{k̄}) = 1`)

* **The affine line is simply connected, Galois form**
  (`CurvesJacobian.Cusp.mem_ambientKernel_lineData₂`): for `k` algebraically closed of
  characteristic `0` and `Ω / k(t)` Galois, separably closed, `Gal(Ω / k(t))` is the closed
  subgroup generated by the inertia elements at the places `W ⊇ k` with `t ∈ W` (the places
  centred on `𝔸¹`). Proof: by pi1's `GaloisData.ker_galoisHom` for the Galois data
  `lineData₂` (`H = H_L = Gal(Ω / k(t))`, `R = k[t]`) it suffices that the Galois action
  `Gal(Ω / k(t)) → π₁ᵉᵗ(Spec R)` is trivial. It factors through `π₁ᵉᵗ(𝔾_m) ≅ Π̂_{0,2}`
  (`exists_continuousMulEquiv_lineInertiaS` for `S = {0}`, the scheme map
  `𝔾_m = Spec k[t, 1/t] → Spec R`, `lineDataToS₂`), which is topologically generated by the
  cuspidal generator at `0` (`eq_top_of_etaFn_cusp_mem₂`: `c₀ c₁ = 1`), whose image is the image
  of an inertia group at a place over `0`, trivial in `π₁ᵉᵗ(Spec R)`.
* **Transfer to `K`** (`CurvesJacobian.Cusp.mem_of_galResConst_eq_one₂`): for `K` of
  characteristic `0`, `Ω` algebraically closed and Galois over `K(t)` and `k̄ ⊆ Ω` the algebraic
  closure of `K`, every `σ ∈ Gal(Ω / K(t))` trivial on `k̄` lies in every closed subgroup
  containing the inertia elements at the places `W ⊇ K` with `t ∈ W`
  (`Gal(Ω / k̄(t)) → Gal(Ω / K(t))` is continuous, `continuous_galDown₂`).
* **The orbifold** (`CurvesJacobian.Cusp.ker_piConstC_le₂`): for Galois data `D` with `H = ⊤` and
  `|A| = 2`, every inertia element `σ` at such a place maps to `1` (if `σ ∈ H_L`, then `σ ∈ S`)
  or to an involution of `Δ_C` outside `Π_X` (`σ² ∈ H_L` as `|A| = 2`, so `σ² ∈ S`; `σ ∉ H_L`
  means that its image is not in `ι(H_L ⧸ ⟨⟨S⟩⟩)`). Hence `Δ_C` (the image of the elements
  trivial on `k̄`) lies in the closed subgroup generated by these involutions.
* `hemi_hgen`: transport along `equivPi1 : Π_C ≃ₜ* H ⧸ ⟨⟨S⟩⟩`.
-/

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale Polynomial Pi1.Orbifold
open AffOrbicurve Topology Belyi

universe u

noncomputable section

namespace CurvesJacobian.Cusp

/-! ### `Π̂_{0,2}` is generated by one cuspidal generator -/

section SurfaceGroup

open Pi1 Pi1.SurfaceGen Pi1.SurfaceGroup ProfiniteGrp.ProfiniteCompletion

/-- The surface relation of `Π_{0,2}`: `c₀ c₁ = 1`. -/
lemma cusp_zero_mul_cusp_one₂ : (cusp 0 : SurfaceGroup 0 2) * cusp 1 = 1 := by
  have h := relation (g := 0) (r := 2)
  simpa [commProd, ordProd, List.ofFn_succ] using h

/-- **`Π̂_{0,2}` is topologically generated by each cuspidal generator**: a closed subgroup
containing `c_j` is everything. -/
theorem eq_top_of_etaFn_cusp_mem₂ (j : Fin 2) (N : Subgroup (ProfiniteSurfaceGroup 0 2))
    (hN : IsClosed (N : Set (ProfiniteSurfaceGroup 0 2)))
    (hj : etaFn (GrpCat.of (SurfaceGroup 0 2)) (cusp j) ∈ N) : N = ⊤ := by
  let η : SurfaceGroup 0 2 →* ProfiniteSurfaceGroup 0 2 := (eta (GrpCat.of (SurfaceGroup 0 2))).hom
  have hj' : cusp j ∈ N.comap η := hj
  have h01 := cusp_zero_mul_cusp_one₂
  have h0 : cusp 0 = (cusp 1 : SurfaceGroup 0 2)⁻¹ := eq_inv_of_mul_eq_one_left h01
  have h1 : cusp 1 = (cusp 0 : SurfaceGroup 0 2)⁻¹ := eq_inv_of_mul_eq_one_right h01
  have key : cusp 0 ∈ N.comap η ∧ cusp 1 ∈ N.comap η := by
    fin_cases j
    · exact ⟨hj', by rw [h1]; exact inv_mem hj'⟩
    · exact ⟨by rw [h0]; exact inv_mem hj', hj'⟩
  have htop : N.comap η = ⊤ := by
    rw [eq_top_iff, ← PresentedGroup.closure_range_of, Subgroup.closure_le]
    rintro _ ⟨s, rfl⟩
    cases s with
    | a i => exact i.elim0
    | b i => exact i.elim0
    | c i =>
      fin_cases i
      · exact key.1
      · exact key.2
  have hsub : Set.range (etaFn (GrpCat.of (SurfaceGroup 0 2))) ⊆ N := by
    rintro _ ⟨x, rfl⟩
    have hx : x ∈ N.comap η := htop ▸ Subgroup.mem_top x
    exact hx
  rw [eq_top_iff]
  intro z _
  have hz : z ∈ closure (Set.range (etaFn (GrpCat.of (SurfaceGroup 0 2)))) :=
    (denseRange (GrpCat.of (SurfaceGroup 0 2))).closure_range ▸ Set.mem_univ z
  exact hN.closure_subset_iff.2 hsub hz

end SurfaceGroup

/-! ### The Galois data of the affine line -/

section Line

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}

/-- **The Galois data of the affine line** `𝔸¹ = Spec k[t]`: `H = H_L = Gal(Ω / k(t))`. -/
def lineData₂ (ht : Transcendental k t) : GaloisData k t where
  H := ⊤
  HL := ⊤
  le := le_rfl
  isOpen_HL := by
    rw [Subgroup.coe_top]
    exact isOpen_univ
  conj_mem := fun _ _ _ _ => Subgroup.mem_top _
  transcendental := ht

lemma lineToΩS_injective₂ (S : Finset k) (ht : Transcendental k t) :
    Function.Injective (lineToΩS S ht) :=
  (algebraMap (K₀ k t) Ω).injective.comp (lineToK₀S_injective S ht)

variable [IsGalois (K₀ k t) Ω]

open IntermediateField.algebraAdjoinAdjoin in
/-- **The coordinate ring of `lineData₂` is `k[t]`**: its elements are polynomials in `t`, hence
lie in `k[t, 1/P_S(t)]`. -/
lemma exists_lineToΩS_eq₂ (ht : Transcendental k t) (S : Finset k) (r : (lineData₂ ht).R) :
    ∃ y : lineRingS S, lineToΩS S ht y = algebraMap (lineData₂ ht).R Ω r := by
  have hL : (lineData₂ ht).L = ⊥ := by
    change IntermediateField.fixedField (⊤ : Subgroup (Ω ≃ₐ[K₀ k t] Ω)) = ⊥
    rw [← IntermediateField.fixingSubgroup_bot]
    exact InfiniteGalois.fixedField_fixingSubgroup ⊥
  have hmem : algebraMap (lineData₂ ht).R Ω r ∈ (⊥ : IntermediateField (K₀ k t) Ω) :=
    hL ▸ CoordRing.algebraMap_mem r
  obtain ⟨y, hy⟩ := IntermediateField.mem_bot.1 hmem
  have hint : IsIntegral (A₀ k t) (algebraMap (K₀ k t) Ω y) :=
    hy ▸ CoordRing.isIntegral_algebraMap r
  have hint' : IsIntegral (A₀ k t) y :=
    (isIntegral_algHom_iff (IsScalarTower.toAlgHom (A₀ k t) (K₀ k t) Ω)
      (algebraMap (K₀ k t) Ω).injective).1 hint
  haveI := AffOrbicurve.isDedekindDomain_A₀ ht
  obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.1 hint'
  have ha2 : (a : Ω) ∈ (aeval t : k[X] →ₐ[k] Ω).range := by
    have h : (a : Ω) ∈ Algebra.adjoin k {t} := a.2
    rwa [Algebra.adjoin_singleton_eq_range_aeval] at h
  obtain ⟨p, hp⟩ := (AlgHom.mem_range _).1 ha2
  have h3 : algebraMap (K₀ k t) Ω (algebraMap (A₀ k t) (K₀ k t) a) = (a : Ω) := rfl
  rw [ha, hy] at h3
  exact ⟨algebraMap k[X] (lineRingS S) p, (lineToΩS_algebraMap S ht p).trans (hp.trans h3.symm)⟩

lemma lineToΩS_mem_range₂ (ht : Transcendental k t) (S : Finset k) (r : (lineData₂ ht).R) :
    algebraMap (lineData₂ ht).R Ω r ∈ (lineToΩS S ht).range := by
  obtain ⟨y, hy⟩ := exists_lineToΩS_eq₂ ht S r
  exact (AlgHom.mem_range _).2 ⟨y, hy⟩

/-- **`k[t] → k[t, 1/P_S(t)]`** on the coordinate ring of `lineData₂` (the scheme map
`𝔸¹ ∖ S → 𝔸¹`). -/
def lineDataToS₂ (ht : Transcendental k t) (S : Finset k) :
    (lineData₂ ht).R →+* lineRingS S :=
  ((AlgEquiv.ofInjective (lineToΩS S ht)
      (lineToΩS_injective₂ S ht)).symm.toRingEquiv.toRingHom).comp
    ((algebraMap (lineData₂ ht).R Ω).codRestrict (lineToΩS S ht).range
      (lineToΩS_mem_range₂ ht S))

lemma lineToΩS_lineDataToS₂ (ht : Transcendental k t) (S : Finset k) (r : (lineData₂ ht).R) :
    lineToΩS S ht (lineDataToS₂ ht S r) = algebraMap (lineData₂ ht).R Ω r := by
  have h2 := AlgEquiv.ofInjective_apply (lineToΩS S ht) (lineToΩS_injective₂ S ht)
    (lineDataToS₂ ht S r)
  have h3 : AlgEquiv.ofInjective (lineToΩS S ht) (lineToΩS_injective₂ S ht)
      (lineDataToS₂ ht S r) = (algebraMap (lineData₂ ht).R Ω).codRestrict
        (lineToΩS S ht).range (lineToΩS_mem_range₂ ht S) r :=
    (AlgEquiv.ofInjective (lineToΩS S ht) (lineToΩS_injective₂ S ht)).apply_symm_apply
      ((algebraMap (lineData₂ ht).R Ω).codRestrict (lineToΩS S ht).range
        (lineToΩS_mem_range₂ ht S) r)
  calc lineToΩS S ht (lineDataToS₂ ht S r)
      = ((AlgEquiv.ofInjective (lineToΩS S ht) (lineToΩS_injective₂ S ht)
          (lineDataToS₂ ht S r) : (lineToΩS S ht).range) : Ω) := h2.symm
    _ = (((algebraMap (lineData₂ ht).R Ω).codRestrict (lineToΩS S ht).range
          (lineToΩS_mem_range₂ ht S) r : (lineToΩS S ht).range) : Ω) := congrArg Subtype.val h3
    _ = algebraMap (lineData₂ ht).R Ω r := rfl

lemma lineGenS_comp₂ (ht : Transcendental k t) (S : Finset k) :
    lineGenS S ht ≫ Spec.map (CommRingCat.ofHom (lineDataToS₂ ht S)) =
      specPoint (lineData₂ ht).R Ω := by
  rw [lineGenS_eq, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  exact congrArg (fun φ => Spec.map (CommRingCat.ofHom φ))
    (RingHom.ext fun r => lineToΩS_lineDataToS₂ ht S r)

variable [IsSepClosed Ω]

/-- **`π₁ᵉᵗ(𝔸¹ ∖ S) → π₁ᵉᵗ(Spec R)` intertwines the Galois actions.** -/
theorem fundamentalGroupMap_lineGaloisS₂ (ht : Transcendental k t) (S : Finset k)
    (σ : Ω ≃ₐ[K₀ k t] Ω) :
    fundamentalGroupMap (Spec.map (CommRingCat.ofHom (lineDataToS₂ ht S))) (lineGenS_comp₂ ht S)
        (lineGaloisS S ht σ) =
      (lineData₂ ht).galoisHom le_rfl ⟨σ, Subgroup.mem_top σ⟩ := by
  have h := fundamentalGroupMap_galoisAction (K₀ k t)
    (Spec.map (CommRingCat.ofHom (lineToK₀S S ht).toRingHom))
    (Spec.map (CommRingCat.ofHom (lineDataToS₂ ht S))) (p := lineGenS S ht) rfl
    (lineGenS_comp₂ ht S) (by rw [← Category.assoc]; exact lineGenS_comp₂ ht S) σ
  refine h.trans ?_
  rw [GaloisData.galoisHom_apply, GaloisData.galoisHomL_eq]
  exact galoisAction_eq_of_apply_eq (K₀ k t) _ _ _ _ _ _ fun _ => rfl

variable [IsAlgClosed k] [CharZero k]

/-- **The Galois action on `π₁ᵉᵗ(𝔸¹)` is trivial** (`π₁ᵉᵗ(𝔸¹_k) = 1`). -/
theorem galoisHom_lineData_eq_one₂ (ht : Transcendental k t) (σ : (lineData₂ ht).H) :
    (lineData₂ ht).galoisHom le_rfl σ = 1 := by
  classical
  have hS : ({0} : Finset k).card = 0 + 1 := Finset.card_singleton 0
  obtain ⟨σc, Θ, hΘ⟩ := exists_continuousMulEquiv_lineInertiaS ({0} : Finset k) hS ht
  obtain ⟨W, hWk, hWv⟩ := exists_valuationSubring_sub_lt_one ht (0 : k)
  have hc0 : (0 : k) ∈ ({0} : Finset k) := Finset.mem_singleton_self 0
  obtain ⟨τ, hτ⟩ := hΘ (some ⟨0, hc0⟩) W hWk hWv
  obtain ⟨φ, hφ⟩ : ∃ φ, φ = fundamentalGroupMap
      (Spec.map (CommRingCat.ofHom (lineDataToS₂ ht {0}))) (lineGenS_comp₂ ht {0}) := ⟨_, rfl⟩
  have htW : t ∈ W := by
    have h1 : t - algebraMap k Ω 0 ∈ W := (W.valuation_le_one_iff _).1 hWv.le
    simpa using h1
  have hS0 : ∀ ρ ∈ GaloisPi1.inertia (P := K₀ k t) W, φ (lineGaloisS {0} ht ρ) = 1 := by
    intro ρ hρ
    rw [hφ, fundamentalGroupMap_lineGaloisS₂, ← MonoidHom.mem_ker, GaloisData.ker_galoisHom]
    exact (lineData₂ ht).mem_kernel_of_mem_S _ ⟨Subgroup.mem_top ρ, W, hWk, htW, hρ⟩
  have hI : lineInertiaS {0} ht W ≤ φ.toMonoidHom.ker := by
    refine Subgroup.topologicalClosure_minimal _ ?_ ?_
    · rw [Subgroup.closure_le]
      rintro _ ⟨ρ, hρ, rfl⟩
      exact hS0 ρ hρ
    · rw [MonoidHom.coe_ker]
      exact isClosed_singleton.preimage φ.continuous
  let N : Subgroup (Pi1.ProfiniteSurfaceGroup 0 (0 + 2)) :=
    (φ.toMonoidHom.comp Θ.symm.toMulEquiv.toMonoidHom).ker
  have hNc : IsClosed (N : Set (Pi1.ProfiniteSurfaceGroup 0 (0 + 2))) := by
    rw [MonoidHom.coe_ker]
    exact isClosed_singleton.preimage (φ.continuous.comp Θ.symm.continuous)
  have hmemI : ProfiniteGrp.ProfiniteCompletion.etaFn
      (GrpCat.of (Pi1.SurfaceGroup 0 (0 + 2)))
        (Pi1.SurfaceGroup.cusp (cuspIndex σc (some ⟨0, hc0⟩))) ∈
        Pi1.SurfaceGroup.inertia (g := 0) (cuspIndex σc (some ⟨0, hc0⟩)) :=
    Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers _)
  rw [← hτ] at hmemI
  obtain ⟨y, hy, hyeq⟩ := hmemI
  have hjN : ProfiniteGrp.ProfiniteCompletion.etaFn
      (GrpCat.of (Pi1.SurfaceGroup 0 (0 + 2)))
        (Pi1.SurfaceGroup.cusp (cuspIndex σc (some ⟨0, hc0⟩))) ∈ N := by
    rw [← hyeq, MonoidHom.mem_ker]
    have hy1 : φ y = 1 := hI hy
    change φ (Θ.symm (Θ (τ * y * τ⁻¹))) = 1
    rw [ContinuousMulEquiv.symm_apply_apply, map_mul, map_mul, hy1, mul_one, map_inv,
      mul_inv_cancel]
  have hN := eq_top_of_etaFn_cusp_mem₂ (cuspIndex σc (some ⟨0, hc0⟩)) N hNc hjN
  have hmem : Θ (lineGaloisS {0} ht σ.1) ∈ N := hN ▸ Subgroup.mem_top _
  have h1 : φ (lineGaloisS {0} ht σ.1) = 1 := by
    have h2 : φ (Θ.symm (Θ (lineGaloisS {0} ht σ.1))) = 1 := hmem
    rwa [ContinuousMulEquiv.symm_apply_apply] at h2
  rw [hφ, fundamentalGroupMap_lineGaloisS₂] at h1
  exact h1

/-- **The affine line is simply connected (Galois form)**: every element of `Gal(Ω / k(t))` lies
in the closed subgroup generated by the conjugates of the inertia elements at the places
`W ⊇ k` with `t ∈ W`. -/
theorem mem_ambientKernel_lineData₂ (ht : Transcendental k t) (σ : Ω ≃ₐ[K₀ k t] Ω) :
    σ ∈ GaloisPi1.ambientKernel (lineData₂ ht).H (lineData₂ ht).S := by
  have h := galoisHom_lineData_eq_one₂ ht ⟨σ, Subgroup.mem_top σ⟩
  rw [← MonoidHom.mem_ker, GaloisData.ker_galoisHom, GaloisPi1.kernel,
    Subgroup.mem_subgroupOf] at h
  exact h

end Line

/-! ### Transfer to a non-closed base field -/

section Transfer

variable {K Ω : Type u} [Field K] [Field Ω] [Algebra K Ω] {t : Ω}

lemma mem_K₀_constField₂ {x : Ω} (hx : x ∈ K₀ K t) : x ∈ K₀ (ConstField₂ K Ω) t := by
  have h : K₀ K t ≤ (K₀ (ConstField₂ K Ω) t).restrictScalars K :=
    IntermediateField.adjoin_le_iff.2 (Set.singleton_subset_iff.2
      (IntermediateField.mem_adjoin_simple_self (ConstField₂ K Ω) t))
  exact h hx

instance charZero_constField₂ [CharZero K] : CharZero (ConstField₂ K Ω) :=
  charZero_of_injective_algebraMap (algebraMap K (ConstField₂ K Ω)).injective

omit [Algebra K Ω] in
/-- `Gal(Ω / F₂) ⊆ Gal(Ω / F₁)` for subfields `F₁ ⊆ F₂` of `Ω` (over possibly different bases). -/
def galRestrictHom₂ {L₁ L₂ : Type*} [Field L₁] [Field L₂] [Algebra L₁ Ω] [Algebra L₂ Ω]
    {F₁ : IntermediateField L₁ Ω} {F₂ : IntermediateField L₂ Ω} (h : ∀ x ∈ F₁, x ∈ F₂) :
    (Ω ≃ₐ[F₂] Ω) →* (Ω ≃ₐ[F₁] Ω) where
  toFun ρ := AlgEquiv.ofRingEquiv (f := ρ.toRingEquiv) fun c => ρ.commutes ⟨c.1, h c.1 c.2⟩
  map_one' := AlgEquiv.ext fun _ => rfl
  map_mul' _ _ := AlgEquiv.ext fun _ => rfl

variable (t) in
/-- `Gal(Ω / k̄(t)) ⊆ Gal(Ω / K(t))`. -/
def galDown₂ : (Ω ≃ₐ[K₀ (ConstField₂ K Ω) t] Ω) →* (Ω ≃ₐ[K₀ K t] Ω) :=
  galRestrictHom₂ fun _ hx => mem_K₀_constField₂ hx

@[simp] lemma galDown₂_apply (ρ : Ω ≃ₐ[K₀ (ConstField₂ K Ω) t] Ω) (x : Ω) :
    galDown₂ t ρ x = ρ x := rfl

variable [CharZero K] [IsAlgClosed Ω] [IsGalois (K₀ K t) Ω]

/-- `Ω` is Galois over `k̄(t)`. -/
theorem isGalois_K₀_constField₂ : IsGalois (K₀ (ConstField₂ K Ω) t) Ω := by
  let φ : K₀ K t →+* K₀ (ConstField₂ K Ω) t :=
    { toFun := fun x => ⟨x.1, mem_K₀_constField₂ x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  haveI : Algebra.IsAlgebraic (K₀ (ConstField₂ K Ω) t) Ω := ⟨fun x => by
    have hx : IsIntegral (K₀ K t) x := Algebra.IsIntegral.isIntegral x
    exact (hx.map_of_comp_eq φ (RingHom.id Ω) (by ext; rfl)).isAlgebraic⟩
  haveI : Normal (K₀ (ConstField₂ K Ω) t) Ω :=
    { toIsAlgebraic := inferInstance
      splits' := fun _ => IsAlgClosed.splits _ }
  haveI : CharZero (K₀ (ConstField₂ K Ω) t) := charZero_of_injective_algebraMap
    (algebraMap (ConstField₂ K Ω) (K₀ (ConstField₂ K Ω) t)).injective
  exact isGalois_iff.2 ⟨Algebra.IsAlgebraic.isSeparable_of_perfectField, inferInstance⟩

variable (t) in
/-- `Gal(Ω / k̄(t)) → Gal(Ω / K(t))` is continuous for the Krull topologies. -/
theorem continuous_galDown₂ : Continuous (galDown₂ (K := K) (Ω := Ω) t) := by
  haveI := isGalois_K₀_constField₂ (K := K) (Ω := Ω) (t := t)
  refine continuous_of_continuousAt_one _ ?_
  rw [ContinuousAt, map_one]
  intro s hs
  obtain ⟨E, hE, hEs⟩ := (krullTopology_mem_nhds_one_iff _ _ s).1 hs
  have hfg : E.toSubalgebra.FG := Subalgebra.fg_of_fg_toSubmodule (Module.Finite.iff_fg.1 hE)
  obtain ⟨T, hTfin, hT⟩ := IntermediateField.fg_def.1 (E.fg_of_fg_toSubalgebra hfg)
  haveI : Finite T := hTfin.to_subtype
  have hint : ∀ x ∈ T, IsIntegral (K₀ (ConstField₂ K Ω) t) x :=
    fun x _ => Algebra.IsIntegral.isIntegral x
  haveI := IntermediateField.finiteDimensional_adjoin hint
  rw [Filter.mem_map, krullTopology_mem_nhds_one_iff]
  refine ⟨IntermediateField.adjoin (K₀ (ConstField₂ K Ω) t) T, inferInstance,
    fun ρ hρ => hEs ?_⟩
  have hρ' : ρ ∈ (IntermediateField.adjoin (K₀ (ConstField₂ K Ω) t) T).fixingSubgroup := hρ
  change galDown₂ t ρ ∈ E.fixingSubgroup
  rw [IntermediateField.mem_fixingSubgroup_iff] at hρ' ⊢
  intro x hx
  rw [← hT] at hx
  exact (IntermediateField.forall_mem_adjoin_smul_eq_self_iff (F := K₀ K t) (S := T)
    (galDown₂ t ρ)).2 (fun y hy => hρ' _ (IntermediateField.subset_adjoin _ _ hy)) x hx

/-- **Elements trivial on the constants are generated by inertia at finite places.** For `K` of
characteristic `0`, `Ω` algebraically closed and Galois over `K(t)` (`t` transcendental) and a
closed subgroup `M ⊆ Gal(Ω / K(t))` containing the inertia elements of all places `W ⊇ K` with
`t ∈ W`, every `σ` acting trivially on the algebraic closure `k̄` of `K` in `Ω` lies in `M`
(`π₁ᵉᵗ(𝔸¹_{k̄}) = 1`). -/
theorem mem_of_galResConst_eq_one₂ (ht : Transcendental K t) (M : Subgroup (Ω ≃ₐ[K₀ K t] Ω))
    (hMc : IsClosed (M : Set (Ω ≃ₐ[K₀ K t] Ω)))
    (hM : ∀ W : ValuationSubring Ω, (∀ c : K, algebraMap K Ω c ∈ W) → t ∈ W →
      ∀ σ ∈ GaloisPi1.inertia (P := K₀ K t) W, σ ∈ M)
    {σ : Ω ≃ₐ[K₀ K t] Ω} (hσ : galResConst t σ = 1) : σ ∈ M := by
  haveI := isGalois_K₀_constField₂ (K := K) (Ω := Ω) (t := t)
  have ht' : Transcendental (ConstField₂ K Ω) t :=
    (Algebra.IsAlgebraic.transcendental_iff K (ConstField₂ K Ω)).1 ht
  have hM₀c : IsClosed ((M.comap (galDown₂ t)) : Set (Ω ≃ₐ[K₀ (ConstField₂ K Ω) t] Ω)) :=
    hMc.preimage (continuous_galDown₂ t)
  have hamb : GaloisPi1.ambientKernel (lineData₂ ht').H (lineData₂ ht').S ≤
      M.comap (galDown₂ t) := by
    refine Subgroup.topologicalClosure_minimal _ ?_ hM₀c
    rw [Subgroup.closure_le]
    rintro _ ⟨h, hh, s, hs, rfl⟩
    obtain ⟨-, W, hWk, htW, hI⟩ := conj_mem_S (lineData₂ ht') hh hs
    change galDown₂ t (h * s * h⁻¹) ∈ M
    refine hM W (fun c => ?_) htW _ (fun a ha => hI a ha)
    rw [IsScalarTower.algebraMap_apply K (ConstField₂ K Ω) Ω]
    exact hWk _
  have hfixk : ∀ c : ConstField₂ K Ω, σ (algebraMap (ConstField₂ K Ω) Ω c) =
      algebraMap (ConstField₂ K Ω) Ω c := fun c => by
    have h := congrArg Subtype.val (DFunLike.congr_fun hσ c)
    rw [galResConst_apply, AlgEquiv.one_apply] at h
    rw [IntermediateField.algebraMap_apply]
    exact h
  let σk : Ω ≃ₐ[ConstField₂ K Ω] Ω := AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) hfixk
  have hfix : ∀ x ∈ K₀ (ConstField₂ K Ω) t, σk • x = x :=
    (IntermediateField.forall_mem_adjoin_smul_eq_self_iff (F := ConstField₂ K Ω) (S := {t})
      σk).2 (by
      intro x hx
      rw [Set.mem_singleton_iff.1 hx]
      exact σ.commutes ⟨t, IntermediateField.mem_adjoin_simple_self K t⟩)
  let σ' : Ω ≃ₐ[K₀ (ConstField₂ K Ω) t] Ω :=
    AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) fun x => hfix x.1 x.2
  have h1 : σ' ∈ M.comap (galDown₂ t) := hamb (mem_ambientKernel_lineData₂ ht' σ')
  have h2 : galDown₂ t σ' = σ := AlgEquiv.ext fun _ => rfl
  rw [← h2]
  exact h1

end Transfer

/-! ### The orbifold: `Δ_C` is generated by involutions outside `Π_X` -/

section Orbifold

variable {K Ω : Type u} [Field K] [CharZero K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω] {t : Ω}
  [IsGalois (K₀ K t) Ω] (D : GaloisData K t)

/-- **`Δ_C` is topologically generated by involutions outside `Π_X`** (Galois model): for Galois
data `D` with `H = Gal(Ω / K(t))` and `|A| = 2`, the kernel of `H ⧸ ⟨⟨S⟩⟩ → Gal(k̄ / K)` lies in
the closed subgroup generated by its involutions not in `ι(H_L ⧸ ⟨⟨S⟩⟩)`. -/
theorem ker_piConstC_le₂ (hH : D.H = ⊤) (hA : Nat.card D.A = 2) :
    (piConstC D).ker ≤ (Subgroup.closure {τ | τ ∈ (piConstC D).ker ∧ τ ^ 2 = 1 ∧
      τ ∉ (orbiIncl D).toMonoidHom.range}).topologicalClosure := by
  set T : Set (GaloisPi1.pi1 D.H D.S D.isClosed_H) := {τ | τ ∈ (piConstC D).ker ∧ τ ^ 2 = 1 ∧
      τ ∉ (orbiIncl D).toMonoidHom.range}
  have hmemH : ∀ x : Ω ≃ₐ[K₀ K t] Ω, x ∈ D.H := fun x => by
    rw [hH]
    exact Subgroup.mem_top x
  let ι : (Ω ≃ₐ[K₀ K t] Ω) →* D.H := MonoidHom.codRestrict (MonoidHom.id _) D.H hmemH
  let f₀ : (Ω ≃ₐ[K₀ K t] Ω) →* GaloisPi1.pi1 D.H D.S D.isClosed_H :=
    (QuotientGroup.mk' (GaloisPi1.kernel D.H D.S)).comp ι
  have hf₀ : ∀ x, f₀ x = (QuotientGroup.mk (ι x) : D.H ⧸ GaloisPi1.kernel D.H D.S) :=
    fun _ => rfl
  have hf₀c : Continuous f₀ :=
    (QuotientGroup.continuous_mk (N := GaloisPi1.kernel D.H D.S)).comp
      (continuous_id.subtype_mk hmemH)
  have hMc : IsClosed (((Subgroup.closure T).topologicalClosure.comap f₀ :
      Subgroup (Ω ≃ₐ[K₀ K t] Ω)) : Set (Ω ≃ₐ[K₀ K t] Ω)) :=
    (Subgroup.isClosed_topologicalClosure _).preimage hf₀c
  have hf₀S : ∀ x, x ∈ D.S → f₀ x = 1 := fun x hx =>
    (QuotientGroup.eq_one_iff (ι x)).2 (D.mem_kernel_of_mem_S (ι x) hx)
  have hM : ∀ W : ValuationSubring Ω, (∀ c : K, algebraMap K Ω c ∈ W) → t ∈ W →
      ∀ σ ∈ GaloisPi1.inertia (P := K₀ K t) W,
        σ ∈ (Subgroup.closure T).topologicalClosure.comap f₀ := by
    intro W hWK htW σ hσ
    by_cases hσL : σ ∈ D.HL
    · rw [Subgroup.mem_comap, hf₀S σ ⟨hσL, W, hWK, htW, hσ⟩]
      exact Subgroup.one_mem _
    · refine Subgroup.mem_comap.2 (Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ?_))
      refine ⟨?_, ?_, ?_⟩
      · rw [MonoidHom.mem_ker]
        exact galResConst_eq_one_of_mem_inertia W hWK hσ
      · have hA2 : ((ι σ : D.A)) ^ 2 = 1 := by
          rw [← hA]
          exact pow_card_eq_one'
        rw [← QuotientGroup.mk_pow] at hA2
        have hσ2L : σ ^ 2 ∈ D.HL := by
          have h := (QuotientGroup.eq_one_iff (N := D.HL.subgroupOf D.H) (ι σ ^ 2)).1 hA2
          exact Subgroup.mem_subgroupOf.1 h
        have hσ2I : σ ^ 2 ∈ GaloisPi1.inertia (P := K₀ K t) W := by
          rw [pow_two]
          exact GaloisPi1.mul_mem_inertia W hσ hσ
        rw [← map_pow]
        exact hf₀S _ ⟨hσ2L, W, hWK, htW, hσ2I⟩
      · rw [← ker_orbiProj, MonoidHom.mem_ker, hf₀, orbiProj_mk]
        intro h
        exact hσL (Subgroup.mem_subgroupOf.1 ((QuotientGroup.eq_one_iff (ι σ)).1 h))
  intro τ hτ
  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective (s := GaloisPi1.kernel D.H D.S) τ
  have hres : galResConst t (h : Ω ≃ₐ[K₀ K t] Ω) = 1 := hτ
  have hmem := mem_of_galResConst_eq_one₂ D.transcendental _ hMc hM hres
  have hmem' : f₀ (h : Ω ≃ₐ[K₀ K t] Ω) ∈ (Subgroup.closure T).topologicalClosure := hmem
  exact hmem'

end Orbifold

/-! ### Transport along `≃ₜ*` -/

section Transport

variable {P Q : Type*} [Group P] [Group Q] [TopologicalSpace P] [TopologicalSpace Q]
  [IsTopologicalGroup P] [IsTopologicalGroup Q]

/-- Topological generation by involutions outside a subgroup is transported along `≃ₜ*`. -/
lemma le_closure_involutions_of_equiv₂ (e : P ≃ₜ* Q) {Δ X : Subgroup P} {ΔQ XQ : Subgroup Q}
    (hΔ : ∀ τ, τ ∈ Δ ↔ e τ ∈ ΔQ) (hX : ∀ τ, τ ∈ X ↔ e τ ∈ XQ)
    (hQ : ΔQ ≤ (Subgroup.closure {τ | τ ∈ ΔQ ∧ τ ^ 2 = 1 ∧ τ ∉ XQ}).topologicalClosure) :
    Δ ≤ (Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X}).topologicalClosure := by
  have hle : (Subgroup.closure {τ | τ ∈ ΔQ ∧ τ ^ 2 = 1 ∧ τ ∉ XQ}).topologicalClosure ≤
      (Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X}).topologicalClosure.comap
        e.symm.toMulEquiv.toMonoidHom := by
    refine Subgroup.topologicalClosure_minimal _ ?_
      ((Subgroup.isClosed_topologicalClosure _).preimage e.symm.continuous)
    rw [Subgroup.closure_le]
    rintro x ⟨hx1, hx2, hx3⟩
    refine Subgroup.mem_comap.2 (Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ?_))
    have hex : e (e.symm x) = x := e.apply_symm_apply x
    refine ⟨?_, ?_, ?_⟩
    · change e.symm x ∈ Δ
      rw [hΔ, hex]
      exact hx1
    · change (e.symm x) ^ 2 = 1
      rw [← map_pow, hx2, map_one]
    · change e.symm x ∉ X
      rw [hX, hex]
      exact hx3
  intro τ hτ
  have h1 := hle (hQ ((hΔ τ).1 hτ))
  have h2 : e.symm (e τ) ∈
      (Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X}).topologicalClosure := h1
  rwa [e.symm_apply_apply] at h2

end Transport

/-! ### The hemi-elliptic orbicurve -/

section Hemi

variable {K : Type u} [Field K] [NumberField K] (E : WeierstrassCurve K) [E.IsElliptic]
  (Ω' : Type u) [Field Ω'] [Algebra K Ω'] [IsAlgClosed Ω'] [Algebra.IsAlgebraic K Ω']
  [CharZero Ω']

lemma mem_ker_hemiPrC_iff₂ (τ : etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E))) :
    τ ∈ (hemiPrC E Ω').toMonoidHom.ker ↔
      (hemiData E).equivPi1 τ ∈ (piConstC (hemiData E)).ker := by
  have h1 : hemiGkEquiv E Ω' (hemiPrC E Ω' τ) =
      piConstC (hemiData E) ((hemiData E).equivPi1 τ) := hemiGkEquiv_hemiPrC E Ω' τ
  have key : hemiPrC E Ω' τ = 1 ↔ piConstC (hemiData E) ((hemiData E).equivPi1 τ) = 1 := by
    rw [← h1]
    exact ⟨fun h => by rw [h, map_one],
      fun h => (hemiGkEquiv E Ω').injective (h.trans (map_one _).symm)⟩
  exact key

lemma mem_range_hemiPiXEmb_iff₂
    (τ : etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E))) :
    τ ∈ (hemiPiXEmb E Ω').toMonoidHom.range ↔
      (hemiData E).equivPi1 τ ∈ (orbiIncl (hemiData E)).toMonoidHom.range := by
  have h1 := SetLike.ext_iff.1 (range_hemiPiXEmb E Ω') τ
  have h2 := SetLike.ext_iff.1 (range_orbiEmb₂ (hemiData E)) τ
  refine h1.trans (h2.trans ⟨?_, fun h => ⟨_, h, (hemiData E).equivPi1.symm_apply_apply τ⟩⟩)
  rintro ⟨y, hy, hyτ⟩
  subst hyτ
  have h3 : (hemiData E).equivPi1 ((hemiData E).equivPi1.symm y) = y :=
    (hemiData E).equivPi1.apply_symm_apply y
  change (hemiData E).equivPi1 ((hemiData E).equivPi1.symm y) ∈ _
  rw [h3]
  exact hy

/-- **Step (D-b) of [AbsTopII] Cor. 3.3 (ii)**: `Δ_C` is topologically generated by the
involutions of `Δ_C` not in `Π_X` (the inertia generators at the points of `E[2] ∖ {O}`). -/
theorem hemi_hgen : (hemiPrC E Ω').toMonoidHom.ker ≤
    (Subgroup.closure {τ | τ ∈ (hemiPrC E Ω').toMonoidHom.ker ∧ τ ^ 2 = 1 ∧
      τ ∉ (hemiPiXEmb E Ω').toMonoidHom.range}).topologicalClosure :=
  le_closure_involutions_of_equiv₂ (hemiData E).equivPi1 (mem_ker_hemiPrC_iff₂ E Ω')
    (mem_range_hemiPiXEmb_iff₂ E Ω') (ker_piConstC_le₂ (hemiData E) rfl (card_hemiA E))

/-- **[AbsTopII] Cor. 3.3 (ii) for the hemi-elliptic orbicurve `C = [(E ∖ {O}) / ±1]`,
unconditional**: an open subgroup `J ⊆ Π_C` of index `2` has torsion-free geometric part
`J ∩ Δ_C` iff `J ∩ Δ_C = Π_X ∩ Δ_C` (`= Δ_X`), i.e. iff `J` is geometrically the semi-elliptic
double cover `X → C` (`hemi_semiElliptic_iff` with `hgen` discharged by `hemi_hgen`). -/
theorem hemi_semiElliptic_iff'
    (J : Subgroup (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E))))
    (hJo : IsOpen (J : Set (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)))))
    (hJ : J.index = 2) :
    IsTorsionFreeSubgroup (J ⊓ (hemiPrC E Ω').toMonoidHom.ker) ↔
      J ⊓ (hemiPrC E Ω').toMonoidHom.ker =
        (hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker :=
  hemi_semiElliptic_iff E Ω' (hemi_hgen E Ω') J hJo hJ

end Hemi

