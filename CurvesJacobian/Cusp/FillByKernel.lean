import CurvesJacobian.Cusp.FillAutExt
import CurvesJacobian.Cusp.FillSeq

/-!
# Filling the cusps determined by a closed normal subgroup

Let `C` be a hyperbolic curve over a number field `K`, `U ⊆ X̄` its open, `Π_U` its arithmetic
fundamental group (`CurvesJacobian.Cusp.arithmeticExt`) and `N ⊆ Π_U` a closed normal subgroup
which is topologically normally generated by the cuspidal inertia groups `I ∈ arithCusps` it
contains, such that some cuspidal inertia group is not contained in `N`.

* **`CurvesJacobian.Cusp.exists_fill_ker_eq`**: there is an open `U' ⊇ U` (with a cusp) such that
  `N` is the kernel of the filling map `Π_U → Π_{U'}` (`fillMap`).

## Proof

Every place `W ⊇ Ω` of `K(X̄_Ω)^alg` has a centre `y ∈ X̄`: `ι⁻¹(W) = 𝒪_{X̄,y}`
(`exists_stalkVS_eq_comap_ffEmb`), and for an open `V ⊇ U` with a cusp, `W` is centred on
`V_Ω` iff `y ∈ V` (`isCentredOn_baseChangeOpen_iff_mem`). Let `S` be the set of points `x ∉ U`
such that the inertia groups of all places centred at `x` lie in `N`, and `U' = U ∪ S` (open,
`X̄ ∖ U` being a finite set of closed points).

* `ker ⊆ N`: the kernel is topologically normally generated by the inertia groups of places
  centred on `U'_Ω` but not on `U_Ω` (`ker_fillMap_eq_map_iUnion`); their centres lie in `S`.
* `N ⊆ ker`: for a cusp `I ⊆ N` with place `W` centred at `x`, all places centred at `x` are
  conjugate under `Gal(K(X̄_Ω)^alg / K(X̄))` (`exists_algEquiv_comap_eq`), so their inertia groups
  are `Π_U`-conjugate to `I` (`map_geomCuspInertia_comap`), hence lie in `N`; so `x ∈ S` and
  `I ⊆ ker` (`geomCuspInertia_map_le_ker`).
* `U'` has a cusp: the centre of a cusp `I ⊄ N` is not in `S`.
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi Belyi.Anabelian
open Pi1.Orbifold AffOrbicurve
open scoped TensorProduct

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section GroupConj

variable {G : Type*} [Group G] {J N : Subgroup G} [hN : N.Normal]

/-- A conjugate of a subgroup of a normal subgroup `N` lies in `N`. -/
lemma map_conj_le_of_le_normal (g : G) (hJ : J ≤ N) : J.map (MulAut.conj g).toMonoidHom ≤ N :=
  Subgroup.map_le_iff_le_comap.2 fun x hx ↦ by
    simpa using hN.conj_mem _ (hJ hx) g

/-- If a conjugate of `J` lies in the normal subgroup `N`, so does `J`. -/
lemma le_normal_of_map_conj_le (g : G) (hJ : J.map (MulAut.conj g).toMonoidHom ≤ N) : J ≤ N :=
  fun x hx ↦ by
    have := hN.conj_mem _ (hJ (Subgroup.mem_map_of_mem _ hx)) g⁻¹
    simpa [mul_assoc] using this

end GroupConj

section Arith

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty)

attribute [local instance] isAlgClosure_of_isAlgebraic

omit [Algebra.IsAlgebraic K Ω] in
/-- **The centre of a place**: a place `W ⊇ Ω` of `K(X̄_Ω)^alg` restricts on `K(X̄)` to the stalk
`𝒪_{X̄,y}` of some point `y`. -/
lemma exists_stalkVS_eq_comap_ffEmb {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W) :
    ∃ y : C.Xbar, stalkVS K y = W.comap (ffEmb Ω C hc) := by
  haveI := isSeparated_of_over K C.Xbar
  have hX := valuationRing_stalk_of_isCurveOver K C.Xbar
  have hKO : ∀ c : K, algebraMap K C.Xbar.functionField c ∈ W.comap (ffEmb Ω C hc) := fun c ↦ by
    rw [ValuationSubring.mem_comap, ffEmb_algebraMap]
    exact hW _
  refine ⟨(pointEquivValuationSubringOver K hX).symm ⟨_, hKO⟩, ?_⟩
  have := congrArg Subtype.val ((pointEquivValuationSubringOver K hX).apply_symm_apply ⟨_, hKO⟩)
  rw [pointEquivValuationSubringOver_apply] at this
  exact this

omit [Algebra.IsAlgebraic K Ω] in
/-- **Centred places and centres**: for an open `V ⊇ U` with a cusp, a place `W ⊇ Ω` centred at
`y` (`ι⁻¹(W) = 𝒪_{X̄,y}`) is centred on `V_Ω` iff `y ∈ V`. -/
lemma isCentredOn_baseChangeOpen_iff_mem (V : C.Xbar.Opens) (hV : C.U ≤ V)
    (hV' : (V : Set C.Xbar)ᶜ.Nonempty) [Nonempty (baseChangeOpen K Ω V)]
    {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W) {y : C.Xbar}
    (hy : stalkVS K y = W.comap (ffEmb Ω C hc)) :
    IsCentredOn (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
      (baseChangeOpen K Ω V) W ↔ y ∈ V := by
  haveI : Nonempty V := (C.nonempty.mono hV).to_subtype
  have key : ∀ a : Γ(C.Xbar, V), secEmb Ω C (isAffineOpen_of_le C hV hV') a ∈ W ↔
      C.Xbar.germToFunctionField V a ∈ stalkVS K y := fun a ↦ by
    rw [hy, ValuationSubring.mem_comap, ffEmb_germ_of_le Ω C hc hV hV']
  rw [isCentredOn_baseChangeOpen_iff Ω C (isAffineOpen_of_le C hV hV')]
  constructor
  · rintro ⟨-, hWa⟩
    exact mem_of_germ_mem C V (C.cusps_finite.subset (Set.compl_subset_compl.2 hV))
      fun a ↦ (key a).1 (hWa a)
  · intro hyV
    exact ⟨hW, fun a ↦ (key a).2
      ⟨C.Xbar.presheaf.germ _ y hyV a, by rw [Scheme.algebraMap_germ_eq_germToFunctionField]⟩⟩

omit [Algebra.IsAlgebraic K Ω] in
/-- A place `W ⊇ Ω` not centred on `U_Ω` is centred at a point outside `U`. -/
lemma not_mem_of_stalkVS_eq_comap_ffEmb {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (hWU : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W) {y : C.Xbar}
    (hy : stalkVS K y = W.comap (ffEmb Ω C hc)) : y ∉ C.U := fun hyU ↦
  hWU ((isCentredOn_baseChangeOpen_iff_mem Ω C hc C.U le_rfl hc hW hy).2 hyU)

/-- **Places centred at the same point have `Π_U`-conjugate inertia groups.** -/
lemma exists_map_geomCuspInertia_eq_conj {W W' : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (hW' : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W')
    (e : W.comap (ffEmb Ω C hc) = W'.comap (ffEmb Ω C hc)) :
    ∃ g, (geomCuspInertia Ω C W').map (geomToPi Ω C hc) =
      ((geomCuspInertia Ω C W).map (geomToPi Ω C hc)).map (MulAut.conj g).toMonoidHom := by
  have e' : W.comap (algebraMap (arithFF Ω C hc) (FFClosure (geomCurve Ω C))) =
      W'.comap (algebraMap (arithFF Ω C hc) (FFClosure (geomCurve Ω C))) := by
    ext ⟨z, w, rfl⟩
    exact SetLike.ext_iff.1 e w
  obtain ⟨τ, rfl⟩ := exists_algEquiv_comap_eq W W' e'
  exact ⟨arithAction Ω C hc τ, map_geomCuspInertia_comap Ω C hc hW τ hW'⟩

/-- **Inertia groups of places centred in `U' ∖ U` lie in the filling kernel.** -/
theorem map_geomCuspInertia_le_ker_fillMap_of_mem {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty) [Nonempty (baseChangeOpen K Ω U')]
    {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (hWU : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W) {y : C.Xbar}
    (hy : stalkVS K y = W.comap (ffEmb Ω C hc)) (hyU' : y ∈ U') :
    (geomCuspInertia Ω C W).map (geomToPi Ω C hc) ≤ (fillMap Ω C hc h).toMonoidHom.ker :=
  geomCuspInertia_map_le_ker Ω C hc h hc'
    ((isCentredOn_baseChangeOpen_iff_mem Ω C hc U' h hc' hW hy).2 hyU') hWU

/-- **A cuspidal inertia group lying over a point of `U'` lies in the filling kernel.** -/
theorem le_ker_fillMap_of_mem {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty) [Nonempty (baseChangeOpen K Ω U')]
    {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (hWU : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W) {y : C.Xbar}
    (hy : stalkVS K y = W.comap (ffEmb Ω C hc)) (hyU' : y ∈ U') (g) :
    ((geomCuspInertia Ω C W).map (geomToPi Ω C hc)).map (MulAut.conj g).toMonoidHom ≤
      (fillMap Ω C hc h).toMonoidHom.ker :=
  map_conj_le_of_le_normal g
    (map_geomCuspInertia_le_ker_fillMap_of_mem Ω C hc h hc' hW hWU hy hyU')

/-- **The filling kernel lies in `N`** if `N` is closed and normal and contains the inertia
groups of all places centred in `U' ∖ U`. -/
theorem ker_fillMap_le_of_forall {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty) [Nonempty (baseChangeOpen K Ω U')]
    (N : Subgroup π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) [N.Normal]
    (hNc : IsClosed (N : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))))
    (hN : ∀ W : ValuationSubring (FFClosure (geomCurve Ω C)),
      (∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W) → ∀ y : C.Xbar,
      stalkVS K y = W.comap (ffEmb Ω C hc) → y ∈ U' → y ∉ C.U →
        (geomCuspInertia Ω C W).map (geomToPi Ω C hc) ≤ N) :
    (fillMap Ω C hc h).toMonoidHom.ker ≤ N := by
  rw [ker_fillMap_eq_map_iUnion Ω C hc h hc', Subgroup.map_le_iff_le_comap]
  apply Subgroup.topologicalClosure_minimal
  · refine Subgroup.normalClosure_le_normal fun s hs ↦ ?_
    obtain ⟨W, ⟨hWV, hWU⟩, hs⟩ := Set.mem_iUnion₂.1 hs
    obtain ⟨y, hy⟩ := exists_stalkVS_eq_comap_ffEmb Ω C hc hWV.1
    exact hN W hWV.1 y hy ((isCentredOn_baseChangeOpen_iff_mem Ω C hc U' h hc' hWV.1 hy).1 hWV)
      (not_mem_of_stalkVS_eq_comap_ffEmb Ω C hc hWV.1 hWU hy) (Subgroup.mem_map_of_mem _ hs)
  · exact hNc.preimage (continuous_geomToPi Ω C hc)

/-- **Filling the cusps determined by a closed normal subgroup.** Let
`N ⊆ Π_U` be the closed normal subgroup topologically normally generated by the cuspidal inertia
groups `I ∈ arithCusps` it contains, and assume some cuspidal inertia group is not contained in
`N`. Then `N` is the kernel of the filling map `Π_U → Π_{U'}` for some open `U' ⊇ U` with a
cusp. -/
theorem exists_fill_ker_eq
    (N : Subgroup π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)))
    (hN : N = (Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω C hc ∧ I ≤ N),
      (I : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))))).topologicalClosure)
    (hne : ∃ I ∈ arithCusps Ω C hc, ¬ I ≤ N) :
    ∃ (U' : C.Xbar.Opens) (h : C.U ≤ U'), (U' : Set C.Xbar)ᶜ.Nonempty ∧
      Nonempty (baseChangeOpen K Ω U') ∧ (fillMap Ω C hc h).toMonoidHom.ker = N := by
  haveI hNn : N.Normal := by
    rw [hN]
    exact Subgroup.is_normal_topologicalClosure _
  have hNc : IsClosed (N : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))) := by
    rw [hN]
    exact Subgroup.isClosed_topologicalClosure _
  -- the points all of whose places have inertia in `N`
  let S : Set C.Xbar := {x | x ∉ C.U ∧ ∀ W : ValuationSubring (FFClosure (geomCurve Ω C)),
    (∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W) →
      stalkVS K x = W.comap (ffEmb Ω C hc) → (geomCuspInertia Ω C W).map (geomToPi Ω C hc) ≤ N}
  have hSo : IsOpen ((C.U : Set C.Xbar) ∪ S) :=
    isOpen_union_of_subset_diff C.U ⊤ le_top (fun x hx ↦ ⟨trivial, hx.1⟩)
      (C.cusps_finite.subset fun _ hx ↦ hx.2)
      fun _ hx ↦ isClosed_singleton_of_not_mem (k := K) C.Xbar C.U C.nonempty hx.2
  let U' : C.Xbar.Opens := ⟨(C.U : Set C.Xbar) ∪ S, hSo⟩
  have h : C.U ≤ U' := fun _ hx ↦ Or.inl hx
  haveI : Nonempty (baseChangeOpen K Ω U') :=
    (nonempty_baseChangeOpen K Ω (C.nonempty.mono h)).to_subtype
  -- a cusp outside `N` gives a cusp of `U'`
  obtain ⟨_, ⟨_, ⟨W₀, hk₀, hW₀U, rfl⟩, g₀, rfl⟩, hIN⟩ := hne
  obtain ⟨y₀, hy₀⟩ := exists_stalkVS_eq_comap_ffEmb Ω C hc hk₀
  have hc' : (U' : Set C.Xbar)ᶜ.Nonempty := by
    refine ⟨y₀, fun hy ↦ ?_⟩
    rcases hy with hy | hy
    · exact not_mem_of_stalkVS_eq_comap_ffEmb Ω C hc hk₀ hW₀U hy₀ hy
    · exact hIN (map_conj_le_of_le_normal g₀ (hy.2 W₀ hk₀ hy₀))
  refine ⟨U', h, hc', inferInstance, le_antisymm ?_ ?_⟩
  · refine ker_fillMap_le_of_forall Ω C hc h hc' N hNc fun W hW y hy hyU' hyU ↦ ?_
    exact (hyU'.resolve_left hyU).2 W hW hy
  · refine hN.le.trans (Subgroup.topologicalClosure_minimal _ ?_ ?_)
    · refine Subgroup.normalClosure_le_normal fun s hs ↦ ?_
      obtain ⟨_, ⟨⟨_, ⟨W, hk, hWU, rfl⟩, g, rfl⟩, hIN⟩, hs⟩ := Set.mem_iUnion₂.1 hs
      have hJN := le_normal_of_map_conj_le g hIN
      obtain ⟨y, hy⟩ := exists_stalkVS_eq_comap_ffEmb Ω C hc hk
      have hyS : y ∈ S := by
        refine ⟨not_mem_of_stalkVS_eq_comap_ffEmb Ω C hc hk hWU hy, fun W' hk' hy' ↦ ?_⟩
        obtain ⟨g', hg'⟩ := exists_map_geomCuspInertia_eq_conj Ω C hc hk hk' (hy.symm.trans hy')
        rw [hg']
        exact map_conj_le_of_le_normal g' hJN
      exact le_ker_fillMap_of_mem Ω C hc h hc' hk hWU hy (Or.inr hyS) g hs
    · exact isClosed_singleton.preimage (fillMap Ω C hc h).continuous

end Arith

end CurvesJacobian.Cusp
