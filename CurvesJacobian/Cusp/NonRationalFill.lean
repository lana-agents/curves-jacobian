import CurvesJacobian.Cusp.ArithmeticFill
import CurvesJacobian.Cusp.PlaceTransitivity

/-!
# Filling in a non-rational cusp on the arithmetic fundamental group (MR8.3)

[AbsTopI] Definition 4.2 (iii)(c) (`Topics in Absolute Anabelian Geometry I.txt` l.3010–3015):
an elementary operation of type `•` is a surjection `Π_j ↠ Π_{j+1}` "such that Ker(φ) is
topologically normally generated by a cuspidal decomposition group". For a hyperbolic curve `C`
over a number field `K` (`Π_U` of `CurvesJacobian.Cusp.arithmeticExt`, `Ω = K̄`) and an open
`U' ⊇ U` (with a cusp) such that `U' ∖ U ⊆ {x}` for a closed point `x ∈ U' ∖ U` — **not
necessarily `K`-rational** —

* **`exists_ker_fillMap_eq_normalClosure`**: the kernel of `fillMap : Π_U → Π_{U'}` is the closed
  normal subgroup generated by a single `I ∈ arithCusps` (generalising
  `exists_ker_fillMap_eq_normalClosure_of_rational`).

## Proof

1. (`ker_fillMap_eq_map_iUnion`) As in `ker_fillMap_eq_map`, but with the general filling formula
   `ker_fundamentalGroupMap_homOfLE_eq_cuspInertia`: the kernel is the image under `geomToPi` of
   the closed normal subgroup of `π₁ᵉᵗ(U_Ω)` generated by the `cuspInertia U_Ω W` for all places
   `W` of `F = K(X̄_Ω)^alg` centred on `U'_Ω` but not on `U_Ω`.
2. (The arithmetic Galois action.) `tensorEmb : Ω ⊗ Γ(U) → L ≅ K(X̄_Ω)` is the ring map of the
   generic point `Spec L ⟶ U_Ω ≅ Spec (Ω ⊗ Γ(U))`; `secEmb a = tensorEmb (1 ⊗ a)` is injective
   and extends to `ffEmb : K(X̄) ↪ F`, with image `arithFF = L₀`. `F` is algebraic over `L₀`
   (`L = K(X̄_Ω)` is generated by `Ω` and `L₀`, `secToTensor` being surjective), so `F/L₀` is
   Galois. `arithAction : Gal(F/L₀) → Π_U` is the Galois action at the generic point
   `Spec L₀ ⟶ Spec Γ(U)` followed by the change of base point `arithFiberIso` induced
   (`fiberIsoMap`) by `basePointIso`. By `galoisAction_eq_of_apply_eq` (the two generic points
   `Spec F ⟶ Spec Γ(U)` agree) and naturality of base point changes, `geomToPi ∘ chartHom` is
   `arithAction ∘ toArithAut` on `H = Gal(F/L)` (`geomToPi_chartHom`).
3. (Inertia.) An inertia element over `L₀` of a place `W ⊇ Ω` fixes `Ω` (it permutes the
   elements algebraic over `ℚ`, which lie in `Ω`, and `σ c - c ∈ Ω ∩ 𝔪_W = 0`), hence fixes `L`
   (`inertia_fixes_L`), so lies in `H`. Thus `geomToPi (cuspInertia W)` is generated by
   `arithAction (inertia_{L₀} W)` (`map_geomCuspInertia`), and conjugating `W` by `τ ∈ Gal(F/L₀)`
   conjugates it by `arithAction τ` (`map_geomCuspInertia_comap`).
4. (Places over `x`.) For `W` centred on `U'_Ω` but not on `U_Ω`, `ffEmb⁻¹(W)` is a valuation ring
   of `K(X̄)` over `K`, i.e. the stalk at a point `y` (`pointEquivValuationSubringOver`); `y ∈ U'`
   (`mem_of_germ_mem`) and `y ∉ U`, so `y = x` (`comap_ffEmb_eq`). Hence all such `W` restrict to
   the same place of `L₀`, are `Gal(F/L₀)`-conjugate (`exists_algEquiv_comap_eq`), and their
   cuspidal inertia groups are `Π_U`-conjugate; the kernel is normally generated by one of them.
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi Belyi.Anabelian
open Pi1.Orbifold AffOrbicurve
open scoped TensorProduct

universe u

noncomputable section

namespace CurvesJacobian.Cusp

/-- If `Ω/K₀` is algebraic and `f : Ω →+* B` agrees with `algebraMap Ω B` on `K₀`, then every
`f c` is algebraic over `Ω` (it is a root of the image of a `K₀`-polynomial killing `c`). -/
lemma isAlgebraic_apply_of_eq_on {K₀ Ω B : Type*} [Field K₀] [Field Ω] [CommRing B]
    [Algebra K₀ Ω] [Algebra Ω B] [Algebra.IsAlgebraic K₀ Ω] (f : Ω →+* B)
    (hf : ∀ a : K₀, f (algebraMap K₀ Ω a) = algebraMap Ω B (algebraMap K₀ Ω a)) (c : Ω) :
    IsAlgebraic Ω (f c) := by
  obtain ⟨p, hp0, hpc⟩ := Algebra.IsAlgebraic.isAlgebraic (R := K₀) c
  refine ⟨p.map (algebraMap K₀ Ω),
    (Polynomial.map_ne_zero_iff (algebraMap K₀ Ω).injective).2 hp0, ?_⟩
  have hcomp : (algebraMap Ω B).comp (algebraMap K₀ Ω) = f.comp (algebraMap K₀ Ω) :=
    RingHom.ext fun a ↦ (hf a).symm
  rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂,
    ← Polynomial.aeval_def, hpc, map_zero]

section Arith

variable {K : Type u} [Field K] [CharZero K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
  (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)

attribute [local instance] isAlgClosure_of_isAlgebraic

include hc' in
/-- **The general filling formula**: the kernel of `Π_U → Π_{U'}` is the image in `Δ_U ⊆ Π_U`
of the closed normal subgroup of `π₁ᵉᵗ(U_Ω)` generated by the cuspidal inertia groups of all
places centred on `U'_Ω` but not on `U_Ω`. -/
theorem ker_fillMap_eq_map_iUnion [Nonempty (baseChangeOpen K Ω U')] :
    (fillMap Ω C hc h).toMonoidHom.ker =
      (Subgroup.normalClosure (⋃ (W : ValuationSubring (FFClosure (geomCurve Ω C)))
        (_ : IsCentredOn (geomData Ω C) (geomCurve Ω C)
          (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W ∧
          ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
            (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W),
          (geomCuspInertia Ω C W : Set _))).topologicalClosure.map
        (geomToPi Ω C hc) := by
  haveI := isIntegral_specSections C hc
  haveI := isIntegral_specTensor Ω C hc
  haveI := isIntegral_specTensor_of_le Ω C h hc'
  have hmono := baseChangeOpen_mono K Ω h
  let β := fundamentalGroupMap (baseChangeSpec K Ω Γ(C.Xbar, C.U)) (rfl : basePoint Ω C hc ≫ _ = _)
  let β' := fundamentalGroupMap (baseChangeSpec K Ω Γ(C.Xbar, U'))
    (rfl : fillPoint Ω C hc h ≫ _ = _)
  let ψ := fundamentalGroupMap (Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom))
    (rfl : basePoint Ω C hc ≫ _ = fillPoint Ω C hc h)
  have hy : (basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom) ≫
      (geomCurve Ω C).homOfLE hmono = fillPoint Ω C hc h ≫ (specTensorIsoBaseChangeOpen K Ω
      (isAffineOpen_of_le C h hc')).hom := by
    rw [Category.assoc, specTensorIso_hom_homOfLE, fillPoint, Category.assoc]
  let ι := fundamentalGroupMap (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom (rfl :
      basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom = _)
  let ι' := fundamentalGroupMap (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_of_le C h hc')).hom
      (rfl : fillPoint Ω C hc h ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_of_le C h
      hc')).hom = _)
  let ψg := fundamentalGroupMap ((geomCurve Ω C).homOfLE hmono) hy
  have E1 : ∀ δ, fillMap Ω C hc h (β δ) = β' (ψ δ) := by
    intro δ
    have c1 := fundamentalGroupMap_comp (baseChangeSpec K Ω Γ(C.Xbar, C.U))
      (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)) (rfl : basePoint Ω C hc ≫ _ = _)
      (fillPoint_spec Ω C hc h) ((Category.assoc _ _ _).symm.trans (fillPoint_spec Ω C hc h))
    have c2 := fundamentalGroupMap_comp
      (Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom))
      (baseChangeSpec K Ω Γ(C.Xbar, U')) (rfl : basePoint Ω C hc ≫ _ = fillPoint Ω C hc h) rfl
      (Category.assoc _ _ _).symm
    have c3 := fundamentalGroupMap_congr (specMap_tensorRes_baseChangeSpec K Ω h).symm
      ((Category.assoc (basePoint Ω C hc) _ _).symm.trans (fillPoint_spec Ω C hc h))
      (Category.assoc (basePoint Ω C hc) _ _).symm
    have := congrArg (fun φ : _ →ₜ* _ ↦ φ δ) (c1.symm.trans (c3.trans c2))
    exact this
  have E2 : ∀ δ, ψg (ι δ) = ι' (ψ δ) := by
    intro δ
    have c1 := fundamentalGroupMap_comp (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C
        hc)).hom ((geomCurve Ω C).homOfLE hmono)
      (rfl : basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom = _)
          hy ((Category.assoc _ _ _).symm.trans hy)
    have c2 := fundamentalGroupMap_comp
      (Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom)) (specTensorIsoBaseChangeOpen K Ω
          (isAffineOpen_of_le C h hc')).hom
      (rfl : basePoint Ω C hc ≫ _ = fillPoint Ω C hc h) rfl (Category.assoc _ _ _).symm
    have c3 := fundamentalGroupMap_congr
      (specTensorIso_hom_homOfLE K Ω (isAffineOpen_U C hc) (isAffineOpen_of_le C h hc') h)
      ((Category.assoc (basePoint Ω C hc) _ _).symm.trans hy) (Category.assoc (basePoint Ω C hc) _
          _).symm
    exact congrArg (fun φ : _ →ₜ* _ ↦ φ δ) (c1.symm.trans (c3.trans c2))
  have E3 := ker_fundamentalGroupMap_eq_map ((geomCurve Ω C).homOfLE hmono)
    (specPoint_genericL_homOfLE (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) hmono) hy (basePointIso Ω C hc)
  have E4 := ker_fundamentalGroupMap_homOfLE_eq_cuspInertia (geomData Ω C) (geomCurve Ω C)
    (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveGaloisData_H_le Ω (transcendental_geomCoord Ω C))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C))
    (curveEquivL_τ Ω (transcendental_geomCoord Ω C))
    (compl_finite_baseChangeOpen K Ω C.nonempty)
    (compl_finite_baseChangeOpen K Ω (C.nonempty.mono h)) hmono
  have hιe : ∀ δ, fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C
      hc)) (basePoint Ω C hc) δ = ι δ := fun _ ↦ rfl
  ext γ
  rw [MonoidHom.mem_ker, Subgroup.mem_map]
  constructor
  · intro hγ
    change fillMap Ω C hc h γ = 1 at hγ
    have hG : γ ∈ (toGaloisGroup (Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, C.U))))
        (basePoint_spec₂ Ω C hc)).ker := by
      rw [← ker_projGk, MonoidHom.mem_ker]
      change projGk Ω C hc γ = 1
      rw [← projGkFill_fillMap Ω C hc h, hγ, map_one]
    obtain ⟨δ, hδ⟩ := (bijective_toKerToGaloisGroup (basePoint Ω C hc) (basePoint_spec₁ Ω C hc)
      (basePoint_spec₂ Ω C hc)).2 ⟨γ, hG⟩
    have hδ' : β δ = γ := congrArg Subtype.val hδ
    have hψ : ψ δ = 1 := fundamentalGroupMap_baseChange_injective (fillPoint Ω C hc h)
      (by rw [← E1, hδ', hγ]; exact (map_one _).symm)
    have hg : ι δ ∈ ψg.toMonoidHom.ker := by
      rw [MonoidHom.mem_ker]
      change ψg (ι δ) = 1
      rw [E2, hψ]
      exact map_one _
    rw [E3, E4] at hg
    obtain ⟨g, hg, hgι⟩ := Subgroup.mem_map.1 hg
    refine ⟨g, hg, ?_⟩
    rw [geomToPi_eq]
    change β ((fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc))
        (basePoint Ω C hc)).symm (basePointEquiv Ω C hc g)) = γ
    have : basePointEquiv Ω C hc g = ι δ := hgι
    rw [this, ← hιe, ContinuousMulEquiv.symm_apply_apply, hδ']
  · rintro ⟨g, hg, rfl⟩
    let δ := (fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc))
        (basePoint Ω C hc)).symm (basePointEquiv Ω C hc g)
    have hιδ : ι δ = basePointEquiv Ω C hc g := by
      rw [← hιe, ContinuousMulEquiv.apply_symm_apply]
    have hker : ι δ ∈ ψg.toMonoidHom.ker := by
      rw [E3, E4]
      exact Subgroup.mem_map.2 ⟨g, hg, hιδ.symm⟩
    have hψ : ψ δ = 1 := by
      refine (fundamentalGroupMap_bijective_of_isIso (specTensorIsoBaseChangeOpen K Ω
          (isAffineOpen_of_le C h hc')).hom rfl).1 ?_
      change ι' (ψ δ) = ι' 1
      rw [← E2, show ι' 1 = 1 from map_one _]
      exact hker
    change fillMap Ω C hc h (geomToPi Ω C hc g) = 1
    rw [geomToPi_eq]
    change fillMap Ω C hc h (β δ) = 1
    rw [E1, hψ]
    exact map_one _

/-! ### The generic point of `V_Ω ≅ Spec (Ω ⊗ Γ(V))` -/

instance isIntegral_hypCurveXbar : IsIntegral C.Xbar := IsCurveOver.isIntegral K C.Xbar

instance nonempty_hypCurveU : Nonempty C.U := C.nonempty.to_subtype

section Theta

variable {V : C.Xbar.Opens} (hV : IsAffineOpen V) [Nonempty (baseChangeOpen K Ω V)]

/-- The generic point `Spec L ⟶ V_Ω`. -/
abbrev genOpen (V : C.Xbar.Opens) [Nonempty (baseChangeOpen K Ω V)] :
    Spec (.of (geomData Ω C).L) ⟶ (baseChangeOpen K Ω V).toScheme :=
  genericL (geomData Ω C) (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
    (baseChangeOpen K Ω V)

/-- `θ_V : Ω ⊗ Γ(X̄, V) → L`, the ring map of the generic point
`Spec L ⟶ V_Ω ≅ Spec (Ω ⊗ Γ(V))`. -/
def tensorEmb : Ω ⊗[K] Γ(C.Xbar, V) →+* (geomData Ω C).L :=
  (Spec.preimage (genOpen Ω C V ≫ (specTensorIsoBaseChangeOpen K Ω hV).inv)).hom

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma specMap_tensorEmb : Spec.map (CommRingCat.ofHom (tensorEmb Ω C hV)) =
    genOpen Ω C V ≫ (specTensorIsoBaseChangeOpen K Ω hV).inv := by
  rw [tensorEmb, CommRingCat.ofHom_hom, Spec.map_preimage]

omit [CharZero K] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω]
  [Nonempty (baseChangeOpen K Ω V)] in
include hV in
lemma isAffineOpen_baseChangeOpen : IsAffineOpen (baseChangeOpen K Ω V) :=
  IsAffine.of_isIso (specTensorIsoBaseChangeOpen K Ω hV).inv

/-- `Γ(X̄_Ω, V_Ω) → Ω ⊗ Γ(X̄, V)`. -/
def secToTensor : Γ(geomCurve Ω C, baseChangeOpen K Ω V) →+* Ω ⊗[K] Γ(C.Xbar, V) :=
  (Spec.preimage ((specTensorIsoBaseChangeOpen K Ω hV).hom ≫
    (isAffineOpen_baseChangeOpen Ω C hV).isoSpec.hom)).hom

omit [CharZero K] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω]
  [Nonempty (baseChangeOpen K Ω V)] in
lemma secToTensor_surjective : Function.Surjective (secToTensor Ω C hV) := by
  intro t
  let e := Spec.preimage ((isAffineOpen_baseChangeOpen Ω C hV).isoSpec.inv ≫
    (specTensorIsoBaseChangeOpen K Ω hV).inv)
  refine ⟨e t, ?_⟩
  have h1 : e ≫ Spec.preimage ((specTensorIsoBaseChangeOpen K Ω hV).hom ≫
      (isAffineOpen_baseChangeOpen Ω C hV).isoSpec.hom) = 𝟙 _ := by
    rw [← Spec.preimage_comp]
    simp
  exact congrArg (fun f ↦ f.hom t) h1

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma tensorEmb_secToTensor (s : Γ(geomCurve Ω C, baseChangeOpen K Ω V)) :
    tensorEmb Ω C hV (secToTensor Ω C hV s) = curveEquivL Ω (transcendental_geomCoord Ω C)
      ((geomCurve Ω C).germToFunctionField (baseChangeOpen K Ω V) s) := by
  have hVΩ := isAffineOpen_baseChangeOpen Ω C hV
  have key : CommRingCat.ofHom ((tensorEmb Ω C hV).comp (secToTensor Ω C hV)) =
      (geomCurve Ω C).germToFunctionField (baseChangeOpen K Ω V) ≫
        CommRingCat.ofHom (curveEquivL Ω (transcendental_geomCoord Ω C)).toRingHom := by
    apply Spec.map_injective
    rw [CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp, specMap_tensorEmb, secToTensor,
      CommRingCat.ofHom_hom, Spec.map_preimage, Category.assoc, Iso.inv_hom_id_assoc,
      genOpen, genericL]
    have := genericToOpen_homOfLE_isoSpec_hom (le_refl (baseChangeOpen K Ω V)) hVΩ
    rw [Scheme.homOfLE_rfl, Category.id_comp] at this
    rw [Category.assoc, this]
    rfl
  exact congrArg (fun f ↦ f.hom s) key

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma coe_tensorEmb_algebraMap (c : Ω) :
    ((tensorEmb Ω C hV (algebraMap Ω (Ω ⊗[K] Γ(C.Xbar, V)) c) : (geomData Ω C).L) :
      FFClosure (geomCurve Ω C)) = algebraMap Ω (FFClosure (geomCurve Ω C)) c := by
  have e1 : Spec.map (CommRingCat.ofHom (algebraMap Ω (Ω ⊗[K] Γ(C.Xbar, V)))) =
      (specTensorIsoBaseChangeOpen K Ω hV).hom ≫ (baseChangeOpen K Ω V).ι ≫
        pullback.snd (C.Xbar ↘ Spec (.of K)) (specAlgebraMap K Ω) :=
    (specTensorIso_hom_ι_snd K Ω hV).symm
  have e2 := Belyi.specMap_algebraMap_functionField Ω (geomCurve Ω C)
  have key : CommRingCat.ofHom ((tensorEmb Ω C hV).comp (algebraMap Ω (Ω ⊗[K] Γ(C.Xbar, V)))) =
      CommRingCat.ofHom ((curveEquivL Ω (transcendental_geomCoord Ω C)).toRingHom.comp
        (algebraMap Ω (geomCurve Ω C).functionField)) := by
    apply Spec.map_injective
    change Spec.map (CommRingCat.ofHom (algebraMap Ω (Ω ⊗[K] Γ(C.Xbar, V))) ≫
        CommRingCat.ofHom (tensorEmb Ω C hV)) =
      Spec.map (CommRingCat.ofHom (algebraMap Ω (geomCurve Ω C).functionField) ≫
        CommRingCat.ofHom (curveEquivL Ω (transcendental_geomCoord Ω C)).toRingHom)
    rw [Spec.map_comp, Spec.map_comp, specMap_tensorEmb, e1, e2]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [genericL_ι_assoc, genericLX, Category.assoc]
    rfl
  have := congrArg (fun f ↦ ((f.hom c : (geomData Ω C).L) : FFClosure (geomCurve Ω C))) key
  exact this.trans (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C) c)

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma tensorEmb_injective : Function.Injective (tensorEmb Ω C hV) := by
  intro a b hab
  obtain ⟨a, rfl⟩ := secToTensor_surjective Ω C hV a
  obtain ⟨b, rfl⟩ := secToTensor_surjective Ω C hV b
  rw [tensorEmb_secToTensor, tensorEmb_secToTensor] at hab
  rw [Scheme.germToFunctionField_injective _ _ ((curveEquivL Ω _).injective hab)]

/-- `φ_V : Γ(X̄, V) → K(X̄_Ω)^alg`, `a ↦ θ_V(1 ⊗ a)`. -/
def secEmb : Γ(C.Xbar, V) →+* FFClosure (geomCurve Ω C) :=
  (algebraMap (geomData Ω C).L (FFClosure (geomCurve Ω C))).comp ((tensorEmb Ω C hV).comp
    (Algebra.TensorProduct.includeRight : Γ(C.Xbar, V) →ₐ[K] Ω ⊗[K] Γ(C.Xbar, V)).toRingHom)

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma secEmb_apply (a : Γ(C.Xbar, V)) :
    secEmb Ω C hV a = (tensorEmb Ω C hV (1 ⊗ₜ a) : FFClosure (geomCurve Ω C)) := rfl

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma secEmb_injective : Function.Injective (secEmb Ω C hV) :=
  (algebraMap (geomData Ω C).L (FFClosure (geomCurve Ω C))).injective.comp
    ((tensorEmb_injective Ω C hV).comp
      (Algebra.TensorProduct.includeRight_injective (algebraMap K Ω).injective))

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma coe_tensorEmb_tmul (c : Ω) (a : Γ(C.Xbar, V)) :
    (tensorEmb Ω C hV (c ⊗ₜ a) : FFClosure (geomCurve Ω C)) =
      algebraMap Ω (FFClosure (geomCurve Ω C)) c * secEmb Ω C hV a := by
  have : c ⊗ₜ[K] a = algebraMap Ω (Ω ⊗[K] Γ(C.Xbar, V)) c * (1 ⊗ₜ a) := by
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
      one_mul]
    rfl
  rw [this, map_mul, IntermediateField.coe_mul, coe_tensorEmb_algebraMap, secEmb_apply]

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
lemma secEmb_algebraMap (c : K) :
    secEmb Ω C hV (algebraMap K Γ(C.Xbar, V) c) =
      algebraMap Ω (FFClosure (geomCurve Ω C)) (algebraMap K Ω c) := by
  rw [secEmb_apply, ← Algebra.TensorProduct.tmul_one_eq_one_tmul, coe_tensorEmb_tmul, map_one,
    mul_one]

end Theta


/-! ### The function field `K(X̄) ↪ K(X̄_Ω)^alg` and the arithmetic Galois group -/

include hc in
lemma isFractionRing_sections : IsFractionRing Γ(C.Xbar, C.U) C.Xbar.functionField :=
  functionField_isFractionRing_of_isAffineOpen C.Xbar C.U (isAffineOpen_U C hc)

/-- `ι : K(X̄) → K(X̄_Ω)^alg`, extending `φ_U` from `Γ(X̄, U)` to its fraction field. -/
def ffEmb : C.Xbar.functionField →+* FFClosure (geomCurve Ω C) :=
  haveI := isFractionRing_sections C hc
  IsFractionRing.lift (secEmb_injective Ω C (isAffineOpen_U C hc))

omit [Algebra.IsAlgebraic K Ω] in
lemma ffEmb_germ (a : Γ(C.Xbar, C.U)) :
    ffEmb Ω C hc (C.Xbar.germToFunctionField C.U a) = secEmb Ω C (isAffineOpen_U C hc) a := by
  haveI := isFractionRing_sections C hc
  exact IsFractionRing.lift_algebraMap _ a

/-- `L₀ = ι(K(X̄)) ⊆ K(X̄_Ω)^alg`, the function field of `X̄` inside `K(X̄_Ω)^alg`. -/
abbrev arithFF : Subfield (FFClosure (geomCurve Ω C)) := (ffEmb Ω C hc).fieldRange

omit [Algebra.IsAlgebraic K Ω] in
lemma secEmb_mem_arithFF (a : Γ(C.Xbar, C.U)) :
    secEmb Ω C (isAffineOpen_U C hc) a ∈ arithFF Ω C hc :=
  ⟨_, ffEmb_germ Ω C hc a⟩

omit [Algebra.IsAlgebraic K Ω] in
lemma arithFF_le : arithFF Ω C hc ≤ (geomData Ω C).L.toSubfield := by
  haveI := isFractionRing_sections C hc
  rintro _ ⟨z, rfl⟩
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := Γ(C.Xbar, C.U)) z
  rw [map_div₀]
  refine div_mem ?_ ?_
  · change ffEmb Ω C hc (C.Xbar.germToFunctionField C.U a) ∈ _
    rw [ffEmb_germ, secEmb_apply]
    exact SetLike.coe_mem _
  · change ffEmb Ω C hc (C.Xbar.germToFunctionField C.U b) ∈ _
    rw [ffEmb_germ, secEmb_apply]
    exact SetLike.coe_mem _

omit [Algebra.IsAlgebraic K Ω] in
lemma ffEmb_algebraMap (c : K) :
    ffEmb Ω C hc (algebraMap K C.Xbar.functionField c) =
      algebraMap Ω (FFClosure (geomCurve Ω C)) (algebraMap K Ω c) := by
  rw [algebraMap_functionField_eq_germ K C.Xbar C.U c]
  exact (ffEmb_germ Ω C hc _).trans (secEmb_algebraMap Ω C (isAffineOpen_U C hc) c)

instance charZero_FFClosure : CharZero (FFClosure (geomCurve Ω C)) :=
  charZero_of_injective_algebraMap (algebraMap Ω (FFClosure (geomCurve Ω C))).injective

instance charZero_arithFF : CharZero (arithFF Ω C hc) :=
  (algebraMap (arithFF Ω C hc) (FFClosure (geomCurve Ω C))).charZero

/-- Elements of `Ω` are algebraic over `L₀`. -/
lemma isAlgebraic_algebraMap_Omega (c : Ω) :
    IsAlgebraic (arithFF Ω C hc) (algebraMap Ω (FFClosure (geomCurve Ω C)) c) := by
  obtain ⟨p, hp0, hpc⟩ := Algebra.IsAlgebraic.isAlgebraic (R := K) c
  set φ : K →+* arithFF Ω C hc :=
    (ffEmb Ω C hc).rangeRestrictField.comp (algebraMap K C.Xbar.functionField)
  refine ⟨p.map φ, (Polynomial.map_ne_zero_iff φ.injective).2 hp0, ?_⟩
  have hcomp : (algebraMap (arithFF Ω C hc) (FFClosure (geomCurve Ω C))).comp φ =
      (algebraMap Ω (FFClosure (geomCurve Ω C))).comp (algebraMap K Ω) :=
    RingHom.ext fun a ↦ ffEmb_algebraMap Ω C hc a
  rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂,
    ← Polynomial.aeval_def, hpc, map_zero]

omit [Algebra.IsAlgebraic K Ω] in
/-- A subfield containing `Ω` and `φ_U(Γ(U))` contains `θ_U(Ω ⊗ Γ(U))`. -/
lemma tensorEmb_mem_of_le (S : Subfield (FFClosure (geomCurve Ω C)))
    (hΩ : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ S)
    (hφ : ∀ a, secEmb Ω C (isAffineOpen_U C hc) a ∈ S) (t : Ω ⊗[K] Γ(C.Xbar, C.U)) :
    (tensorEmb Ω C (isAffineOpen_U C hc) t : FFClosure (geomCurve Ω C)) ∈ S := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul c a =>
    rw [coe_tensorEmb_tmul]
    exact mul_mem (hΩ c) (hφ a)
  | add x y hx hy =>
    rw [map_add, IntermediateField.coe_add]
    exact add_mem hx hy

omit [Algebra.IsAlgebraic K Ω] in
/-- A subfield containing `Ω` and `φ_U(Γ(U))` contains `K(X̄_Ω)`. -/
lemma algebraMap_mem_of_le (S : Subfield (FFClosure (geomCurve Ω C)))
    (hΩ : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ S)
    (hφ : ∀ a, secEmb Ω C (isAffineOpen_U C hc) a ∈ S) (z : (geomCurve Ω C).functionField) :
    algebraMap (geomCurve Ω C).functionField (FFClosure (geomCurve Ω C)) z ∈ S := by
  have hU := isAffineOpen_baseChangeOpen Ω C (isAffineOpen_U C hc)
  haveI := functionField_isFractionRing_of_isAffineOpen (geomCurve Ω C) (geomOpen Ω C) hU
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective
    (A := Γ(geomCurve Ω C, geomOpen Ω C)) z
  have key : ∀ s : Γ(geomCurve Ω C, geomOpen Ω C),
      algebraMap (geomCurve Ω C).functionField (FFClosure (geomCurve Ω C))
        ((geomCurve Ω C).germToFunctionField (geomOpen Ω C) s) ∈ S := fun s ↦ by
    rw [← curveEquivL_apply Ω (transcendental_geomCoord Ω C), ← tensorEmb_secToTensor]
    exact tensorEmb_mem_of_le Ω C hc S hΩ hφ _
  rw [map_div₀]
  exact div_mem (key a) (key b)

/-- **`K(X̄_Ω)^alg` is algebraic over `L₀ = K(X̄)`.** -/
instance isAlgebraic_arithFF :
    Algebra.IsAlgebraic (arithFF Ω C hc) (FFClosure (geomCurve Ω C)) := by
  let M := algebraicClosure (arithFF Ω C hc) (FFClosure (geomCurve Ω C))
  have hM : ∀ z : (geomCurve Ω C).functionField,
      algebraMap (geomCurve Ω C).functionField (FFClosure (geomCurve Ω C)) z ∈ M.toSubfield :=
    algebraMap_mem_of_le Ω C hc M.toSubfield
      (fun c ↦ mem_algebraicClosure_iff.2 (isAlgebraic_algebraMap_Omega Ω C hc c))
      (fun a ↦ mem_algebraicClosure_iff.2
        (_root_.isAlgebraic_algebraMap (⟨_, secEmb_mem_arithFF Ω C hc a⟩ : arithFF Ω C hc)))
  refine ⟨fun z ↦ ?_⟩
  obtain ⟨p, hp0, hp⟩ := Algebra.IsAlgebraic.isAlgebraic
    (R := (geomCurve Ω C).functionField) z
  let g : (geomCurve Ω C).functionField →+* M :=
    (algebraMap (geomCurve Ω C).functionField (FFClosure (geomCurve Ω C))).codRestrict
      M.toSubfield hM
  have hzM : IsAlgebraic M z := by
    refine ⟨p.map g, (Polynomial.map_ne_zero_iff g.injective).2 hp0, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    exact hp
  exact hzM.restrictScalars (arithFF Ω C hc)

instance isGalois_arithFF : IsGalois (arithFF Ω C hc) (FFClosure (geomCurve Ω C)) :=
  haveI : IsAlgClosure (arithFF Ω C hc) (FFClosure (geomCurve Ω C)) :=
    ⟨inferInstance, inferInstance⟩
  inferInstance

/-! ### The arithmetic Galois action `Gal(K(X̄_Ω)^alg / K(X̄)) → Π_U` -/

/-- `U_Ω ≅ Spec (Ω ⊗ Γ(U)) ⟶ Spec Γ(U)`. -/
abbrev geomToSpec : (geomOpen Ω C).toScheme ⟶ Spec (.of Γ(C.Xbar, C.U)) :=
  (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).inv ≫
    baseChangeSpec K Ω Γ(C.Xbar, C.U)

/-- `Γ(U) → L₀`. -/
def secToArithFF : Γ(C.Xbar, C.U) →+* arithFF Ω C hc :=
  (secEmb Ω C (isAffineOpen_U C hc)).codRestrict (arithFF Ω C hc) (secEmb_mem_arithFF Ω C hc)

/-- The generic point `Spec L₀ ⟶ Spec Γ(U)`. -/
abbrev arithGenPt : Spec (.of (arithFF Ω C hc)) ⟶ Spec (.of Γ(C.Xbar, C.U)) :=
  Spec.map (CommRingCat.ofHom (secToArithFF Ω C hc))

omit [Algebra.IsAlgebraic K Ω] in
lemma specMap_algebraMap_arithGenPt :
    Spec.map (CommRingCat.ofHom (algebraMap (arithFF Ω C hc) (FFClosure (geomCurve Ω C)))) ≫
        arithGenPt Ω C hc =
      (specPoint (geomData Ω C).L (FFClosure (geomCurve Ω C)) ≫ genOpen Ω C C.U) ≫
        geomToSpec Ω C hc := by
  have e1 : genOpen Ω C C.U ≫ geomToSpec Ω C hc = Spec.map (CommRingCat.ofHom
      ((tensorEmb Ω C (isAffineOpen_U C hc)).comp (Algebra.TensorProduct.includeRight :
        Γ(C.Xbar, C.U) →ₐ[K] Ω ⊗[K] Γ(C.Xbar, C.U)).toRingHom)) := by
    rw [geomToSpec, ← Category.assoc, ← specMap_tensorEmb, baseChangeSpec, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp]
  rw [Category.assoc, e1, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
    ← CommRingCat.ofHom_comp]
  rfl

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
lemma basePoint_geomToSpec :
    (basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom) ≫
      geomToSpec Ω C hc = basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U) := by
  simp only [geomToSpec, Category.assoc, Iso.hom_inv_id_assoc]

/-- The change of base point on `Spec Γ(U)` induced by `basePointIso`. -/
def arithFiberIso : fiber ((specPoint (geomData Ω C).L (FFClosure (geomCurve Ω C)) ≫
    genOpen Ω C C.U) ≫ geomToSpec Ω C hc) ≅
      fiber (basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) :=
  fiberIsoMap (geomToSpec Ω C hc) rfl (basePoint_geomToSpec Ω C hc) (basePointIso Ω C hc)

/-- **The arithmetic Galois action** `Gal(K(X̄_Ω)^alg / K(X̄)) → Π_U` at the generic point,
moved to the base point of `Π_U`. -/
def arithAction : (FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C)) →*
    π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) :=
  (PreGaloisCategory.autContinuousMulEquivOfIso (arithFiberIso Ω C hc)).toMulEquiv.toMonoidHom.comp
    (galoisAction (arithFF Ω C hc) (arithGenPt Ω C hc) (specMap_algebraMap_arithGenPt Ω C hc))

/-- `geomToPi` is `π₁ᵉᵗ(U_Ω) → π₁ᵉᵗ(Spec Γ(U))` at the generic point, followed by the change of
base point `arithFiberIso`. -/
lemma geomToPi_eq_arithFiberIso (g) :
    geomToPi Ω C hc g = PreGaloisCategory.autContinuousMulEquivOfIso (arithFiberIso Ω C hc)
      (fundamentalGroupMap (geomToSpec Ω C hc) rfl g) := by
  rw [geomToPi_eq, arithFiberIso, ← fundamentalGroupMap_autContinuousMulEquivOfIso]
  change _ = fundamentalGroupMap (geomToSpec Ω C hc) (basePoint_geomToSpec Ω C hc)
    (basePointEquiv Ω C hc g)
  generalize basePointEquiv Ω C hc g = δ'
  obtain ⟨δ, rfl⟩ := (fundamentalGroupEquivOfIso (specTensorIsoBaseChangeOpen K Ω
    (isAffineOpen_U C hc)) (basePoint Ω C hc)).surjective δ'
  rw [ContinuousMulEquiv.symm_apply_apply]
  have h'' : basePoint Ω C hc ≫ (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom ≫
      geomToSpec Ω C hc = basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U) := by
    simp only [geomToSpec, Iso.hom_inv_id_assoc]
  have c1 := fundamentalGroupMap_comp (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom
    (geomToSpec Ω C hc) rfl (basePoint_geomToSpec Ω C hc) h''
  have c2 := fundamentalGroupMap_congr
    (f := (specTensorIsoBaseChangeOpen K Ω (isAffineOpen_U C hc)).hom ≫ geomToSpec Ω C hc)
    (f' := baseChangeSpec K Ω Γ(C.Xbar, C.U)) (by simp only [geomToSpec, Iso.hom_inv_id_assoc])
    h'' rfl
  exact congrArg (fun φ : _ →ₜ* _ ↦ φ δ) (c2.symm.trans c1)

/-- An element of `H = Gal(K(X̄_Ω)^alg / K(X̄_Ω))` as an automorphism over `L₀ = K(X̄)`. -/
def toArithAut (σ : (geomData Ω C).H) :
    FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C) :=
  AlgEquiv.ofRingEquiv (f := (σ : FFClosure (geomCurve Ω C) ≃ₐ[K₀ Ω (coordT (geomCoord Ω C))]
    FFClosure (geomCurve Ω C)).toRingEquiv) fun x ↦
      apply_eq_of_mem_HL (geomData Ω C) (curveGaloisData_H_le Ω _ σ.2) ⟨x, arithFF_le Ω C hc x.2⟩

/-- **Compatibility of the geometric and arithmetic Galois actions**: for `σ ∈ H`, the image in
`Π_U` of `σ ∈ π₁ᵉᵗ(U_Ω)` is `arithAction σ`. -/
lemma geomToPi_chartHom (σ : (geomData Ω C).H) :
    geomToPi Ω C hc ((geomData Ω C).chartHom (curveGaloisData_H_le Ω _) (genOpen Ω C C.U) σ) =
      arithAction Ω C hc (toArithAut Ω C hc σ) := by
  rw [geomToPi_eq_arithFiberIso, GaloisData.chartHom_apply, fundamentalGroupMap_galoisAction
    (geomData Ω C).L (genOpen Ω C C.U) (geomToSpec Ω C hc) rfl rfl (Category.assoc _ _ _).symm]
  change _ = PreGaloisCategory.autContinuousMulEquivOfIso (arithFiberIso Ω C hc)
    (galoisAction (arithFF Ω C hc) (arithGenPt Ω C hc) (specMap_algebraMap_arithGenPt Ω C hc)
      (toArithAut Ω C hc σ))
  refine congrArg (PreGaloisCategory.autContinuousMulEquivOfIso (arithFiberIso Ω C hc)) ?_
  exact galoisAction_eq_of_apply_eq (geomData Ω C).L (genOpen Ω C C.U ≫ geomToSpec Ω C hc)
    (arithGenPt Ω C hc)
    _ (specMap_algebraMap_arithGenPt Ω C hc) _ _ fun _ ↦ rfl

/-! ### Inertia over `K(X̄)` -/

omit [CharZero K] [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
/-- Elements of `K(X̄_Ω)^alg` algebraic over `Ω` lie in `Ω`. -/
lemma exists_algebraMap_eq_of_isAlgebraic_Omega (z : FFClosure (geomCurve Ω C))
    (hz : IsAlgebraic Ω z) : ∃ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c = z := by
  have hint : IsIntegral Ω z := hz.isIntegral
  haveI := IntermediateField.adjoin.finiteDimensional hint
  haveI := Algebra.IsAlgebraic.of_finite Ω (IntermediateField.adjoin Ω {z})
  have hbot := IntermediateField.eq_bot_of_isAlgClosed_of_isAlgebraic
    (IntermediateField.adjoin Ω {z})
  have : z ∈ (⊥ : IntermediateField Ω (FFClosure (geomCurve Ω C))) :=
    hbot ▸ IntermediateField.mem_adjoin_simple_self Ω z
  exact IntermediateField.mem_bot.1 this

omit [CharZero K] [Algebra.IsAlgebraic K Ω] in
/-- Elements of `K(X̄_Ω)^alg` algebraic over `ℚ` lie in `Ω`. -/
lemma exists_algebraMap_eq_of_isAlgebraic (z : FFClosure (geomCurve Ω C))
    (hz : IsAlgebraic ℚ z) : ∃ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c = z :=
  exists_algebraMap_eq_of_isAlgebraic_Omega Ω C z (hz.tower_top Ω)

/-- **Inertia fixes the constants**: an inertia element over `L₀` of a place `W ⊇ Ω` fixes `Ω`
(it maps `Ω` to itself, and `σ c - c ∈ Ω ∩ 𝔪_W = 0`). -/
lemma inertia_fixes_Omega {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    {σ : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C)}
    (hσ : σ ∈ GaloisPi1.inertia W) (c : Ω) :
    σ (algebraMap Ω (FFClosure (geomCurve Ω C)) c) =
      algebraMap Ω (FFClosure (geomCurve Ω C)) c := by
  obtain ⟨c', hc'⟩ := exists_algebraMap_eq_of_isAlgebraic_Omega Ω C
    (σ (algebraMap Ω (FFClosure (geomCurve Ω C)) c))
    (isAlgebraic_apply_of_eq_on (K₀ := K)
      ((σ : FFClosure (geomCurve Ω C) →+* FFClosure (geomCurve Ω C)).comp
        (algebraMap Ω (FFClosure (geomCurve Ω C)))) (fun a ↦ by
          change σ _ = _
          rw [← ffEmb_algebraMap Ω C hc a]
          exact σ.commutes ⟨_, _, rfl⟩) c)
  have hlt := hσ _ (hW c)
  rw [← hc', ← map_sub, valuation_lt_one_iff_mem] at hlt
  by_contra hne
  have hne' : c' - c ≠ 0 := fun h0 ↦ hne (by rw [← hc', sub_eq_zero.1 h0])
  obtain ⟨-, h0 | hinv⟩ := hlt
  · exact hne' ((algebraMap Ω (FFClosure (geomCurve Ω C))).injective (by rw [h0, map_zero]))
  · exact hinv (by rw [← map_inv₀]; exact hW _)

/-- **Inertia over `K(X̄)` is geometric**: an inertia element over `L₀` of a place `W ⊇ Ω` fixes
`L = K(X̄_Ω)`. -/
lemma inertia_fixes_L {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    {σ : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C)}
    (hσ : σ ∈ GaloisPi1.inertia W) (x : (geomData Ω C).L) : σ x = x := by
  let S := (σ : FFClosure (geomCurve Ω C) →+* FFClosure (geomCurve Ω C)).eqLocusField
    (RingHom.id _)
  have := algebraMap_mem_of_le Ω C hc S (fun c ↦ inertia_fixes_Omega Ω C hc hW hσ c)
    (fun a ↦ σ.commutes ⟨_, secEmb_mem_arithFF Ω C hc a⟩)
    ((curveEquivL Ω (transcendental_geomCoord Ω C)).symm x)
  rw [← curveEquivL_apply Ω (transcendental_geomCoord Ω C), RingEquiv.apply_symm_apply] at this
  exact this

/-- An inertia element over `L₀` of a place `W ⊇ Ω`, as an element of `H`. -/
def inertiaToH {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (σ : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C))
    (hσ : σ ∈ GaloisPi1.inertia W) : (geomData Ω C).H :=
  let σ' : FFClosure (geomCurve Ω C) ≃ₐ[K₀ Ω (coordT (geomCoord Ω C))]
      FFClosure (geomCurve Ω C) :=
    AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) fun x ↦
      inertia_fixes_L Ω C hc hW hσ ⟨_, (geomData Ω C).L.algebraMap_mem x⟩
  ⟨σ', (geomData Ω C).le (by
    have hcl : IsClosed ((geomData Ω C).HL : Set (FFClosure (geomCurve Ω C) ≃ₐ[K₀ Ω
      (coordT (geomCoord Ω C))] FFClosure (geomCurve Ω C))) := (geomData Ω C).isClosed_HL
    have h := InfiniteGalois.fixingSubgroup_fixedField (⟨(geomData Ω C).HL, hcl⟩ : ClosedSubgroup _)
    change σ' ∈ (⟨(geomData Ω C).HL, hcl⟩ : ClosedSubgroup _).toSubgroup
    rw [← h, IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact inertia_fixes_L Ω C hc hW hσ ⟨x, hx⟩)⟩

lemma toArithAut_inertiaToH {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (σ : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C))
    (hσ : σ ∈ GaloisPi1.inertia W) : toArithAut Ω C hc (inertiaToH Ω C hc hW σ hσ) = σ :=
  AlgEquiv.ext fun _ ↦ rfl

/-- **The image of a cuspidal inertia group in `Π_U`** is generated by the image of the inertia
group over `K(X̄)` under the arithmetic Galois action. -/
lemma map_geomCuspInertia {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W) :
    (geomCuspInertia Ω C W).map (geomToPi Ω C hc) =
      Subgroup.closure (arithAction Ω C hc ''
        {σ : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C) |
          σ ∈ GaloisPi1.inertia W}) := by
  rw [geomCuspInertia, cuspInertia, MonoidHom.map_closure, Set.image_image]
  congr 1
  ext γ
  constructor
  · rintro ⟨σ, hσ, rfl⟩
    exact ⟨toArithAut Ω C hc σ, hσ, (geomToPi_chartHom Ω C hc σ).symm⟩
  · rintro ⟨τ, hτ, rfl⟩
    refine ⟨inertiaToH Ω C hc hW τ hτ, hτ, ?_⟩
    change geomToPi Ω C hc ((geomData Ω C).chartHom (curveGaloisData_H_le Ω _) (genOpen Ω C C.U)
      (inertiaToH Ω C hc hW τ hτ)) = _
    rw [geomToPi_chartHom, toArithAut_inertiaToH]

/-- **Conjugating places by `Gal(K(X̄_Ω)^alg / K(X̄)) ` conjugates the cuspidal inertia groups in
`Π_U`.** -/
lemma map_geomCuspInertia_comap {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hW : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈ W)
    (τ : FFClosure (geomCurve Ω C) ≃ₐ[arithFF Ω C hc] FFClosure (geomCurve Ω C))
    (hW' : ∀ c : Ω, algebraMap Ω (FFClosure (geomCurve Ω C)) c ∈
      W.comap (τ.symm : FFClosure (geomCurve Ω C) →+* FFClosure (geomCurve Ω C))) :
    (geomCuspInertia Ω C (W.comap (τ.symm : FFClosure (geomCurve Ω C) →+*
        FFClosure (geomCurve Ω C)))).map (geomToPi Ω C hc) =
      ((geomCuspInertia Ω C W).map (geomToPi Ω C hc)).map
        (MulAut.conj (arithAction Ω C hc τ)).toMonoidHom := by
  rw [map_geomCuspInertia Ω C hc hW', map_geomCuspInertia Ω C hc hW, MonoidHom.map_closure,
    Set.image_image]
  congr 1
  ext γ
  constructor
  · rintro ⟨ρ, hρ, rfl⟩
    refine ⟨τ⁻¹ * ρ * τ, (GaloisPi1.mem_inertia_comap_iff τ ρ).1 hρ, ?_⟩
    simp [map_mul, mul_assoc]
  · rintro ⟨ρ, hρ, rfl⟩
    refine ⟨τ * ρ * τ⁻¹, (GaloisPi1.mem_inertia_comap_iff τ _).2 (by simpa [mul_assoc] using hρ),
      ?_⟩
    simp [map_mul]

/-! ### Places over a closed point `x` of `X̄` -/

omit [Algebra.IsAlgebraic K Ω] in
include hc' in
lemma tensorEmb_tensorRes [Nonempty (baseChangeOpen K Ω U')] (t : Ω ⊗[K] Γ(C.Xbar, U')) :
    tensorEmb Ω C (isAffineOpen_U C hc) (tensorRes K Ω h t) =
      tensorEmb Ω C (isAffineOpen_of_le C h hc') t := by
  have hU := isAffineOpen_U C hc
  have hU' := isAffineOpen_of_le C h hc'
  have e : (specTensorIsoBaseChangeOpen K Ω hU).inv ≫
      Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom) =
      (geomCurve Ω C).homOfLE (baseChangeOpen_mono K Ω h) ≫
        (specTensorIsoBaseChangeOpen K Ω hU').inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, specTensorIso_hom_homOfLE K Ω hU hU' h,
      Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have key : CommRingCat.ofHom ((tensorEmb Ω C hU).comp (tensorRes K Ω h).toRingHom) =
      CommRingCat.ofHom (tensorEmb Ω C hU') := by
    apply Spec.map_injective
    change Spec.map (CommRingCat.ofHom (tensorRes K Ω h).toRingHom ≫
      CommRingCat.ofHom (tensorEmb Ω C hU)) = _
    rw [Spec.map_comp, specMap_tensorEmb, specMap_tensorEmb, Category.assoc, e,
      genericL_homOfLE_assoc]
  exact congrArg (fun f ↦ f.hom t) key

omit [Algebra.IsAlgebraic K Ω] in
include hc' in
lemma secEmb_resAlg [Nonempty (baseChangeOpen K Ω U')] (a : Γ(C.Xbar, U')) :
    secEmb Ω C (isAffineOpen_U C hc) (resAlg K h a) =
      secEmb Ω C (isAffineOpen_of_le C h hc') a := by
  rw [secEmb_apply, secEmb_apply, ← tensorEmb_tensorRes Ω C hc h hc']
  rfl

/-- A point `y` of `X̄` with `Γ(V) ⊆ 𝒪_{X̄,y}` (`V` with finite complement) lies in `V`. -/
lemma mem_of_germ_mem (V : C.Xbar.Opens) [Nonempty V] (hV : (V : Set C.Xbar)ᶜ.Finite)
    {y : C.Xbar} (hy : ∀ a : Γ(C.Xbar, V), C.Xbar.germToFunctionField V a ∈ stalkVS K y) :
    y ∈ V := by
  by_cases hne : V = ⊤
  · subst hne
    trivial
  obtain ⟨τ, hτ, hVτ⟩ := exists_chartOne_eq K V hV hne
  subst hVτ
  obtain ⟨a, ha⟩ := (mem_range_germ_chartOne_iff hτ τ).2
    (isIntegral_algebraMap (x := (⟨τ, Algebra.self_mem_adjoin_singleton K τ⟩ :
      Algebra.adjoin K {τ})))
  have h1 := hy a
  rw [ha] at h1
  exact (mem_chartOne_iff K hτ y).2 h1

omit [Algebra.IsAlgebraic K Ω] in
include h hc' in
/-- **A place of `K(X̄_Ω)^alg` over `x` restricts to the stalk `𝒪_{X̄,x}` on `K(X̄)`**: if
`U' ∖ U ⊆ {x}` and `W` is centred on `U'_Ω` but not on `U_Ω`, then `ι⁻¹(W) = 𝒪_{X̄,x}`. -/
lemma comap_ffEmb_eq [Nonempty (baseChangeOpen K Ω U')] {x : C.Xbar}
    (hx : (U' : Set C.Xbar) \ C.U ⊆ {x}) {W : ValuationSubring (FFClosure (geomCurve Ω C))}
    (hWV : IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W)
    (hWU : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W) :
    W.comap (ffEmb Ω C hc) = stalkVS K x := by
  haveI := isSeparated_of_over K C.Xbar
  haveI : Nonempty U' := (C.nonempty.mono h).to_subtype
  have hX := valuationRing_stalk_of_isCurveOver K C.Xbar
  have hKO : ∀ c : K, algebraMap K C.Xbar.functionField c ∈ W.comap (ffEmb Ω C hc) := fun c ↦ by
    rw [ValuationSubring.mem_comap, ffEmb_algebraMap]
    exact hWV.1 _
  let y := (pointEquivValuationSubringOver K hX).symm ⟨_, hKO⟩
  have hy : stalkVS K y = W.comap (ffEmb Ω C hc) := by
    have := congrArg Subtype.val ((pointEquivValuationSubringOver K hX).apply_symm_apply ⟨_, hKO⟩)
    rw [pointEquivValuationSubringOver_apply] at this
    exact this
  have hyU' : y ∈ U' := by
    refine mem_of_germ_mem C U' (C.cusps_finite.subset (Set.compl_subset_compl.2 h)) fun a ↦ ?_
    rw [hy, ValuationSubring.mem_comap]
    have hres : C.Xbar.germToFunctionField C.U (resAlg K h a) =
        C.Xbar.germToFunctionField U' a := germToFunctionField_res (CategoryTheory.homOfLE h) a
    rw [← hres, ffEmb_germ, secEmb_resAlg Ω C hc h hc', secEmb_apply]
    obtain ⟨s, hs⟩ := secToTensor_surjective Ω C (isAffineOpen_of_le C h hc') (1 ⊗ₜ a)
    rw [← hs, tensorEmb_secToTensor]
    exact hWV.2 s
  have hyU : y ∉ C.U := fun hyU ↦ hWU ⟨hWV.1, fun s ↦ by
    have hφ : ∀ a, secEmb Ω C (isAffineOpen_U C hc) a ∈ W := fun a ↦ by
      have : C.Xbar.germToFunctionField C.U a ∈ stalkVS K y :=
        ⟨C.Xbar.presheaf.germ _ y hyU a, by rw [Scheme.algebraMap_germ_eq_germToFunctionField]⟩
      rw [hy, ValuationSubring.mem_comap, ffEmb_germ] at this
      exact this
    have hθ : ∀ t, (tensorEmb Ω C (isAffineOpen_U C hc) t : FFClosure (geomCurve Ω C)) ∈ W := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul c a =>
        rw [coe_tensorEmb_tmul]
        exact mul_mem (hWV.1 c) (hφ a)
      | add x y hx hy =>
        rw [map_add, IntermediateField.coe_add]
        exact add_mem hx hy
    have := hθ (secToTensor Ω C (isAffineOpen_U C hc) s)
    rw [tensorEmb_secToTensor] at this
    exact this⟩
  rw [← hy, Set.mem_singleton_iff.1 (hx ⟨hyU', hyU⟩)]

omit [Algebra.IsAlgebraic K Ω] in
include h hc' in
/-- Two places over `x` have the same restriction to `L₀ = K(X̄)`. -/
lemma comap_arithFF_eq [Nonempty (baseChangeOpen K Ω U')] {x : C.Xbar}
    (hx : (U' : Set C.Xbar) \ C.U ⊆ {x}) {W₁ W₂ : ValuationSubring (FFClosure (geomCurve Ω C))}
    (h₁V : IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W₁)
    (h₁U : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W₁)
    (h₂V : IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W₂)
    (h₂U : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
      (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W₂) :
    W₁.comap (algebraMap (arithFF Ω C hc) (FFClosure (geomCurve Ω C))) =
      W₂.comap (algebraMap (arithFF Ω C hc) (FFClosure (geomCurve Ω C))) := by
  have e := (comap_ffEmb_eq Ω C hc h hc' hx h₁V h₁U).trans
    (comap_ffEmb_eq Ω C hc h hc' hx h₂V h₂U).symm
  ext ⟨z, w, rfl⟩
  exact SetLike.ext_iff.1 e w

include hc' in
/-- **Filling in a cusp** ([AbsTopI] Definition 4.2 (iii), l.3011–3014): if `U ⊆ U'` (both with a
cusp) and `U' ∖ U ⊆ {x}` for a closed point `x ∈ U' ∖ U` (not necessarily `K`-rational), the
kernel of `Π_U → Π_{U'}` is topologically normally generated by a single cuspidal inertia group
`I ∈ arithCusps`. -/
theorem exists_ker_fillMap_eq_normalClosure [Nonempty (baseChangeOpen K Ω U')]
    {x : C.Xbar} (hxU' : x ∈ U') (hxU : x ∉ C.U) (hx : (U' : Set C.Xbar) \ C.U ⊆ {x}) :
    ∃ I ∈ arithCusps Ω C hc, (fillMap Ω C hc h).toMonoidHom.ker =
      (Subgroup.normalClosure (I : Set _)).topologicalClosure := by
  obtain ⟨y, hy⟩ := Scheme.Pullback.exists_preimage_pullback (f := C.Xbar ↘ Spec (.of K))
    (g := specAlgebraMap K Ω) x (Classical.arbitrary _) (Subsingleton.elim _ _)
  have hyU' : y ∈ baseChangeOpen K Ω U' := by
    change (pullback.fst (C.Xbar ↘ Spec (.of K)) (specAlgebraMap K Ω)) y ∈ U'
    rw [hy.1]
    exact hxU'
  have hyU : y ∉ geomOpen Ω C := by
    change (pullback.fst (C.Xbar ↘ Spec (.of K)) (specAlgebraMap K Ω)) y ∉ C.U
    rw [hy.1]
    exact hxU
  obtain ⟨W₀, -, hW₀V, hW₀U⟩ := exists_isCentredOn_not_isCentredOn (geomData Ω C)
    (geomCurve Ω C) (curveEquivL Ω (transcendental_geomCoord Ω C))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω C))
    (compl_finite_baseChangeOpen K Ω C.nonempty) hyU' hyU
  refine ⟨_, mem_arithCusps Ω C hc hW₀V.1 hW₀U, ?_⟩
  have hconj : ∀ W : ValuationSubring (FFClosure (geomCurve Ω C)),
      IsCentredOn (geomData Ω C) (geomCurve Ω C)
        (curveEquivL Ω (transcendental_geomCoord Ω C)) (baseChangeOpen K Ω U') W ∧
      ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
        (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W →
      ∃ g, (geomCuspInertia Ω C W).map (geomToPi Ω C hc) =
        ((geomCuspInertia Ω C W₀).map (geomToPi Ω C hc)).map (MulAut.conj g).toMonoidHom := by
    rintro W ⟨hWV, hWU⟩
    obtain ⟨τ, hτ⟩ := exists_algEquiv_comap_eq W₀ W
      (comap_arithFF_eq Ω C hc h hc' hx hW₀V hW₀U hWV hWU)
    refine ⟨arithAction Ω C hc τ, ?_⟩
    have := map_geomCuspInertia_comap Ω C hc hW₀V.1 τ (hτ ▸ hWV.1)
    rw [← hτ] at this
    exact this
  have E := ker_fillMap_eq_map_iUnion Ω C hc h hc'
  apply le_antisymm
  · rw [E, Subgroup.map_le_iff_le_comap]
    apply Subgroup.topologicalClosure_minimal
    · rw [← Subgroup.map_le_iff_le_comap]
      refine le_trans ?_ (Subgroup.le_topologicalClosure _)
      rw [Subgroup.map_le_iff_le_comap]
      refine Subgroup.normalClosure_le_normal fun s hs ↦ ?_
      obtain ⟨W, hW, hs⟩ := Set.mem_iUnion₂.1 hs
      obtain ⟨g, hg⟩ := hconj W hW
      have hmem : geomToPi Ω C hc s ∈ ((geomCuspInertia Ω C W₀).map (geomToPi Ω C hc)).map
          (MulAut.conj g).toMonoidHom := hg ▸ Subgroup.mem_map_of_mem _ hs
      obtain ⟨t, ht, hts⟩ := Subgroup.mem_map.1 hmem
      refine Subgroup.mem_comap.2 ?_
      rw [← hts]
      exact (Subgroup.normalClosure_normal).conj_mem _ (Subgroup.subset_normalClosure ht) g
    · exact (Subgroup.isClosed_topologicalClosure _).preimage (continuous_geomToPi Ω C hc)
  · apply Subgroup.topologicalClosure_minimal
    · refine Subgroup.normalClosure_le_normal ?_
      rintro _ ⟨s, hs, rfl⟩
      rw [E]
      exact ⟨s, Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure
        (Set.mem_iUnion₂.2 ⟨W₀, ⟨hW₀V, hW₀U⟩, hs⟩)), rfl⟩
    · exact isClosed_singleton.preimage (fillMap Ω C hc h).continuous

end Arith

end CurvesJacobian.Cusp

