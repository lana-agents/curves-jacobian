import CurvesJacobian.Cusp.KaehlerLocal
import CurvesJacobian.Cusp.DifferentialGenus
import CurvesJacobian.Cusp.BaseChange
import CurvesJacobian.Scheme.PointDegree
import CurvesJacobian.Picard.CurveGenus
import Belyi.Anabelian.LocAn

/-!
# `dim H⁰(X, Ω¹) ≤ g` for a curve over a field of characteristic zero

For a curve `X` over a field `k` of characteristic zero (belyi's `IsCurveOver`), the genus
`Belyi.Anabelian.curveGenus k X = dim_k H⁰(X, Ω¹_{X/k})` of [LocAn]'s hyperbolicity condition
(regular differentials of the function field) is at most the genus `CurvesJacobian.curveGenus k X`
of the function field (weil-curves, Riemann–Roch)
(`CurvesJacobian.Cusp.locAn_curveGenus_le`).

At a closed point `x` with place `Q`, the stalk `𝒪_{X,x} ≅ 𝒪_Q` is essentially of finite type
over `k` (a localisation of an affine chart), with maximal ideal generated by a uniformiser `π_Q`
and residue field finite over `k`, so `Ω_{𝒪_{X,x}/k} = 𝒪_{X,x} dπ_Q`
(`CurvesJacobian.Cusp.kaehler_eq_smul_D`). These are the local hypotheses of
`CurvesJacobian.Cusp.finrank_le_genus`.
-/

open CategoryTheory AlgebraicGeometry Belyi WeilCurves.FunctionField IsLocalRing Polynomial
  KaehlerDifferential Module

universe u

noncomputable section

namespace CurvesJacobian.Cusp

variable (k : Type u) [Field k] (X : Scheme.{u}) [X.Over (Spec (.of k))]

/-- The stalk of a locally finite type `k`-scheme is essentially of finite type over `k`. -/
lemma essFiniteType_stalk [LocallyOfFiniteType (X ↘ Spec (.of k))] (x : X) :
    letI := Anabelian.stalkAlgebra k X x
    Algebra.EssFiniteType k (X.presheaf.stalk x) := by
  letI := Anabelian.stalkAlgebra k X x
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : X.Opens) from trivial)
  letI : Algebra k Γ(X, V) := sectionsAlgebra k X V
  haveI : Algebra.FiniteType k Γ(X, V) := finiteType_sections k hV
  letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
  haveI hloc : IsLocalization (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl
      (X.presheaf.stalk x) := hV.isLocalization_stalk ⟨x, hxV⟩
  haveI : Algebra.EssFiniteType Γ(X, V) (X.presheaf.stalk x) :=
    Algebra.EssFiniteType.of_isLocalization (S := X.presheaf.stalk x)
      (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl
  haveI : IsScalarTower k Γ(X, V) (X.presheaf.stalk x) := IsScalarTower.of_algebraMap_eq fun c ↦ by
    change (X.presheaf.germ ⊤ x trivial) ((X ↘ Spec (.of k)).appTop
        ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c)) =
      (X.presheaf.germ V x hxV) ((X ↘ Spec (.of k)).appLE ⊤ V (by simp)
        ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c))
    rw [Scheme.Hom.appLE, CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]
    rfl
  exact Algebra.EssFiniteType.comp k Γ(X, V) (X.presheaf.stalk x)

variable [IsCurveOver k X] [IsIntegral X]

section Place

variable [PerfectField k] (Q : Place k X.functionField)

/-- The stalk at the point of a place is its valuation ring. -/
def stalkPlaceEquiv : X.presheaf.stalk (pointOfPlace k X Q) ≃+* Q.1 :=
  (stalkRingEquiv (valuationRing_stalk_of_isCurveOver k X) _).trans
    (RingEquiv.subringCongr (congrArg ValuationSubring.toSubring (place_val_eq k X Q).symm))

lemma coe_stalkPlaceEquiv (a : X.presheaf.stalk (pointOfPlace k X Q)) :
    (stalkPlaceEquiv k X Q a : X.functionField) =
      algebraMap (X.presheaf.stalk (pointOfPlace k X Q)) X.functionField a :=
  rfl

lemma mem_maximalIdeal_stalk_iff (z : X.presheaf.stalk (pointOfPlace k X Q)) :
    z ∈ maximalIdeal _ ↔ stalkPlaceEquiv k X Q z ∈ maximalIdeal Q.1 := by
  simp only [mem_maximalIdeal, mem_nonunits_iff, MulEquiv.isUnit_map (stalkPlaceEquiv k X Q)]

/-- The preimage in the stalk of an element of `𝒪_Q`. -/
lemma exists_stalk_eq {f : X.functionField} (hf : f ∈ Q.1) :
    ∃ a : X.presheaf.stalk (pointOfPlace k X Q),
      algebraMap (X.presheaf.stalk (pointOfPlace k X Q)) X.functionField a = f :=
  ⟨(stalkPlaceEquiv k X Q).symm ⟨f, hf⟩, by
    rw [← coe_stalkPlaceEquiv, RingEquiv.apply_symm_apply]⟩

/-- A uniformiser at `Q` generates the maximal ideal of the stalk. -/
lemma maximalIdeal_stalk_eq_span {π : X.presheaf.stalk (pointOfPlace k X Q)}
    (hπ : Q.ord (algebraMap _ X.functionField π) = 1) :
    maximalIdeal (X.presheaf.stalk (pointOfPlace k X Q)) = Ideal.span {π} := by
  set ψ := stalkPlaceEquiv k X Q
  have hπ0 : algebraMap _ X.functionField π ≠ 0 := by
    intro h; rw [h, Place.ord_zero] at hπ; omega
  ext z
  rw [mem_maximalIdeal_stalk_iff, Ideal.mem_span_singleton']
  constructor
  · intro hz
    by_cases hz0 : (ψ z : X.functionField) = 0
    · refine ⟨0, ?_⟩
      rw [zero_mul]
      exact ((algebraMap_stalk_injective _).eq_iff.mp (hz0.trans (map_zero _).symm)).symm
    have hord := (Q.ord_pos_iff_mem_maximalIdeal hz0).mpr hz
    set q := (ψ z : X.functionField) / algebraMap _ X.functionField π
    have hq : q ∈ Q.1 := Q.mem_of_ord_nonneg (by
      rw [Q.ord_div hz0 hπ0, hπ]; omega)
    obtain ⟨r, hr⟩ := exists_stalk_eq k X Q hq
    refine ⟨r, algebraMap_stalk_injective _ ?_⟩
    rw [map_mul, hr, div_mul_cancel₀ _ hπ0]
    rfl
  · rintro ⟨r, rfl⟩
    by_cases hr0 : algebraMap _ X.functionField r = 0
    · have : r = 0 := (algebraMap_stalk_injective _).eq_iff.mp (hr0.trans (map_zero _).symm)
      rw [this, zero_mul, map_zero]
      exact Ideal.zero_mem _
    have h0 : (ψ (r * π) : X.functionField) ≠ 0 := by
      rw [coe_stalkPlaceEquiv, map_mul]; exact mul_ne_zero hr0 hπ0
    refine (Q.ord_pos_iff_mem_maximalIdeal h0).mp ?_
    rw [coe_stalkPlaceEquiv, map_mul, Q.ord_mul hr0 hπ0, hπ]
    have := Q.ord_nonneg_of_mem (show algebraMap _ X.functionField r ∈ Q.1 from
      (ψ r).2)
    omega

/-- Every element of the stalk admits `p ∈ k[X]` with `p(u) ∈ 𝔪` and `p'(u)` a unit. -/
lemma exists_aeval_stalk [CharZero k] (u : X.presheaf.stalk (pointOfPlace k X Q)) :
    letI := Anabelian.stalkAlgebra k X (pointOfPlace k X Q)
    ∃ p : k[X], aeval u p ∈ maximalIdeal _ ∧ IsUnit (aeval u (derivative p)) := by
  letI := Anabelian.stalkAlgebra k X (pointOfPlace k X Q)
  haveI := Anabelian.stalkAlgebra_isScalarTower k X (pointOfPlace k X Q)
  set ψ := stalkPlaceEquiv k X Q
  set uF := algebraMap _ X.functionField u
  have huQ : uF ∈ Q.1 := (ψ u).2
  set r := Q.residue ⟨uF, huQ⟩
  have hint : IsIntegral k r := Algebra.IsIntegral.isIntegral r
  set p := minpoly k r
  have hsep : p.Separable := (minpoly.irreducible hint).separable
  have hcomp : Q.1.subtype.comp Q.baseHom = algebraMap k X.functionField := by ext; rfl
  have hcomp' : Q.residue.comp Q.baseHom = algebraMap k Q.ResidueField := by ext; rfl
  -- `ψ (aeval u q) = q(uF)` in `𝒪_Q` and its residue is `q(r)`
  have hψ : ∀ q : k[X], ψ (aeval u q) = q.eval₂ Q.baseHom ⟨uF, huQ⟩ := fun q ↦ by
    apply Subtype.ext
    rw [coe_stalkPlaceEquiv, ← aeval_algebraMap_apply]
    have := Polynomial.hom_eval₂ q Q.baseHom Q.1.subtype ⟨uF, huQ⟩
    rw [hcomp] at this
    rw [aeval_def]
    exact this.symm
  have hres : ∀ q : k[X], Q.residue (ψ (aeval u q)) = aeval r q := fun q ↦ by
    rw [hψ, Polynomial.hom_eval₂, hcomp', ← aeval_def]
  refine ⟨p, ?_, ?_⟩
  · rw [mem_maximalIdeal_stalk_iff, ← Q.residue_eq_zero_iff, hres, minpoly.aeval]
  · have : ψ (aeval u (derivative p)) ∉ maximalIdeal Q.1 := by
      rw [← Q.residue_eq_zero_iff, hres]
      exact hsep.aeval_derivative_ne_zero (minpoly.aeval k r)
    rw [← mem_maximalIdeal_stalk_iff, mem_maximalIdeal, mem_nonunits_iff, not_not] at this
    exact this

end Place

/-- **`dim_k H⁰(X, Ω¹) ≤ g`** for a curve over a field of characteristic zero. -/
theorem locAn_curveGenus_le [CharZero k] :
    (Anabelian.curveGenus k X : ℤ) ≤ curveGenus k X := by
  set F := X.functionField
  choose π hπ using fun Q : Place k F ↦ Q.exists_ord_eq_one
  -- the uniformisers come from the stalks
  have hπQ : ∀ Q : Place k F, π Q ∈ Q.1 := fun Q ↦ Q.mem_of_ord_nonneg (by rw [hπ Q]; omega)
  choose π' hπ' using fun Q : Place k F ↦ exists_stalk_eq k X Q (hπQ Q)
  have hmax : ∀ Q : Place k F, maximalIdeal (X.presheaf.stalk (pointOfPlace k X Q)) =
      Ideal.span {π' Q} := fun Q ↦ maximalIdeal_stalk_eq_span k X Q (by rw [hπ' Q, hπ Q])
  have hfin : ∀ Q : Place k F,
      letI := Anabelian.stalkAlgebra k X (pointOfPlace k X Q)
      Module.Finite (X.presheaf.stalk (pointOfPlace k X Q))
        Ω[X.presheaf.stalk (pointOfPlace k X Q)⁄k] := fun Q ↦ by
    letI := Anabelian.stalkAlgebra k X (pointOfPlace k X Q)
    haveI := essFiniteType_stalk k X (pointOfPlace k X Q)
    infer_instance
  refine finrank_le_genus π hπ (fun Q u hu ↦ ?_) (ell_zero_eq_one k X)
    (Anabelian.globalDifferentials k X) (fun ω hω Q ↦ ?_)
  · letI := Anabelian.stalkAlgebra k X (pointOfPlace k X Q)
    haveI := Anabelian.stalkAlgebra_isScalarTower k X (pointOfPlace k X Q)
    haveI := hfin Q
    obtain ⟨a, rfl⟩ := exists_stalk_eq k X Q hu
    obtain ⟨g, hg⟩ := exists_D_eq_smul_D (exists_aeval_stalk k X Q) (hmax Q) (F := F) a
    refine ⟨algebraMap _ F g, (stalkPlaceEquiv k X Q g).2, ?_⟩
    rw [hg, hπ' Q]
  · letI := Anabelian.stalkAlgebra k X (pointOfPlace k X Q)
    haveI := Anabelian.stalkAlgebra_isScalarTower k X (pointOfPlace k X Q)
    haveI := hfin Q
    have hω' : ω ∈ Anabelian.regularDifferentialsAt k X (pointOfPlace k X Q) :=
      (Submodule.mem_iInf _).mp hω _
    obtain ⟨g, hg⟩ := exists_eq_smul_D_of_mem_range (exists_aeval_stalk k X Q) (hmax Q)
      (F := F) hω'
    refine ⟨algebraMap _ F g, (stalkPlaceEquiv k X Q g).2, ?_⟩
    rw [hg, hπ' Q]

end CurvesJacobian.Cusp
