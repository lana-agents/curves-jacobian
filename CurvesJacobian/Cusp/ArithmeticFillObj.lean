import CurvesJacobian.Cusp.ArithmeticFill
import Belyi.Converse.Normalization
import Belyi.Converse.Pi1InvarianceCurve
import Pi1.FundamentalGroup.DenseOpen
import Pi1.FundamentalGroup.GenericPoint

/-!
# The chain object `Π_{U'}` of a filling `U ⊆ U'` (MR8.3, operations of type `•`)

[AbsTopI] Definition 4.2 (iii)(c) (`Topics in Absolute Anabelian Geometry I.txt` l.3011–3014): an
operation of type `•` is a surjection `Π_j ↠ Π_{j+1}` whose kernel is topologically normally
generated by a cuspidal decomposition group. For a hyperbolic curve `C = (X̄ ⊇ U)` over a number
field `K` and an open `U ⊆ U' ⊆ X̄` such that `(X̄, U')` is again hyperbolic with a cusp, this file
provides the target of such an operation as an object of `Chain(Π_U)`:

* `CurvesJacobian.Cusp.fillMap_surjective`: `Π_U ↠ Π_{U'}` (the normalisation of `Spec Γ(U')` in
  `Spec Γ(U)` is trivial: `Γ(U')` is integrally closed with fraction field `K(X̄)`);
* `CurvesJacobian.Cusp.fillCurve`: the hyperbolic curve `(X̄, U')`;
* `CurvesJacobian.Cusp.isSlim_ker_projGkFill`, `ker_projGkFill_ne_bot`: `Δ_{U'}` (at the base
  point `fillPoint`) is slim and nontrivial — transported from `arithmeticExt` of `fillCurve`
  along an isomorphism of fibre functors
  (`AlgebraicGeometry.FiniteEtale.ker_fundamentalGroupMap_eq_map`);
* `CurvesJacobian.Cusp.fillChainObj`: `Π_{U'}` with rigidifying homomorphism `fillMap`, and
  `fillMap_compat` (compatibility with the trivial chain object).

Together with `exists_ker_fillMap_eq_normalClosure_of_rational` (the kernel of `fillMap` is
topologically normally generated by one arithmetic cusp inertia group) this is all the data of an
`ElemOp.decusp` except the condition `ChainObj.IsCuspidal` (the commensurator of the cusp
inertia group in `Δ_U` is the group itself), which is open.
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi
  Belyi.Anabelian Pi1.Profinite
open scoped TensorProduct

universe u

noncomputable section

namespace CurvesJacobian.Cusp

/-- The restriction of a continuous isomorphism to a subgroup and its image. -/
def continuousMulEquivSubgroupMap {G G' : Type*} [Group G] [TopologicalSpace G] [Group G']
    [TopologicalSpace G'] (e : G ≃ₜ* G') (H : Subgroup G) :
    H ≃ₜ* H.map e.toMulEquiv.toMonoidHom where
  __ := e.toMulEquiv.subgroupMap H
  continuous_toFun := (e.continuous.comp continuous_subtype_val).subtype_mk _
  continuous_invFun := by
    refine continuous_induced_rng.2 ?_
    have : (Subtype.val ∘ (e.toMulEquiv.subgroupMap H).symm) =
        e.symm ∘ (Subtype.val : H.map e.toMulEquiv.toMonoidHom → G') := by
      funext x
      obtain ⟨_, ⟨y, hy, rfl⟩⟩ := x
      have := (e.toMulEquiv.subgroupMap H).symm_apply_apply ⟨y, hy⟩
      change _ = e.symm (e y)
      rw [e.symm_apply_apply]
      exact congrArg Subtype.val this
    exact this ▸ e.symm.continuous.comp continuous_subtype_val

variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
  (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
  (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)

attribute [local instance] isAlgClosure_of_isAlgebraic

omit [NumberField K] in
lemma germ_resAlg [IsIntegral C.Xbar] [Nonempty C.U] [Nonempty U'] (a : Γ(C.Xbar, U')) :
    C.Xbar.germToFunctionField C.U (resAlg K h a) = C.Xbar.germToFunctionField U' a := by
  change C.Xbar.presheaf.germ C.U _ _ ((Scheme.Hom.appLE (𝟙 C.Xbar) U' C.U h) a) =
    C.Xbar.presheaf.germ U' _ _ a
  rw [Scheme.Hom.appLE, CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]
  rfl

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
include hc' in
/-- **`Π_U ↠ Π_{U'}`**: filling in cusps is surjective on arithmetic fundamental groups. -/
theorem fillMap_surjective : Function.Surjective (fillMap Ω C hc h) := by
  haveI := IsCurveOver.isIntegral K C.Xbar
  haveI : Nonempty C.U := C.nonempty.to_subtype
  haveI : Nonempty U' := (C.nonempty.mono h).to_subtype
  have hU' := isAffineOpen_of_le C h hc'
  haveI := isIntegral_specSections C hc
  haveI : IsIntegral (Spec Γ(C.Xbar, U')) := isIntegral_spec_sections hU'
  haveI : IsIntegrallyClosed Γ(C.Xbar, U') := isIntegrallyClosed_of_isAffineOpen hU'
    fun x _ ↦ IsCurveOver.isIntegrallyClosed_stalk K C.Xbar x
  haveI := functionField_isFractionRing_of_isAffineOpen C.Xbar U' hU'
  haveI : IsIso (Spec.map (CommRingCat.ofHom (resAlg K h).toRingHom)).fromNormalization := by
    refine isIso_fromNormalization_specMap _ (fun a b hab ↦ ?_) fun s hs ↦ ?_
    · apply C.Xbar.germToFunctionField_injective U'
      rw [← germ_resAlg C h a, ← germ_resAlg C h b]
      exact congrArg _ hab
    · exact mem_range_of_isIntegralElem_of_isIntegrallyClosed (RingHom.id _)
        (resAlg K h).toRingHom (C.Xbar.germToFunctionField C.U).hom
        (C.Xbar.germToFunctionField_injective C.U) (RingHom.ext fun a ↦ germ_resAlg C h a) hs
  exact fundamentalGroupMap_surjective_of_isIso_fromNormalization _ _

/-- **The hyperbolic curve `(X̄, U')`**, for `U ⊆ U'` with `(X̄, U')` hyperbolic. -/
def fillCurve (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
    2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U') : HypCurve K where
  Xbar := C.Xbar
  U := U'
  nonempty := C.nonempty.mono h
  cusps_finite := C.cusps_finite.subset (Set.compl_subset_compl.2 h)
  hyperbolic := hyp

variable (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
    2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U')

include hc' hyp in
/-- **`Δ_{U'}` is slim** (at the base point `fillPoint`): transported from `Δ` of the arithmetic
extension of `fillCurve` along an isomorphism of fibre functors. -/
theorem isSlim_ker_projGkFill : IsSlim (projGkFill Ω C hc h).toMonoidHom.ker := by
  haveI : IsIntegral (Spec (CommRingCat.of Γ(C.Xbar, U'))) :=
    isIntegral_specSections (fillCurve C h hyp) hc'
  obtain ⟨α⟩ := PreGaloisCategory.nonempty_iso_of_fiberFunctor
    (fiber (basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
    (fiber (fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
  have hker := ker_fundamentalGroupMap_eq_map
    (Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, U'))))
    (basePoint_spec₂ Ω (fillCurve C h hyp) hc') (fillPoint_spec₂ Ω C hc h) α
  change IsSlim (fundamentalGroupMap _ (fillPoint_spec₂ Ω C hc h)).toMonoidHom.ker
  rw [hker]
  exact (arithmeticExt Ω (fillCurve C h hyp) hc').slim_delta.of_continuousMulEquiv
    (continuousMulEquivSubgroupMap _ _)

include hc' hyp in
/-- **`Δ_{U'}` is nontrivial** (at the base point `fillPoint`). -/
theorem ker_projGkFill_ne_bot : (projGkFill Ω C hc h).toMonoidHom.ker ≠ ⊥ := by
  haveI : IsIntegral (Spec (CommRingCat.of Γ(C.Xbar, U'))) :=
    isIntegral_specSections (fillCurve C h hyp) hc'
  obtain ⟨α⟩ := PreGaloisCategory.nonempty_iso_of_fiberFunctor
    (fiber (basePoint Ω (fillCurve C h hyp) hc' ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
    (fiber (fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U')))
  have hker := ker_fundamentalGroupMap_eq_map
    (Spec.map (CommRingCat.ofHom (algebraMap K Γ(C.Xbar, U'))))
    (basePoint_spec₂ Ω (fillCurve C h hyp) hc') (fillPoint_spec₂ Ω C hc h) α
  change (fundamentalGroupMap _ (fillPoint_spec₂ Ω C hc h)).toMonoidHom.ker ≠ ⊥
  rw [hker, Ne, Subgroup.map_eq_bot_iff_of_injective _
    (PreGaloisCategory.autContinuousMulEquivOfIso α).injective]
  exact (arithmeticExt Ω (fillCurve C h hyp) hc').nontrivial_delta

/-- `fillMap` restricted to the open subgroup `⊤` (the rigidifying homomorphism of
`fillChainObj`). -/
def fillRho : ((⊤ : OpenSubgroup (arithmeticExt Ω C hc).Pi) : Subgroup (arithmeticExt Ω C hc).Pi)
    →ₜ* π₁ᵉᵗ(fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U')) :=
  (fillMap Ω C hc h).comp
    ⟨(((⊤ : OpenSubgroup (arithmeticExt Ω C hc).Pi) : Subgroup (arithmeticExt Ω C hc).Pi).subtype :
      _ →* π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))), continuous_subtype_val⟩

include hc' in
lemma isOpen_range_fillRho : IsOpen (Set.range (fillRho Ω C hc h)) := by
  have : Set.range (fillRho Ω C hc h) = Set.univ :=
    Set.eq_univ_of_forall fun y ↦ by
      obtain ⟨x, rfl⟩ := fillMap_surjective Ω C hc h hc' y
      exact ⟨⟨x, trivial⟩, rfl⟩
  rw [this]
  exact isOpen_univ

omit [Algebra.IsAlgebraic K Ω] [CharZero Ω] in
lemma isOpen_range_projGkFill : IsOpen (Set.range (projGkFill Ω C hc h)) := by
  have : Set.range (projGkFill Ω C hc h) = Set.univ :=
    Set.eq_univ_of_forall fun g ↦ by
      obtain ⟨x, rfl⟩ := projGk_surjective Ω C hc g
      exact ⟨fillMap Ω C hc h x, projGkFill_fillMap Ω C hc h x⟩
  rw [this]
  exact isOpen_univ

/-- **The chain object `Π_{U'}`** of a filling `U ⊆ U'` with `(X̄, U')` hyperbolic with a cusp:
`Π_{U'} = π₁ᵉᵗ(Spec Γ(U'), fillPoint)` with rigidifying homomorphism `fillMap : Π_U ↠ Π_{U'}`
(defined on all of `Π_U`) and projection `projGkFill` to `G_K` ([AbsTopI] Definition 4.2 (iii),
conditions (1Π), (2Π)). -/
def fillChainObj : ChainObj (arithmeticExt Ω C hc) where
  grp := ProfiniteGrp.of π₁ᵉᵗ(fillPoint Ω C hc h ≫ baseChangeSpec K Ω Γ(C.Xbar, U'))
  dom := ⊤
  rho := fillRho Ω C hc h
  isOpen_range_rho := isOpen_range_fillRho Ω C hc h hc'
  toG := projGkFill Ω C hc h
  isOpen_range_toG := isOpen_range_projGkFill Ω C hc h
  toG_rho x := by
    change projGkFill Ω C hc h (fillRho Ω C hc h x) = projGk Ω C hc x.1
    exact projGkFill_fillMap Ω C hc h x.1
  slim_delta := isSlim_ker_projGkFill Ω C hc h hc' hyp
  nontrivial_delta := ker_projGkFill_ne_bot Ω C hc h hc' hyp

/-- `fillMap : Π_U → Π_{U'}` is compatible with the rigidifying homomorphisms of the trivial chain
object and of `fillChainObj` (as the operation homomorphism of an operation of type `•`). -/
lemma fillMap_compat :
    ChainObj.Compat (ChainObj.base (arithmeticExt Ω C hc)) (fillChainObj Ω C hc h hc' hyp)
      (fillMap Ω C hc h) :=
  ⟨⊤, le_rfl, le_rfl, fun _ _ ↦ rfl⟩

end CurvesJacobian.Cusp
