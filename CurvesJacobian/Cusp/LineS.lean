import CurvesJacobian.Cusp.PBranch

/-!
# The line `ℙ¹ ∖ (S ∪ {∞})` and its Galois action at the geometric generic point

For a finite set `S ⊆ k`, `U_S = ℙ¹ ∖ (S ∪ {∞}) = Spec k[t, 1/P_S(t)]` with
`P_S = ∏_{a ∈ S} (X - a)` (`CurvesJacobian.Cusp.polyS`, `CurvesJacobian.Cusp.lineRingS`); this
generalises `CurvesJacobian.Cusp.lineRing` (`S = {0, 1}`).

For `Ω` a separably closed Galois extension of `k(t)` (`t ∈ Ω` transcendental), `η : Spec Ω ⟶ U_S`
is the geometric generic point (`CurvesJacobian.Cusp.lineGenS`), `Gal(Ω / k(t))` acts on
`π₁ᵉᵗ(U_S, η)` (`CurvesJacobian.Cusp.lineGaloisS`), and the inertia group of a place `W` in
`π₁ᵉᵗ(U_S, η)` is the closed subgroup generated by the images of the inertia elements
(`CurvesJacobian.Cusp.lineInertiaS`).

The local coordinate at the cusp `c : Option k` is `t - a` for `c = some a` and `1/t` for
`c = none` (the cusp `∞`) (`CurvesJacobian.Cusp.cuspCoordS`).
-/

open CategoryTheory AlgebraicGeometry Polynomial AffOrbicurve

universe u

noncomputable section

namespace CurvesJacobian.Cusp

/-! ### The ring `k[t, 1/P_S(t)]` -/

section Line

variable {k : Type u} [Field k] (S : Finset k)

/-- `P_S = ∏_{a ∈ S} (X - a)`. -/
def polyS : k[X] := ∏ a ∈ S, (X - C a)

lemma polyS_ne_zero : polyS S ≠ 0 :=
  Finset.prod_ne_zero_iff.2 fun a _ ↦ X_sub_C_ne_zero a

lemma aeval_polyS {A : Type*} [CommRing A] [Algebra k A] (x : A) :
    aeval x (polyS S) = ∏ a ∈ S, (x - algebraMap k A a) := by
  simp [polyS, map_prod]

/-- The coordinate ring `k[t, 1/P_S(t)]` of `ℙ¹ ∖ (S ∪ {∞})`. -/
abbrev lineRingS : Type u := Localization.Away (polyS S)

/-- The coordinate `t ∈ k[t, 1/P_S(t)]`. -/
def lineTS : lineRingS S := algebraMap k[X] (lineRingS S) X

instance : Algebra.FiniteType k (lineRingS S) :=
  Algebra.FiniteType.trans (S := k[X]) inferInstance
    (IsLocalization.finiteType_of_monoid_fg (Submonoid.powers (polyS S)) _)

instance : IsDomain (lineRingS S) :=
  IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors
    (polyS_ne_zero S))

variable {S} {F : Type u} [CommRing F] [Algebra k F]

/-- `k[t, 1/P_S(t)] → F`, `t ↦ a`, for `P_S(a)` a unit. -/
def lineLiftS (a : F) (ha : IsUnit (aeval a (polyS S))) : lineRingS S →ₐ[k] F :=
  IsLocalization.Away.liftAlgHom (polyS S) (f := aeval a) ha

@[simp]
lemma lineLiftS_lineTS (a : F) (ha : IsUnit (aeval a (polyS S))) :
    lineLiftS a ha (lineTS S) = a := by
  simp [lineLiftS, lineTS]

lemma lineLiftS_algebraMap (a : F) (ha : IsUnit (aeval a (polyS S))) (p : k[X]) :
    lineLiftS a ha (algebraMap k[X] _ p) = aeval a p := by
  simp [lineLiftS]

/-- `k`-algebra maps out of `k[t, 1/P_S(t)]` are determined by the image of `t`. -/
lemma lineRingS_algHom_ext {f g : lineRingS S →ₐ[k] F} (h : f (lineTS S) = g (lineTS S)) :
    f = g := by
  refine AlgHom.coe_ringHom_injective (IsLocalization.ringHom_ext
    (Submonoid.powers (polyS S)) (Polynomial.ringHom_ext (fun c ↦ ?_) ?_))
  · simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe]
    change f (algebraMap k[X] _ (algebraMap k k[X] c)) = g (algebraMap k[X] _ (algebraMap k k[X] c))
    rw [← IsScalarTower.algebraMap_apply k k[X] (lineRingS S), AlgHom.commutes, AlgHom.commutes]
  · exact h

omit [Algebra k F] in
/-- Ring maps out of `k[t, 1/P_S(t)]` are determined by `k` and the image of `t`. -/
lemma lineRingS_ringHom_ext {f g : lineRingS S →+* F}
    (hC : ∀ c : k, f (algebraMap k _ c) = g (algebraMap k _ c))
    (h : f (lineTS S) = g (lineTS S)) : f = g := by
  refine IsLocalization.ringHom_ext (Submonoid.powers (polyS S))
    (Polynomial.ringHom_ext (fun c ↦ ?_) ?_)
  · simp only [RingHom.coe_comp, Function.comp_apply]
    change f (algebraMap k[X] _ (algebraMap k k[X] c)) = g (algebraMap k[X] _ (algebraMap k k[X] c))
    rw [← IsScalarTower.algebraMap_apply k k[X] (lineRingS S)]
    exact hC c
  · exact h

variable (S) in
lemma isUnit_aeval_lineTS : IsUnit (aeval (lineTS S) (polyS S)) := by
  have h : aeval (lineTS S) (polyS S) = algebraMap k[X] (lineRingS S) (polyS S) := by
    rw [lineTS, Polynomial.aeval_algebraMap_apply, aeval_X_left_apply]
  rw [h]
  exact IsLocalization.Away.algebraMap_isUnit _

variable (S) in
/-- `k[X₀] → k[t, 1/P_S(t)]`, `X₀ ↦ t`, is étale (a localization). -/
lemma etale_mvAeval_lineTS :
    (MvPolynomial.aeval (R := k) fun _ : Fin 1 ↦ lineTS S).toRingHom.Etale := by
  refine etale_mvAeval_of_etale_aeval ?_
  have e : (Polynomial.aeval (R := k) (lineTS S)).toRingHom = algebraMap k[X] (lineRingS S) :=
    Polynomial.ringHom_ext (fun c ↦ by
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_C]
      rw [IsScalarTower.algebraMap_apply k k[X] (lineRingS S)]
      rfl)
      (by simp [lineTS])
  rw [e]
  exact RingHom.etale_algebraMap.2 (Algebra.Etale.of_isLocalizationAway (polyS S))

end Line

/-! ### The geometric generic point and the Galois action -/

section Galois

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} (S : Finset k)

lemma isUnit_aeval_polyS_of_transcendental (ht : Transcendental k t) {E : IntermediateField k Ω}
    (h : t ∈ E) : IsUnit (aeval (⟨t, h⟩ : E) (polyS S)) := by
  refine isUnit_iff_ne_zero.2 fun h0 ↦ ht ⟨polyS S, polyS_ne_zero S, ?_⟩
  have := congrArg (IntermediateField.val E) h0
  rw [← Polynomial.aeval_algHom_apply (IntermediateField.val E)] at this
  simpa using this

/-- `k[t, 1/P_S(t)] → k(t)`. -/
def lineToK₀S (ht : Transcendental k t) : lineRingS S →ₐ[k] K₀ k t :=
  lineLiftS (tK₀ k t) (isUnit_aeval_polyS_of_transcendental S ht _)

/-- `k[t, 1/P_S(t)] → Ω`. -/
def lineToΩS (ht : Transcendental k t) : lineRingS S →ₐ[k] Ω :=
  (IsScalarTower.toAlgHom k (K₀ k t) Ω).comp (lineToK₀S S ht)

@[simp]
lemma lineToΩS_lineTS (ht : Transcendental k t) : lineToΩS S ht (lineTS S) = t := by
  simp [lineToΩS, lineToK₀S, tK₀]

lemma lineToΩS_algebraMap (ht : Transcendental k t) (p : k[X]) :
    lineToΩS S ht (algebraMap k[X] _ p) = aeval t p := by
  have : (lineToΩS S ht).comp (IsScalarTower.toAlgHom k k[X] (lineRingS S)) = aeval t :=
    Polynomial.algHom_ext (by
      rw [AlgHom.comp_apply, aeval_X]
      exact lineToΩS_lineTS S ht)
  exact DFunLike.congr_fun this p

/-- **The geometric generic point** `η : Spec Ω ⟶ Spec k(t) ⟶ ℙ¹ ∖ (S ∪ {∞})`. -/
def lineGenS (ht : Transcendental k t) : Spec (.of Ω) ⟶ Spec (.of (lineRingS S)) :=
  Spec.map (CommRingCat.ofHom (algebraMap (K₀ k t) Ω)) ≫
    Spec.map (CommRingCat.ofHom (lineToK₀S S ht).toRingHom)

lemma lineGenS_eq (ht : Transcendental k t) :
    lineGenS S ht = Spec.map (CommRingCat.ofHom (lineToΩS S ht).toRingHom) := by
  rw [lineGenS, ← Spec.map_comp]
  rfl

variable [IsSepClosed Ω] [IsGalois (K₀ k t) Ω]

/-- **The Galois action** `Gal(Ω / k(t)) → π₁ᵉᵗ(ℙ¹ ∖ (S ∪ {∞}), η)`. -/
def lineGaloisS (ht : Transcendental k t) : (Ω ≃ₐ[K₀ k t] Ω) →* π₁ᵉᵗ(lineGenS S ht) :=
  FiniteEtale.galoisAction (K₀ k t) (Spec.map (CommRingCat.ofHom (lineToK₀S S ht).toRingHom)) rfl

/-- **The inertia group of a place `W` of `Ω` in `π₁ᵉᵗ(ℙ¹ ∖ (S ∪ {∞}), η)`**: the closed subgroup
generated by the images of the inertia elements of `W`. -/
def lineInertiaS (ht : Transcendental k t) (W : ValuationSubring Ω) :
    Subgroup π₁ᵉᵗ(lineGenS S ht) :=
  (Subgroup.closure (lineGaloisS S ht '' GaloisPi1.inertia (P := K₀ k t) W)).topologicalClosure

end Galois

/-! ### Local coordinates at the cusps -/

section Coord

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω]

/-- **The local coordinate at the cusp `c`**: `t - a` at `c = some a`, `1/t` at `c = none`
(the cusp `∞`). -/
def cuspCoordS : Option k → Ω → Ω
  | some a, t => t - algebraMap k Ω a
  | none, t => t⁻¹

@[simp] lemma cuspCoordS_some (a : k) (t : Ω) : cuspCoordS (some a) t = t - algebraMap k Ω a :=
  rfl

@[simp] lemma cuspCoordS_none (t : Ω) : cuspCoordS (none : Option k) t = t⁻¹ := rfl

end Coord

end CurvesJacobian.Cusp
