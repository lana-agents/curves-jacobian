import CurvesJacobian.Cusp.HemiArith
import CurvesJacobian.Cusp.TorsionFree
import CurvesJacobian.Cusp.EnlargeKernel

/-!
# The semi-elliptic double cover `X → C` of the hemi-elliptic orbicurve ([AbsTopII] Cor. 3.3 (ii))

[AbsTopII] Cor. 3.3 (ii) (`Topics in Absolute Anabelian Geometry II.txt` l.4447–4453): "The
collection of open subgroups `Π_D ⊆ Π_C` that arise from finite étale double coverings `D → C`
that exhibit `C` as semi-elliptic may be characterized group-theoretically as the collection of
open subgroups `J ⊆ Π_C` of index `2` such that `J ∩ Δ_C` is torsion-free." By Remark 3.1.1
(l.4317–4322), `D_{k̄} → C_{k̄}` is the unique finite étale double covering of `C_{k̄}` by a
hyperbolic curve. Here `C = [X / ±1]` is the hemi-elliptic orbicurve of an elliptic curve `E`
over a number field `K`, `X = E ∖ {O}` (`CurvesJacobian.Cusp.hemiData`,
`CurvesJacobian.Cusp.hemi_arith_orbiEmb`), `Π_X ↪ Π_C` is `hemiPiXEmb`, `Δ_C = ker hemiPrC`.

We prove Cor. 3.3 (ii) in the form "an open `J ⊆ Π_C` of index `2` has torsion-free geometric
part iff `J` is geometrically the semi-elliptic double cover `X → C`, i.e.
`J ∩ Δ_C = Π_X ∩ Δ_C = Δ_X`" (the arithmetic `J` with this geometric part are then the quadratic
twists of `X → C`; not formalised):

* `CurvesJacobian.Cusp.inf_eq_of_isTorsionFreeSubgroup₂` (pure group theory): let `G` be a
  topological group, `X, J ≤ G` open of index `2` and `Δ ≤ G` topologically generated by
  involutions not in `X`. If `J ∩ Δ` is torsion-free, then `J ∩ Δ = X ∩ Δ` (the two characters
  `Δ → ℤ/2` cut out by `J` and `X` agree on the generators: no involution lies in `J`);
  `isTorsionFreeSubgroup_inf_iff₂`: if moreover `X ∩ Δ` is torsion-free, this is an iff;
* `CurvesJacobian.Cusp.isTorsionFreeSubgroup_hemi_range_inf`: `Π_X ∩ Δ_C = Δ_X`
  (`hemi_range_inf_ker`) is torsion-free (`Δ_X ≅ Π̂_{1,1}` is free profinite);
* `CurvesJacobian.Cusp.hemi_semiElliptic_iff`: **Cor. 3.3 (ii)** for `C`, and
  `hemi_semiElliptic_range`: `J = Π_X` (the double cover `X → C` itself) is such a subgroup.

**Hypothesis** `hgen` (step (D-b), proved in `CurvesJacobian.Cusp.HemiInvolutionGen` as
`hemi_hgen`; unconditional form `hemi_semiElliptic_iff'`): `Δ_C` is topologically generated
by involutions not in `Π_X`. Geometrically these are the generators of the inertia groups at the
three orbifold points `E[2] ∖ {O}` (the roots `e₁, e₂, e₃` of the `2`-division polynomial on the
`x`-line): `Δ_C` is a quotient of `π₁(ℙ¹_{k̄} ∖ {e₁, e₂, e₃, ∞}) ≅ Π̂_{0,4}`, which is
topologically generated by inertia generators `γ₁, γ₂, γ₃` at `e₁, e₂, e₃`, whose images in `Π_C`
have order `2` and lie outside `Π_X` (`L / k(x)` is ramified at the `eᵢ`).
-/

open Pi1.Orbifold AffOrbicurve Topology Belyi

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section GroupTheory

variable {G : Type*} [Group G]

/-- The subgroup of elements lying in both or in neither of two subgroups of index `2` (the kernel
of the product of the two characters `G → ℤ/2`). -/
def agreeSubgroup₂ {X J : Subgroup G} (hX : X.index = 2) (hJ : J.index = 2) : Subgroup G where
  carrier := {g | g ∈ J ↔ g ∈ X}
  one_mem' := iff_of_true J.one_mem X.one_mem
  mul_mem' := fun {a b} ha hb => by
    change a * b ∈ J ↔ a * b ∈ X
    rw [Subgroup.mul_mem_iff_of_index_two hJ, Subgroup.mul_mem_iff_of_index_two hX]
    exact iff_congr ha hb
  inv_mem' := fun {a} ha => by
    change a⁻¹ ∈ J ↔ a⁻¹ ∈ X
    rw [inv_mem_iff, inv_mem_iff]
    exact ha

lemma mem_agreeSubgroup₂ {X J : Subgroup G} (hX : X.index = 2) (hJ : J.index = 2) (g : G) :
    g ∈ agreeSubgroup₂ hX hJ ↔ (g ∈ J ↔ g ∈ X) := Iff.rfl

/-- The image of a torsion-free subgroup under an injective homomorphism is torsion-free. -/
lemma isTorsionFreeSubgroup_map₂ {H : Type*} [Group H] (f : G →* H)
    (hf : Function.Injective f) {T : Subgroup G} (hT : IsTorsionFreeSubgroup T) :
    IsTorsionFreeSubgroup (T.map f) := by
  rintro _ ⟨x, hx, rfl⟩ hfin
  rw [hT x hx ((hf.isOfFinOrder_iff (f := f)).1 hfin), map_one]

variable [TopologicalSpace G] [IsTopologicalGroup G]

/-- **Group theory of [AbsTopII] Cor. 3.3 (ii).** Let `X, J ≤ G` be open of index `2` and `Δ ≤ G`
topologically generated by involutions not in `X`. If `J ∩ Δ` is torsion-free, then
`J ∩ Δ = X ∩ Δ`. -/
theorem inf_eq_of_isTorsionFreeSubgroup₂ {Δ X J : Subgroup G} (hX : X.index = 2)
    (hJ : J.index = 2) (hXo : IsOpen (X : Set G)) (hJo : IsOpen (J : Set G))
    (hgen : Δ ≤ (Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X}).topologicalClosure)
    (htf : IsTorsionFreeSubgroup (J ⊓ Δ)) : J ⊓ Δ = X ⊓ Δ := by
  have hJX : J ⊓ X ≤ agreeSubgroup₂ hX hJ := fun g hg => iff_of_true hg.1 hg.2
  have hopen : IsOpen ((J ⊓ X : Subgroup G) : Set G) := by
    rw [Subgroup.coe_inf]
    exact hJo.inter hXo
  have hclosed : IsClosed ((agreeSubgroup₂ hX hJ : Subgroup G) : Set G) :=
    Subgroup.isClosed_of_isOpen _ (Subgroup.isOpen_mono hJX hopen)
  have hgenle : Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X} ≤ agreeSubgroup₂ hX hJ := by
    rw [Subgroup.closure_le]
    rintro τ ⟨hτΔ, hτ2, hτX⟩
    have hτJ : τ ∉ J := fun hτJ => by
      have h1 : τ = 1 :=
        htf τ ⟨hτJ, hτΔ⟩ (isOfFinOrder_iff_pow_eq_one.2 ⟨2, two_pos, hτ2⟩)
      exact hτX (h1 ▸ X.one_mem)
    exact iff_of_false hτJ hτX
  have hM : Δ ≤ agreeSubgroup₂ hX hJ :=
    hgen.trans (Subgroup.topologicalClosure_minimal _ hgenle hclosed)
  ext g
  constructor
  · rintro ⟨hgJ, hgΔ⟩
    exact ⟨((mem_agreeSubgroup₂ hX hJ g).1 (hM hgΔ)).1 hgJ, hgΔ⟩
  · rintro ⟨hgX, hgΔ⟩
    exact ⟨((mem_agreeSubgroup₂ hX hJ g).1 (hM hgΔ)).2 hgX, hgΔ⟩

/-- **Group theory of [AbsTopII] Cor. 3.3 (ii), iff form.** If moreover `X ∩ Δ` is torsion-free,
then for every open `J ≤ G` of index `2`: `J ∩ Δ` is torsion-free iff `J ∩ Δ = X ∩ Δ`. -/
theorem isTorsionFreeSubgroup_inf_iff₂ {Δ X J : Subgroup G} (hX : X.index = 2)
    (hJ : J.index = 2) (hXo : IsOpen (X : Set G)) (hJo : IsOpen (J : Set G))
    (hgen : Δ ≤ (Subgroup.closure {τ | τ ∈ Δ ∧ τ ^ 2 = 1 ∧ τ ∉ X}).topologicalClosure)
    (hXtf : IsTorsionFreeSubgroup (X ⊓ Δ)) :
    IsTorsionFreeSubgroup (J ⊓ Δ) ↔ J ⊓ Δ = X ⊓ Δ :=
  ⟨inf_eq_of_isTorsionFreeSubgroup₂ hX hJ hXo hJo hgen, fun h => h ▸ hXtf⟩

end GroupTheory

section Hemi

variable {K : Type u} [Field K] [NumberField K] (E : WeierstrassCurve K) [E.IsElliptic]
  (Ω' : Type u) [Field Ω'] [Algebra K Ω'] [IsAlgClosed Ω'] [Algebra.IsAlgebraic K Ω']
  [CharZero Ω']

/-- **`Δ_X` is torsion-free** for `X = E ∖ {O}`. -/
theorem isTorsionFreeSubgroup_ker_pr_hemi :
    IsTorsionFreeSubgroup
      (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).pr.toMonoidHom.ker := by
  intro x hx hfin
  have h := Delta_eq_one_of_isOfFinOrder Ω' (hypCurveX E) (compl_XE_nonempty E) (δ := ⟨x, hx⟩)
    ((Subgroup.subtype_injective _).isOfFinOrder_iff (f := Subgroup.subtype _) |>.1 hfin)
  exact congrArg Subtype.val h

/-- **`Π_X ∩ Δ_C = Δ_X`** (the image of `Δ_X` under `Π_X ↪ Π_C`). -/
theorem hemi_range_inf_ker :
    (hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker =
      (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).pr.toMonoidHom.ker.map
        (hemiPiXEmb E Ω').toMonoidHom :=
  (inf_comm (hemiPiXEmb E Ω').toMonoidHom.range (hemiPrC E Ω').toMonoidHom.ker).trans
    (hemi_arith_orbiEmb E Ω').2.2.2.2

/-- **`Π_X ∩ Δ_C` is torsion-free** (step (D-a)). -/
theorem isTorsionFreeSubgroup_hemi_range_inf :
    IsTorsionFreeSubgroup
      ((hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker) := by
  rw [hemi_range_inf_ker]
  exact isTorsionFreeSubgroup_map₂ _ (hemi_arith_orbiEmb E Ω').1.injective
    (isTorsionFreeSubgroup_ker_pr_hemi E Ω')

/-- `Π_X` is open in `Π_C`. -/
theorem isOpen_hemi_range :
    IsOpen ((hemiPiXEmb E Ω').toMonoidHom.range :
      Set (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)))) := by
  rw [MonoidHom.coe_range]
  exact (hemi_arith_orbiEmb E Ω').1.isOpen_range

/-- **[AbsTopII] Cor. 3.3 (ii) for the hemi-elliptic orbicurve `C = [(E ∖ {O}) / ±1]`**: an open
subgroup `J ⊆ Π_C` of index `2` has torsion-free geometric part `J ∩ Δ_C` iff
`J ∩ Δ_C = Π_X ∩ Δ_C` (`= Δ_X`, `hemi_range_inf_ker`), i.e. iff `J` is geometrically the
semi-elliptic double cover `X → C` (Remark 3.1.1). Hypothesis `hgen` (step (D-b), discharged by
`hemi_hgen` in `HemiInvolutionGen`): `Δ_C` is topologically generated by involutions not in
`Π_X` (the inertia generators at the three points of `E[2] ∖ {O}`). -/
theorem hemi_semiElliptic_iff
    (hgen : (hemiPrC E Ω').toMonoidHom.ker ≤
      (Subgroup.closure {τ | τ ∈ (hemiPrC E Ω').toMonoidHom.ker ∧ τ ^ 2 = 1 ∧
        τ ∉ (hemiPiXEmb E Ω').toMonoidHom.range}).topologicalClosure)
    (J : Subgroup (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E))))
    (hJo : IsOpen (J : Set (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)))))
    (hJ : J.index = 2) :
    IsTorsionFreeSubgroup (J ⊓ (hemiPrC E Ω').toMonoidHom.ker) ↔
      J ⊓ (hemiPrC E Ω').toMonoidHom.ker =
        (hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker :=
  isTorsionFreeSubgroup_inf_iff₂ (hemi_arith_orbiEmb E Ω').2.2.1 hJ (isOpen_hemi_range E Ω')
    hJo hgen (isTorsionFreeSubgroup_hemi_range_inf E Ω')

/-- **The semi-elliptic double cover `X → C` itself**: `J = Π_X` is an open subgroup of `Π_C` of
index `2` with torsion-free geometric part `Π_X ∩ Δ_C = Δ_X`. -/
theorem hemi_semiElliptic_range :
    IsOpen ((hemiPiXEmb E Ω').toMonoidHom.range :
      Set (etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E)))) ∧
      (hemiPiXEmb E Ω').toMonoidHom.range.index = 2 ∧
      IsTorsionFreeSubgroup
        ((hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker) ∧
      (hemiPiXEmb E Ω').toMonoidHom.range ⊓ (hemiPrC E Ω').toMonoidHom.ker =
        (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).pr.toMonoidHom.ker.map
          (hemiPiXEmb E Ω').toMonoidHom :=
  ⟨isOpen_hemi_range E Ω', (hemi_arith_orbiEmb E Ω').2.2.1,
    isTorsionFreeSubgroup_hemi_range_inf E Ω', hemi_range_inf_ker E Ω'⟩

end Hemi

end CurvesJacobian.Cusp
