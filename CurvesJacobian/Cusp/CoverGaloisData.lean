import CurvesJacobian.Cusp.Inertia
import CurvesJacobian.Cusp.CoverGenus
import CurvesJacobian.Scheme.CurveFunctionField

/-!
# Galois data of a finite étale cover of an open of a curve (MR8.3, [AbsTopI] Lemma 4.1 (i))

Setting of `CurvesJacobian/Cusp/Inertia.lean`: Galois data `D : GaloisData k t` with
`[IsGalois (K₀ k t) Ω] [IsSepClosed Ω]`, a curve `X` over `k` (characteristic `0`) with
`eL : K(X) ≃ L` (`hk`, `hτ`). For a morphism `q : N ⟶ X` of integral `k`-schemes mapping the
generic point to the generic point (`hq`), with `N` a curve over `k` (`IsCurveOver k N`):

* `CurvesJacobian.Cusp.coverEmb`: an embedding `K(N) ↪ Ω` extending `K(X) ≅ L ⊆ Ω`
  (`coverEmb_functionFieldMap`; `K(N)` is algebraic over `K(X)`, `isAlgebraic_functionFieldMap`,
  and `Ω` is algebraically closed);
* `coverL` its image `L'` (finite over `k(t)`, `finiteDimensional_coverL`), and
  `coverData D eL hk hτ q hs hq : GaloisData k t` with `H' = H'_L = Gal(Ω / L')`
  (`coverData_H_le`, `coverData_L`, `coverData_H_le_H : H' ≤ H`);
* `coverEL : K(N) ≃ L'` with the analogues `coverEL_algebraMap` of `hk` and `coverEL_τ` of `hτ`
  (for the coordinate `q^* τ`).

For a nonempty open `U ⊆ X` and `q ∣_ U : q⁻¹U ⟶ U`:

* `specPoint_coverGenericL`: the geometric generic points agree on the nose,
  `Spec Ω ⟶ Spec L' ⟶ q⁻¹U ⟶ U` equals `Spec Ω ⟶ Spec L ⟶ U`;
* `fundamentalGroupMap_coverChartHom`: **naturality** — `π₁ᵉᵗ(q⁻¹U) → π₁ᵉᵗ(U)` maps
  `chartHom D' σ` to `chartHom D σ` for `σ ∈ H' ≤ H` (from `fundamentalGroupMap_chartHom_of_le`,
  valid for any two Galois data with `H₁ ≤ H₂` and points inducing the same geometric point);
* `map_cuspInertia_cover`: the image of `cuspInertia D' N (q⁻¹U) W` is the subgroup generated by
  the images of the inertia elements of `W` lying in `H'`; in particular
  `map_cuspInertia_cover_le`: it lies in `cuspInertia D X U W`;
* `isCentredOn_of_isCentredOn_cover`, `isCentredOn_cover_iff`: `W` centred on `q⁻¹U` (for `D'`)
  implies centred on `U` (for `D`), and conversely if `Γ(N, q⁻¹U)` is integral over `Γ(X, U)`
  (valuation rings are integrally closed).

**The compactified cover.** For `p : Y ⟶ U` finite étale with `Y` integral and
`N = (p ≫ U.ι).normalization` (over `k` via `normOver`; a curve by `normCurve`,
`q = fromNormalization`, `hs := rfl`, `hq := normGeneric k p`):

* `normIso : Y ≅ q⁻¹U` with `normIso_inv_comp : normIso.inv ≫ p = q ∣_ U`;
* `isIntegral_normalization_app`: for `U` affine, `Γ(N, q⁻¹U)` is integral over `Γ(X, U)`
  (`normalizationObjIso`), hence `isCentredOn_normalization_iff`;
* `genericY`, `fundamentalGroupMap_genericY`: naturality for `p` itself, at the generic point
  `Spec L' ⟶ q⁻¹U ≅ Y`.
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale
open Pi1.Orbifold AffOrbicurve
open scoped IntermediateField

universe u

noncomputable section

namespace CurvesJacobian.Cusp

section Field

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}

/-- **Galois data of an intermediate field** `L' ⊆ Ω` with open fixing group:
`H = H_L = Gal(Ω / L')`. -/
def fieldData (ht : Transcendental k t) (L' : IntermediateField (K₀ k t) Ω)
    (hL' : IsOpen (L'.fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω))) : GaloisData k t where
  H := L'.fixingSubgroup
  HL := L'.fixingSubgroup
  le := le_rfl
  isOpen_HL := hL'
  conj_mem := fun _ hh _ hn ↦ mul_mem (mul_mem hh hn) (inv_mem hh)
  transcendental := ht

variable (ht : Transcendental k t) (L' : IntermediateField (K₀ k t) Ω)
  (hL' : IsOpen (L'.fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω)))

lemma fieldData_H_le : (fieldData ht L' hL').H ≤ (fieldData ht L' hL').HL := le_rfl

variable [IsGalois (K₀ k t) Ω]

lemma fieldData_L : (fieldData ht L' hL').L = L' :=
  InfiniteGalois.fixedField_fixingSubgroup L'

lemma fieldData_H_le_HL (D : GaloisData k t) (h : D.L ≤ L') :
    (fieldData ht L' hL').H ≤ D.HL := by
  rw [← D.fixingSubgroup_L]
  exact IntermediateField.fixingSubgroup_le h

end Field

section Action

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} [IsGalois (K₀ k t) Ω]
  [IsSepClosed Ω]

/-- **Change of Galois data**: for `H₁ ≤ H₂` and points `j₁ : Spec L₁ ⟶ Y`, `j₂ : Spec L₂ ⟶ Z`
and `f : Y ⟶ Z` inducing the same geometric point, `π₁ᵉᵗ(f)` intertwines the Galois actions. -/
lemma fundamentalGroupMap_chartHom_of_le {D₁ D₂ : GaloisData k t} (hH₁ : D₁.H ≤ D₁.HL)
    (hH₂ : D₂.H ≤ D₂.HL) (hle : D₁.H ≤ D₂.H) {Y Z : Scheme.{u}} (j₁ : Spec (.of D₁.L) ⟶ Y)
    (f : Y ⟶ Z) (j₂ : Spec (.of D₂.L) ⟶ Z)
    (h : (specPoint D₁.L Ω ≫ j₁) ≫ f = specPoint D₂.L Ω ≫ j₂) (σ : D₁.H) :
    fundamentalGroupMap f h (D₁.chartHom hH₁ j₁ σ) =
      D₂.chartHom hH₂ j₂ (Subgroup.inclusion hle σ) := by
  rw [GaloisData.chartHom_apply, GaloisData.chartHom_apply,
    fundamentalGroupMap_galoisAction D₁.L j₁ f rfl h (by rw [← Category.assoc]; exact h)]
  exact galoisAction_eq_of_apply_eq D₁.L (j₁ ≫ f) j₂ _ rfl _ _ fun _ ↦ rfl

end Action

section Cover

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} (D : GaloisData k t)
  {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsIntegral X] (eL : X.functionField ≃+* D.L)
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)
  {N : Scheme.{u}} [N.Over (Spec (.of k))] [IsIntegral N] (q : N ⟶ X)
  (hs : N ↘ Spec (.of k) = q ≫ (X ↘ Spec (.of k))) (hq : q (genericPoint N) = genericPoint X)

include hs in
lemma functionFieldMap_algebraMap_k (c : k) :
    functionFieldMap q hq (algebraMap k X.functionField c) = algebraMap k N.functionField c := by
  change functionFieldMap q hq (X.presheaf.germ ⊤ (genericPoint X) trivial
      ((X ↘ Spec (.of k)).appTop ((Scheme.ΓSpecIso (.of k)).inv c))) =
    N.presheaf.germ ⊤ (genericPoint N) trivial
      ((N ↘ Spec (.of k)).appTop ((Scheme.ΓSpecIso (.of k)).inv c))
  rw [functionFieldMap_germ_top, hs, Scheme.Hom.comp_appTop]
  rfl

/-- `K(X) → K(N)` as a `k`-algebra map. -/
def functionFieldAlgHom : X.functionField →ₐ[k] N.functionField :=
  { (functionFieldMap q hq).hom with commutes' := functionFieldMap_algebraMap_k q hs hq }

lemma functionFieldAlgHom_apply (z : X.functionField) :
    functionFieldAlgHom q hs hq z = functionFieldMap q hq z := rfl

omit [X.Over (Spec (.of k))] [N.Over (Spec (.of k))] in
/-- The generic points of `N` and `X` are compatible with `functionFieldMap`. -/
lemma fromSpecStalk_comp_eq : N.fromSpecStalk (genericPoint N) ≫ q =
    Spec.map (functionFieldMap q hq) ≫ X.fromSpecStalk (genericPoint X) := by
  rw [functionFieldMap, Spec.map_comp, Category.assoc,
    Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk]

omit [X.Over (Spec (.of k))] [N.Over (Spec (.of k))] in
include hq in
/-- `q⁻¹U` is nonempty for `U` nonempty. -/
lemma nonempty_preimage (U : X.Opens) [Nonempty U] : Nonempty (q ⁻¹ᵁ U) :=
  ⟨⟨genericPoint N, by
    change q (genericPoint N) ∈ U
    rw [hq]
    exact genericPoint_mem_of_nonempty U⟩⟩

omit [X.Over (Spec (.of k))] [N.Over (Spec (.of k))] in
/-- `functionFieldMap` on germs of sections over `U`. -/
lemma germToFunctionField_app (U : X.Opens) [Nonempty U] [Nonempty (q ⁻¹ᵁ U)] (a : Γ(X, U)) :
    N.germToFunctionField (q ⁻¹ᵁ U) (q.app U a) =
      functionFieldMap q hq (X.germToFunctionField U a) := by
  change _ = q.stalkMap (genericPoint N) (X.presheaf.stalkSpecializes _
    (X.presheaf.germ U (genericPoint X) _ a))
  rw [TopCat.Presheaf.germ_stalkSpecializes_apply, Scheme.Hom.germ_stalkMap_apply]

variable [CharZero k] [IsCurveOver k N]

include hs in
/-- `K(N)` is algebraic over `K(X)`. -/
lemma isAlgebraic_functionFieldMap {τ : X.functionField} (hτT : Transcendental k τ) :
    letI := (functionFieldMap q hq).hom.toAlgebra
    Algebra.IsAlgebraic X.functionField N.functionField := by
  letI := (functionFieldMap q hq).hom.toAlgebra
  let φk := functionFieldAlgHom q hs hq
  have hu : Transcendental k (φk τ) := fun h ↦
    hτT ((isAlgebraic_algHom_iff φk φk.toRingHom.injective).1 h)
  haveI := WeilCurves.FunctionField.isAlgebraic_adjoin hu
  have hle : (k⟮φk τ⟯).toSubalgebra ≤ φk.range := by
    rw [← AlgHom.fieldRange_toSubalgebra]
    exact IntermediateField.toSubalgebra_le_toSubalgebra.2
      (IntermediateField.adjoin_simple_le_iff.2 ⟨τ, rfl⟩)
  refine ⟨fun x ↦ ?_⟩
  have h1 : IsAlgebraic φk.range x :=
    (Algebra.IsAlgebraic.isAlgebraic (R := k⟮φk τ⟯) x).tower_top_of_subalgebra_le hle
  let f : φk.range ≃+* X.functionField := (AlgEquiv.ofInjectiveField φk).symm.toRingEquiv
  refine (isAlgebraic_ringHom_iff_of_comp_eq f (RingHom.id N.functionField)
    Function.injective_id (RingHom.ext fun b ↦ ?_)).2 h1
  exact congrArg Subtype.val ((AlgEquiv.ofInjectiveField φk).apply_symm_apply b)

variable [IsSepClosed Ω]

/-- **An embedding `K(N) ↪ Ω` extending `K(X) ≅ L ⊆ Ω`** (chosen by `IsAlgClosed.lift`). -/
def coverEmb : N.functionField →+* Ω :=
  letI := (functionFieldMap q hq).hom.toAlgebra
  letI : Algebra X.functionField Ω := ((algebraMap D.L Ω).comp eL.toRingHom).toAlgebra
  haveI := isAlgebraic_functionFieldMap q hs hq (transcendental_of_embK D X eL hk hτ)
  haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
  (IsAlgClosed.lift (R := X.functionField) (S := N.functionField) (M := Ω)).toRingHom

lemma coverEmb_functionFieldMap (z : X.functionField) :
    coverEmb D eL hk hτ q hs hq (functionFieldMap q hq z) = ((eL z : D.L) : Ω) := by
  letI := (functionFieldMap q hq).hom.toAlgebra
  letI : Algebra X.functionField Ω := ((algebraMap D.L Ω).comp eL.toRingHom).toAlgebra
  haveI := isAlgebraic_functionFieldMap q hs hq (transcendental_of_embK D X eL hk hτ)
  haveI : CharZero Ω := charZero_of_injective_algebraMap (algebraMap k Ω).injective
  exact (IsAlgClosed.lift (R := X.functionField) (S := N.functionField) (M := Ω)).commutes z

lemma coverEmb_algebraMap (c : k) :
    coverEmb D eL hk hτ q hs hq (algebraMap k N.functionField c) = algebraMap k Ω c := by
  rw [← functionFieldMap_algebraMap_k q hs hq, coverEmb_functionFieldMap, hk]

/-- `K(N) ↪ Ω` as a `k`-algebra map. -/
def coverEmbK : N.functionField →ₐ[k] Ω :=
  { coverEmb D eL hk hτ q hs hq with commutes' := coverEmb_algebraMap D eL hk hτ q hs hq }

/-- **The image `L' ⊆ Ω` of `K(N)`**, an intermediate field over `k(t)`. -/
def coverL : IntermediateField (K₀ k t) Ω :=
  (coverEmb D eL hk hτ q hs hq).fieldRange.toIntermediateField fun x ↦
    RingHom.mem_fieldRange.2 ⟨functionFieldMap q hq (eL.symm ⟨_, D.L.algebraMap_mem x⟩), by
      rw [coverEmb_functionFieldMap, RingEquiv.apply_symm_apply]⟩

lemma mem_coverL (y : Ω) : y ∈ coverL D eL hk hτ q hs hq ↔ ∃ x, coverEmb D eL hk hτ q hs hq x = y :=
  RingHom.mem_fieldRange

lemma le_coverL : D.L ≤ coverL D eL hk hτ q hs hq := fun y hy ↦
  (mem_coverL D eL hk hτ q hs hq y).2 ⟨functionFieldMap q hq (eL.symm ⟨y, hy⟩), by
    rw [coverEmb_functionFieldMap, RingEquiv.apply_symm_apply]⟩

variable [IsGalois (K₀ k t) Ω]

/-- `L'` is finite over `k(t)`. -/
lemma finiteDimensional_coverL : FiniteDimensional (K₀ k t) (coverL D eL hk hτ q hs hq) := by
  obtain ⟨S, hS⟩ := WeilCurves.FunctionField.exists_finset_adjoin_eq_top k N.functionField
  let ψ := coverEmbK D eL hk hτ q hs hq
  let M := IntermediateField.adjoin (K₀ k t) (ψ '' (S : Set N.functionField))
  haveI : FiniteDimensional (K₀ k t) M := IntermediateField.finiteDimensional_adjoin
    fun x _ ↦ (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  have hle : coverL D eL hk hτ q hs hq ≤ M := by
    intro y hy
    obtain ⟨x, rfl⟩ := (mem_coverL D eL hk hτ q hs hq y).1 hy
    have hx : ψ x ∈ (IntermediateField.adjoin k (S : Set N.functionField)).map ψ :=
      (IntermediateField.mem_map _).2 ⟨x, hS ▸ IntermediateField.mem_top, rfl⟩
    rw [IntermediateField.adjoin_map] at hx
    have h2 : IntermediateField.adjoin k (ψ '' (S : Set N.functionField)) ≤
        M.restrictScalars k :=
      IntermediateField.adjoin_le_iff.2 fun z hz ↦ IntermediateField.subset_adjoin (K₀ k t) _ hz
    exact h2 hx
  exact FiniteDimensional.of_injective (IntermediateField.inclusion hle).toLinearMap
    (IntermediateField.inclusion hle).toRingHom.injective

/-- **Galois data of the cover** `N`: `H' = H'_L = Gal(Ω / L')` for the image `L'` of `K(N)`. -/
def coverData : GaloisData k t :=
  haveI := finiteDimensional_coverL D eL hk hτ q hs hq
  fieldData D.transcendental (coverL D eL hk hτ q hs hq)
    (coverL D eL hk hτ q hs hq).fixingSubgroup_isOpen

lemma coverData_H_le : (coverData D eL hk hτ q hs hq).H ≤ (coverData D eL hk hτ q hs hq).HL :=
  le_rfl

lemma coverData_L : (coverData D eL hk hτ q hs hq).L = coverL D eL hk hτ q hs hq :=
  fieldData_L _ _ _

/-- `H' ≤ H_L`. -/
lemma coverData_H_le_HL : (coverData D eL hk hτ q hs hq).H ≤ D.HL :=
  fieldData_H_le_HL _ _ _ D (le_coverL D eL hk hτ q hs hq)

/-- `H' ≤ H`. -/
lemma coverData_H_le_H : (coverData D eL hk hτ q hs hq).H ≤ D.H :=
  (coverData_H_le_HL D eL hk hτ q hs hq).trans D.le

lemma coverEmb_mem (x : N.functionField) :
    coverEmb D eL hk hτ q hs hq x ∈ (coverData D eL hk hτ q hs hq).L :=
  (SetLike.ext_iff.1 (coverData_L D eL hk hτ q hs hq) _).2
    ((mem_coverL D eL hk hτ q hs hq _).2 ⟨x, rfl⟩)

/-- `K(N) → L'`. -/
def coverHom : N.functionField →+* (coverData D eL hk hτ q hs hq).L where
  toFun x := ⟨coverEmb D eL hk hτ q hs hq x, coverEmb_mem D eL hk hτ q hs hq x⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' x y := Subtype.ext (map_mul _ x y)
  map_zero' := Subtype.ext (map_zero _)
  map_add' x y := Subtype.ext (map_add _ x y)

/-- **`K(N) ≃ L'`.** -/
def coverEL : N.functionField ≃+* (coverData D eL hk hτ q hs hq).L :=
  RingEquiv.ofBijective (coverHom D eL hk hτ q hs hq)
    ⟨fun x y h ↦ (coverEmb D eL hk hτ q hs hq).injective (congrArg Subtype.val h), fun y ↦ by
      have hy := (SetLike.ext_iff.1 (coverData_L D eL hk hτ q hs hq) (y : Ω)).1 y.2
      obtain ⟨x, hx⟩ := (mem_coverL D eL hk hτ q hs hq _).1 hy
      exact ⟨x, Subtype.ext hx⟩⟩

@[simp] lemma coe_coverEL (x : N.functionField) :
    ((coverEL D eL hk hτ q hs hq x : (coverData D eL hk hτ q hs hq).L) : Ω) =
      coverEmb D eL hk hτ q hs hq x := rfl

lemma coverEL_functionFieldMap (z : X.functionField) :
    ((coverEL D eL hk hτ q hs hq (functionFieldMap q hq z) : (coverData D eL hk hτ q hs hq).L) :
      Ω) = ((eL z : D.L) : Ω) :=
  coverEmb_functionFieldMap D eL hk hτ q hs hq z

/-- The analogue of `hk` for the cover. -/
lemma coverEL_algebraMap (c : k) :
    ((coverEL D eL hk hτ q hs hq (algebraMap k N.functionField c) :
      (coverData D eL hk hτ q hs hq).L) : Ω) = algebraMap k Ω c :=
  coverEmb_algebraMap D eL hk hτ q hs hq c

/-- The analogue of `hτ` for the cover (with the coordinate `q^* τ`). -/
lemma coverEL_τ :
    ((coverEL D eL hk hτ q hs hq (functionFieldMap q hq τ) :
      (coverData D eL hk hτ q hs hq).L) : Ω) = t := by
  rw [coverEL_functionFieldMap, hτ]

section Pi1

variable (U : X.Opens) [Nonempty U] [Nonempty (q ⁻¹ᵁ U)]

/-- **Compatibility of the geometric generic points**: `Spec Ω ⟶ Spec L' ⟶ q⁻¹U ⟶ U` is
`Spec Ω ⟶ Spec L ⟶ U`. -/
lemma specPoint_coverGenericL :
    (specPoint (coverData D eL hk hτ q hs hq).L Ω ≫ genericL (coverData D eL hk hτ q hs hq) N
      (coverEL D eL hk hτ q hs hq) (q ⁻¹ᵁ U)) ≫ q ∣_ U =
      specPoint D.L Ω ≫ genericL D X eL U := by
  have h : functionFieldMap q hq ≫ CommRingCat.ofHom (coverEL D eL hk hτ q hs hq).toRingHom ≫
      CommRingCat.ofHom (algebraMap (coverData D eL hk hτ q hs hq).L Ω) =
      CommRingCat.ofHom eL.toRingHom ≫ CommRingCat.ofHom (algebraMap D.L Ω) := by
    ext z
    exact coverEmb_functionFieldMap D eL hk hτ q hs hq z
  rw [← cancel_mono U.ι]
  simp only [Category.assoc, morphismRestrict_ι, genericL_ι_assoc, genericL_ι, genericLX,
    fromSpecStalk_comp_eq q hq]
  rw [← Spec.map_comp_assoc, ← Spec.map_comp_assoc, ← Spec.map_comp_assoc]
  exact congrArg (fun φ ↦ Spec.map φ ≫ X.fromSpecStalk (genericPoint X)) h

variable (hH : D.H ≤ D.HL)

/-- **Naturality**: `π₁ᵉᵗ(q⁻¹U) → π₁ᵉᵗ(U)` intertwines the Galois action of `H' ≤ H` on
`π₁ᵉᵗ(q⁻¹U)` (Galois data of the cover) with that of `H` on `π₁ᵉᵗ(U)`. -/
theorem fundamentalGroupMap_coverChartHom (σ : (coverData D eL hk hτ q hs hq).H) :
    fundamentalGroupMap (q ∣_ U) (specPoint_coverGenericL D eL hk hτ q hs hq U)
      ((coverData D eL hk hτ q hs hq).chartHom (coverData_H_le D eL hk hτ q hs hq)
        (genericL _ N (coverEL D eL hk hτ q hs hq) (q ⁻¹ᵁ U)) σ) =
      D.chartHom hH (genericL D X eL U)
        (Subgroup.inclusion (coverData_H_le_H D eL hk hτ q hs hq) σ) :=
  fundamentalGroupMap_chartHom_of_le _ hH _ _ _ _ _ σ

/-- **The image of a cuspidal inertia group of the cover**: `π₁ᵉᵗ(q⁻¹U) → π₁ᵉᵗ(U)` maps
`cuspInertia (q⁻¹U) W` onto the subgroup generated by the images of the inertia elements of `W`
lying in `H'`. -/
theorem map_cuspInertia_cover (W : ValuationSubring Ω) :
    (cuspInertia (coverData D eL hk hτ q hs hq) N (coverEL D eL hk hτ q hs hq)
      (coverData_H_le D eL hk hτ q hs hq) (q ⁻¹ᵁ U) W).map
        (fundamentalGroupMap (q ∣_ U) (specPoint_coverGenericL D eL hk hτ q hs hq U)).toMonoidHom =
      Subgroup.closure (D.chartHom hH (genericL D X eL U) ''
        {σ : D.H | (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.inertia W ∧
          (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ (coverData D eL hk hτ q hs hq).H}) := by
  rw [cuspInertia, MonoidHom.map_closure, ← Set.image_comp]
  congr 1
  ext g
  constructor
  · rintro ⟨σ, hσ, rfl⟩
    exact ⟨Subgroup.inclusion (coverData_H_le_H D eL hk hτ q hs hq) σ, ⟨hσ, σ.2⟩,
      (fundamentalGroupMap_coverChartHom D eL hk hτ q hs hq U hH σ).symm⟩
  · rintro ⟨σ, ⟨hσW, hσ⟩, rfl⟩
    exact ⟨⟨σ, hσ⟩, hσW, fundamentalGroupMap_coverChartHom D eL hk hτ q hs hq U hH ⟨σ, hσ⟩⟩

/-- The image of a cuspidal inertia group of the cover lies in the cuspidal inertia group of
`U` (for the same place `W`). -/
theorem map_cuspInertia_cover_le (W : ValuationSubring Ω) :
    (cuspInertia (coverData D eL hk hτ q hs hq) N (coverEL D eL hk hτ q hs hq)
      (coverData_H_le D eL hk hτ q hs hq) (q ⁻¹ᵁ U) W).map
        (fundamentalGroupMap (q ∣_ U) (specPoint_coverGenericL D eL hk hτ q hs hq U)).toMonoidHom ≤
      cuspInertia D X eL hH U W := by
  rw [map_cuspInertia_cover D eL hk hτ q hs hq U hH, cuspInertia]
  exact Subgroup.closure_mono (Set.image_mono fun σ hσ ↦ hσ.1)

end Pi1

section Centred

variable (U : X.Opens) [Nonempty U] [Nonempty (q ⁻¹ᵁ U)]
  {W : ValuationSubring Ω}

/-- A place centred on `q⁻¹U` (for the cover) is centred on `U`. -/
theorem isCentredOn_of_isCentredOn_cover
    (hW : IsCentredOn (coverData D eL hk hτ q hs hq) N (coverEL D eL hk hτ q hs hq) (q ⁻¹ᵁ U) W) :
    IsCentredOn D X eL U W := by
  refine ⟨hW.1, fun a ↦ ?_⟩
  have := hW.2 (q.app U a)
  rwa [germToFunctionField_app q hq, coverEL_functionFieldMap] at this

/-- **Centred places of the cover**: if `Γ(N, q⁻¹U)` is integral over `Γ(X, U)` (e.g. for the
normalisation and `U` affine), a place is centred on `q⁻¹U` iff it is centred on `U`. -/
theorem isCentredOn_cover_iff
    (hint : letI := (q.app U).hom.toAlgebra; ∀ b : Γ(N, q ⁻¹ᵁ U), IsIntegral Γ(X, U) b) :
    IsCentredOn (coverData D eL hk hτ q hs hq) N (coverEL D eL hk hτ q hs hq) (q ⁻¹ᵁ U) W ↔
      IsCentredOn D X eL U W := by
  refine ⟨isCentredOn_of_isCentredOn_cover D eL hk hτ q hs hq U, fun ⟨hkW, hW⟩ ↦ ⟨hkW, fun b ↦ ?_⟩⟩
  letI := (q.app U).hom.toAlgebra
  let g : Γ(X, U) →+* W.toSubring :=
    ((algebraMap D.L Ω).comp (eL.toRingHom.comp (X.germToFunctionField U).hom)).codRestrict
      W.toSubring hW
  let ψ : Γ(N, q ⁻¹ᵁ U) →+* Ω :=
    (coverEmb D eL hk hτ q hs hq).comp (N.germToFunctionField (q ⁻¹ᵁ U)).hom
  have hcomp : (algebraMap W.toSubring Ω).comp g = ψ.comp (algebraMap Γ(X, U) Γ(N, q ⁻¹ᵁ U)) := by
    ext a
    change ((eL (X.germToFunctionField U a) : D.L) : Ω) =
      coverEmb D eL hk hτ q hs hq (N.germToFunctionField (q ⁻¹ᵁ U) (q.app U a))
    rw [germToFunctionField_app q hq, coverEmb_functionFieldMap]
  have hb : IsIntegral W.toSubring (ψ b) := (hint b).map_of_comp_eq g ψ hcomp
  haveI : IsIntegrallyClosedIn W.toSubring Ω := inferInstanceAs (IsIntegrallyClosedIn W Ω)
  obtain ⟨y, hy⟩ := IsIntegrallyClosedIn.isIntegral_iff.1 hb
  change ψ b ∈ W
  rw [← hy]
  exact y.2

end Centred

end Cover

/-! ### The compactified cover -/

section Normalization

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsLocallyNoetherian X]
  {U : X.Opens} {Y : Scheme.{u}} (p : Y ⟶ U) [IsFinite p]

variable (k) in
/-- The compactified cover `N` (normalisation of `X` in `Y`) as a scheme over `k`, via
`q : N ⟶ X`. -/
abbrev normOver : (p ≫ U.ι).normalization.Over (Spec (.of k)) :=
  ⟨(p ≫ U.ι).fromNormalization ≫ (X ↘ Spec (.of k))⟩

attribute [local instance] normOver

/-- **`Y ≅ q⁻¹U`** inside the compactified cover `N`. -/
def normIso : Y ≅ ((p ≫ U.ι).fromNormalization ⁻¹ᵁ U : Scheme.{u}) :=
  (isPullback_toNormalization p).isoIsPullback _ _
    (isPullback_morphismRestrict (p ≫ U.ι).fromNormalization U).flip

lemma normIso_inv_comp : (normIso p).inv ≫ p = (p ≫ U.ι).fromNormalization ∣_ U :=
  (Iso.inv_comp_eq _).2 (IsPullback.isoIsPullback_hom_snd _ _ (isPullback_toNormalization p) _).symm

omit [X.Over (Spec (.of k))] in
/-- For `U` affine, `Γ(N, q⁻¹U)` is integral over `Γ(X, U)` (it is the integral closure of
`Γ(X, U)` in `Γ(Y, 𝒪_Y)`, `normalizationObjIso`). -/
lemma isIntegral_normalization_app (hU : IsAffineOpen U) :
    letI := ((p ≫ U.ι).fromNormalization.app U).hom.toAlgebra
    ∀ b : Γ((p ≫ U.ι).normalization, (p ≫ U.ι).fromNormalization ⁻¹ᵁ U), IsIntegral Γ(X, U) b := by
  letI := ((p ≫ U.ι).fromNormalization.app U).hom.toAlgebra
  letI := ((p ≫ U.ι).app U).hom.toAlgebra
  intro b
  let e := (p ≫ U.ι).normalizationObjIso hU
  have hb : e.inv (e.hom b) = b := Iso.hom_inv_id_apply e b
  rw [← hb]
  refine IsIntegral.map_of_comp_eq (RingHom.id Γ(X, U)) e.inv.hom ?_
    (integralClosure.isIntegral (e.hom b))
  rw [RingHom.comp_id]
  exact congrArg CommRingCat.Hom.hom ((p ≫ U.ι).fromNormalization_app hU)

omit [X.Over (Spec (.of k))] in
/-- `q⁻¹U ⊆ N` is nonempty (it contains the image of `Y`). -/
lemma normNonempty [IsIntegral Y] : Nonempty ((p ≫ U.ι).fromNormalization ⁻¹ᵁ U) := by
  obtain ⟨y⟩ := (inferInstance : Nonempty Y)
  refine ⟨⟨(p ≫ U.ι).toNormalization y, ?_⟩⟩
  change (p ≫ U.ι).fromNormalization ((p ≫ U.ι).toNormalization y) ∈ U
  rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
  exact (p y).2

attribute [local instance] normNonempty

variable [IsIntegral X] [CharZero k] [IsAlgClosed k] [IsCurveOver k X] [Etale p] [IsIntegral Y]
  [Nonempty U]

omit [CharZero k] [IsAlgClosed k] in
variable (k) in
include k in
/-- `q` maps the generic point of `N` to the generic point of `X`. -/
lemma normGeneric :
    (p ≫ U.ι).fromNormalization (genericPoint (p ≫ U.ι).normalization) = genericPoint X :=
  fromNormalization_genericPoint (k := k) ⟨_, (Classical.arbitrary U).2⟩ p

omit [IsIntegral X] in
/-- **`N` is a curve over `k`.** -/
lemma normCurve : IsCurveOver k (p ≫ U.ι).normalization :=
  isCurveOver_normalization (k := k) ⟨_, (Classical.arbitrary U).2⟩ p

attribute [local instance] normCurve

variable (D : GaloisData k t) (eL : X.functionField ≃+* D.L)
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t) [IsSepClosed Ω] [IsGalois (K₀ k t) Ω]

/-- **Centred places of the compactified cover** (`U` affine): a place `W` is centred on
`q⁻¹U ≅ Y` (for the Galois data of `N`) iff it is centred on `U`. -/
theorem isCentredOn_normalization_iff (hU : IsAffineOpen U) {W : ValuationSubring Ω} :
    IsCentredOn (coverData D eL hk hτ _ rfl (normGeneric k p)) _
        (coverEL D eL hk hτ _ rfl (normGeneric k p)) ((p ≫ U.ι).fromNormalization ⁻¹ᵁ U) W ↔
      IsCentredOn D X eL U W :=
  isCentredOn_cover_iff D eL hk hτ _ rfl (normGeneric k p) U
    (isIntegral_normalization_app p hU)

/-- The geometric generic point of `Y`, through `Spec L' ⟶ q⁻¹U ≅ Y`. -/
def genericY : Spec (.of (coverData D eL hk hτ _ rfl (normGeneric k p)).L) ⟶ Y :=
  genericL _ _ (coverEL D eL hk hτ _ rfl (normGeneric k p)) _ ≫ (normIso p).inv

lemma specPoint_genericY :
    (specPoint (coverData D eL hk hτ _ rfl (normGeneric k p)).L Ω ≫ genericY p D eL hk hτ) ≫ p =
      specPoint D.L Ω ≫ genericL D X eL U := by
  rw [genericY, Category.assoc, Category.assoc, normIso_inv_comp, ← Category.assoc]
  exact specPoint_coverGenericL D eL hk hτ _ rfl (normGeneric k p) U

/-- **Naturality for the cover `p : Y ⟶ U`**: `π₁ᵉᵗ(Y) → π₁ᵉᵗ(U)` intertwines the Galois action
of `H' = Gal(Ω / L')` (Galois data of the compactified cover, at the generic point of `Y`) with
that of `H ⊇ H'` on `π₁ᵉᵗ(U)`. -/
theorem fundamentalGroupMap_genericY (hH : D.H ≤ D.HL)
    (σ : (coverData D eL hk hτ _ rfl (normGeneric k p)).H) :
    fundamentalGroupMap p (specPoint_genericY p D eL hk hτ)
      ((coverData D eL hk hτ _ rfl (normGeneric k p)).chartHom le_rfl (genericY p D eL hk hτ) σ) =
      D.chartHom hH (genericL D X eL U)
        (Subgroup.inclusion (coverData_H_le_H D eL hk hτ _ rfl (normGeneric k p)) σ) :=
  fundamentalGroupMap_chartHom_of_le _ hH _ _ _ _ _ σ

end Normalization

end CurvesJacobian.Cusp
