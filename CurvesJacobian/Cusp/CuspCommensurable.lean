import CurvesJacobian.Cusp.SingleCusp

/-!
# Cuspidal inertia groups of distinct cusps are not commensurable (MR8.3)

[AbsTopI] Lemma 4.1 (i) (`Topics in Absolute Anabelian Geometry I.txt` l.2742–2745): the
decomposition group of a cusp "is a torsion-free, commensurably terminal infinite subgroup of
`Δ`". This file proves the step of the algebraic route to commensurable terminality that
separates distinct cusps, by filling in one of them.

Setting of `CurvesJacobian.Cusp.Inertia`.

* `CurvesJacobian.Cusp.map_cuspInertia_homOfLE`: **functoriality of cuspidal inertia under
  filling**: for `U ⊆ V`, the map `π₁ᵉᵗ(U) → π₁ᵉᵗ(V)` sends `cuspInertia U W` onto
  `cuspInertia V W` (both are generated by the images of the same Galois inertia elements);
* `CurvesJacobian.Cusp.relIndex_cuspInertia_eq_zero`: **distinct cusps are not commensurable**:
  if `W` is centred on `V ⊇ U` but not on `U` (a place over a cusp in `V ∖ U`) and
  `cuspInertia V W'` is nontrivial and torsion-free, then `cuspInertia U W ∩ cuspInertia U W'` has
  infinite index in `cuspInertia U W'` (`relIndex = 0`): the filling map kills `cuspInertia U W`
  and maps `cuspInertia U W'` onto `cuspInertia V W'`, which would otherwise be finite;
* `CurvesJacobian.Cusp.exists_opens_coe_eq_insert`: `U ∪ {y}` is open for `U` with finite
  complement;
* `CurvesJacobian.Cusp.comapK_comap_eq_of_relIndex_ne_zero`: **a Galois element commensurating a
  cuspidal inertia group fixes its cusp**: if the image `γ ∈ π₁ᵉᵗ(U)` of `σ ∈ H` satisfies
  `[γ I_W γ⁻¹ : I_W ∩ γ I_W γ⁻¹] < ∞`, then `σ(W)` lies over the same point of `X ∖ U` as `W`,
  provided the cuspidal inertia groups of `σ(W)` after filling in other cusps are nontrivial and
  torsion-free.
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale
open Pi1.Orbifold AffOrbicurve

universe u

noncomputable section

namespace CurvesJacobian.Cusp

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} (D : GaloisData k t)
  (X : Scheme.{u}) [X.Over (Spec (CommRingCat.of k))] [IsIntegral X]
  (eL : X.functionField ≃+* D.L)
  [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] (hH : D.H ≤ D.HL)

omit [X.Over (Spec (CommRingCat.of k))] in
/-- **Functoriality of cuspidal inertia under filling**: for `U ⊆ V`, the map
`π₁ᵉᵗ(U) → π₁ᵉᵗ(V)` sends `cuspInertia U W` onto `cuspInertia V W`. -/
theorem map_cuspInertia_homOfLE {U V : X.Opens} [Nonempty U] [Nonempty V] (h : U ≤ V)
    (W : ValuationSubring Ω) :
    (cuspInertia D X eL hH U W).map
        (fundamentalGroupMap (X.homOfLE h) (specPoint_genericL_homOfLE D X eL h)).toMonoidHom =
      cuspInertia D X eL hH V W := by
  rw [cuspInertia, cuspInertia, MonoidHom.map_closure, Set.image_image]
  congr 1
  exact Set.image_congr (fun σ _ ↦ fundamentalGroupMap_genericL D X eL hH h σ)

variable [IsAlgClosed k] [CharZero k] [IsCurveOver k X]
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)

omit [IsAlgClosed k] in
include hk hτ in
/-- **Distinct cusps are not commensurable.** Let `U ⊆ V` (nonempty, finite complements), `W` a
place centred on `V` but not on `U`, and `W'` a place whose cuspidal inertia group in
`π₁ᵉᵗ(V)` is nontrivial and torsion-free. Then `cuspInertia U W ∩ cuspInertia U W'` has infinite
index in `cuspInertia U W'`. -/
theorem relIndex_cuspInertia_eq_zero {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hU : (U : Set X)ᶜ.Finite) (hV : (V : Set X)ᶜ.Finite) (h : U ≤ V)
    {W W' : ValuationSubring Ω} (hWV : IsCentredOn D X eL V W) (hWU : ¬ IsCentredOn D X eL U W)
    (hne : cuspInertia D X eL hH V W' ≠ ⊥)
    (htf : ∀ g ∈ cuspInertia D X eL hH V W', IsOfFinOrder g → g = 1) :
    (cuspInertia D X eL hH U W).relIndex (cuspInertia D X eL hH U W') = 0 := by
  let f := (fundamentalGroupMap (X.homOfLE h) (specPoint_genericL_homOfLE D X eL h)).toMonoidHom
  by_contra h0
  have hker : cuspInertia D X eL hH U W ≤ f.ker :=
    cuspInertia_le_ker D X eL hH hk hτ hU hV h hWV hWU
  have hdvd := Subgroup.relIndex_dvd_of_le_left (cuspInertia D X eL hH U W') hker
  have hcard : Nat.card ((cuspInertia D X eL hH U W').map f) ≠ 0 := by
    rw [← Subgroup.relIndex_ker]
    intro h0'
    rw [h0'] at hdvd
    exact h0 (Nat.eq_zero_of_zero_dvd hdvd)
  rw [map_cuspInertia_homOfLE D X eL hH h W'] at hcard
  haveI := Nat.finite_of_card_ne_zero hcard
  refine hne ((Subgroup.eq_bot_iff_forall _).2 fun g hg ↦ htf g hg ?_)
  exact (cuspInertia D X eL hH V W').subtype.isOfFinOrder (isOfFinOrder_of_finite ⟨g, hg⟩)

omit [IsAlgClosed k] in
variable (k) in
include k in
/-- For `U` nonempty with finite complement, `U ∪ {y}` is open (the points outside `U` are
closed). -/
lemma exists_opens_coe_eq_insert (U : X.Opens) [Nonempty U] (hU : (U : Set X)ᶜ.Finite) (y : X) :
    ∃ V : X.Opens, (V : Set X) = insert y (U : Set X) := by
  refine ⟨⟨insert y (U : Set X), ?_⟩, rfl⟩
  have hc : (insert y (U : Set X))ᶜ = (U : Set X)ᶜ \ {y} := by
    ext x
    simp [not_or, and_comm]
  rw [← isClosed_compl_iff, hc, ← Set.biUnion_of_singleton ((U : Set X)ᶜ \ {y})]
  refine (hU.subset Set.sdiff_subset).isClosed_biUnion fun x hx ↦ ?_
  refine isClosed_closedPoint k X ⟨x, fun hxg ↦ hx.1 ?_⟩
  obtain ⟨u⟩ := ‹Nonempty U›
  rw [hxg]
  exact ((genericPoint_spec X).mem_open_set_iff U.isOpen).2 ⟨u.1, trivial, u.2⟩

omit [IsAlgClosed k] in
include hk hτ in
/-- **A Galois element commensurating a cuspidal inertia group fixes its cusp.** Let `W ⊇ k` be
a place not centred on `U` (a place over a cusp of `U`), `σ ∈ H` with image `γ ∈ π₁ᵉᵗ(U)`, and
suppose `I_W ∩ γ I_W γ⁻¹` has finite index in `γ I_W γ⁻¹ = I_{σ(W)}`. If the cuspidal inertia
group of `σ(W)` stays nontrivial and torsion-free after filling in any set of cusps not containing
the cusp under `σ(W)`, then `σ(W)` lies over the same point of `X ∖ U` as `W`. -/
theorem comapK_comap_eq_of_relIndex_ne_zero {U : X.Opens} [Nonempty U]
    (hU : (U : Set X)ᶜ.Finite) {W : ValuationSubring Ω} (hkW : ∀ c : k, algebraMap k Ω c ∈ W)
    (hWU : ¬ IsCentredOn D X eL U W) (σ : D.H)
    (hcusp : ∀ (V : X.Opens) [Nonempty V], (V : Set X)ᶜ.Finite → U ≤ V →
      ¬ IsCentredOn D X eL V (W.comap ((σ : Ω ≃ₐ[K₀ k t] Ω).symm : Ω →+* Ω)) →
      cuspInertia D X eL hH V (W.comap ((σ : Ω ≃ₐ[K₀ k t] Ω).symm : Ω →+* Ω)) ≠ ⊥ ∧
      ∀ g ∈ cuspInertia D X eL hH V (W.comap ((σ : Ω ≃ₐ[K₀ k t] Ω).symm : Ω →+* Ω)),
        IsOfFinOrder g → g = 1)
    (hcomm : (cuspInertia D X eL hH U W).relIndex ((cuspInertia D X eL hH U W).map
      (MulAut.conj (D.chartHom hH (genericL D X eL U) σ)).toMonoidHom) ≠ 0) :
    comapK D X eL hk (W.comap ((σ : Ω ≃ₐ[K₀ k t] Ω).symm : Ω →+* Ω)) = comapK D X eL hk W := by
  let W' : ValuationSubring Ω := W.comap ((σ : Ω ≃ₐ[K₀ k t] Ω).symm : Ω →+* Ω)
  have hkW' : ∀ c : k, algebraMap k Ω c ∈ W' := fun c ↦ by
    change (σ : Ω ≃ₐ[K₀ k t] Ω).symm (algebraMap k Ω c) ∈ W
    rw [IsScalarTower.algebraMap_apply k (K₀ k t) Ω, AlgEquiv.commutes]
    rw [← IsScalarTower.algebraMap_apply k (K₀ k t) Ω]
    exact hkW c
  have hW'U : ¬ IsCentredOn D X eL U W' := (isCentredOn_comap_iff D X eL U (hH σ.2) W).not.2 hWU
  obtain ⟨y, hyU, hy⟩ := exists_notMem_of_not_isCentredOn D X eL hk U hkW hWU
  obtain ⟨y', hy'U, hy'⟩ := exists_notMem_of_not_isCentredOn D X eL hk U hkW' hW'U
  by_cases hyy : y' = y
  · change comapK D X eL hk W' = _
    rw [← hy, ← hy', hyy]
  exfalso
  obtain ⟨V, hVeq⟩ := exists_opens_coe_eq_insert k X U hU y
  have hyV : y ∈ V := by
    rw [← SetLike.mem_coe, hVeq]
    exact Set.mem_insert _ _
  haveI : Nonempty V := ⟨⟨y, hyV⟩⟩
  have h : U ≤ V := fun x hx ↦ by
    rw [← SetLike.mem_coe, hVeq]
    exact Set.mem_insert_of_mem _ hx
  have hV : (V : Set X)ᶜ.Finite := by
    rw [hVeq]
    exact hU.subset (Set.compl_subset_compl.2 (Set.subset_insert _ _))
  have hWV : IsCentredOn D X eL V W := by
    refine ⟨hkW, fun a ↦ ?_⟩
    have hmem : X.germToFunctionField V a ∈ stalkVS k y :=
      ⟨X.presheaf.germ _ y hyV a, by rw [Scheme.algebraMap_germ_eq_germToFunctionField]⟩
    rw [hy] at hmem
    exact hmem
  have hW'V : ¬ IsCentredOn D X eL V W' := fun hW'V ↦ by
    have hy'V := mem_of_isCentredOn D X eL hk V hV hW'V hy'
    rw [← SetLike.mem_coe, hVeq] at hy'V
    rcases hy'V with h' | h'
    · exact hyy h'
    · exact hy'U h'
  obtain ⟨hne, htf⟩ := hcusp V hV h hW'V
  apply hcomm
  rw [← cuspInertia_comap]
  exact relIndex_cuspInertia_eq_zero D X eL hH hk hτ hU hV h hWV hWU hne htf

end CurvesJacobian.Cusp
