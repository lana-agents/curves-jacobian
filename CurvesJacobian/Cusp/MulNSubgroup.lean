import CurvesJacobian.Cusp.DupSubgroup
import CurvesJacobian.Cusp.EllipticChainEN
import EllipticCurves.FunctionField.TranslationMulByNCommGeneral

/-!
# The `[N]`-subgroup of `Π_{E∖O}` is group-theoretic on `Δ` ([AbsTopII] Cor 3.4, step G1)

The general-`N` version of `Cusp/DupSubgroup.lean` (`N = 2`). Let `E` be an elliptic curve over
a number field `K` with `#E(K)[N] = N²` (`TorsionCardN E N`, i.e. all of `E[N]` is `K`-rational),
`X = E ∖ {O}`, `Π = Π_X`, `Δ = ker(Π ↠ G_K)`, and let `Π_U ⊆ Π` (`mulNPiU`) be the image of
`π₁(E ∖ E[N])` under `[N] : E ∖ E[N] → E ∖ {O}` (`mulByNXMor`). Let `Δ^N [Δ, Δ]`
(`mulNClosure Δ N`) be the closed subgroup topologically generated by the `N`-th powers and the
commutators of elements of `Δ`.

Main results:
* `autN_bijective`, `isGalois_mulByNXMor`: the automorphisms of the cover `[N]` are exactly the
  `N²` translations by `E[N]` (`autN`; translation by `T ∈ E[N]` fixes `[N]^* K(E)`,
  `translateEndo_mulByNEndo_apply_torsion_of_baseField` of `elliptic-curves`), the cover is
  Galois, and `Aut([N])` is commutative of exponent dividing `N` (`aut_mulByNXMor_comm`,
  `aut_mulByNXMor_pow`); the geometric generic fibre has at most `[K(E) : [N]^* K(E)] = N²`
  points (`finite_card_fibre_leN`);
* `mulNPiU_index`, `pow_mem_mulNPiU`, `commutator_mem_mulNPiU`, `mulNPiU_normal`: `Π_U` is
  normal and open of index `N²` in `Π`, and contains all `g^N` and all commutators;
* `Delta_sup_mulNPiU`: `Δ · Π_U = Π` (`E ∖ E[N]` is geometrically connected);
* `mulNPiU_inf_Delta`: **`Π_U ⊓ Δ = Δ^N [Δ, Δ]`**, given that `Δ ≅ Π̂_{1,1}`;
* `map_mulNPiU_inf_Delta`: an isomorphism `Φ : Π_{X₁} ≅ Π_{X₂}` of cuspidal extensions maps
  `Π_{U₁} ⊓ Δ₁` onto `Π_{U₂} ⊓ Δ₂`.

The group-theoretic core is `inf_eq_mulNClosure`: for a closed normal `Δ ⊴ Π` topologically
generated by two elements and a closed normal `H ⊴ Π` of index `N²` with `g^N ∈ H` and
`[g, h] ∈ H` for all `g, h` and `Δ H = Π`, one has `H ∩ Δ = Δ^N [Δ, Δ]`
(`Δ / Δ^N [Δ, Δ]` is a quotient of `(ℤ/N)²`, `relIndex_mulNClosure_le`).

`Topics in Absolute Anabelian Geometry II.txt` l.4540–4600 (Cor 3.4).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale PreGaloisCategory
  Belyi Belyi.Anabelian

universe u

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace CurvesJacobian.Cusp

/-! ### The closed subgroup generated by `N`-th powers and commutators -/

section PowComm

variable {P : Type*} [Group P] [TopologicalSpace P] [IsTopologicalGroup P]

/-- The `N`-th powers and the commutators of elements of `D`. -/
def mulNGenSet (D : Subgroup P) (N : ℕ) : Set P :=
  {x | (∃ d ∈ D, d ^ N = x) ∨ ∃ d ∈ D, ∃ e ∈ D, d * e * d⁻¹ * e⁻¹ = x}

/-- `D^N [D, D]`: the closed subgroup topologically generated by the `N`-th powers and the
commutators of elements of `D`. -/
def mulNClosure (D : Subgroup P) (N : ℕ) : Subgroup P :=
  (Subgroup.closure (mulNGenSet D N)).topologicalClosure

lemma pow_mem_mulNClosure {D : Subgroup P} (N : ℕ) {d : P} (hd : d ∈ D) :
    d ^ N ∈ mulNClosure D N :=
  Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (Or.inl ⟨d, hd, rfl⟩))

lemma commutator_mem_mulNClosure {D : Subgroup P} (N : ℕ) {d e : P} (hd : d ∈ D) (he : e ∈ D) :
    d * e * d⁻¹ * e⁻¹ ∈ mulNClosure D N :=
  Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (Or.inr ⟨d, hd, e, he, rfl⟩))

lemma mulNClosure_le {D H : Subgroup P} {N : ℕ} (hH : IsClosed (H : Set P))
    (hpow : ∀ d ∈ D, d ^ N ∈ H) (hcomm : ∀ d ∈ D, ∀ e ∈ D, d * e * d⁻¹ * e⁻¹ ∈ H) :
    mulNClosure D N ≤ H :=
  Subgroup.topologicalClosure_minimal _ ((Subgroup.closure_le H).2 (by
    rintro _ (⟨d, hd, rfl⟩ | ⟨d, hd, e, he, rfl⟩)
    · exact hpow d hd
    · exact hcomm d hd e he)) hH

lemma isClosed_mulNClosure (D : Subgroup P) (N : ℕ) : IsClosed (mulNClosure D N : Set P) :=
  Subgroup.isClosed_topologicalClosure _

omit [TopologicalSpace P] [IsTopologicalGroup P] in
lemma closure_mulNGenSet_normal (D : Subgroup P) [hD : D.Normal] (N : ℕ) :
    (Subgroup.closure (mulNGenSet D N)).Normal := by
  refine ⟨fun n hn g ↦ ?_⟩
  induction hn using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ⟨d, hd, rfl⟩ | ⟨d, hd, e, he, rfl⟩
    · refine Subgroup.subset_closure (Or.inl ⟨g * d * g⁻¹, hD.conj_mem d hd g, ?_⟩)
      have h := map_pow (MulAut.conj g) d N
      simp only [MulAut.conj_apply] at h
      exact h.symm
    · exact Subgroup.subset_closure (Or.inr ⟨g * d * g⁻¹, hD.conj_mem d hd g,
        g * e * g⁻¹, hD.conj_mem e he g, by group⟩)
  | one => simp
  | mul x y _ _ hx hy =>
    rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
    exact mul_mem hx hy
  | inv x _ hx =>
    rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
    exact inv_mem hx

instance mulNClosure_normal (D : Subgroup P) [D.Normal] (N : ℕ) : (mulNClosure D N).Normal :=
  haveI := closure_mulNGenSet_normal D N
  Subgroup.is_normal_topologicalClosure _

/-- Two commuting elements `u, v` with `u^N = v^N = 1` generate a subgroup contained in
`{u^i v^j | i, j < N}`. -/
lemma closure_pair_subset_rangeN {Q : Type*} [Group Q] {N : ℕ} (hN : N ≠ 0) {u v : Q}
    (hu : u ^ N = 1) (hv : v ^ N = 1) (huv : u * v = v * u) :
    ∀ z ∈ Subgroup.closure ({u, v} : Set Q),
      z ∈ Set.range (fun ij : Fin N × Fin N ↦ u ^ (ij.1 : ℕ) * v ^ (ij.2 : ℕ)) := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hN
  have hvu : Commute v u := huv.symm
  have hmul : ∀ i j k l : ℕ, u ^ i * v ^ j * (u ^ k * v ^ l) = u ^ (i + k) * v ^ (j + l) := by
    intro i j k l
    rw [pow_add, pow_add, mul_assoc, ← mul_assoc (v ^ j), (hvu.pow_pow j k).eq]
    simp only [mul_assoc]
  have hpow : ∀ (w : Q), w ^ (n + 1) = 1 → ∀ i : ℕ, w ^ (i + i * n) = 1 := by
    intro w hw i
    rw [show i + i * n = (n + 1) * i by ring, pow_mul, hw, one_pow]
  have key : ∀ z ∈ Subgroup.closure ({u, v} : Set Q), ∃ i j : ℕ, u ^ i * v ^ j = z := by
    intro z hz
    induction hz using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨1, 0, by simp⟩
      · exact ⟨0, 1, by simp⟩
    | one => exact ⟨0, 0, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨i, j, rfl⟩ := hx
      obtain ⟨k, l, rfl⟩ := hy
      exact ⟨i + k, j + l, (hmul i j k l).symm⟩
    | inv x _ hx =>
      obtain ⟨i, j, rfl⟩ := hx
      refine ⟨i * n, j * n, (inv_eq_of_mul_eq_one_right ?_).symm⟩
      rw [hmul, hpow u hu, hpow v hv, one_mul]
  intro z hz
  obtain ⟨i, j, rfl⟩ := key z hz
  refine ⟨(⟨i % (n + 1), Nat.mod_lt _ n.succ_pos⟩, ⟨j % (n + 1), Nat.mod_lt _ n.succ_pos⟩), ?_⟩
  change u ^ (i % (n + 1)) * v ^ (j % (n + 1)) = _
  rw [← pow_eq_pow_mod i hu, ← pow_eq_pow_mod j hv]

/-- **`[D : D^N [D, D]] ≤ N²`** if `D` is closed, normal and topologically generated by two
elements. -/
theorem relIndex_mulNClosure_le {D : Subgroup P} [D.Normal] {N : ℕ} (hN : N ≠ 0) {a b : P}
    (hgen : (Subgroup.closure ({a, b} : Set P)).topologicalClosure = D) :
    (mulNClosure D N).relIndex D ≤ N ^ 2 ∧ (mulNClosure D N).relIndex D ≠ 0 := by
  have hmem : ∀ x ∈ Subgroup.closure ({a, b} : Set P), x ∈ D := fun x hx ↦
    hgen ▸ Subgroup.le_topologicalClosure _ hx
  have ha : a ∈ D := hmem a (Subgroup.subset_closure (by simp))
  have hb : b ∈ D := hmem b (Subgroup.subset_closure (by simp))
  set C := mulNClosure D N with hC
  haveI : IsClosed (C : Set P) := isClosed_mulNClosure D N
  have hu : (QuotientGroup.mk' C a) ^ N = 1 := by
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact pow_mem_mulNClosure N ha
  have hv : (QuotientGroup.mk' C b) ^ N = 1 := by
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact pow_mem_mulNClosure N hb
  have huv : QuotientGroup.mk' C a * QuotientGroup.mk' C b =
      QuotientGroup.mk' C b * QuotientGroup.mk' C a := by
    rw [← commutatorElement_eq_one_iff_mul_comm, commutatorElement_def, ← map_inv, ← map_inv,
      ← map_mul, ← map_mul, ← map_mul, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact commutator_mem_mulNClosure N ha hb
  have hF := closure_pair_subset_rangeN hN hu hv huv
  set f : Fin N × Fin N → P ⧸ C := fun ij ↦
    QuotientGroup.mk' C a ^ (ij.1 : ℕ) * QuotientGroup.mk' C b ^ (ij.2 : ℕ) with hfdef
  set F : Set (P ⧸ C) := Set.range f with hFdef
  have hcl : IsClosed ((QuotientGroup.mk' C) ⁻¹' F) :=
    (Set.finite_range f).isClosed.preimage QuotientGroup.continuous_mk
  have hsub : (Subgroup.closure ({a, b} : Set P) : Set P) ⊆ (QuotientGroup.mk' C) ⁻¹' F := by
    intro x hx
    apply hF
    have h1 := Subgroup.mem_map_of_mem (QuotientGroup.mk' C) hx
    rwa [MonoidHom.map_closure, Set.image_pair] at h1
  have hD : (D : Set P) ⊆ (QuotientGroup.mk' C) ⁻¹' F := by
    intro x hx
    have hx' : x ∈ (Subgroup.closure ({a, b} : Set P)).topologicalClosure := hgen.symm ▸ hx
    have h := closure_minimal hsub hcl
    rw [← Subgroup.topologicalClosure_coe] at h
    exact h hx'
  let φ : D →* P ⧸ C := (QuotientGroup.mk' C).comp D.subtype
  have hker : C.subgroupOf D = φ.ker := by
    ext x
    simp [φ, Subgroup.mem_subgroupOf, QuotientGroup.eq_one_iff]
  have hrange : ∀ z ∈ φ.range, z ∈ F := by
    rintro _ ⟨x, rfl⟩
    exact hD x.2
  let ι : φ.range → F := fun z ↦ ⟨z.1, hrange z.1 z.2⟩
  have hι : Function.Injective ι := fun z w h ↦ Subtype.ext (by
    have h' := congrArg Subtype.val h
    exact h')
  haveI : Finite F := Set.finite_range f
  haveI : Finite φ.range := Finite.of_injective ι hι
  have hidx : C.relIndex D = Nat.card φ.range := by
    rw [Subgroup.relIndex, hker, Subgroup.index_ker]
  have hF2 : Nat.card F ≤ N ^ 2 := by
    refine (Finite.card_range_le f).trans (le_of_eq ?_)
    rw [Nat.card_prod, Nat.card_eq_fintype_card, Fintype.card_fin, sq]
  refine ⟨hidx ▸ (Nat.card_le_card_of_injective ι hι).trans hF2, ?_⟩
  rw [hidx]
  exact Nat.card_pos.ne'

/-- **The group-theoretic core of [AbsTopII] Cor 3.4 (G1) for `[N]`**: let `D ⊴ P` be closed and
topologically generated by two elements, and `H ⊴ P` closed of index `N²` such that `P / H` is
abelian of exponent dividing `N` (`g^N ∈ H`, `[g, h] ∈ H`) and `D ⊔ H = P`. Then
`H ⊓ D = D^N [D, D]`. -/
theorem inf_eq_mulNClosure {D H : Subgroup P} [D.Normal] [H.Normal] {N : ℕ} (hN : N ≠ 0)
    (hD : IsClosed (D : Set P)) (hH : IsClosed (H : Set P)) (hidx : H.index = N ^ 2)
    (hpow : ∀ g : P, g ^ N ∈ H) (hcomm : ∀ g h : P, g * h * g⁻¹ * h⁻¹ ∈ H)
    (hsup : D ⊔ H = ⊤) {a b : P}
    (hgen : (Subgroup.closure ({a, b} : Set P)).topologicalClosure = D) :
    H ⊓ D = mulNClosure D N := by
  obtain ⟨hle2, h0⟩ := relIndex_mulNClosure_le hN hgen
  have hle : mulNClosure D N ≤ H ⊓ D :=
    le_inf (mulNClosure_le hH (fun d _ ↦ hpow d) fun d _ e _ ↦ hcomm d e)
      (mulNClosure_le hD (fun d hd ↦ pow_mem hd N) fun d hd e he ↦
        mul_mem (mul_mem (mul_mem hd he) (inv_mem hd)) (inv_mem he))
  have hHD : (H ⊓ D).relIndex D = N ^ 2 := by
    rw [Subgroup.inf_relIndex_right, ← Subgroup.relIndex_sup_right, hsup,
      Subgroup.relIndex_top_right, hidx]
  have hmul := Subgroup.relIndex_mul_relIndex _ _ _ hle (inf_le_right : H ⊓ D ≤ D)
  rw [hHD] at hmul
  have hpos : 0 < N ^ 2 := pow_pos (Nat.pos_of_ne_zero hN) 2
  have h1 : (mulNClosure D N).relIndex (H ⊓ D) = 1 := by
    have h2 : (mulNClosure D N).relIndex (H ⊓ D) * N ^ 2 ≤ 1 * N ^ 2 := by
      rw [hmul, one_mul]
      exact hle2
    have h3 := Nat.le_of_mul_le_mul_right h2 hpos
    have h4 : (mulNClosure D N).relIndex (H ⊓ D) ≠ 0 := by
      intro h
      rw [h, zero_mul] at hmul
      exact h0 hmul.symm
    omega
  exact le_antisymm (Subgroup.relIndex_eq_one.1 h1) hle

/-- `D^N [D, D]` is transported by isomorphisms of topological groups. -/
theorem map_mulNClosure {Q : Type*} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    (e : P ≃ₜ* Q) (D : Subgroup P) (N : ℕ) :
    (mulNClosure D N).map e.toMulEquiv.toMonoidHom =
      mulNClosure (D.map e.toMulEquiv.toMonoidHom) N := by
  apply SetLike.coe_injective
  have hc : ⇑e.toMulEquiv.toMonoidHom = ⇑e.toHomeomorph := rfl
  rw [Subgroup.coe_map, mulNClosure, mulNClosure, Subgroup.topologicalClosure_coe,
    Subgroup.topologicalClosure_coe, hc, Homeomorph.image_closure, ← hc, ← Subgroup.coe_map,
    MonoidHom.map_closure]
  congr 3
  ext y
  constructor
  · rintro ⟨_, ⟨d, hd, rfl⟩ | ⟨d, hd, f, hf, rfl⟩, rfl⟩
    · exact Or.inl ⟨e d, ⟨d, hd, rfl⟩, (map_pow _ d N).symm⟩
    · refine Or.inr ⟨e d, ⟨d, hd, rfl⟩, e f, ⟨f, hf, rfl⟩, ?_⟩
      simp only [map_mul, map_inv]
      rfl
  · rintro (⟨_, ⟨d, hd, rfl⟩, rfl⟩ | ⟨_, ⟨d, hd, rfl⟩, _, ⟨f, hf, rfl⟩, rfl⟩)
    · exact ⟨d ^ N, Or.inl ⟨d, hd, rfl⟩, map_pow _ d N⟩
    · refine ⟨d * f * d⁻¹ * f⁻¹, Or.inr ⟨d, hd, f, hf, rfl⟩, ?_⟩
      simp only [map_mul, map_inv]

end PowComm

/-- **An isomorphism of cuspidal extensions maps `Δ^N [Δ, Δ]` onto `Δ^N [Δ, Δ]`.** -/
theorem _root_.Belyi.Anabelian.CuspidalExt.Iso.map_mulNClosure₂ {A B : CuspidalExt}
    (Φ : A.Iso B) (N : ℕ) :
    (mulNClosure A.Delta N).map Φ.pi.toMulEquiv.toMonoidHom = mulNClosure B.Delta N := by
  rw [CurvesJacobian.Cusp.map_mulNClosure, Φ.map_Delta₂]

/-! ### Galois objects with abelian automorphism group of exponent `N` -/

section GaloisAbelian

variable {C : Type*} [Category C] [GaloisCategory C] (F : C ⥤ FintypeCat.{u}) [FiberFunctor F]

omit [GaloisCategory C] [FiberFunctor F] in
lemma smul_comm_autN (A : C) (σ : Aut F) (a : Aut A) (x : F.obj A) :
    σ • (a • x) = a • (σ • x) :=
  NatTrans.naturality_apply σ.hom a.hom x

/-- If `a^n = 1` for every automorphism `a` of the Galois object `A`, then `σ^n ∈ Stab(x)` for
every `σ ∈ Aut F`. -/
theorem pow_mem_stabilizer_of_pow_eq_one (A : C) [IsGalois A] {n : ℕ}
    (hA : ∀ a : Aut A, a ^ n = 1) (x : F.obj A) (σ : Aut F) :
    σ ^ n ∈ MulAction.stabilizer (Aut F) x := by
  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq (Aut A) x (σ • x)
  have key : ∀ k : ℕ, σ ^ k • x = a ^ k • x := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ', mul_smul, ih, smul_comm_autN, ← ha, ← mul_smul, ← pow_succ]
  rw [MulAction.mem_stabilizer_iff, key, hA, one_smul]

/-- If the automorphism group of the Galois object `A` is commutative, then every commutator of
`Aut F` stabilises every point of the fibre of `A`. -/
theorem commutator_mem_stabilizer_of_comm (A : C) [IsGalois A]
    (hA : ∀ a b : Aut A, a * b = b * a) (x : F.obj A) (σ τ : Aut F) :
    σ * τ * σ⁻¹ * τ⁻¹ ∈ MulAction.stabilizer (Aut F) x := by
  have hx : ∀ y : F.obj A, σ • τ • y = τ • σ • y := by
    intro y
    obtain ⟨b, rfl⟩ := MulAction.exists_smul_eq (Aut A) x y
    obtain ⟨a, ha⟩ := MulAction.exists_smul_eq (Aut A) x (σ • x)
    obtain ⟨c, hc⟩ := MulAction.exists_smul_eq (Aut A) x (τ • x)
    rw [smul_comm_autN F A τ b x, smul_comm_autN F A σ b (τ • x),
      smul_comm_autN F A σ b x, smul_comm_autN F A τ b (σ • x)]
    congr 1
    rw [← hc, ← ha, smul_comm_autN F A σ c x, smul_comm_autN F A τ a x, ← ha, ← hc,
      ← mul_smul, ← mul_smul, hA c a]
  rw [MulAction.mem_stabilizer_iff]
  simp only [mul_smul]
  rw [hx, smul_inv_smul, smul_inv_smul]

end GaloisAbelian

/-! ### The translations by `E[N]` act on `B_N = K[E][1/ψ_N]` over `[N]^*` -/

section TranslationsN

open Polynomial WeierstrassCurve.Affine WeierstrassCurve.Affine.CoordinateRing

variable {K : Type u} [Field K] [CharZero K] (E : WeierstrassCurve K) [E.IsElliptic] (N : ℕ)
  [NeZero N]

local notation "A" => E.toAffine.CoordinateRing
local notation "FF" => E.toAffine.FunctionField
local notation "ι" => algebraMap (coverRingN E N) E.toAffine.FunctionField

instance isIntegrallyClosed_coverRingN : IsIntegrallyClosed (coverRingN E N) :=
  isIntegrallyClosed_of_isLocalization (R := A) _ (Submonoid.powers (psiN E N))
    (powers_le_nonZeroDivisors_of_noZeroDivisors (psiN_ne_zero_of_neZero E N))

/-- `B_N` is integral over `K[E]` via `[N]^*`. -/
lemma mulByNHom_isIntegral : (mulByNHom E N).IsIntegral := fun b ↦
  Algebra.IsIntegral.isIntegral (R := A) (show MulByNB E N from b)

open Classical in
omit [CharZero K] [NeZero N] in
/-- **Translation by an `N`-torsion point fixes `[N]^* f`.** -/
theorem translateAut_mulByNEndo₂ {n : ℕ}
    (hn : Transcendental K (n • genericPoint (W := E.toAffine)).xCoord) {P : E.toAffine.Point}
    (hP : P ∈ E.toAffine.torsion n) (f : FF) :
    translateAut P (mulByNEndo n hn f) = mulByNEndo n hn f := by
  rcases P with _ | ⟨x, y, h⟩
  · rw [← Point.zero_def, translateAut_zero, AlgEquiv.one_apply]
  · rw [translateAut_apply_some]
    exact translateEndo_mulByNEndo_apply_torsion_of_baseField h.left n hn
      (mem_torsion_iff.mp hP) f

variable {E N}

open Classical in
/-- Translation by an `N`-torsion point, an automorphism of `K(E)`. -/
def tauN (P : E.toAffine.torsion N) : FF ≃ₐ[K] FF := translateAut (P : E.toAffine.Point)

omit [CharZero K] [NeZero N] in
lemma tauN_injective : Function.Injective (tauN (E := E) (N := N)) :=
  translateAut_injective.comp Subtype.val_injective

open Classical in
lemma tauN_mulByNHom (P : E.toAffine.torsion N) (a : A) :
    (tauN P).toRingEquiv (ι (mulByNHom E N a)) = ι (mulByNHom E N a) := by
  rw [algebraMap_mulByNHom]
  exact translateAut_mulByNEndo₂ E (transcendental_N E N) P.2 _

open Classical in
omit [CharZero K] [NeZero N] in
lemma tauN_add (P Q : E.toAffine.torsion N) (f : FF) :
    tauN (P + Q) f = tauN P (tauN Q f) := by
  rw [tauN, AddSubgroup.coe_add, translateAut_add, AlgEquiv.mul_apply]
  rfl

open Classical in
omit [CharZero K] [NeZero N] in
lemma tauN_zero (f : FF) : tauN (0 : E.toAffine.torsion N) f = f := by
  rw [tauN, ZeroMemClass.coe_zero, translateAut_zero, AlgEquiv.one_apply]

open Classical in
/-- Translation by an `N`-torsion point restricted to `B_N = K[E][1/ψ_N]`. -/
def sigmaN (P : E.toAffine.torsion N) : coverRingN E N ≃+* coverRingN E N :=
  restrictRingEquiv (mulByNHom E N) (mulByNHom_isIntegral E N) (tauN P).toRingEquiv
    (tauN_mulByNHom P)

open Classical in
lemma sigmaN_mulByNHom (P : E.toAffine.torsion N) (a : A) :
    sigmaN P (mulByNHom E N a) = mulByNHom E N a :=
  restrictRingEquiv_apply_self _ _ _ _ a

open Classical in
lemma algebraMap_sigmaN (P : E.toAffine.torsion N) (b : coverRingN E N) :
    ι (sigmaN P b) = tauN P (ι b) :=
  algebraMap_restrictRingEquiv _ _ _ _ b

lemma sigmaN_injective : Function.Injective (sigmaN (E := E) (N := N)) := fun _ _ h ↦
  tauN_injective (AlgEquiv.ext fun x ↦ RingEquiv.congr_fun
    (eq_of_restrictRingEquiv_eq _ _ _ _ h) x)

open Classical in
lemma sigmaN_sigmaN (P Q : E.toAffine.torsion N) (b : coverRingN E N) :
    sigmaN Q (sigmaN P b) = sigmaN (P + Q) b := by
  apply algebraMap_coverRingN_injective E N
  rw [algebraMap_sigmaN, algebraMap_sigmaN, algebraMap_sigmaN, add_comm, tauN_add]

open Classical in
lemma sigmaN_zero (b : coverRingN E N) : sigmaN (0 : E.toAffine.torsion N) b = b := by
  apply algebraMap_coverRingN_injective E N
  rw [algebraMap_sigmaN, tauN_zero]

end TranslationsN

/-! ### `[N] : E ∖ E[N] → E ∖ {O}` and its geometric generic fibre -/

section CoverN

open Polynomial WeierstrassCurve.Affine WeierstrassCurve.Affine.CoordinateRing

variable {K : Type u} [Field K] [CharZero K] (E : WeierstrassCurve K) [E.IsElliptic] (N : ℕ)
  [NeZero N]

local notation "A" => E.toAffine.CoordinateRing
local notation "FF" => E.toAffine.FunctionField
local notation "ι" => algebraMap (coverRingN E N) E.toAffine.FunctionField

instance isDomain_sectionsVNE : IsDomain Γ(curveE E, VNE E N) :=
  Function.Injective.isDomain (sectionsVNEEquiv E N).toRingHom (sectionsVNEEquiv E N).injective

/-- The geometric generic point of `X` *through* `[N]`: `K[E] →[N]^* K(E) ⊆ Ω`. -/
def zetaN : Γ(curveE E, XE E) ⟶ CommRingCat.of (OmegaE E) :=
  CommRingCat.ofHom ((algebraMap FF (OmegaE E)).comp
    (((algebraMap (coverRingN E N) FF).comp (mulByNHom E N)).comp
      (sectionsXEAlgEquiv E).toRingEquiv.toRingHom))

/-- A point of the fibre, as a map `B_N → Ω`. -/
def fibreHomN (g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E)) :
    coverRingN E N →+* OmegaE E :=
  g.hom.comp (sectionsVNEEquiv E N).symm.toRingHom

variable {E N}

lemma fibreHomN_mulByNHom {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E)}
    (hg : CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N) (a : A) :
    fibreHomN E N g (mulByNHom E N a) = algebraMap FF (OmegaE E) (ι (mulByNHom E N a)) := by
  have h := congrArg (fun φ ↦ φ.hom ((sectionsXEAlgEquiv E).symm a)) hg
  simpa [mulByNXHom, zetaN, fibreHomN] using h

lemma fibreHomN_injective {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E)}
    (hg : CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N) :
    Function.Injective (fibreHomN E N g) := by
  refine injective_of_isIntegral (mulByNHom E N) (mulByNHom_isIntegral E N) _ ?_
  have : (fibreHomN E N g).comp (mulByNHom E N) =
      (algebraMap FF (OmegaE E)).comp ((algebraMap (coverRingN E N) FF).comp (mulByNHom E N)) :=
    RingHom.ext (fibreHomN_mulByNHom hg)
  rw [this]
  exact (algebraMap FF (OmegaE E)).injective.comp
    ((algebraMap_coverRingN_injective E N).comp (mulByNHom_injective E N))

/-- The extension of a fibre point to `K(E) → Ω`. -/
def fibreLiftN {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E)}
    (hg : CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N) : FF →+* OmegaE E :=
  IsFractionRing.lift (fibreHomN_injective hg)

lemma fibreLiftN_algebraMap {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E)}
    (hg : CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N) (b : coverRingN E N) :
    fibreLiftN hg (ι b) = fibreHomN E N g b :=
  IsFractionRing.lift_algebraMap _ _

/-- A fibre point is the identity on `[N]^* K(E)`. -/
lemma fibreLiftN_mulByNEndo {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E)}
    (hg : CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N) (u : FF) :
    fibreLiftN hg (mulByNEndo N (transcendental_N E N) u) =
      algebraMap FF (OmegaE E) (mulByNEndo N (transcendental_N E N) u) := by
  have : (fibreLiftN hg).comp (mulByNEndo N (transcendental_N E N)) =
      (algebraMap FF (OmegaE E)).comp (mulByNEndo N (transcendental_N E N)) :=
    IsLocalization.ringHom_ext (nonZeroDivisors A) (RingHom.ext fun a ↦ by
      simp only [RingHom.coe_comp, Function.comp_apply]
      rw [← algebraMap_mulByNHom, fibreLiftN_algebraMap, fibreHomN_mulByNHom hg])
  exact RingHom.congr_fun this u

variable (E N)

/-- **The geometric generic fibre of `[N] : E ∖ E[N] → E ∖ {O}` has at most `N²` points**
(`[K(E) : [N]^* K(E)] = N²`, `finrank_mulByNFieldRange_eq_sq_of_isCoprime_ΨSq_adjacent`). -/
theorem finite_card_fibre_leN :
    Finite {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E) //
      CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N} ∧
    Nat.card {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E) //
      CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N} ≤ N ^ 2 := by
  set L' := (mulByNEndoAlgHom (W := E.toAffine) N (transcendental_N E N)).fieldRange
  letI : Algebra L' (OmegaE E) := ((algebraMap FF (OmegaE E)).comp (algebraMap L' FF)).toAlgebra
  have hdeg : Module.finrank L' FF = N ^ 2 :=
    finrank_mulByNFieldRange_eq_sq_of_isCoprime_ΨSq_adjacent two_ne_zero (intCast_N_ne_zero N)
      (isCoprime_ΨSq_adjacent two_ne_zero _)
  haveI : Module.Free L' FF := Module.Free.of_divisionRing L' FF
  haveI : Module.Finite L' FF := Module.finite_of_finrank_pos (by
    rw [hdeg]; exact pow_pos (Nat.pos_of_ne_zero (NeZero.ne N)) 2)
  let Φ : {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E) //
      CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N} → (FF →ₐ[L'] OmegaE E) := fun g ↦
    { fibreLiftN g.2 with
      commutes' := fun l ↦ by
        obtain ⟨u, hu⟩ := AlgHom.mem_fieldRange.1 l.2
        change fibreLiftN g.2 (l : FF) = algebraMap FF (OmegaE E) (l : FF)
        rw [← hu]
        exact fibreLiftN_mulByNEndo g.2 u }
  have hΦ : Function.Injective Φ := by
    intro g₁ g₂ h
    refine Subtype.ext (CommRingCat.hom_ext (RingHom.ext fun x ↦ ?_))
    have h' := DFunLike.congr_fun h (ι (sectionsVNEEquiv E N x))
    change fibreLiftN g₁.2 _ = fibreLiftN g₂.2 _ at h'
    simpa [fibreLiftN_algebraMap, fibreHomN] using h'
  exact ⟨Finite.of_injective Φ hΦ, (Nat.card_le_card_of_injective Φ hΦ).trans
    ((card_algHom_le_finrank L' FF (OmegaE E)).trans hdeg.le)⟩

variable {E N}

open Classical in
/-- Translation by an `N`-torsion point on `Γ(E ∖ E[N])`. -/
def rhoVN (P : E.toAffine.torsion N) : Γ(curveE E, VNE E N) ≅ Γ(curveE E, VNE E N) :=
  RingEquiv.toCommRingCatIso
    ((sectionsVNEEquiv E N).trans ((sigmaN P).trans (sectionsVNEEquiv E N).symm))

open Classical in
lemma rhoVN_comm (P : E.toAffine.torsion N) :
    CommRingCat.ofHom (mulByNXHom E N) ≫ (rhoVN P).hom = CommRingCat.ofHom (mulByNXHom E N) := by
  ext x
  simp [rhoVN, mulByNXHom, sigmaN_mulByNHom]

lemma rhoVN_injective : Function.Injective (rhoVN (E := E) (N := N)) := by
  intro P Q h
  apply sigmaN_injective
  ext b
  have := congrArg (fun e : Γ(curveE E, VNE E N) ≅ Γ(curveE E, VNE E N) ↦
    e.hom ((sectionsVNEEquiv E N).symm b)) h
  simpa [rhoVN] using this

open Classical in
lemma rhoVN_hom_comp (P Q : E.toAffine.torsion N) :
    (rhoVN P).hom ≫ (rhoVN Q).hom = (rhoVN (P + Q)).hom := by
  ext x
  simp [rhoVN, sigmaN_sigmaN]

open Classical in
lemma rhoVN_zero_hom : (rhoVN (0 : E.toAffine.torsion N)).hom = 𝟙 _ := by
  ext x
  simp [rhoVN, sigmaN_zero]

open Classical in
/-- The translation by `P ∈ E[N]` as an automorphism of the cover `[N]`. -/
def autN (P : E.toAffine.torsion N) : Aut (coverObj (mulByNXMor E N)) :=
  autOfRingIso (CommRingCat.ofHom (mulByNXHom E N)) (rhoVN P) (rhoVN_comm P)

open Classical in
lemma autN_mul (P Q : E.toAffine.torsion N) : autN P * autN Q = autN (P + Q) := by
  apply Iso.ext
  refine MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
  change Spec.map (rhoVN Q).hom ≫ Spec.map (rhoVN P).hom = Spec.map (rhoVN (P + Q)).hom
  rw [← Spec.map_comp, rhoVN_hom_comp]

open Classical in
lemma autN_zero : autN (0 : E.toAffine.torsion N) = 1 := by
  apply Iso.ext
  refine MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
  change Spec.map (rhoVN (0 : E.toAffine.torsion N)).hom = 𝟙 _
  rw [rhoVN_zero_hom, Spec.map_id]

open Classical in
lemma autN_pow (P : E.toAffine.torsion N) (n : ℕ) : autN P ^ n = autN (n • P) := by
  induction n with
  | zero => rw [pow_zero, zero_nsmul, autN_zero]
  | succ n ih => rw [pow_succ, ih, autN_mul, succ_nsmul]

open Classical in
lemma autN_pow_N (P : E.toAffine.torsion N) : autN P ^ N = 1 := by
  rw [autN_pow, nsmul_mem_torsion, autN_zero]

lemma autN_injective : Function.Injective (autN (E := E) (N := N)) := by
  intro P Q hPQ
  have h : Spec.map (rhoVN P).hom = Spec.map (rhoVN Q).hom := by
    rw [← autOfRingIso_hom_left _ (rhoVN P) (rhoVN_comm P),
      ← autOfRingIso_hom_left _ (rhoVN Q) (rhoVN_comm Q)]
    exact congrArg (fun e : Aut (coverObj (mulByNXMor E N)) ↦ e.hom.left) hPQ
  exact rhoVN_injective (Iso.ext (Spec.map_injective h))

variable (E N) in
/-- `Aut([N])` is finite with at most `N²` elements: it embeds into the geometric generic
fibre. -/
theorem card_aut_mulByNXMor_le : Finite (Aut (coverObj (mulByNXMor E N))) ∧
    Nat.card (Aut (coverObj (mulByNXMor E N))) ≤ N ^ 2 := by
  obtain ⟨hfin, hcard⟩ := finite_card_fibre_leN E N
  haveI : IrreducibleSpace (Spec Γ(curveE E, VNE E N)) := inferInstance
  haveI : IsConnected (coverObj (mulByNXMor E N)) :=
    (isConnected_iff_connectedSpace (coverObj (mulByNXMor E N))).2
      (IrreducibleSpace.connectedSpace (Spec Γ(curveE E, VNE E N)))
  obtain ⟨x⟩ := nonempty_fiber_of_isConnected (fiber (Spec.map (zetaN E N)))
    (coverObj (mulByNXMor E N))
  have hw : ∀ y : (fiber (Spec.map (zetaN E N))).obj (coverObj (mulByNXMor E N)),
      CommRingCat.ofHom (mulByNXHom E N) ≫
        Spec.preimage (fiberObjEquivHom (Spec.map (zetaN E N)) _ y).left = zetaN E N :=
    fun y ↦ by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage]
      exact w_left (fiberObjEquivHom (Spec.map (zetaN E N)) _ y)
  let ev : Aut (coverObj (mulByNXMor E N)) →
      {g : Γ(curveE E, VNE E N) ⟶ CommRingCat.of (OmegaE E) //
        CommRingCat.ofHom (mulByNXHom E N) ≫ g = zetaN E N} := fun a ↦
    ⟨Spec.preimage (fiberObjEquivHom (Spec.map (zetaN E N)) _
      ((fiber (Spec.map (zetaN E N))).map a.hom x)).left, hw _⟩
  have hev : Function.Injective ev := by
    intro a b hab
    apply evaluation_aut_injective_of_isConnected (fiber (Spec.map (zetaN E N))) _ x
    have h : (fiberObjEquivHom (Spec.map (zetaN E N)) _
          ((fiber (Spec.map (zetaN E N))).map a.hom x)).left =
        (fiberObjEquivHom (Spec.map (zetaN E N)) _
          ((fiber (Spec.map (zetaN E N))).map b.hom x)).left := by
      rw [← Spec.map_preimage (fiberObjEquivHom (Spec.map (zetaN E N)) _
          ((fiber (Spec.map (zetaN E N))).map a.hom x)).left,
        ← Spec.map_preimage (fiberObjEquivHom (Spec.map (zetaN E N)) _
          ((fiber (Spec.map (zetaN E N))).map b.hom x)).left]
      exact congrArg (fun g ↦ Spec.map g.1) hab
    exact (fiberObjEquivHom (Spec.map (zetaN E N)) _).injective (Over.OverMorphism.ext h)
  exact ⟨Finite.of_injective ev hev, (Nat.card_le_card_of_injective ev hev).trans hcard⟩

open Classical in
/-- **`#E(K)[N] = N²`** (all of `E[N]` is `K`-rational). -/
def TorsionCardN (E : WeierstrassCurve K) (N : ℕ) : Prop :=
  Nat.card (E.toAffine.torsion N) = N ^ 2

variable (hcard : TorsionCardN E N)

open Classical in
omit [CharZero K] [E.IsElliptic] in
include hcard in
lemma finite_torsionN : Finite (E.toAffine.torsion N) :=
  Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero 2 (NeZero.ne N))

open Classical in
include hcard in
/-- **The automorphisms of `[N] : E ∖ E[N] → E ∖ {O}` are exactly the `N²` translations by
`E[N]`** (`#E(K)[N] = N²`). -/
theorem autN_bijective : Function.Bijective (autN (E := E) (N := N)) := by
  obtain ⟨hfin, hle⟩ := card_aut_mulByNXMor_le E N
  haveI := finite_torsionN hcard
  exact autN_injective.bijective_of_nat_card_le (by rw [hcard]; exact hle)

include hcard in
/-- `|Aut([N])| = N²`. -/
theorem card_aut_mulByNXMor : Nat.card (Aut (coverObj (mulByNXMor E N))) = N ^ 2 := by
  rw [← Nat.card_congr (Equiv.ofBijective _ (autN_bijective hcard)), hcard]

include hcard in
/-- **`Aut([N])` is commutative** (translations commute). -/
theorem aut_mulByNXMor_comm (a b : Aut (coverObj (mulByNXMor E N))) : a * b = b * a := by
  obtain ⟨P, rfl⟩ := (autN_bijective hcard).2 a
  obtain ⟨Q, rfl⟩ := (autN_bijective hcard).2 b
  rw [autN_mul, autN_mul, add_comm]

include hcard in
/-- **`Aut([N])` has exponent dividing `N`** (`N • T = 0` for `T ∈ E[N]`). -/
theorem aut_mulByNXMor_pow (a : Aut (coverObj (mulByNXMor E N))) : a ^ N = 1 := by
  obtain ⟨P, rfl⟩ := (autN_bijective hcard).2 a
  exact autN_pow_N P

open Classical in
include hcard in
/-- **`[N] : E ∖ E[N] → E ∖ {O}` is a Galois cover** (group `E[N]`) when `#E(K)[N] = N²`. -/
theorem isGalois_mulByNXMor : IsGalois (coverObj (mulByNXMor E N)) := by
  obtain ⟨hfin, hle⟩ := finite_card_fibre_leN E N
  haveI := finite_torsionN hcard
  exact isGalois_coverObj_of_card (CommRingCat.ofHom (mulByNXHom E N)) rhoVN rhoVN_comm
    rhoVN_injective (zetaN E N) (hle.trans hcard.ge)

end CoverN

/-! ### `Π_U` in `Π_{E∖O}` for `[N]`: index `N²`, `N`-th powers, commutators, `Δ · Π_U = Π` -/

section PiUN


variable {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (E : WeierstrassCurve K) [E.IsElliptic]
  (N : ℕ) [NeZero N]

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **`Π_U ⊆ Π_{E∖O}` for `[N]`**: the image of `π₁(E ∖ E[N]) → π₁(E ∖ {O})` under `[N]`. -/
abbrev mulNPiU : Subgroup (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Pi :=
  cor37bPiV Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveVN E N) (compl_VNE_nonempty E N)
    (mulByNXMor E N)

lemma mulNPiU_eq_map : mulNPiU Ω E N =
    (fundamentalGroupMap (mulByNXMor E N) rfl).toMonoidHom.range.map
      (autContinuousMulEquivOfIso (coverFib Ω (hypCurveX E) (compl_XE_nonempty E)
        (hypCurveVN E N) (compl_VNE_nonempty E N) (mulByNXMor E N))).toMulEquiv.toMonoidHom := by
  ext z
  constructor
  · rintro ⟨σ, rfl⟩
    exact ⟨_, ⟨σ, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨σ, rfl⟩, rfl⟩
    exact ⟨σ, rfl⟩

variable {E N} (hcard : TorsionCardN E N)

include hcard in
/-- **`[Π : Π_U] = N²`**. -/
theorem mulNPiU_index : (mulNPiU Ω E N).index = N ^ 2 := by
  haveI := isIntegral_specSections (hypCurveX E) (compl_XE_nonempty E)
  haveI := isGalois_mulByNXMor hcard
  rw [mulNPiU_eq_map, index_map_mulEquiv₂, range_fundamentalGroupMap_of_isFiniteEtale',
    index_stabilizer_of_isGalois, card_aut_mulByNXMor hcard]

include hcard in
/-- **`g^N ∈ Π_U` for every `g ∈ Π`** (`Π/Π_U ≅ E[N]` has exponent dividing `N`). -/
theorem pow_mem_mulNPiU (g : (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Pi) :
    g ^ N ∈ mulNPiU Ω E N := by
  haveI := isIntegral_specSections (hypCurveX E) (compl_XE_nonempty E)
  haveI := isGalois_mulByNXMor hcard
  rw [mulNPiU_eq_map, range_fundamentalGroupMap_of_isFiniteEtale']
  obtain ⟨s, rfl⟩ := (autContinuousMulEquivOfIso (coverFib Ω (hypCurveX E) (compl_XE_nonempty E)
    (hypCurveVN E N) (compl_VNE_nonempty E N) (mulByNXMor E N))).surjective g
  refine ⟨s ^ N, pow_mem_stabilizer_of_pow_eq_one _ _ (aut_mulByNXMor_pow hcard) _ s, ?_⟩
  exact map_pow _ s N

include hcard in
/-- **`[g, h] ∈ Π_U` for all `g, h ∈ Π`** (`Π/Π_U ≅ E[N]` is abelian). -/
theorem commutator_mem_mulNPiU
    (g h : (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Pi) :
    g * h * g⁻¹ * h⁻¹ ∈ mulNPiU Ω E N := by
  haveI := isIntegral_specSections (hypCurveX E) (compl_XE_nonempty E)
  haveI := isGalois_mulByNXMor hcard
  rw [mulNPiU_eq_map, range_fundamentalGroupMap_of_isFiniteEtale']
  obtain ⟨s, rfl⟩ := (autContinuousMulEquivOfIso (coverFib Ω (hypCurveX E) (compl_XE_nonempty E)
    (hypCurveVN E N) (compl_VNE_nonempty E N) (mulByNXMor E N))).surjective g
  obtain ⟨t, rfl⟩ := (autContinuousMulEquivOfIso (coverFib Ω (hypCurveX E) (compl_XE_nonempty E)
    (hypCurveVN E N) (compl_VNE_nonempty E N) (mulByNXMor E N))).surjective h
  refine ⟨s * t * s⁻¹ * t⁻¹,
    commutator_mem_stabilizer_of_comm _ _ (aut_mulByNXMor_comm hcard) _ s t, ?_⟩
  simp only [map_mul, map_inv]
  rfl

variable (E N)

/-- `Π_U` is open, hence closed. -/
theorem isClosed_mulNPiU : IsClosed (SetLike.coe (mulNPiU Ω E N)) :=
  Subgroup.isClosed_of_isOpen _ (isOpen_range_coverPiHom Ω (hypCurveX E) (compl_XE_nonempty E)
    (hypCurveVN E N) (compl_VNE_nonempty E N) (mulByNXMor E N))

variable {E N}

include hcard in
/-- `Π_U ⊴ Π`. -/
theorem mulNPiU_normal : (mulNPiU Ω E N).Normal :=
  cor37b_normal Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveVN E N) (compl_VNE_nonempty E N)
    (mulByNXMor E N) (isGalois_mulByNXMor hcard)

variable (E N) in
lemma mulByNXMor_spec :
    mulByNXMor E N ≫ Spec.map (CommRingCat.ofHom (algebraMap K Γ(curveE E, XE E))) =
      Spec.map (CommRingCat.ofHom (algebraMap K Γ(curveE E, VNE E N))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K K)) := by
  simp only [mulByNXMor, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  exact RingHom.ext fun c ↦ mulByNXHom_algebraMap E N c

variable (E N)

/-- **`Π_U ↠ G_K`**: `E ∖ E[N]` is geometrically connected over `K`. -/
theorem pr_mulNPiU_surjective (y : (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).G) :
    ∃ h ∈ mulNPiU Ω E N, (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr h = y := by
  obtain ⟨z, hz⟩ := (autContinuousMulEquivOfIso (coverG Ω (hypCurveX E) (compl_XE_nonempty E)
    (hypCurveVN E N) (compl_VNE_nonempty E N) (mulByNXMor E N)
    (mulByNXMor_spec E N))).surjective y
  obtain ⟨w, hw⟩ := galoisMap_self_surjective Ω z
  obtain ⟨γ, hγ⟩ := (arithmeticExt Ω (hypCurveVN E N) (compl_VNE_nonempty E N)).pr_surjective w
  refine ⟨_, ⟨γ, rfl⟩, ?_⟩
  change (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr
    (coverPiHom Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveVN E N) (compl_VNE_nonempty E N)
      (mulByNXMor E N) γ) = y
  rw [pr_coverPiHom Ω (hypCurveX E) (compl_XE_nonempty E) (hypCurveVN E N)
    (compl_VNE_nonempty E N) (mulByNXMor E N) (mulByNXMor_spec E N), hγ, ← hz, ← hw]
  rfl

/-- **`Δ · Π_U = Π`**. -/
theorem Delta_sup_mulNPiU :
    (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta ⊔ mulNPiU Ω E N = ⊤ := by
  refine eq_top_iff.2 fun g _ ↦ ?_
  obtain ⟨h, hh, hpr⟩ := pr_mulNPiU_surjective Ω E N
    ((arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr g)
  have hd : g * h⁻¹ ∈ (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta := by
    change (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).pr (g * h⁻¹) = 1
    rw [map_mul, map_inv, hpr, mul_inv_cancel]
  have := Subgroup.mul_mem_sup hd hh
  rwa [inv_mul_cancel_right] at this

variable {E N}

include hcard in
/-- **[AbsTopII] Cor 3.4, step G1 for `[N]`: `Π_U ⊓ Δ = Δ^N [Δ, Δ]`** for `X = E ∖ {O}` with
`#E(K)[N] = N²` (`Ē_{\bar K}` has genus `1` and `X_{\bar K}` one cusp, so `Δ ≅ Π̂_{1,1}`). -/
theorem mulNPiU_inf_Delta :
    mulNPiU Ω E N ⊓ (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta =
      mulNClosure (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta N := by
  haveI := mulNPiU_normal Ω hcard
  obtain ⟨e⟩ := nonempty_kerProjGk_equiv Ω (hypCurveX E) (compl_XE_nonempty E)
  obtain ⟨a, b, hab⟩ := exists_topGen_of_equiv
    (D := (arithmeticExt Ω (hypCurveX E) (compl_XE_nonempty E)).Delta)
    (isClosed_Delta₂ _) e (curveGenus_baseChange_curveE E Ω)
    (card_compl_baseChangeOpen_XE E Ω)
  exact inf_eq_mulNClosure (NeZero.ne N) (isClosed_Delta₂ _) (isClosed_mulNPiU Ω E N)
    (mulNPiU_index Ω hcard) (pow_mem_mulNPiU Ω hcard) (commutator_mem_mulNPiU Ω hcard)
    (Delta_sup_mulNPiU Ω E N) hab

end PiUN

/-! ### Transport along isomorphisms of cuspidal extensions -/

section TransportN


variable {K₁ : Type u} [Field K₁] [NumberField K₁] (Ω₁ : Type u) [Field Ω₁] [Algebra K₁ Ω₁]
  [IsAlgClosed Ω₁] [Algebra.IsAlgebraic K₁ Ω₁] [CharZero Ω₁] {E₁ : WeierstrassCurve K₁}
  [E₁.IsElliptic]
  {K₂ : Type u} [Field K₂] [NumberField K₂] (Ω₂ : Type u) [Field Ω₂] [Algebra K₂ Ω₂]
  [IsAlgClosed Ω₂] [Algebra.IsAlgebraic K₂ Ω₂] [CharZero Ω₂] {E₂ : WeierstrassCurve K₂}
  [E₂.IsElliptic] {N : ℕ} [NeZero N]

/-- **[AbsTopII] Cor 3.4 (G1) for `[N]`, transport**: an isomorphism `Φ : Π_{X₁} ≅ Π_{X₂}` of
cuspidal extensions (`X_i = E_i ∖ {O}`, `#E_i(K_i)[N] = N²`) maps `Π_{U₁} ⊓ Δ₁` onto
`Π_{U₂} ⊓ Δ₂`. -/
theorem map_mulNPiU_inf_Delta
    (Φ : (arithmeticExt Ω₁ (hypCurveX E₁) (compl_XE_nonempty E₁)).Iso
      (arithmeticExt Ω₂ (hypCurveX E₂) (compl_XE_nonempty E₂)))
    (hE₁ : TorsionCardN E₁ N) (hE₂ : TorsionCardN E₂ N) :
    (mulNPiU Ω₁ E₁ N ⊓ (arithmeticExt Ω₁ (hypCurveX E₁) (compl_XE_nonempty E₁)).Delta).map
        Φ.pi.toMulEquiv.toMonoidHom =
      mulNPiU Ω₂ E₂ N ⊓ (arithmeticExt Ω₂ (hypCurveX E₂) (compl_XE_nonempty E₂)).Delta := by
  rw [mulNPiU_inf_Delta Ω₁ hE₁, mulNPiU_inf_Delta Ω₂ hE₂, Φ.map_mulNClosure₂]

end TransportN

