import CurvesJacobian.Cusp.CuspConj
import CurvesJacobian.Galois.AbelianPi1
import CurvesJacobian.Galois.ChartOfOpen

/-!
# Filling in one cusp: the kernel is normally generated by one cuspidal inertia group

(MR8.3, task 2 (iii), geometric step.) [AbsTopI] Definition 4.2 (iii)
(`Topics in Absolute Anabelian Geometry I.txt` l.3011–3014): an elementary operation of type `•`
is a surjection `Π_j ↠ Π_{j+1}` "whose kernel is topologically normally generated by a cuspidal
decomposition group"; geometrically ([AbsTopI] Lemma 4.1 (v), l.2733 ff.) this is filling in one
cusp `x` of `U`, i.e. `π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(U ∪ {x})`.

Setting of `CurvesJacobian.Cusp.Inertia`.

* `CurvesJacobian.Cusp.mem_of_isCentredOn`: if `W` is centred on `V` (finite complement) and
  lies over the stalk `𝒪_{X,y}`, then `y ∈ V` (for `V ≠ X`, `V` is a chart `π⁻¹ D₊(X₁)` of a
  rational function `τ` regular on `V`, and `τ ∈ 𝒪_{X,y}` forces `y ∈ V`).
* `CurvesJacobian.Cusp.comapK_eq_of_isCentredOn`: if `V ∖ U` has at most one point, all places
  centred on `V` but not on `U` restrict to the same place of `K(X)` (the stalk at the cusp);
  `comap_algebraMap_eq_of_isCentredOn`: the same for the place of `L`.
* `CurvesJacobian.Cusp.exists_isCentredOn_not_isCentredOn`: for `x ∈ V ∖ U` there is such a
  place (extension of `𝒪_{X,x}` to `Ω`, Mathlib `IsLocalRing.exists_factor_valuationRing`).
* `CurvesJacobian.Cusp.ker_fundamentalGroupMap_homOfLE_eq_normalClosure`: **for `V ∖ U` at most
  one point, the kernel of `π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(V)` is the closed normal subgroup generated by one
  cuspidal inertia group** `cuspInertia U W₀` (any `W₀` centred on `V`, not on `U`), from
  `ker_fundamentalGroupMap_homOfLE_eq_cuspInertia` and `exists_cuspInertia_eq_conj`.
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale
open Pi1.Orbifold AffOrbicurve

universe u

noncomputable section

namespace CurvesJacobian.Cusp

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} (D : GaloisData k t)
  (X : Scheme.{u}) [X.Over (Spec (CommRingCat.of k))] [IsIntegral X]
  (eL : X.functionField ≃+* D.L)
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  [IsAlgClosed k] [CharZero k] [IsCurveOver k X]

omit [IsAlgClosed k] in
/-- A place centred on `V` (finite complement) lying over the stalk at `y` has `y ∈ V`. -/
lemma mem_of_isCentredOn (V : X.Opens) [Nonempty V] (hV : (V : Set X)ᶜ.Finite)
    {W : ValuationSubring Ω} (hW : IsCentredOn D X eL V W) {y : X}
    (hy : stalkVS k y = comapK D X eL hk W) : y ∈ V := by
  by_cases hne : V = ⊤
  · subst hne
    trivial
  obtain ⟨τ, hτ, hVτ⟩ := exists_chartOne_eq k V hV hne
  subst hVτ
  obtain ⟨a, ha⟩ := (mem_range_germ_chartOne_iff hτ τ).2
    (isIntegral_algebraMap (x := (⟨τ, Algebra.self_mem_adjoin_singleton k τ⟩ :
      Algebra.adjoin k {τ})))
  have h1 := hW.2 a
  rw [ha] at h1
  have h2 : τ ∈ comapK D X eL hk W := h1
  rw [← hy] at h2
  exact (mem_chartOne_iff k hτ y).2 h2

omit [IsAlgClosed k] in
/-- **Places over one cusp.** If `V ∖ U` has at most one point, all places centred on `V` but not
on `U` restrict to the same valuation subring of `K(X)` (the stalk at the cusp). -/
lemma comapK_eq_of_isCentredOn {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hV : (V : Set X)ᶜ.Finite) (hsub : ((V : Set X) \ U).Subsingleton)
    {W₁ W₂ : ValuationSubring Ω} (h₁V : IsCentredOn D X eL V W₁) (h₁U : ¬ IsCentredOn D X eL U W₁)
    (h₂V : IsCentredOn D X eL V W₂) (h₂U : ¬ IsCentredOn D X eL U W₂) :
    comapK D X eL hk W₁ = comapK D X eL hk W₂ := by
  obtain ⟨y₁, hy₁U, hy₁⟩ := exists_notMem_of_not_isCentredOn D X eL hk U h₁V.1 h₁U
  obtain ⟨y₂, hy₂U, hy₂⟩ := exists_notMem_of_not_isCentredOn D X eL hk U h₂V.1 h₂U
  have hy₁V := mem_of_isCentredOn D X eL hk V hV h₁V hy₁
  have hy₂V := mem_of_isCentredOn D X eL hk V hV h₂V hy₂
  have : y₁ = y₂ := hsub ⟨hy₁V, hy₁U⟩ ⟨hy₂V, hy₂U⟩
  rw [← hy₁, ← hy₂, this]

omit [IsAlgClosed k] [CharZero k] [IsCurveOver k X] in
/-- `comapK` determines the restriction to `L`. -/
lemma comap_algebraMap_eq_of_comapK_eq {W₁ W₂ : ValuationSubring Ω}
    (h : comapK D X eL hk W₁ = comapK D X eL hk W₂) :
    W₁.comap (algebraMap D.L Ω) = W₂.comap (algebraMap D.L Ω) := by
  ext z
  have := SetLike.ext_iff.1 h (eL.symm z)
  simp only [ValuationSubring.mem_comap] at this ⊢
  change ((eL (eL.symm z) : D.L) : Ω) ∈ W₁ ↔ ((eL (eL.symm z) : D.L) : Ω) ∈ W₂ at this
  simpa using this

omit [IsAlgClosed k] in
include hk in
/-- If `V ∖ U` has at most one point, all places centred on `V` but not on `U` restrict to the
same place of `L`. -/
lemma comap_algebraMap_eq_of_isCentredOn {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hV : (V : Set X)ᶜ.Finite) (hsub : ((V : Set X) \ U).Subsingleton)
    {W₁ W₂ : ValuationSubring Ω} (h₁V : IsCentredOn D X eL V W₁) (h₁U : ¬ IsCentredOn D X eL U W₁)
    (h₂V : IsCentredOn D X eL V W₂) (h₂U : ¬ IsCentredOn D X eL U W₂) :
    W₁.comap (algebraMap D.L Ω) = W₂.comap (algebraMap D.L Ω) :=
  comap_algebraMap_eq_of_comapK_eq D X eL hk
    (comapK_eq_of_isCentredOn D X eL hk hV hsub h₁V h₁U h₂V h₂U)

omit [IsAlgClosed k] in
/-- **Every cusp carries a place.** For `x ∈ V ∖ U` (`U` with finite complement) there is a place
`W ⊇ k` of `Ω` over `𝒪_{X,x}`, centred on `V` but not on `U`. -/
theorem exists_isCentredOn_not_isCentredOn {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hU : (U : Set X)ᶜ.Finite) {x : X} (hxV : x ∈ V) (hxU : x ∉ U) :
    ∃ W : ValuationSubring Ω, comapK D X eL hk W = stalkVS k x ∧
      IsCentredOn D X eL V W ∧ ¬ IsCentredOn D X eL U W := by
  set O := stalkVS k x
  let f : O →+* Ω := (embK D X eL hk).toRingHom.comp O.subtype
  obtain ⟨A, hA, hloc⟩ := IsLocalRing.exists_factor_valuationRing f
  have hO : comapK D X eL hk A = O := by
    apply le_antisymm
    · intro z hz
      by_contra hzO
      have hz0 : z ≠ 0 := fun h ↦ hzO (h ▸ zero_mem O)
      have hzi : z⁻¹ ∈ O := (O.mem_or_inv_mem z).resolve_left hzO
      have hu : IsUnit (f.codRestrict A.toSubring hA ⟨z⁻¹, hzi⟩) := by
        refine IsUnit.of_mul_eq_one ⟨_, hz⟩ (Subtype.ext ?_)
        change (embK D X eL hk) z⁻¹ * (embK D X eL hk) z = 1
        rw [map_inv₀, inv_mul_cancel₀ ((map_ne_zero _).2 hz0)]
      obtain ⟨b, hb⟩ := isUnit_iff_exists_inv.1 ((hloc.map_nonunit _) hu)
      have hb' : z⁻¹ * (b : X.functionField) = 1 := congrArg Subtype.val hb
      rw [inv_mul_eq_one₀ hz0] at hb'
      exact hzO (hb' ▸ b.2)
    · intro z hz
      exact hA ⟨z, hz⟩
  have hkA : ∀ c : k, algebraMap k Ω c ∈ A := fun c ↦ by
    rw [← (embK D X eL hk).commutes c]
    exact hA ⟨_, algebraMap_mem_stalkValuationSubring k _ x c⟩
  refine ⟨A, hO, ⟨hkA, fun a ↦ ?_⟩, fun hAU ↦ hxU ?_⟩
  · have hmem : X.germToFunctionField V a ∈ O :=
      ⟨X.presheaf.germ _ x hxV a, by rw [Scheme.algebraMap_germ_eq_germToFunctionField]⟩
    exact hA ⟨_, hmem⟩
  · exact mem_of_isCentredOn D X eL hk U hU hAU hO.symm

variable [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] (hH : D.H ≤ D.HL)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)

omit [IsAlgClosed k] in
include hk hτ in
/-- **Filling in one cusp** ([AbsTopI] Definition 4.2 (iii), l.3011–3014; Lemma 4.1 (v)): if
`U ⊆ V` (finite complements) and `V ∖ U` has at most one point, the kernel of
`π₁ᵉᵗ(U) ↠ π₁ᵉᵗ(V)` is the closed normal subgroup generated by the single cuspidal inertia group
`cuspInertia U W₀`, for any place `W₀` centred on `V` but not on `U`. -/
theorem ker_fundamentalGroupMap_homOfLE_eq_normalClosure {U V : X.Opens} [Nonempty U]
    [Nonempty V] (hU : (U : Set X)ᶜ.Finite) (hV : (V : Set X)ᶜ.Finite) (h : U ≤ V)
    (hsub : ((V : Set X) \ U).Subsingleton) {W₀ : ValuationSubring Ω}
    (hW₀V : IsCentredOn D X eL V W₀) (hW₀U : ¬ IsCentredOn D X eL U W₀) :
    (fundamentalGroupMap (X.homOfLE h) (specPoint_genericL_homOfLE D X eL h)).toMonoidHom.ker =
      (Subgroup.normalClosure (cuspInertia D X eL hH U W₀ : Set _)).topologicalClosure := by
  rw [ker_fundamentalGroupMap_homOfLE_eq_cuspInertia D X eL hH hk hτ hU hV h]
  congr 1
  apply le_antisymm
  · refine Subgroup.normalClosure_le_normal ?_
    intro g hg
    obtain ⟨W, ⟨hWV, hWU⟩, hgW⟩ := Set.mem_iUnion₂.1 hg
    obtain ⟨γ, hγ⟩ := exists_cuspInertia_eq_conj D X eL hH U W₀ W
      (comap_algebraMap_eq_of_isCentredOn D X eL hk hV hsub hW₀V hW₀U hWV hWU)
    rw [SetLike.mem_coe, hγ] at hgW
    obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.1 hgW
    exact (Subgroup.normalClosure_normal).conj_mem _ (Subgroup.subset_normalClosure ha) γ
  · refine Subgroup.normalClosure_mono ?_
    intro g hg
    exact Set.mem_iUnion₂.2 ⟨W₀, ⟨hW₀V, hW₀U⟩, hg⟩

end CurvesJacobian.Cusp
