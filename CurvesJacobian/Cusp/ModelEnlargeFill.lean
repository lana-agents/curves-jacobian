/-!
# Enlarging a geometric model: the filled quotient curve (MR8 option (Q), step (Q-c))

In the setting of `CurvesJacobian.Cusp.ModelEnlargeExt` (a geometric model `D`, a subgroup
`ι(Π_Y) ≤ P' ≤ N_A(ι(Π_Y))` of finite relative index, the quotient curve `Z₀` over `M₀` with
`e : Π_{Z₀} ≃ₜ* E₁` and `Φ : E₁ ↠ P'`), put **`Φ_Z = Φ ∘ e : Π_{Z₀} ↠ P'`**
(`GeomModel.enlPhiZ`). We assume (explicit hypotheses, proved elsewhere)

* `hΔ`: `γ ∈ Δ_{Z₀} ↔ Φ_Z γ ∈ Δ_A` (`GeomModel.mem_ker_projGk_enlZ0_iff`), and
* `htf`: `P' ∩ Δ_A` is torsion-free.

Main results:

* the basic open `V'' = D(h'(t)) ⊆ U_Y` (`GeomModel.enlV`, `CurvesJacobian.Cusp.basicSubCurve`)
  with `θ : Π_{V''} ≃ₜ* π₁ᵉᵗ(V, a)` (`GeomModel.enlTheta`), the filling map
  `ψ_{V''} = ψ₀ ∘ θ : Π_{V''} → Π_Y` (`GeomModel.enlPsiV`, induced by `V'' ⊆ U_Y`), and the
  embedding `ι_{V''} : Π_{V''} ↪ Π_{Z₀}` onto the finite-index subgroup `N = e⁻¹(ker p₁)`
  (`GeomModel.enlIotaV`, `GeomModel.enlN`, `GeomModel.mem_enlN_iff`), with
  `Φ_Z ∘ ι_{V''} = ι ∘ ψ_{V''}` (`GeomModel.coe_enlPhiZ_enlIotaV`);
* `GeomModel.exists_arithCusps_enlIotaV`: each cuspidal inertia group `J` of `V''` lies in a
  cuspidal inertia group `C` of `Z₀` with `C ∩ N ≤ ι(J)` (K1 for `V'' → L` and `Z₀ → L`);
* **`GeomModel.exists_map_enlPhiZ_eq_bot`** (torsion argument): if `ψ_{V''}(J) = 1`, then
  `Φ_Z(C) = 1` (finite image in the torsion-free `P' ∩ Δ_A`);
* **`GeomModel.ker_enlPhiZ_eq_closure`** (step 1): `ker Φ_Z` is the closed normal subgroup
  generated by the cuspidal inertia groups of `Π_{Z₀}` it contains;
* **`GeomModel.exists_cusp_not_le_ker_enlPhiZ`** (step 2): some cuspidal inertia group of `Π_{Z₀}`
  is not killed by `Φ_Z`;
* **`GeomModel.exists_enlFill`** (step 3): an open `U' ⊇ U_{Z₀}` with a cusp and
  `ker (fillMap) = ker Φ_Z`, such that `(X̄_{Z₀}, U')` is hyperbolic (`GeomModel.enlFill_hyp`);
* **`GeomModel.enlFillCurve`** (step 4), the filled curve `Z` over `M₀` (with its cusp
  `GeomModel.enlFillCurve_cusp`), and **`GeomModel.enlFillEquiv : Π_Z ≃ₜ* P'`** with
  `enlFillEquiv ∘ fillPiHom = Φ_Z` (`GeomModel.enlFillEquiv_fillPiHom`).

Generic tools: `CurvesJacobian.Cusp.closure_normalClosure_le_comap` and
`CurvesJacobian.Cusp.contMulEquivOfKerEq` (`Q ≃ₜ* P` for continuous surjections `E ↠ Q`,
`E ↠ P` with the same kernel, `E`, `Q` compact Hausdorff).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi Belyi.Anabelian
  Pi1.Profinite PreGaloisCategory Polynomial

universe u

noncomputable section

namespace CurvesJacobian.Cusp

/-! ### Two generic facts on topological groups -/

section Generic

/-- Pushing topological normal generators along a continuous homomorphism: if `ι(S) ⊆ S'`, then
`ι` maps the closed normal subgroup generated by `S` into the one generated by `S'`. -/
lemma closure_normalClosure_le_comap {V E : Type*} [Group V] [TopologicalSpace V]
    [IsTopologicalGroup V] [Group E] [TopologicalSpace E] [IsTopologicalGroup E] (ι : V →* E)
    (hι : Continuous ι) {S : Set V} {S' : Set E} (hS : ∀ s ∈ S, ι s ∈ S') :
    (Subgroup.normalClosure S).topologicalClosure ≤
      ((Subgroup.normalClosure S').topologicalClosure).comap ι := by
  haveI : (((Subgroup.normalClosure S').topologicalClosure).comap ι).Normal :=
    Subgroup.Normal.comap (Subgroup.is_normal_topologicalClosure _) ι
  refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal fun s hs ↦ ?_)
    ((Subgroup.isClosed_topologicalClosure _).preimage hι)
  exact Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure (hS s hs))

variable {E Q P : Type*} [Group E] [TopologicalSpace E] [CompactSpace E] [Group Q]
  [TopologicalSpace Q] [CompactSpace Q] [T2Space Q] [Group P] [TopologicalSpace P] [T2Space P]
  (f : E →ₜ* Q) (hf : Function.Surjective f) (Φ : E →ₜ* P)
  (hker : f.toMonoidHom.ker = Φ.toMonoidHom.ker)

/-- The homomorphism `Q → P` induced by `Φ : E → P` along a surjection `f : E ↠ Q` with the same
kernel. -/
def liftOfKerEq : Q →* P := (f.toMonoidHom.liftOfSurjective hf) ⟨Φ.toMonoidHom, hker.le⟩

omit [CompactSpace E] [CompactSpace Q] [T2Space Q] [T2Space P] in
lemma liftOfKerEq_apply (x : E) : liftOfKerEq f hf Φ hker (f x) = Φ x :=
  MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ x

omit [CompactSpace E] [CompactSpace Q] [T2Space Q] [T2Space P] in
lemma bijective_liftOfKerEq (hΦ : Function.Surjective Φ) :
    Function.Bijective (liftOfKerEq f hf Φ hker) := by
  refine ⟨(injective_iff_map_eq_one _).2 fun q hq ↦ ?_, fun p ↦ ?_⟩
  · obtain ⟨x, rfl⟩ := hf q
    rw [liftOfKerEq_apply] at hq
    have hx : x ∈ f.toMonoidHom.ker := hker ▸ MonoidHom.mem_ker.2 hq
    exact hx
  · obtain ⟨x, rfl⟩ := hΦ p
    exact ⟨f x, liftOfKerEq_apply f hf Φ hker x⟩

omit [CompactSpace Q] [T2Space P] in
lemma continuous_liftOfKerEq : Continuous (liftOfKerEq f hf Φ hker) := by
  refine (Topology.IsQuotientMap.of_surjective_continuous hf f.continuous).continuous_iff.2 ?_
  have e : (liftOfKerEq f hf Φ hker) ∘ f = Φ := funext (liftOfKerEq_apply f hf Φ hker)
  rw [e]
  exact Φ.continuous

/-- **`Q ≃ₜ* P`** for continuous surjections `f : E ↠ Q`, `Φ : E ↠ P` with the same kernel
(`E`, `Q` compact, `Q`, `P` Hausdorff), with `e ∘ f = Φ` (`contMulEquivOfKerEq_apply`). -/
def contMulEquivOfKerEq (hΦ : Function.Surjective Φ) : Q ≃ₜ* P :=
  let m := MulEquiv.ofBijective (liftOfKerEq f hf Φ hker) (bijective_liftOfKerEq f hf Φ hker hΦ)
  let h : Q ≃ₜ P := (continuous_liftOfKerEq f hf Φ hker).homeoOfEquivCompactToT2 (f := m.toEquiv)
  { m with
    continuous_toFun := h.continuous_toFun
    continuous_invFun := h.continuous_invFun }

lemma contMulEquivOfKerEq_apply (hΦ : Function.Surjective Φ) (x : E) :
    contMulEquivOfKerEq f hf Φ hker hΦ (f x) = Φ x :=
  liftOfKerEq_apply f hf Φ hker x

end Generic

end CurvesJacobian.Cusp

namespace CurvesJacobian.Cusp.GeomModel

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {CX : HypCurve K}
  {hcX : (CX.U : Set CX.Xbar)ᶜ.Nonempty} {A : ChainObj (arithmeticExt Ω CX hcX)}
  (D : GeomModel Ω CX hcX A) (hDGC : RelIsomDGC D.M) {P' : Subgroup D.Nrm}
  (hrel : D.ιNHom.range.relIndex P' ≠ 0)

attribute [local instance] isAlgClosure_of_isAlgebraic

/-! ### The basic open `V'' = D(h'(t)) ⊆ U_Y` -/

/-- The section `r = h'(t) ∈ Γ(U_Y)`, `h' = X (X - 1) h`. -/
abbrev enlR : Γ(D.Y.Xbar, D.Y.U) :=
  lineHom K (D.enlT hDGC hrel) (quotLinePoly K (D.enlH hDGC hrel))

lemma enlR_ne_zero : D.enlR hDGC hrel ≠ 0 :=
  lineHom_ne_zero (D.transcendental_enlT hDGC hrel)
    (quotLinePoly_ne_zero K (D.enlH_ne_zero hDGC hrel))

/-- **The curve `V'' = (X̄_Y, D(r))`** over `M`. -/
abbrev enlV : HypCurve D.M := basicSubCurve D.Y (D.enlR hDGC hrel) (D.enlR_ne_zero hDGC hrel)

lemma enlV_cusp : ((D.enlV hDGC hrel).U : Set (D.enlV hDGC hrel).Xbar)ᶜ.Nonempty :=
  basicSubCurve_cusp D.Y D.hY _ _

/-- The base point of `Π_{V''}`. -/
abbrev enlVPt : Spec (.of Ω) ⟶ Spec Γ((D.enlV hDGC hrel).Xbar, (D.enlV hDGC hrel).U) :=
  basePoint Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel) ≫
    baseChangeSpec D.M Ω Γ((D.enlV hDGC hrel).Xbar, (D.enlV hDGC hrel).U)

/-- `Spec Γ(V'') ≅ Spec Γ(U_Y)_r = V`. -/
abbrev enlVIso : Spec Γ((D.enlV hDGC hrel).Xbar, (D.enlV hDGC hrel).U) ≅
    Spec (.of (D.enlRing hDGC hrel)) :=
  basicSubCurveIso D.Y D.hY (D.enlR hDGC hrel)

/-- The fixed change of base point `fiber (x ≫ e) ≅ fiber a`. -/
def enlVFib : fiber (D.enlVPt hDGC hrel ≫ (D.enlVIso hDGC hrel).hom) ≅
    fiber (D.enlPt hDGC hrel) :=
  (nonempty_iso_of_fiberFunctor _ _).some

/-- **`θ : Π_{V''} ≃ₜ* π₁ᵉᵗ(V, a)`**, induced by `Spec Γ(V'') ≅ V`. -/
def enlTheta : π₁ᵉᵗ(D.enlVPt hDGC hrel) ≃ₜ* π₁ᵉᵗ(D.enlPt hDGC hrel) :=
  (fundamentalGroupEquivOfIso (D.enlVIso hDGC hrel) (D.enlVPt hDGC hrel)).trans
    (autContinuousMulEquivOfIso (D.enlVFib hDGC hrel))

lemma isConjInduced_enlTheta :
    IsConjInduced (D.enlVIso hDGC hrel).hom (D.enlTheta hDGC hrel) :=
  ⟨D.enlVFib hDGC hrel, fun _ ↦ rfl⟩

/-- **`ψ_{V''} : Π_{V''} → Π_Y`** (`ψ₀ ∘ θ`). -/
def enlPsiV : π₁ᵉᵗ(D.enlVPt hDGC hrel) →ₜ* D.Pi :=
  (D.enlPsi₀ hDGC hrel).comp (ContinuousMonoidHom.toContinuousMonoidHom (D.enlTheta hDGC hrel))

/-- `ψ_{V''}` is induced by `Spec Γ(U_Y) → Γ(V'')` (the filling of `V'' ⊆ U_Y`). -/
theorem isConjInduced_enlPsiV :
    IsConjInduced (Spec.map (CommRingCat.ofHom
      (resAlg D.M (D.Y.Xbar.basicOpen_le (D.enlR hDGC hrel))).toRingHom)) (D.enlPsiV hDGC hrel) :=
  (((D.isConjInduced_enlTheta hDGC hrel).comp (D.isConjInduced_enlPsi₀ hDGC hrel)).congr_hom
    (basicSubCurveIso_hom_comp_resAlg D.Y D.hY (D.enlR hDGC hrel))).congr_fun fun _ ↦ rfl

/-- **`φ_L : Π_{V''} → π₁ᵉᵗ(L, η')`** (`θ` followed by `π₁ᵉᵗ(V ⟶ L)`). -/
def enlPhiL : π₁ᵉᵗ(D.enlVPt hDGC hrel) →ₜ* π₁ᵉᵗ(D.enlEta hDGC hrel) :=
  (fundamentalGroupMap (D.enlCover hDGC hrel) (D.enlPt_spec hDGC hrel)).comp
    (ContinuousMonoidHom.toContinuousMonoidHom (D.enlTheta hDGC hrel))

lemma enlPhiL_apply (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    D.enlPhiL hDGC hrel y = fundamentalGroupMap (D.enlCover hDGC hrel) (D.enlPt_spec hDGC hrel)
      (D.enlTheta hDGC hrel y) :=
  rfl

instance isFiniteEtale_enlVIso_comp :
    IsFiniteEtale ((D.enlVIso hDGC hrel).hom ≫ D.enlCover hDGC hrel) := by
  haveI : IsFiniteEtale (D.enlVIso hDGC hrel).hom := {}
  exact MorphismProperty.comp_mem _ _ _ (inferInstanceAs (IsFiniteEtale _)) inferInstance

lemma isConjInduced_enlPhiL :
    IsConjInduced ((D.enlVIso hDGC hrel).hom ≫ D.enlCover hDGC hrel) (D.enlPhiL hDGC hrel) := by
  have h2 : IsConjInduced (D.enlCover hDGC hrel)
      (fundamentalGroupMap (D.enlCover hDGC hrel) (D.enlPt_spec hDGC hrel)) :=
    (isConjInduced_iff _ (D.enlPt_spec hDGC hrel) _).2 ⟨Iso.refl _, fun σ ↦ by
      change _ = (Iso.refl _).conjAut _
      rw [Iso.conjAut_apply]
      ext
      simp⟩
  exact ((D.isConjInduced_enlTheta hDGC hrel).comp h2).congr_fun fun _ ↦ rfl

/-- `Spec Γ(V'') ⟶ V ⟶ Spec Γ(L)` lies over `Spec M ⟶ Spec K`. -/
lemma enlPhiL_over :
    ((D.enlVIso hDGC hrel).hom ≫ D.enlCover hDGC hrel) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K Γ((D.enlL hDGC hrel).Xbar,
          (D.enlL hDGC hrel).U))) =
      Spec.map (CommRingCat.ofHom (algebraMap D.M Γ((D.enlV hDGC hrel).Xbar,
          (D.enlV hDGC hrel).U))) ≫ Spec.map (CommRingCat.ofHom (algebraMap K D.M)) := by
  have h1 : D.enlCover hDGC hrel ≫ Spec.map (CommRingCat.ofHom (algebraMap K
      Γ((D.enlL hDGC hrel).Xbar, (D.enlL hDGC hrel).U))) =
      Spec.map (CommRingCat.ofHom (algebraMap K (D.enlRing hDGC hrel))) := by
    refine (congrArg (· ≫ _) (quotLineCover_eq K _ _ _)).trans ?_
    rw [Category.assoc, lineCurveIso_hom_structure, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext c
    refine (congrArg (Localization.awayMap (lineHom K (D.enlT hDGC hrel))
      (quotLinePoly K (D.enlH hDGC hrel))) (IsScalarTower.algebraMap_apply K K[X] _ c)).trans ?_
    refine (IsLocalization.map_eq _ _).trans ?_
    refine (congrArg _ ((aeval (D.enlT hDGC hrel)).commutes c)).trans ?_
    exact (IsScalarTower.algebraMap_apply K Γ(D.Y.Xbar, D.Y.U) (D.enlRing hDGC hrel) c).symm
  have h2 : algebraMap K (D.enlRing hDGC hrel) =
      (algebraMap D.M (D.enlRing hDGC hrel)).comp (algebraMap K D.M) := by
    ext c
    simp [IsScalarTower.algebraMap_apply K Γ(D.Y.Xbar, D.Y.U) (D.enlRing hDGC hrel),
      IsScalarTower.algebraMap_apply D.M Γ(D.Y.Xbar, D.Y.U) (D.enlRing hDGC hrel),
      IsScalarTower.algebraMap_apply K D.M Γ(D.Y.Xbar, D.Y.U)]
  rw [Category.assoc, h1, h2, CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc]
  exact congrArg (· ≫ _) (basicSubCurveIso_hom_comp_structure D.Y D.hY (D.enlR hDGC hrel))

lemma enlPhiL_mem_cover (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    D.enlPhiL hDGC hrel y ∈ (coverSubgroup (D.enlCover hDGC hrel) (D.enlPt hDGC hrel)
      (D.enlPt_spec hDGC hrel) : Subgroup π₁ᵉᵗ(D.enlEta hDGC hrel)) := by
  rw [← range_fundamentalGroupMap_eq_coverSubgroup]
  exact ⟨_, rfl⟩

lemma enlPhiL_mem_E₁ (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    D.enlPhiL hDGC hrel y ∈ D.enlE₁ hDGC hrel :=
  coverSubgroup_le_quot (ρ := D.enlCoverAut hDGC hrel) (D.enlPt_spec hDGC hrel)
    (D.enlPhiL_mem_cover hDGC hrel y)

lemma enlPhiL_mem_ker (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    (⟨_, D.enlPhiL_mem_E₁ hDGC hrel y⟩ : D.enlE₁ hDGC hrel) ∈ (D.enlP₁ hDGC hrel).ker := by
  rw [ker_enlP₁]
  exact Subgroup.mem_subgroupOf.2 (D.enlPhiL_mem_cover hDGC hrel y)

lemma enlKerToV_enlPhiL (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    D.enlKerToV hDGC hrel ⟨_, D.enlPhiL_mem_ker hDGC hrel y⟩ = D.enlTheta hDGC hrel y :=
  fundamentalGroupMap_injective_of_isFiniteEtale' (D.enlCover hDGC hrel) (D.enlPt hDGC hrel)
    (D.enlPt_spec hDGC hrel) (D.fundamentalGroupMap_enlKerToV hDGC hrel _)


/-! ### The quotient curve `Z₀` and the inclusion `ι_{V''} : Π_{V''} ↪ Π_{Z₀}` -/

attribute [local instance] enlAlgebraM₀

lemma enlFill_isAlgebraic : Algebra.IsAlgebraic (D.enlM₀ hDGC hrel) Ω :=
  D.isAlgebraic_enlAlgebraM₀ hDGC hrel

lemma enlFill_isScalarTower : IsScalarTower K (D.enlM₀ hDGC hrel) Ω :=
  D.isScalarTower_enlAlgebraM₀ hDGC hrel

attribute [local instance] enlFill_isAlgebraic enlFill_isScalarTower

/-- The base point of `Π_{Z₀}`. -/
abbrev enlZ0Pt : Spec (.of Ω) ⟶ Spec Γ((D.enlZ0 hDGC hrel).Xbar, (D.enlZ0 hDGC hrel).U) :=
  basePoint Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) ≫
    baseChangeSpec (D.enlM₀ hDGC hrel) Ω Γ((D.enlZ0 hDGC hrel).Xbar, (D.enlZ0 hDGC hrel).U)

/-- `Spec Γ(Z₀) ≅ W`. -/
abbrev enlZ0Iso : Spec Γ((D.enlZ0 hDGC hrel).Xbar, (D.enlZ0 hDGC hrel).U) ≅ D.enlW hDGC hrel :=
  lineQuotCurveIso K (D.enlT hDGC hrel) (D.enlH hDGC hrel) (D.enlH_ne_zero hDGC hrel)
    (D.finite_enlT hDGC hrel) (D.enlH_etale hDGC hrel) (D.enlRho hDGC hrel)
    (D.enlRho_fix hDGC hrel) (D.transcendental_enlT hDGC hrel)

instance isFiniteEtale_enlZ0Iso_comp :
    IsFiniteEtale ((D.enlZ0Iso hDGC hrel).hom ≫ D.enlWHom hDGC hrel) := by
  haveI : IsFiniteEtale (D.enlZ0Iso hDGC hrel).hom := {}
  exact MorphismProperty.comp_mem _ _ _ (inferInstanceAs (IsFiniteEtale _)) inferInstance

/-- `Spec Γ(Z₀) ≅ W ⟶ Spec Γ(L)` lies over `Spec M₀ ⟶ Spec K`. -/
lemma enlZ0_over :
    ((D.enlZ0Iso hDGC hrel).hom ≫ D.enlWHom hDGC hrel) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K Γ((D.enlL hDGC hrel).Xbar,
          (D.enlL hDGC hrel).U))) =
      Spec.map (CommRingCat.ofHom (algebraMap (D.enlM₀ hDGC hrel) Γ((D.enlZ0 hDGC hrel).Xbar,
          (D.enlZ0 hDGC hrel).U))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (D.enlM₀ hDGC hrel))) :=
  (Category.assoc _ _ _).trans
    (coverIso_spec (D.enlL hDGC hrel) (D.enlL_cusp hDGC hrel) (D.enlWHom hDGC hrel))

/-- `Π_{Z₀} ≃ E₁ ⊆ π₁ᵉᵗ(L, η')`. -/
def enlPhiZL : π₁ᵉᵗ(D.enlZ0Pt hDGC hrel) →*
    π₁ᵉᵗ(D.enlEta hDGC hrel) :=
  (D.enlE₁ hDGC hrel).subtype.comp (D.enlZ0PiEquiv hDGC hrel).toMulEquiv.toMonoidHom

lemma isConjInduced_enlPhiZL :
    IsConjInduced ((D.enlZ0Iso hDGC hrel).hom ≫ D.enlWHom hDGC hrel) (D.enlPhiZL hDGC hrel) :=
  (D.isConjInduced_enlZ0PiEquiv hDGC hrel).congr_fun fun _ ↦ rfl

/-- **`ι_{V''} : Π_{V''} → Π_{Z₀}`**, `y ↦ e⁻¹(φ_L y)` (`e : Π_{Z₀} ≃ E₁`). -/
def enlIotaV : π₁ᵉᵗ(D.enlVPt hDGC hrel) →ₜ*
    π₁ᵉᵗ(D.enlZ0Pt hDGC hrel) :=
  (ContinuousMonoidHom.toContinuousMonoidHom (D.enlZ0PiEquiv hDGC hrel).symm).comp
    { toMonoidHom := (D.enlPhiL hDGC hrel).toMonoidHom.codRestrict (D.enlE₁ hDGC hrel)
        (D.enlPhiL_mem_E₁ hDGC hrel)
      continuous_toFun := (D.enlPhiL hDGC hrel).continuous.subtype_mk _ }

lemma enlZ0PiEquiv_enlIotaV (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    D.enlZ0PiEquiv hDGC hrel (D.enlIotaV hDGC hrel y) = ⟨_, D.enlPhiL_mem_E₁ hDGC hrel y⟩ :=
  (D.enlZ0PiEquiv hDGC hrel).apply_symm_apply _

lemma enlPhiZL_enlIotaV (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    D.enlPhiZL hDGC hrel (D.enlIotaV hDGC hrel y) = D.enlPhiL hDGC hrel y :=
  congrArg Subtype.val (D.enlZ0PiEquiv_enlIotaV hDGC hrel y)

/-- **`N = e⁻¹(ker p₁) ≤ Π_{Z₀}`**, the image of `ι_{V''}` (`mem_enlN_iff`), of finite index. -/
def enlN : Subgroup π₁ᵉᵗ(D.enlZ0Pt hDGC hrel) :=
  (D.enlP₁ hDGC hrel).ker.comap (D.enlZ0PiEquiv hDGC hrel).toMulEquiv.toMonoidHom

/-- `N` has finite index (`G` is finite). -/
lemma index_enlN_ne_zero : (D.enlN hDGC hrel).index ≠ 0 := by
  rw [enlN, Subgroup.index_comap_of_surjective _ (D.enlZ0PiEquiv hDGC hrel).surjective,
    Subgroup.index_ker]
  exact (Nat.card_pos (α := (D.enlP₁ hDGC hrel).range)).ne'

/-- **`N` is the image of `ι_{V''}`.** -/
lemma mem_enlN_iff (x : π₁ᵉᵗ(D.enlZ0Pt hDGC hrel)) :
    x ∈ D.enlN hDGC hrel ↔ ∃ y, D.enlIotaV hDGC hrel y = x := by
  constructor
  · intro hx
    have hx' : ((D.enlZ0PiEquiv hDGC hrel x : D.enlE₁ hDGC hrel) : π₁ᵉᵗ(D.enlEta hDGC hrel)) ∈
        (coverSubgroup (D.enlCover hDGC hrel) (D.enlPt hDGC hrel) (D.enlPt_spec hDGC hrel) :
          Subgroup π₁ᵉᵗ(D.enlEta hDGC hrel)) :=
      D.mem_coverSubgroup_of_mem_ker_enlP₁ hDGC hrel hx
    rw [← range_fundamentalGroupMap_eq_coverSubgroup] at hx'
    obtain ⟨τ, hτ⟩ := hx'
    refine ⟨(D.enlTheta hDGC hrel).symm τ, (D.enlZ0PiEquiv hDGC hrel).injective (Subtype.ext ?_)⟩
    refine (congrArg Subtype.val (D.enlZ0PiEquiv_enlIotaV hDGC hrel _)).trans ?_
    refine (D.enlPhiL_apply hDGC hrel _).trans ?_
    refine (congrArg (fundamentalGroupMap (D.enlCover hDGC hrel) (D.enlPt_spec hDGC hrel))
      ((D.enlTheta hDGC hrel).apply_symm_apply τ)).trans ?_
    exact hτ
  · rintro ⟨y, rfl⟩
    change D.enlZ0PiEquiv hDGC hrel (D.enlIotaV hDGC hrel y) ∈ (D.enlP₁ hDGC hrel).ker
    rw [enlZ0PiEquiv_enlIotaV]
    exact D.enlPhiL_mem_ker hDGC hrel y

/-- **Cuspidal inertia groups of `V''` and of `Z₀`**: for a cuspidal inertia group `J` of
`Π_{V''}` there is a cuspidal inertia group `C` of `Π_{Z₀}` with `ι(J) ≤ C` and `C ∩ N ≤ ι(J)`
(`C` is the preimage of a cuspidal inertia group `I_L ⊇ φ_L(J)` of `π₁ᵉᵗ(L)`, whose preimage in
`Π_{V''}` is a cuspidal inertia group containing `J` with finite index, hence equal to `J`). -/
theorem exists_arithCusps_enlIotaV {J}
    (hJ : J ∈ arithCusps Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel)) :
    ∃ C ∈ arithCusps Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel),
      J.map (D.enlIotaV hDGC hrel).toMonoidHom ≤ C ∧
        C ⊓ D.enlN hDGC hrel ≤ J.map (D.enlIotaV hDGC hrel).toMonoidHom := by
  set f := (D.enlPhiL hDGC hrel).toMonoidHom
  obtain ⟨I, hI, hJI, hfin⟩ := exists_arithCusps_map_le_of_conjInduced Ω (D.enlL hDGC hrel)
    (D.enlL_cusp hDGC hrel) (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel) _ f
    (D.isConjInduced_enlPhiL hDGC hrel) hJ
  have hJ' := comap_mem_arithCusps_of_conjInduced Ω (D.enlL hDGC hrel) (D.enlL_cusp hDGC hrel)
    (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel) _ (D.enlPhiL_over hDGC hrel) f
    (D.isConjInduced_enlPhiL hDGC hrel) hI
  have hC := comap_mem_arithCusps_of_conjInduced Ω (D.enlL hDGC hrel) (D.enlL_cusp hDGC hrel)
    (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) _ (D.enlZ0_over hDGC hrel) (D.enlPhiZL hDGC hrel)
    (D.isConjInduced_enlPhiZL hDGC hrel) hI
  have hinj : Function.Injective f := injective_of_conjInduced_cover Ω (D.enlL hDGC hrel)
    (D.enlL_cusp hDGC hrel) (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel) _
    (D.isConjInduced_enlPhiL hDGC hrel)
  have hle : J ≤ I.comap f := Subgroup.map_le_iff_le_comap.1 hJI
  have hfin' : J.relIndex (I.comap f) ≠ 0 := by
    have h1 : J.map f ≤ f.range ⊓ I := le_inf (Subgroup.map_le_range f J) hJI
    have h2 := Subgroup.relIndex_mul_relIndex (J.map f) (f.range ⊓ I) I h1 inf_le_right
    have h3 : (J.map f).relIndex (f.range ⊓ I) ≠ 0 := left_ne_zero_of_mul (h2.symm ▸ hfin)
    have e1 := Subgroup.relIndex_map_map_of_injective J (I.comap f) hinj
    have e2 : (I.comap f).map f = f.range ⊓ I := Subgroup.map_comap_eq f I
    exact e1 ▸ e2.symm ▸ h3
  have hJeq : J = I.comap f := eq_of_le_of_mem_arithCusps Ω _ _ hJ hJ' hle hfin'
  refine ⟨_, hC, ?_, ?_⟩
  · rintro _ ⟨y, hy, rfl⟩
    change D.enlPhiZL hDGC hrel (D.enlIotaV hDGC hrel y) ∈ I
    rw [enlPhiZL_enlIotaV]
    exact hle hy
  · rintro x ⟨hxC, hxN⟩
    obtain ⟨y, rfl⟩ := (D.mem_enlN_iff hDGC hrel x).1 hxN
    refine ⟨y, ?_, rfl⟩
    rw [hJeq]
    change f y ∈ I
    have hxC' : D.enlPhiZL hDGC hrel (D.enlIotaV hDGC hrel y) ∈ I := hxC
    rw [enlPhiZL_enlIotaV] at hxC'
    exact hxC'


/-! ### The homomorphism `Φ_Z : Π_{Z₀} ↠ P'` -/

variable (hPP' : D.ιNHom.range ≤ P')

/-- **`Φ_Z = Φ ∘ e : Π_{Z₀} ↠ P'`** (`e : Π_{Z₀} ≃ E₁`, `Φ = GeomModel.enlPhi`). -/
def enlPhiZ : π₁ᵉᵗ(D.enlZ0Pt hDGC hrel) →ₜ* P' :=
  (D.enlPhi hDGC hrel hPP').comp
    (ContinuousMonoidHom.toContinuousMonoidHom (D.enlZ0PiEquiv hDGC hrel))

lemma enlPhiZ_apply (x : π₁ᵉᵗ(D.enlZ0Pt hDGC hrel)) :
    D.enlPhiZ hDGC hrel hPP' x = D.enlPhi hDGC hrel hPP' (D.enlZ0PiEquiv hDGC hrel x) :=
  rfl

/-- **`Φ_Z` is surjective.** -/
theorem enlPhiZ_surjective : Function.Surjective (D.enlPhiZ hDGC hrel hPP') :=
  (D.enlPhi_surjective hDGC hrel hPP').comp (D.enlZ0PiEquiv hDGC hrel).surjective

/-- **`Φ_Z ∘ ι_{V''} = ι ∘ ψ_{V''}`.** -/
theorem coe_enlPhiZ_enlIotaV (y : π₁ᵉᵗ(D.enlVPt hDGC hrel)) :
    ((D.enlPhiZ hDGC hrel hPP' (D.enlIotaV hDGC hrel y) : D.Nrm) : A.grp) =
      D.ι (D.enlPsiV hDGC hrel y) := by
  have h1 : D.enlPhiZ hDGC hrel hPP' (D.enlIotaV hDGC hrel y) =
      D.enlPhi hDGC hrel hPP' ⟨_, D.enlPhiL_mem_E₁ hDGC hrel y⟩ :=
    congrArg (D.enlPhi hDGC hrel hPP') (D.enlZ0PiEquiv_enlIotaV hDGC hrel y)
  rw [h1]
  refine (D.coe_enlPhi_ker hDGC hrel hPP' ⟨_, D.enlPhiL_mem_ker hDGC hrel y⟩).trans ?_
  rw [enlKerToV_enlPhiL]
  rfl

/-- **`ker ψ_{V''} = ι_{V''}⁻¹(ker Φ_Z)`.** -/
theorem ker_enlPsiV_eq : (D.enlPsiV hDGC hrel).toMonoidHom.ker =
    (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker.comap (D.enlIotaV hDGC hrel).toMonoidHom := by
  ext y
  rw [Subgroup.mem_comap, MonoidHom.mem_ker, MonoidHom.mem_ker]
  constructor
  · intro h
    refine Subtype.ext (Subtype.ext ?_)
    refine (D.coe_enlPhiZ_enlIotaV hDGC hrel hPP' y).trans ?_
    change D.ι (D.enlPsiV hDGC hrel y) = 1
    rw [show D.enlPsiV hDGC hrel y = 1 from h, map_one]
  · intro h
    apply D.inj
    have h' : D.enlPhiZ hDGC hrel hPP' (D.enlIotaV hDGC hrel y) = 1 := h
    refine (D.coe_enlPhiZ_enlIotaV hDGC hrel hPP' y).symm.trans ?_
    rw [h', map_one]
    rfl

/-- **`ker Φ_Z ≤ N`** (`Φ_Z` lies over `G`). -/
theorem ker_enlPhiZ_le_enlN : (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker ≤ D.enlN hDGC hrel := by
  intro x hx
  have h := D.enlP₂_enlPhi hDGC hrel hPP' (D.enlZ0PiEquiv hDGC hrel x)
  have hx' : D.enlPhi hDGC hrel hPP' (D.enlZ0PiEquiv hDGC hrel x) = 1 := hx
  rw [hx', map_one] at h
  exact MonoidHom.mem_ker.2 h.symm

/-! ### Step 1: the kernel of `Φ_Z` is generated by cuspidal inertia groups -/

variable {D hDGC hrel hPP'} in
/-- The torsion-free subgroup `T = P' ∩ Δ_A` of `P'`. -/
lemma isTorsionFree_enlT (htf : IsTorsionFreeSubgroup (P'.map D.Nrm.subtype ⊓ A.Delta)) :
    IsTorsionFreeSubgroup (A.Delta.comap (D.Nrm.subtype.comp P'.subtype)) := by
  intro x hx hfin
  have hinj : Function.Injective (D.Nrm.subtype.comp P'.subtype) :=
    Subtype.val_injective.comp Subtype.val_injective
  refine (injective_iff_map_eq_one _).1 hinj x (htf _ ⟨⟨(x : D.Nrm), x.2, rfl⟩, hx⟩ ?_)
  exact (D.Nrm.subtype.comp P'.subtype).isOfFinOrder hfin

variable (hΔ : ∀ γ, γ ∈ (projGk Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel)).toMonoidHom.ker ↔
    ((D.enlPhiZ hDGC hrel hPP' γ : D.Nrm) : A.grp) ∈ A.Delta)
  (htf : IsTorsionFreeSubgroup (P'.map D.Nrm.subtype ⊓ A.Delta))

include hΔ in
/-- `Φ_Z` maps cuspidal inertia groups of `Z₀` into `P' ∩ Δ_A`. -/
lemma map_le_enlT {C} (hC : C ∈ arithCusps Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel)) :
    C.map (D.enlPhiZ hDGC hrel hPP').toMonoidHom ≤
      A.Delta.comap (D.Nrm.subtype.comp P'.subtype) := by
  rintro _ ⟨x, hx, rfl⟩
  exact (hΔ x).1 (arithCusps_le Ω _ _ hC hx)

include hΔ htf in
/-- **The torsion argument: the inertia groups `C` of `Z₀` over the cusps of `V''` lying in
`U_Y` have trivial (in particular finite) image in `P'`.** For a cuspidal inertia group `J` of
`Π_{V''}` killed by `ψ_{V''}` (i.e. over a point of `U_Y ∖ V''`), there is a cuspidal inertia
group `C ⊇ ι(J)` of `Π_{Z₀}` with `Φ_Z(C) = 1`: `C ∩ N ≤ ι(J)` is killed, `N` has finite index,
and `Φ_Z(C)` lies in the torsion-free `P' ∩ Δ_A`. -/
theorem exists_map_enlPhiZ_eq_bot {J}
    (hJ : J ∈ arithCusps Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel))
    (hJk : J ≤ (D.enlPsiV hDGC hrel).toMonoidHom.ker) :
    ∃ C ∈ arithCusps Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel),
      J.map (D.enlIotaV hDGC hrel).toMonoidHom ≤ C ∧
        C.map (D.enlPhiZ hDGC hrel hPP').toMonoidHom = ⊥ := by
  obtain ⟨C, hC, h1, h2⟩ := D.exists_arithCusps_enlIotaV hDGC hrel hJ
  refine ⟨C, hC, h1, map_eq_bot_of_inf_le_ker _ (D.index_enlN_ne_zero hDGC hrel)
    (isTorsionFree_enlT htf) (D.map_le_enlT hDGC hrel hPP' hΔ hC)
    (h2.trans (Subgroup.map_le_iff_le_comap.2 (hJk.trans (D.ker_enlPsiV_eq hDGC hrel hPP').le)))⟩

include hΔ htf in
/-- **Step 1: `ker Φ_Z` is the closed normal subgroup generated by the cuspidal inertia groups of
`Π_{Z₀}` it contains.** -/
theorem ker_enlPhiZ_eq_closure : (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker =
    (Subgroup.normalClosure (⋃ (C) (_ : C ∈ arithCusps Ω (D.enlZ0 hDGC hrel)
      (D.enlZ0_cusp hDGC hrel) ∧ C ≤ (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker),
        (C : Set π₁ᵉᵗ(D.enlZ0Pt hDGC hrel)))).topologicalClosure
    := by
  have hclosed : IsClosed ((D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker :
      Set π₁ᵉᵗ(D.enlZ0Pt hDGC hrel)) :=
    isClosed_singleton.preimage (D.enlPhiZ hDGC hrel hPP').continuous
  have H := D.isConjInduced_enlPsiV hDGC hrel
  haveI : Nonempty (baseChangeOpen D.M Ω (X := (D.enlV hDGC hrel).Xbar) D.Y.U) :=
    (nonempty_baseChangeOpen D.M Ω D.Y.nonempty).to_subtype
  have hgenV := ker_eq_closure_cusps_of_conjInduced_fill Ω (D.enlV hDGC hrel)
    (D.enlV_cusp hDGC hrel) (D.Y.Xbar.basicOpen_le (D.enlR hDGC hrel)) D.hY D.Y.hyperbolic
    (D.enlPsiV hDGC hrel).toMonoidHom H
  refine ker_eq_closure_of_cusps (D.enlPhiZ hDGC hrel hPP').toMonoidHom hclosed
    (D.index_enlN_ne_zero hDGC hrel) (isTorsionFree_enlT htf) _
    ((fun J ↦ J.map (D.enlIotaV hDGC hrel).toMonoidHom) ''
      arithCusps Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel))
    (fun C hC ↦ D.map_le_enlT hDGC hrel hPP' hΔ hC) ?_ ?_
  · refine le_antisymm (fun x hx ↦ ?_) (Subgroup.topologicalClosure_minimal _
      (Subgroup.normalClosure_le_normal fun s hs ↦ ?_) hclosed)
    · obtain ⟨y, rfl⟩ := (D.mem_enlN_iff hDGC hrel x).1 (D.ker_enlPhiZ_le_enlN hDGC hrel hPP' hx)
      have hy : y ∈ (D.enlPsiV hDGC hrel).toMonoidHom.ker := (D.ker_enlPsiV_eq hDGC hrel hPP').ge hx
      refine closure_normalClosure_le_comap (D.enlIotaV hDGC hrel).toMonoidHom
        (D.enlIotaV hDGC hrel).continuous (fun s hs ↦ ?_) (hgenV.le hy)
      obtain ⟨I, ⟨hI, hIk⟩, hsI⟩ := Set.mem_iUnion₂.1 hs
      exact Set.mem_iUnion₂.2 ⟨I.map (D.enlIotaV hDGC hrel).toMonoidHom,
        ⟨⟨I, hI, rfl⟩, Subgroup.map_le_iff_le_comap.2
          (hIk.trans (D.ker_enlPsiV_eq hDGC hrel hPP').le)⟩, ⟨s, hsI, rfl⟩⟩
    · obtain ⟨J, ⟨-, hJk⟩, hsJ⟩ := Set.mem_iUnion₂.1 hs
      exact hJk hsJ
  · rintro _ ⟨J, hJ, rfl⟩ hJk
    obtain ⟨C, hC, h1, h2⟩ := D.exists_arithCusps_enlIotaV hDGC hrel hJ
    exact ⟨C, hC, h1, h2.trans hJk⟩

/-! ### Step 2: some cuspidal inertia group of `Z₀` survives -/

/-- **Step 2: some cuspidal inertia group of `Π_{Z₀}` is not killed by `Φ_Z`**: one over a cusp
of `Y` (its intersection with `Π_{V''}` contains a cuspidal inertia group of `Π_{V''}` not killed
by the filling `V'' ⊆ U_Y`, `CurvesJacobian.Cusp.false_of_le_ker`). -/
theorem exists_cusp_not_le_ker_enlPhiZ :
    ∃ C ∈ arithCusps Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel),
      ¬ C ≤ (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker := by
  have hle := D.Y.Xbar.basicOpen_le (D.enlR hDGC hrel)
  obtain ⟨y, hy⟩ := compl_nonempty_baseChangeOpen D.M Ω D.hY
  haveI : Nonempty (baseChangeOpen D.M Ω (X := (D.enlV hDGC hrel).Xbar) D.Y.U) :=
    (nonempty_baseChangeOpen D.M Ω D.Y.nonempty).to_subtype
  obtain ⟨W, -, hWV, hWU⟩ := exists_isCentredOn_not_isCentredOn (geomData Ω (D.enlV hDGC hrel))
    (geomCurve Ω (D.enlV hDGC hrel))
    (curveEquivL Ω (transcendental_geomCoord Ω (D.enlV hDGC hrel)))
    (curveEquivL_algebraMap Ω (transcendental_geomCoord Ω (D.enlV hDGC hrel))) (V := ⊤)
    (U := baseChangeOpen D.M Ω (X := (D.enlV hDGC hrel).Xbar) D.Y.U)
    (compl_finite_baseChangeOpen D.M Ω D.Y.nonempty) (Set.mem_univ y) hy
  have hWU' : ¬ IsCentredOn (geomData Ω (D.enlV hDGC hrel)) (geomCurve Ω (D.enlV hDGC hrel))
      (curveEquivL Ω (transcendental_geomCoord Ω (D.enlV hDGC hrel)))
      (geomOpen Ω (D.enlV hDGC hrel)) W := fun h ↦
    hWU (isCentredOn_mono Ω (D.enlV hDGC hrel) (V := geomOpen Ω (D.enlV hDGC hrel))
      (V' := baseChangeOpen D.M Ω (X := (D.enlV hDGC hrel).Xbar) D.Y.U)
      (baseChangeOpen_mono D.M Ω hle) h)
  have hJ : ((geomCuspInertia Ω (D.enlV hDGC hrel) W).map
      (geomToPi Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel))).map
      (MulAut.conj 1).toMonoidHom ∈ arithCusps Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel) :=
    ⟨_, ⟨W, hWV.1, hWU', rfl⟩, 1, rfl⟩
  obtain ⟨C, hC, hJC, -⟩ := D.exists_arithCusps_enlIotaV hDGC hrel hJ
  refine ⟨C, hC, fun hCk ↦ ?_⟩
  have hJk : ((geomCuspInertia Ω (D.enlV hDGC hrel) W).map
      (geomToPi Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel))).map
      (MulAut.conj 1).toMonoidHom ≤ (D.enlPsiV hDGC hrel).toMonoidHom.ker := by
    exact (Subgroup.map_le_iff_le_comap.1 (hJC.trans hCk)).trans
      (D.ker_enlPsiV_eq hDGC hrel hPP').ge
  have hker := ker_eq_ker_fillMap_of_conjInduced Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel)
    hle D.hY D.Y.hyperbolic _ (D.isConjInduced_enlPsiV hDGC hrel)
  exact false_of_le_ker Ω (D.enlV hDGC hrel) (D.enlV_cusp hDGC hrel) hle D.hY
    (isHyperbolic_baseChange Ω D.Y) hWV.1 hWU 1
    (by rw [Subgroup.relIndex_self]; exact one_ne_zero) (hJk.trans hker.le)

/-! ### Step 3: the filling -/

/-- Two non-commuting elements of `Δ_Y` (`Δ_Y` is slim and nontrivial). -/
lemma exists_not_commute_Delta : ∃ a ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker,
    ∃ b ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker, a * b ≠ b * a := by
  have hs := (arithmeticExt Ω D.Y D.hY).slim_delta.center_eq_bot
  obtain ⟨a, ha⟩ := (Subgroup.ne_bot_iff_exists_ne_one).1
    (arithmeticExt Ω D.Y D.hY).nontrivial_delta
  have hac : a ∉ Subgroup.center _ := fun h ↦ ha (by rw [hs] at h; exact h)
  rw [Subgroup.mem_center_iff] at hac
  obtain ⟨b, hb⟩ := not_forall.1 hac
  exact ⟨a.1, a.2, b.1, b.2, fun h ↦ hb (Subtype.ext h.symm)⟩

include hΔ in
/-- Preimages of elements of `ι(Δ_Y)` under `Φ_Z` lie in `Δ_{Z₀}`. -/
lemma mem_ker_projGk_of_enlPhiZ_eq {x : π₁ᵉᵗ(D.enlZ0Pt hDGC hrel)} {σ : D.Pi}
    (hσ : D.ιN σ ∈ P') (hx : D.enlPhiZ hDGC hrel hPP' x = ⟨D.ιN σ, hσ⟩)
    (hσk : σ ∈ (projGk Ω D.Y D.hY).toMonoidHom.ker) :
    x ∈ (projGk Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel)).toMonoidHom.ker := by
  refine (hΔ x).2 ?_
  rw [hx]
  exact (Subgroup.ext_iff.1 D.comap_Delta σ).2 hσk

include hΔ in
/-- **Hyperbolicity of the filling**: if the kernel of the filling map `Π_{Z₀} → Π_{U'}` is
`ker Φ_Z`, then `(X̄_{Z₀}, U')` is hyperbolic: two non-commuting elements of `Δ_Y` give elements
of `Δ_{Z₀}` whose images under the filling map do not commute. -/
theorem enlFill_hyp {U' : (D.enlZ0 hDGC hrel).Xbar.Opens} (h : (D.enlZ0 hDGC hrel).U ≤ U')
    (hc' : (U' : Set (D.enlZ0 hDGC hrel).Xbar)ᶜ.Nonempty)
    (hker : (fillMap Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) h).toMonoidHom.ker =
      (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker) :
    haveI := IsCurveOver.isIntegral (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar
    2 < 2 * Anabelian.curveGenus (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar +
      cuspDegree (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar U' := by
  obtain ⟨a, ha, b, hb, hab⟩ := D.exists_not_commute_Delta
  obtain ⟨a', ha'⟩ := D.enlPhiZ_surjective hDGC hrel hPP' ⟨D.ιN a, hPP' ⟨a, rfl⟩⟩
  obtain ⟨b', hb'⟩ := D.enlPhiZ_surjective hDGC hrel hPP' ⟨D.ιN b, hPP' ⟨b, rfl⟩⟩
  have hnc : D.enlPhiZ hDGC hrel hPP' a' * D.enlPhiZ hDGC hrel hPP' b' ≠
      D.enlPhiZ hDGC hrel hPP' b' * D.enlPhiZ hDGC hrel hPP' a' := by
    rw [ha', hb']
    intro hc
    apply hab
    apply D.inj
    rw [map_mul, map_mul]
    exact congrArg (fun z : P' ↦ ((z : D.Nrm) : A.grp)) hc
  refine two_lt_of_not_commute_fillMap Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) h hc'
    ⟨a', D.mem_ker_projGk_of_enlPhiZ_eq hDGC hrel hPP' hΔ _ ha' ha, b',
      D.mem_ker_projGk_of_enlPhiZ_eq hDGC hrel hPP' hΔ _ hb' hb, fun hc ↦ hnc ?_⟩
  have h1 : (fillMap Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) h).toMonoidHom (a' * b') =
      (fillMap Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) h).toMonoidHom (b' * a') :=
    (map_mul _ a' b').trans (hc.trans (map_mul _ b' a').symm)
  have h2 : (D.enlPhiZ hDGC hrel hPP').toMonoidHom (a' * b') =
      (D.enlPhiZ hDGC hrel hPP').toMonoidHom (b' * a') :=
    (MonoidHom.eq_iff _).2 (hker.le ((MonoidHom.eq_iff _).1 h1))
  exact (map_mul _ a' b').symm.trans (h2.trans (map_mul _ b' a'))

include hΔ htf in
/-- **Step 3: the filling of `Z₀`**: an open `U' ⊇ U_{Z₀}` with a cusp such that the kernel of
the filling map `Π_{Z₀} → Π_{U'}` is `ker Φ_Z` (`CurvesJacobian.Cusp.exists_fill_ker_eq`), and
`(X̄_{Z₀}, U')` is hyperbolic (`GeomModel.enlFill_hyp`). -/
theorem exists_enlFill :
    ∃ (U' : (D.enlZ0 hDGC hrel).Xbar.Opens) (h : (D.enlZ0 hDGC hrel).U ≤ U')
      (_ : (U' : Set (D.enlZ0 hDGC hrel).Xbar)ᶜ.Nonempty)
      (_ : Nonempty (baseChangeOpen (D.enlM₀ hDGC hrel) Ω U')),
      (fillMap Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) h).toMonoidHom.ker =
          (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker ∧
        (haveI := IsCurveOver.isIntegral (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar;
          2 < 2 * Anabelian.curveGenus (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar +
            cuspDegree (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar U') := by
  obtain ⟨U', h, hc', hne, hker⟩ := exists_fill_ker_eq Ω (D.enlZ0 hDGC hrel)
    (D.enlZ0_cusp hDGC hrel) _ (D.ker_enlPhiZ_eq_closure hDGC hrel hPP' hΔ htf)
    (D.exists_cusp_not_le_ker_enlPhiZ hDGC hrel hPP')
  exact ⟨U', h, hc', hne, hker, D.enlFill_hyp hDGC hrel hPP' hΔ h hc' hker⟩

/-! ### Step 4: the filled curve `Z` and `Π_Z ≃ P'` -/

/-- **The open `U' ⊇ U_{Z₀}` of the filling** (`GeomModel.exists_enlFill`). -/
def enlFillU : (D.enlZ0 hDGC hrel).Xbar.Opens :=
  (D.exists_enlFill hDGC hrel hPP' hΔ htf).choose

lemma enlFillU_le : (D.enlZ0 hDGC hrel).U ≤ D.enlFillU hDGC hrel hPP' hΔ htf :=
  (D.exists_enlFill hDGC hrel hPP' hΔ htf).choose_spec.choose

lemma enlFillU_cusp :
    (D.enlFillU hDGC hrel hPP' hΔ htf : Set (D.enlZ0 hDGC hrel).Xbar)ᶜ.Nonempty :=
  (D.exists_enlFill hDGC hrel hPP' hΔ htf).choose_spec.choose_spec.choose

instance nonempty_enlFillU :
    Nonempty (baseChangeOpen (D.enlM₀ hDGC hrel) Ω (D.enlFillU hDGC hrel hPP' hΔ htf)) :=
  (D.exists_enlFill hDGC hrel hPP' hΔ htf).choose_spec.choose_spec.choose_spec.choose

/-- **The kernel of the filling map is `ker Φ_Z`.** -/
theorem ker_fillMap_enlFillU :
    (fillMap Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel)
      (D.enlFillU_le hDGC hrel hPP' hΔ htf)).toMonoidHom.ker =
        (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker :=
  (D.exists_enlFill hDGC hrel hPP' hΔ htf).choose_spec.choose_spec.choose_spec.choose_spec.1

/-- `(X̄_{Z₀}, U')` is hyperbolic. -/
lemma enlFillU_hyp :
    haveI := IsCurveOver.isIntegral (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar
    2 < 2 * Anabelian.curveGenus (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar +
      cuspDegree (D.enlM₀ hDGC hrel) (D.enlZ0 hDGC hrel).Xbar (D.enlFillU hDGC hrel hPP' hΔ htf) :=
  (D.exists_enlFill hDGC hrel hPP' hΔ htf).choose_spec.choose_spec.choose_spec.choose_spec.2

/-- **The filled quotient curve `Z = (X̄_{Z₀}, U')`** over `M₀`. -/
def enlFillCurve : HypCurve (D.enlM₀ hDGC hrel) :=
  fillCurve (D.enlZ0 hDGC hrel) (D.enlFillU_le hDGC hrel hPP' hΔ htf)
    (D.enlFillU_hyp hDGC hrel hPP' hΔ htf)

/-- `Z` has a cusp. -/
lemma enlFillCurve_cusp : ((D.enlFillCurve hDGC hrel hPP' hΔ htf).U :
    Set (D.enlFillCurve hDGC hrel hPP' hΔ htf).Xbar)ᶜ.Nonempty :=
  D.enlFillU_cusp hDGC hrel hPP' hΔ htf

/-- The base point of `Π_Z`. -/
abbrev enlFillPt : Spec (.of Ω) ⟶ Spec Γ((D.enlFillCurve hDGC hrel hPP' hΔ htf).Xbar,
    (D.enlFillCurve hDGC hrel hPP' hΔ htf).U) :=
  basePoint Ω (D.enlFillCurve hDGC hrel hPP' hΔ htf) (D.enlFillCurve_cusp hDGC hrel hPP' hΔ htf) ≫
    baseChangeSpec (D.enlM₀ hDGC hrel) Ω Γ((D.enlFillCurve hDGC hrel hPP' hΔ htf).Xbar,
      (D.enlFillCurve hDGC hrel hPP' hΔ htf).U)

/-- The canonical surjection `Π_{Z₀} ↠ Π_Z` (`CurvesJacobian.Cusp.fillPiHom`). -/
abbrev enlFillPiHom : π₁ᵉᵗ(D.enlZ0Pt hDGC hrel) →ₜ*
    π₁ᵉᵗ(D.enlFillPt hDGC hrel hPP' hΔ htf) :=
  fillPiHom Ω (D.enlZ0 hDGC hrel) (D.enlZ0_cusp hDGC hrel) (D.enlFillU_le hDGC hrel hPP' hΔ htf)
    (D.enlFillU_cusp hDGC hrel hPP' hΔ htf) (D.enlFillU_hyp hDGC hrel hPP' hΔ htf)

/-- `Π_{Z₀} → Π_Z` is surjective. -/
lemma enlFillPiHom_surjective : Function.Surjective (D.enlFillPiHom hDGC hrel hPP' hΔ htf) :=
  surjective_of_conjInduced_fill Ω _ _ _ _ _ (isConjInduced_fillPiHom Ω _ _ _ _ _)

/-- **The kernel of `Π_{Z₀} → Π_Z` is `ker Φ_Z`.** -/
lemma ker_enlFillPiHom : (D.enlFillPiHom hDGC hrel hPP' hΔ htf).toMonoidHom.ker =
    (D.enlPhiZ hDGC hrel hPP').toMonoidHom.ker :=
  (ker_eq_ker_fillMap_of_conjInduced Ω _ _ _ _ _ _ (isConjInduced_fillPiHom Ω _ _ _ _ _)).trans
    (D.ker_fillMap_enlFillU hDGC hrel hPP' hΔ htf)

/-- **`Π_Z ≃ₜ* P'`** (`Π_Z` at the base point of `Z`), with `enlFillEquiv ∘ fillPiHom = Φ_Z`
(`GeomModel.enlFillEquiv_fillPiHom`). -/
def enlFillEquiv : π₁ᵉᵗ(D.enlFillPt hDGC hrel hPP' hΔ htf) ≃ₜ* P' :=
  contMulEquivOfKerEq (D.enlFillPiHom hDGC hrel hPP' hΔ htf)
    (D.enlFillPiHom_surjective hDGC hrel hPP' hΔ htf) (D.enlPhiZ hDGC hrel hPP')
    (D.ker_enlFillPiHom hDGC hrel hPP' hΔ htf) (D.enlPhiZ_surjective hDGC hrel hPP')

/-- **`enlFillEquiv ∘ fillPiHom = Φ_Z`.** -/
theorem enlFillEquiv_fillPiHom
    (σ : π₁ᵉᵗ(D.enlZ0Pt hDGC hrel)) :
    D.enlFillEquiv hDGC hrel hPP' hΔ htf (D.enlFillPiHom hDGC hrel hPP' hΔ htf σ) =
      D.enlPhiZ hDGC hrel hPP' σ :=
  contMulEquivOfKerEq_apply _ _ _ _ _ σ

end CurvesJacobian.Cusp.GeomModel
