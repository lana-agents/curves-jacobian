import Mathlib.RingTheory.Invariant.Profinite
import Mathlib.FieldTheory.Galois.Infinite
import Mathlib.FieldTheory.Galois.Profinite
import Mathlib.FieldTheory.Minpoly.Field
import Mathlib.RingTheory.Valuation.ValuationSubring

/-!
# Galois acts transitively on the extensions of a place (MR8.3, task 2 (iii))

Let `Ω / L` be a (possibly infinite) Galois extension and `W, W'` valuation subrings of `Ω` with
the same restriction `O = W ∩ L = W' ∩ L` to `L`. Then `W' = σ(W)` for some `σ ∈ Gal(Ω/L)`
(`CurvesJacobian.Cusp.exists_algEquiv_comap_eq`).

This is the input for "the cusp inertia groups over one cusp are conjugate": the places of the
separable closure `Ω` of the function field over one cusp `x` are `Gal(Ω/L)`-conjugate, so the
kernel of filling in `x` is topologically normally generated by *one* cuspidal inertia group
([AbsTopI] Definition 4.2 (iii)(c), `Topics in Absolute Anabelian Geometry I.txt` l.3011–3014).

## Proof

* `holo Ω O ⊆ Ω`: the elements lying in every valuation subring of `Ω` over `O` (the integral
  closure of `O` in `Ω`). It is stable under `Gal(Ω/L)`, and its `Gal(Ω/L)`-invariants are `O`.
* Mathlib's `Algebra.IsInvariant.exists_smul_of_under_eq_of_profinite` (transitivity of a
  profinite group on the primes over a given prime) gives `σ` with `σ(𝔪_W ∩ holo Ω O) =
  𝔪_{W'} ∩ holo Ω O`.
* **A place is determined by its centre** (`le_of_comap_eq_of_nonunits`): if `V₁, V₂` restrict to
  the same `O` and have the same centre on `holo Ω O`, then `V₁ = V₂`. For `x ∈ V₁` with
  normalised minimal-polynomial relation `∑ bᵢ xⁱ = 0` (`bᵢ ∈ O`, `b_j` the last unit), the
  elements `s = ∑_{i ≥ j} bᵢ x^{i-j}` and `s x` lie in `holo Ω O` (use `x ∈ V` or, if not, the
  relation rewritten in `x⁻¹`), `s` is a unit of `V₁` (it is `≡ b_j` mod `𝔪_{V₁}`), hence of
  `V₂`, and `x = (s x) / s ∈ V₂`.
-/

open Polynomial

noncomputable section

namespace CurvesJacobian.Cusp

section Valuation

variable {K : Type*} [Field K]

/-- `v_A(a) < 1` iff `a ∈ A` and `a` is `0` or `a⁻¹ ∉ A`. -/
lemma valuation_lt_one_iff_mem (A : ValuationSubring K) (a : K) :
    A.valuation a < 1 ↔ a ∈ A ∧ (a = 0 ∨ a⁻¹ ∉ A) := by
  rw [← ValuationSubring.mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or]
  constructor
  · rintro (rfl | h)
    · exact ⟨A.zero_mem, Or.inl rfl⟩
    · exact ⟨(A.mem_or_inv_mem a).resolve_right h, Or.inr h⟩
  · rintro ⟨-, h⟩
    exact h

variable {K' : Type*} [Field K']

/-- Valuations along `comap`. -/
lemma valuation_comap_lt_one_iff (A : ValuationSubring K') (f : K →+* K') (a : K) :
    (A.comap f).valuation a < 1 ↔ A.valuation (f a) < 1 := by
  rw [valuation_lt_one_iff_mem, valuation_lt_one_iff_mem, ValuationSubring.mem_comap,
    ValuationSubring.mem_comap, map_inv₀, map_eq_zero]

end Valuation

variable {L Ω : Type*} [Field L] [Field Ω] [Algebra L Ω]

/-- The elements of `Ω` lying in every valuation subring of `Ω` over `O` (the integral closure of
`O` in `Ω`). -/
def holo (Ω : Type*) [Field Ω] [Algebra L Ω] (O : ValuationSubring L) : Subring Ω :=
  ⨅ V : {V : ValuationSubring Ω // ∀ a ∈ O, algebraMap L Ω a ∈ V}, V.1.toSubring

lemma mem_holo {O : ValuationSubring L} {b : Ω} :
    b ∈ holo Ω O ↔ ∀ V : ValuationSubring Ω, (∀ a ∈ O, algebraMap L Ω a ∈ V) → b ∈ V := by
  simp only [holo, Subring.mem_iInf, Subtype.forall]
  rfl

lemma comap_le_iff {O : ValuationSubring L} {V : ValuationSubring Ω} :
    O ≤ V.comap (algebraMap L Ω) ↔ ∀ a ∈ O, algebraMap L Ω a ∈ V :=
  Iff.rfl

/-- The key polynomial identity: if `∑_{i ≤ n} Bᵢ xⁱ = 0` and `j ≤ n`, then with
`s = ∑_{j ≤ i ≤ n} Bᵢ x^{i-j}` we have `s xʲ = -∑_{i < j} Bᵢ xⁱ`. -/
lemma sum_Ico_mul_pow {x : Ω} {B : ℕ → Ω} {n j : ℕ} (hj : j ≤ n)
    (h : ∑ i ∈ Finset.range (n + 1), B i * x ^ i = 0) :
    (∑ i ∈ Finset.Ico j (n + 1), B i * x ^ (i - j)) * x ^ j =
      -∑ i ∈ Finset.range j, B i * x ^ i := by
  rw [← Finset.sum_range_add_sum_Ico _ (by omega : j ≤ n + 1)] at h
  rw [Finset.sum_mul, eq_neg_iff_add_eq_zero, add_comm, ← h]
  congr 1
  refine Finset.sum_congr rfl fun i hi ↦ ?_
  rw [mul_assoc, ← pow_add, Nat.sub_add_cancel (Finset.mem_Ico.1 hi).1]

/-- **A place is determined by its restriction and its centre on the integral closure.** Let
`Ω/L` be algebraic, `V₁, V₂` valuation subrings of `Ω` with the same restriction `O` to `L`,
such that every element of `holo Ω O` which is a nonunit of `V₂` is a nonunit of `V₁`. Then
`V₁ ≤ V₂`. -/
theorem le_of_comap_eq_of_nonunits [Algebra.IsAlgebraic L Ω] {V₁ V₂ : ValuationSubring Ω}
    (h : V₁.comap (algebraMap L Ω) = V₂.comap (algebraMap L Ω))
    (hc : ∀ b ∈ holo Ω (V₁.comap (algebraMap L Ω)), V₂.valuation b < 1 → V₁.valuation b < 1) :
    V₁ ≤ V₂ := by
  classical
  intro x hx
  set O := V₁.comap (algebraMap L Ω) with hO
  set p := minpoly L x
  have hp0 : p ≠ 0 := minpoly.ne_zero (Algebra.IsIntegral.isIntegral x)
  set n := p.natDegree
  -- the coefficient of largest `O`-valuation
  obtain ⟨m, hm, hmax⟩ := Finset.exists_max_image (Finset.range (n + 1))
    (fun i ↦ O.valuation (p.coeff i)) ⟨n, Finset.self_mem_range_succ n⟩
  have hn1 : p.coeff n = 1 := (minpoly.monic (Algebra.IsIntegral.isIntegral x)).leadingCoeff
  have hc0 : p.coeff m ≠ 0 := by
    intro h0
    have := hmax n (Finset.self_mem_range_succ n)
    rw [h0, hn1, map_zero, map_one] at this
    exact one_ne_zero (le_antisymm this zero_le)
  set c := p.coeff m
  set b : ℕ → L := fun i ↦ p.coeff i / c
  have hbO : ∀ i ∈ Finset.range (n + 1), b i ∈ O := fun i hi ↦ by
    rw [← ValuationSubring.valuation_le_one_iff, map_div₀, div_le_one₀]
    · exact hmax i hi
    · exact zero_lt_iff.2 ((Valuation.ne_zero_iff _).2 hc0)
  have hbm : O.valuation (b m) = 1 := by
    simp only [b]
    rw [map_div₀]
    exact div_self ((Valuation.ne_zero_iff _).2 hc0)
  -- `j`: the last index with `v(b j) = 1`
  set j := Nat.findGreatest (fun i ↦ O.valuation (b i) = 1) n
  have hmn : m ≤ n := Nat.lt_succ_iff.1 (Finset.mem_range.1 hm)
  have hj : O.valuation (b j) = 1 :=
    Nat.findGreatest_spec (P := fun i ↦ O.valuation (b i) = 1) hmn hbm
  have hjn : j ≤ n := Nat.findGreatest_le n
  have hgt : ∀ i, j < i → i ≤ n → O.valuation (b i) < 1 := fun i hji hin ↦
    lt_of_le_of_ne ((ValuationSubring.valuation_le_one_iff _ _).2
      (hbO i (Finset.mem_range.2 (Nat.lt_succ_of_le hin))))
      (Nat.findGreatest_is_greatest hji hin)
  -- the relation `∑ Bᵢ xⁱ = 0`
  set B : ℕ → Ω := fun i ↦ algebraMap L Ω (b i)
  have hrel : ∑ i ∈ Finset.range (n + 1), B i * x ^ i = 0 := by
    have h0 : aeval x p = 0 := minpoly.aeval L x
    rw [aeval_eq_sum_range] at h0
    have : ∑ i ∈ Finset.range (n + 1), B i * x ^ i =
        algebraMap L Ω c⁻¹ * ∑ i ∈ Finset.range (n + 1), p.coeff i • x ^ i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      simp only [B, b, Algebra.smul_def, div_eq_mul_inv, map_mul]
      ring
    rw [this, h0, mul_zero]
  set s := ∑ i ∈ Finset.Ico j (n + 1), B i * x ^ (i - j)
  have hs := sum_Ico_mul_pow hjn hrel
  have hBV : ∀ V : ValuationSubring Ω, (∀ a ∈ O, algebraMap L Ω a ∈ V) →
      ∀ i ∈ Finset.range (n + 1), B i ∈ V := fun V hV i hi ↦ hV _ (hbO i hi)
  -- `s, s x ∈ holo Ω O`
  have hsV : ∀ V : ValuationSubring Ω, (∀ a ∈ O, algebraMap L Ω a ∈ V) →
      s ∈ V ∧ s * x ∈ V := by
    intro V hV
    by_cases hxV : x ∈ V
    · have : s ∈ V := V.sum_mem fun i hi ↦ V.mul_mem _ _
        (hBV V hV i (Finset.mem_range.2 (by simpa using (Finset.mem_Ico.1 hi).2)))
        (V.pow_mem hxV _)
      exact ⟨this, V.mul_mem _ _ this hxV⟩
    · have hx0 : x ≠ 0 := fun h0 ↦ hxV (h0 ▸ V.zero_mem)
      have hxi : x⁻¹ ∈ V := (V.mem_or_inv_mem x).resolve_left hxV
      have hpow : ∀ i < j, x ^ i * x⁻¹ ^ j = x⁻¹ ^ (j - i) := fun i hi ↦ by
        rw [inv_pow, inv_pow, pow_sub₀ _ hx0 hi.le, mul_inv, inv_inv, mul_comm]
      have hs' : s = -∑ i ∈ Finset.range j, B i * x⁻¹ ^ (j - i) := by
        have : s = (s * x ^ j) * x⁻¹ ^ j := by
          rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hx0, one_pow, mul_one]
        rw [this, hs, neg_mul, Finset.sum_mul]
        congr 1
        refine Finset.sum_congr rfl fun i hi ↦ ?_
        rw [mul_assoc, hpow i (Finset.mem_range.1 hi)]
      have hsx : s * x = -∑ i ∈ Finset.range j, B i * x⁻¹ ^ (j - i - 1) := by
        rw [hs', neg_mul, Finset.sum_mul]
        congr 1
        refine Finset.sum_congr rfl fun i hi ↦ ?_
        have hij : 1 ≤ j - i := by have := Finset.mem_range.1 hi; omega
        rw [mul_assoc, ← pow_sub_one_mul (by omega : j - i ≠ 0), mul_assoc, inv_mul_cancel₀ hx0,
          mul_one]
      have hmem : ∀ e : ℕ → ℕ, (∑ i ∈ Finset.range j, B i * x⁻¹ ^ e i) ∈ V := fun e ↦
        V.sum_mem fun i hi ↦ V.mul_mem _ _
          (hBV V hV i (Finset.mem_range.2 (by have := Finset.mem_range.1 hi; omega)))
          (V.pow_mem hxi _)
      exact ⟨hs' ▸ V.neg_mem _ (hmem _), hsx ▸ V.neg_mem _ (hmem _)⟩
  have hsholo : s ∈ holo Ω O := mem_holo.2 fun V hV ↦ (hsV V hV).1
  -- `s` is a unit of `V₁`
  have hOV : ∀ a ∈ O, algebraMap L Ω a ∈ V₁ := fun a ha ↦ ha
  have hv1 : V₁.valuation s = 1 := by
    have hsplit : s = B j + ∑ i ∈ Finset.Ico (j + 1) (n + 1), B i * x ^ (i - j) := by
      change ∑ i ∈ Finset.Ico j (n + 1), B i * x ^ (i - j) = _
      rw [Finset.sum_eq_sum_Ico_succ_bot (by omega : j < n + 1), Nat.sub_self, pow_zero, mul_one]
    have hBj : V₁.valuation (B j) = 1 := by
      have h1 : B j ∈ V₁ := hOV _ (hbO j (Finset.mem_range.2 (Nat.lt_succ_of_le hjn)))
      have h2 : ¬ V₁.valuation (B j) < 1 := by
        rw [← valuation_comap_lt_one_iff, ← hO, hj]
        exact lt_irrefl 1
      exact le_antisymm ((ValuationSubring.valuation_le_one_iff _ _).2 h1) (not_lt.1 h2)
    rw [hsplit, Valuation.map_add_eq_of_lt_left]
    · exact hBj
    · rw [hBj]
      refine Valuation.map_sum_lt _ one_ne_zero fun i hi ↦ ?_
      have hi' := Finset.mem_Ico.1 hi
      rw [Valuation.map_mul]
      have hBi : V₁.valuation (B i) < 1 := by
        rw [← valuation_comap_lt_one_iff, ← hO]
        exact hgt i (by omega) (by omega)
      calc V₁.valuation (B i) * V₁.valuation (x ^ (i - j))
          ≤ V₁.valuation (B i) * 1 := by
            gcongr
            exact (ValuationSubring.valuation_le_one_iff _ _).2 (V₁.pow_mem hx _)
        _ < 1 := by rwa [mul_one]
  -- hence a unit of `V₂`
  have hO2 : ∀ a ∈ O, algebraMap L Ω a ∈ V₂ := fun a ha ↦
    (show a ∈ V₂.comap (algebraMap L Ω) from h ▸ ha)
  obtain ⟨hs2, hsx2⟩ := hsV V₂ hO2
  have hv2 : ¬ V₂.valuation s < 1 := fun hlt ↦ by
    have := hc s hsholo hlt
    rw [hv1] at this
    exact lt_irrefl 1 this
  have hs0 : s ≠ 0 := fun h0 ↦ by rw [h0, map_zero] at hv1; exact zero_ne_one hv1
  have hsinv : s⁻¹ ∈ V₂ := by
    rw [← ValuationSubring.valuation_le_one_iff, map_inv₀]
    have : V₂.valuation s = 1 :=
      le_antisymm ((ValuationSubring.valuation_le_one_iff _ _).2 hs2) (not_lt.1 hv2)
    rw [this, inv_one]
  have : x = s * x * s⁻¹ := by field_simp
  rw [this]
  exact V₂.mul_mem _ _ hsx2 hsinv

section Galois

open scoped Pointwise

/-- `holo Ω O` is stable under the `L`-automorphisms of `Ω`. -/
lemma apply_mem_holo {O : ValuationSubring L} (σ : Ω ≃ₐ[L] Ω) {b : Ω} (hb : b ∈ holo Ω O) :
    σ b ∈ holo Ω O := by
  rw [mem_holo] at hb ⊢
  intro V hV
  have := hb (V.comap (σ : Ω →+* Ω)) fun a ha ↦ by
    rw [ValuationSubring.mem_comap]
    simpa using hV a ha
  simpa using this

/-- The action of `Gal(Ω/L)` on `holo Ω O`. -/
instance (O : ValuationSubring L) : MulSemiringAction (Ω ≃ₐ[L] Ω) (holo Ω O) where
  smul σ b := ⟨σ (b : Ω), apply_mem_holo σ b.2⟩
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero σ := Subtype.ext (map_zero σ)
  smul_add σ _ _ := Subtype.ext (map_add σ _ _)
  smul_one σ := Subtype.ext (map_one σ)
  smul_mul σ _ _ := Subtype.ext (map_mul σ _ _)

@[simp]
lemma coe_smul_holo {O : ValuationSubring L} (σ : Ω ≃ₐ[L] Ω) (b : holo Ω O) :
    ((σ • b : holo Ω O) : Ω) = σ (b : Ω) := rfl

lemma algebraMap_mem_holo {O : ValuationSubring L} {a : L} (ha : a ∈ O) :
    algebraMap L Ω a ∈ holo Ω O :=
  mem_holo.2 fun _ hV ↦ hV a ha

/-- `O → holo Ω O`. -/
instance (O : ValuationSubring L) : Algebra O (holo Ω O) :=
  RingHom.toAlgebra
    { toFun := fun a ↦ ⟨algebraMap L Ω a, algebraMap_mem_holo a.2⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' _ _ := Subtype.ext (map_mul _ _ _)
      map_zero' := Subtype.ext (map_zero _)
      map_add' _ _ := Subtype.ext (map_add _ _ _) }

@[simp]
lemma coe_algebraMap_holo {O : ValuationSubring L} (a : O) :
    ((algebraMap O (holo Ω O) a : holo Ω O) : Ω) = algebraMap L Ω a := rfl

instance (O : ValuationSubring L) : SMulCommClass (Ω ≃ₐ[L] Ω) O (holo Ω O) where
  smul_comm σ a b := Subtype.ext (by
    simp only [Algebra.smul_def, coe_smul_holo, Subring.coe_mul, coe_algebraMap_holo, map_mul,
      AlgEquiv.commutes])

/-- The centre `𝔪_W ∩ holo Ω O` of a valuation subring `W` over `O`. -/
def centre (O : ValuationSubring L) (W : ValuationSubring Ω)
    (hW : ∀ a ∈ O, algebraMap L Ω a ∈ W) : Ideal (holo Ω O) where
  carrier := {b | W.valuation (b : Ω) < 1}
  add_mem' {a b} ha hb := lt_of_le_of_lt (W.valuation.map_add _ _) (max_lt ha hb)
  zero_mem' := by simp
  smul_mem' c b hb := by
    change W.valuation ((c : Ω) * b) < 1
    rw [map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_left' ((W.valuation_le_one_iff _).2
      (mem_holo.1 c.2 W hW))) hb

lemma mem_centre {O : ValuationSubring L} {W : ValuationSubring Ω}
    {hW : ∀ a ∈ O, algebraMap L Ω a ∈ W} {b : holo Ω O} :
    b ∈ centre O W hW ↔ W.valuation (b : Ω) < 1 := Iff.rfl

instance (O : ValuationSubring L) (W : ValuationSubring Ω)
    (hW : ∀ a ∈ O, algebraMap L Ω a ∈ W) : (centre O W hW).IsPrime := by
  have hle : ∀ b : holo Ω O, W.valuation (b : Ω) ≤ 1 := fun b ↦
    (W.valuation_le_one_iff _).2 (mem_holo.1 b.2 W hW)
  refine (Ideal.isPrime_iff).2 ⟨fun h ↦ ?_, fun {a b} hab ↦ ?_⟩
  · have : (1 : holo Ω O) ∈ centre O W hW := h ▸ Submodule.mem_top
    rw [mem_centre] at this
    simp at this
  · rw [mem_centre, mem_centre]
    by_contra hne
    push Not at hne
    have ha : W.valuation (a : Ω) = 1 := le_antisymm (hle a) hne.1
    have hb : W.valuation (b : Ω) = 1 := le_antisymm (hle b) hne.2
    rw [mem_centre, Subring.coe_mul, map_mul, ha, hb, one_mul] at hab
    exact lt_irrefl 1 hab

variable [IsGalois L Ω]

/-- **Galois acts transitively on the places of `Ω` over a place of `L`.** If `W, W'` are
valuation subrings of a Galois extension `Ω/L` with the same restriction to `L`, then
`W' = σ(W)` for some `σ ∈ Gal(Ω/L)`. -/
theorem exists_algEquiv_comap_eq (W W' : ValuationSubring Ω)
    (h : W.comap (algebraMap L Ω) = W'.comap (algebraMap L Ω)) :
    ∃ σ : Ω ≃ₐ[L] Ω, W' = W.comap (σ.symm : Ω →+* Ω) := by
  classical
  set O := W.comap (algebraMap L Ω) with hO
  have hW : ∀ a ∈ O, algebraMap L Ω a ∈ W := fun a ha ↦ ha
  have hW' : ∀ a ∈ O, algebraMap L Ω a ∈ W' := fun a ha ↦
    (show a ∈ W'.comap (algebraMap L Ω) from h ▸ ha)
  -- the profinite setting
  letI : TopologicalSpace (holo Ω O) := ⊥
  haveI : DiscreteTopology (holo Ω O) := ⟨rfl⟩
  haveI : ContinuousSMul (Ω ≃ₐ[L] Ω) (holo Ω O) := by
    rw [continuousSMul_iff_stabilizer_isOpen]
    intro b
    convert stabilizer_isOpen_of_isIntegral (K := L) (b : Ω) using 1
    ext σ
    simp only [SetLike.mem_coe, MulAction.mem_stabilizer_iff, Subtype.ext_iff, coe_smul_holo,
      AlgEquiv.smul_def]
  haveI : Algebra.IsInvariant O (holo Ω O) (Ω ≃ₐ[L] Ω) := by
    refine ⟨fun b hb ↦ ?_⟩
    obtain ⟨a, ha⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed (k := L) (b : Ω)).2
      fun σ ↦ congrArg Subtype.val (hb σ)
    have haO : a ∈ O := by
      rw [hO, ValuationSubring.mem_comap, ha]
      exact mem_holo.1 b.2 W hW
    exact ⟨⟨a, haO⟩, Subtype.ext ha⟩
  have hunder : (centre O W hW).under O = (centre O W' hW').under O := by
    ext a
    simp only [Ideal.under, Ideal.mem_comap, mem_centre, coe_algebraMap_holo]
    rw [← valuation_comap_lt_one_iff, ← valuation_comap_lt_one_iff, ← hO, ← h]
  obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq_of_profinite
    (G := Ω ≃ₐ[L] Ω) (centre O W hW) (centre O W' hW') hunder
  refine ⟨g, ?_⟩
  set V₁ := W.comap (g.symm : Ω →+* Ω)
  have hV₁ : V₁.comap (algebraMap L Ω) = W'.comap (algebraMap L Ω) := by
    rw [← h]
    ext a
    simp only [V₁, ValuationSubring.mem_comap, RingHom.coe_coe, AlgEquiv.commutes]
    exact Iff.rfl
  have hholo : holo Ω (V₁.comap (algebraMap L Ω)) = holo Ω O := by rw [hV₁, ← h]
  -- the centres of `V₁ = g(W)` and `W'` agree
  have hcen : ∀ b ∈ holo Ω O, V₁.valuation b < 1 ↔ W'.valuation b < 1 := by
    intro b hb
    have h1 : V₁.valuation b < 1 ↔ (⟨b, hb⟩ : holo Ω O) ∈ g • centre O W hW := by
      rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, mem_centre, valuation_comap_lt_one_iff]
      rfl
    rw [h1, ← hg, mem_centre]
  apply le_antisymm
  · refine le_of_comap_eq_of_nonunits hV₁.symm fun b hb hlt ↦ ?_
    rw [← hV₁, hholo] at hb
    exact (hcen b hb).1 hlt
  · refine le_of_comap_eq_of_nonunits hV₁ fun b hb hlt ↦ ?_
    rw [hholo] at hb
    exact (hcen b hb).2 hlt

end Galois

end CurvesJacobian.Cusp
