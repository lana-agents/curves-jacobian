import CurvesJacobian.Cusp.CompletionSubgroup
import Pi1.Surface.Profinite
import Pi1.Surface.SchreierSurface

/-!
# Filling in cusps of an open subgroup of `F̂_{n+1}`, with the cusps at infinity

Let `F = F(x₀, …, xₙ)`, `F̂` its profinite completion, acting continuously on a finite set `Ω`
(compatibly with an action of `F` through `η : F → F̂`, transitive from `ω₀`), and let
`O = Stab(ω₀) ⊆ F̂`, an open subgroup. Let `Pi'` be a compact group with `Φ : Pi' ≃ₜ* O`, and `𝒞`
a set of subgroups of `Pi'` whose images are exactly the subgroups `τ Iₐ τ⁻¹ ∩ O`
(`τ ∈ F̂`, `Iₐ = ⟨xₐ⟩‾`, `a ≤ n`); geometrically: `Pi' = π₁ᵉᵗ(U')` for a finite étale cover
`U' → ℙ¹ ∖ {s₀, …, sₙ, ∞}` and `𝒞` the inertia groups of the points of `U ⊇ U'` over the `sₐ`.

**Main result** (`CurvesJacobian.Cusp.exists_surfaceGroup_quotient`): there are `g, r` and a
continuous surjection `q : Pi' ↠ Π̂_{g,r}` with kernel the closed normal subgroup generated by `𝒞`,
mapping every subgroup `C` with image `τ I_∞ τ⁻¹ ∩ O` (`I_∞ = ⟨x_∞⟩‾`, `x_∞ = (x₀ ⋯ xₙ)⁻¹`) onto
a conjugate of a cuspidal inertia group `Iⱼ = ⟨cⱼ⟩‾` of `Π̂_{g,r}`, and with
`2g + r + ∑ₐ #(⟨xₐ⟩-orbits) + |Ω| = |Ω| (n + 1) + 2`.

Proof: `O ≅ Ĥ` for `H = Stab_F(ω₀)` (`CurvesJacobian.Cusp.completionComapEquiv`); every
`τ Iₐ τ⁻¹ ∩ O` is an `O`-conjugate of `⟨η(γ⁻¹ xₐᵐ γ)⟩‾` with `m` the length of the `⟨xₐ⟩`-orbit
of `γ ω₀` (`CurvesJacobian.Cusp.exists_inertia_inf_stabilizer_eq`), so the closed normal subgroup
generated by `𝒞` is the closure of the image of the cusp subgroup `N ⊴ H` of pi1's Schreier
normal form; `Ĥ ⧸ N̂ ≅ (H ⧸ N)^` (`CurvesJacobian.Cusp.ker_completionMap`) and
`H ⧸ N ≅ Π_{g,r}` with the loops around `∞` going to conjugates of the cusps (pi1's
`Pi1.ReidemeisterSchreier.exists_quotient_cuspSubgroup_mulEquiv_surfaceGroup`).
-/

open CategoryTheory ProfiniteGrp ProfiniteGrp.ProfiniteCompletion Topology Pi1.Profinite

noncomputable section

namespace CurvesJacobian.Cusp

section Lemmas

variable {A B : Type*} [Group A] [TopologicalSpace A] [IsTopologicalGroup A] [CompactSpace A]
  [Group B] [TopologicalSpace B] [IsTopologicalGroup B] [T2Space B]

/-- The image of a closed subgroup under a continuous homomorphism from a compact group. -/
lemma map_topologicalClosure_of_compact (f : A →* B) (hf : Continuous f) (S : Subgroup A) :
    S.topologicalClosure.map f = (S.map f).topologicalClosure := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    have hmaps : Set.MapsTo f (S : Set A) ((S.map f : Subgroup B) : Set B) :=
      fun y hy ↦ ⟨y, hy, rfl⟩
    have := map_mem_closure hf hx hmaps
    exact this
  · refine Subgroup.topologicalClosure_minimal _
      (Subgroup.map_mono (Subgroup.le_topologicalClosure _)) ?_
    rw [Subgroup.coe_map]
    exact ((Subgroup.isClosed_topologicalClosure S).isCompact.image hf).isClosed

lemma map_topologicalClosure_zpowers_of_compact (f : A →* B) (hf : Continuous f) (b : A) :
    (Subgroup.zpowers b).topologicalClosure.map f =
      (Subgroup.zpowers (f b)).topologicalClosure := by
  rw [map_topologicalClosure_of_compact f hf, MonoidHom.map_zpowers]

end Lemmas

/-- The profinite free group `F̂(x₀, …, xₙ)`. -/
abbrev FHat (n : ℕ) : ProfiniteGrp.{0} := completion (GrpCat.of (FreeGroup (Fin (n + 1))))

/-- `⟨η(w)⟩‾ ⊆ F̂`. -/
abbrev basicInertia {n : ℕ} (w : FreeGroup (Fin (n + 1))) : Subgroup (FHat n) :=
  (Subgroup.zpowers (etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) w)).topologicalClosure

section Main

open Pi1.ReidemeisterSchreier Pi1.ReidemeisterSchreier.SchreierRibbon

variable {n : ℕ} {Fb : Type} [Finite Fb] [MulAction (FHat n) Fb]
  [MulAction (FreeGroup (Fin (n + 1))) Fb]
  (hcompat : ∀ (g : FreeGroup (Fin (n + 1))) (y : Fb),
    g • y = etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) g • y)
  (hopen : ∀ y : Fb, IsOpen (MulAction.stabilizer (FHat n) y : Set (FHat n)))
  {ω₀ : Fb}

omit [Finite Fb] in
include hcompat hopen in
/-- **Decomposition of `τ I τ⁻¹ ∩ O`**: for `x ∈ F` and `τ ∈ F̂` there are `o ∈ O = Stab(ω₀)` and
`γ ∈ F` with `τ ⟨η x⟩‾ τ⁻¹ ∩ O = o ⟨η(γ⁻¹ xᵐ γ)⟩‾ o⁻¹`, `m` the period of `x` at `γ ω₀`. -/
theorem exists_inertia_inf_stabilizer_eq (x : FreeGroup (Fin (n + 1))) (τ : FHat n) :
    ∃ o ∈ MulAction.stabilizer (FHat n) ω₀, ∃ γ : FreeGroup (Fin (n + 1)), τ⁻¹ • ω₀ = γ • ω₀ ∧
      (basicInertia x).map (MulAut.conj τ).toMonoidHom ⊓ MulAction.stabilizer (FHat n) ω₀ =
        (basicInertia (γ⁻¹ * x ^ Function.minimalPeriod (x • ·) (γ • ω₀) * γ)).map
          (MulAut.conj o).toMonoidHom := by
  have hO := hopen ω₀
  -- choose `γ` with `o = τ η(γ) ∈ O`
  have hV : IsOpen {y : FHat n | τ * y ∈ MulAction.stabilizer (FHat n) ω₀} :=
    hO.preimage (continuous_const.mul continuous_id)
  obtain ⟨γ, hγ⟩ := (denseRange (GrpCat.of (FreeGroup (Fin (n + 1))))).exists_mem_open hV
    ⟨τ⁻¹, by simp⟩
  obtain ⟨o, ho, rfl⟩ : ∃ o ∈ MulAction.stabilizer (FHat n) ω₀,
      τ = o * (etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) γ)⁻¹ :=
    ⟨_, hγ, by rw [mul_inv_cancel_right]⟩
  refine ⟨o, ho, γ, ?_, ?_⟩
  · rw [mul_inv_rev, inv_inv, mul_smul, hcompat,
      inv_smul_eq_iff.2 (MulAction.mem_stabilizer_iff.1 ho).symm]
  have hc : (MulAut.conj (o * (etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) γ)⁻¹)).toMonoidHom =
      (MulAut.conj o).toMonoidHom.comp
        (MulAut.conj (etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) γ)⁻¹).toMonoidHom := by
    ext y
    simp [MulAut.conj_apply, mul_assoc]
  have hOo : (MulAction.stabilizer (FHat n) ω₀).map (MulAut.conj o).toMonoidHom =
      MulAction.stabilizer (FHat n) ω₀ := by
    apply le_antisymm
    · rintro _ ⟨y, hy, rfl⟩
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ ho hy) (Subgroup.inv_mem _ ho)
    · intro y hy
      refine ⟨o⁻¹ * y * o, Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ ho) hy) ho,
        ?_⟩
      simp [MulAut.conj_apply, mul_assoc]
  rw [hc, ← Subgroup.map_map]
  conv_lhs => rw [← hOo]
  rw [← Subgroup.map_inf_eq _ _ _ (MulAut.conj o).injective]
  congr 1
  have hper : Function.minimalPeriod (x • ·) (γ • ω₀) =
      Function.minimalPeriod (etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) x • ·)
        (etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) γ • ω₀) := by
    have h1 : (x • · : Fb → Fb) = (etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) x • ·) :=
      funext fun y ↦ hcompat x y
    rw [h1, hcompat γ ω₀]
  simp only [basicInertia]
  rw [map_conj_topologicalClosure_zpowers, inv_inv,
    topologicalClosure_zpowers_conj_inf_stabilizer hO,
    ← hper]
  congr 2


variable (htrans : ∀ ω, ∃ g : FreeGroup (Fin (n + 1)), g • ω₀ = ω)
  {Pi' : Type*} [Group Pi'] [TopologicalSpace Pi'] [IsTopologicalGroup Pi'] [CompactSpace Pi']
  (Φ : Pi' ≃ₜ* MulAction.stabilizer (FHat n) ω₀)

/-- The image of a subgroup `C ⊆ Pi'` in `F̂`. -/
def cuspImage (C : Subgroup Pi') : Subgroup (FHat n) :=
  (C.map (Φ : Pi' →* MulAction.stabilizer (FHat n) ω₀)).map
    (MulAction.stabilizer (FHat n) ω₀).subtype

include hcompat hopen htrans in
/-- **Filling in the cusps over `s₀, …, sₙ`.** See the module docstring. -/
theorem exists_surfaceGroup_quotient (𝒞 : Set (Subgroup Pi'))
    (h𝒞 : ∀ C ∈ 𝒞, ∃ (a : Fin (n + 1)) (τ : FHat n),
      cuspImage Φ C = (basicInertia (FreeGroup.of a)).map (MulAut.conj τ).toMonoidHom ⊓
        MulAction.stabilizer (FHat n) ω₀)
    (h𝒞' : ∀ (a : Fin (n + 1)) (τ : FHat n), ∃ C ∈ 𝒞,
      cuspImage Φ C = (basicInertia (FreeGroup.of a)).map (MulAut.conj τ).toMonoidHom ⊓
        MulAction.stabilizer (FHat n) ω₀) :
    ∃ (g r : ℕ) (q : Pi' →* Pi1.ProfiniteSurfaceGroup g r), Continuous q ∧
      Function.Surjective q ∧
      q.ker = (Subgroup.normalClosure (⋃ C ∈ 𝒞, (C : Set Pi'))).topologicalClosure ∧
      (∃ μ' : MulAction.orbitRel.Quotient (Subgroup.zpowers (xInf n)) Fb ≃ Fin r,
        ∀ (C : Subgroup Pi') (τ : FHat n), cuspImage Φ C =
          (basicInertia (xInf n)).map (MulAut.conj τ).toMonoidHom ⊓
            MulAction.stabilizer (FHat n) ω₀ →
        ∃ κ : Pi1.ProfiniteSurfaceGroup g r,
          C.map q = (Pi1.SurfaceGroup.inertia (μ' (Quotient.mk _ (τ⁻¹ • ω₀)))).map
            (MulAut.conj κ).toMonoidHom) ∧
      2 * g + r + ∑ a : Fin (n + 1),
          Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers (FreeGroup.of a)) Fb) +
            Nat.card Fb = Nat.card Fb * (n + 1) + 2 := by
  classical
  obtain ⟨g, r, ΘS, μ, hconj, hcount⟩ := exists_quotient_cuspSubgroup_mulEquiv_surfaceGroup htrans
  have hO := hopen ω₀
  have hOcl : IsClosed (MulAction.stabilizer (FHat n) ω₀ : Set (FHat n)) :=
    Subgroup.isClosed_of_isOpen _ hO
  have hHs : MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀ =
      (MulAction.stabilizer (FHat n) ω₀).comap (etaHom _) := by
    ext γ
    simp [MulAction.mem_stabilizer_iff, hcompat]
  let E1 : completion (GrpCat.of (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀)) ≃ₜ*
      MulAction.stabilizer (FHat n) ω₀ :=
    (completionCongr (MulEquiv.subgroupCongr hHs)).trans
      (completionComapEquiv (MulAction.stabilizer (FHat n) ω₀) hO)
  -- `ι : Ĥ ↪ F̂`
  let ι : completion (GrpCat.of (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀)) →* FHat n :=
    (MulAction.stabilizer (FHat n) ω₀).subtype.comp (E1 : _ →* _)
  have hιc : Continuous ι := continuous_subtype_val.comp E1.continuous
  have hιi : Function.Injective ι := Subtype.val_injective.comp E1.injective
  have hιη : ∀ h : MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀,
      ι (etaFn _ h) =
        etaFn (GrpCat.of (FreeGroup (Fin (n + 1)))) (h : FreeGroup (Fin (n + 1))) := by
    intro h
    change ((completionComapEquiv _ hO) (completionCongr (MulEquiv.subgroupCongr hHs)
      (etaFn _ h)) : FHat n) = _
    rw [completionCongr_apply, completionMap_eta, completionComapEquiv_eta]
    rfl
  let Ψ : Pi' ≃ₜ* completion (GrpCat.of (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀)) :=
    Φ.trans E1.symm
  have hΨ : ∀ C : Subgroup Pi', (C.map (Ψ : Pi' →* _)).map ι = cuspImage Φ C := by
    intro C
    rw [cuspImage, Subgroup.map_map, Subgroup.map_map]
    congr 1
    ext x
    simp [Ψ, ι]
  set N := cuspSubgroup (Set.univ : Set (Fin (n + 1))) ω₀ with hN
  let M := (N.map (etaHom (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀))).topologicalClosure
  haveI hMn : M.Normal := normal_topologicalClosure_map_etaHom N
  have hMcl : IsClosed (M : Set (completion (GrpCat.of
      (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀)))) :=
    Subgroup.isClosed_topologicalClosure _
  -- the images of the cusp subgroups
  have hd : ∀ (x γ : FreeGroup (Fin (n + 1))),
      γ⁻¹ * x ^ Function.minimalPeriod (x • ·) (γ • ω₀) * γ ∈
      MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀ := by
    intro x γ
    rw [MulAction.mem_stabilizer_iff, mul_smul, mul_smul,
      (MulAction.pow_smul_eq_iff_minimalPeriod_dvd).2 dvd_rfl, inv_smul_smul]
  have hcusp : ∀ (C : Subgroup Pi') (x : FreeGroup (Fin (n + 1))) (τ : FHat n),
      cuspImage Φ C = (basicInertia x).map (MulAut.conj τ).toMonoidHom ⊓
        MulAction.stabilizer (FHat n) ω₀ →
      ∃ (γ : FreeGroup (Fin (n + 1))) (κ : completion (GrpCat.of
          (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀))), τ⁻¹ • ω₀ = γ • ω₀ ∧
        C.map (Ψ : Pi' →* _) = (Subgroup.zpowers (etaFn _
          (⟨_, hd x γ⟩ : MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀))).topologicalClosure.map
            (MulAut.conj κ).toMonoidHom := by
    intro C x τ hC
    obtain ⟨o, ho, γ, hτγ, hoγ⟩ := exists_inertia_inf_stabilizer_eq hcompat hopen (ω₀ := ω₀) x τ
    refine ⟨γ, E1.symm ⟨o, ho⟩, hτγ, ?_⟩
    apply Subgroup.map_injective hιi
    rw [hΨ, hC, hoγ, Subgroup.map_map]
    have hcomm : ι.comp (MulAut.conj (E1.symm ⟨o, ho⟩)).toMonoidHom =
        (MulAut.conj o).toMonoidHom.comp ι := by
      ext y
      simp [ι, MulAut.conj_apply]
    rw [hcomm, ← Subgroup.map_map, map_topologicalClosure_zpowers_of_compact ι hιc, hιη]
  -- the quotient map
  let q₀ := completionMap (QuotientGroup.mk' N)
  let q' : completion (GrpCat.of (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀)) →*
      Pi1.ProfiniteSurfaceGroup g r :=
    ((completionCongr ΘS : _ ≃ₜ* _) : _ →* _).comp q₀
  have hq'c : Continuous q' := (completionCongr ΘS).continuous.comp (continuous_completionMap _)
  have hq₀s : Function.Surjective q₀ := completionMap_surjective (QuotientGroup.mk'_surjective N)
  have hq'k : q'.ker = M := by
    have : q'.ker = q₀.ker := by
      ext y
      simp only [MonoidHom.mem_ker, q', MonoidHom.comp_apply]
      constructor
      · intro h
        exact (completionCongr ΘS).injective (h.trans (map_one _).symm)
      · intro h
        rw [h, map_one]
    rw [this, ker_completionMap (QuotientGroup.mk'_surjective N), QuotientGroup.ker_mk']
  have hNgen : ∀ (a : Fin (n + 1)) (γ : FreeGroup (Fin (n + 1))),
      (⟨_, hd (FreeGroup.of a) γ⟩ : MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀) ∈ N := by
    intro a γ
    refine Subgroup.subset_normalClosure ⟨a, Set.mem_univ _, γ⁻¹,
      (Function.minimalPeriod (FreeGroup.of a • ·) (γ • ω₀) : ℤ), ?_⟩
    simp [zpow_natCast]
  let q : Pi' →* Pi1.ProfiniteSurfaceGroup g r := q'.comp (Ψ : Pi' →* _)
  refine ⟨g, r, q, hq'c.comp Ψ.continuous,
    ((completionCongr ΘS).surjective.comp hq₀s).comp Ψ.surjective, ?_, ?_, hcount⟩
  · -- the kernel
    have hk1 : q.ker = M.comap (Ψ : Pi' →* _) := by
      rw [← hq'k]
      rfl
    have hkey : M = ((Subgroup.normalClosure (⋃ C ∈ 𝒞, (C : Set Pi'))).topologicalClosure).map
        (Ψ : Pi' →* _) := by
      rw [map_topologicalClosure_of_compact _ Ψ.continuous,
        Subgroup.map_normalClosure _ _ Ψ.surjective]
      apply le_antisymm
      · refine Subgroup.topologicalClosure_mono ?_
        rw [hN, cuspSubgroup]
        refine (Subgroup.map_normalClosure_le _ _).trans (Subgroup.normalClosure_mono ?_)
        rintro _ ⟨h, ⟨a, -, γ, k, hh⟩, rfl⟩
        obtain ⟨C, hC𝒞, hC⟩ := h𝒞' a (etaFn _ γ)
        have hmem : etaFn (GrpCat.of (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀)) h ∈
            C.map (Ψ : Pi' →* _) := by
          rw [← Subgroup.mem_map_iff_mem hιi, hΨ, hC, hιη, hh]
          refine ⟨⟨(etaFn _ (FreeGroup.of a)) ^ k, ?_, ?_⟩, ?_⟩
          · exact Subgroup.zpow_mem _ (Subgroup.le_topologicalClosure _
              (Subgroup.mem_zpowers _)) k
          · simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
            change etaHom _ γ * etaHom _ (FreeGroup.of a) ^ k * (etaHom _ γ)⁻¹ =
              etaHom _ (γ * FreeGroup.of a ^ k * γ⁻¹)
            rw [map_mul, map_mul, map_inv, map_zpow]
          · rw [← hh]
            exact (show (h : FreeGroup (Fin (n + 1))) ∈
              (MulAction.stabilizer (FHat n) ω₀).comap (etaHom _) from hHs ▸ h.2)
        obtain ⟨y, hy, hyh⟩ := hmem
        exact ⟨y, Set.mem_iUnion₂.2 ⟨C, hC𝒞, hy⟩, hyh⟩
      · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_) hMcl
        rintro _ ⟨y, hy, rfl⟩
        obtain ⟨C, hC𝒞, hyC⟩ := Set.mem_iUnion₂.1 hy
        obtain ⟨a, τ, hCa⟩ := h𝒞 C hC𝒞
        obtain ⟨γ, κ, -, hCm⟩ := hcusp C (FreeGroup.of a) τ hCa
        have hy' : (Ψ : Pi' →* completion (GrpCat.of
            (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀))) y ∈
            C.map (Ψ : Pi' →* completion (GrpCat.of
              (MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀))) :=
          Subgroup.mem_map_of_mem _ hyC
        rw [hCm] at hy'
        obtain ⟨z, hz, hzy⟩ := hy'
        rw [← hzy]
        have hzM : z ∈ M := by
          refine Subgroup.topologicalClosure_minimal _ ?_ hMcl hz
          rw [Subgroup.zpowers_le]
          exact Subgroup.le_topologicalClosure _ ⟨_, hNgen a γ, rfl⟩
        exact hMn.conj_mem z hzM κ
    rw [hk1, hkey, Subgroup.comap_map_eq_self_of_injective Ψ.injective]
  · -- the cusps at infinity
    refine ⟨μ, fun C τ hC ↦ ?_⟩
    obtain ⟨γ, κ, hτγ, hCm⟩ := hcusp C (xInf n) τ hC
    obtain ⟨c, hc⟩ := isConj_iff.1 (hconj ⟨_, hd (xInf n) γ⟩ γ rfl)
    rw [hτγ]
    refine ⟨q' κ * etaFn _ c⁻¹, ?_⟩
    have hq'η : q' (etaFn _
        (⟨_, hd (xInf n) γ⟩ : MulAction.stabilizer (FreeGroup (Fin (n + 1))) ω₀)) =
        etaFn _ (c⁻¹ * Pi1.SurfaceGroup.cusp (μ (Quotient.mk _ (γ • ω₀))) * c) := by
      change completionCongr ΘS (completionMap (QuotientGroup.mk' N) (etaFn _ _)) = _
      rw [completionMap_eta, completionCongr_apply, completionMap_eta]
      congr 1
      rw [← hc]
      simp only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one]
      rfl
    have hcomm : q'.comp (MulAut.conj κ).toMonoidHom =
        (MulAut.conj (q' κ)).toMonoidHom.comp q' := by
      ext y
      simp [MulAut.conj_apply]
    change C.map (q'.comp (Ψ : Pi' →* _)) = _
    rw [← Subgroup.map_map, hCm, Subgroup.map_map, hcomm, ← Subgroup.map_map,
      map_topologicalClosure_zpowers_of_compact q' hq'c, hq'η, Pi1.SurfaceGroup.inertia]
    have h2 : etaFn (GrpCat.of (Pi1.SurfaceGroup g r))
        (c⁻¹ * Pi1.SurfaceGroup.cusp (μ (Quotient.mk _ (γ • ω₀))) * c) =
        etaFn _ c⁻¹ * etaFn _ (Pi1.SurfaceGroup.cusp (μ (Quotient.mk _ (γ • ω₀)))) *
          (etaFn _ c⁻¹)⁻¹ := by
      change etaHom _ (c⁻¹ * _ * c) = etaHom _ c⁻¹ * etaHom _ _ * (etaHom _ c⁻¹)⁻¹
      simp only [map_mul, map_inv, inv_inv]
    rw [h2, ← map_conj_topologicalClosure_zpowers, Subgroup.map_map]
    congr 1
    ext y
    simp [MulAut.conj_apply, mul_assoc]

end Main

end CurvesJacobian.Cusp
