import CurvesJacobian.Cusp.BelyiChainHV
import CurvesJacobian.Cusp.CoverRangeOpen

/-!
# Pulling a filling back along a finite étale cover (MR8, round 29)

The geometric step of the soundness of elliptic cuspidalisation ([AbsTopII] Cor 3.3 (iii)(a),
`Topics in Absolute Anabelian Geometry II.txt` l.4481–4491): the fibre product of a filling
`Π_Y ↠ Π_{Y'}` with an open subgroup `O ⊆ Π_{Y'}` is again a filling `Π_Z ↠ Π_{Z'}`, where
`Z` is the finite étale cover of `Y` attached to `O`.

* **`CurvesJacobian.Cusp.exists_fill_cover`**: for a hyperbolic curve `Y` over a number field `M`
  (with a cusp), a filling `Y.U ⊆ U'` (hyperbolic, with a cusp) and an open subgroup
  `O ⊆ Π_{Y'}`, there are a number field `M₁ ⊇ M`, a hyperbolic curve `Z` over `M₁` with a filling
  `Z.U ⊆ UZ`, a continuous injection `κ : Π_Z ↪ Π_Y` with image `fillPiHom⁻¹(O)` and a continuous
  injection `ε : Π_{Z'} ↪ Π_{Y'}` with image `O`, such that `fill_Y ∘ κ = ε ∘ fill_Z` and `ε` lies
  over `res : G_{M₁} → G_M` up to conjugation.
* **`CurvesJacobian.Cusp.exists_fill_of_coverHom`**: the same, for any continuous injection
  `κ : Π_Z ↪ Π_Y` with image `fillPiHom⁻¹(O)` over `res` (up to conjugation) pulling cuspidal
  inertia groups back to cuspidal inertia groups.
* `CurvesJacobian.Cusp.ker_fillPiHom_eq_closure_fc`: `ker(Π_Y ↠ Π_{Y'})` is topologically normally
  generated by the cuspidal inertia groups it contains;
  `CurvesJacobian.Cusp.comap_eq_closure_normalClosure_fc`: this property passes to preimages along
  an injection pulling cusps back to cusps;
  `CurvesJacobian.Cusp.exists_fill_kerPi_eq_fc`: a closed normal subgroup of this kind which
  misses a cusp and has a non-commutative image of `Δ` is the kernel of a hyperbolic filling.

## Proof

`P = fillPiHom⁻¹(O)` is open, so it is the image of `π₁ᵉᵗ` of a connected finite étale cover
(`exists_isFiniteEtale_range_eq_of_open`), whose curve `Z = coverCurve` gives `κ`
(`coverCurvePiEquiv`). `N = κ⁻¹(ker fill_Y)` is topologically normally generated by the cusps of
`Π_Z` it contains (the cusps of `Π_Y` in `ker fill_Y` lie in `P`, their preimages are cusps); a
cusp of `Y'` is the image of a cusp `I` of `Y` and is infinite, so `κ⁻¹(I) ⊄ N` (`P ∩ I` has
finite index in `I`); `Δ_{Y'} ∩ O` is slim and nontrivial, hence non-commutative, and lifts to
`Δ_Z`. So `N = ker fill_Z` for a hyperbolic filling `Z ⊆ Z'` (`exists_fill_ker_eq`,
`two_lt_of_not_commute_fillMap`), and `ε` is induced by `fill_Y ∘ κ` (`liftOfKerEq`).
-/

open CategoryTheory Limits AlgebraicGeometry AlgebraicGeometry.FiniteEtale Belyi Belyi.Anabelian
  Pi1.Profinite PreGaloisCategory

universe u

noncomputable section

namespace CurvesJacobian.Cusp

/-! ### Generic group theory -/

section Generic

/-- The commutator of two elements with commuting images lies in the kernel. -/
lemma map_commutator_eq_one_fc {G H : Type*} [Group G] [Group H] (φ : G →* H) {a b : G}
    (e : φ a * φ b = φ b * φ a) : φ (a * b * (b * a)⁻¹) = 1 := by
  rw [map_mul, map_inv, map_mul, map_mul, e, mul_inv_cancel]

/-- Two elements whose commutator lies in the kernel have commuting images. -/
lemma map_mul_comm_of_commutator_fc {G H : Type*} [Group G] [Group H] (φ : G →* H) {a b : G}
    (e : φ (a * b * (b * a)⁻¹) = 1) : φ a * φ b = φ b * φ a := by
  rw [map_mul, map_inv, map_mul, map_mul, mul_inv_eq_one] at e
  exact e

/-- `y = g x g⁻¹` gives `x = g⁻¹ y g`. -/
lemma eq_conj_inv_fc {G : Type*} [Group G] {g x y : G} (e : y = g * x * g⁻¹) :
    x = g⁻¹ * y * g := by
  rw [e]
  group

/-- `g⁻¹ (c x c⁻¹) g = 1` gives `x = 1`. -/
lemma eq_one_of_conj_conj_fc {G : Type*} [Group G] {g c x : G}
    (e : g⁻¹ * (c * x * c⁻¹) * g = 1) : x = 1 := by
  have : x = (g⁻¹ * c)⁻¹ * (g⁻¹ * (c * x * c⁻¹) * g) * (g⁻¹ * c) := by group
  rw [this, e]
  group

/-- Chaining three conjugations, the middle one through a homomorphism `r`. -/
lemma conj_chain_fc {G H F : Type*} [Group G] [Group H] [FunLike F G H] [MonoidHomClass F G H]
    (r : F) {x y gY c : H} {z t gZ : G} (hx : x = gY⁻¹ * y * gY) (hy : y = c * r z * c⁻¹)
    (hz : t = gZ⁻¹ * z * gZ) :
    x = (gY⁻¹ * c * r gZ) * r t * (gY⁻¹ * c * r gZ)⁻¹ := by
  subst hx hy hz
  simp only [map_mul, map_inv]
  group

/-- **Topological normal generation by a conjugation-stable family passes to preimages** along a
continuous injection `κ : G_Z ↪ G_Y` from a compact group, if `L ⊆ range κ` and preimages of
members of the family `CY` lie in the family `CZ`. -/
theorem comap_eq_closure_normalClosure_fc {GZ GY : Type*} [Group GZ] [TopologicalSpace GZ]
    [IsTopologicalGroup GZ] [CompactSpace GZ] [Group GY] [TopologicalSpace GY]
    [IsTopologicalGroup GY] [T2Space GY] (κ : GZ →ₜ* GY) (hκ : Function.Injective κ)
    (CY : Set (Subgroup GY)) (CZ : Set (Subgroup GZ))
    (hconj : ∀ I ∈ CY, ∀ g : GY, I.map (MulAut.conj g).toMonoidHom ∈ CY)
    (hcomap : ∀ I ∈ CY, I.comap κ.toMonoidHom ∈ CZ) (L : Subgroup GY)
    (hL : L = (Subgroup.normalClosure (⋃ (I) (_ : I ∈ CY ∧ I ≤ L),
      (I : Set GY))).topologicalClosure)
    (hLκ : L ≤ κ.toMonoidHom.range) :
    L.comap κ.toMonoidHom = (Subgroup.normalClosure (⋃ (J) (_ : J ∈ CZ ∧
      J ≤ L.comap κ.toMonoidHom), (J : Set GZ))).topologicalClosure := by
  haveI hLn : L.Normal := by
    rw [hL]
    exact Subgroup.is_normal_topologicalClosure _
  have hLc : IsClosed (L : Set GY) := by
    rw [hL]
    exact Subgroup.isClosed_topologicalClosure _
  haveI : (L.comap κ.toMonoidHom).Normal := hLn.comap _
  refine le_antisymm ?_ ?_
  · have hRc : IsClosed (((Subgroup.normalClosure (⋃ (J) (_ : J ∈ CZ ∧
        J ≤ L.comap κ.toMonoidHom), (J : Set GZ))).topologicalClosure.map κ.toMonoidHom :
          Subgroup GY) : Set GY) := by
      rw [Subgroup.coe_map]
      exact ((Subgroup.isClosed_topologicalClosure _).isCompact.image κ.continuous).isClosed
    have hLR : L ≤ (Subgroup.normalClosure (⋃ (J) (_ : J ∈ CZ ∧
        J ≤ L.comap κ.toMonoidHom), (J : Set GZ))).topologicalClosure.map κ.toMonoidHom := by
      have hL' := hL.le
      refine hL'.trans (Subgroup.topologicalClosure_minimal _ ?_ hRc)
      refine (Subgroup.closure_le _).2 fun c hc ↦ ?_
      obtain ⟨s, hs, hsc⟩ := Group.mem_conjugatesOfSet_iff.1 hc
      obtain ⟨g, rfl⟩ := isConj_iff.1 hsc
      obtain ⟨I, ⟨hI, hIL⟩, hsI⟩ := Set.mem_iUnion₂.1 hs
      have hI' := hconj I hI g
      have hI'L : I.map (MulAut.conj g).toMonoidHom ≤ L := map_conj_le_of_le_normal g hIL
      have hmem : g * s * g⁻¹ ∈ I.map (MulAut.conj g).toMonoidHom := ⟨s, hsI, by simp⟩
      obtain ⟨z, hz⟩ := hLκ (hI'L hmem)
      refine ⟨z, ?_, hz⟩
      refine Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure
        (Set.mem_iUnion₂.2 ⟨_, ⟨hcomap _ hI', Subgroup.comap_mono hI'L⟩, ?_⟩))
      change κ.toMonoidHom z ∈ I.map (MulAut.conj g).toMonoidHom
      rw [hz]
      exact hmem
    intro x hx
    obtain ⟨y, hy, hyx⟩ := hLR hx
    rw [← hκ hyx]
    exact hy
  · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_)
      (hLc.preimage κ.continuous)
    intro s hs
    obtain ⟨J, ⟨-, hJ⟩, hsJ⟩ := Set.mem_iUnion₂.1 hs
    exact hJ hsJ

/-- **An infinite image survives a finite-index restriction**: if `f(I)` is infinite and
`range κ` has finite index, then `κ⁻¹(I) ⊄ κ⁻¹(ker f)`. -/
theorem not_comap_le_comap_ker_fc {GZ GY GY' : Type*} [Group GZ] [Group GY] [Group GY']
    (κ : GZ →* GY) (f : GY →* GY') [κ.range.FiniteIndex] {I : Subgroup GY}
    (hI : ¬ (I.map f).Commensurable ⊥) : ¬ I.comap κ ≤ f.ker.comap κ := by
  intro hle
  apply hI
  have h1 : I ⊓ κ.range ≤ f.ker := by
    rintro x ⟨hxI, z, rfl⟩
    exact hle hxI
  haveI := Subgroup.isFiniteRelIndex_of_finiteIndex (H := κ.range) (K := I)
  have h2 : I.Commensurable (I ⊓ κ.range) :=
    ⟨by rw [Subgroup.relIndex_eq_one.2 inf_le_left]; exact one_ne_zero,
      by rw [Subgroup.inf_relIndex_left]; exact Subgroup.relIndex_ne_zero⟩
  have h3 := Subgroup.Commensurable.map' f h2
  rw [(Subgroup.map_eq_bot_iff _).2 h1] at h3
  exact h3

/-- **A nontrivial slim subgroup meets every open subgroup non-commutatively.** -/
theorem exists_not_commute_of_isSlim_fc {G : Type*} [Group G] [TopologicalSpace G]
    {Δ H : Subgroup G} (hΔ : IsSlim Δ) (hne : Δ ≠ ⊥) (hH : IsOpen (H : Set G)) :
    ∃ x ∈ Δ, x ∈ H ∧ ∃ y ∈ Δ, y ∈ H ∧ x * y ≠ y * x := by
  have hs := IsSlim.subgroupOf hΔ hH
  have hn := IsSlim.subgroupOf_ne_bot hΔ hne hH
  haveI := (Subgroup.nontrivial_iff_ne_bot _).2 hn
  obtain ⟨z, hz⟩ := exists_ne (1 : Δ.subgroupOf H)
  have hzc : z ∉ Subgroup.center (Δ.subgroupOf H) := by
    rw [hs.center_eq_bot, Subgroup.mem_bot]
    exact hz
  rw [Subgroup.mem_center_iff] at hzc
  push Not at hzc
  obtain ⟨w, hw⟩ := hzc
  exact ⟨w.1.1, w.2, w.1.2, z.1.1, z.2, z.1.2, fun e ↦ hw (Subtype.ext (Subtype.ext e))⟩

/-- **Lifting along a continuous surjection with the same kernel** (compact source, Hausdorff
target): an injective `ε` with `ε ∘ f = Φ`. -/
theorem exists_lift_injective_fc {E Q P : Type*} [Group E] [TopologicalSpace E] [CompactSpace E]
    [Group Q] [TopologicalSpace Q] [CompactSpace Q] [T2Space Q] [Group P] [TopologicalSpace P]
    [T2Space P] (f : E →ₜ* Q) (hf : Function.Surjective f) (Φ : E →ₜ* P)
    (hker : f.toMonoidHom.ker = Φ.toMonoidHom.ker) :
    ∃ ε : Q →ₜ* P, Function.Injective ε ∧ ∀ x, ε (f x) = Φ x := by
  refine ⟨⟨liftOfKerEq f hf Φ hker, continuous_liftOfKerEq f hf Φ hker⟩, ?_,
    liftOfKerEq_apply f hf Φ hker⟩
  refine (injective_iff_map_eq_one _).2 fun q hq ↦ ?_
  obtain ⟨x, rfl⟩ := hf q
  have h1 : Φ x = 1 := (liftOfKerEq_apply f hf Φ hker x).symm.trans hq
  have hx : x ∈ f.toMonoidHom.ker := hker ▸ MonoidHom.mem_ker.2 h1
  exact hx

end Generic

/-! ### Fillings of one curve -/

section Fill

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- `ker fillPiHom = ker fillMap`. -/
lemma ker_fillPiHom_eq_fc {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω]
    [Algebra K Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
    (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
      2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U') :
    (fillPiHom Ω C hc h hc' hyp).toMonoidHom.ker = (fillMap Ω C hc h).toMonoidHom.ker := by
  ext σ
  change fillPiHom Ω C hc h hc' hyp σ = 1 ↔ fillMap Ω C hc h σ = 1
  rw [← fillTransport_fillPiHom Ω C hc h hc' hyp σ]
  exact (map_eq_one_iff _ (fillTransport Ω C hc h hc' hyp).injective).symm

/-- `fillPiHom` is surjective. -/
lemma fillPiHom_surjective_fc {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω]
    [Algebra K Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
    (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
      2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U') :
    Function.Surjective (fillPiHom Ω C hc h hc' hyp) :=
  surjective_of_conjInduced_fill Ω C hc h hc' hyp (isConjInduced_fillPiHom Ω C hc h hc' hyp)

/-- **`fillPiHom` lies over `G_K`** up to conjugation by `fillG`. -/
lemma projGk_fillPiHom_fc {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω]
    [Algebra K Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
    (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
      2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U') (σ) :
    projGk Ω (fillCurve C h hyp) hc' (fillPiHom Ω C hc h hc' hyp σ) =
      (fillG Ω C hc h hc' hyp)⁻¹ * projGk Ω C hc σ * fillG Ω C hc h hc' hyp := by
  have e1 := projGkFill_fillTransport Ω C hc h hc' hyp (fillPiHom Ω C hc h hc' hyp σ)
  have e2 : projGkFill Ω C hc h (fillTransport Ω C hc h hc' hyp (fillPiHom Ω C hc h hc' hyp σ)) =
      projGk Ω C hc σ :=
    (congrArg (projGkFill Ω C hc h) (fillTransport_fillPiHom Ω C hc h hc' hyp σ)).trans
      (projGkFill_fillMap Ω C hc h σ)
  exact eq_conj_inv_fc (e2.symm.trans e1)

/-- **The filling kernel is topologically normally generated by the cuspidal inertia groups it
contains.** -/
theorem ker_fillMap_eq_closure_fc {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω]
    [Algebra K Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
    (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty) :
    (fillMap Ω C hc h).toMonoidHom.ker = (Subgroup.normalClosure (⋃ (I)
      (_ : I ∈ arithCusps Ω C hc ∧ I ≤ (fillMap Ω C hc h).toMonoidHom.ker),
        (I : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))))).topologicalClosure :=
    by
  haveI := nonempty_fillOpen Ω C h
  haveI := fun S : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)) ↦
    Subgroup.is_normal_topologicalClosure (Subgroup.normalClosure S)
  refine le_antisymm ?_ ?_
  · refine ker_fillMap_le_of_forall Ω C hc h hc' _ (Subgroup.isClosed_topologicalClosure _)
      fun W hW y hy hyU' hyU ↦ ?_
    have hWU : ¬ IsCentredOn (geomData Ω C) (geomCurve Ω C)
        (curveEquivL Ω (transcendental_geomCoord Ω C)) (geomOpen Ω C) W := fun hc0 ↦
      hyU ((isCentredOn_baseChangeOpen_iff_mem Ω C hc C.U le_rfl hc hW hy).1 hc0)
    intro x hx
    exact Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure (Set.mem_iUnion₂.2
      ⟨_, ⟨mem_arithCusps Ω C hc hW hWU,
        map_geomCuspInertia_le_ker_fillMap_of_mem Ω C hc h hc' hW hWU hy hyU'⟩, hx⟩))
  · refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal fun s hs ↦ ?_)
      (isClosed_singleton.preimage (fillMap Ω C hc h).continuous)
    obtain ⟨I, ⟨-, hI⟩, hsI⟩ := Set.mem_iUnion₂.1 hs
    exact hI hsI

/-- `ker_fillMap_eq_closure_fc` for `fillPiHom`. -/
theorem ker_fillPiHom_eq_closure_fc {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω]
    [Algebra K Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
    (hc : (C.U : Set C.Xbar)ᶜ.Nonempty) {U' : C.Xbar.Opens} (h : C.U ≤ U')
    (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
      2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U') :
    (fillPiHom Ω C hc h hc' hyp).toMonoidHom.ker = (Subgroup.normalClosure (⋃ (I)
      (_ : I ∈ arithCusps Ω C hc ∧ I ≤ (fillPiHom Ω C hc h hc' hyp).toMonoidHom.ker),
        (I : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))))).topologicalClosure :=
    by
  rw [ker_fillPiHom_eq_fc Ω C hc h hc' hyp]
  exact ker_fillMap_eq_closure_fc Ω C hc h hc'

/-- **A hyperbolic filling with prescribed kernel**: a closed normal subgroup `N ⊆ Π_U`
topologically normally generated by the cuspidal inertia groups it contains, missing some cusp,
and with `Δ_U / (N ∩ Δ_U)` non-commutative, is the kernel of `fillPiHom` for a hyperbolic filling
`U ⊆ U'` with a cusp. -/
theorem exists_fill_kerPi_eq_fc {K : Type u} [Field K] [NumberField K] (Ω : Type u) [Field Ω]
    [Algebra K Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] (C : HypCurve K)
    (hc : (C.U : Set C.Xbar)ᶜ.Nonempty)
    (N : Subgroup π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U)))
    (hN : N = (Subgroup.normalClosure (⋃ (I) (_ : I ∈ arithCusps Ω C hc ∧ I ≤ N),
      (I : Set π₁ᵉᵗ(basePoint Ω C hc ≫ baseChangeSpec K Ω Γ(C.Xbar, C.U))))).topologicalClosure)
    (hne : ∃ I ∈ arithCusps Ω C hc, ¬ I ≤ N)
    (hnc : ∃ a ∈ (projGk Ω C hc).toMonoidHom.ker, ∃ b ∈ (projGk Ω C hc).toMonoidHom.ker,
      a * b * (b * a)⁻¹ ∉ N) :
    ∃ (U' : C.Xbar.Opens) (h : C.U ≤ U') (hc' : (U' : Set C.Xbar)ᶜ.Nonempty)
      (hyp : haveI := IsCurveOver.isIntegral K C.Xbar
        2 < 2 * Anabelian.curveGenus K C.Xbar + cuspDegree K C.Xbar U'),
      (fillPiHom Ω C hc h hc' hyp).toMonoidHom.ker = N := by
  obtain ⟨U', h, hc', -, hker⟩ := exists_fill_ker_eq Ω C hc N hN hne
  obtain ⟨a, ha, b, hb, hab⟩ := hnc
  have hyp := two_lt_of_not_commute_fillMap Ω C hc h hc' ⟨a, ha, b, hb, fun e ↦ hab (by
    rw [← hker]
    exact map_commutator_eq_one_fc (fillMap Ω C hc h).toMonoidHom e)⟩
  exact ⟨U', h, hc', hyp, (ker_fillPiHom_eq_fc Ω C hc h hc' hyp).trans hker⟩

end Fill

/-! ### Pulling a filling back along a cover -/

section Cover

variable {M : Type u} [Field M] [NumberField M] (Ω : Type u) [Field Ω] [Algebra M Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic M Ω] [CharZero Ω]

attribute [local instance] isAlgClosure_of_isAlgebraic

/-- **Pulling a filling back along an open embedding** (abstract form of `exists_fill_cover`): let
`Y ⊆ Y' = (X̄_Y, U')` be a hyperbolic filling, `O ⊆ Π_{Y'}` open, and `κ : Π_Z ↪ Π_Y` a continuous
injection from the arithmetic `π₁` of a hyperbolic curve `Z` over `M₁ ⊇ M` with image
`fillPiHom⁻¹(O)`, lying over `res : G_{M₁} → G_M` up to conjugation and pulling cuspidal inertia
groups back to cuspidal inertia groups. Then there are a hyperbolic filling `Z ⊆ Z'` and a
continuous injection `ε : Π_{Z'} ↪ Π_{Y'}` with image `O`, `fill_Y ∘ κ = ε ∘ fill_Z`, lying over
`res` up to conjugation. -/
theorem exists_fill_of_coverHom (Y : HypCurve M) (hY : (Y.U : Set Y.Xbar)ᶜ.Nonempty)
    {U' : Y.Xbar.Opens} (h : Y.U ≤ U') (hc' : (U' : Set Y.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral M Y.Xbar
      2 < 2 * Anabelian.curveGenus M Y.Xbar + cuspDegree M Y.Xbar U')
    (O : Subgroup π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫ baseChangeSpec M Ω Γ(Y.Xbar, U')))
    (hO : IsOpen (O : Set π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫
      baseChangeSpec M Ω Γ(Y.Xbar, U')))) {M₁ : Type u} [Field M₁] [NumberField M₁] [Algebra M M₁]
    [Algebra M₁ Ω] [IsScalarTower M M₁ Ω] [Algebra.IsAlgebraic M₁ Ω]
    (Z : HypCurve M₁) (hZ : (Z.U : Set Z.Xbar)ᶜ.Nonempty)
    (κ : π₁ᵉᵗ(basePoint Ω Z hZ ≫ baseChangeSpec M₁ Ω Γ(Z.Xbar, Z.U)) →ₜ*
      π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U)))
    (hκ : Function.Injective κ)
    (hrange : κ.toMonoidHom.range = O.comap (fillPiHom Ω Y hY h hc' hyp).toMonoidHom)
    (hcusp : ∀ I ∈ arithCusps Ω Y hY, I.comap κ.toMonoidHom ∈ arithCusps Ω Z hZ)
    (c : π₁ᵉᵗ(Spec.map (CommRingCat.ofHom (algebraMap M Ω))))
    (hcκ : ∀ σ, projGk Ω Y hY (κ σ) = c * resGal M Ω M₁ (projGk Ω Z hZ σ) * c⁻¹) :
    ∃ (UZ : Z.Xbar.Opens) (hZU : Z.U ≤ UZ) (hcZ : (UZ : Set Z.Xbar)ᶜ.Nonempty)
      (hypZ : haveI := IsCurveOver.isIntegral M₁ Z.Xbar
        2 < 2 * Anabelian.curveGenus M₁ Z.Xbar + cuspDegree M₁ Z.Xbar UZ)
      (ε : π₁ᵉᵗ(basePoint Ω (fillCurve Z hZU hypZ) hcZ ≫ baseChangeSpec M₁ Ω Γ(Z.Xbar, UZ)) →ₜ*
        π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫ baseChangeSpec M Ω Γ(Y.Xbar, U'))),
      Function.Injective ε ∧ ε.toMonoidHom.range = O ∧
      (∀ σ, fillPiHom Ω Y hY h hc' hyp (κ σ) = ε (fillPiHom Ω Z hZ hZU hcZ hypZ σ)) ∧
      ∃ g, ∀ τ, projGk Ω (fillCurve Y h hyp) hc' (ε τ) =
        g * resGal M Ω M₁ (projGk Ω (fillCurve Z hZU hypZ) hcZ τ) * g⁻¹ := by
  -- the kernel of the filling of `Y` lies in `P = range κ`
  have hLκ : (fillPiHom Ω Y hY h hc' hyp).toMonoidHom.ker ≤ κ.toMonoidHom.range := by
    intro x hx
    have hx' : fillPiHom Ω Y hY h hc' hyp x = 1 := hx
    rw [hrange]
    change fillPiHom Ω Y hY h hc' hyp x ∈ O
    rw [hx']
    exact O.one_mem
  -- `N = κ⁻¹(ker fill_Y)` is generated by cusps
  have hN := comap_eq_closure_normalClosure_fc κ hκ (arithCusps Ω Y hY) (arithCusps Ω Z hZ)
    (fun I hI g ↦ map_conj_mem_arithCusps Ω Y hY hI g) hcusp _
    (ker_fillPiHom_eq_closure_fc Ω Y hY h hc' hyp) hLκ
  -- elements of `Δ_{Y'} ∩ O` lift to `Δ_Z`
  have hlift : ∀ x, x ∈ (projGk Ω (fillCurve Y h hyp) hc').toMonoidHom.ker → x ∈ O →
      ∃ a ∈ (projGk Ω Z hZ).toMonoidHom.ker, fillPiHom Ω Y hY h hc' hyp (κ a) = x := by
    intro x hxΔ hxO
    obtain ⟨x', rfl⟩ := fillPiHom_surjective_fc Ω Y hY h hc' hyp x
    have hx'P : x' ∈ κ.toMonoidHom.range := by
      rw [hrange]
      exact hxO
    obtain ⟨a, rfl⟩ := hx'P
    refine ⟨a, ?_, rfl⟩
    have e1 : projGk Ω (fillCurve Y h hyp) hc' (fillPiHom Ω Y hY h hc' hyp (κ a)) = 1 := hxΔ
    rw [projGk_fillPiHom_fc Ω Y hY h hc' hyp, hcκ] at e1
    have e2 : galoisMap M M₁ Ω (projGk Ω Z hZ a) = 1 := eq_one_of_conj_conj_fc e1
    exact (map_eq_one_iff _ (galoisMap_injective M M₁ Ω)).1 e2
  -- a non-commutative image of `Δ_Z`
  have hnc : ∃ a ∈ (projGk Ω Z hZ).toMonoidHom.ker, ∃ b ∈ (projGk Ω Z hZ).toMonoidHom.ker,
      a * b * (b * a)⁻¹ ∉ (fillPiHom Ω Y hY h hc' hyp).toMonoidHom.ker.comap κ.toMonoidHom := by
    obtain ⟨x, hxΔ, hxO, y, hyΔ, hyO, hxy⟩ := exists_not_commute_of_isSlim_fc
      (arithmeticExt Ω (fillCurve Y h hyp) hc').slim_delta
      (arithmeticExt Ω (fillCurve Y h hyp) hc').nontrivial_delta hO
    obtain ⟨a, ha, rfl⟩ := hlift x hxΔ hxO
    obtain ⟨b, hb, rfl⟩ := hlift y hyΔ hyO
    exact ⟨a, ha, b, hb, fun hmem ↦ hxy (map_mul_comm_of_commutator_fc
      ((fillPiHom Ω Y hY h hc' hyp).toMonoidHom.comp κ.toMonoidHom) hmem)⟩
  -- a cusp of `Z` outside `N`
  have hne : ∃ J ∈ arithCusps Ω Z hZ,
      ¬ J ≤ (fillPiHom Ω Y hY h hc' hyp).toMonoidHom.ker.comap κ.toMonoidHom := by
    haveI := nonempty_fillOpen Ω Y h
    obtain ⟨I', hI'⟩ := exists_mem_arithCusps₂ (Ω := Ω) (CX := fillCurve Y h hyp) (hcX := hc')
    obtain ⟨I, hI, hII'⟩ := exists_map_eq_of_conjInduced_fill Ω Y hY h hc' hyp
      (fillPiHom Ω Y hY h hc' hyp).toMonoidHom (isConjInduced_fillPiHom Ω Y hY h hc' hyp) hI'
    have hPo : IsOpen ((κ.toMonoidHom.range : Subgroup _) :
        Set π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U))) := by
      rw [hrange]
      exact hO.preimage (fillPiHom Ω Y hY h hc' hyp).continuous
    haveI := finiteIndex_of_isOpen hPo
    refine ⟨_, hcusp I hI, not_comap_le_comap_ker_fc κ.toMonoidHom
      (fillPiHom Ω Y hY h hc' hyp).toMonoidHom ?_⟩
    rw [hII']
    exact not_commensurable_bot_of_mem_arithCusps₂ hI'
  -- the filling of `Z`
  obtain ⟨UZ, hZU, hcZ, hypZ, hker⟩ := exists_fill_kerPi_eq_fc Ω Z hZ _ hN hne hnc
  obtain ⟨ε, hεinj, hε⟩ := exists_lift_injective_fc (fillPiHom Ω Z hZ hZU hcZ hypZ)
    (fillPiHom_surjective_fc Ω Z hZ hZU hcZ hypZ) ((fillPiHom Ω Y hY h hc' hyp).comp κ)
    (hker.trans (MonoidHom.comap_ker _ _))
  have hε' : ∀ σ, ε (fillPiHom Ω Z hZ hZU hcZ hypZ σ) = fillPiHom Ω Y hY h hc' hyp (κ σ) := hε
  have hεr : ε.toMonoidHom.range = O := by
    ext x
    constructor
    · rintro ⟨q, rfl⟩
      obtain ⟨σ, rfl⟩ := fillPiHom_surjective_fc Ω Z hZ hZU hcZ hypZ q
      have hσ : κ σ ∈ O.comap (fillPiHom Ω Y hY h hc' hyp).toMonoidHom := by
        rw [← hrange]
        exact ⟨σ, rfl⟩
      change ε (fillPiHom Ω Z hZ hZU hcZ hypZ σ) ∈ O
      rw [hε']
      exact hσ
    · intro hx
      obtain ⟨y, rfl⟩ := fillPiHom_surjective_fc Ω Y hY h hc' hyp x
      have hy : y ∈ κ.toMonoidHom.range := by
        rw [hrange]
        exact hx
      obtain ⟨σ, rfl⟩ := hy
      exact ⟨fillPiHom Ω Z hZ hZU hcZ hypZ σ, hε' σ⟩
  refine ⟨UZ, hZU, hcZ, hypZ, ε, hεinj, hεr, fun σ ↦ (hε' σ).symm,
    (fillG Ω Y hY h hc' hyp)⁻¹ * c * resGal M Ω M₁ (fillG Ω Z hZ hZU hcZ hypZ), fun τ ↦ ?_⟩
  obtain ⟨σ, rfl⟩ := fillPiHom_surjective_fc Ω Z hZ hZU hcZ hypZ τ
  exact (congrArg (projGk Ω (fillCurve Y h hyp) hc') (hε' σ)).trans
    (conj_chain_fc (resGal M Ω M₁) (projGk_fillPiHom_fc Ω Y hY h hc' hyp (κ σ)) (hcκ σ)
      (projGk_fillPiHom_fc Ω Z hZ hZU hcZ hypZ σ))

/-- **`exists_fill_cover` for a given connected finite étale cover** `p : Yc ⟶ Spec Γ(Y.U)` with a
point `ζ` such that `π₁ᵉᵗ(Yc, ζ) → Π_Y` has image `fillPiHom⁻¹(O)`: `Z` is the cover curve
`coverCurve Y hY p` over its constant field and `κ` is `Π_Z ≃ π₁ᵉᵗ(Yc) ⊆ Π_Y`. -/
theorem exists_fill_cover_of_isFiniteEtale (Y : HypCurve M) (hY : (Y.U : Set Y.Xbar)ᶜ.Nonempty)
    {U' : Y.Xbar.Opens} (h : Y.U ≤ U') (hc' : (U' : Set Y.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral M Y.Xbar
      2 < 2 * Anabelian.curveGenus M Y.Xbar + cuspDegree M Y.Xbar U')
    (O : Subgroup π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫ baseChangeSpec M Ω Γ(Y.Xbar, U')))
    (hO : IsOpen (O : Set π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫
      baseChangeSpec M Ω Γ(Y.Xbar, U'))))
    {Yc : Scheme.{u}} (p : Yc ⟶ Spec Γ(Y.Xbar, Y.U)) [IsFiniteEtale p] [ConnectedSpace Yc]
    (ζ : Spec (.of Ω) ⟶ Yc) (hζ : ζ ≫ p = basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U))
    (hrangeP : (fundamentalGroupMap p hζ).toMonoidHom.range =
      O.comap (fillPiHom Ω Y hY h hc' hyp).toMonoidHom) :
    ∃ (M₁ : Type u) (_ : Field M₁) (_ : NumberField M₁) (_ : Algebra M M₁) (_ : Algebra M₁ Ω)
      (_ : IsScalarTower M M₁ Ω) (_ : FiniteDimensional M M₁) (_ : Algebra.IsAlgebraic M₁ Ω)
      (Z : HypCurve M₁) (hZ : (Z.U : Set Z.Xbar)ᶜ.Nonempty) (UZ : Z.Xbar.Opens) (hZU : Z.U ≤ UZ)
      (hcZ : (UZ : Set Z.Xbar)ᶜ.Nonempty)
      (hypZ : haveI := IsCurveOver.isIntegral M₁ Z.Xbar
        2 < 2 * Anabelian.curveGenus M₁ Z.Xbar + cuspDegree M₁ Z.Xbar UZ)
      (κ : π₁ᵉᵗ(basePoint Ω Z hZ ≫ baseChangeSpec M₁ Ω Γ(Z.Xbar, Z.U)) →ₜ*
        π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U)))
      (ε : π₁ᵉᵗ(basePoint Ω (fillCurve Z hZU hypZ) hcZ ≫ baseChangeSpec M₁ Ω Γ(Z.Xbar, UZ)) →ₜ*
        π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫ baseChangeSpec M Ω Γ(Y.Xbar, U'))),
      Function.Injective κ ∧
      κ.toMonoidHom.range = O.comap (fillPiHom Ω Y hY h hc' hyp).toMonoidHom ∧
      Function.Injective ε ∧ ε.toMonoidHom.range = O ∧
      (∀ σ, fillPiHom Ω Y hY h hc' hyp (κ σ) = ε (fillPiHom Ω Z hZ hZU hcZ hypZ σ)) ∧
      ∃ g, ∀ τ, projGk Ω (fillCurve Y h hyp) hc' (ε τ) =
        g * resGal M Ω M₁ (projGk Ω (fillCurve Z hZU hypZ) hcZ τ) * g⁻¹ := by
  haveI := isIntegral_specSections Y hY
  letI := coverAlgebra Ω Y hY p ζ
  haveI := isScalarTower_coverAlgebra Ω Y hY p ζ hζ
  haveI := isAlgebraic_coverAlgebra Ω Y hY p ζ hζ
  haveI : FiniteDimensional M (coverField Y hY p) :=
    Module.Finite.of_restrictScalars_finite ℚ M (coverField Y hY p)
  have htoG := toG_coverCurvePiEquiv Ω Y hY p ζ hζ
  generalize coverConj Ω Y hY p ζ hζ (coverCurve Y hY p) (coverCurve_cusp Y hY p)
    (coverIso Y hY p) (coverIso_spec Y hY p) = cc at htoG
  obtain ⟨κ, hκdef⟩ : ∃ κ : π₁ᵉᵗ(basePoint Ω (coverCurve Y hY p) (coverCurve_cusp Y hY p) ≫
      baseChangeSpec (coverField Y hY p) Ω Γ((coverCurve Y hY p).Xbar, (coverCurve Y hY p).U)) →ₜ*
        π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U)),
      ∀ σ, κ σ = coverPiIncl Ω Y hY p ζ hζ (coverCurvePiEquiv Ω Y hY p ζ hζ σ) :=
    ⟨(coverPiIncl Ω Y hY p ζ hζ).comp
      (ContinuousMonoidHom.toContinuousMonoidHom (coverCurvePiEquiv Ω Y hY p ζ hζ)),
      fun _ ↦ rfl⟩
  have hinj : Function.Injective κ := fun a b hab ↦ (coverCurvePiEquiv Ω Y hY p ζ hζ).injective
    (Subtype.ext ((hκdef a).symm.trans (hab.trans (hκdef b))))
  have hrange : κ.toMonoidHom.range = O.comap (fillPiHom Ω Y hY h hc' hyp).toMonoidHom := by
    rw [← hrangeP, range_fundamentalGroupMap_eq_coverSubgroup]
    ext x
    constructor
    · rintro ⟨σ, rfl⟩
      change κ σ ∈ (coverSubgroup p ζ hζ :
        Subgroup π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U)))
      rw [hκdef]
      exact (show ↥(coverSubgroup p ζ hζ :
        Subgroup π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U))) from
          coverCurvePiEquiv Ω Y hY p ζ hζ σ).2
    · intro hx
      obtain ⟨σ, hσ⟩ := (coverCurvePiEquiv Ω Y hY p ζ hζ).surjective ⟨x, hx⟩
      exact ⟨σ, (hκdef σ).trans (congrArg Subtype.val hσ)⟩
  have hcusp : ∀ I ∈ arithCusps Ω Y hY,
      I.comap κ.toMonoidHom ∈ arithCusps Ω (coverCurve Y hY p) (coverCurve_cusp Y hY p) := by
    intro I hI
    have e : I.comap κ.toMonoidHom = I.comap ((coverPiIncl Ω Y hY p ζ hζ).toMonoidHom.comp
        (coverCurvePiEquiv Ω Y hY p ζ hζ).toMulEquiv.toMonoidHom) := by
      ext σ
      exact Iff.of_eq (congrArg (· ∈ I) (hκdef σ))
    rw [e]
    exact comap_coverPiEquiv_mem_arithCusps Ω Y hY (coverCurve Y hY p) (coverCurve_cusp Y hY p)
      p ζ hζ (coverIso Y hY p) (coverIso_spec Y hY p) hI
  have hcκ : ∀ σ, projGk Ω Y hY (κ σ) = cc * resGal M Ω (coverField Y hY p)
      (projGk Ω (coverCurve Y hY p) (coverCurve_cusp Y hY p) σ) * cc⁻¹ := fun σ ↦
    (congrArg (projGk Ω Y hY) (hκdef σ)).trans (htoG σ)
  obtain ⟨UZ, hZU, hcZ, hypZ, ε, hεinj, hεr, hcomm, g, hg⟩ := exists_fill_of_coverHom Ω Y hY h
    hc' hyp O hO (coverCurve Y hY p) (coverCurve_cusp Y hY p) κ hinj hrange hcusp cc hcκ
  exact ⟨coverField Y hY p, inferInstance, inferInstance, inferInstance, coverAlgebra Ω Y hY p ζ,
    inferInstance, inferInstance, inferInstance, coverCurve Y hY p, coverCurve_cusp Y hY p, UZ,
    hZU, hcZ, hypZ, κ, ε, hinj, hrange, hεinj, hεr, hcomm, g, hg⟩

/-- **Pulling a filling back along a finite étale cover** ([AbsTopII] Cor 3.3 (iii)(a), geometric
step, `Topics in Absolute Anabelian Geometry II.txt` l.4481–4491). Let `Y` be a hyperbolic curve
over a number field `M` with a cusp, `Y.U ⊆ U'` a hyperbolic filling with a cusp and `O ⊆ Π_{Y'}`
an open subgroup. Then there are a number field `M₁ ⊇ M` (inside `Ω`), a hyperbolic curve `Z`
over `M₁` with a cusp, a hyperbolic filling `Z.U ⊆ UZ` with a cusp, a continuous injection
`κ : Π_Z ↪ Π_Y` with image `fillPiHom⁻¹(O)` and a continuous injection `ε : Π_{Z'} ↪ Π_{Y'}` with
image `O` such that `fill_Y ∘ κ = ε ∘ fill_Z` and `ε` lies over `res : G_{M₁} → G_M` up to
conjugation. (`Z` is the cover of `Y` attached to `fillPiHom⁻¹(O)`.) -/
theorem exists_fill_cover (Y : HypCurve M) (hY : (Y.U : Set Y.Xbar)ᶜ.Nonempty)
    {U' : Y.Xbar.Opens} (h : Y.U ≤ U') (hc' : (U' : Set Y.Xbar)ᶜ.Nonempty)
    (hyp : haveI := IsCurveOver.isIntegral M Y.Xbar
      2 < 2 * Anabelian.curveGenus M Y.Xbar + cuspDegree M Y.Xbar U')
    (O : Subgroup π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫ baseChangeSpec M Ω Γ(Y.Xbar, U')))
    (hO : IsOpen (O : Set π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫
      baseChangeSpec M Ω Γ(Y.Xbar, U')))) :
    ∃ (M₁ : Type u) (_ : Field M₁) (_ : NumberField M₁) (_ : Algebra M M₁) (_ : Algebra M₁ Ω)
      (_ : IsScalarTower M M₁ Ω) (_ : FiniteDimensional M M₁) (_ : Algebra.IsAlgebraic M₁ Ω)
      (Z : HypCurve M₁) (hZ : (Z.U : Set Z.Xbar)ᶜ.Nonempty) (UZ : Z.Xbar.Opens) (hZU : Z.U ≤ UZ)
      (hcZ : (UZ : Set Z.Xbar)ᶜ.Nonempty)
      (hypZ : haveI := IsCurveOver.isIntegral M₁ Z.Xbar
        2 < 2 * Anabelian.curveGenus M₁ Z.Xbar + cuspDegree M₁ Z.Xbar UZ)
      (κ : π₁ᵉᵗ(basePoint Ω Z hZ ≫ baseChangeSpec M₁ Ω Γ(Z.Xbar, Z.U)) →ₜ*
        π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U)))
      (ε : π₁ᵉᵗ(basePoint Ω (fillCurve Z hZU hypZ) hcZ ≫ baseChangeSpec M₁ Ω Γ(Z.Xbar, UZ)) →ₜ*
        π₁ᵉᵗ(basePoint Ω (fillCurve Y h hyp) hc' ≫ baseChangeSpec M Ω Γ(Y.Xbar, U'))),
      Function.Injective κ ∧
      κ.toMonoidHom.range = O.comap (fillPiHom Ω Y hY h hc' hyp).toMonoidHom ∧
      Function.Injective ε ∧ ε.toMonoidHom.range = O ∧
      (∀ σ, fillPiHom Ω Y hY h hc' hyp (κ σ) = ε (fillPiHom Ω Z hZ hZU hcZ hypZ σ)) ∧
      ∃ g, ∀ τ, projGk Ω (fillCurve Y h hyp) hc' (ε τ) =
        g * resGal M Ω M₁ (projGk Ω (fillCurve Z hZU hypZ) hcZ τ) * g⁻¹ := by
  haveI := isIntegral_specSections Y hY
  have hPo : IsOpen ((O.comap (fillPiHom Ω Y hY h hc' hyp).toMonoidHom : Subgroup _) :
      Set π₁ᵉᵗ(basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U))) :=
    hO.preimage (fillPiHom Ω Y hY h hc' hyp).continuous
  obtain ⟨Yc, p, hp, ζ, hζ, hconn, hrangeP⟩ := exists_isFiniteEtale_range_eq_of_open
    (basePoint Ω Y hY ≫ baseChangeSpec M Ω Γ(Y.Xbar, Y.U)) ⟨_, hPo⟩
  haveI := hp
  haveI := hconn
  exact exists_fill_cover_of_isFiniteEtale Ω Y hY h hc' hyp O hO p ζ hζ hrangeP

end Cover

end CurvesJacobian.Cusp
