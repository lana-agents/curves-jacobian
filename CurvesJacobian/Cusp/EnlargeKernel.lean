import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Topology.Algebra.Group.Basic

/-!
# Kernels generated by cuspidal subgroups under a torsion-free target (MR8 option (Q))

Group-theoretic core of the torsion argument in the enlargement of geometric models
(round-23 design, option (Q), step (v)): let `Φ : E →* P` be a homomorphism, `N ≤ E` a subgroup
of finite index and `T ≤ P` a torsion-free subgroup. If a subgroup `C ≤ E` with `Φ(C) ≤ T`
satisfies `C ⊓ N ≤ ker Φ`, then `C ≤ ker Φ` (`CurvesJacobian.Cusp.le_ker_of_inf_le_ker`):
`Φ(C)` consists of elements of finite order (every `x ∈ C` has a power in `C ⊓ N`), which are
trivial in `T`. In particular **the image of `C` in `P` is finite and hence trivial** — this is
the step "each inertia group of the quotient curve has finite image in `P'`, which is
torsion-free" of the construction.

`CurvesJacobian.Cusp.ker_eq_closure_of_cusps`: if moreover `ker Φ` is closed and topologically
normally generated by subgroups `J` each contained in some `C` of a family `𝒞` with
`Φ(C) ≤ T` and `C ⊓ N ≤ ker Φ`, then `ker Φ` is topologically normally generated by the members
of `𝒞` contained in it.
-/

namespace CurvesJacobian.Cusp

variable {E P : Type*} [Group E] [Group P]

/-- A subgroup is torsion-free if its only element of finite order is `1`. -/
def IsTorsionFreeSubgroup (T : Subgroup P) : Prop :=
  ∀ x ∈ T, IsOfFinOrder x → x = 1

/-- **Torsion argument.** If `N` has finite index, `Φ(C) ≤ T` with `T` torsion-free and
`C ⊓ N ≤ ker Φ`, then `C ≤ ker Φ`. -/
theorem le_ker_of_inf_le_ker (Φ : E →* P) {N C : Subgroup E} (hN : N.index ≠ 0)
    {T : Subgroup P} (hT : IsTorsionFreeSubgroup T) (hCT : C.map Φ ≤ T)
    (hCN : C ⊓ N ≤ Φ.ker) : C ≤ Φ.ker := by
  intro x hx
  have hrel : N.relIndex C ≠ 0 := fun h0 ↦ hN (by
    rw [← Subgroup.relIndex_top_right]
    exact Subgroup.relIndex_eq_zero_of_le_right le_top h0)
  obtain ⟨n, hn, -, hxn⟩ := Subgroup.exists_pow_mem_of_relIndex_ne_zero hrel hx
  have hxn' : x ^ n ∈ C ⊓ N := ⟨hxn.2, hxn.1⟩
  have h1 : Φ x ^ n = 1 := by
    rw [← map_pow]
    exact hCN hxn'
  exact hT _ (hCT ⟨x, hx, rfl⟩) (isOfFinOrder_iff_pow_eq_one.2 ⟨n, hn, h1⟩)

/-- The image of `C` is trivial (in particular finite). -/
theorem map_eq_bot_of_inf_le_ker (Φ : E →* P) {N C : Subgroup E} (hN : N.index ≠ 0)
    {T : Subgroup P} (hT : IsTorsionFreeSubgroup T) (hCT : C.map Φ ≤ T)
    (hCN : C ⊓ N ≤ Φ.ker) : C.map Φ = ⊥ :=
  (Subgroup.map_eq_bot_iff C).2 (le_ker_of_inf_le_ker Φ hN hT hCT hCN)

variable [TopologicalSpace E]

/-- **The kernel is generated by the members of `𝒞` it contains.** Let `ker Φ` be closed and
topologically normally generated by subgroups `J ∈ 𝒥` contained in it, each of which lies in some
`C ∈ 𝒞` with `Φ(C) ≤ T` (`T` torsion-free) and `C ⊓ N ≤ ker Φ` (`N` of finite index). Then
`ker Φ` is topologically normally generated by the members of `𝒞` contained in it. -/
theorem ker_eq_closure_of_cusps [IsTopologicalGroup E] (Φ : E →* P)
    (hclosed : IsClosed (Φ.ker : Set E)) {N : Subgroup E} (hN : N.index ≠ 0)
    {T : Subgroup P} (hT : IsTorsionFreeSubgroup T) (𝒞 𝒥 : Set (Subgroup E))
    (hCT : ∀ C ∈ 𝒞, C.map Φ ≤ T)
    (hgen : Φ.ker = (Subgroup.normalClosure
      (⋃ (J) (_ : J ∈ 𝒥 ∧ J ≤ Φ.ker), (J : Set E))).topologicalClosure)
    (hJ : ∀ J ∈ 𝒥, J ≤ Φ.ker → ∃ C ∈ 𝒞, J ≤ C ∧ C ⊓ N ≤ Φ.ker) :
    Φ.ker = (Subgroup.normalClosure
      (⋃ (C) (_ : C ∈ 𝒞 ∧ C ≤ Φ.ker), (C : Set E))).topologicalClosure := by
  apply le_antisymm
  · refine hgen.le.trans ?_
    refine Subgroup.topologicalClosure_mono (Subgroup.normalClosure_mono ?_)
    intro x hx
    obtain ⟨J, ⟨hJ𝒥, hJk⟩, hxJ⟩ := Set.mem_iUnion₂.1 hx
    obtain ⟨C, hC, hJC, hCN⟩ := hJ J hJ𝒥 hJk
    exact Set.mem_iUnion₂.2 ⟨C, ⟨hC, le_ker_of_inf_le_ker Φ hN hT (hCT C hC) hCN⟩, hJC hxJ⟩
  · refine Subgroup.topologicalClosure_minimal _ ?_ hclosed
    refine Subgroup.normalClosure_le_normal ?_
    intro x hx
    obtain ⟨C, ⟨-, hCk⟩, hxC⟩ := Set.mem_iUnion₂.1 hx
    exact hCk hxC

end CurvesJacobian.Cusp
