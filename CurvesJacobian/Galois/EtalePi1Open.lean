import CurvesJacobian.Galois.EtalePi1
import CurvesJacobian.Galois.NewCoordinate
import CurvesJacobian.Galois.ChartOfOpen
import Pi1.Orbifold.CuspFilling

/-!
# `π₁ᵉᵗ` of open subschemes of a curve in the Galois model

Setting of `Galois/EtalePi1.lean`: `k` algebraically closed of characteristic `0`,
`D : GaloisData k t` with `H = H_L` (`hH`), `X` a curve over `k` and `eL : K(X) ≃ L` a
`k`-isomorphism (`hk`) with `eL τ = t` (`hτ`). For a nonempty open `U ⊆ X` let

* `CurvesJacobian.genericL D X eL U : Spec L ⟶ U` be the generic point, and
  `D.chartHom hH (genericL D X eL U) : H →* π₁ᵉᵗ(U)` the intrinsic Galois action at the geometric
  generic point `Spec Ω ⟶ Spec L ⟶ U`;
* `CurvesJacobian.SU D X eL U ⊆ H` the inertia elements at the places `W ⊇ k` of `Ω` centred
  on `U`, i.e. with `eL(Γ(U, 𝒪_X)) ⊆ W`.

Main results, for `U` nonempty with finite complement (`hU`):

* `CurvesJacobian.genericL_spec`: `H → π₁ᵉᵗ(U)` is surjective with kernel `⟨⟨S_U⟩⟩`;
* `CurvesJacobian.etalePi1OpenEquiv : π₁ᵉᵗ(U) ≃ₜ* H ⧸ ⟨⟨S_U⟩⟩` (inverse induced by the Galois
  action, `etalePi1OpenEquiv_symm_mk`);
* `CurvesJacobian.etalePi1OpenEquiv_fundamentalGroupMap`: **naturality** — for `U ⊆ V`, the map
  `π₁ᵉᵗ(U) → π₁ᵉᵗ(V)` is the quotient map `H ⧸ ⟨⟨S_U⟩⟩ ↠ H ⧸ ⟨⟨S_V⟩⟩` (`GaloisPi1.pi1Map`);
* `CurvesJacobian.ker_fundamentalGroupMap_homOfLE`: **filling in cusps** — the kernel of
  `π₁ᵉᵗ(U) → π₁ᵉᵗ(V)` is the closed normal subgroup generated by the images of the inertia
  elements in `S_V ∖ S_U`;
* `CurvesJacobian.etalePi1EquivPiX_fundamentalGroupMap_top`: for `U = X` this is
  `etalePi1EquivPiX` (`SU_top : S_X = SAll D`).

Ingredients: `SU_chartOne` (`S_U = D.Sat (eL τ')` for the chart `U = π⁻¹ D₊(X₁)` of a rational
function `τ'`, `π = toP1 τ'`), `genericL_chartOne_spec`, `ker_genericL_top`,
`genericL_top_surjective`, and `exists_chartOne_eq` (every `U ≠ X` with finite complement is
such a chart, by Riemann–Roch). The chart case uses `CurvesJacobian.newData` (Galois data for
the coordinate `eL τ'`, whose coordinate ring is `Γ(U)`) and pi1's `ker_galoisHom` for it; the
case `U = X` is the two-chart étale van Kampen theorem `ker_curveChartHomX`.
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry Belyi AlgebraicGeometry.FiniteEtale
open Pi1.Orbifold AffOrbicurve

universe u

noncomputable section

namespace CurvesJacobian

section Galois

variable {F Ω : Type u} [Field F] [Field Ω] [Algebra F Ω] [IsSepClosed Ω] [IsGalois F Ω]

/-- Naturality of the Galois action through a field-valued point, with an arbitrary
factorisation `j ≫ f = j'`. -/
lemma fundamentalGroupMap_galoisAction_eq {Y Z : Scheme.{u}} (j : Spec (.of F) ⟶ Y) (f : Y ⟶ Z)
    (j' : Spec (.of F) ⟶ Z) (hj : j ≫ f = j') {p : Spec (.of Ω) ⟶ Y} {η : Spec (.of Ω) ⟶ Z}
    (h₁ : Spec.map (CommRingCat.ofHom (algebraMap F Ω)) ≫ j = p) (h₂ : p ≫ f = η)
    (h' : Spec.map (CommRingCat.ofHom (algebraMap F Ω)) ≫ j' = η) (g : Ω ≃ₐ[F] Ω) :
    fundamentalGroupMap f h₂ (galoisAction F j h₁ g) = galoisAction F j' h' g := by
  rw [fundamentalGroupMap_galoisAction F j f h₁ h₂ (by rw [hj]; exact h')]
  exact DFunLike.congr_fun (galoisAction_congr F hj _ _) g

end Galois

section Opens

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} (D : GaloisData k t)
  (X : Scheme.{u}) [X.Over (Spec (CommRingCat.of k))] [IsIntegral X]
  (eL : X.functionField ≃+* D.L)

/-- The generic point `Spec L ≅ Spec K(X) ⟶ U` of a nonempty open `U`. -/
def genericL (U : X.Opens) [Nonempty U] : Spec (.of D.L) ⟶ U :=
  Spec.map (CommRingCat.ofHom eL.toRingHom) ≫ genericToOpen U

/-- The generic point `Spec L ≅ Spec K(X) ⟶ X`. -/
def genericLX : Spec (.of D.L) ⟶ X :=
  Spec.map (CommRingCat.ofHom eL.toRingHom) ≫ X.fromSpecStalk (genericPoint X)

omit [X.Over (Spec (CommRingCat.of k))] in
@[reassoc (attr := simp)]
lemma genericL_ι (U : X.Opens) [Nonempty U] : genericL D X eL U ≫ U.ι = genericLX D X eL := by
  simp [genericL, genericLX]

omit [X.Over (Spec (CommRingCat.of k))] in
@[reassoc]
lemma genericL_homOfLE {U V : X.Opens} [Nonempty U] [Nonempty V] (h : U ≤ V) :
    genericL D X eL U ≫ X.homOfLE h = genericL D X eL V := by
  rw [← cancel_mono V.ι, Category.assoc, Scheme.homOfLE_ι, genericL_ι, genericL_ι]

omit [X.Over (Spec (CommRingCat.of k))] in
lemma specPoint_genericL_homOfLE {U V : X.Opens} [Nonempty U] [Nonempty V] (h : U ≤ V) :
    (specPoint D.L Ω ≫ genericL D X eL U) ≫ X.homOfLE h = specPoint D.L Ω ≫ genericL D X eL V := by
  rw [Category.assoc, genericL_homOfLE]

/-- **The inertia elements at the places centred on `U`**: the elements of `H` lying in the
inertia group of a valuation subring `W ⊇ k` of `Ω` with `eL(Γ(U, 𝒪_X)) ⊆ W`. -/
def SU (U : X.Opens) [Nonempty U] : Set (Ω ≃ₐ[K₀ k t] Ω) :=
  {σ | σ ∈ D.H ∧ ∃ W : ValuationSubring Ω, (∀ c : k, algebraMap k Ω c ∈ W) ∧
    (∀ a : Γ(X, U), ((eL (X.germToFunctionField U a) : D.L) : Ω) ∈ W) ∧
    σ ∈ GaloisPi1.inertia W}

omit [X.Over (Spec (CommRingCat.of k))] in
lemma SU_subset_H (U : X.Opens) [Nonempty U] : SU D X eL U ⊆ D.H := fun _ h ↦ h.1

omit [X.Over (Spec (CommRingCat.of k))] in
/-- `S_U ⊆ S_V` for `U ⊆ V`. -/
lemma SU_mono {U V : X.Opens} [Nonempty U] [Nonempty V] (h : U ≤ V) :
    SU D X eL U ⊆ SU D X eL V := by
  rintro σ ⟨hσ, W, hk, hW, hi⟩
  refine ⟨hσ, W, hk, fun a ↦ ?_, hi⟩
  rw [← germToFunctionField_res (homOfLE h) a]
  exact hW _

variable (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)

include hk in
/-- A function integral over `k[s]` lies in every place `W ⊇ k` of `Ω` containing `s`. -/
lemma mem_of_isIntegral {W : ValuationSubring Ω} (hkW : ∀ c : k, algebraMap k Ω c ∈ W)
    {s z : X.functionField} (hs : ((eL s : D.L) : Ω) ∈ W)
    (hz : IsIntegral (Algebra.adjoin k {s}) z) : ((eL z : D.L) : Ω) ∈ W :=
  WeilCurves.FunctionField.mem_of_mem_chartRing W hkW hs
    ((isIntegral_adjoin_map_iff (embK D X eL hk) s z).1 hz)

variable [IsAlgClosed k] [CharZero k] [IsCurveOver k X]

omit [IsAlgClosed k] in
include hk in
/-- On the chart `π⁻¹ D₊(X₁)` of a rational function `τ'`, the places centred on `U` are those
containing `eL τ'`. -/
lemma SU_chartOne (hH : D.H ≤ D.HL) {τ' : X.functionField} (hτ' : Transcendental k τ') :
    SU D X eL (chartOne k X τ') = D.Sat ((eL τ' : D.L) : Ω) := by
  ext σ
  constructor
  · rintro ⟨hσ, W, hkW, hW, hi⟩
    obtain ⟨a, ha⟩ := (mem_range_germ_chartOne_iff hτ' τ').2
      (isIntegral_algebraMap (x := (⟨τ', Algebra.self_mem_adjoin_singleton k τ'⟩ :
        Algebra.adjoin k {τ'})))
    refine ⟨hH hσ, W, hkW, ?_, hi⟩
    rw [← ha]
    exact hW a
  · rintro ⟨hσ, W, hkW, ht, hi⟩
    exact ⟨D.le hσ, W, hkW, fun a ↦ mem_of_isIntegral D X eL hk hkW ht
      ((mem_range_germ_chartOne_iff hτ' _).1 ⟨a, rfl⟩), hi⟩

omit [IsAlgClosed k] in
include hk in
/-- The places centred on `X` are all places `W ⊇ k`. -/
lemma SU_top [Nonempty (⊤ : X.Opens)] {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t) :
    SU D X eL ⊤ = SAll D := by
  have hτT := transcendental_of_embK D X eL hk hτ
  ext σ
  constructor
  · rintro ⟨hσ, W, hkW, -, hi⟩
    exact ⟨hσ, W, hkW, hi⟩
  · rintro ⟨hσ, W, hkW, hi⟩
    refine ⟨hσ, W, hkW, fun a ↦ ?_, hi⟩
    rcases W.mem_or_inv_mem t with ht | ht
    · rw [← germToFunctionField_res (homOfLE (le_top : chartOne k X τ ≤ ⊤)) a]
      exact mem_of_isIntegral D X eL hk hkW (s := τ) (by rw [hτ]; exact ht)
        ((mem_range_germ_chartOne_iff hτT _).1 ⟨_, rfl⟩)
    · haveI := nonempty_chartZero_of_ne_zero (k := k) X (ne_zero_of_embK D X eL hk hτ)
      rw [← germToFunctionField_res (homOfLE (le_top : chartZero k X τ ≤ ⊤)) a]
      refine mem_of_isIntegral D X eL hk hkW (s := τ⁻¹) ?_
        ((mem_range_germ_chartZero_iff hτT _).1 ⟨_, rfl⟩)
      rw [map_inv₀, IntermediateField.coe_inv, hτ]
      exact ht

section Action

variable [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] (hH : D.H ≤ D.HL)

omit [IsAlgClosed k] [CharZero k] [IsCurveOver k X] in
/-- Naturality of `chartHom` along `f` with `j ≫ f = j'`. -/
lemma fundamentalGroupMap_chartHom_eq {Y Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) (f : Y ⟶ Z)
    (j' : Spec (.of D.L) ⟶ Z) (hj : j ≫ f = j')
    (h : (specPoint D.L Ω ≫ j) ≫ f = specPoint D.L Ω ≫ j') (σ : D.H) :
    fundamentalGroupMap f h (D.chartHom hH j σ) = D.chartHom hH j' σ := by
  rw [GaloisData.chartHom_apply, GaloisData.chartHom_apply]
  exact fundamentalGroupMap_galoisAction_eq j f j' hj rfl h rfl _

omit [X.Over (Spec (CommRingCat.of k))] [IsAlgClosed k] [CharZero k] [IsCurveOver k X] in
/-- **Naturality in `U ⊆ V`**: `π₁ᵉᵗ(U) → π₁ᵉᵗ(V)` intertwines the Galois actions of `H`. -/
theorem fundamentalGroupMap_genericL {U V : X.Opens} [Nonempty U] [Nonempty V] (h : U ≤ V)
    (σ : D.H) :
    fundamentalGroupMap (X.homOfLE h) (specPoint_genericL_homOfLE D X eL h)
      (D.chartHom hH (genericL D X eL U) σ) = D.chartHom hH (genericL D X eL V) σ :=
  fundamentalGroupMap_chartHom_eq D hH _ _ _ (genericL_homOfLE D X eL h) _ σ

section Chart

variable {τ' : X.functionField} (hτ' : Transcendental k τ')

omit [IsAlgClosed k] [CharZero k] [IsCurveOver k X] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] in
include hk hτ' in
lemma transcendental_eL : Transcendental k ((eL τ' : D.L) : Ω) := by
  rw [← embK_apply D X eL hk]
  exact fun h ↦ hτ' ((isAlgebraic_algHom_iff (embK D X eL hk)
    (embK D X eL hk).toRingHom.injective).mp h)

/-- `L` as the function field of `newData` for the coordinate `eL τ'`. -/
def newL : D.L ≃+* (newData D (eL τ').2 (transcendental_eL D X eL hk hτ')).L :=
  haveI := isGalois_K₀_of_mem (E := D.L) D.transcendental (eL τ').2
    (transcendental_eL D X eL hk hτ')
  { toFun x := ⟨x, (mem_newData_L D _ _ _).2 x.2⟩
    invFun x := ⟨x, (mem_newData_L D _ _ _).1 x.2⟩
    left_inv _ := rfl
    right_inv _ := rfl
    map_mul' _ _ := rfl
    map_add' _ _ := rfl }

omit [IsAlgClosed k] in
include hk hτ' hH in
/-- **`π₁ᵉᵗ` of a chart**: the Galois action `H → π₁ᵉᵗ(π⁻¹ D₊(X₁))` (`π = toP1 τ'`) is
surjective with kernel `⟨⟨S_U⟩⟩`. -/
theorem genericL_chartOne_spec :
    (D.chartHom hH (genericL D X eL (chartOne k X τ'))).ker =
      GaloisPi1.kernel D.H (SU D X eL (chartOne k X τ')) ∧
    Function.Surjective (D.chartHom hH (genericL D X eL (chartOne k X τ'))) := by
  have ht' : ((eL τ' : D.L) : Ω) ∈ D.L := (eL τ').2
  have htr' := transcendental_eL D X eL hk hτ'
  haveI := isGalois_K₀_of_mem (E := D.L) D.transcendental ht' htr'
  set D' := newData D ht' htr'
  let eL' : X.functionField ≃+* D'.L := eL.trans (newL D X eL hk hτ')
  have hk' : ∀ c : k, ((eL' (algebraMap k X.functionField c) : D'.L) : Ω) = algebraMap k Ω c :=
    hk
  have hτ'' : ((eL' τ' : D'.L) : Ω) = ((eL τ' : D.L) : Ω) := rfl
  have hU := isAffineOpen_chartOne (k := k) (X := X) hτ'
  let e := chartIso hU (chartOneEquiv D' X eL' hk' hτ'').toCommRingCatIso
  have hj : Spec.map (CommRingCat.ofHom eL'.toRingHom) ≫ genericToOpen _ ≫ e.hom =
      D'.genericPoint := by
    have := genericToOpen_homOfLE_chartIso (le_refl (chartOne k X τ')) hU
      (chartOneEquiv D' X eL' hk' hτ'').toCommRingCatIso
      (CommRingCat.ofHom (algebraMap D'.R D'.L)) (CommRingCat.ofHom eL'.toRingHom)
      (CommRingCat.hom_ext (RingHom.ext fun a => algebraMap_chartOneEquiv D' X eL' hk' hτ'' a))
    rwa [Scheme.homOfLE_rfl, Category.id_comp] at this
  have h : (specPoint D.L Ω ≫ genericL D X eL (chartOne k X τ')) ≫ e.hom =
      specPoint D'.R Ω := by
    have h1 : specPoint D.L Ω ≫ genericL D X eL (chartOne k X τ') =
        specPoint D'.L Ω ≫ Spec.map (CommRingCat.ofHom eL'.toRingHom) ≫ genericToOpen _ := by
      simp only [genericL, ← Category.assoc, ← Spec.map_comp]
      rfl
    rw [h1, Category.assoc, Category.assoc, hj]
    exact D'.genericPoint_comp
  refine ⟨?_, chartHom_iso_new_surjective D ht' htr' hH _ e h⟩
  rw [ker_chartHom_iso_new D ht' htr' hH _ e h,
    GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ (SU_subset_H D X eL _),
    SU_chartOne D X eL hk hH hτ']

omit [IsAlgClosed k] in
include hk hτ' hH in
theorem ker_genericL_chartOne :
    (D.chartHom hH (genericL D X eL (chartOne k X τ'))).ker =
      GaloisPi1.kernel D.H (SU D X eL (chartOne k X τ')) :=
  (genericL_chartOne_spec D X eL hk hH hτ').1

omit [IsAlgClosed k] in
include hk hτ' hH in
theorem genericL_chartOne_surjective :
    Function.Surjective (D.chartHom hH (genericL D X eL (chartOne k X τ'))) :=
  (genericL_chartOne_spec D X eL hk hH hτ').2

end Chart

section Top

variable {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)

instance nonempty_top : Nonempty ((⊤ : X.Opens) : Scheme.{u}) :=
  ⟨⟨genericPoint X, trivial⟩⟩

omit [X.Over (Spec (CommRingCat.of k))] [IsIntegral X] in
instance isIso_top_ι : IsIso (⊤ : X.Opens).ι := by
  rw [← Scheme.topIso_hom]
  infer_instance

omit [X.Over (Spec (CommRingCat.of k))] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω]
  [IsAlgClosed k] [CharZero k] [IsCurveOver k X] in
lemma specPoint_genericL_ι (U : X.Opens) [Nonempty U] :
    (specPoint D.L Ω ≫ genericL D X eL U) ≫ U.ι = specPoint D.L Ω ≫ genericLX D X eL := by
  rw [Category.assoc, genericL_ι]

omit [X.Over (Spec (CommRingCat.of k))] [IsAlgClosed k] [CharZero k] [IsCurveOver k X] in
/-- `π₁ᵉᵗ(U) → π₁ᵉᵗ(X)` intertwines the Galois actions. -/
lemma fundamentalGroupMap_ι_genericL (U : X.Opens) [Nonempty U] (σ : D.H) :
    fundamentalGroupMap U.ι (specPoint_genericL_ι D X eL U) (D.chartHom hH (genericL D X eL U) σ) =
      D.chartHom hH (genericLX D X eL) σ :=
  fundamentalGroupMap_chartHom_eq D hH _ _ _ (genericL_ι D X eL U) _ σ

omit [X.Over (Spec (CommRingCat.of k))] [IsAlgClosed k] [CharZero k] [IsCurveOver k X] in
lemma ker_genericL_top_eq :
    (D.chartHom hH (genericL D X eL ⊤)).ker = (D.chartHom hH (genericLX D X eL)).ker := by
  rw [← MonoidHom.ker_comp_of_injective _
    (fundamentalGroupMap (⊤ : X.Opens).ι (specPoint_genericL_ι D X eL ⊤)).toMonoidHom
    (fundamentalGroupMap_bijective_of_isIso _ _).1]
  exact congrArg MonoidHom.ker (MonoidHom.ext (fundamentalGroupMap_ι_genericL D X eL hH ⊤))

omit [IsAlgClosed k] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] in
lemma curveJ_basePoint' :
    (((specPoint D.L Ω ≫ curveJ D X eL hk hτ) ≫ incl₁ _ _) ≫ (chartOne k X τ).ι) ≫ 𝟙 X =
      specPoint D.L Ω ≫ genericLX D X eL := by
  rw [Category.comp_id, curveJ_basePoint, geometricGenericPoint, genericLX, ← Category.assoc,
    ← Spec.map_comp]
  rfl

omit [IsAlgClosed k] in
/-- The two-chart Galois action on `π₁ᵉᵗ(X)` is the Galois action through `Spec L ⟶ X`
(at any geometric point `η` equal to the geometric generic point). -/
lemma fundamentalGroupMap_id_curveChartHomX_galoisAction {η : Spec (.of Ω) ⟶ X}
    (hη : (((specPoint D.L Ω ≫ curveJ D X eL hk hτ) ≫ incl₁ _ _) ≫ (chartOne k X τ).ι) ≫ 𝟙 X = η)
    (h' : Spec.map (CommRingCat.ofHom (algebraMap D.L Ω)) ≫ genericLX D X eL = η) (σ : D.H) :
    fundamentalGroupMap (𝟙 X) hη
      (D.chartHomX hH (chartOne k X τ) (chartZero k X τ) (curveJ D X eL hk hτ) σ) =
      galoisAction D.L (genericLX D X eL) h' (D.toGalL (Subgroup.inclusion hH σ)) := by
  rw [GaloisData.chartHomX_apply, GaloisData.chartHom_apply,
    fundamentalGroupMap_galoisAction_eq _ (incl₁ _ _) _ rfl rfl rfl (Category.assoc _ _ _).symm,
    fundamentalGroupMap_galoisAction_eq _ (chartOne k X τ).ι _ rfl _ rfl
      (by simp only [Category.assoc]),
    fundamentalGroupMap_galoisAction_eq _ (𝟙 X) (genericLX D X eL) _ _ _ h']
  simp [curveJ, genericLX]

omit [IsAlgClosed k] in
/-- The two-chart Galois action on `π₁ᵉᵗ(X)` is the Galois action through `Spec L ⟶ X`. -/
lemma fundamentalGroupMap_id_curveChartHomX (σ : D.H) :
    fundamentalGroupMap (𝟙 X) (curveJ_basePoint' D X eL hk hτ)
      (D.chartHomX hH (chartOne k X τ) (chartZero k X τ) (curveJ D X eL hk hτ) σ) =
      D.chartHom hH (genericLX D X eL) σ :=
  fundamentalGroupMap_id_curveChartHomX_galoisAction D X eL hk hH hτ _ rfl σ

omit [IsAlgClosed k] in
include hk hτ in
/-- **`π₁ᵉᵗ(X)` in the Galois model**: the Galois action `H → π₁ᵉᵗ(⊤)` has kernel
`⟨⟨S_X⟩⟩ = ⟨⟨SAll D⟩⟩`. -/
theorem ker_genericL_top :
    (D.chartHom hH (genericL D X eL ⊤)).ker = GaloisPi1.kernel D.H (SU D X eL ⊤) := by
  have h1 : (D.chartHomX hH (chartOne k X τ) (chartZero k X τ) (curveJ D X eL hk hτ)).ker =
      (D.chartHom hH (genericLX D X eL)).ker := by
    rw [← MonoidHom.ker_comp_of_injective
      (D.chartHomX hH (chartOne k X τ) (chartZero k X τ) (curveJ D X eL hk hτ))
      (fundamentalGroupMap (𝟙 X) (curveJ_basePoint' D X eL hk hτ)).toMonoidHom
      (fundamentalGroupMap_bijective_of_isIso _ _).1]
    exact congrArg MonoidHom.ker
      (MonoidHom.ext (fundamentalGroupMap_id_curveChartHomX D X eL hk hH hτ))
  rw [SU_top D X eL hk hτ, ker_genericL_top_eq, ← h1, ker_curveChartHomX D X eL hk hτ hH]

omit [IsAlgClosed k] in
include hk hτ in
theorem genericL_top_surjective : Function.Surjective (D.chartHom hH (genericL D X eL ⊤)) := by
  intro y
  obtain ⟨z, hz⟩ := (fundamentalGroupMap_bijective_of_isIso (𝟙 X)
    (curveJ_basePoint' D X eL hk hτ)).2
      (fundamentalGroupMap (⊤ : X.Opens).ι (specPoint_genericL_ι D X eL ⊤) y)
  obtain ⟨σ, rfl⟩ := curveChartHomX_surjective D X eL hk hτ hH z
  refine ⟨σ, (fundamentalGroupMap_bijective_of_isIso (⊤ : X.Opens).ι
    (specPoint_genericL_ι D X eL ⊤)).1 ?_⟩
  rw [fundamentalGroupMap_ι_genericL, ← fundamentalGroupMap_id_curveChartHomX D X eL hk hH hτ,
    hz]

end Top

section General

variable {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)

omit [IsAlgClosed k] in
include hk hτ hH in
/-- **`π₁ᵉᵗ(U)` in the Galois model**: for a nonempty open `U` of the curve `X` with finite
complement, the intrinsic Galois action `H → π₁ᵉᵗ(U)` through the generic point is surjective
with kernel `⟨⟨S_U⟩⟩`. -/
theorem genericL_spec (U : X.Opens) [Nonempty U] (hU : (U : Set X)ᶜ.Finite) :
    (D.chartHom hH (genericL D X eL U)).ker = GaloisPi1.kernel D.H (SU D X eL U) ∧
    Function.Surjective (D.chartHom hH (genericL D X eL U)) := by
  by_cases htop : U = ⊤
  · subst htop
    exact ⟨ker_genericL_top D X eL hk hH hτ, genericL_top_surjective D X eL hk hH hτ⟩
  · obtain ⟨τ', hτ', rfl⟩ := exists_chartOne_eq k U hU htop
    exact genericL_chartOne_spec D X eL hk hH hτ'

omit [IsAlgClosed k] in
/-- **SGA 1 V.8.2 for open subschemes of a curve**: `π₁ᵉᵗ(U) ≃ₜ* H ⧸ ⟨⟨S_U⟩⟩` at the geometric
generic point of `U`, for `U ⊆ X` nonempty open with finite complement. The inverse is induced
by the intrinsic Galois action (`etalePi1OpenEquiv_symm_mk`); the isomorphisms are natural in `U`
(`etalePi1OpenEquiv_fundamentalGroupMap`), and for `U = X` it is `etalePi1EquivPiX`
(`etalePi1EquivPiX_fundamentalGroupMap_top`). -/
def etalePi1OpenEquiv (U : X.Opens) [Nonempty U] (hU : (U : Set X)ᶜ.Finite) :
    π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) ≃ₜ* GaloisPi1.pi1 D.H (SU D X eL U) D.isClosed_H :=
  GaloisPi1.equivOfSurjective D.H D.isClosed_H (SU D X eL U) (D.chartHom hH (genericL D X eL U))
    (D.continuous_chartHom hH _) (genericL_spec D X eL hk hH hτ U hU).2
    (genericL_spec D X eL hk hH hτ U hU).1

omit [IsAlgClosed k] in
lemma etalePi1OpenEquiv_symm_mk (U : X.Opens) [Nonempty U] (hU : (U : Set X)ᶜ.Finite)
    (σ : D.H) :
    (etalePi1OpenEquiv D X eL hk hH hτ U hU).symm (σ : D.H ⧸ GaloisPi1.kernel D.H (SU D X eL U)) =
      D.chartHom hH (genericL D X eL U) σ :=
  rfl

omit [IsAlgClosed k] in
lemma etalePi1OpenEquiv_chartHom (U : X.Opens) [Nonempty U] (hU : (U : Set X)ᶜ.Finite)
    (σ : D.H) :
    etalePi1OpenEquiv D X eL hk hH hτ U hU (D.chartHom hH (genericL D X eL U) σ) =
      (σ : D.H ⧸ GaloisPi1.kernel D.H (SU D X eL U)) := by
  rw [← etalePi1OpenEquiv_symm_mk D X eL hk hH hτ U hU σ, ContinuousMulEquiv.apply_symm_apply]

omit [IsAlgClosed k] in
/-- **Naturality in `U ⊆ V`**: under `etalePi1OpenEquiv`, the map `π₁ᵉᵗ(U) → π₁ᵉᵗ(V)` induced by
the inclusion is the quotient map `H ⧸ ⟨⟨S_U⟩⟩ ↠ H ⧸ ⟨⟨S_V⟩⟩`. -/
theorem etalePi1OpenEquiv_fundamentalGroupMap {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hU : (U : Set X)ᶜ.Finite) (hV : (V : Set X)ᶜ.Finite) (h : U ≤ V)
    (γ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)) :
    etalePi1OpenEquiv D X eL hk hH hτ V hV
        (fundamentalGroupMap (X.homOfLE h) (specPoint_genericL_homOfLE D X eL h) γ) =
      GaloisPi1.pi1Map D.isClosed_H D.isClosed_H le_rfl (SU_mono D X eL h)
        (etalePi1OpenEquiv D X eL hk hH hτ U hU γ) := by
  obtain ⟨σ, rfl⟩ := (genericL_spec D X eL hk hH hτ U hU).2 γ
  rw [fundamentalGroupMap_genericL, etalePi1OpenEquiv_chartHom D X eL hk hH hτ V hV,
    etalePi1OpenEquiv_chartHom D X eL hk hH hτ U hU, GaloisPi1.pi1Map_mk]
  rfl

omit [IsAlgClosed k] in
include hk hτ in
/-- **Filling in cusps, scheme form**: for `U ⊆ V` (nonempty, finite complements), the kernel of
`π₁ᵉᵗ(U) → π₁ᵉᵗ(V)` is the closed normal subgroup generated by the images of the inertia elements
at the places centred on `V` but not on `U` (the places over `V ∖ U`). -/
theorem ker_fundamentalGroupMap_homOfLE {U V : X.Opens} [Nonempty U] [Nonempty V]
    (hU : (U : Set X)ᶜ.Finite) (hV : (V : Set X)ᶜ.Finite) (h : U ≤ V) :
    (fundamentalGroupMap (X.homOfLE h) (specPoint_genericL_homOfLE D X eL h)).toMonoidHom.ker =
      (Subgroup.normalClosure (D.chartHom hH (genericL D X eL U) ''
        (Subtype.val ⁻¹' (SU D X eL V \ SU D X eL U) : Set D.H))).topologicalClosure := by
  haveI := GaloisPi1.compactSpace_of_isClosed D.H D.isClosed_H
  have hU' := genericL_spec D X eL hk hH hτ U hU
  have hV' := genericL_spec D X eL hk hH hτ V hV
  have hker : ((fundamentalGroupMap (X.homOfLE h)
      (specPoint_genericL_homOfLE D X eL h)).toMonoidHom.comp
        (D.chartHom hH (genericL D X eL U))).ker =
      (Subgroup.normalClosure (Subtype.val ⁻¹' SU D X eL V : Set D.H)).topologicalClosure := by
    rw [← GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _ (SU_subset_H D X eL V), ← hV'.1]
    exact congrArg MonoidHom.ker (MonoidHom.ext (fundamentalGroupMap_genericL D X eL hH h))
  rw [MonoidHom.ker_eq_topologicalClosure_normalClosure_image _ (D.continuous_chartHom hH _)
    hU'.2 _ _ hker]
  congr 1
  apply le_antisymm
  · refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨σ, hσ, rfl⟩
    by_cases hσU : (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ SU D X eL U
    · have : D.chartHom hH (genericL D X eL U) σ = 1 := by
        rw [← MonoidHom.mem_ker, hU'.1, GaloisPi1.kernel_eq_topologicalClosure _ D.isClosed_H _
          (SU_subset_H D X eL U)]
        exact Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure hσU)
      rw [this]
      exact Subgroup.one_mem _
    · exact Subgroup.subset_normalClosure ⟨σ, ⟨hσ, hσU⟩, rfl⟩
  · exact Subgroup.normalClosure_mono (Set.image_mono fun σ hσ ↦ hσ.1)

omit [X.Over (Spec (CommRingCat.of k))] [IsIntegral X] [IsAlgClosed k] [CharZero k]
  [IsCurveOver k X] [IsSepClosed Ω] [IsGalois (K₀ k t) Ω] in
lemma fundamentalGroupCongr_eq {Y : Scheme.{u}} {x₁ x₂ : Spec (.of Ω) ⟶ Y} (h : x₁ = x₂)
    (h' : x₁ ≫ 𝟙 Y = x₂) (γ : π₁ᵉᵗ(x₁)) :
    fundamentalGroupCongr h γ = fundamentalGroupMap (𝟙 Y) h' γ := by
  subst h
  rw [fundamentalGroupMap_id]
  rfl

omit [X.Over (Spec (CommRingCat.of k))] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] [IsAlgClosed k]
  [CharZero k] [IsCurveOver k X] in
lemma specPoint_genericL_top_ι :
    (specPoint D.L Ω ≫ genericL D X eL ⊤) ≫ (⊤ : X.Opens).ι = geometricGenericPoint D X eL := by
  rw [specPoint_genericL_ι, genericLX, geometricGenericPoint, ← Category.assoc, ← Spec.map_comp]
  rfl

omit [IsAlgClosed k] in
/-- **The proper case**: `etalePi1EquivPiX` (`π₁ᵉᵗ(X) ≃ₜ* H ⧸ ⟨⟨SAll D⟩⟩`) is
`etalePi1OpenEquiv` for `U = X` (`S_X = SAll D`, `SU_top`), through `π₁ᵉᵗ(⊤) ≅ π₁ᵉᵗ(X)`. -/
theorem etalePi1EquivPiX_fundamentalGroupMap_top
    (γ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤)) :
    etalePi1EquivPiX D X eL hk hτ hH
        (fundamentalGroupMap (⊤ : X.Opens).ι (specPoint_genericL_top_ι D X eL) γ) =
      GaloisPi1.pi1Map D.isClosed_H D.isClosed_H le_rfl (SU_top D X eL hk hτ).le
        (etalePi1OpenEquiv D X eL hk hH hτ ⊤ (by simp) γ) := by
  obtain ⟨σ, rfl⟩ := genericL_top_surjective D X eL hk hH hτ γ
  rw [etalePi1OpenEquiv_chartHom D X eL hk hH hτ ⊤ (by simp), GaloisPi1.pi1Map_mk]
  apply (etalePi1EquivPiX D X eL hk hτ hH).symm.injective
  rw [ContinuousMulEquiv.symm_apply_apply]
  change _ = (fundamentalGroupCongr (curveJ_basePoint D X eL hk hτ))
    (D.chartHomX hH (chartOne k X τ) (chartZero k X τ) (curveJ D X eL hk hτ) σ)
  have h' : Spec.map (CommRingCat.ofHom (algebraMap D.L Ω)) ≫ genericLX D X eL =
      geometricGenericPoint D X eL := by
    rw [← specPoint_genericL_top_ι, specPoint_genericL_ι]
  rw [fundamentalGroupCongr_eq _ (by rw [Category.comp_id, curveJ_basePoint]),
    fundamentalGroupMap_id_curveChartHomX_galoisAction D X eL hk hH hτ _ h',
    GaloisData.chartHom_apply,
    fundamentalGroupMap_galoisAction_eq _ _ (genericLX D X eL) (genericL_ι D X eL ⊤) rfl _ h']

