import CurvesJacobian.Galois.PicTorsion
import ContinuousKummerTheory.Curve.Decomposition

/-!
# Unramified Kummer classes are the characters of `Π_X`

Setting of `Galois/PicTorsion.lean` (`D : GaloisData k t`, `F = Ω^H`, `char k = 0`, `k`
algebraically closed). Let

* `CurvesJacobian.SAll D ⊆ H`: the elements of `H` lying in the inertia group of some place
  `W ⊇ k` of `Ω` (all places of `F`, cusps included);
* `Π_X = H ⧸ ⟨⟨SAll D⟩⟩` (`GaloisPi1.kernel D.H (SAll D)`, the closed normal subgroup generated by
  `SAll D`): pi1's Galois model of the fundamental group of the proper curve `X` with function
  field `F` (SGA 1 V.8.2).

Since `μₙ ⊆ k ⊆ F` is fixed by `Gal(Ω/F)`, classes in `H¹(Gal(Ω/F), μₙ)` are continuous
characters, and:

* `CurvesJacobian.unramifiedCharsEquiv D n :
    unramifiedChars D n ≃* ContinuousMonoidHom (D.H ⧸ GaloisPi1.kernel D.H (SAll D)) (Mu n Ω)`;
* `CurvesJacobian.picTorsionEquivPiChars D n :
    Pic(F)[n] ≃+ Additive (ContinuousMonoidHom Π_X μₙ)` (with `picTorsionEquivUnramified`).

Identifying `Π_X` with `π₁ᵉᵗ` of the proper scheme `X` is not done here (pi1 track).
-/

open KummerTheory Curve AffOrbicurve WeilCurves.FunctionField

set_option linter.unusedSectionVars false

namespace CurvesJacobian

universe u

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  (D : Pi1.Orbifold.GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω]
  (n : ℕ) [NeZero n]

/-- The elements of `H` lying in the inertia group of some place `W ⊇ k` of `Ω`. -/
def SAll : Set (Ω ≃ₐ[K₀ k t] Ω) :=
  {σ | σ ∈ D.H ∧ ∃ W : ValuationSubring Ω, (∀ c : k, algebraMap k Ω c ∈ W) ∧
    σ ∈ GaloisPi1.inertia W}

/-- `Π_X`: `H` modulo the closed normal subgroup generated by all inertia groups. -/
abbrev PiX : Type u := D.H ⧸ GaloisPi1.kernel D.H (SAll D)

variable [IsAlgClosed k]

/-- `Gal(Ω/F)` acts trivially on `μₙ` (`μₙ ⊆ k`). -/
lemma galF_smul_mu (g : Ω ≃ₐ[F D] Ω) (ζ : Mu n Ω) : g • ζ = ζ := by
  apply Mu.ext
  apply Units.ext
  rw [Mu.val_smul_coe]
  have hζ : ((Mu.val ζ : Ωˣ) : Ω) ^ n = 1 := by
    rw [← Units.val_pow_eq_pow_val, Mu.val_pow_n, Units.val_one]
  obtain ⟨c, hc⟩ := exists_algebraMap_eq_of_isAlgebraic (k := k)
    (⟨Polynomial.X ^ n - 1, Polynomial.X_pow_sub_C_ne_zero (Nat.pos_of_ne_zero (NeZero.ne n)) 1,
      by simp [hζ]⟩ : IsAlgebraic k ((Mu.val ζ : Ωˣ) : Ω))
  rw [← hc, IsScalarTower.algebraMap_apply k (F D) Ω, AlgEquiv.commutes]

/-- `H` acts trivially on `μₙ`. -/
lemma H_smul_mu (σ : D.H) (ζ : Mu n Ω) : σ • ζ = ζ := by
  rw [← toGalF_smul_mu]
  exact galF_smul_mu D n _ ζ

/-- The character of `H` attached to a class `χ`: `σ ↦ χ(σ)` (well defined as `H` acts
trivially on `μₙ`). -/
noncomputable def charOfH (χ : ContH1 (Ω ≃ₐ[F D] Ω) (Mu n Ω)) : D.H →* Mu n Ω where
  toFun σ := ContH1.evalTriv σ (H_smul_mu D n σ) (resMu D n χ)
  map_one' := by
    induction χ using ContH1.induction_on with
    | h c => exact ContH1.map_one_eq _
  map_mul' σ τ := by
    induction χ using ContH1.induction_on with
    | h c =>
      change (c : (Ω ≃ₐ[F D] Ω) → Mu n Ω) (toGalF D (σ * τ)) =
        (c : (Ω ≃ₐ[F D] Ω) → Mu n Ω) (toGalF D σ) * (c : (Ω ≃ₐ[F D] Ω) → Mu n Ω) (toGalF D τ)
      rw [map_mul, ContH1.isMulCocycle₁ c, galF_smul_mu, mul_comm]

lemma charOfH_mk (c : ContH1.cocycles (Ω ≃ₐ[F D] Ω) (Mu n Ω)) (σ : D.H) :
    charOfH D n (ContH1.mk c) σ = (c : (Ω ≃ₐ[F D] Ω) → Mu n Ω) (toGalF D σ) :=
  rfl

lemma continuous_charOfH (χ : ContH1 (Ω ≃ₐ[F D] Ω) (Mu n Ω)) : Continuous (charOfH D n χ) := by
  induction χ using ContH1.induction_on with
  | h c => exact (ContH1.continuous c).comp (continuous_toGalF (D := D))

set_option maxHeartbeats 1000000 in
-- closure computations in the Krull topology of `Gal(Ω/k(t))` are slow to elaborate
/-- An unramified class kills all inertia, hence the kernel of `H → Π_X`. -/
lemma kernel_le_ker_charOfH (χ : unramifiedChars D n) :
    GaloisPi1.kernel D.H (SAll D) ≤ (charOfH D n χ).ker := by
  intro σ hσ
  -- the subgroup of the ambient group of elements of `H` killed by the character
  let K : Subgroup (Ω ≃ₐ[K₀ k t] Ω) := (charOfH D n χ).ker.map D.H.subtype
  have hKclosed : IsClosed (K : Set (Ω ≃ₐ[K₀ k t] Ω)) := by
    have h1 : IsClosed ((charOfH D n χ).ker : Set D.H) :=
      (isClosed_discrete ({1} : Set (Mu n Ω))).preimage (continuous_charOfH D n χ)
    have h2 := (D.isClosed_H.isClosedEmbedding_subtypeVal).isClosed_iff_image_isClosed.1 h1
    have hK : (K : Set (Ω ≃ₐ[K₀ k t] Ω)) = Subtype.val '' ((charOfH D n χ).ker : Set D.H) := by
      rw [Subgroup.coe_map]; rfl
    rw [hK]
    exact h2
  have hconj : GaloisPi1.conjSet D.H (SAll D) ⊆ K := by
    rintro _ ⟨h, hh, s, ⟨hsH, W, hk, hsW⟩, rfl⟩
    refine ⟨⟨h, hh⟩ * ⟨s, hsH⟩ * ⟨h, hh⟩⁻¹, ?_, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker, map_mul, map_mul, mul_comm, ← mul_assoc, map_inv,
      inv_mul_cancel, one_mul]
    exact χ.2 W hk ⟨s, hsH⟩ hsW
  have hle : GaloisPi1.ambientKernel D.H (SAll D) ≤ K :=
    Subgroup.topologicalClosure_minimal _ ((Subgroup.closure_le K).2 hconj) hKclosed
  have hσ' : (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ GaloisPi1.ambientKernel D.H (SAll D) :=
    Subgroup.mem_subgroupOf.1 hσ
  obtain ⟨τ, hτ, hτσ⟩ := Subgroup.mem_map.1 (hle hσ')
  have hτ' : charOfH D n χ τ = 1 := hτ
  have : τ = σ := Subtype.ext hτσ
  rw [MonoidHom.mem_ker, ← this]
  exact hτ'

/-- The character of `Π_X` attached to an unramified class. -/
noncomputable def charOfPiX (χ : unramifiedChars D n) : ContinuousMonoidHom (PiX D) (Mu n Ω) :=
  { QuotientGroup.lift _ (charOfH D n χ) (kernel_le_ker_charOfH D n χ) with
    continuous_toFun := by
      refine (QuotientGroup.isQuotientMap_mk _).continuous_iff.2 ?_
      exact continuous_charOfH D n χ }

lemma charOfPiX_mk (χ : unramifiedChars D n) (σ : D.H) :
    charOfPiX D n χ (QuotientGroup.mk σ) = charOfH D n χ σ :=
  rfl

/-- The class attached to a character of `Π_X`. -/
noncomputable def classOfPiX (φ : ContinuousMonoidHom (PiX D) (Mu n Ω)) :
    ContH1 (Ω ≃ₐ[F D] Ω) (Mu n Ω) :=
  ContH1.mk (ContH1.mkCocycle (fun τ ↦ φ (QuotientGroup.mk (ofGalF D τ)))
    (φ.continuous.comp (QuotientGroup.continuous_mk.comp (continuous_ofGalF D)))
    (fun g h ↦ by
      change φ (QuotientGroup.mk (ofGalF D (g * h))) =
        g • φ (QuotientGroup.mk (ofGalF D h)) * φ (QuotientGroup.mk (ofGalF D g))
      rw [galF_smul_mu, map_mul (ofGalF D), QuotientGroup.mk_mul, map_mul φ, mul_comm]))

set_option synthInstance.maxHeartbeats 200000 in
-- the group structure on the quotient `PiX D` takes long to synthesize
lemma classOfPiX_mem (φ : ContinuousMonoidHom (PiX D) (Mu n Ω)) :
    classOfPiX D n φ ∈ unramifiedChars D n := by
  intro W hk σ hσ
  change φ (QuotientGroup.mk (ofGalF D (toGalF D σ))) = 1
  have hσ' : ofGalF D (toGalF D σ) = σ := (galFEquiv D).symm_apply_apply σ
  have hmemN : σ ∈ GaloisPi1.kernel D.H (SAll D) :=
    Subgroup.mem_subgroupOf.2 (Subgroup.le_topologicalClosure _ (Subgroup.subset_closure
      ⟨1, D.H.one_mem, σ, ⟨σ.2, W, hk, hσ⟩, by simp⟩))
  have hmk : (QuotientGroup.mk σ : PiX D) = 1 := (QuotientGroup.eq_one_iff σ).2 hmemN
  rw [hσ', hmk, map_one]

/-- **Unramified classes are the continuous characters of `Π_X`.** -/
noncomputable def unramifiedCharsEquiv :
    unramifiedChars D n ≃* ContinuousMonoidHom (PiX D) (Mu n Ω) where
  toFun := charOfPiX D n
  invFun φ := ⟨classOfPiX D n φ, classOfPiX_mem D n φ⟩
  left_inv χ := by
    obtain ⟨χ, hχ⟩ := χ
    induction χ using ContH1.induction_on with
    | h c =>
      apply Subtype.ext
      change ContH1.mk _ = ContH1.mk c
      congr 1
      apply Subtype.ext
      funext τ
      change charOfH D n (ContH1.mk c) (ofGalF D τ) = _
      rw [charOfH_mk, toGalF_ofGalF]
  right_inv φ := by
    refine ContinuousMonoidHom.ext fun x ↦ ?_
    induction x using QuotientGroup.induction_on with
    | H σ =>
      change charOfH D n (classOfPiX D n φ) σ = φ (QuotientGroup.mk σ)
      unfold classOfPiX
      rw [charOfH_mk]
      change φ (QuotientGroup.mk (ofGalF D (toGalF D σ))) = _
      rw [show ofGalF D (toGalF D σ) = σ from (galFEquiv D).symm_apply_apply σ]
  map_mul' a b := by
    refine ContinuousMonoidHom.ext fun x ↦ ?_
    induction x using QuotientGroup.induction_on with
    | H σ =>
      change charOfH D n (a * b : unramifiedChars D n) σ =
        charOfH D n a σ * charOfH D n b σ
      simp only [charOfH, MonoidHom.coe_mk, OneHom.coe_mk, Subgroup.coe_mul, map_mul]

attribute [local instance] isFunctionField_F

/-- **`Pic(X)[n] ≃ Hom_cont(Π_X, μₙ)`** (Galois model, `k` algebraically closed of
characteristic `0`). -/
noncomputable def picTorsionEquivPiChars (hn : 0 < n) :
    picTorsion k (F D) n ≃+ Additive (ContinuousMonoidHom (PiX D) (Mu n Ω)) :=
  (picTorsionEquivUnramified D hn).trans (unramifiedCharsEquiv D n).toAdditive

end CurvesJacobian
