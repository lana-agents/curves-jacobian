import CurvesJacobian.Galois.FunctionFieldF
import Pi1.Orbifold.EtaleTwoCharts

/-!
# Changing the coordinate of the Galois model

Let `D : GaloisData k t` with `H = H_L` (`hH : D.H ≤ D.HL`) and `L = Ω^{H_L}`. For any
`t' ∈ L` transcendental over `k`, the field `L` is finite over `k(t')`
(`CurvesJacobian.finiteDimensional_extendK₀`, by weil-curves: a function field of one variable
is finite over `k(s)` for every transcendental `s`), and `Ω` is Galois over `k(t')`
(`CurvesJacobian.isGalois_K₀_of_mem`). We get Galois data
`CurvesJacobian.newData D ht' htr' : GaloisData k t'` with `H' = H'_L = Gal(Ω / L) ≤ Gal(Ω / k(t'))`
and the same function field `L` (`mem_newData_L`); its coordinate ring is the integral closure
of `k[t']` in `L`. Unlike pi1's `GaloisData.transfer`, `k(t')` may be a proper subfield of `k(t)`
or not comparable with it.

* `CurvesJacobian.toNew : D.H →* (newData D ht' htr').H` and `fromNew`: mutually inverse
  continuous isomorphisms (both are `σ ↦ σ` on `Ω`);
* `CurvesJacobian.comap_kernel_newData`: the inertia elements of `newData` correspond to
  `D.Sat t'` (inertia elements at the places of `Ω` containing `k` and `t'`);
* `CurvesJacobian.ker_chartHom_comp_iso_new`, `chartHom_comp_iso_new_surjective`: for a scheme
  `Z ≅ Spec R'` (`R'` the integral closure of `k[t']` in `L`) compatibly with the geometric
  generic points, the intrinsic Galois action `H → π₁ᵉᵗ(Z)` is surjective with kernel the closed
  normal subgroup generated by `D.Sat t'`.
-/

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale
open Pi1.Orbifold AffOrbicurve WeilCurves.FunctionField

universe u

noncomputable section

namespace CurvesJacobian

section Field

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t t' : Ω}
  {E : IntermediateField (K₀ k t) Ω}

lemma isScalarTower_k_E_Ω : IsScalarTower k E Ω :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

/-- A finite extension of `k(t)` (`t` transcendental) is a function field of one variable. -/
theorem isFunctionField_of_finite [FiniteDimensional (K₀ k t) E] (htr : Transcendental k t) :
    IsFunctionField k E := by
  haveI := isScalarTower_k_E_Ω (E := E)
  set s : E := algebraMap (K₀ k t) E ⟨t, IntermediateField.mem_adjoin_simple_self k t⟩
  have hs : Transcendental k s := by
    have h : Transcendental k ((s : E) : Ω) := htr
    exact (transcendental_algebraMap_iff (algebraMap E Ω).injective).1 h
  refine ⟨⟨s, hs, ?_⟩⟩
  set A : IntermediateField k E := IntermediateField.adjoin k {s}
  have hmem : ∀ x : K₀ k t, algebraMap (K₀ k t) E x ∈ A := by
    intro x
    have hx : (x : Ω) ∈ (K₀ k t) := x.2
    have hle : (K₀ k t) ≤ (A.map (IntermediateField.val E |>.restrictScalars k)) := by
      rw [IntermediateField.adjoin_simple_le_iff]
      exact ⟨s, IntermediateField.mem_adjoin_simple_self k _, rfl⟩
    obtain ⟨y, hy, hyx⟩ := hle hx
    have : y = algebraMap (K₀ k t) E x := Subtype.ext hyx
    exact this ▸ hy
  letI : Algebra (K₀ k t) A :=
    ((algebraMap (K₀ k t) E).codRestrict A.toSubalgebra hmem).toAlgebra
  haveI : IsScalarTower (K₀ k t) A E := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  exact Module.Finite.of_restrictScalars_finite (K₀ k t) A E

lemma K₀_le_of_mem (ht' : t' ∈ E) : K₀ k t' ≤ E.restrictScalars k :=
  IntermediateField.adjoin_simple_le_iff.2 ht'

variable (E) in
/-- `E` seen as an intermediate field of `Ω / k(t')`, for `t' ∈ E`. -/
def extendK₀ (ht' : t' ∈ E) : IntermediateField (K₀ k t') Ω :=
  IntermediateField.extendScalars (K₀_le_of_mem ht')

@[simp] lemma mem_extendK₀ (ht' : t' ∈ E) (x : Ω) : x ∈ extendK₀ E ht' ↔ x ∈ E := Iff.rfl

/-- **`L` is finite over `k(t')`** for every `t' ∈ L` transcendental over `k`. -/
theorem finiteDimensional_extendK₀ [FiniteDimensional (K₀ k t) E] (htr : Transcendental k t)
    (ht' : t' ∈ E) (htr' : Transcendental k t') :
    FiniteDimensional (K₀ k t') (extendK₀ E ht') := by
  haveI := isScalarTower_k_E_Ω (E := E)
  haveI := isFunctionField_of_finite (E := E) htr
  set s : E := ⟨t', ht'⟩
  have hs : Transcendental k s := by
    have h : Transcendental k ((s : E) : Ω) := htr'
    exact (transcendental_algebraMap_iff (algebraMap E Ω).injective).1 h
  haveI := finiteDimensional_adjoin hs
  -- `k⟮s⟯ ⊆ E` maps into `k(t') ⊆ Ω`
  have hmap : ∀ c : IntermediateField.adjoin k {s}, ((c : E) : Ω) ∈ K₀ k t' := by
    intro c
    have h1 : (IntermediateField.val E).restrictScalars k (c : E) ∈
        (IntermediateField.adjoin k {s}).map ((IntermediateField.val E).restrictScalars k) :=
      ⟨c, c.2, rfl⟩
    rw [IntermediateField.adjoin_map, Set.image_singleton] at h1
    exact h1
  let ψ : IntermediateField.adjoin k {s} → K₀ k t' := fun c ↦ ⟨((c : E) : Ω), hmap c⟩
  let φ : E → extendK₀ E ht' := fun e ↦ ⟨(e : Ω), e.2⟩
  obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := IntermediateField.adjoin k {s}) (M := E)
  classical
  refine ⟨⟨S.image φ, ?_⟩⟩
  rw [eq_top_iff]
  rintro y -
  have key : ∀ e : E, e ∈ Submodule.span (IntermediateField.adjoin k {s}) (S : Set E) →
      φ e ∈ Submodule.span (K₀ k t') ((S.image φ : Finset _) : Set (extendK₀ E ht')) := by
    intro e he
    induction he using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_image_of_mem φ hx))
    | zero => exact (show φ 0 = 0 from rfl) ▸ Submodule.zero_mem _
    | add x y _ _ hx hy => exact (show φ (x + y) = φ x + φ y from rfl) ▸ Submodule.add_mem _ hx hy
    | smul c x _ hx =>
      have : φ (c • x) = ψ c • φ x := rfl
      rw [this]
      exact Submodule.smul_mem _ _ hx
  have := key ⟨(y : Ω), y.2⟩ (hS ▸ Submodule.mem_top)
  exact this

end Field

section Galois

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t t' : Ω}

/-- The inclusion `k(t) → M` for an intermediate field `M` of `Ω / k(t')` containing `k(t)`. -/
def inclK₀ (M : IntermediateField (K₀ k t') Ω) (hle : ∀ c : K₀ k t, (c : Ω) ∈ M) :
    K₀ k t →+* M where
  toFun c := ⟨(c : Ω), hle c⟩
  map_one' := Subtype.ext rfl
  map_mul' _ _ := Subtype.ext rfl
  map_zero' := Subtype.ext rfl
  map_add' _ _ := Subtype.ext rfl

lemma isIntegral_of_le (M : IntermediateField (K₀ k t') Ω) (hle : ∀ c : K₀ k t, (c : Ω) ∈ M)
    {ω : Ω} (hω : IsIntegral (K₀ k t) ω) : IsIntegral M ω := by
  obtain ⟨p, hpm, hp⟩ := hω
  refine ⟨p.map (inclK₀ M hle), hpm.map _, ?_⟩
  have hc : (algebraMap M Ω).comp (inclK₀ M hle) = algebraMap (K₀ k t) Ω :=
    RingHom.ext fun _ ↦ rfl
  rw [Polynomial.eval₂_map, hc]
  exact hp

/-- Elements of `Ω` integral over `k(t)` are integral over `k(t')` if `k(t)` lies in an
intermediate field finite over `k(t')`. -/
lemma isIntegral_of_le_finite (M : IntermediateField (K₀ k t') Ω) [FiniteDimensional (K₀ k t') M]
    (hle : ∀ c : K₀ k t, (c : Ω) ∈ M) {ω : Ω} (hω : IsIntegral (K₀ k t) ω) :
    IsIntegral (K₀ k t') ω := by
  haveI : Algebra.IsIntegral (K₀ k t') M := Algebra.IsIntegral.of_finite _ _
  exact isIntegral_trans (R := K₀ k t') (A := M) ω (isIntegral_of_le M hle hω)

/-- **`Ω` is Galois over `k(t')`** for `t'` transcendental in a finite extension `E` of `k(t)`
(char. `0`, `Ω` separably closed and Galois over `k(t)`). -/
theorem isGalois_K₀_of_mem [CharZero k] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω]
    {E : IntermediateField (K₀ k t) Ω} [FiniteDimensional (K₀ k t) E]
    (htr : Transcendental k t) (ht' : t' ∈ E) (htr' : Transcendental k t') :
    IsGalois (K₀ k t') Ω := by
  haveI := finiteDimensional_extendK₀ htr ht' htr'
  haveI : Algebra.IsIntegral (K₀ k t') Ω := ⟨fun ω ↦ isIntegral_of_le_finite (extendK₀ E ht')
    (fun c ↦ E.algebraMap_mem c) (Algebra.IsIntegral.isIntegral (R := K₀ k t) ω)⟩
  haveI : Algebra.IsSeparable (K₀ k t') Ω := Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : IsSepClosure (K₀ k t') Ω := ⟨inferInstance, inferInstance⟩
  infer_instance

end Galois

section NewData

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t t' : Ω}
  [IsGalois (K₀ k t) Ω] (D : GaloisData k t) (ht' : t' ∈ D.L) (htr' : Transcendental k t')

/-- **Galois data for a new coordinate** `t' ∈ L`: `H' = H'_L = Gal(Ω / L) ≤ Gal(Ω / k(t'))`. -/
def newData : GaloisData k t' :=
  haveI := finiteDimensional_extendK₀ D.transcendental ht' htr'
  { H := (extendK₀ D.L ht').fixingSubgroup
    HL := (extendK₀ D.L ht').fixingSubgroup
    le := le_rfl
    isOpen_HL := IntermediateField.fixingSubgroup_isOpen _
    conj_mem := fun _ hh _ hn ↦ mul_mem (mul_mem hh hn) (inv_mem hh)
    transcendental := htr' }

lemma newData_H_le : (newData D ht' htr').H ≤ (newData D ht' htr').HL := le_rfl

lemma fix_of_mem_newData_H (σ : (newData D ht' htr').H) {x : Ω} (hx : x ∈ D.L) :
    (σ : Ω ≃ₐ[K₀ k t'] Ω) x = x :=
  (IntermediateField.mem_fixingSubgroup_iff _ _).1 σ.2 x hx

/-- `newData` has the same function field `L`. -/
lemma mem_newData_L [IsGalois (K₀ k t') Ω] (x : Ω) : x ∈ (newData D ht' htr').L ↔ x ∈ D.L := by
  change x ∈ IntermediateField.fixedField (extendK₀ D.L ht').fixingSubgroup ↔ _
  rw [InfiniteGalois.fixedField_fixingSubgroup]
  rfl

omit [IsGalois (K₀ k t) Ω] in
variable {D} in
lemma fix_of_mem_H (hH : D.H ≤ D.HL) (σ : D.H) {x : Ω} (hx : x ∈ D.L) :
    (σ : Ω ≃ₐ[K₀ k t] Ω) x = x :=
  (IntermediateField.mem_fixedField_iff _ _).1 hx _ (hH σ.2)

variable (hH : D.H ≤ D.HL)

/-- `H ≅ H'`: an element of `H = Gal(Ω / L)` seen as an automorphism over `k(t')`. -/
def toNew : D.H →* (newData D ht' htr').H where
  toFun σ := ⟨AlgEquiv.ofRingEquiv (f := (σ : Ω ≃ₐ[K₀ k t] Ω).toRingEquiv)
      (fun c ↦ fix_of_mem_H hH σ (K₀_le_of_mem ht' c.2)),
    (IntermediateField.mem_fixingSubgroup_iff _ _).2 fun _ hx ↦ fix_of_mem_H hH σ hx⟩
  map_one' := Subtype.ext (AlgEquiv.ext fun _ ↦ rfl)
  map_mul' _ _ := Subtype.ext (AlgEquiv.ext fun _ ↦ rfl)

@[simp] lemma toNew_apply (σ : D.H) (x : Ω) :
    ((toNew D ht' htr' hH σ : (newData D ht' htr').H) : Ω ≃ₐ[K₀ k t'] Ω) x =
      (σ : Ω ≃ₐ[K₀ k t] Ω) x := rfl

/-- The inverse of `toNew`. -/
def fromNew : (newData D ht' htr').H →* D.H where
  toFun σ := ⟨AlgEquiv.ofRingEquiv (f := (σ : Ω ≃ₐ[K₀ k t'] Ω).toRingEquiv)
      (fun c ↦ fix_of_mem_newData_H D ht' htr' σ (D.L.algebraMap_mem c)),
    D.le (by
      rw [← D.fixingSubgroup_L]
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).2 fun _ hx ↦
        fix_of_mem_newData_H D ht' htr' σ hx)⟩
  map_one' := Subtype.ext (AlgEquiv.ext fun _ ↦ rfl)
  map_mul' _ _ := Subtype.ext (AlgEquiv.ext fun _ ↦ rfl)

@[simp] lemma fromNew_apply (σ : (newData D ht' htr').H) (x : Ω) :
    ((fromNew D ht' htr' σ : D.H) : Ω ≃ₐ[K₀ k t] Ω) x = (σ : Ω ≃ₐ[K₀ k t'] Ω) x := rfl

@[simp] lemma fromNew_toNew (σ : D.H) : fromNew D ht' htr' (toNew D ht' htr' hH σ) = σ :=
  Subtype.ext (AlgEquiv.ext fun _ ↦ rfl)

@[simp] lemma toNew_fromNew (σ : (newData D ht' htr').H) :
    toNew D ht' htr' hH (fromNew D ht' htr' σ) = σ :=
  Subtype.ext (AlgEquiv.ext fun _ ↦ rfl)

lemma continuous_toNew [IsGalois (K₀ k t') Ω] : Continuous (toNew D ht' htr' hH) :=
  (continuous_of_isOpen_setOf_apply_eq ((newData D ht' htr').H.subtype.comp
    (toNew D ht' htr' hH)) fun x ↦
      (isOpen_setOf_apply_eq (t := t) x).preimage continuous_subtype_val).subtype_mk _

lemma continuous_fromNew [IsGalois (K₀ k t') Ω] : Continuous (fromNew D ht' htr') :=
  (continuous_of_isOpen_setOf_apply_eq (D.H.subtype.comp (fromNew D ht' htr')) fun x ↦
      (isOpen_setOf_apply_eq (t := t') x).preimage continuous_subtype_val).subtype_mk _

lemma mem_newData_S_iff (σ : D.H) :
    ((toNew D ht' htr' hH σ : (newData D ht' htr').H) : Ω ≃ₐ[K₀ k t'] Ω) ∈
      (newData D ht' htr').S ↔ (σ : Ω ≃ₐ[K₀ k t] Ω) ∈ D.Sat t' := by
  change (_ ∈ (newData D ht' htr').HL ∧ _) ↔ (_ ∈ D.HL ∧ _)
  simp only [GaloisPi1.inertia, Set.mem_setOf_eq, toNew_apply]
  exact and_congr ⟨fun _ ↦ hH σ.2, fun _ ↦ (toNew D ht' htr' hH σ).2⟩ Iff.rfl

/-- The inertia elements of `newData`, seen in `H`: the preimage under `H ≅ H'` of the closed
normal closure of the inertia elements of `newData` is the closed normal closure of
`D.Sat t'`. -/
lemma comap_kernel_newData [IsGalois (K₀ k t') Ω] :
    (GaloisPi1.kernel (newData D ht' htr').H (newData D ht' htr').S).comap
      (toNew D ht' htr' hH) =
      (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure := by
  set D' := newData D ht' htr'
  have hS' : D'.S ⊆ D'.H := fun _ h ↦ D'.le h.1
  rw [GaloisPi1.kernel_eq_topologicalClosure _ D'.isClosed_H _ hS']
  haveI hN :
      (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure.Normal :=
    Subgroup.is_normal_topologicalClosure _
  haveI hN' : (Subgroup.normalClosure (Subtype.val ⁻¹' D'.S :
      Set D'.H)).topologicalClosure.Normal :=
    Subgroup.is_normal_topologicalClosure _
  apply le_antisymm
  · intro σ hσ
    haveI := hN.comap (fromNew D ht' htr')
    have hle : (Subgroup.normalClosure (Subtype.val ⁻¹' D'.S : Set D'.H)).topologicalClosure ≤
        (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure.comap
          (fromNew D ht' htr') := by
      refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_)
        ((Subgroup.isClosed_topologicalClosure _).preimage (continuous_fromNew D ht' htr'))
      intro s hs
      refine Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure ?_)
      change ((fromNew D ht' htr' s : D.H) : Ω ≃ₐ[K₀ k t] Ω) ∈ D.Sat t'
      rw [← mem_newData_S_iff D ht' htr' hH, toNew_fromNew]
      exact hs
    have := hle hσ
    rwa [Subgroup.mem_comap, fromNew_toNew] at this
  · haveI := hN'.comap (toNew D ht' htr' hH)
    refine Subgroup.topologicalClosure_minimal _ (Subgroup.normalClosure_le_normal ?_)
      ((Subgroup.isClosed_topologicalClosure _).preimage (continuous_toNew D ht' htr' hH))
    intro s hs
    refine Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure ?_)
    change ((toNew D ht' htr' hH s : D'.H) : Ω ≃ₐ[K₀ k t'] Ω) ∈ D'.S
    rw [mem_newData_S_iff D ht' htr' hH]
    exact hs

section Scheme

variable [IsSepClosed Ω] [IsGalois (K₀ k t') Ω]

/-- `chartHom` followed by a morphism to `Spec R'` (`R'` the ring of `newData`) compatible with
the geometric points is the intrinsic Galois action of `newData`. -/
lemma fundamentalGroupMap_chartHom_new {Y : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y)
    (φ : Y ⟶ Spec (.of (newData D ht' htr').R))
    (h : (specPoint D.L Ω ≫ j) ≫ φ = specPoint (newData D ht' htr').R Ω) (σ : D.H) :
    fundamentalGroupMap φ h (D.chartHom hH j σ) =
      (newData D ht' htr').galoisHom (newData_H_le D ht' htr') (toNew D ht' htr' hH σ) := by
  rw [GaloisData.chartHom_apply, fundamentalGroupMap_galoisAction D.L j φ rfl h
      (by rw [← Category.assoc]; exact h),
    GaloisData.galoisHom_apply, GaloisData.galoisHomL_eq]
  refine galoisAction_eq_of_apply_eq D.L _ _ _ _ _ _ fun x ↦ ?_
  simp only [GaloisData.toGalL_apply, Subgroup.coe_inclusion, toNew_apply]

variable [CharZero k]

/-- **The kernel of the Galois action on `π₁ᵉᵗ` of a chart for the coordinate `t'`**: for
`ι : Y ⟶ Z` and `e : Z ≅ Spec R'` compatible with the geometric points, the kernel of
`H → π₁ᵉᵗ(Y) → π₁ᵉᵗ(Z)` is the closed normal subgroup generated by `D.Sat t'`. -/
lemma ker_chartHom_comp_iso_new {Y Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) (ι : Y ⟶ Z)
    (e : Z ≅ Spec (.of (newData D ht' htr').R))
    (h : ((specPoint D.L Ω ≫ j) ≫ ι) ≫ e.hom = specPoint (newData D ht' htr').R Ω) :
    ((fundamentalGroupMap ι (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _)).toMonoidHom.comp
      (D.chartHom hH j)).ker =
      (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure := by
  have h' : (specPoint D.L Ω ≫ j) ≫ ι ≫ e.hom = specPoint (newData D ht' htr').R Ω := by
    rw [← Category.assoc]
    exact h
  have hσ (σ : D.H) : fundamentalGroupMap e.hom h (fundamentalGroupMap ι
      (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _) (D.chartHom hH j σ)) =
      (newData D ht' htr').galoisHom (newData_H_le D ht' htr') (toNew D ht' htr' hH σ) :=
    (DFunLike.congr_fun (fundamentalGroupMap_comp ι e.hom rfl h h') _).symm.trans
      (fundamentalGroupMap_chartHom_new D ht' htr' hH j (ι ≫ e.hom) h' σ)
  rw [← MonoidHom.ker_comp_of_injective _ (fundamentalGroupMap e.hom h).toMonoidHom
    (fundamentalGroupMap_bijective_of_isIso _ h).1, ← comap_kernel_newData D ht' htr' hH,
    ← (newData D ht' htr').ker_galoisHom (newData_H_le D ht' htr'), MonoidHom.comap_ker]
  exact congrArg MonoidHom.ker (MonoidHom.ext hσ)

lemma chartHom_comp_iso_new_surjective {Y Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Y) (ι : Y ⟶ Z)
    (e : Z ≅ Spec (.of (newData D ht' htr').R))
    (h : ((specPoint D.L Ω ≫ j) ≫ ι) ≫ e.hom = specPoint (newData D ht' htr').R Ω) :
    Function.Surjective ((fundamentalGroupMap ι
      (rfl : (specPoint D.L Ω ≫ j) ≫ ι = _)).toMonoidHom.comp (D.chartHom hH j)) := by
  have h' : (specPoint D.L Ω ≫ j) ≫ ι ≫ e.hom = specPoint (newData D ht' htr').R Ω := by
    rw [← Category.assoc]
    exact h
  intro y
  obtain ⟨σ, hσ⟩ := (newData D ht' htr').galoisHom_surjective (newData_H_le D ht' htr')
    (fundamentalGroupMap e.hom h y)
  refine ⟨fromNew D ht' htr' σ, (fundamentalGroupMap_bijective_of_isIso _ h).1 ?_⟩
  refine ((DFunLike.congr_fun (fundamentalGroupMap_comp ι e.hom rfl h h') _).symm.trans
    (fundamentalGroupMap_chartHom_new D ht' htr' hH j (ι ≫ e.hom) h' _)).trans ?_
  rw [toNew_fromNew, hσ]

/-- `ker_chartHom_comp_iso_new` without the intermediate morphism. -/
lemma ker_chartHom_iso_new {Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Z)
    (e : Z ≅ Spec (.of (newData D ht' htr').R))
    (h : (specPoint D.L Ω ≫ j) ≫ e.hom = specPoint (newData D ht' htr').R Ω) :
    (D.chartHom hH j).ker =
      (Subgroup.normalClosure (Subtype.val ⁻¹' D.Sat t' : Set D.H)).topologicalClosure := by
  rw [← MonoidHom.ker_comp_of_injective _ (fundamentalGroupMap e.hom h).toMonoidHom
    (fundamentalGroupMap_bijective_of_isIso _ h).1, ← comap_kernel_newData D ht' htr' hH,
    ← (newData D ht' htr').ker_galoisHom (newData_H_le D ht' htr'), MonoidHom.comap_ker]
  exact congrArg MonoidHom.ker (MonoidHom.ext (fundamentalGroupMap_chartHom_new D ht' htr' hH j
    e.hom h))

/-- `chartHom_comp_iso_new_surjective` without the intermediate morphism. -/
lemma chartHom_iso_new_surjective {Z : Scheme.{u}} (j : Spec (.of D.L) ⟶ Z)
    (e : Z ≅ Spec (.of (newData D ht' htr').R))
    (h : (specPoint D.L Ω ≫ j) ≫ e.hom = specPoint (newData D ht' htr').R Ω) :
    Function.Surjective (D.chartHom hH j) := by
  intro y
  obtain ⟨σ, hσ⟩ := (newData D ht' htr').galoisHom_surjective (newData_H_le D ht' htr')
    (fundamentalGroupMap e.hom h y)
  refine ⟨fromNew D ht' htr' σ, (fundamentalGroupMap_bijective_of_isIso _ h).1 ?_⟩
  rw [fundamentalGroupMap_chartHom_new D ht' htr' hH j e.hom h, toNew_fromNew, hσ]

end Scheme

end NewData

end CurvesJacobian
