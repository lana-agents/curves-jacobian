import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.RingTheory.Algebraic.Cardinality
import Mathlib.SetTheory.Cardinal.Subfield

/-!
# Countable algebraically closed subfields

* `CurvesJacobian.isAlgClosed_algebraicClosure`: the relative algebraic closure of `F` in an
  algebraically closed field `E` is algebraically closed.
* `CurvesJacobian.exists_countable_isAlgClosed_subfield`: every countable subset `s` of an
  algebraically closed field `k` lies in a countable algebraically closed subfield (the relative
  algebraic closure in `k` of the subfield generated by `s`).
-/

universe u

namespace CurvesJacobian

/-- **The relative algebraic closure of `F` in an algebraically closed field is algebraically
closed.** -/
theorem isAlgClosed_algebraicClosure (F E : Type*) [Field F] [Field E] [Algebra F E]
    [IsAlgClosed E] : IsAlgClosed (algebraicClosure F E) := by
  refine IsAlgClosed.of_exists_root _ fun p hmon hirr ↦ ?_
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_aeval_eq_zero E p
    (Polynomial.degree_pos_of_irreducible hirr).ne'
  have hxint : IsIntegral (algebraicClosure F E) x := ⟨p, hmon, hx⟩
  have hmem : x ∈ algebraicClosure F E :=
    mem_algebraicClosure_iff'.2 (isIntegral_trans x hxint)
  refine ⟨⟨x, hmem⟩, (algebraMap (algebraicClosure F E) E).injective ?_⟩
  rw [map_zero, ← Polynomial.eval₂_hom, ← Polynomial.aeval_def]
  exact hx

/-- **Countable algebraically closed subfields.** Every countable subset `s` of an algebraically
closed field `k` is contained in a countable algebraically closed subfield `k₀ ⊆ k`. -/
theorem exists_countable_isAlgClosed_subfield (k : Type u) [Field k] [IsAlgClosed k]
    (s : Set k) (hs : s.Countable) :
    ∃ (k₀ : Type u) (_ : Field k₀) (_ : IsAlgClosed k₀) (_ : Countable k₀) (_ : Algebra k₀ k),
      s ⊆ Set.range (algebraMap k₀ k) := by
  let F := Subfield.closure s
  let K := algebraicClosure F k
  haveI := isAlgClosed_algebraicClosure F k
  have hF : Countable F := by
    rw [← Cardinal.mk_le_aleph0_iff]
    refine (Subfield.cardinalMk_closure_le_max s).trans (max_le ?_ le_rfl)
    exact Cardinal.mk_le_aleph0_iff.2 hs.to_subtype
  have hK : Countable K := by
    rw [← Cardinal.mk_le_aleph0_iff]
    refine (Algebra.IsAlgebraic.cardinalMk_le_max F K).trans (max_le ?_ le_rfl)
    exact Cardinal.mk_le_aleph0_iff.2 hF
  refine ⟨K, inferInstance, inferInstance, hK, inferInstance, fun x hx ↦ ?_⟩
  have hxF : x ∈ F := Subfield.subset_closure hx
  have hxK : x ∈ K :=
    mem_algebraicClosure_iff'.2 (isIntegral_algebraMap (R := F) (A := k) (x := ⟨x, hxF⟩))
  exact ⟨⟨x, hxK⟩, rfl⟩

end CurvesJacobian
