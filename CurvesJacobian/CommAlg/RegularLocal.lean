import CurvesJacobian.CommAlg.SerreS2
import Mathlib.RingTheory.KrullDimension.Regular
import Mathlib.Algebra.Module.SpanRankOperations
import Mathlib.RingTheory.Ideal.MinimalPrime.Noetherian

/-!
# Regular local rings are domains; regular domains are normal

Main results (Mathlib's `IsRegularLocalRing` is Stacks Definition 10.60.10 = Tag 00KU):

* `CurvesJacobian.isRegularLocalRing_quotient_span_singleton`: if `x ∈ 𝔪 \ 𝔪²` in a regular
  local ring `R`, then `R ⧸ (x)` is regular local of dimension `dim R - 1`;
* `CurvesJacobian.IsRegularLocalRing.isDomain`: a regular local ring is a domain
  (Stacks, Lemma 10.106.2 = Tag 00NP; proof by induction on the dimension, as in loc. cit.);
* `CurvesJacobian.depthGeTwo_of_isRegularLocalRing`: a regular local ring of dimension `≥ 2`
  has depth `≥ 2` (the case needed of "regular ⇒ Cohen–Macaulay", Stacks Tag 00NQ);
* `CurvesJacobian.isIntegrallyClosed_of_isRegularRing`: a regular domain is normal
  (Stacks, Lemma 10.157.5 = Tag 0567, via Serre's criterion as in loc. cit.).
-/

open IsLocalRing Pointwise RingTheory.Sequence

namespace CurvesJacobian

universe u

variable {R : Type u} [CommRing R]

section Generators

variable [IsLocalRing R] [IsNoetherianRing R]

/-- If `x ∈ 𝔪 \ 𝔪²`, then `𝔪` is generated by `x` together with at most
`spanFinrank 𝔪 - 1` further elements of `𝔪`. -/
lemma exists_finset_span_insert_eq_maximalIdeal {x : R} (hx : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) :
    ∃ T : Finset R, T.card ≤ (maximalIdeal R).spanFinrank - 1 ∧
      (↑T : Set R) ⊆ maximalIdeal R ∧
      Ideal.span (insert x (T : Set R)) = maximalIdeal R := by
  classical
  let k := ResidueField R
  let V := CotangentSpace R
  let v : V := (maximalIdeal R).toCotangent ⟨x, hx⟩
  have hv : v ≠ 0 := by
    intro h
    exact hx2 ((Ideal.toCotangent_eq_zero _ _).1 h)
  obtain ⟨W, hW⟩ := Submodule.exists_isCompl (Submodule.span k {v})
  let b := Module.finBasis k W
  have hfinW : Module.finrank k W = Module.finrank k V - 1 := by
    have := Submodule.finrank_add_eq_of_isCompl hW
    rw [finrank_span_singleton hv] at this
    omega
  choose f hf using fun i ↦ (maximalIdeal R).toCotangent_surjective (b i : V)
  refine ⟨Finset.univ.image (fun i ↦ (f i : R)), ?_, ?_, ?_⟩
  · refine Finset.card_image_le.trans ?_
    rw [Finset.card_univ, Fintype.card_fin, hfinW,
      spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  · intro y hy
    simp only [Finset.coe_image, Finset.coe_univ, Set.image_univ, Set.mem_range] at hy
    obtain ⟨i, rfl⟩ := hy
    exact (f i).2
  · have hWspan : W = Submodule.span k (Set.range fun i ↦ (b i : V)) := by
      have : Set.range (fun i ↦ (b i : V)) = W.subtype '' Set.range b := by
        rw [← Set.range_comp]; rfl
      rw [this, Submodule.span_image, b.span_eq, Submodule.map_top, Submodule.range_subtype]
    have hspan : Submodule.span k ((maximalIdeal R).toCotangent ''
        (insert ⟨x, hx⟩ (Set.range f))) = ⊤ := by
      rw [Set.image_insert_eq, ← Set.range_comp, Submodule.span_insert]
      have : ((maximalIdeal R).toCotangent ∘ f) = fun i ↦ (b i : V) := funext hf
      rw [this, ← hWspan]
      exact hW.sup_eq_top
    have h2 := congrArg (Submodule.map (maximalIdeal R).subtype)
      ((CotangentSpace.span_image_eq_top_iff).1 hspan)
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at h2
    refine Eq.trans ?_ h2
    congr 1
    ext y
    simp only [Set.mem_insert_iff, Finset.coe_image, Finset.coe_univ, Set.image_univ,
      Set.mem_range, Set.image_insert_eq, Submodule.subtype_apply]
    constructor
    · rintro (rfl | ⟨i, rfl⟩)
      · exact Or.inl rfl
      · exact Or.inr ⟨f i, ⟨i, rfl⟩, rfl⟩
    · rintro (rfl | ⟨_, ⟨i, rfl⟩, rfl⟩)
      · exact Or.inl rfl
      · exact Or.inr ⟨i, rfl⟩

end Generators

lemma smul_top_eq_span_singleton (x : R) : x • (⊤ : Ideal R) = Ideal.span {x} := by
  ext c
  exact mem_smul_top_iff_mem_span x c

/-- If `x ∈ 𝔪 \ 𝔪²` in a regular local ring `R`, then `R ⧸ (x)` is a regular local ring and
`dim R ⧸ (x) + 1 = dim R`. -/
theorem isRegularLocalRing_quotient_span_singleton [IsRegularLocalRing R] {x : R}
    (hx : x ∈ maximalIdeal R) (hx2 : x ∉ maximalIdeal R ^ 2) :
    IsRegularLocalRing (R ⧸ Ideal.span {x}) ∧
      ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R := by
  classical
  have hne : Ideal.span {x} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact (mem_maximalIdeal x).1 hx
  haveI : Nontrivial (R ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.2 hne
  haveI : IsLocalRing (R ⧸ Ideal.span {x}) := .of_surjective' _ Ideal.Quotient.mk_surjective
  obtain ⟨T, hTcard, -, hTspan⟩ := exists_finset_span_insert_eq_maximalIdeal hx hx2
  have hm' : maximalIdeal (R ⧸ Ideal.span {x}) =
      Ideal.span ((Ideal.Quotient.mk (Ideal.span {x})) '' (T : Set R)) := by
    rw [← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective, ← hTspan,
      Ideal.map_span, Set.image_insert_eq, Ideal.Quotient.eq_zero_iff_mem.2
        (Ideal.mem_span_singleton_self x), Ideal.span_insert_zero]
  have hs' : (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank ≤ T.card := by
    rw [hm']
    refine (Submodule.spanFinrank_span_le_ncard_of_finite ((T.finite_toSet).image _)).trans ?_
    exact (Set.ncard_image_le T.finite_toSet).trans (Set.ncard_coe_finset T).le
  have h1 := ringKrullDim_le_ringKrullDim_quotSMulTop_succ hx
  rw [smul_top_eq_span_singleton] at h1
  have h2 := ringKrullDim_le_spanFinrank_maximalIdeal (R := R ⧸ Ideal.span {x})
  have hreg := (isRegularLocalRing_iff R).1 inferInstance
  have hd : 1 ≤ (maximalIdeal R).spanFinrank := by
    rw [Nat.one_le_iff_ne_zero, Ne,
      Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal R).fg_of_isNoetherianRing]
    intro h
    rw [h] at hx
    rw [(Submodule.mem_bot R).1 hx] at hx2
    exact hx2 (zero_mem _)
  have h0 : (0 : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ Ideal.span {x}) :=
    ringKrullDim_nonneg_of_nontrivial
  set D := ringKrullDim (R ⧸ Ideal.span {x}) with hD
  clear_value D
  obtain ⟨n, hn⟩ : ∃ n : ℕ, D = n := by
    clear h1 hD
    induction D using WithBot.recBotCoe with
    | bot => exact absurd h0 (by simp)
    | coe e =>
      induction e using ENat.recTopCoe with
      | top =>
        have : ((Submodule.spanFinrank (maximalIdeal (R ⧸ Ideal.span {x})) : ℕ) :
            WithBot ℕ∞) < ((⊤ : ℕ∞) : WithBot ℕ∞) := by
          exact_mod_cast ENat.coe_lt_top _
        exact absurd h2 (not_le.2 this)
      | coe n => exact ⟨n, rfl⟩
  rw [← hreg] at h1 ⊢
  rw [hn] at h1 h2 ⊢
  norm_cast at h1 h2 ⊢
  refine ⟨(isRegularLocalRing_iff _).2 ?_, by omega⟩
  rw [← hD, hn]
  norm_cast
  omega

/-- In a local ring of positive dimension, some `x ∈ 𝔪` avoids `𝔪²` and all minimal primes. -/
lemma exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes [IsLocalRing R] [IsNoetherianRing R]
    (hpos : 0 < ringKrullDim R) :
    ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 ∧ ∀ p ∈ minimalPrimes R, x ∉ p := by
  classical
  have hfin : (insert (maximalIdeal R ^ 2) (minimalPrimes R)).Finite :=
    (minimalPrimes.finite_of_isNoetherianRing R).insert _
  have hnsub : ¬ ((maximalIdeal R : Set R) ⊆
      ⋃ i ∈ insert (maximalIdeal R ^ 2) (minimalPrimes R), (id i : Set R)) := by
    intro hsub
    obtain ⟨i, hi, hle⟩ := (Ideal.subset_union_prime_finite hfin (f := id) (maximalIdeal R ^ 2)
      (maximalIdeal R ^ 2) (fun i hi h1 _ ↦ ((Set.mem_insert_iff.1 hi).resolve_left h1).1.1)).1
      hsub
    rcases Set.mem_insert_iff.1 hi with rfl | hmin
    · -- `𝔪 ≤ 𝔪²` forces `𝔪 = 0`, i.e. dimension `0`
      have hbot : maximalIdeal R = ⊥ :=
        Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal R) _
          (maximalIdeal R).fg_of_isNoetherianRing (by rwa [smul_eq_mul, ← pow_two])
          (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge
      have hf : IsField R := (isField_iff_maximalIdeal_eq).2 hbot
      rw [ringKrullDim_eq_zero_of_isField hf] at hpos
      exact lt_irrefl _ hpos
    · haveI := hmin.1.1
      have heq : i = maximalIdeal R := ((maximalIdeal.isMaximal R).eq_of_le
        (Ideal.IsPrime.ne_top ‹_›) hle).symm
      have h0 : i.height = 0 := Ideal.height_eq_zero_iff.2 hmin
      rw [heq] at h0
      have := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := R)
      rw [h0] at this
      rw [← this] at hpos
      exact lt_irrefl _ hpos
  obtain ⟨x, hx, hxn⟩ := Set.not_subset.1 hnsub
  simp only [Set.mem_iUnion, not_exists, id] at hxn
  exact ⟨x, hx, fun h ↦ hxn _ (Set.mem_insert _ _) h,
    fun p hp h ↦ hxn p (Set.mem_insert_of_mem _ hp) h⟩

/-- **A regular local ring is a domain** (Stacks, Lemma 10.106.2 = Tag 00NP), by induction on
`spanFinrank 𝔪 = dim R`. -/
theorem IsRegularLocalRing.isDomain_aux :
    ∀ (n : ℕ) (R : Type u) [CommRing R] [IsRegularLocalRing R],
      (maximalIdeal R).spanFinrank = n → IsDomain R := by
  intro n
  induction n with
  | zero =>
    intro R _ _ hn
    have hbot : maximalIdeal R = ⊥ :=
      (Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal R).fg_of_isNoetherianRing).1 hn
    exact ((isField_iff_maximalIdeal_eq).2 hbot).isDomain
  | succ n ih =>
    intro R _ _ hn
    have hreg := (isRegularLocalRing_iff R).1 inferInstance
    have hpos : 0 < ringKrullDim R := by
      rw [← hreg, hn]
      exact_mod_cast Nat.succ_pos n
    obtain ⟨x, hx, hx2, hxmin⟩ := exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes hpos
    obtain ⟨hQ, hdim⟩ := isRegularLocalRing_quotient_span_singleton hx hx2
    have hQn : (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank = n := by
      have hQreg := (isRegularLocalRing_iff (R ⧸ Ideal.span {x})).1 hQ
      rw [← hreg, hn, ← hQreg] at hdim
      norm_cast at hdim
      omega
    haveI := ih (R ⧸ Ideal.span {x}) hQn
    have hprime : (Ideal.span {x}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).1 ‹_›
    obtain ⟨p, hpmin, hple⟩ := Ideal.exists_minimalPrimes_le (bot_le (a := Ideal.span {x}))
    haveI : p.IsPrime := hpmin.1.1
    have hxp : x ∉ p := hxmin p hpmin
    have hsmul : p ≤ Ideal.span {x} • p := by
      intro y hy
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 (hple hy)
      have hc : c ∈ p := (Ideal.IsPrime.mem_or_mem ‹_› hy).resolve_right hxp
      rw [smul_eq_mul, show c * x = x * c from mul_comm _ _]
      exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self x) hc
    have hbot : p = ⊥ :=
      Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ p p.fg_of_isNoetherianRing hsmul
        (((Ideal.span_singleton_le_iff_mem _).2 hx).trans
          (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge)
    haveI : (⊥ : Ideal R).IsPrime := hbot ▸ ‹p.IsPrime›
    exact IsDomain.of_bot_isPrime R

/-- **A regular local ring is a domain** (Stacks, Lemma 10.106.2 = Tag 00NP). -/
theorem IsRegularLocalRing.isDomain (R : Type u) [CommRing R] [IsRegularLocalRing R] :
    IsDomain R :=
  IsRegularLocalRing.isDomain_aux _ R rfl

/-- A regular local ring of dimension `≥ 2` contains a regular sequence of length two in its
maximal ideal. -/
theorem depthGeTwo_of_isRegularLocalRing [IsRegularLocalRing R] (h2 : 2 ≤ ringKrullDim R) :
    DepthGeTwo R := by
  haveI := IsRegularLocalRing.isDomain R
  obtain ⟨x, hx, hx2, -⟩ := exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes
    (lt_of_lt_of_le (by decide) h2)
  obtain ⟨hQ, hdim⟩ := isRegularLocalRing_quotient_span_singleton hx hx2
  haveI := IsRegularLocalRing.isDomain (R ⧸ Ideal.span {x})
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact hx2 (zero_mem _)
  -- the maximal ideal of `R ⧸ (x)` is nonzero
  have hQbot : maximalIdeal (R ⧸ Ideal.span {x}) ≠ ⊥ := by
    intro hbot
    have hf : IsField (R ⧸ Ideal.span {x}) := (isField_iff_maximalIdeal_eq).2 hbot
    rw [ringKrullDim_eq_zero_of_isField hf, zero_add] at hdim
    rw [← hdim] at h2
    exact absurd h2 (by decide)
  obtain ⟨y', hy', hy'0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQbot
  rw [← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective,
    Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hy'
  obtain ⟨y, hy, rfl⟩ := hy'
  refine ⟨x, hx, y, hy, IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal R ?_ ?_⟩
  · intro r hr
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl
    exacts [hx, hy]
  rw [isWeaklyRegular_pair_iff]
  refine ⟨fun u v huv ↦ mul_left_cancel₀ hx0 huv, fun c hc ↦ ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul] at hc
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  exact (mul_eq_zero.1 hc).resolve_left hy'0

/-- **A regular domain is normal** (Stacks, Lemma 10.157.5 = Tag 0567), via Serre's criterion. -/
theorem isIntegrallyClosed_of_isRegularRing (A : Type*) [CommRing A] [IsDomain A]
    [IsRegularRing A] : IsIntegrallyClosed A := by
  rw [isIntegrallyClosed_iff_serreR1_and_serreS2]
  refine ⟨fun p _ _ ↦ inferInstance, fun p _ hp ↦ ?_⟩
  apply depthGeTwo_of_isRegularLocalRing
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height p]
  exact le_trans (le_of_eq rfl) (WithBot.coe_le_coe.2 hp)

end CurvesJacobian
