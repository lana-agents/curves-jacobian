/-!
# The zeroth Fitting ideal (JAC J2, algebraic part)

For a finitely generated module `M` over a commutative ring `R` and a generating family
`g : Fin n → M`, let `I(g)` be the ideal generated by the determinants of the `n × n` matrices
all of whose columns are relations among the `g i` (`minorIdeal`). Following the Stacks
Project, Lemma 15.8.2 (Tag 07Z8) and Definition 15.8.3 (Tag 07Z9) — where `Fit₀(M)` is the
ideal generated by the `n × n` minors of a presentation matrix, independent of the
presentation — we prove:

* `minorIdeal_comp_equiv` (reindexing), **`minorIdeal_snoc`** (adding a generator that lies in
  the span of the others does not change the ideal: Laplace expansion along the new row),
  **`minorIdeal_eq_of_span`**: `I(g) = I(h)` for any two generating families;
* **`fitt0 R M`**, the zeroth Fitting ideal, with `fitt0_eq_minorIdeal` for every generating
  family, and invariance under linear isomorphisms (`fitt0_congr`);
* **`fitt0_quotient_range`**: for a square matrix `D`, `Fit₀(Rⁿ / D Rⁿ) = (det D)`;
* **`map_fitt0_quotient_range`**: compatibility with ring maps for square presentations;
* **`fitt0_baseChange`**: `Fit₀(B ⊗_R M) = Fit₀(M) B` for any `R`-algebra `B` (Stacks 15.8.4(3),
  Tag 07ZA; via right exactness of `⊗` and multilinearity of `det` in the columns,
  `det_mem_of_mem_span`).

These are the algebraic inputs of the theta divisor `Θ = V(Fit₀ R¹p_*(𝒫 ⊗ κ))` on `J` (JAC J2):
the ideal is intrinsic, so the local ideals glue, commute with base change, and are locally
principal `(det δ)` for the equal-rank two-term complexes of `TwoTermPerfect.lean`.
-/

open Matrix

universe u v

noncomputable section

namespace CurvesJacobian.Fitting

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

variable (R) in
/-- `a` is a relation among the `g i`. -/
def IsRel {ι : Type*} [Fintype ι] (g : ι → M) (a : ι → R) : Prop :=
  ∑ i, a i • g i = 0

variable (R) in
/-- The ideal generated by the determinants of the square matrices whose columns are relations
among the `g i`. -/
def minorIdeal {ι : Type*} [Fintype ι] [DecidableEq ι] (g : ι → M) : Ideal R :=
  Ideal.span {d | ∃ A : Matrix ι ι R, (∀ j, IsRel R g (fun i ↦ A i j)) ∧ A.det = d}

lemma det_mem_minorIdeal {ι : Type*} [Fintype ι] [DecidableEq ι] {g : ι → M}
    (A : Matrix ι ι R) (hA : ∀ j, IsRel R g (fun i ↦ A i j)) : A.det ∈ minorIdeal R g :=
  Ideal.subset_span ⟨A, hA, rfl⟩

lemma minorIdeal_le_iff {ι : Type*} [Fintype ι] [DecidableEq ι] {g : ι → M} {I : Ideal R} :
    minorIdeal R g ≤ I ↔ ∀ A : Matrix ι ι R, (∀ j, IsRel R g (fun i ↦ A i j)) → A.det ∈ I := by
  rw [minorIdeal, Ideal.span_le]
  exact ⟨fun h A hA ↦ h ⟨A, hA, rfl⟩, fun h _ ⟨A, hA, hd⟩ ↦ hd ▸ h A hA⟩

lemma minorIdeal_comp_equiv_le {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] (g : κ → M) (e : ι ≃ κ) : minorIdeal R (g ∘ e) ≤ minorIdeal R g := by
  refine minorIdeal_le_iff.2 fun A hA ↦ ?_
  rw [← det_submatrix_equiv_self e.symm A]
  refine det_mem_minorIdeal _ fun j ↦ ?_
  have := hA (e.symm j)
  unfold IsRel at this ⊢
  rw [← this, ← e.symm.sum_comp]
  simp

/-- Reindexing the generators does not change the ideal. -/
lemma minorIdeal_comp_equiv {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] (g : κ → M) (e : ι ≃ κ) : minorIdeal R (g ∘ e) = minorIdeal R g := by
  refine le_antisymm (minorIdeal_comp_equiv_le g e) ?_
  have h := minorIdeal_comp_equiv_le (R := R) (g ∘ e) e.symm
  rwa [Function.comp_assoc, e.self_comp_symm, Function.comp_id] at h

/-- **Adding a generator in the span of the others does not change the ideal** (the key step
of Stacks, Lemma 15.8.2, Tag 07Z8). -/
theorem minorIdeal_snoc {n : ℕ} (g : Fin n → M) {x : M}
    (hx : x ∈ Submodule.span R (Set.range g)) :
    minorIdeal R (Fin.snoc g x : Fin (n + 1) → M) = minorIdeal R g := by
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 hx
  apply le_antisymm
  · refine minorIdeal_le_iff.2 fun B hB ↦ ?_
    -- row operations: add `c i` times the last row to row `i`
    let E : Matrix (Fin (n + 1)) (Fin (n + 1)) R := fun i k ↦
      Fin.lastCases (Fin.lastCases 1 (fun _ ↦ 0) k)
        (fun i ↦ Fin.lastCases (c i) (fun k ↦ if i = k then 1 else 0) k) i
    have hE : E.det = 1 := by
      rw [det_succ_row E (Fin.last n), Fin.sum_univ_castSucc]
      have h1 : E.submatrix Fin.castSucc Fin.castSucc = 1 := by
        ext i k
        simp [E, Matrix.one_apply]
      simp only [Fin.succAbove_last, h1, det_one]
      simp [E]
    have hdet : (E * B).det = B.det := by rw [det_mul, hE, one_mul]
    rw [← hdet, det_succ_row _ (Fin.last n)]
    refine Submodule.sum_mem _ fun j _ ↦ Ideal.mul_mem_left _ _ (det_mem_minorIdeal _ fun j' ↦ ?_)
    have hrel := hB (Fin.succAbove j j')
    unfold IsRel at hrel ⊢
    rw [Fin.sum_univ_castSucc] at hrel
    simp only [Fin.snoc_castSucc, Fin.snoc_last] at hrel
    rw [← hc, Finset.smul_sum] at hrel
    rw [← hrel, Fin.succAbove_last, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    simp only [submatrix_apply, Matrix.mul_apply, Fin.sum_univ_castSucc, E, Fin.lastCases_castSucc,
      Fin.lastCases_last, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ,
      if_true, smul_smul, add_smul]
    ring_nf
  · refine minorIdeal_le_iff.2 fun A hA ↦ ?_
    let A' : Matrix (Fin (n + 1)) (Fin (n + 1)) R := fun i k ↦
      Fin.lastCases (Fin.lastCases 1 (fun _ ↦ 0) k)
        (fun i ↦ Fin.lastCases (-c i) (fun k ↦ A i k) k) i
    have hA' : A'.det = A.det := by
      rw [det_succ_row A' (Fin.last n), Fin.sum_univ_castSucc]
      have h1 : A'.submatrix Fin.castSucc Fin.castSucc = A := by
        ext i k
        simp [A']
      simp only [Fin.succAbove_last, h1]
      simp [A']
    rw [← hA']
    refine det_mem_minorIdeal _ fun j ↦ ?_
    unfold IsRel
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, A', Fin.lastCases_castSucc, Fin.lastCases_last]
    induction j using Fin.lastCases with
    | last =>
      simp only [Fin.lastCases_last, neg_smul, Finset.sum_neg_distrib, one_smul, hc,
        neg_add_cancel]
    | cast j =>
      simp only [Fin.lastCases_castSucc, zero_smul, add_zero]
      exact hA j

/-- Appending generators lying in the span of `g` does not change the ideal. -/
theorem minorIdeal_append {n : ℕ} (g : Fin n → M) :
    ∀ {m : ℕ} (h : Fin m → M), (∀ k, h k ∈ Submodule.span R (Set.range g)) →
      minorIdeal R (Fin.append g h) = minorIdeal R g
  | 0, h, _ => by
    rw [show h = Fin.elim0 from funext fun k ↦ k.elim0, Fin.append_elim0]
    exact minorIdeal_comp_equiv g (finCongr (Nat.add_zero n))
  | m + 1, h, hh => by
    rw [← Fin.snoc_init_self h, Fin.append_snoc, minorIdeal_snoc,
      minorIdeal_append g (Fin.init h) (fun k ↦ hh _)]
    have hle : Submodule.span R (Set.range g) ≤
        Submodule.span R (Set.range (Fin.append g (Fin.init h))) := by
      refine Submodule.span_mono ?_
      rintro _ ⟨i, rfl⟩
      exact ⟨Fin.castAdd m i, Fin.append_left _ _ _⟩
    exact hle (hh _)

omit [AddCommGroup M] in
lemma append_comm {n m : ℕ} (g : Fin n → M) (h : Fin m → M) :
    Fin.append h g = Fin.append g h ∘ finAddFlip := by
  funext i
  induction i using Fin.addCases with
  | left k => simp [finAddFlip_apply_castAdd]
  | right k => simp [finAddFlip_apply_natAdd]

/-- **Independence of the generating family** (Stacks, Lemma 15.8.2, Tag 07Z8). -/
theorem minorIdeal_eq_of_span {n m : ℕ} {g : Fin n → M} {h : Fin m → M}
    (hg : Submodule.span R (Set.range g) = ⊤) (hh : Submodule.span R (Set.range h) = ⊤) :
    minorIdeal R g = minorIdeal R h := by
  rw [← minorIdeal_append g h (fun _ ↦ hg ▸ Submodule.mem_top),
    ← minorIdeal_append h g (fun _ ↦ hh ▸ Submodule.mem_top), append_comm,
    minorIdeal_comp_equiv]

variable (R M) in
/-- **The zeroth Fitting ideal** `Fit₀(M)` (Stacks, Definition 15.8.3, Tag 07Z9) of a finitely
generated module; `⊥` (a junk value) otherwise. -/
def fitt0 : Ideal R := by
  classical
  exact if h : Module.Finite R M then
    minorIdeal R (Module.Finite.exists_fin (R := R) (M := M)).choose_spec.choose
  else ⊥

/-- `Fit₀(M)` is the ideal of maximal minors of the relations of **any** finite generating
family. -/
theorem fitt0_eq_minorIdeal {n : ℕ} {g : Fin n → M} (hg : Submodule.span R (Set.range g) = ⊤) :
    fitt0 R M = minorIdeal R g := by
  classical
  have hfin : Module.Finite R M := ⟨⟨(Finset.univ.image g), by simpa using hg⟩⟩
  rw [fitt0, dif_pos hfin]
  exact minorIdeal_eq_of_span
    (Module.Finite.exists_fin (R := R) (M := M)).choose_spec.choose_spec hg

lemma isRel_map {N : Type*} [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) {ι : Type*}
    [Fintype ι] (g : ι → M) (a : ι → R) : IsRel R (e ∘ g) a ↔ IsRel R g a := by
  unfold IsRel
  rw [← e.map_eq_zero_iff, map_sum]
  simp

/-- `Fit₀` is invariant under linear isomorphisms. -/
theorem fitt0_congr [Module.Finite R M] {N : Type*} [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) : fitt0 R M = fitt0 R N := by
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := M)
  have hg' : Submodule.span R (Set.range (e ∘ g)) = ⊤ := by
    have : Set.range (e ∘ g) = (e.toLinearMap) '' Set.range g := by
      rw [Set.range_comp]
      rfl
    rw [this, Submodule.span_image, hg, Submodule.map_top, LinearEquiv.range]
  rw [fitt0_eq_minorIdeal hg, fitt0_eq_minorIdeal hg']
  unfold minorIdeal
  simp_rw [isRel_map]

section Square

variable {n : ℕ} (D : Matrix (Fin n) (Fin n) R)

/-- The images of the standard basis vectors in `Rⁿ / D Rⁿ`. -/
def stdGen : Fin n → (Fin n → R) ⧸ LinearMap.range D.mulVecLin :=
  fun i ↦ Submodule.Quotient.mk (Pi.single i 1)

lemma span_stdGen : Submodule.span R (Set.range (stdGen D)) = ⊤ := by
  have h1 : Set.range (stdGen D) =
      (LinearMap.range D.mulVecLin).mkQ '' Set.range (fun i ↦ (Pi.single i (1 : R))) := by
    rw [← Set.range_comp]
    rfl
  have h2 : Submodule.span R (Set.range (fun i ↦ (Pi.single i (1 : R) : Fin n → R))) = ⊤ := by
    have := (Pi.basisFun R (Fin n)).span_eq
    rwa [show ⇑(Pi.basisFun R (Fin n)) = fun i ↦ Pi.single i 1 from
      funext fun i ↦ Pi.basisFun_apply R (Fin n) i] at this
  rw [h1, Submodule.span_image, h2, Submodule.map_top, Submodule.range_mkQ]

lemma isRel_stdGen (a : Fin n → R) : IsRel R (stdGen D) a ↔ a ∈ LinearMap.range D.mulVecLin := by
  have hsum : ∑ i, a i • (Pi.single i (1 : R) : Fin n → R) = a := by
    ext j
    simp [Finset.sum_apply, Pi.single_apply]
  unfold IsRel stdGen
  change ∑ i, a i • (LinearMap.range D.mulVecLin).mkQ (Pi.single i 1) = 0 ↔ _
  simp_rw [← LinearMap.map_smul, ← map_sum, hsum, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero]

/-- **`Fit₀(Rⁿ / D Rⁿ) = (det D)`** for a square matrix `D`. -/
theorem fitt0_quotient_range :
    fitt0 R ((Fin n → R) ⧸ LinearMap.range D.mulVecLin) = Ideal.span {D.det} := by
  rw [fitt0_eq_minorIdeal (span_stdGen D)]
  apply le_antisymm
  · refine minorIdeal_le_iff.2 fun A hA ↦ ?_
    choose C hC using fun j ↦ (isRel_stdGen D _).1 (hA j)
    have hA' : A = D * Matrix.of (fun i j ↦ C j i) := by
      ext i j
      have := congrFun (hC j) i
      simp only [mulVecLin_apply] at this
      rw [← this]
      rfl
    rw [hA', det_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine det_mem_minorIdeal D fun j ↦ (isRel_stdGen D _).2 ⟨Pi.single j 1, ?_⟩
    ext i
    simp

/-- **Base change of `Fit₀` for square presentations** (Stacks 15.8.4(3), Tag 07ZA). -/
theorem map_fitt0_quotient_range {R' : Type u} [CommRing R'] (φ : R →+* R') :
    fitt0 R' ((Fin n → R') ⧸ LinearMap.range (φ.mapMatrix D).mulVecLin) =
      Ideal.map φ (fitt0 R ((Fin n → R) ⧸ LinearMap.range D.mulVecLin)) := by
  rw [fitt0_quotient_range, fitt0_quotient_range, Ideal.map_span, Set.image_singleton,
    RingHom.map_det]

end Square

section BaseChange

open TensorProduct

/-- Determinants of matrices whose columns lie in the span of `S` lie in every ideal containing
the determinants of the matrices whose columns lie in `S` (multilinearity in the columns). -/
theorem det_mem_of_mem_span {B : Type*} [CommRing B] {n : ℕ} {S : Set (Fin n → B)}
    {I : Ideal B} (hS : ∀ A : Matrix (Fin n) (Fin n) B, (∀ j, (fun i ↦ A i j) ∈ S) → A.det ∈ I)
    (A : Matrix (Fin n) (Fin n) B) (hA : ∀ j, (fun i ↦ A i j) ∈ Submodule.span B S) :
    A.det ∈ I := by
  have key : ∀ k : ℕ, ∀ A : Matrix (Fin n) (Fin n) B,
      (∀ j, (fun i ↦ A i j) ∈ Submodule.span B S) →
      (∀ j : Fin n, k ≤ (j : ℕ) → (fun i ↦ A i j) ∈ S) → A.det ∈ I := by
    intro k
    induction k with
    | zero => exact fun A _ h ↦ hS A fun j ↦ h j (Nat.zero_le _)
    | succ k ih =>
      intro A hA hk
      by_cases hkn : k < n
      · set j₀ : Fin n := ⟨k, hkn⟩ with hj₀
        have hcol : A = A.updateCol j₀ (fun i ↦ A i j₀) := by
          ext i j
          by_cases h : j = j₀
          · subst h
            simp
          · simp [h]
        rw [hcol]
        refine Submodule.span_induction (p := fun v _ ↦ (A.updateCol j₀ v).det ∈ I)
          (fun v hv ↦ ?_) ?_ (fun u v _ _ hu hv ↦ ?_) (fun c v _ hv ↦ ?_) (hA j₀)
        · refine ih _ (fun j ↦ ?_) (fun j hj ↦ ?_)
          · by_cases h : j = j₀
            · subst h
              simpa [updateCol_apply] using Submodule.subset_span hv
            · simpa [updateCol_apply, h] using hA j
          · by_cases h : j = j₀
            · subst h
              simpa [updateCol_apply] using hv
            · have hne : (j : ℕ) ≠ k := fun e ↦ h (Fin.ext e)
              simpa [updateCol_apply, h] using hk j (by omega)
        · rw [det_eq_zero_of_column_eq_zero j₀ (fun i ↦ by simp)]
          exact Submodule.zero_mem _
        · rw [det_updateCol_add]
          exact Submodule.add_mem _ hu hv
        · rw [det_updateCol_smul]
          exact Submodule.smul_mem _ _ hv
      · exact ih A hA fun j hj ↦ hk j (by omega)
  exact key n A hA fun j hj ↦ absurd j.2 (by omega)

variable {B : Type*} [CommRing B] [Algebra R B]

/-- **Base change of `Fit₀`** (Stacks, Lemma 15.8.4(3), Tag 07ZA):
`Fit₀(B ⊗_R M) = Fit₀(M) B`. -/
theorem fitt0_baseChange [Module.Finite R M] :
    fitt0 B (B ⊗[R] M) = Ideal.map (algebraMap R B) (fitt0 R M) := by
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let g' : Fin n → B ⊗[R] M := fun i ↦ (1 : B) ⊗ₜ g i
  have hg' : Submodule.span B (Set.range g') = ⊤ := by
    have h := Submodule.baseChange_span (R := R) (A := B) (Set.range g)
    rw [hg, Submodule.baseChange_top] at h
    rw [h, ← Set.range_comp]
    rfl
  rw [fitt0_eq_minorIdeal hg, fitt0_eq_minorIdeal hg']
  apply le_antisymm
  · -- relations over `B` are `B`-combinations of relations over `R` (right exactness)
    let v := Fintype.linearCombination R g
    have hv : Function.Surjective v :=
      (span_range_eq_top_iff_surjective_fintypeLinearCombination R g).1 hg
    have hex := lTensor_exact B (LinearMap.exact_subtype_ker_map v) hv
    let ψ := (Algebra.TensorProduct.piScalarRight R R B (Fin n)).toLinearMap
    let S : Set (Fin n → B) := {w | ∃ a : Fin n → R, IsRel R g a ∧ w = fun i ↦ algebraMap R B (a i)}
    have hspan : ∀ a : Fin n → B, IsRel B g' a → a ∈ Submodule.span B S := by
      intro a ha
      let x : B ⊗[R] (Fin n → R) := ∑ i, a i ⊗ₜ Pi.single i 1
      have hx : LinearMap.lTensor B v x = 0 := by
        simp only [x, map_sum, LinearMap.lTensor_tmul, v,
          Fintype.linearCombination_apply_single, one_smul]
        rw [← ha]
        refine Finset.sum_congr rfl fun i _ ↦ ?_
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      obtain ⟨y, hy⟩ := (hex x).1 hx
      have hψx : ψ x = a := by
        ext j
        simp [x, ψ, Pi.single_apply]
      rw [← hψx, ← hy]
      clear hy
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul b r =>
        simp only [LinearMap.lTensor_tmul, Submodule.subtype_apply, ψ, AlgEquiv.toLinearMap_apply,
          Algebra.TensorProduct.piScalarRight_tmul]
        have : (fun i ↦ (r : Fin n → R) i • b) =
            b • fun i ↦ algebraMap R B ((r : Fin n → R) i) := by
          ext i
          simp [Algebra.smul_def, mul_comm]
        rw [this]
        refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨r, ?_, rfl⟩)
        have := r.2
        rw [LinearMap.mem_ker, Fintype.linearCombination_apply] at this
        exact this
      | add y₁ y₂ h₁ h₂ =>
        rw [map_add, map_add]
        exact Submodule.add_mem _ h₁ h₂
    refine minorIdeal_le_iff.2 fun A hA ↦ det_mem_of_mem_span (fun A₀ hA₀ ↦ ?_) A
      fun j ↦ hspan _ (hA j)
    choose a ha hA₀ using hA₀
    have : A₀ = (algebraMap R B).mapMatrix (Matrix.of fun i j ↦ a j i) := by
      ext i j
      exact congrFun (hA₀ j) i
    rw [this, ← RingHom.map_det]
    exact Ideal.mem_map_of_mem _ (det_mem_minorIdeal _ fun j ↦ ha j)
  · rw [Ideal.map_le_iff_le_comap]
    refine minorIdeal_le_iff.2 fun A hA ↦ ?_
    rw [Ideal.mem_comap, RingHom.map_det]
    refine det_mem_minorIdeal _ fun j ↦ ?_
    have h := hA j
    unfold IsRel at h ⊢
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, g', algebraMap_smul]
    simp_rw [← TensorProduct.tmul_smul, ← TensorProduct.tmul_sum, h, TensorProduct.tmul_zero]

end BaseChange

end CurvesJacobian.Fitting
