import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.Nullstellensatz
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.KrullDimension.Polynomial
import Mathlib.RingTheory.KrullDimension.Field

/-!
# Common zeros of few polynomials without constant term (first input of Tsen's theorem)

Over an algebraically closed field `k`, fewer than `n` polynomials in `n` variables that all
vanish at the origin have a common zero different from the origin. In particular, `r < N`
homogeneous polynomials of positive degree in `N` variables have a nontrivial common zero.

## Proof

Let `I` be the ideal generated by the polynomials and `m₀` the vanishing ideal of the origin.
If the origin were the only common zero, then by the Nullstellensatz every prime containing `I`
contains `m₀`, so `m₀` is a minimal prime over `I`, and Krull's height theorem gives
`ht m₀ ≤ #equations`. On the other hand every maximal ideal is the vanishing ideal of a point
(Nullstellensatz), all of them have the same height as `m₀` (translation automorphism), and the
supremum of the heights of maximal ideals is `dim k[X₁, …, Xₙ] = n`. Hence `n ≤ #equations`.

## Main results

* `CurvesJacobian.Tsen.exists_ne_zero_common_zero_of_card_lt` : version for polynomials with
  vanishing constant coefficient, arbitrary finite index types.
* `CurvesJacobian.Tsen.exists_common_zero_of_card_lt` : homogeneous version, finite index types.
* `CurvesJacobian.Tsen.exists_common_zero_of_lt` : homogeneous version, `Fin r`, `Fin N`.
-/

namespace CurvesJacobian.Tsen

open MvPolynomial

variable {k : Type*} [Field k] {σ : Type*}

/-- The translation automorphism `X i ↦ X i + x i` of `k[X_σ]`. -/
noncomputable def translate (x : σ → k) : MvPolynomial σ k ≃ₐ[k] MvPolynomial σ k :=
  AlgEquiv.ofAlgHom (aeval fun i => X i + C (x i)) (aeval fun i => X i - C (x i))
    (algHom_ext fun i => by simp) (algHom_ext fun i => by simp)

lemma aeval_zero_translate (x : σ → k) (p : MvPolynomial σ k) :
    aeval (0 : σ → k) (translate x p) = aeval x p := by
  have h : (aeval (0 : σ → k)).comp (translate x).toAlgHom = aeval x :=
    algHom_ext fun i => by simp [translate]
  exact DFunLike.congr_fun h p

lemma comap_translate_vanishingIdeal_zero (x : σ → k) :
    (vanishingIdeal k ({0} : Set (σ → k))).comap (translate x).toRingEquiv =
      vanishingIdeal k ({x} : Set (σ → k)) := by
  ext p
  simp only [Ideal.mem_comap, mem_vanishingIdeal_singleton_iff]
  exact iff_of_eq (congrArg (· = 0) (aeval_zero_translate x p))

lemma height_vanishingIdeal_singleton (x : σ → k) :
    (vanishingIdeal k ({x} : Set (σ → k)) : Ideal (MvPolynomial σ k)).height =
      (vanishingIdeal k ({0} : Set (σ → k)) : Ideal (MvPolynomial σ k)).height := by
  rw [← comap_translate_vanishingIdeal_zero x, RingEquiv.height_comap]

variable [IsAlgClosed k]

/-- Over an algebraically closed field, the vanishing ideal of the origin in `k[X_σ]` has
height `#σ`. -/
lemma card_le_height_vanishingIdeal_zero [Fintype σ] :
    (Fintype.card σ : ℕ∞) ≤
      (vanishingIdeal k ({0} : Set (σ → k)) : Ideal (MvPolynomial σ k)).height := by
  have h := Ideal.sup_isMaximal_height_eq_ringKrullDim (R := MvPolynomial σ k)
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
    Nat.card_eq_fintype_card] at h
  have hle : (⨆ (I : Ideal (MvPolynomial σ k)) (_ : I.IsMaximal), I.height) ≤
      (vanishingIdeal k ({0} : Set (σ → k)) : Ideal (MvPolynomial σ k)).height := by
    refine iSup₂_le fun m hm => ?_
    obtain ⟨x, rfl⟩ := eq_vanishingIdeal_singleton_of_isMaximal k hm
    exact (height_vanishingIdeal_singleton x).le
  have h' : ((Fintype.card σ : ℕ∞) : WithBot ℕ∞) =
      ((⨆ (I : Ideal (MvPolynomial σ k)) (_ : I.IsMaximal), I.height : ℕ∞) : WithBot ℕ∞) := by
    rw [h]; rfl
  exact (WithBot.coe_injective h').le.trans hle

/-- Over an algebraically closed field, fewer polynomials than variables, all vanishing at the
origin, have a common zero different from the origin. -/
theorem exists_ne_zero_common_zero_of_card_lt {ι : Type*} [Fintype ι] [Fintype σ]
    (f : ι → MvPolynomial σ k) (hf : ∀ i, constantCoeff (f i) = 0)
    (h : Fintype.card ι < Fintype.card σ) :
    ∃ x : σ → k, x ≠ 0 ∧ ∀ i, eval x (f i) = 0 := by
  classical
  by_contra hne
  push Not at hne
  set I : Ideal (MvPolynomial σ k) := Ideal.span (Set.range f) with hI
  set m₀ : Ideal (MvPolynomial σ k) := vanishingIdeal k ({0} : Set (σ → k)) with hm₀
  have hm₀max : m₀.IsMaximal := isMaximal_iff_eq_vanishingIdeal_singleton.mpr ⟨0, rfl⟩
  have hIm : I ≤ m₀ := by
    rw [hI, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, hm₀, mem_vanishingIdeal_singleton_iff]
    change eval 0 (f i) = 0
    rw [eval_zero]
    exact hf i
  have hzero : zeroLocus k I ⊆ ({0} : Set (σ → k)) := by
    intro x hx
    by_contra hx0
    obtain ⟨i, hi⟩ := hne x hx0
    have := hx (f i) (Ideal.subset_span ⟨i, rfl⟩)
    exact hi this
  have hmin : m₀ ∈ I.minimalPrimes := by
    refine ⟨⟨hm₀max.isPrime, hIm⟩, fun q hq _ => ?_⟩
    obtain ⟨hqp, hIq⟩ := hq
    have hrad : vanishingIdeal k (zeroLocus k q) = q := by
      rw [vanishingIdeal_zeroLocus_eq_radical, hqp.radical]
    rw [← hrad, hm₀]
    exact vanishingIdeal_anti_mono ((zeroLocus_anti_mono hIq).trans hzero)
  have hspan : I = Ideal.span ((Finset.univ.image f : Finset _) : Set (MvPolynomial σ k)) := by
    rw [hI, Finset.coe_image, Finset.coe_univ, Set.image_univ]
  rw [hspan] at hmin
  have hup := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin
  have hcard : ((Finset.univ.image f).card : ℕ∞) ≤ Fintype.card ι := by
    exact_mod_cast Finset.card_image_le.trans (le_of_eq Finset.card_univ)
  have hlow := card_le_height_vanishingIdeal_zero (k := k) (σ := σ)
  have : (Fintype.card σ : ℕ∞) ≤ Fintype.card ι := hlow.trans (hup.trans hcard)
  exact absurd (by exact_mod_cast this) h.not_ge

omit [IsAlgClosed k] in
/-- A homogeneous polynomial of positive degree has vanishing constant coefficient. -/
lemma constantCoeff_eq_zero_of_isHomogeneous {p : MvPolynomial σ k} {d : ℕ} (hd : 0 < d)
    (hp : p.IsHomogeneous d) : constantCoeff p = 0 := by
  rw [show constantCoeff p = coeff 0 p from congrFun constantCoeff_eq p]
  exact hp.coeff_eq_zero (by simp; omega)

/-- Over an algebraically closed field, fewer homogeneous polynomials of positive degree than
variables have a nontrivial common zero (finite index types). -/
theorem exists_common_zero_of_card_lt {ι : Type*} [Fintype ι] [Fintype σ]
    (f : ι → MvPolynomial σ k) (hf : ∀ i, ∃ d, 0 < d ∧ (f i).IsHomogeneous d)
    (h : Fintype.card ι < Fintype.card σ) :
    ∃ x : σ → k, x ≠ 0 ∧ ∀ i, eval x (f i) = 0 :=
  exists_ne_zero_common_zero_of_card_lt f
    (fun i => (hf i).elim fun _ hd => constantCoeff_eq_zero_of_isHomogeneous hd.1 hd.2) h

/-- Over an algebraically closed field, `r < N` homogeneous polynomials of positive degree in
`N` variables have a nontrivial common zero. -/
theorem exists_common_zero_of_lt {N r : ℕ} (f : Fin r → MvPolynomial (Fin N) k)
    (hf : ∀ i, ∃ d, 0 < d ∧ (f i).IsHomogeneous d) (hr : r < N) :
    ∃ x : Fin N → k, x ≠ 0 ∧ ∀ i, eval x (f i) = 0 :=
  exists_common_zero_of_card_lt f hf (by simpa using hr)

end CurvesJacobian.Tsen
