import CurvesJacobian.Picard.CurveGenus
import CurvesJacobian.Picard.ZeroScheme
import CurvesJacobian.Picard.TwoChartTwist
import CurvesJacobian.Scheme.PointDegree
import CurvesJacobian.Picard.CartierCurve

/-!
# Divisors of locally principal ideal sheaves on a curve

Let `Y` be a curve over a perfect field `κ` (`Belyi.IsCurveOver`), integral, with function field
`K(Y)` and places `WeilCurves.FunctionField.Place κ K(Y)` (points of `Y` other than the generic
point, `CurvesJacobian.pointOfPlace`). We compare ideal sheaves on `Y` with Weil divisors of
`K(Y)`.

* `CurvesJacobian.ordAt P hP g`: the order at `P` of a section `g ∈ Γ(Y, W)`, `pointOfPlace P ∈ W`
  (via the germ in `𝒪_{Y,x} ⊆ K(Y)`; `ordAt_eq_ord_germToFunctionField` for nonempty `W`).
* `Scheme.IdealSheafData.IsLocPrincipal I`: locally generated by nonzerodivisors (the shape of
  `RelEffCartier.locally_principal`).
* `Scheme.IdealSheafData.HasDiv I E`: on every affine open where `I` is principal, every generator
  is nonzero with order `E P` at each place `P` of that open. Local criterion
  `HasDiv.of_forall_exists`; `HasDiv.eq` (locally principal ideal sheaves are determined by their
  divisor), `HasDiv.mul`, `hasDiv_top`.
* Zero schemes of sections of invertible sheaves: `CurvesJacobian.hasDiv_zeroIdeal`,
  `isLocPrincipal_zeroIdeal`, `isLocPrincipal_zeroIdeal_of_hasDiv`, and the ratio lemma
  `CurvesJacobian.exists_ord_eq_sub`: if `Z(s)`, `Z(s')` have divisors `E`, `E'`, then `E - E'` is
  the divisor of a nonzero rational function.
* `κ`-points: `hasDiv_ker_of_forall_eq` (a morphism `Spec κ ⟶ Y` hitting the point of `P` has
  ideal sheaf with divisor `P`). For `κ` algebraically closed: `placeSection κ Y P`, a section of
  `Y → Spec κ` through the point of `P` (the residue field there is `κ`), `placeSection_comp`,
  `placeSection_unique`, `exists_eq_placeSection` (every section is a `placeSection`) and
  `hasDiv_ker_placeSection`.
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry Belyi Opposite
open WeilCurves.FunctionField

universe u

noncomputable section

namespace CurvesJacobian

section Integral

variable {Y : Scheme.{u}} [IsIntegral Y]

lemma algebraMap_germ_ne_zero_iff {W : Y.Opens} {x : Y} (hx : x ∈ W) (g : Γ(Y, W)) :
    algebraMap (Y.presheaf.stalk x) Y.functionField (Y.presheaf.germ W x hx g) ≠ 0 ↔ g ≠ 0 := by
  haveI : Nonempty W := ⟨⟨x, hx⟩⟩
  rw [Y.algebraMap_germ_eq_germToFunctionField hx, ne_eq, ne_eq,
    map_eq_zero_iff _ (Y.germToFunctionField_injective W)]

omit [IsIntegral Y] in
lemma ne_zero_of_isSMulRegular {W : Y.Opens} [Nonempty W] {g : Γ(Y, W)}
    (hg : IsSMulRegular Γ(Y, W) g) : g ≠ 0 := by
  rintro rfl
  exact one_ne_zero (hg (show (0 : Γ(Y, W)) • (1 : Γ(Y, W)) = 0 • 0 by simp))

lemma isSMulRegular_of_ne_zero {W : Y.Opens} [Nonempty W] {g : Γ(Y, W)} (hg : g ≠ 0) :
    IsSMulRegular Γ(Y, W) g :=
  fun _ _ h ↦ mul_left_cancel₀ hg h

end Integral

section General

variable {X : Scheme.{u}}

lemma exists_affineOpens_mem_le {x : X} {O : X.Opens} (hx : x ∈ O) :
    ∃ V : X.affineOpens, x ∈ V.1 ∧ V.1 ≤ O := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVO⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open hx O.2
  exact ⟨⟨V, hV⟩, hxV, hVO⟩

lemma ideal_eq_span_res {I : X.IdealSheafData} {U V : X.affineOpens} (h : V ≤ U)
    {g : Γ(X, U.1)} (hI : I.ideal U = Ideal.span {g}) :
    I.ideal V = Ideal.span {X.presheaf.map (homOfLE h).op g} := by
  rw [← I.map_ideal h, hI, Ideal.map_span, Set.image_singleton]

end General

section Curve

variable {κ : Type u} [Field κ] [PerfectField κ] {Y : Scheme.{u}} [Y.Over (Spec (.of κ))]
  [IsCurveOver κ Y] [IsIntegral Y]

/-- The order at the place `P` of a section `g ∈ Γ(Y, W)` over an open `W` containing the point
of `P`: the `P`-adic order of the image in `K(Y)` of the germ of `g` at `pointOfPlace κ Y P`. -/
def ordAt (P : Place κ Y.functionField) {W : Y.Opens} (hP : pointOfPlace κ Y P ∈ W)
    (g : Γ(Y, W)) : ℤ :=
  P.ord (algebraMap (Y.presheaf.stalk (pointOfPlace κ Y P)) Y.functionField
    (Y.presheaf.germ W _ hP g))

lemma ordAt_eq_ord_germToFunctionField (P : Place κ Y.functionField) {W : Y.Opens}
    [Nonempty W] (hP : pointOfPlace κ Y P ∈ W) (g : Γ(Y, W)) :
    ordAt P hP g = P.ord (Y.germToFunctionField W g) := by
  rw [ordAt, Y.algebraMap_germ_eq_germToFunctionField hP]

lemma ordAt_res (P : Place κ Y.functionField) {W W' : Y.Opens} (h : W' ≤ W)
    (hP : pointOfPlace κ Y P ∈ W') (g : Γ(Y, W)) :
    ordAt P hP (Y.presheaf.map (homOfLE h).op g) = ordAt P (h hP) g := by
  rw [ordAt, ordAt, Y.presheaf.germ_res_apply]

lemma ordAt_nonneg (P : Place κ Y.functionField) {W : Y.Opens} (hP : pointOfPlace κ Y P ∈ W)
    (g : Γ(Y, W)) : 0 ≤ ordAt P hP g := by
  apply P.ord_nonneg_of_mem
  rw [place_val_eq]
  exact (mem_stalkValuationSubring_iff _ _ _).2 ⟨_, rfl⟩

lemma ordAt_mul (P : Place κ Y.functionField) {W : Y.Opens} (hP : pointOfPlace κ Y P ∈ W)
    {g h : Γ(Y, W)} (hg : g ≠ 0) (hh : h ≠ 0) :
    ordAt P hP (g * h) = ordAt P hP g + ordAt P hP h := by
  rw [ordAt, map_mul, map_mul, P.ord_mul ((algebraMap_germ_ne_zero_iff hP g).2 hg)
    ((algebraMap_germ_ne_zero_iff hP h).2 hh)]
  rfl

lemma ordAt_one (P : Place κ Y.functionField) {W : Y.Opens} (hP : pointOfPlace κ Y P ∈ W) :
    ordAt P hP (1 : Γ(Y, W)) = 0 := by
  rw [ordAt, map_one, map_one, P.ord_one]

lemma ordAt_eq_zero_iff_isUnit (P : Place κ Y.functionField) {W : Y.Opens}
    (hP : pointOfPlace κ Y P ∈ W) {g : Γ(Y, W)} (hg : g ≠ 0) :
    ordAt P hP g = 0 ↔ IsUnit (Y.presheaf.germ W _ hP g) := by
  set s := Y.presheaf.germ W _ hP g
  have hs : algebraMap _ Y.functionField s ≠ 0 := (algebraMap_germ_ne_zero_iff hP g).2 hg
  rw [ordAt, P.ord_eq_zero_iff hs, place_val_eq, mem_stalkValuationSubring_iff,
    mem_stalkValuationSubring_iff]
  constructor
  · rintro ⟨-, t, ht⟩
    refine IsUnit.of_mul_eq_one t (algebraMap_stalk_injective _ ?_)
    rw [map_mul, ht, map_one, mul_inv_cancel₀ hs]
  · rintro ⟨u, hu⟩
    refine ⟨⟨s, rfl⟩, ↑u⁻¹, ?_⟩
    rw [← hu]
    refine eq_inv_of_mul_eq_one_left ?_
    rw [← map_mul, Units.inv_mul, map_one]

lemma ordAt_pos_iff (P : Place κ Y.functionField) {W : Y.Opens}
    (hP : pointOfPlace κ Y P ∈ W) {g : Γ(Y, W)} (hg : g ≠ 0) :
    0 < ordAt P hP g ↔ pointOfPlace κ Y P ∉ Y.basicOpen g := by
  rw [Scheme.mem_basicOpen _ _ _ hP, ← ordAt_eq_zero_iff_isUnit P hP hg]
  have := ordAt_nonneg P hP g
  omega

lemma ordAt_unit_mul (P : Place κ Y.functionField) {W : Y.Opens} (hP : pointOfPlace κ Y P ∈ W)
    {g : Γ(Y, W)} (u : Γ(Y, W)ˣ) : ordAt P hP (g * u) = ordAt P hP g := by
  haveI : Nonempty W := ⟨⟨_, hP⟩⟩
  by_cases hg : g = 0
  · rw [hg, zero_mul]
  rw [ordAt_mul P hP hg u.ne_zero, (ordAt_eq_zero_iff_isUnit P hP u.ne_zero).2
    ((u.isUnit).map _), add_zero]

variable (κ) in
/-- Two sections over a nonempty open `W` with `ord_P b ≤ ord_P a` at all places of `W` (and
`b ≠ 0`): `b` divides `a` in `Γ(Y, W)`. -/
lemma exists_mul_eq_of_ordAt_le {W : Y.Opens} [Nonempty W] {a b : Γ(Y, W)} (hb : b ≠ 0)
    (h : ∀ (P : Place κ Y.functionField) (hP : pointOfPlace κ Y P ∈ W),
      ordAt P hP b ≤ ordAt P hP a) : ∃ c, a = c * b := by
  by_cases ha : a = 0
  · exact ⟨0, by rw [ha, zero_mul]⟩
  have hb' : Y.germToFunctionField W b ≠ 0 :=
    (map_ne_zero_iff _ (Y.germToFunctionField_injective W)).2 hb
  have ha' : Y.germToFunctionField W a ≠ 0 :=
    (map_ne_zero_iff _ (Y.germToFunctionField_injective W)).2 ha
  obtain ⟨c, hc⟩ := (mem_regularOutside_iff κ Y W (mem_placesOutside κ Y W)
    (Y.germToFunctionField W a / Y.germToFunctionField W b)).1 (by
      intro P hP
      rw [mem_placesOutside, not_not] at hP
      apply P.mem_of_ord_nonneg
      rw [P.ord_div ha' hb', ← ordAt_eq_ord_germToFunctionField P hP,
        ← ordAt_eq_ord_germToFunctionField P hP, sub_nonneg]
      exact h P hP)
  refine ⟨c, Y.germToFunctionField_injective W ?_⟩
  rw [map_mul, hc, div_mul_cancel₀ _ hb']

end Curve

end CurvesJacobian

namespace AlgebraicGeometry.Scheme.IdealSheafData

open CurvesJacobian

/-- An ideal sheaf is *locally principal*: every point has an affine neighbourhood `U` on which
the ideal is generated by a nonzerodivisor (the shape of `RelEffCartier.locally_principal`). -/
def IsLocPrincipal {X : Scheme.{u}} (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ (U : X.affineOpens) (g : Γ(X, U.1)), x ∈ U.1 ∧
    I.ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X, U.1) g

lemma IsLocPrincipal.mul {X : Scheme.{u}} {I J : X.IdealSheafData} (hI : I.IsLocPrincipal)
    (hJ : J.IsLocPrincipal) : (I * J).IsLocPrincipal := by
  intro x
  obtain ⟨W, g, h, hxW, -, hgI, hg, hhJ, hh⟩ :=
    RelEffCartier.exists_affine_principal_principal hI hJ x ⊤ trivial
  refine ⟨W, g * h, hxW, ?_, hg.mul hh⟩
  rw [IdealSheafData.ideal_mul, Pi.mul_apply, hgI, hhJ, Ideal.span_singleton_mul_span_singleton]

lemma isLocPrincipal_top {X : Scheme.{u}} : (⊤ : X.IdealSheafData).IsLocPrincipal := by
  intro x
  obtain ⟨W, hxW, -⟩ := exists_affineOpens_mem_le (O := ⊤) (x := x) trivial
  exact ⟨W, 1, hxW, by rw [ideal_top, Pi.top_apply, Ideal.span_singleton_one], IsSMulRegular.one _⟩

variable {κ : Type u} [Field κ] [PerfectField κ] {Y : Scheme.{u}} [Y.Over (Spec (.of κ))]
  [IsCurveOver κ Y] [IsIntegral Y]

/-- `I` *has divisor* `E`: on every affine open `W` on which `I` is principal, any generator `g`
is nonzero and has order `E P` at every place `P` whose point lies in `W`. -/
def HasDiv (I : Y.IdealSheafData) (E : Divisor κ Y.functionField) : Prop :=
  ∀ (W : Y.affineOpens) (g : Γ(Y, W.1)), I.ideal W = Ideal.span {g} →
    ∀ (P : Place κ Y.functionField) (hP : pointOfPlace κ Y P ∈ W.1), g ≠ 0 ∧ ordAt P hP g = E P

/-- **Local criterion for `HasDiv`**: it suffices to find, for every place `P`, one affine
neighbourhood of its point with a nonzero generator of order `E P` at `P`. -/
theorem HasDiv.of_forall_exists {I : Y.IdealSheafData} {E : Divisor κ Y.functionField}
    (H : ∀ P : Place κ Y.functionField, ∃ (W : Y.affineOpens) (g : Γ(Y, W.1))
      (hP : pointOfPlace κ Y P ∈ W.1), I.ideal W = Ideal.span {g} ∧ g ≠ 0 ∧ ordAt P hP g = E P) :
    I.HasDiv E := by
  intro W' g' hg' P hP'
  obtain ⟨W, g, hP, hI, hg0, hord⟩ := H P
  obtain ⟨V, hPV, hVle⟩ := exists_affineOpens_mem_le (O := W.1 ⊓ W'.1) ⟨hP, hP'⟩
  have hVW : V.1 ≤ W.1 := hVle.trans inf_le_left
  have hVW' : V.1 ≤ W'.1 := hVle.trans inf_le_right
  haveI : Nonempty V.1 := ⟨⟨_, hPV⟩⟩
  have h1 : Ideal.span {(Y.presheaf.map (homOfLE hVW').op g' : Γ(Y, V.1))} =
      Ideal.span {(Y.presheaf.map (homOfLE hVW).op g : Γ(Y, V.1))} :=
    (ideal_eq_span_res hVW' hg').symm.trans (ideal_eq_span_res hVW hI)
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.1 h1
  have hgV : Y.presheaf.map (homOfLE hVW).op g ≠ 0 := by
    rw [← algebraMap_germ_ne_zero_iff hPV, Y.presheaf.germ_res_apply]
    exact (algebraMap_germ_ne_zero_iff hP g).2 hg0
  refine ⟨fun h ↦ hgV ?_, ?_⟩
  · rw [← hu, h, map_zero, zero_mul]
  · rw [← hord, ← ordAt_res P hVW' hPV, ← ordAt_unit_mul P hPV u, hu, ordAt_res]

/-- Two locally principal ideal sheaves with the same divisor are equal. -/
theorem HasDiv.eq {I J : Y.IdealSheafData} {E : Divisor κ Y.functionField} (hI : I.HasDiv E)
    (hJ : J.HasDiv E) (hI' : I.IsLocPrincipal) (hJ' : J.IsLocPrincipal) : I = J := by
  choose W g h hxW _ hgI hg hhJ hh using fun x : Y ↦
    RelEffCartier.exists_affine_principal_principal hI' hJ' x ⊤ trivial
  refine IdealSheafData.ext_of_iSup_eq_top W
    (eq_top_iff.mpr fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxW x⟩) fun x ↦ ?_
  haveI : Nonempty (W x).1 := ⟨⟨x, hxW x⟩⟩
  have key : ∀ (P : Place κ Y.functionField) (hP : pointOfPlace κ Y P ∈ (W x).1),
      ordAt P hP (g x) = ordAt P hP (h x) := fun P hP ↦
    (hI _ _ (hgI x) P hP).2.trans (hJ _ _ (hhJ x) P hP).2.symm
  obtain ⟨c, hc⟩ := exists_mul_eq_of_ordAt_le κ (ne_zero_of_isSMulRegular (hh x))
    (a := g x) fun P hP ↦ (key P hP).ge
  obtain ⟨c', hc'⟩ := exists_mul_eq_of_ordAt_le κ (ne_zero_of_isSMulRegular (hg x))
    (a := h x) fun P hP ↦ (key P hP).le
  rw [hgI, hhJ]
  refine le_antisymm (Ideal.span_singleton_le_span_singleton.2 ⟨c, ?_⟩)
    (Ideal.span_singleton_le_span_singleton.2 ⟨c', ?_⟩)
  · rw [hc, mul_comm]
  · rw [hc', mul_comm]

/-- Divisors of products of locally principal ideal sheaves add. -/
theorem HasDiv.mul {I J : Y.IdealSheafData} {E E' : Divisor κ Y.functionField}
    (hI : I.HasDiv E) (hJ : J.HasDiv E') (hI' : I.IsLocPrincipal) (hJ' : J.IsLocPrincipal) :
    (I * J).HasDiv (E + E') := by
  refine HasDiv.of_forall_exists fun P ↦ ?_
  obtain ⟨W, g, h, hxW, -, hgI, hg, hhJ, hh⟩ :=
    RelEffCartier.exists_affine_principal_principal hI' hJ' (pointOfPlace κ Y P) ⊤ trivial
  haveI : Nonempty W.1 := ⟨⟨_, hxW⟩⟩
  have hg0 := ne_zero_of_isSMulRegular hg
  have hh0 := ne_zero_of_isSMulRegular hh
  refine ⟨W, g * h, hxW, ?_, mul_ne_zero hg0 hh0, ?_⟩
  · rw [IdealSheafData.ideal_mul, Pi.mul_apply, hgI, hhJ, Ideal.span_singleton_mul_span_singleton]
  · rw [ordAt_mul P hxW hg0 hh0, (hI W g hgI P hxW).2, (hJ W h hhJ P hxW).2, Finsupp.add_apply]

/-- The unit ideal sheaf has divisor `0`. -/
theorem hasDiv_top : (⊤ : Y.IdealSheafData).HasDiv (0 : Divisor κ Y.functionField) :=
  HasDiv.of_forall_exists fun P ↦ by
    obtain ⟨W, hxW, -⟩ := exists_affineOpens_mem_le (O := ⊤) (x := pointOfPlace κ Y P) trivial
    haveI : Nonempty W.1 := ⟨⟨_, hxW⟩⟩
    exact ⟨W, 1, hxW, by rw [ideal_top, Pi.top_apply, Ideal.span_singleton_one], one_ne_zero,
      by rw [ordAt_one]; rfl⟩

end AlgebraicGeometry.Scheme.IdealSheafData

namespace CurvesJacobian

open Scheme ModulesGlue

section General

variable {X : Scheme.{u}}

/-- An invertible sheaf has a basis on an affine neighbourhood of every point. -/
lemma exists_isBasisOn_affineOpens (L : X.Modules) [L.IsInvertible] (x : X) :
    ∃ (W : X.affineOpens) (e : Γ(L, W.1)), x ∈ W.1 ∧ L.IsBasisOn W.1 e := by
  obtain ⟨U, e, hxU, he⟩ := Scheme.Modules.IsInvertible.exists_basis (L := L) x
  obtain ⟨W, hxW, hWU⟩ := exists_affineOpens_mem_le hxU
  exact ⟨W, _, hxW, isBasisOn_rs he hWU⟩

end General

variable {κ : Type u} [Field κ] [PerfectField κ] {Y : Scheme.{u}} [Y.Over (Spec (.of κ))]
  [IsCurveOver κ Y] [IsIntegral Y]

variable (κ) in
/-- Every nonempty open of a curve contains the point of some place. -/
lemma exists_pointOfPlace_mem (W : Y.Opens) [Nonempty W] :
    ∃ P : Place κ Y.functionField, pointOfPlace κ Y P ∈ W := by
  obtain ⟨P, hP⟩ := exists_place_notMem κ (placesOutside κ Y W)
  exact ⟨P, not_not.mp ((mem_placesOutside κ Y W P).not.mp hP)⟩

/-- **Zero schemes of sections.** If near every place `P` the section `s` of the invertible
sheaf `L` has a nonzero coordinate `a` of order `E P` with respect to a local basis, then the
zero scheme of `s` has divisor `E`. -/
theorem hasDiv_zeroIdeal (L : Y.Modules) [L.IsInvertible] (s : Γ(L, ⊤))
    (E : Divisor κ Y.functionField)
    (H : ∀ P : Place κ Y.functionField, ∃ (W : Y.affineOpens) (e : Γ(L, W.1)) (a : Γ(Y, W.1))
      (hP : pointOfPlace κ Y P ∈ W.1), L.IsBasisOn W.1 e ∧
        L.presheaf.map (homOfLE le_top).op s = a • e ∧ a ≠ 0 ∧ ordAt P hP a = E P) :
    (Modules.zeroIdeal L s).HasDiv E :=
  IdealSheafData.HasDiv.of_forall_exists fun P ↦ by
    obtain ⟨W, e, a, hP, he, hs, ha, hord⟩ := H P
    exact ⟨W, a, hP, Modules.zeroIdeal_ideal_of_isBasisOn L s he hs, ha, hord⟩

/-- The zero scheme of a section of an invertible sheaf whose coordinates in local bases are
nonzero (on nonempty affine opens) is locally principal. -/
theorem isLocPrincipal_zeroIdeal (L : Y.Modules) [L.IsInvertible] (s : Γ(L, ⊤))
    (hs : ∀ (W : Y.affineOpens) (e : Γ(L, W.1)) (a : Γ(Y, W.1)), (W.1 : Set Y).Nonempty →
      L.IsBasisOn W.1 e → L.presheaf.map (homOfLE le_top).op s = a • e → a ≠ 0) :
    (Modules.zeroIdeal L s).IsLocPrincipal := by
  intro x
  obtain ⟨W, e, hxW, he⟩ := exists_isBasisOn_affineOpens L x
  obtain ⟨a, ha⟩ := exists_smul_eq_of_isBasisOn he (L.presheaf.map (homOfLE le_top).op s)
  haveI : Nonempty W.1 := ⟨⟨x, hxW⟩⟩
  exact ⟨W, a, hxW, Modules.zeroIdeal_ideal_of_isBasisOn L s he ha.symm,
    isSMulRegular_of_ne_zero (hs W e a ⟨x, hxW⟩ he ha.symm)⟩

/-- A zero scheme with a divisor is locally principal. -/
theorem isLocPrincipal_zeroIdeal_of_hasDiv (L : Y.Modules) [L.IsInvertible] (s : Γ(L, ⊤))
    {E : Divisor κ Y.functionField} (hE : (Modules.zeroIdeal L s).HasDiv E) :
    (Modules.zeroIdeal L s).IsLocPrincipal := by
  refine isLocPrincipal_zeroIdeal L s fun W e a hW he ha ↦ ?_
  haveI : Nonempty W.1 := hW.to_subtype
  obtain ⟨P, hP⟩ := exists_pointOfPlace_mem κ W.1
  exact (hE W a (Modules.zeroIdeal_ideal_of_isBasisOn L s he ha) P hP).1

/-- **Ratio of two sections.** If the zero schemes of two sections `s`, `s'` of an invertible
sheaf have divisors `E`, `E'`, then `E - E'` is the divisor of a rational function (the ratio of
the coordinates of `s` and `s'` in any local basis). -/
theorem exists_ord_eq_sub (L : Y.Modules) [L.IsInvertible] (s s' : Γ(L, ⊤))
    {E E' : Divisor κ Y.functionField} (hs : (Modules.zeroIdeal L s).HasDiv E)
    (hs' : (Modules.zeroIdeal L s').HasDiv E') :
    ∃ f : Y.functionField, f ≠ 0 ∧ ∀ P : Place κ Y.functionField, P.ord f = E P - E' P := by
  have chart : ∀ (W : Y.affineOpens) (e : Γ(L, W.1)) (P : Place κ Y.functionField)
      (hP : pointOfPlace κ Y P ∈ W.1), L.IsBasisOn W.1 e → ∃ a a' : Γ(Y, W.1),
        L.presheaf.map (homOfLE le_top).op s = a • e ∧
        L.presheaf.map (homOfLE le_top).op s' = a' • e ∧ a ≠ 0 ∧ a' ≠ 0 ∧
        ordAt P hP a = E P ∧ ordAt P hP a' = E' P := by
    intro W e P hP he
    obtain ⟨a, ha⟩ := exists_smul_eq_of_isBasisOn he (L.presheaf.map (homOfLE le_top).op s)
    obtain ⟨a', ha'⟩ := exists_smul_eq_of_isBasisOn he (L.presheaf.map (homOfLE le_top).op s')
    have h1 := hs W a (Modules.zeroIdeal_ideal_of_isBasisOn L s he ha.symm) P hP
    have h2 := hs' W a' (Modules.zeroIdeal_ideal_of_isBasisOn L s' he ha'.symm) P hP
    exact ⟨a, a', ha.symm, ha'.symm, h1.1, h2.1, h1.2, h2.2⟩
  obtain ⟨P0⟩ : Nonempty (Place κ Y.functionField) :=
    ⟨curvePlaceEquiv κ Y (nonempty_closedPoint κ Y).some⟩
  obtain ⟨W0, e0, hP0, he0⟩ := exists_isBasisOn_affineOpens L (pointOfPlace κ Y P0)
  obtain ⟨a0, a0', h0, h0', ha0, ha0', -, -⟩ := chart W0 e0 P0 hP0 he0
  haveI : Nonempty W0.1 := ⟨⟨_, hP0⟩⟩
  have hinj : ∀ (W : Y.Opens) [Nonempty W] (b : Γ(Y, W)), b ≠ 0 →
      Y.germToFunctionField W b ≠ 0 := fun W _ b hb ↦
    (map_ne_zero_iff _ (Y.germToFunctionField_injective W)).2 hb
  refine ⟨Y.germToFunctionField W0.1 a0 / Y.germToFunctionField W0.1 a0',
    div_ne_zero (hinj _ _ ha0) (hinj _ _ ha0'), fun P ↦ ?_⟩
  obtain ⟨W1, e1, hP1, he1⟩ := exists_isBasisOn_affineOpens L (pointOfPlace κ Y P)
  obtain ⟨a1, a1', h1, h1', ha1, ha1', ho1, ho1'⟩ := chart W1 e1 P hP1 he1
  haveI : Nonempty W1.1 := ⟨⟨_, hP1⟩⟩
  let V : Y.Opens := W0.1 ⊓ W1.1
  haveI : Nonempty V :=
    ⟨⟨genericPoint Y, genericPoint_mem_of_nonempty _, genericPoint_mem_of_nonempty _⟩⟩
  have hV0 : V ≤ W0.1 := inf_le_left
  have hV1 : V ≤ W1.1 := inf_le_right
  obtain ⟨u, hu⟩ := TwoChart.exists_unit_smul_eq (isBasisOn_rs he1 hV1) (isBasisOn_rs he0 hV0)
  have key : ∀ (t : Γ(L, ⊤)) (b0 : Γ(Y, W0.1)) (b1 : Γ(Y, W1.1)),
      L.presheaf.map (homOfLE le_top).op t = b0 • e0 →
      L.presheaf.map (homOfLE le_top).op t = b1 • e1 →
      Y.germToFunctionField W0.1 b0 * Y.germToFunctionField V u =
        Y.germToFunctionField W1.1 b1 := by
    intro t b0 b1 hb0 hb1
    have : rr hV0 b0 * u = rr hV1 b1 := by
      apply smul_left_injective_of_isBasisOn (isBasisOn_rs he1 hV1)
      rw [mul_smul, hu, ← rs_smul, ← rs_smul, ← hb0, ← hb1, rs_rs, rs_rs]
    rw [← germToFunctionField_res (homOfLE hV0) b0, ← germToFunctionField_res (homOfLE hV1) b1]
    exact (map_mul _ _ _).symm.trans (congrArg _ this)
  have hu0 : Y.germToFunctionField V u ≠ 0 := hinj V _ u.ne_zero
  rw [← mul_div_mul_right _ _ hu0, key s a0 a1 h0 h1, key s' a0' a1' h0' h1',
    P.ord_div (hinj _ _ ha1) (hinj _ _ ha1'), ← ordAt_eq_ord_germToFunctionField P hP1,
    ← ordAt_eq_ord_germToFunctionField P hP1, ho1, ho1']

/-! ### The divisor of a `κ`-point -/

section Ker

omit [PerfectField κ] [Y.Over (Spec (.of κ))] [IsCurveOver κ Y] [IsIntegral Y] in
/-- A function `r` on an affine open lies in the kernel ideal of `s : Spec κ ⟶ Y` iff it vanishes
at the image point, i.e. iff the image point is not in `D(r)`. -/
lemma mem_ker_ideal_iff (s : Spec (.of κ) ⟶ Y) (W : Y.affineOpens) (r : Γ(Y, W.1)) :
    r ∈ s.ker.ideal W ↔ ∀ z, s z ∉ Y.basicOpen r := by
  rw [Scheme.Hom.ker_apply, RingHom.mem_ker, ← basicOpen_eq_bot_iff, ← Scheme.preimage_basicOpen,
    eq_bot_iff]
  exact ⟨fun h z hz ↦ h hz, fun h z hz ↦ (h z hz).elim⟩

variable (κ) in
/-- A local uniformizer at a place `P`: an affine neighbourhood `V` of the point of `P` with a
function `π` of order `1` at `P` which vanishes at no other point of `V`. -/
lemma exists_uniformizer (P : Place κ Y.functionField) :
    ∃ (V : Y.affineOpens) (π : Γ(Y, V.1)) (hP : pointOfPlace κ Y P ∈ V.1), π ≠ 0 ∧
      ordAt P hP π = 1 ∧ ∀ y ∈ V.1, y ∉ Y.basicOpen π → y = pointOfPlace κ Y P := by
  set x := pointOfPlace κ Y P
  obtain ⟨f, hf⟩ := P.exists_ord_eq_one
  have hfmem : f ∈ P.1 := P.mem_of_ord_nonneg (by rw [hf]; norm_num)
  rw [place_val_eq, mem_stalkValuationSubring_iff] at hfmem
  obtain ⟨t, ht⟩ := hfmem
  obtain ⟨U, hxU, b, hb⟩ := Y.presheaf.exists_germ_eq t
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  have hb0 : b ≠ 0 := by
    rintro rfl
    rw [map_zero] at hb
    rw [← hb, map_zero] at ht
    rw [← ht, P.ord_zero] at hf
    exact zero_ne_one hf
  have hη : genericPoint Y ∈ Y.basicOpen b := by
    rw [Scheme.mem_basicOpen _ _ _ (genericPoint_mem_of_nonempty U)]
    change IsUnit (Y.germToFunctionField U b)
    exact isUnit_iff_ne_zero.2 ((map_ne_zero_iff _ (Y.germToFunctionField_injective U)).2 hb0)
  haveI : Nonempty (Y.basicOpen b) := ⟨⟨_, hη⟩⟩
  let F : Set Y := (Y.basicOpen b : Set Y)ᶜ \ {x}
  have hFfin : F.Finite := (finite_compl_of_nonempty κ Y (Y.basicOpen b)).subset Set.sdiff_subset
  have hFcl : IsClosed F := by
    have := hFfin.isClosed_biUnion fun y hy ↦ (isClosed_singleton_iff κ Y y).2
      fun h ↦ hy.1 (h ▸ hη)
    rwa [Set.biUnion_of_singleton] at this
  let O : Y.Opens := U ⊓ ⟨Fᶜ, hFcl.isOpen_compl⟩
  have hxO : x ∈ O := ⟨hxU, fun h ↦ h.2 rfl⟩
  obtain ⟨V, hxV, hVO⟩ := exists_affineOpens_mem_le hxO
  have hVU : V.1 ≤ U := hVO.trans inf_le_left
  refine ⟨V, Y.presheaf.map (homOfLE hVU).op b, hxV, ?_, ?_, ?_⟩
  · rw [← algebraMap_germ_ne_zero_iff hxV, Y.presheaf.germ_res_apply]
    exact (algebraMap_germ_ne_zero_iff hxU b).2 hb0
  · rw [ordAt_res, ordAt, hb, ht, hf]
  · intro y hyV hy
    by_contra hne
    rw [Y.basicOpen_res] at hy
    exact (hVO hyV).2 ⟨fun h ↦ hy ⟨hyV, h⟩, hne⟩

/-- Near the point of `P`, the kernel ideal of a `κ`-point at `P` is generated by a local
uniformizer. -/
lemma ker_ideal_eq_span_uniformizer {P : Place κ Y.functionField} (s : Spec (.of κ) ⟶ Y)
    (hs : ∀ z, s z = pointOfPlace κ Y P) {V : Y.affineOpens} {π : Γ(Y, V.1)}
    (hP : pointOfPlace κ Y P ∈ V.1) (hπ : π ≠ 0) (h1 : ordAt P hP π = 1)
    (hz : ∀ y ∈ V.1, y ∉ Y.basicOpen π → y = pointOfPlace κ Y P) :
    s.ker.ideal V = Ideal.span {π} := by
  apply le_antisymm
  · intro r hr
    rw [mem_ker_ideal_iff] at hr
    by_cases hr0 : r = 0
    · rw [hr0]
      exact zero_mem _
    haveI : Nonempty V.1 := ⟨⟨_, hP⟩⟩
    obtain ⟨c, rfl⟩ := exists_mul_eq_of_ordAt_le κ hπ (a := r) fun Q hQ ↦ by
      by_cases hQP : pointOfPlace κ Y Q ∈ Y.basicOpen π
      · have : ¬ 0 < ordAt Q hQ π := by rw [ordAt_pos_iff Q hQ hπ, not_not]; exact hQP
        linarith [ordAt_nonneg Q hQ r]
      · obtain rfl := pointOfPlace_injective κ Y (hz _ hQ hQP)
        have := (ordAt_pos_iff Q hQ hr0).2 (by
          rw [← hs (IsLocalRing.closedPoint κ)]
          exact hr _)
        rw [h1]
        omega
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_singleton_le_iff_mem, mem_ker_ideal_iff]
    intro z
    rw [hs z, ← ordAt_pos_iff P hP hπ, h1]
    exact one_pos

variable (κ) in
/-- Points other than the point of `P` have affine neighbourhoods avoiding it. -/
lemma exists_affineOpens_notMem (P : Place κ Y.functionField) {y : Y}
    (hy : y ≠ pointOfPlace κ Y P) :
    ∃ V : Y.affineOpens, y ∈ V.1 ∧ pointOfPlace κ Y P ∉ V.1 := by
  have hcl : IsClosed {pointOfPlace κ Y P} :=
    isClosed_closedPoint κ Y ((curvePlaceEquiv κ Y).symm P)
  obtain ⟨V, hyV, hVO⟩ := exists_affineOpens_mem_le (O := ⟨_, hcl.isOpen_compl⟩) hy
  exact ⟨V, hyV, fun h ↦ hVO h rfl⟩

/-- Away from the point of `P`, the kernel ideal of a `κ`-point at `P` is the unit ideal. -/
lemma ker_ideal_eq_top {P : Place κ Y.functionField} (s : Spec (.of κ) ⟶ Y)
    (hs : ∀ z, s z = pointOfPlace κ Y P) {V : Y.affineOpens} (hV : pointOfPlace κ Y P ∉ V.1) :
    s.ker.ideal V = Ideal.span {1} := by
  rw [Ideal.span_singleton_one, eq_top_iff]
  intro r _
  rw [mem_ker_ideal_iff]
  intro z hz
  rw [hs] at hz
  exact hV (Y.basicOpen_le r hz)

/-- **The divisor of a `κ`-point.** The ideal sheaf of (the image of) a morphism
`s : Spec κ ⟶ Y` hitting the point of the place `P` has divisor `P`. -/
theorem hasDiv_ker_of_forall_eq (P : Place κ Y.functionField) (s : Spec (.of κ) ⟶ Y)
    (hs : ∀ z, s z = pointOfPlace κ Y P) : s.ker.HasDiv (Finsupp.single P 1) :=
  IdealSheafData.HasDiv.of_forall_exists fun Q ↦ by
    by_cases hQ : Q = P
    · subst hQ
      obtain ⟨V, π, hP, hπ, h1, hz⟩ := exists_uniformizer κ Q
      exact ⟨V, π, hP, ker_ideal_eq_span_uniformizer s hs hP hπ h1 hz, hπ,
        by rw [h1, Finsupp.single_eq_same]⟩
    · obtain ⟨V, hyV, hxV⟩ :=
        exists_affineOpens_notMem κ P fun h ↦ hQ (pointOfPlace_injective κ Y h)
      haveI : Nonempty V.1 := ⟨⟨_, hyV⟩⟩
      exact ⟨V, 1, hyV, ker_ideal_eq_top s hs hxV, one_ne_zero,
        by rw [ordAt_one, Finsupp.single_apply, if_neg (Ne.symm hQ)]⟩

/-- The ideal sheaf of a `κ`-point at a place is locally principal. -/
theorem isLocPrincipal_ker_of_forall_eq (P : Place κ Y.functionField) (s : Spec (.of κ) ⟶ Y)
    (hs : ∀ z, s z = pointOfPlace κ Y P) : s.ker.IsLocPrincipal := by
  intro y
  by_cases hy : y = pointOfPlace κ Y P
  · subst hy
    obtain ⟨V, π, hP, hπ, h1, hz⟩ := exists_uniformizer κ P
    haveI : Nonempty V.1 := ⟨⟨_, hP⟩⟩
    exact ⟨V, π, hP, ker_ideal_eq_span_uniformizer s hs hP hπ h1 hz, isSMulRegular_of_ne_zero hπ⟩
  · obtain ⟨V, hyV, hxV⟩ := exists_affineOpens_notMem κ P hy
    exact ⟨V, 1, hyV, ker_ideal_eq_top s hs hxV, IsSMulRegular.one _⟩

end Ker

/-! ### Rational points of a curve over an algebraically closed field -/

section Rational

variable (κ Y) in
/-- The structure map `κ → κ(x)` of the residue field at a point (the ring map underlying
`CurvesJacobian.residueFieldAlgebra`). -/
def residueFieldStructureMap (x : Y) : CommRingCat.of κ ⟶ Y.residueField x :=
  (Scheme.ΓSpecIso (CommRingCat.of κ)).inv ≫ (Y ↘ Spec (CommRingCat.of κ)).appTop ≫
    Y.presheaf.germ ⊤ x trivial ≫ Y.residue x

omit [PerfectField κ] [IsCurveOver κ Y] [IsIntegral Y] in
lemma fromSpecResidueField_comp_structure (x : Y) :
    Y.fromSpecResidueField x ≫ (Y ↘ Spec (.of κ)) = Spec.map (residueFieldStructureMap κ Y x) := by
  rw [Scheme.fromSpecResidueField, ← Category.comp_id (Y ↘ Spec (.of κ)),
    ← toSpecΓ_SpecMap_ΓSpecIso_inv, Scheme.toSpecΓ_naturality_assoc, Category.assoc,
    Scheme.fromSpecStalk_toSpecΓ_assoc, residueFieldStructureMap, Spec.map_comp, Spec.map_comp,
    Spec.map_comp]
  simp only [Category.assoc]

omit [PerfectField κ] [IsCurveOver κ Y] [IsIntegral Y] in
lemma specMap_comp_structure_eq_id_iff (x : Y) (ψ : Y.residueField x ⟶ .of κ) :
    Spec.map ψ ≫ Y.fromSpecResidueField x ≫ (Y ↘ Spec (.of κ)) = 𝟙 _ ↔
      residueFieldStructureMap κ Y x ≫ ψ = 𝟙 _ := by
  rw [fromSpecResidueField_comp_structure, ← Spec.map_comp, ← Spec.map_id, Spec.map_inj]

omit [PerfectField κ] [Y.Over (Spec (.of κ))] [IsCurveOver κ Y] [IsIntegral Y] in
lemma exists_eq_specMap_comp_fromSpecResidueField (s : Spec (.of κ) ⟶ Y) {x : Y}
    (hx : s (IsLocalRing.closedPoint κ) = x) :
    ∃ ψ : Y.residueField x ⟶ .of κ, s = Spec.map ψ ≫ Y.fromSpecResidueField x := by
  subst hx
  exact ⟨_, (Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField κ Y s).symm⟩

/-- The image of a section of `Y → Spec κ` is a closed point. -/
lemma apply_ne_genericPoint_of_section (s : Spec (.of κ) ⟶ Y)
    (hs : s ≫ (Y ↘ Spec (.of κ)) = 𝟙 _) (z : Spec (.of κ)) : s z ≠ genericPoint Y := by
  haveI : IsClosedImmersion (s ≫ (Y ↘ Spec (.of κ))) := by rw [hs]; infer_instance
  haveI := IsClosedImmersion.of_comp s (Y ↘ Spec (.of κ))
  have hcl : IsClosed (Set.range s) := s.isClosedEmbedding.isClosed_range
  have hrange : Set.range s = {s z} := by
    ext y
    constructor
    · rintro ⟨z', rfl⟩
      rw [Subsingleton.elim z' z]
      rfl
    · rintro rfl
      exact ⟨z, rfl⟩
  rw [hrange] at hcl
  exact (isClosed_singleton_iff κ Y (s z)).1 hcl

variable [IsAlgClosed κ]

/-- Over an algebraically closed field, the residue field at the point of a place is `κ`. -/
lemma residueFieldStructureMap_bijective (P : Place κ Y.functionField) :
    Function.Bijective (residueFieldStructureMap κ Y (pointOfPlace κ Y P)).hom := by
  letI := residueFieldAlgebra κ Y (pointOfPlace κ Y P)
  have h := pointDegree_eq_finrank κ Y ((curvePlaceEquiv κ Y).symm P)
  rw [pointDegree, Equiv.apply_symm_apply] at h
  haveI : Module.Finite κ (Y.residueField (pointOfPlace κ Y P)) :=
    Module.finite_of_finrank_pos (by rw [← h]; exact P.deg_pos)
  exact IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ)
    (K := Y.residueField (pointOfPlace κ Y P))

variable (κ Y) in
/-- The `κ`-rational point of the curve `Y` at the place `P` (`κ` algebraically closed):
`Spec κ ≅ Spec κ(x) ⟶ Y`. -/
def placeSection (P : Place κ Y.functionField) : Spec (.of κ) ⟶ Y :=
  Spec.map (CommRingCat.ofHom
      (RingEquiv.ofBijective _ (residueFieldStructureMap_bijective P)).symm.toRingHom) ≫
    Y.fromSpecResidueField (pointOfPlace κ Y P)

@[simp]
lemma placeSection_apply (P : Place κ Y.functionField) (z : Spec (.of κ)) :
    placeSection κ Y P z = pointOfPlace κ Y P := by
  rw [placeSection, Scheme.Hom.comp_apply]
  exact Scheme.fromSpecResidueField_apply _ _

/-- `placeSection κ Y P` is a section of the structure morphism. -/
@[reassoc (attr := simp)]
lemma placeSection_comp (P : Place κ Y.functionField) :
    placeSection κ Y P ≫ (Y ↘ Spec (.of κ)) = 𝟙 _ := by
  rw [placeSection, Category.assoc, specMap_comp_structure_eq_id_iff]
  ext c
  exact (RingEquiv.ofBijective _ (residueFieldStructureMap_bijective P)).symm_apply_apply c

/-- **Uniqueness of rational points**: a section of `Y → Spec κ` through the point of `P` is
`placeSection κ Y P`. -/
theorem placeSection_unique (P : Place κ Y.functionField) (s : Spec (.of κ) ⟶ Y)
    (hs : s ≫ (Y ↘ Spec (.of κ)) = 𝟙 _) (hx : ∀ z, s z = pointOfPlace κ Y P) :
    s = placeSection κ Y P := by
  obtain ⟨ψ, rfl⟩ := exists_eq_specMap_comp_fromSpecResidueField s (hx _)
  rw [Category.assoc, specMap_comp_structure_eq_id_iff] at hs
  rw [placeSection]
  congr 2
  ext c
  obtain ⟨a, rfl⟩ := (residueFieldStructureMap_bijective P).2 c
  have h := congrArg (fun f ↦ f.hom a) hs
  refine h.trans ?_
  exact ((RingEquiv.ofBijective _ (residueFieldStructureMap_bijective P)).symm_apply_apply a).symm

/-- **Every rational point is a `placeSection`.** -/
theorem exists_eq_placeSection (s : Spec (.of κ) ⟶ Y) (hs : s ≫ (Y ↘ Spec (.of κ)) = 𝟙 _) :
    ∃ P : Place κ Y.functionField, s = placeSection κ Y P := by
  let z : Spec (.of κ) := IsLocalRing.closedPoint κ
  let P := curvePlaceEquiv κ Y ⟨s z, apply_ne_genericPoint_of_section s hs z⟩
  have hP : pointOfPlace κ Y P = s z :=
    congrArg Subtype.val ((curvePlaceEquiv κ Y).symm_apply_apply _)
  refine ⟨P, placeSection_unique P s hs fun z' ↦ ?_⟩
  rw [Subsingleton.elim z' z, hP]

/-- **The divisor of a rational point**: the ideal sheaf of `placeSection κ Y P` has divisor
`P`. -/
theorem hasDiv_ker_placeSection (P : Place κ Y.functionField) :
    (placeSection κ Y P).ker.HasDiv (Finsupp.single P 1) :=
  hasDiv_ker_of_forall_eq P _ (placeSection_apply P)

/-- The ideal sheaf of `placeSection κ Y P` is locally principal. -/
theorem isLocPrincipal_ker_placeSection (P : Place κ Y.functionField) :
    (placeSection κ Y P).ker.IsLocPrincipal :=
  isLocPrincipal_ker_of_forall_eq P _ (placeSection_apply P)

end Rational

end CurvesJacobian
