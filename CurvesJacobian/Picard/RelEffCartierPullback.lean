import CurvesJacobian.Picard.RelEffCartierBaseChange
import CurvesJacobian.Picard.PicMap

/-!
# Pullback of the line bundle of a relative effective Cartier divisor

Let `φ : X' ⟶ X` be a morphism of schemes and `I` an ideal sheaf on `X` which is locally
generated by nonzerodivisors, such that the pulled-back ideal sheaf `I.comap φ` is again locally
generated by nonzerodivisors. Then `φ^* I ≅ I.comap φ` as sheaves of modules
(`IdealSheafData.nonempty_pullback_idealSheaf_iso`): on suitable affine opens both sides have
the basis `φ^* g`, where `g` is a local generator of `I`, with the same transition functions.

Consequently, for relative effective Cartier divisors `D` on `X/S`, `D'` on `X'/S'` with
`I_{D'} = φ^{-1} I_D`, the pullback of `𝒪_X(D)` is `𝒪_{X'}(D')` in the Picard group
(`RelEffCartier.map_picClass_of_ideal_eq`); in particular `Pic.map (pullback.fst f g)` sends
the class of `D` to the class of the base change `D_T` (`RelEffCartier.map_picClass_baseChange`).
-/

open CategoryTheory MonoidalCategory Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

universe u

noncomputable section

namespace CurvesJacobian

/-- If `(a) = (b)` and `b` is a nonzerodivisor, then so is `a`. -/
lemma isSMulRegular_of_span_eq {R : Type*} [CommRing R] {a b : R}
    (h : Ideal.span {a} = Ideal.span {b}) (hb : IsSMulRegular R b) : IsSMulRegular R a := by
  have ha : a ∈ Ideal.span {b} := h ▸ Ideal.mem_span_singleton_self a
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
  have hb' : b ∈ Ideal.span {c * b} := h.symm ▸ Ideal.mem_span_singleton_self b
  obtain ⟨e, he⟩ := Ideal.mem_span_singleton'.mp hb'
  have hce : c * e = 1 := hb (by
    change b * (c * e) = b * 1
    rw [mul_one]
    calc b * (c * e) = e * (c * b) := by ring
      _ = b := he)
  exact ((Units.mkOfMulEqOne c e hce).isUnit.isSMulRegular R).mul hb

end CurvesJacobian

namespace AlgebraicGeometry

open Scheme CurvesJacobian

namespace Scheme.IdealSheafData

variable {X X' : Scheme.{u}}

/-- The inclusion `I ⟶ 𝒪_X` of the ideal sheaf. -/
def idealSheafι (I : X.IdealSheafData) : I.idealSheaf ⟶ Modules.structureSheaf X :=
  (Modules.sheafify X).map I.idealSub.ι ≫ (Modules.structureSheafIsoUnit X).inv

lemma structureSheafIsoUnit_hom_app {V : X.Opens} (a : Γ(X, V)) :
    (Modules.structureSheafIsoUnit X).hom.app V a =
      (Modules.toSheafify (𝟙_ X.PresheafOfModules)).app (op V) a := by
  change a • Scheme.PresheafOfModules.res _ (le_top : V ≤ ⊤)
    ((Modules.toSheafify (𝟙_ X.PresheafOfModules)).app (op ⊤) (1 : Γ(X, ⊤))) = _
  rw [← Scheme.PresheafOfModules.app_res, ← map_smul]
  congr 1
  change a * X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op 1 = a
  rw [map_one, mul_one]

lemma idealSheafι_app (I : X.IdealSheafData) {V : X.Opens} (a : I.idealSub.obj (op V)) :
    (I.idealSheafι.app V ((Modules.toSheafify I.idealPre).app (op V) a) : Γ(X, V)) =
      a.1 := by
  have h := congr_arg (fun η ↦ η.app (op V) a)
    ((PresheafOfModules.sheafificationAdjunction.{u} (𝟙 X.ringCatSheaf.obj)).unit.naturality
      I.idealSub.ι)
  change (Modules.structureSheafIsoUnit X).inv.app V
    (((Modules.sheafify X).map I.idealSub.ι).app V
      ((Modules.toSheafify I.idealPre).app (op V) a)) = _
  have h' : ((Modules.sheafify X).map I.idealSub.ι).app V
      ((Modules.toSheafify I.idealPre).app (op V) a) =
        (Modules.structureSheafIsoUnit X).hom.app V (show Γ(X, V) from a.1) := by
    rw [structureSheafIsoUnit_hom_app]
    exact h.symm
  rw [h', Modules.iso_inv_app_hom_app]

lemma hom_app_res {M : X.Modules} (ψ : M ⟶ Modules.structureSheaf X) {U V : X.Opens}
    (h : V ≤ U) (m : Γ(M, U)) :
    ψ.app V (Scheme.PresheafOfModules.res ((Modules.toPresheafOfModules X).obj M) h m) =
      X.presheaf.map (homOfLE h).op (ψ.app U m) :=
  Scheme.PresheafOfModules.app_res ((Modules.toPresheafOfModules X).map ψ) h m

variable (φ : X' ⟶ X) {I : X.IdealSheafData}

/-- Around every point of `X'` there are affine opens `W' ⊆ φ⁻¹ W` with `I(W) = (g)` and
`(φ^{-1} I)(W') = (φ^* g)`, both generators being nonzerodivisors. -/
lemma exists_comap_principal
    (hI : ∀ x : X, ∃ (U : X.affineOpens) (g : Γ(X, U.1)), x ∈ U.1 ∧
      I.ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X, U.1) g)
    (hJ : ∀ x : X', ∃ (U : X'.affineOpens) (g : Γ(X', U.1)), x ∈ U.1 ∧
      (I.comap φ).ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X', U.1) g) (x : X') :
    ∃ (W : X.affineOpens) (g : Γ(X, W.1)) (W' : X'.affineOpens) (hW : W'.1 ≤ φ ⁻¹ᵁ W.1),
      x ∈ W'.1 ∧ I.ideal W = Ideal.span {g} ∧ IsSMulRegular Γ(X, W.1) g ∧
      (I.comap φ).ideal W' = Ideal.span {φ.appLE W.1 W'.1 hW g} ∧
      IsSMulRegular Γ(X', W'.1) (φ.appLE W.1 W'.1 hW g) := by
  obtain ⟨W, g, hxW, hIW, hg⟩ := hI (φ x)
  obtain ⟨U', h, hxU', hJU', hh⟩ := hJ x
  obtain ⟨a, haW, hxa⟩ := U'.2.exists_basicOpen_le (V := φ ⁻¹ᵁ W.1) ⟨x, hxW⟩ hxU'
  let W' : X'.affineOpens := X'.affineBasicOpen a
  have hW'U' : W'.1 ≤ U'.1 := X'.basicOpen_le a
  obtain ⟨hJW', hhW'⟩ := principal_basicOpen hJU' hh W' a rfl hW'U'
  have hcomap := ideal_comap_of_le I φ W W' haW
  have key : (I.comap φ).ideal W' = Ideal.span {φ.appLE W.1 W'.1 haW g} := by
    rw [hcomap, hIW, Ideal.map_span, Set.image_singleton]
  exact ⟨W, g, W', haW, hxa, hIW, hg, key, isSMulRegular_of_span_eq (key.symm.trans hJW') hhW'⟩

/-- If `I` and `φ^{-1} I` are both locally generated by nonzerodivisors, then
`φ^* I ≅ φ^{-1} I`. -/
theorem nonempty_pullback_idealSheaf_iso
    (hI : ∀ x : X, ∃ (U : X.affineOpens) (g : Γ(X, U.1)), x ∈ U.1 ∧
      I.ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X, U.1) g)
    (hJ : ∀ x : X', ∃ (U : X'.affineOpens) (g : Γ(X', U.1)), x ∈ U.1 ∧
      (I.comap φ).ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X', U.1) g) :
    Nonempty ((Modules.pullback φ).obj I.idealSheaf ≅ (I.comap φ).idealSheaf) := by
  choose W g W' hW hxW hIW hg hJW hg' using exists_comap_principal φ hI hJ
  let P := (Modules.toPresheafOfModules X).obj I.idealSheaf
  let L := (Modules.toPresheafOfModules X').obj ((Modules.pullback φ).obj I.idealSheaf)
  let a : ∀ x, I.idealSub.obj (op (W x).1) := fun x ↦ ⟨g x,
      (I.mem_idealSub_iff_of_isAffine (W x) (g x)).mpr
        (hIW x ▸ Ideal.mem_span_singleton_self (g x))⟩
  let bI : ∀ x, Γ(I.idealSheaf, (W x).1) := fun x ↦
    (Modules.toSheafify I.idealPre).app (op (W x).1) (a x)
  have hbI : ∀ x, I.idealSheaf.IsBasisOn (W x).1 (bI x) := fun x ↦
    isBasisOn_idealSheaf (hIW x) (hg x)
  let u : ∀ x y, Γ(X, (W x).1 ⊓ (W y).1) := fun x y ↦
    Scheme.PresheafOfModules.coord (hbI x) inf_le_left
      (Scheme.PresheafOfModules.res P inf_le_right (bI y))
  have hu : ∀ x y, X.presheaf.map (homOfLE inf_le_right).op (g y) =
      u x y * X.presheaf.map (homOfLE inf_le_left).op (g x) := by
    intro x y
    have h := Scheme.PresheafOfModules.coord_smul (hbI x) inf_le_left
      (Scheme.PresheafOfModules.res P inf_le_right (bI y))
    let ψ := I.idealSheafι
    let Vxy := (W x).1 ⊓ (W y).1
    have e1 : (ψ.app Vxy (Scheme.PresheafOfModules.res P inf_le_right (bI y)) : Γ(X, Vxy)) =
        X.presheaf.map (homOfLE inf_le_right).op (g y) :=
      (hom_app_res ψ inf_le_right (bI y)).trans (congrArg _ (idealSheafι_app I (a y)))
    have e2 : (ψ.app Vxy (Scheme.PresheafOfModules.res P inf_le_left (bI x)) : Γ(X, Vxy)) =
        X.presheaf.map (homOfLE inf_le_left).op (g x) :=
      (hom_app_res ψ inf_le_left (bI x)).trans (congrArg _ (idealSheafι_app I (a x)))
    have e3 : (ψ.app Vxy (u x y • Scheme.PresheafOfModules.res P inf_le_left (bI x)) :
        Γ(X, Vxy)) = @HMul.hMul Γ(X, Vxy) Γ(X, Vxy) Γ(X, Vxy) _ (u x y)
          (ψ.app Vxy (Scheme.PresheafOfModules.res P inf_le_left (bI x))) :=
      Modules.Hom.app_smul _ _ _
    exact e1.symm.trans ((congrArg (ψ.app Vxy) h.symm).trans (e3.trans (congrArg _ e2)))
  have hle : ∀ x y, (W' x).1 ⊓ (W' y).1 ≤ φ ⁻¹ᵁ ((W x).1 ⊓ (W y).1) := fun x y ↦
    inf_le_inf (hW x) (hW y)
  refine Modules.nonempty_iso_of_transitions (fun x ↦ (W' x).1) hxW
    (fun x ↦ Scheme.PresheafOfModules.res L (hW x) (Modules.pullbackSection φ (bI x)))
    (fun x ↦ (Modules.toSheafify (I.comap φ).idealPre).app (op (W' x).1)
      ⟨φ.appLE _ _ (hW x) (g x), ((I.comap φ).mem_idealSub_iff_of_isAffine (W' x) _).mpr
        (hJW x ▸ Ideal.mem_span_singleton_self _)⟩)
    (fun x ↦ (Modules.isBasisOn_pullbackSection φ _ (hbI x)).restrict (hW x))
    (fun x ↦ isBasisOn_idealSheaf (hJW x) (hg' x))
    (fun x y ↦ φ.appLE _ _ (hle x y) (u x y)) ?_ ?_
  · intro x y
    rw [Scheme.PresheafOfModules.res_res, Scheme.PresheafOfModules.res_res]
    have e : ∀ z (h : (W x).1 ⊓ (W y).1 ≤ (W z).1) (h' : (W' x).1 ⊓ (W' y).1 ≤ (W' z).1),
        Scheme.PresheafOfModules.res L (h'.trans (hW z)) (Modules.pullbackSection φ (bI z)) =
          Scheme.PresheafOfModules.res L (hle x y)
            (Modules.pullbackSection φ (Scheme.PresheafOfModules.res P h (bI z))) := by
      intro z h h'
      erw [Modules.pullbackSection_res φ h (bI z)]
      exact (Scheme.PresheafOfModules.res_res L _ _ _).symm
    rw [e y inf_le_right inf_le_right, e x inf_le_left inf_le_left,
      ← Scheme.PresheafOfModules.coord_smul (hbI x) inf_le_left
        (Scheme.PresheafOfModules.res P inf_le_right (bI y))]
    erw [Modules.pullbackSection_smul φ (u x y)]
    exact Scheme.PresheafOfModules.res_smul' L _ _ _
  · intro x y
    let T := Modules.toSheafify (I.comap φ).idealPre
    refine (Scheme.PresheafOfModules.app_res T inf_le_right _).symm.trans ?_
    refine Eq.trans ?_ (congrArg (φ.appLE _ _ (hle x y) (u x y) • ·)
      (Scheme.PresheafOfModules.app_res T inf_le_left _))
    refine Eq.trans ?_ (map_smul (T.app (op ((W' x).1 ⊓ (W' y).1))).hom _ _)
    congr 1
    apply Subtype.ext
    change X'.presheaf.map (homOfLE inf_le_right).op (φ.appLE _ _ (hW y) (g y)) =
      φ.appLE _ _ (hle x y) (u x y) *
        X'.presheaf.map (homOfLE inf_le_left).op (φ.appLE _ _ (hW x) (g x))
    have e : ∀ z (h : (W x).1 ⊓ (W y).1 ≤ (W z).1) (h' : (W' x).1 ⊓ (W' y).1 ≤ (W' z).1),
        X'.presheaf.map (homOfLE h').op (φ.appLE _ _ (hW z) (g z)) =
          φ.appLE _ _ (hle x y) (X.presheaf.map (homOfLE h).op (g z)) := by
      intro z h h'
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.appLE_map,
        Scheme.Hom.map_appLE]
    rw [e y inf_le_right inf_le_right, e x inf_le_left inf_le_left, hu, map_mul]
    rfl

end Scheme.IdealSheafData

namespace RelEffCartier

variable {X S X' S' : Scheme.{u}} {f : X ⟶ S} {f' : X' ⟶ S'}

/-- If the ideal of `D'` is the pullback of the ideal of `D` along `φ`, then `φ^* 𝒪_X(-D)` is
isomorphic to `𝒪_{X'}(-D')`. -/
lemma nonempty_pullback_idealSheaf_iso (D : RelEffCartier f) (D' : RelEffCartier f')
    (φ : X' ⟶ X) (h : D'.ideal = D.ideal.comap φ) :
    Nonempty ((Modules.pullback φ).obj D.idealSheaf ≅ D'.idealSheaf) := by
  obtain ⟨e⟩ := IdealSheafData.nonempty_pullback_idealSheaf_iso φ D.locally_principal
    (h ▸ D'.locally_principal)
  exact ⟨e ≪≫ eqToIso (by rw [RelEffCartier.idealSheaf, h])⟩

/-- If the ideal of `D'` is the pullback of the ideal of `D` along `φ`, then `φ^* 𝒪_X(D)` and
`𝒪_{X'}(D')` have the same class in the Picard group. -/
theorem map_picClass_of_ideal_eq (D : RelEffCartier f) (D' : RelEffCartier f')
    (φ : X' ⟶ X) (h : D'.ideal = D.ideal.comap φ) :
    Pic.map φ D.picClass = D'.picClass := by
  obtain ⟨e⟩ := nonempty_pullback_idealSheaf_iso D D' φ h
  rw [picClass_eq_neg, picClass_eq_neg, map_neg, Pic.map_mk, Pic.mk_eq_of_iso e]

/-- The pullback of `𝒪_X(D)` along `X_T ⟶ X` is `𝒪_{X_T}(D_T)`. -/
theorem map_picClass_baseChange (D : RelEffCartier f) {T : Scheme.{u}} (g : T ⟶ S) :
    Pic.map (pullback.fst f g) D.picClass = (D.baseChange g).picClass :=
  map_picClass_of_ideal_eq D _ _ (baseChange_ideal D g)

end RelEffCartier

end AlgebraicGeometry
