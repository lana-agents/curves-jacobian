import CurvesJacobian.Picard.RelEffCartier
import CurvesJacobian.Picard.PushoutAlgebra
import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!
# Base change of relative effective Cartier divisors

For a relative effective Cartier divisor `D ⊂ X` over `S` and a morphism `g : T ⟶ S`, the
pullback `D_T = D ×_S T ⊂ X_T = X ×_S T` is a relative effective Cartier divisor over `T`
(Stacks, Tag 056Q (1)–(2)). Its ideal sheaf is the pullback of the ideal sheaf of `D` along
`X_T → X`; on an affine open `W ×_V V'` it is generated by `a ⊗ 1` if `I_D(W) = (a)`, and
`a ⊗ 1` is a nonzerodivisor of `Γ(W) ⊗_{Γ(V)} Γ(V')` because `Γ(W)/a` is `Γ(V)`-flat.

* `IdealSheafData.ideal_comap_of_le`: on affine opens `W' ⊆ φ⁻¹ W`, the pulled-back ideal
  `(I.comap φ)(W')` is the extension of `I(W)`.
* `RelEffCartier.baseChange`, with `baseChange_ideal` and `degree_baseChange`
  (the degree of `D_T` at `t` is the degree of `D` at `g t`).
-/

open CategoryTheory Limits TopologicalSpace
open scoped AlgebraicGeometry

universe u

noncomputable section

namespace AlgebraicGeometry

open Scheme CurvesJacobian

namespace Scheme.IdealSheafData

variable {X X' : Scheme.{u}} (I : X.IdealSheafData) (φ : X' ⟶ X)

lemma preimage_fst_eq_inf (W : X.affineOpens) (W' : X'.affineOpens) (h : W'.1 ≤ φ ⁻¹ᵁ W.1) :
    pullback.fst φ I.subschemeι ⁻¹ᵁ W'.1 = pullback.fst φ I.subschemeι ⁻¹ᵁ W'.1 ⊓
      pullback.snd φ I.subschemeι ⁻¹ᵁ (I.subschemeι ⁻¹ᵁ W.1) := by
  refine (inf_eq_left.mpr ?_).symm
  rw [← Scheme.Hom.comp_preimage, ← pullback.condition, Scheme.Hom.comp_preimage]
  exact (pullback.fst φ I.subschemeι).preimage_mono h

/-- The sections of `X' ×_X Z` (with `Z` the closed subscheme of `I`) over `W' ×_W Z_W` form a
pushout of rings. -/
lemma isPushout_comap (W : X.affineOpens) (W' : X'.affineOpens) (h : W'.1 ≤ φ ⁻¹ᵁ W.1) :
    IsPushout (φ.appLE W W' h) (I.subschemeι.appLE W (I.subschemeι ⁻¹ᵁ W.1) le_rfl)
      ((pullback.fst φ I.subschemeι).appLE W' _ le_rfl)
      ((pullback.snd φ I.subschemeι).appLE (I.subschemeι ⁻¹ᵁ W.1)
        (pullback.fst φ I.subschemeι ⁻¹ᵁ W'.1)
        ((I.preimage_fst_eq_inf φ W W' h).le.trans inf_le_right)) := by
  have H := IsPullback.of_hasPullback φ I.subschemeι
  have hUY := I.preimage_fst_eq_inf φ W W' h
  exact (isIso_pushoutSection_iff H le_rfl h hUY).mp
    (isIso_pushoutSection_of_isAffineOpen H le_rfl h hUY W.2 (W.2.preimage _) W'.2)

/-- On affine opens `W' ⊆ φ⁻¹ W`, the pullback ideal sheaf is the extension of `I(W)`. -/
theorem ideal_comap_of_le (W : X.affineOpens) (W' : X'.affineOpens) (h : W'.1 ≤ φ ⁻¹ᵁ W.1) :
    (I.comap φ).ideal W' = (I.ideal W).map (φ.appLE W W' h).hom := by
  have hsurj : Function.Surjective (I.subschemeι.appLE W (I.subschemeι ⁻¹ᵁ W.1) le_rfl) := by
    rw [← Scheme.Hom.app_eq_appLE]
    exact I.subschemeι_app_surjective W
  have hker := ker_inl_of_isPushout (I.isPushout_comap φ W W' h) hsurj
  rw [← Scheme.Hom.app_eq_appLE, ← Scheme.Hom.app_eq_appLE, ker_subschemeι_app] at hker
  rw [comap, Scheme.Hom.ker_apply, hker]

end Scheme.IdealSheafData

variable {X S T : Scheme.{u}} {f : X ⟶ S} (D : RelEffCartier f) (g : T ⟶ S)

namespace RelEffCartier

/-- Locally on `X_T`, the pulled-back ideal of `D` is generated by the image of a local
nonzerodivisor generator of `D`, and this image is a nonzerodivisor. -/
lemma baseChange_locally_principal (x : ↑(pullback f g)) :
    ∃ (U : (pullback f g).affineOpens) (a : Γ(pullback f g, U.1)), x ∈ U.1 ∧
      (D.ideal.comap (pullback.fst f g)).ideal U = Ideal.span {a} ∧
      IsSMulRegular Γ(pullback f g, U.1) a := by
  have H := IsPullback.of_hasPullback f g
  obtain ⟨V, hV, hxV, -⟩ := Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens
    (Opens.mem_top (f (pullback.fst f g x)))
  obtain ⟨W, a, -, hxW, hWV, haI, ha, -, -⟩ := exists_affine_principal_principal
    D.locally_principal D.locally_principal (pullback.fst f g x) (f ⁻¹ᵁ V) hxV
  have hgx : g (pullback.snd f g x) ∈ V := by
    rw [← Scheme.Hom.comp_apply, ← pullback.condition, Scheme.Hom.comp_apply]
    exact hxV
  obtain ⟨V', hV', hxV', hV'V⟩ := Opens.isBasis_iff_nbhd.mp T.isBasis_affineOpens
    (show pullback.snd f g x ∈ g ⁻¹ᵁ V from hgx)
  let VV : S.affineOpens := ⟨V, hV⟩
  let VV' : T.affineOpens := ⟨V', hV'⟩
  let UY : (pullback f g).Opens := pullback.fst f g ⁻¹ᵁ W.1 ⊓ pullback.snd f g ⁻¹ᵁ V'
  have hUY : UY = pullback.fst f g ⁻¹ᵁ W.1 ⊓ pullback.snd f g ⁻¹ᵁ V' := rfl
  have : IsAffine V := hV
  have : IsAffine V' := hV'
  have : IsAffine W.1 := W.2
  have hUYa : IsAffineOpen UY :=
    .of_isIso (Scheme.Hom.isPullback_resLE H hV'V hWV hUY).isoPullback.hom
  have hpush := (isIso_pushoutSection_iff H hV'V hWV hUY).mp
    (isIso_pushoutSection_of_isAffineOpen H hV'V hWV hUY hV hV' W.2)
  have hle : UY ≤ pullback.fst f g ⁻¹ᵁ W.1 := inf_le_left
  refine ⟨⟨UY, hUYa⟩, (pullback.fst f g).appLE W.1 UY hle a, ⟨hxW, hxV'⟩, ?_, ?_⟩
  · rw [IdealSheafData.ideal_comap_of_le D.ideal (pullback.fst f g) W ⟨UY, hUYa⟩ hle, haI,
      Ideal.map_span, Set.image_singleton]
  · have hflat := D.ideal.flat_quotient_of_flat (hf := D.flat) f VV W hWV
    rw [haI] at hflat
    exact isSMulRegular_inl_of_isPushout hpush ha hflat

/-- The base change `D_T ⊂ X_T` is flat over `T`. -/
lemma flat_baseChange :
    Flat ((D.ideal.comap (pullback.fst f g)).subschemeι ≫ pullback.snd f g) := by
  have sq : IsPullback (pullback.snd (pullback.fst f g) D.ideal.subschemeι)
      (pullback.fst (pullback.fst f g) D.ideal.subschemeι ≫ pullback.snd f g)
      (D.ideal.subschemeι ≫ f) g :=
    (IsPullback.of_hasPullback (pullback.fst f g) D.ideal.subschemeι).flip.paste_vert
      (IsPullback.of_hasPullback f g)
  have : Flat (D.ideal.subschemeι ≫ f) := D.flat
  have hfl : Flat (pullback.fst (pullback.fst f g) D.ideal.subschemeι ≫ pullback.snd f g) :=
    MorphismProperty.of_isPullback (P := @Flat) sq this
  rw [← IdealSheafData.comapIso_hom_fst, Category.assoc]
  infer_instance

/-- The base change of a relative effective Cartier divisor (Stacks, Tag 056Q): the closed
subscheme `D ×_S T ⊂ X ×_S T`, with ideal sheaf the pullback of the ideal sheaf of `D`. -/
def baseChange : RelEffCartier (pullback.snd f g) where
  ideal := D.ideal.comap (pullback.fst f g)
  locally_principal := D.baseChange_locally_principal g
  flat := D.flat_baseChange g

lemma baseChange_ideal : (D.baseChange g).ideal = D.ideal.comap (pullback.fst f g) := rfl

/-- The base change `D_T` is `D ×_S T`. -/
def baseChangeIso : (D.baseChange g).toScheme ≅ pullback (pullback.fst f g) D.ideal.subschemeι :=
  D.ideal.comapIso (pullback.fst f g)

/-- The degree of `D_T` at `t ∈ T` is the degree of `D` at `g t`. -/
lemma degree_baseChange [IsFinite (D.ideal.subschemeι ≫ f)] (t : T) :
    (D.baseChange g).degree t = D.degree (g t) := by
  have sq : IsPullback (pullback.snd (pullback.fst f g) D.ideal.subschemeι)
      (pullback.fst (pullback.fst f g) D.ideal.subschemeι ≫ pullback.snd f g)
      (D.ideal.subschemeι ≫ f) g :=
    (IsPullback.of_hasPullback (pullback.fst f g) D.ideal.subschemeι).flip.paste_vert
      (IsPullback.of_hasPullback f g)
  have : Flat (D.ideal.subschemeι ≫ f) := D.flat
  have : IsFinite (pullback.fst (pullback.fst f g) D.ideal.subschemeι ≫ pullback.snd f g) :=
    MorphismProperty.of_isPullback (P := @IsFinite) sq ‹_›
  have : Flat (pullback.fst (pullback.fst f g) D.ideal.subschemeι ≫ pullback.snd f g) :=
    MorphismProperty.of_isPullback (P := @Flat) sq ‹Flat (D.ideal.subschemeι ≫ f)›
  simp only [degree, baseChange_ideal]
  rw [← IdealSheafData.comapIso_hom_fst, Category.assoc, Scheme.Hom.finrank_comp_left_of_isIso,
    Scheme.Hom.finrank_of_isPullback _ _ _ _ sq]

end RelEffCartier

end AlgebraicGeometry

end
