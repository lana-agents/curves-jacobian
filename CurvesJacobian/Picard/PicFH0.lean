import CurvesJacobian.Picard.PicFOpen
import CurvesJacobian.Picard.PicF
import CurvesJacobian.Picard.RelEffCartierUnit

/-!
# Base change of `H⁰` under the `F`-condition

Let `C` be a curve over a perfect field `k` with a finite `π : C → ℙ¹_k`, `T` an affine
`k`-scheme and `L` an invertible sheaf on `C ×_k T` satisfying the `F`-condition of Stacks,
Lemma 44.6.2 (Tag 0B9V) (`FCond`: Čech `H¹ = 0`, Čech `H⁰` invertible, for the chart covering).
For every affine `T''` and `h : T'' ⟶ T`, the Čech `H⁰` of the pullback of `L` to `C ×_k T''` is
`Γ(T'') ⊗_{Γ(T)} H⁰(L)` (`CurvesJacobian.fCondH0BaseChange`). In particular, near every point of
`T` there is a basic open `D(r)` over which `H⁰` is generated by one element
(`CurvesJacobian.exists_basicOpen_H0_cyclic`), as used in the proof of Stacks, Lemma 44.6.4
(Tag 0B9X).
-/

open CategoryTheory Limits TopologicalSpace AlgebraicGeometry TensorProduct

universe u

noncomputable section

namespace CurvesJacobian

open Cech Belyi

variable {k : Type u} [Field k] {C : Scheme.{u}} [C.Over (Spec (CommRingCat.of k))]
  {T : Scheme.{u}} [T.Over (Spec (CommRingCat.of k))] [IsAffine T]
  (π : C ⟶ ProjectiveLine.scheme k) [PerfectField k] [IsCurveOver k C] [IsFinite π]

local notation "Sk" => Spec (CommRingCat.of k)

/-- The charts of `C ×_k T'` for `g' : T' ⟶ Spec k`. -/
abbrev chartOf {T' : Scheme.{u}} (g' : T' ⟶ Sk) (i : Fin 2) : (pullback (C ↘ Sk) g').Opens :=
  (pullback.fst (C ↘ Sk) g' ≫ π) ⁻¹ᵁ ProjectiveLine.U k i

/-- The Čech `H⁰` of `M` on `C ×_k T'` for the chart covering. -/
abbrev chartH0 {T' : Scheme.{u}} (g' : T' ⟶ Sk) (M : (pullback (C ↘ Sk) g').Modules) :=
  cechModH0 T' M (chartOf π g' 0) (chartOf π g' 1)

/-- If `g/1` generates `H_r` and `r` becomes a unit in `B`, then `1 ⊗ g` generates `B ⊗_A H`. -/
lemma span_one_tmul_eq_top {A B H : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup H] [Module A H] (r : A) (hr : IsUnit (algebraMap A B r)) (g : H)
    (hg : Submodule.span (Localization.Away r)
      {LocalizedModule.mk g (1 : Submonoid.powers r)} = ⊤) :
    Submodule.span B {(1 : B) ⊗ₜ[A] g} = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  induction x using TensorProduct.induction_on with
  | zero => exact Submodule.zero_mem _
  | add x y hx hy => exact Submodule.add_mem _ hx hy
  | tmul b h =>
    have hmem : LocalizedModule.mk h (1 : Submonoid.powers r) ∈
        Submodule.span (Localization.Away r) {LocalizedModule.mk g (1 : Submonoid.powers r)} :=
      hg ▸ Submodule.mem_top
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
    induction c using Localization.induction_on with | H x =>
    obtain ⟨a, ⟨_, n, rfl⟩⟩ := x
    rw [LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq] at hc
    obtain ⟨⟨_, k, rfl⟩, hk⟩ := hc
    have hk' : (r ^ k * a) • g = r ^ (k + n) • h := by
      simpa [Submonoid.smul_def, smul_smul, pow_add] using hk
    have hv : IsUnit (algebraMap A B (r ^ (k + n))) := by
      rw [map_pow]
      exact hr.pow _
    have key : (1 : B) ⊗ₜ[A] h =
        (((hv.unit⁻¹ : Bˣ) : B) * algebraMap A B (r ^ k * a)) • ((1 : B) ⊗ₜ[A] g) := by
      have e1 : algebraMap A B (r ^ (k + n)) • ((1 : B) ⊗ₜ[A] h) =
          algebraMap A B (r ^ k * a) • ((1 : B) ⊗ₜ[A] g) := by
        rw [algebraMap_smul, algebraMap_smul, ← TensorProduct.tmul_smul,
          ← TensorProduct.tmul_smul, hk']
      rw [mul_smul, ← e1, smul_smul, IsUnit.val_inv_mul, one_smul]
    rw [show b ⊗ₜ[A] h = b • ((1 : B) ⊗ₜ[A] h) by rw [TensorProduct.smul_tmul', smul_eq_mul,
      mul_one], key, smul_smul]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- An invertible module is generated by one element near every prime, compatibly with base
change: there are `r ∉ 𝔭` and `g` such that `1 ⊗ g` generates `B ⊗_A H` whenever `r` becomes
a unit in `B`. -/
lemma exists_cyclic_of_invertible {A H : Type*} [CommRing A] [AddCommGroup H] [Module A H]
    [Module.Invertible A H] (𝔭 : Ideal A) [𝔭.IsPrime] : ∃ r ∉ 𝔭, ∃ g : H,
      ∀ (B : Type*) [CommRing B] [Algebra A B], IsUnit (algebraMap A B r) →
        Submodule.span B {(1 : B) ⊗ₜ[A] g} = ⊤ := by
  obtain ⟨S, hS, hfree⟩ := Module.Invertible.exists_finset_free_localization A H
  obtain ⟨r, hrS, hr𝔭⟩ : ∃ r ∈ S, r ∉ 𝔭 := by
    by_contra hcon
    push Not at hcon
    exact (‹𝔭.IsPrime›).ne_top (top_le_iff.mp (hS ▸ Ideal.span_le.mpr fun r hr ↦ hcon r hr))
  haveI := hfree r hrS
  obtain ⟨e⟩ := Module.Invertible.free_iff_linearEquiv.mp
    ‹Module.Free (Localization.Away r) (LocalizedModule.Away r H)›
  obtain ⟨b, hb⟩ : ∃ b : LocalizedModule.Away r H,
      Submodule.span (Localization.Away r) {b} = ⊤ := by
    refine ⟨e.symm 1, ?_⟩
    have h1 := congrArg (Submodule.map e.symm.toLinearMap)
      (Ideal.span_singleton_one (α := Localization.Away r))
    rwa [Submodule.map_span, Set.image_singleton, Submodule.map_top, LinearEquiv.range] at h1
  induction b using LocalizedModule.induction_on with | h g s =>
  have hspan : Submodule.span (Localization.Away r)
      {LocalizedModule.mk g (1 : Submonoid.powers r)} = ⊤ := by
    have h1 : LocalizedModule.mk g (1 : Submonoid.powers r) =
        algebraMap A (Localization.Away r) (s : A) • LocalizedModule.mk g s := by
      rw [algebraMap_smul, LocalizedModule.smul'_mk, LocalizedModule.mk_eq]
      exact ⟨1, by simp [Submonoid.smul_def]⟩
    have hu : IsUnit (algebraMap A (Localization.Away r) (s : A)) :=
      IsLocalization.map_units _ s
    rw [h1, Submodule.span_singleton_smul_eq hu, hb]
  exact ⟨r, hr𝔭, g, fun B _ _ hunit ↦ span_one_tmul_eq_top r hunit g hspan⟩

lemma span_singleton_equiv_eq_top {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) {x : M} (hx : Submodule.span R {x} = ⊤) :
    Submodule.span R {e x} = ⊤ := by
  have h1 := congrArg (Submodule.map e.toLinearMap) hx
  rwa [Submodule.map_span, Set.image_singleton, Submodule.map_top, LinearEquiv.range] at h1

/-- **Base change of `H⁰` under the `F`-condition**: for `L` on `C ×_k T` satisfying `FCond`
and `h : T'' ⟶ T` with `T''` affine, `H⁰(C ×_k T'', h^*L) ≅ Γ(T'') ⊗_{Γ(T)} H⁰(C ×_k T, L)`. -/
def fCondH0BaseChange (L : (pullback (C ↘ Sk) (T ↘ Sk)).Modules) [L.IsInvertible]
    (hL : FCond π (T ↘ Sk) L) (T'' : Scheme.{u}) [IsAffine T''] [T''.Over T] :
    chartH0 π ((T'' ↘ T) ≫ (T ↘ Sk))
        ((Scheme.Modules.pullback (bcMap (C ↘ Sk) (T'' ↘ T) (T ↘ Sk) ((T'' ↘ T) ≫ (T ↘ Sk))
          rfl)).obj L) ≃ₗ[Γ(T'', ⊤)]
      Γ(T'', ⊤) ⊗[Γ(T, ⊤)] chartH0 π (T ↘ Sk) L := by
  set h := T'' ↘ T with hh
  have H : IsPullback (bcMap (C ↘ Sk) h (T ↘ Sk) (h ≫ (T ↘ Sk)) rfl)
      (pullback.snd (C ↘ Sk) (h ≫ (T ↘ Sk)))
      (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T) :=
    HilbPoint.isPullback_baseChangeMap (C ↘ Sk)
      (Over.homMk h rfl : Over.mk (h ≫ (T ↘ Sk)) ⟶ Over.mk (T ↘ Sk))
  let e := H.isoPullback.hom
  have he₁ : e ≫ pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T) =
      bcMap (C ↘ Sk) h (T ↘ Sk) (h ≫ (T ↘ Sk)) rfl :=
    H.isoPullback_hom_fst
  have he₂ : e ≫ pullback.snd (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T) =
      pullback.snd (C ↘ Sk) (h ≫ (T ↘ Sk)) :=
    H.isoPullback_hom_snd
  have hpX : bcMap (C ↘ Sk) h (T ↘ Sk) (h ≫ (T ↘ Sk)) rfl ≫ pullback.fst (C ↘ Sk) (T ↘ Sk) =
      pullback.fst (C ↘ Sk) (h ≫ (T ↘ Sk)) := bcMap_fst _ _ _ _ _
  let iso : (Scheme.Modules.pullback e).obj ((Scheme.Modules.pullback
      (pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T))).obj L) ≅
      (Scheme.Modules.pullback (bcMap (C ↘ Sk) h (T ↘ Sk) (h ≫ (T ↘ Sk)) rfl)).obj L :=
    (Scheme.Modules.pullbackComp e _).app L ≪≫ eqToIso (by rw [he₁])
  have hcharts : ∀ i : Fin 2, chartOf π (h ≫ (T ↘ Sk)) i =
      e ⁻¹ᵁ (pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T) ⁻¹ᵁ
        (curveChartMap (T₀ := T) π ⁻¹ᵁ ProjectiveLine.U k i)) := fun i ↦ by
    dsimp only [chartOf]
    rw [← hpX, ← he₁]
    rfl
  have hZU := fun i : Fin 2 ↦ isAffineOpen_preimage_fst (S := T) (T := T'')
    (curveChartMap (T₀ := T) π ⁻¹ᵁ ProjectiveLine.U k i) (isAffineOpen_chart π i) _ rfl
  have hZUV := isAffineOpen_preimage_fst (S := T) (T := T'')
    (curveChartMap (T₀ := T) π ⁻¹ᵁ ProjectiveLine.U k 0 ⊓
      curveChartMap (T₀ := T) π ⁻¹ᵁ ProjectiveLine.U k 1) (isAffineOpen_chart_inf π) _ rfl
  have eUV : chartOf π (h ≫ (T ↘ Sk)) 0 ⊓ chartOf π (h ≫ (T ↘ Sk)) 1 =
      e ⁻¹ᵁ (pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T) ⁻¹ᵁ
        (curveChartMap (T₀ := T) π ⁻¹ᵁ ProjectiveLine.U k 0 ⊓
          curveChartMap (T₀ := T) π ⁻¹ᵁ ProjectiveLine.U k 1)) := by
    rw [hcharts 0, hcharts 1]
    rfl
  -- step 1: `H⁰(bcMap^* L) ≅ H⁰(e^* p^* L)`
  have hf₁ := sectionsIso_res (S := T'') iso.symm
    (inf_le_left : chartOf π (h ≫ (T ↘ Sk)) 0 ⊓ chartOf π (h ≫ (T ↘ Sk)) 1 ≤ _)
  have hg₁ := sectionsIso_res (S := T'') iso.symm
    (inf_le_right : chartOf π (h ≫ (T ↘ Sk)) 0 ⊓ chartOf π (h ≫ (T ↘ Sk)) 1 ≤ _)
  refine TwoCech.equivH0 _ _ _ hf₁ hg₁ ≪≫ₗ ?_
  -- step 2: `H⁰(e^* p^* L) ≅ H⁰(p^* L)`
  have hf₂ := pullbackIsoSections_res e he₂ ((Scheme.Modules.pullback
      (pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T))).obj L)
    (hZU 0) hZUV ((pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T)).preimage_mono
      inf_le_left) (hcharts 0) eUV inf_le_left
  have hg₂ := pullbackIsoSections_res e he₂ ((Scheme.Modules.pullback
      (pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T))).obj L)
    (hZU 1) hZUV ((pullback.fst (pullback (C ↘ Sk) (T ↘ Sk) ↘ T) (T'' ↘ T)).preimage_mono
      inf_le_right) (hcharts 1) eUV inf_le_right
  refine (TwoCech.equivH0 _ _ _ hf₂ hg₂).symm ≪≫ₗ ?_
  -- step 3: base change along `T'' → T`
  exact cechH0BaseChangeCurve (T₀ := T) (π := π) T'' hL

omit [PerfectField k] [IsCurveOver k C] in
/-- Near every point of `T` there is a basic open `D(r)` such that, for every affine `T''` over
`T` landing in `D(r)`, the `H⁰` of the `F`-condition on `C ×_k T''` is generated by one
element. -/
theorem exists_basicOpen_H0_cyclic (L : (pullback (C ↘ Sk) (T ↘ Sk)).Modules) [L.IsInvertible]
    (hL : FCond π (T ↘ Sk) L) (t : T) : ∃ r : Γ(T, ⊤), t ∈ T.basicOpen r ∧
      ∀ (T'' : Scheme.{u}) [IsAffine T''] [T''.Over T], Set.range (T'' ↘ T) ⊆ T.basicOpen r →
      ∃ s : chartH0 π ((T'' ↘ T) ≫ (T ↘ Sk))
        ((Scheme.Modules.pullback (bcMap (C ↘ Sk) (T'' ↘ T) (T ↘ Sk)
          ((T'' ↘ T) ≫ (T ↘ Sk)) rfl)).obj L),
        Submodule.span Γ(T'', ⊤) {s} = ⊤ := by
  have hinv : Module.Invertible Γ(T, ⊤) (chartH0 π (T ↘ Sk) L) := ((isFPoint_iff _ _ _).mp hL).2
  obtain ⟨r, hr, g, hg⟩ := exists_cyclic_of_invertible (H := chartH0 π (T ↘ Sk) L)
    (T.toSpecΓ t).asIdeal
  have htr : t ∈ T.basicOpen r := by
    rw [← Scheme.toSpecΓ_preimage_basicOpen]
    exact (PrimeSpectrum.mem_basicOpen _ _).mpr hr
  refine ⟨r, htr, fun T'' _ _ hran ↦ ?_⟩
  have hunit : IsUnit (algebraMap Γ(T, ⊤) Γ(T'', ⊤) r) := by
    refine isUnit_of_basicOpen_eq_top _ fun t' ↦ ?_
    rw [algebraMap_sections, Scheme.basicOpen_appLE]
    exact ⟨trivial, hran ⟨t', rfl⟩⟩
  exact ⟨_, span_singleton_equiv_eq_top (fCondH0BaseChange π L hL T'').symm (hg _ hunit)⟩

end CurvesJacobian
