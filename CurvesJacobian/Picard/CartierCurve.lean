/-!
# Charts on smooth curves used for relative effective Cartier divisors

Let `C` be a scheme smooth of relative dimension `1` over a field `k`.

* `CurvesJacobian.exists_kaehler_chart`: every point of `C` has an affine neighbourhood `W` with
  a function `s ∈ Γ(C, W)` such that `Ω_{Γ(W)/k}` is generated by `ds` (from a standard smooth
  presentation of relative dimension `1`, Mathlib's `SubmersivePresentation.basisKaehler`); so
  `s` is an étale coordinate on `W`.
* `CurvesJacobian.exists_place_notMem`: a function field over a perfect field has infinitely many
  places; `exists_transcendental_forall_mem_stalk`: every finite set of points of a curve consists
  of points at which some transcendental rational function `t` is regular.
* `CurvesJacobian.curveMap_mem_U_one`, `germ_curveMap_coord`: for the finite morphism
  `π_t : C → ℙ¹` attached to `t` (belyi's `homOfFunctionField`), every point at which `t` is regular
  maps into the chart `D₊(x₁)` (by separatedness of `ℙ¹`: `Spec 𝒪_{C,x} → ℙ¹` is the point with
  coordinate `t`), and the pulled-back coordinate `x₀/x₁` has germ `t` at the generic point.
* `CurvesJacobian.exists_affine_chart_flat`: every finite set of points lies in an affine open `U`
  with a function `u` making `Γ(U)` flat over `k[X]` (torsion-free over a PID).
-/

open CategoryTheory Limits TopologicalSpace AlgebraicGeometry

universe u

noncomputable section

namespace CurvesJacobian

open Cech

variable {k : Type u} [Field k] (C : Scheme.{u}) [C.Over (Spec (CommRingCat.of k))]

local notation "Sk" => Spec (CommRingCat.of k)

/-- **Étale coordinates on smooth curves.** Every point of a scheme smooth of relative dimension
`1` over a field has an affine neighbourhood `W` with `Ω_{Γ(W)/k} = Γ(W) ds` for some
`s ∈ Γ(W)`. -/
theorem exists_kaehler_chart [SmoothOfRelativeDimension 1 (C ↘ Sk)] (x : C) :
    ∃ (W : C.Opens) (_ : IsAffineOpen W) (s : Γ(C, W)), x ∈ W ∧
      Submodule.span Γ(C, W) {KaehlerDifferential.D Γ(Sk, ⊤) Γ(C, W) s} = ⊤ ∧
      Algebra.FiniteType Γ(Sk, ⊤) Γ(C, W) := by
  obtain ⟨U, -, V, hV, hxV, hVU, hss⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1)
      (f := C ↘ Sk) x
  have hUtop : U = ⊤ := by
    ext y
    simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true, SetLike.mem_coe]
    rw [Subsingleton.elim y ((C ↘ Sk).base x)]
    exact hVU hxV
  subst hUtop
  have hss' : Algebra.IsStandardSmoothOfRelativeDimension 1 Γ(Sk, ⊤) Γ(C, V) := hss
  obtain ⟨ι, σ, _, _, P, hP⟩ := hss'.out
  haveI : Nontrivial Γ(C, V) := by
    refine ⟨⟨1, 0, fun h ↦ one_ne_zero (α := C.presheaf.stalk x) ?_⟩⟩
    have := congrArg (C.presheaf.germ V x hxV) h
    rwa [map_one, map_zero] at this
  have hrank := P.rank_kaehlerDifferential
  rw [hP] at hrank
  haveI : Unique ((Set.range P.map)ᶜ : Set _) := by
    have : Cardinal.mk ((Set.range P.map)ᶜ : Set _) = 1 := by
      have h := P.basisKaehler.mk_eq_rank
      rw [hrank] at h
      simpa using h
    have h := Cardinal.eq_one_iff_unique.mp this
    haveI := h.1
    exact uniqueOfSubsingleton h.2.some
  refine ⟨V, hV, P.val (default : ((Set.range P.map)ᶜ : Set _)), hxV, ?_, ?_⟩
  · rw [← P.basisKaehler.span_eq]
    congr 1
    ext ω
    simp only [Set.mem_singleton_iff, Set.mem_range]
    constructor
    · rintro rfl
      exact ⟨default, P.basisKaehler_apply _⟩
    · rintro ⟨i, rfl⟩
      rw [Subsingleton.elim i default, P.basisKaehler_apply]
  · haveI : Algebra.IsStandardSmooth Γ(Sk, ⊤) Γ(C, V) := P.isStandardSmooth
    infer_instance

section Places

open WeilCurves.FunctionField

variable (k) {K : Type*} [Field K] [Algebra k K] [PerfectField k] [IsFunctionField k K]

/-- A function field has infinitely many places. -/
theorem exists_place_notMem (F : Finset (Place k K)) : ∃ P : Place k K, P ∉ F := by
  classical
  by_contra h
  push Not at h
  choose x hx using fun P : Place k K ↦ exists_zero_only_at P
  set y := ∑ P ∈ F, (x P)⁻¹
  have hy : ∀ Q : Place k K, y ∉ Q.1 := by
    intro Q hyQ
    have hz : ∑ P ∈ F.erase Q, (x P)⁻¹ ∈ Q.1 := by
      refine Q.1.sum_mem fun P hP ↦ Place.mem_of_ord_nonneg Q ?_
      rw [Place.ord_inv]
      linarith [(hx P).2.2 Q (Finset.ne_of_mem_erase hP).symm]
    have hxQ : (x Q)⁻¹ ∈ Q.1 := by
      have := Q.1.sub_mem hyQ hz
      have e : y = (x Q)⁻¹ + ∑ P ∈ F.erase Q, (x P)⁻¹ :=
        (Finset.add_sum_erase F (fun P ↦ (x P)⁻¹) (h Q)).symm
      rw [e, add_sub_cancel_right] at this
      exact this
    have : Q.ord (x Q)⁻¹ < 0 := by rw [Place.ord_inv]; linarith [(hx Q).2.1]
    exact (Place.ord_neg_iff Q).mp this hxQ
  by_cases hyt : Transcendental k y
  · obtain ⟨P, hP⟩ := Place.exists_ord_pos hyt
    exact hy P (Place.mem_of_ord_nonneg P hP.le)
  · obtain ⟨t, ht⟩ := exists_transcendental k K
    obtain ⟨P, -⟩ := Place.exists_ord_pos ht
    exact hy P (P.mem_of_isAlgebraic (not_not.mp hyt))

/-- For every finite set of places there is a transcendental function regular at all of them. -/
theorem exists_transcendental_forall_mem (F : Finset (Place k K)) :
    ∃ t : K, Transcendental k t ∧ ∀ P ∈ F, t ∈ P.1 := by
  obtain ⟨P₀, hP₀⟩ := exists_place_notMem k F
  obtain ⟨x, hxt, -, hx⟩ := exists_zero_only_at P₀
  refine ⟨x⁻¹, transcendental_inv hxt, fun P hP ↦ Place.mem_of_ord_nonneg P ?_⟩
  rw [Place.ord_inv]
  linarith [hx P (fun h ↦ hP₀ (h ▸ hP))]

end Places

section BigChart

open Belyi WeilCurves.FunctionField

attribute [local instance] MvPolynomial.gradedAlgebra

open scoped Belyi.P1 Polynomial

variable (k) [PerfectField k] [IsCurveOver k C] [IsIntegral C]

/-- Every finite set of points of a curve consists of points at which some transcendental
rational function is regular. -/
theorem exists_transcendental_forall_mem_stalk (S : Finset C) :
    ∃ t : C.functionField, Transcendental k t ∧
      ∀ x ∈ S, t ∈ Set.range (algebraMap (C.presheaf.stalk x) C.functionField) := by
  classical
  let F : Finset (Place k C.functionField) :=
    (S.filter (fun y ↦ y ≠ genericPoint C)).attach.image fun y ↦
      curvePlaceEquiv k C
        (Subtype.mk y.1 (by have := y.2; rw [Finset.mem_filter] at this; exact this.2))
  obtain ⟨t, ht, htF⟩ := exists_transcendental_forall_mem k F
  refine ⟨t, ht, fun x hx ↦ ?_⟩
  by_cases hη : x = genericPoint C
  · exact mem_range_algebraMap_of_eq_genericPoint hη t
  · have hmem := htF (curvePlaceEquiv k C ⟨x, hη⟩) (Finset.mem_image.mpr
      ⟨⟨x, Finset.mem_filter.mpr ⟨hx, hη⟩⟩, Finset.mem_attach _ _, rfl⟩)
    rw [curvePlaceEquiv_apply] at hmem
    exact hmem

/-- The finite morphism `C → ℙ¹` attached to a rational function (belyi). -/
noncomputable abbrev curveMap (t : C.functionField) : C ⟶ ProjectiveLine.scheme k :=
  homOfFunctionField k C (valuationRing_stalk_of_isCurveOver k C) t

/-- The `k`-algebra structure on a stalk of `C`. -/
noncomputable abbrev stalkAlgebra (x : C) : Algebra k (C.presheaf.stalk x) :=
  ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (C ↘ Sk).appTop ≫
    C.presheaf.germ ⊤ x trivial).hom.toAlgebra

lemma isDominant_specMap_stalkSpecializes (x : C) :
    IsDominant (Spec.map (C.presheaf.stalkSpecializes
      ((genericPoint_spec C).specializes (Set.mem_univ x)))) := by
  set φ := C.presheaf.stalkSpecializes ((genericPoint_spec C).specializes (Set.mem_univ x))
  have hinj : Function.Injective φ.hom :=
    IsFractionRing.injective (C.presheaf.stalk x) C.functionField
  let p₀ : Spec C.functionField := IsLocalRing.closedPoint C.functionField
  have hp : ((Spec.map φ).base p₀ : PrimeSpectrum (C.presheaf.stalk x)).asIdeal = ⊥ := by
    change Ideal.comap φ.hom (IsLocalRing.maximalIdeal C.functionField) = ⊥
    rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot,
      (RingHom.injective_iff_ker_eq_bot _).mp hinj]
  refine ⟨Dense.mono (Set.singleton_subset_iff.mpr (Set.mem_range_self p₀)) ?_⟩
  rw [dense_iff_closure_eq]
  have hc := PrimeSpectrum.closure_singleton (R := C.presheaf.stalk x) ((Spec.map φ) p₀)
  rw [hp, Submodule.bot_coe, PrimeSpectrum.zeroLocus_singleton_zero] at hc
  exact hc

omit [PerfectField k] [IsCurveOver k C] [IsIntegral C] in
/-- `k`-algebra homomorphisms commute with evaluation of the chart ring of `D₊(x₁)`. -/
lemma comp_awayEval {R R' : Type u} [CommRing R] [CommRing R'] [Algebra k R] [Algebra k R']
    (φ : R →ₐ[k] R') (a : R) :
    (φ : R →+* R').comp (P1.awayEval k a) = P1.awayEval k (φ a) := by
  have h : φ.comp (P1.awayEvalₐ k a) = P1.awayEvalₐ k (φ a) := by
    have hX : (P1.awayChartEquivOne k).symm Polynomial.X = P1.affineCoord k :=
      (AlgEquiv.symm_apply_eq _).mpr (P1.awayChartEquivOne_affineCoord k).symm
    have hc : (φ.comp (P1.awayEvalₐ k a)).comp (P1.awayChartEquivOne k).symm.toAlgHom =
        (P1.awayEvalₐ k (φ a)).comp (P1.awayChartEquivOne k).symm.toAlgHom := by
      apply Polynomial.algHom_ext
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, hX]
      change φ (P1.awayEval k a (P1.affineCoord k)) = P1.awayEval k (φ a) (P1.affineCoord k)
      rw [P1.awayEval_affineCoord, P1.awayEval_affineCoord]
    ext z
    have := congrArg (fun f ↦ f (P1.awayChartEquivOne k z)) hc
    simpa using this
  exact congrArg AlgHom.toRingHom h

/-- If a rational function `t` is regular at `x`, the morphism `C → ℙ¹` attached to `t` maps `x`
into the affine chart `D₊(x₁)` (whose coordinate `x₀/x₁` pulls back to `t`). -/
theorem curveMap_mem_U_one (t : C.functionField) (x : C)
    (hx : t ∈ Set.range (algebraMap (C.presheaf.stalk x) C.functionField)) :
    curveMap k C t x ∈ ProjectiveLine.U k 1 := by
  obtain ⟨a, ha⟩ := hx
  letI := stalkAlgebra k C x
  set h := (genericPoint_spec C).specializes (Set.mem_univ x)
  haveI := isDominant_specMap_stalkSpecializes C x
  have hgen : C.fromSpecStalk (genericPoint C) ≫ curveMap k C t = functionFieldPoint k C t := by
    have h3 := congrArg Scheme.RationalMap.fromFunctionField
      (toRationalMap_homOfFunctionField k C (valuationRing_stalk_of_isCurveOver k C) t)
    rw [Scheme.Hom.toRationalMap, Scheme.RationalMap.fromFunctionField_toRationalMap,
      fromFunctionField_ratMapOfFunctionField, Scheme.PartialMap.fromFunctionField,
      Scheme.PartialMap.fromSpecStalkOfMem_toPartialMap] at h3
    exact h3
  let φ : C.presheaf.stalk x →ₐ[k] C.functionField :=
    { (C.presheaf.stalkSpecializes h).hom with
      commutes' := fun c ↦ by
        change (C.presheaf.stalkSpecializes h).hom ((C.presheaf.germ ⊤ x trivial).hom _) = _
        rw [← CommRingCat.comp_apply, TopCat.Presheaf.germ_stalkSpecializes]
        rfl }
  have hφa : φ a = t := ha
  have key : C.fromSpecStalk x ≫ curveMap k C t = P1.point k a := by
    refine ext_of_isDominant_of_isSeparated (Limits.terminal.from _)
      (Limits.terminal.hom_ext _ _) (Spec.map (C.presheaf.stalkSpecializes h)) ?_
    rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk_assoc, hgen, functionFieldPoint,
      P1.point, P1.point]
    erw [← Spec.map_comp_assoc]
    congr 2
    ext z
    change _ = (C.presheaf.stalkSpecializes h).hom (P1.awayEval k a z)
    rw [← hφa]
    exact (congrArg (fun f : _ →+* _ ↦ f z) (comp_awayEval k φ a)).symm
  have hpt := congrArg (fun f : Spec (C.presheaf.stalk x) ⟶ ProjectiveLine.scheme k ↦
    f (IsLocalRing.closedPoint _)) key
  simp only [Scheme.Hom.comp_apply, Scheme.fromSpecStalk_closedPoint] at hpt
  rw [hpt]
  have hr : (Proj.awayι (P1Grading k) (MvPolynomial.X 1) (P1.X_mem_P1Grading k 1)
      one_pos).opensRange = ProjectiveLine.U k 1 := Proj.opensRange_awayι _ _ _ _
  rw [← hr]
  exact ⟨_, rfl⟩

omit [PerfectField k] [IsCurveOver k C] [IsIntegral C] in
lemma chartCoord_one_eq_affineCoord :
    (ProjectiveLine.chartCoord 1 : HomogeneousLocalization.Away (ProjectiveLine.grading k)
      (MvPolynomial.X 1)) = P1.affineCoord k := by
  apply HomogeneousLocalization.val_injective
  simp [ProjectiveLine.chartCoord, P1.affineCoord, HomogeneousLocalization.Away.val_mk]

/-- The chart coordinate `x₀/x₁` of `D₊(x₁) ⊆ ℙ¹` pulls back along the morphism `C → ℙ¹`
attached to `t` to a function whose germ at the generic point is `t`. -/
theorem germ_curveMap_coord (t : C.functionField)
    (hη : genericPoint C ∈ curveMap k C t ⁻¹ᵁ ProjectiveLine.U k 1) :
    C.presheaf.germ _ (genericPoint C) hη
      ((curveMap k C t).app _ (ProjectiveLine.coord k 1)) = t := by
  set π := curveMap k C t
  set g := C.fromSpecStalk (genericPoint C) ≫ π
  have hgen : g = P1.point k t := by
    have h3 := congrArg Scheme.RationalMap.fromFunctionField
      (toRationalMap_homOfFunctionField k C (valuationRing_stalk_of_isCurveOver k C) t)
    rw [Scheme.Hom.toRationalMap, Scheme.RationalMap.fromFunctionField_toRationalMap,
      fromFunctionField_ratMapOfFunctionField, Scheme.PartialMap.fromFunctionField,
      Scheme.PartialMap.fromSpecStalkOfMem_toPartialMap] at h3
    exact h3
  have hr : (Proj.awayι (P1Grading k) (MvPolynomial.X 1) (P1.X_mem_P1Grading k 1)
      one_pos).opensRange = ProjectiveLine.U k 1 := Proj.opensRange_awayι _ _ _ _
  have hi : (⊤ : (Spec C.functionField).Opens) ≤ g ⁻¹ᵁ ProjectiveLine.U k 1 := by
    intro z _
    change g z ∈ ProjectiveLine.U k 1
    rw [← hr, hgen]
    exact ⟨(Spec.map (CommRingCat.ofHom (P1.awayEval k t))) z, rfl⟩
  have hU := ProjectiveLine.isAffineOpen_U k 1
  have h1 := IsAffineOpen.SpecMap_appLE_fromSpec g hU (isAffineOpen_top _) hi
  rw [ProjectiveLine.fromSpec_eq, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h1
  let ι := Proj.awayι (ProjectiveLine.grading k) (MvPolynomial.X 1) (ProjectiveLine.X_mem 1)
    one_pos
  have h2 : (Spec.map (g.appLE (ProjectiveLine.U k 1) ⊤ hi) ≫
      Spec.map (Proj.awayToSection (ProjectiveLine.grading k) (MvPolynomial.X 1))) ≫ ι =
      (Spec.map (Scheme.ΓSpecIso C.functionField).inv ≫
        Spec.map (CommRingCat.ofHom (P1.awayEval (R := C.functionField) k t))) ≫ ι := by
    simp only [Category.assoc]
    refine h1.trans ?_
    rw [hgen]
    rfl
  have h3 := (cancel_mono _).mp h2
  rw [← Spec.map_comp, ← Spec.map_comp] at h3
  have e1 : g.appLE (ProjectiveLine.U k 1) ⊤ hi = (curveMap k C t).app _ ≫
      C.presheaf.germ _ _ hη ≫ (Scheme.ΓSpecIso C.functionField).inv := by
    rw [Scheme.Hom.comp_appLE, Scheme.Hom.appLE, Scheme.fromSpecStalk_app hη]
    simp only [Category.assoc, ← Functor.map_comp]
    erw [Subsingleton.elim ((homOfLE _).op ≫ (homOfLE hi).op) (𝟙 _), CategoryTheory.Functor.map_id,
      Category.comp_id]
  have h4 := Spec.map_injective h3
  rw [e1, ← Category.assoc, ← Category.assoc] at h4
  have h5 := (cancel_mono _).mp h4
  have h6 := ConcreteCategory.congr_hom h5 (ProjectiveLine.chartCoord 1)
  have h7 : P1.awayEval (R := C.functionField) k t (ProjectiveLine.chartCoord 1) = t := by
    rw [chartCoord_one_eq_affineCoord, P1.awayEval_affineCoord]
  exact h6.trans h7

/-- **A big affine chart.** Every finite set of points of a curve lies in an affine open `U` with
a function `u ∈ Γ(U)` making `Γ(U)` a flat `k[X]`-algebra (`U` is the preimage of `D₊(x₁)` under
the finite morphism `C → ℙ¹` attached to a rational function regular at the given points, and `u`
is the pulled back coordinate). -/
theorem exists_affine_chart_flat (S : Finset C) :
    ∃ (U : C.Opens) (_ : IsAffineOpen U) (u : Γ(C, U)), (∀ x ∈ S, x ∈ U) ∧
      letI := (Polynomial.aeval (R := Γ(Sk, ⊤)) u).toRingHom.toAlgebra
      Module.Flat Γ(Sk, ⊤)[X] Γ(C, U) := by
  obtain ⟨t, ht, htS⟩ := exists_transcendental_forall_mem_stalk k C S
  set π := curveMap k C t
  haveI : IsFinite π := isFinite_homOfFunctionField_of_isCurveOver k C ht
  set U := π ⁻¹ᵁ ProjectiveLine.U k 1
  have hU : IsAffineOpen U := (ProjectiveLine.isAffineOpen_U k 1).preimage π
  have hη : genericPoint C ∈ U :=
    curveMap_mem_U_one k C t _ (mem_range_algebraMap_of_eq_genericPoint rfl t)
  refine ⟨U, hU, π.app _ (ProjectiveLine.coord k 1), fun x hx ↦ curveMap_mem_U_one k C t x
    (htS x hx), ?_⟩
  letI : Field Γ(Sk, ⊤) :=
    ((Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv.toMulEquiv.isField
      (Field.toIsField k)).toField
  letI := (Polynomial.aeval (R := Γ(Sk, ⊤))
    (π.app _ (ProjectiveLine.coord k 1))).toRingHom.toAlgebra
  haveI : Nonempty U := ⟨⟨_, hη⟩⟩
  -- the germ at the generic point
  set γ : Γ(C, U) →+* C.functionField := (C.presheaf.germ U _ hη).hom
  have hγ : ∀ p : Γ(Sk, ⊤)[X], γ (algebraMap Γ(Sk, ⊤)[X] Γ(C, U) p) =
      Polynomial.aeval t (p.map (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom) := by
    intro p
    change γ (Polynomial.aeval _ p) = _
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.aeval_def, Polynomial.eval₂_map]
    congr 1
    · ext c
      change C.presheaf.germ U _ hη ((C ↘ Sk).appLE ⊤ U (by simp) c) =
        ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (C ↘ Sk).appTop ≫
          C.presheaf.germ ⊤ (genericPoint C) trivial)
          ((Scheme.ΓSpecIso (CommRingCat.of k)).hom c)
      rw [← CommRingCat.comp_apply (Scheme.ΓSpecIso (CommRingCat.of k)).hom,
        Iso.hom_inv_id_assoc, Scheme.Hom.appLE, CommRingCat.comp_apply,
        C.presheaf.germ_res_apply]
      rfl
    · exact germ_curveMap_coord k C t hη
  have hinj : Function.Injective (algebraMap Γ(Sk, ⊤)[X] Γ(C, U)) := by
    rw [injective_iff_map_eq_zero]
    intro p hp
    have h0 := hγ p
    rw [hp, map_zero] at h0
    by_contra hp0
    refine ht ⟨p.map (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom, ?_, h0.symm⟩
    exact (Polynomial.map_ne_zero_iff
      (Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv.injective).mpr hp0
  rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout]
  rw [eq_bot_iff]
  rintro z ⟨⟨p, hp⟩, hpz⟩
  change algebraMap Γ(Sk, ⊤)[X] Γ(C, U) p * z = 0 at hpz
  have hp0 : algebraMap Γ(Sk, ⊤)[X] Γ(C, U) p ≠ 0 := fun h ↦
    nonZeroDivisors.coe_ne_zero ⟨p, hp⟩ ((injective_iff_map_eq_zero _).mp hinj p h)
  exact (mul_eq_zero.mp hpz).resolve_left hp0

end BigChart

end CurvesJacobian
