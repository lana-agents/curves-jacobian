import CurvesJacobian.Picard.CechLineBundle
import CurvesJacobian.CommAlg.FittingZero

/-!
# The Fitting ideal of `H¹` of a line bundle in a family (JAC J2, local part)

The theta divisor of the Jacobian is `Θ = V(Fit₀ R¹p_*(𝒫 ⊗ κ))` (`JAC-plan.md`, J2). Over an
affine base `S` and for a line bundle `L` on `Y/S` with a two-affine covering `(U, V)`:

* **`fitt0_cechModH1_baseChange`**: `Fit₀(H¹(L_T)) = Fit₀(H¹(L)) Γ(T)` for every affine
  `S`-scheme `T` (`Cech.lineBundleH1BaseChange'` and `Fitting.fitt0_baseChange`), so the local
  ideals `Fit₀(H¹)` over the affine opens of the base are compatible with restriction;
* **`Fitting.fitt0_quotient_range_eq`**: for a map `δ : K₀ → K₁` of free modules of the same
  finite rank, `Fit₀(K₁ / δ K₀) = (det δ)`: where the perfect model `δ` of
  `Cech.exists_finite_projective_lineBundle` has free terms of equal rank (`χ = 0`), the ideal is
  principal, generated by `det δ`.
-/

open CategoryTheory Limits TensorProduct AlgebraicGeometry

universe u

noncomputable section

namespace CurvesJacobian

namespace Fitting

variable {R : Type u} [CommRing R] {K₀ K₁ : Type*} [AddCommGroup K₀] [Module R K₀]
  [AddCommGroup K₁] [Module R K₁] {n : ℕ}

/-- **`Fit₀(K₁ / δ K₀) = (det δ)`** for `δ` between free modules of the same finite rank. -/
theorem fitt0_quotient_range_eq (b₀ : Module.Basis (Fin n) R K₀) (b₁ : Module.Basis (Fin n) R K₁)
    (δ : K₀ →ₗ[R] K₁) :
    fitt0 R (K₁ ⧸ LinearMap.range δ) = Ideal.span {(LinearMap.toMatrix b₀ b₁ δ).det} := by
  set D := LinearMap.toMatrix b₀ b₁ δ
  have hmap : (LinearMap.range δ).map (b₁.equivFun : K₁ →ₗ[R] Fin n → R) =
      LinearMap.range D.mulVecLin := by
    ext y
    simp only [Submodule.mem_map, LinearMap.mem_range, LinearEquiv.coe_coe]
    constructor
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
      refine ⟨b₀.equivFun x, ?_⟩
      rw [Matrix.mulVecLin_apply, Module.Basis.equivFun_apply, Module.Basis.equivFun_apply,
        LinearMap.toMatrix_mulVec_repr]
    · rintro ⟨x, rfl⟩
      refine ⟨δ (b₀.equivFun.symm x), ⟨_, rfl⟩, ?_⟩
      rw [Module.Basis.equivFun_apply, ← LinearMap.toMatrix_mulVec_repr b₀ b₁,
        ← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
      rfl
  have : Module.Finite R K₁ := Module.Finite.of_basis b₁
  rw [fitt0_congr (Submodule.Quotient.equiv _ _ b₁.equivFun hmap), fitt0_quotient_range]

end Fitting

namespace Cech

open Scheme.Modules

variable {S Y T : Scheme.{u}} [Y.Over S] [T.Over S] [IsAffine S] [IsAffine T] (L : Y.Modules)
  [L.IsInvertible] (U V : Y.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V)
  (hUV : IsAffineOpen (U ⊓ V))

include hU hV hUV in
/-- **The Fitting ideal of Čech `H¹` commutes with base change**:
`Fit₀(H¹(L_T)) = Fit₀(H¹(L)) Γ(T)`. -/
theorem fitt0_cechModH1_baseChange [Module.Finite Γ(S, ⊤) (cechModH1 S L U V)] :
    Fitting.fitt0 Γ(T, ⊤) (cechModH1 T (lineBundleBaseChange (T := T) L)
      (pullback.fst (Y ↘ S) (T ↘ S) ⁻¹ᵁ U) (pullback.fst (Y ↘ S) (T ↘ S) ⁻¹ᵁ V)) =
      Ideal.map (algebraMap Γ(S, ⊤) Γ(T, ⊤)) (Fitting.fitt0 Γ(S, ⊤) (cechModH1 S L U V)) := by
  rw [← Fitting.fitt0_baseChange]
  exact (Fitting.fitt0_congr (lineBundleH1BaseChange' L U V hU hV hUV).symm).symm

end Cech

end CurvesJacobian
