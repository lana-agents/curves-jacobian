/-!
# Zero schemes of generating sections are relative effective Cartier divisors

Let `C` be a curve over a perfect field `k` with a finite `π : C → ℙ¹_k`, `T` an affine
`k`-scheme, `X_T = C ×_k T` with the charts `U_0`, `U_1` (preimages of the standard charts of
`ℙ¹`), and `L` an invertible sheaf on `X_T` satisfying the `F`-condition (Čech `H¹ = 0`, Čech
`H⁰` invertible over `Γ(T)`) whose `H⁰` is generated by one element `s`. This file proves the
surjectivity step of Stacks, Lemma 44.6.4 (Tag 0B9X): the zero scheme `D` of the global section
`s₀` corresponding to `s` is a relative effective Cartier divisor on `X_T` over `T`, of degree
`g(C)` everywhere, with `𝒪(D) ≅ L` (`CurvesJacobian.exists_relEffCartier_of_cyclic`).

Instead of the reduction to fibres over points used by Stacks, the argument is relative:

* `CurvesJacobian.one_tmul_res_ne_zero`: for every field `K` over `Γ(T)`, `1 ⊗ s₀|_{U_i} ≠ 0`
  in `K ⊗ Γ(L, U_i)`. Indeed `1 ⊗ s ≠ 0` in `K ⊗ H⁰`, `K ⊗ H⁰ → K ⊗ (Γ(L, U_0) × Γ(L, U_1))`
  is injective (`H¹ = 0` and `Γ(U_0 ∩ U_1)` is flat), and `K ⊗ Γ(L, U_i) → K ⊗ Γ(L, U_0 ∩ U_1)`
  is injective (localization at the chart coordinate of a projective module over the domain
  `K ⊗ Γ(U_i)`, `one_tmul_eq_zero_of_isLocalizedModule`);
* `CurvesJacobian.smul_injective_chart`, `CurvesJacobian.flat_quotient_chart`: by the
  fibrewise criterion of `CurvesJacobian.FibreFlat`, `s₀|_{U_i}` is a nonzerodivisor and
  `Γ(U_i) / c(s₀|_{U_i})` is flat over `Γ(T)`;
* `CurvesJacobian.eq_zero_of_smul_eq_zero`: `s₀` is a nonzerodivisor on every open;
* `CurvesJacobian.zeroSchemeDivisor`: the divisor, with its degree
  (`degree_zeroSchemeDivisor`, via `degree_zeroScheme_eq_curveGenus`) and class
  (`picClass_zeroSchemeDivisor`).
-/

open CategoryTheory Limits TopologicalSpace AlgebraicGeometry Opposite TensorProduct

universe u

noncomputable section

namespace CurvesJacobian

section Algebra

variable {A R M K : Type*} [CommRing A] [CommRing R] [Algebra A R] [AddCommGroup M]
  [Module R M] [Module A M] [IsScalarTower A R M] [CommRing K] [Algebra A K]

/-- If `M` is projective over `R`, `1 ⊗ m = 0` in `K ⊗_A M` as soon as `1 ⊗ μ m = 0` in
`K ⊗_A R` for every `μ : M →ₗ[R] R`. -/
theorem one_tmul_eq_zero_of_dual [Module.Projective R M] {m : M}
    (h : ∀ μ : M →ₗ[R] R, (1 : K) ⊗ₜ[A] μ m = 0) : (1 : K) ⊗ₜ[A] m = 0 := by
  classical
  obtain ⟨σ, hσ⟩ := Module.projective_def'.mp ‹Module.Projective R M›
  have hs' : m = (σ m).sum fun m' r ↦ r • m' := by
    simpa [Finsupp.linearCombination_apply] using congr($hσ m).symm
  rw [hs', Finsupp.sum, TensorProduct.tmul_sum]
  refine Finset.sum_eq_zero fun m' _ ↦ ?_
  have : (1 : K) ⊗ₜ[A] (σ m m') = 0 := h ((Finsupp.lapply m') ∘ₗ σ)
  calc (1 : K) ⊗ₜ[A] (σ m m' • m')
      = ((LinearMap.toSpanSingleton R M m').restrictScalars A).lTensor K
          ((1 : K) ⊗ₜ[A] σ m m') := rfl
    _ = 0 := by rw [this, map_zero]

/-- Over a fibre ring `K ⊗_A R` which is a domain, multiplication by `f` with `1 ⊗ f ≠ 0` is
injective on `1 ⊗ M` for `M` projective over `R`. -/
theorem one_tmul_eq_zero_of_pow_smul [Module.Projective R M] [IsDomain (K ⊗[A] R)] {f : R}
    (hf : (1 : K) ⊗ₜ[A] f ≠ 0) (n : ℕ) {m : M} (h : (1 : K) ⊗ₜ[A] (f ^ n • m) = 0) :
    (1 : K) ⊗ₜ[A] m = 0 := by
  refine one_tmul_eq_zero_of_dual (R := R) fun μ ↦ ?_
  have h1 := congrArg ((μ.restrictScalars A).lTensor K) h
  rw [LinearMap.lTensor_tmul, map_zero, LinearMap.restrictScalars_apply, map_smul,
    smul_eq_mul, show (1 : K) ⊗ₜ[A] (f ^ n * μ m) = ((1 : K) ⊗ₜ[A] f) ^ n * (1 ⊗ₜ μ m) by
      rw [Algebra.TensorProduct.tmul_pow, Algebra.TensorProduct.tmul_mul_tmul, one_pow,
        one_mul]] at h1
  exact (mul_eq_zero.mp h1).resolve_left (pow_ne_zero n hf)

/-- **Base change of a localization is injective on a projective module with domain fibre**:
if `φ : M → M'` is the localization away from `f` and `K ⊗_A R` is a domain in which `1 ⊗ f ≠ 0`,
then `1 ⊗ φ m = 0` implies `1 ⊗ m = 0`. -/
theorem one_tmul_eq_zero_of_isLocalizedModule [Module.Projective R M] [IsDomain (K ⊗[A] R)]
    {M' : Type*} [AddCommGroup M'] [Module R M'] [Module A M'] [IsScalarTower A R M'] {f : R}
    (φ : M →ₗ[R] M') [IsLocalizedModule (Submonoid.powers f) φ] (hf : (1 : K) ⊗ₜ[A] f ≠ 0)
    {m : M} (h : (1 : K) ⊗ₜ[A] φ m = 0) : (1 : K) ⊗ₜ[A] m = 0 := by
  let ψ := TensorProduct.AlgebraTensorModule.rTensor A K φ
  have h1 : ψ (m ⊗ₜ (1 : K)) = 0 := by
    change φ m ⊗ₜ (1 : K) = 0
    rw [← TensorProduct.comm_tmul A K M', h, map_zero]
  obtain ⟨⟨c, n, rfl⟩, hc⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers f) ψ).mp h1
  refine one_tmul_eq_zero_of_pow_smul hf n ?_
  rw [Submonoid.smul_def, TensorProduct.smul_tmul'] at hc
  rw [← TensorProduct.comm_tmul A M K, hc, map_zero]

/-- A generator of an invertible module stays nonzero in every fibre. -/
theorem one_tmul_ne_zero_of_span_eq_top {H : Type*} [AddCommGroup H] [Module A H]
    [Module.Invertible A H] [Nontrivial K] {s : H} (hs : Submodule.span A {s} = ⊤) :
    (1 : K) ⊗ₜ[A] s ≠ 0 := by
  intro h0
  have hall : ∀ x : K ⊗[A] H, x = 0 := fun x ↦ by
    induction x using TensorProduct.induction_on with
    | zero => rfl
    | add x y hx hy => rw [hx, hy, add_zero]
    | tmul c y =>
      obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp (hs ▸ Submodule.mem_top : y ∈ _)
      rw [← TensorProduct.smul_tmul, show a • c = (a • c) • (1 : K) by rw [smul_eq_mul, mul_one],
        ← TensorProduct.smul_tmul', h0, smul_zero]
  have : (1 : K) = 0 := FaithfulSMul.eq_of_smul_eq_smul (α := K ⊗[A] H) fun x ↦ by
    rw [hall x, smul_zero, smul_zero]
  exact one_ne_zero this

/-- Regularity of `r ↦ r • s` passes to a localization `R' = R_f`, `M' = M_f`. -/
theorem smul_eq_zero_of_isLocalizedModule {R' M' : Type*} [CommRing R'] [Algebra R R'] {f : R}
    [IsLocalization.Away f R'] [AddCommGroup M'] [Module R M'] [Module R' M']
    [IsScalarTower R R' M'] (φ : M →ₗ[R] M') [IsLocalizedModule (Submonoid.powers f) φ] {s : M}
    (hs : ∀ r : R, r • s = 0 → r = 0) (r' : R') (h : r' • φ s = 0) : r' = 0 := by
  obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers f) r'
  have h1 : φ (a • s) = 0 := by
    rw [map_smul, ← algebraMap_smul R' a (φ s),
      ← IsLocalization.mk'_spec R' a (⟨f ^ n, n, rfl⟩ : Submonoid.powers f), mul_comm,
      mul_smul, h, smul_zero]
  obtain ⟨⟨_, m, rfl⟩, hc⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers f) φ).mp h1
  rw [Submonoid.smul_def, smul_smul] at hc
  exact (IsLocalization.mk'_eq_zero_iff _ _).mpr ⟨⟨f ^ m, m, rfl⟩, hs _ hc⟩

end Algebra

section Sections

open Cech

variable {S Y : Scheme.{u}} [Y.Over S]

lemma res_algebraMap {W W' : Y.Opens} (h : W' ≤ W) (a : Γ(S, ⊤)) :
    Y.presheaf.map (homOfLE h).op (algebraMap Γ(S, ⊤) Γ(Y, W) a) =
      algebraMap Γ(S, ⊤) Γ(Y, W') a := by
  rw [algebraMap_sections, ← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  rfl

open Scheme.Modules in
/-- `Γ(S) → Γ(Y, W) → Γ(L, D(f))` is a scalar tower. -/
lemma isScalarTower_basicOpen (L : Y.Modules) {W : Y.Opens} (f : Γ(Y, W)) :
    IsScalarTower Γ(S, ⊤) Γ(Y, W) Γ(L, Y.basicOpen f) where
  smul_assoc a r x := by
    rw [smul_basicOpen_def, smul_basicOpen_def, smul_sections_def, Algebra.smul_def, map_mul,
      mul_smul, res_algebraMap]

end Sections

section Curve

open Cech Belyi Polynomial ModulesGlue

variable {k : Type u} [Field k] [PerfectField k] {C : Scheme.{u}}
  [C.Over (Spec (CommRingCat.of k))] [IsCurveOver k C] (π : C ⟶ ProjectiveLine.scheme k)
  [IsFinite π] {T : Scheme.{u}} [T.Over (Spec (CommRingCat.of k))] [IsAffine T]

local notation "Sk" => Spec (CommRingCat.of k)
local notation "XT" => pullback (C ↘ Sk) (T ↘ Sk)
local notation "𝒰" => chartOf π (T ↘ Sk)

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] [IsAffine T] in
lemma chart_inf_le (i : Fin 2) : ((𝒰 0) ⊓ (𝒰 1)) ≤ 𝒰 i := by
  fin_cases i
  exacts [inf_le_left, inf_le_right]

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] [IsAffine T] in
lemma basicOpen_chartCoord (i : Fin 2) :
    (XT).basicOpen (chartCoord (T₀ := T) π i) = (𝒰 0) ⊓ (𝒰 1) := by
  fin_cases i
  exacts [basicOpen_chartτ _, basicOpen_chartσ _]

omit [PerfectField k] [IsCurveOver k C] in
lemma isUnit_res_chartCoord (i : Fin 2) :
    IsUnit ((XT).presheaf.map (homOfLE (chart_inf_le (T := T) π i)).op
      (chartCoord (T₀ := T) π i)) := by
  fin_cases i
  · letI := ((XT).presheaf.map (homOfLE (inf_le_left : (𝒰 0) ⊓ (𝒰 1) ≤ _)).op).hom.toAlgebra
    haveI := isLocalization_chart_inf_zero (T₀ := T) π
    exact IsLocalization.Away.algebraMap_isUnit (chartCoord (T₀ := T) π 0)
  · letI := ((XT).presheaf.map (homOfLE (inf_le_right : (𝒰 0) ⊓ (𝒰 1) ≤ _)).op).hom.toAlgebra
    haveI := isLocalization_chart_inf_one (T₀ := T) π
    exact IsLocalization.Away.algebraMap_isUnit (chartCoord (T₀ := T) π 1)

/-- The chart coordinate does not vanish in any fibre. -/
lemma one_tmul_chartCoord_ne_zero (K : Type u) [Field K] [Algebra Γ(T, ⊤) K] (i : Fin 2) :
    (1 : K) ⊗ₜ[Γ(T, ⊤)] chartCoord (T₀ := T) π i ≠ 0 := by
  intro h
  haveI := nontrivial_tensor_chart_inf (T₀ := T) π K
  let φ : Γ(XT, 𝒰 i) →ₐ[Γ(T, ⊤)] Γ(XT, (𝒰 0) ⊓ (𝒰 1)) :=
    { ((XT).presheaf.map (homOfLE (chart_inf_le (T := T) π i)).op).hom with
      commutes' := fun r ↦ res_algebraMap (chart_inf_le (T := T) π i) r }
  have hu := (isUnit_res_chartCoord (T := T) π i).map
    (Algebra.TensorProduct.includeRight (R := Γ(T, ⊤)) (A := K))
  have h0 := congrArg (Algebra.TensorProduct.map (AlgHom.id Γ(T, ⊤) K) φ) h
  rw [Algebra.TensorProduct.map_tmul, map_zero, AlgHom.id_apply] at h0
  rw [Algebra.TensorProduct.includeRight_apply] at hu
  exact not_isUnit_zero (h0 ▸ hu)

open Scheme.Modules in
/-- If the restriction of `s₀` to `U_0 ∩ U_1` vanishes in a fibre, so does its restriction to
`U_i`: `Γ(L, U_0 ∩ U_1)` is the localization of `Γ(L, U_i)` at the chart coordinate, and
`Γ(L, U_i)` is projective over `Γ(U_i)`, whose fibres are domains. -/
lemma one_tmul_res_eq_zero_of_inf (L : (XT).Modules) [L.IsInvertible] (s₀ : Γ(L, ⊤))
    (K : Type u) [Field K] [Algebra Γ(T, ⊤) K] (i : Fin 2)
    (h : (1 : K) ⊗ₜ[Γ(T, ⊤)] rs L (le_top : (𝒰 0) ⊓ (𝒰 1) ≤ ⊤) s₀ = 0) :
    (1 : K) ⊗ₜ[Γ(T, ⊤)] rs L (le_top : 𝒰 i ≤ ⊤) s₀ = 0 := by
  have hU := isAffineOpen_chart (T₀ := T) π i
  set f := chartCoord (T₀ := T) π i
  haveI := isQuasicoherent_of_isInvertible L
  haveI := L.isLocalizedModule_resBasicOpen hU f
  haveI := projective_sections L hU
  haveI := isDomain_tensor_chart (T₀ := T) π i K
  haveI := isScalarTower_basicOpen (S := T) L f
  have hD : (XT).basicOpen f ≤ (𝒰 0) ⊓ (𝒰 1) := (basicOpen_chartCoord π i).le
  refine one_tmul_eq_zero_of_isLocalizedModule (L.resBasicOpen f)
    (one_tmul_chartCoord_ne_zero π K i) ?_
  have h1 := congrArg ((resModLin T L hD).lTensor K) h
  rw [LinearMap.lTensor_tmul, map_zero, resModLin_apply] at h1
  rw [resBasicOpen_apply]
  convert h1 using 2
  exact (rs_rs L _ _ s₀).trans (rs_rs L _ _ s₀).symm

/-- **The section does not vanish in any fibre on any chart** (Stacks, Tag 0B9X): if `L`
satisfies the `F`-condition and `Ȟ⁰(L)` is generated by (the image of) `s₀`, then for every field
`K` over `Γ(T)`, `1 ⊗ s₀|_{U_i} ≠ 0` in `K ⊗_{Γ(T)} Γ(L, U_i)`. -/
theorem one_tmul_res_ne_zero (L : (XT).Modules) [L.IsInvertible] (hL : FCond π (T ↘ Sk) L)
    (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤)
    (K : Type u) [Field K] [Algebra Γ(T, ⊤) K] (i : Fin 2) :
    (1 : K) ⊗ₜ[Γ(T, ⊤)] rs L (le_top : 𝒰 i ≤ ⊤) s₀ ≠ 0 := by
  obtain ⟨h1, h0⟩ := hL
  haveI := h0
  have hne := one_tmul_ne_zero_of_span_eq_top (K := K) hs
  have hsurj := (TwoTerm.subsingleton_H1_iff _ _).mp h1
  haveI := flat_chart_inf (T₀ := T) π
  haveI := flat_sections (S := T) L (isAffineOpen_chart_inf (T₀ := T) π)
  have hinj := (TwoTerm.kerBaseChangeMap_bijective K hsurj).1
  have hres : ∀ j : Fin 2, rs L (le_top : (𝒰 0) ⊓ (𝒰 1) ≤ ⊤) s₀ =
      resModLin T L (chart_inf_le (T := T) π j) (rs L (le_top : 𝒰 j ≤ ⊤) s₀) := fun j ↦
    (rs_rs L _ _ s₀).symm
  have key : ∀ j : Fin 2, (1 : K) ⊗ₜ[Γ(T, ⊤)] rs L (le_top : 𝒰 j ≤ ⊤) s₀ = 0 →
      ∀ j', (1 : K) ⊗ₜ[Γ(T, ⊤)] rs L (le_top : 𝒰 j' ≤ ⊤) s₀ = 0 := by
    intro j hj j'
    refine one_tmul_res_eq_zero_of_inf π L s₀ K j' ?_
    rw [hres j, ← LinearMap.lTensor_tmul, hj, map_zero]
  intro hi
  apply hne
  apply hinj
  rw [map_zero]
  apply Subtype.ext
  rw [TwoTerm.kerBaseChangeMap_tmul, ZeroMemClass.coe_zero]
  apply (TensorProduct.prodRight Γ(T, ⊤) Γ(T, ⊤) K _ _).injective
  rw [TensorProduct.prodRight_tmul, map_zero]
  exact Prod.ext (key i hi 0) (key i hi 1)

section Chart

attribute [local instance] chartAlgebra

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] [IsAffine T] in
lemma isScalarTower_chart (i : Fin 2) : IsScalarTower Γ(T, ⊤) Γ(T, ⊤)[X] Γ(XT, 𝒰 i) :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ (Polynomial.aeval_C _ _).symm

/-- The fibre hypothesis of `FibreFlat` for `s₀|_{U_i}`. -/
theorem injective_lTensor_chart (L : (XT).Modules) [L.IsInvertible] (hL : FCond π (T ↘ Sk) L)
    (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤)
    (i : Fin 2) (p : Ideal Γ(T, ⊤)) [p.IsPrime] :
    Function.Injective ((FibreFlat.smulS (A := Γ(T, ⊤)) (R := Γ(XT, 𝒰 i))
      (rs L (le_top : 𝒰 i ≤ ⊤) s₀)).lTensor p.ResidueField) := by
  haveI := Scheme.Modules.projective_sections L (isAffineOpen_chart (T₀ := T) π i)
  haveI := isDomain_tensor_chart (T₀ := T) π i p.ResidueField
  exact FibreFlat.injective_lTensor_of_isDomain _ _ (one_tmul_res_ne_zero π L hL s₀ hs _ i)

/-- `s₀|_{U_i}` is a nonzerodivisor. -/
theorem smul_injective_chart (L : (XT).Modules) [L.IsInvertible] (hL : FCond π (T ↘ Sk) L)
    (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤)
    (i : Fin 2) : Function.Injective fun r : Γ(XT, 𝒰 i) ↦ r • rs L (le_top : 𝒰 i ≤ ⊤) s₀ := by
  haveI := isScalarTower_chart (T := T) π i
  haveI := finite_sections_chart (T₀ := T) π i
  haveI := projective_sections_chart (T₀ := T) π i
  haveI := invertible_sections L (isAffineOpen_chart (T₀ := T) π i)
  exact FibreFlat.smul_injective_of_fibres _ (injective_lTensor_chart π L hL s₀ hs i)

/-- `Γ(U_i) / c(s₀|_{U_i})` is flat over `Γ(T)`. -/
theorem flat_quotient_chart (L : (XT).Modules) [L.IsInvertible] (hL : FCond π (T ↘ Sk) L)
    (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤)
    (i : Fin 2) : Module.Flat Γ(T, ⊤)
      (Γ(XT, 𝒰 i) ⧸ contentIdeal (R := Γ(XT, 𝒰 i)) (rs L (le_top : 𝒰 i ≤ ⊤) s₀)) := by
  haveI := isScalarTower_chart (T := T) π i
  haveI := finite_sections_chart (T₀ := T) π i
  haveI := projective_sections_chart (T₀ := T) π i
  haveI := invertible_sections L (isAffineOpen_chart (T₀ := T) π i)
  exact flat_quotient_contentIdeal _
    (FibreFlat.flat_quotient_of_fibres _ (injective_lTensor_chart π L hL s₀ hs i))

end Chart

open Scheme.Modules in
/-- **`s₀` is a nonzerodivisor on every open** of `C ×_k T`: this is local, and on a basic open
inside a chart it follows from `smul_injective_chart` by localization. -/
theorem eq_zero_of_smul_eq_zero (L : (XT).Modules) [L.IsInvertible] (hL : FCond π (T ↘ Sk) L)
    (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤)
    (V : (XT).Opens) (r : Γ(XT, V)) (h : r • rs L (le_top : V ≤ ⊤) s₀ = 0) : r = 0 := by
  refine sheaf_eq_of_locally_eq (XT).sheaf r 0 fun x hx ↦ ?_
  obtain ⟨i, hi⟩ : ∃ i : Fin 2, x ∈ 𝒰 i := by
    have : x ∈ (𝒰 0) ⊔ (𝒰 1) := by rw [chartOf_sup]; trivial
    simp only [Opens.mem_sup] at this
    rcases this with h | h
    exacts [⟨0, h⟩, ⟨1, h⟩]
  have hU := isAffineOpen_chart (T₀ := T) π i
  obtain ⟨f, hfV, hxf⟩ := hU.exists_basicOpen_le ⟨x, hx⟩ hi
  refine ⟨_, hfV, hxf, ?_⟩
  haveI := hU.isLocalization_basicOpen f
  haveI := isQuasicoherent_of_isInvertible L
  haveI := L.isLocalizedModule_resBasicOpen hU f
  have hreg : ∀ r : Γ(XT, 𝒰 i), r • rs L (le_top : 𝒰 i ≤ ⊤) s₀ = 0 → r = 0 := fun r hr ↦
    smul_injective_chart π L hL s₀ hs i (by simp only [hr, zero_smul])
  change (XT).presheaf.map (homOfLE hfV).op r = (XT).presheaf.map (homOfLE hfV).op 0
  rw [map_zero]
  refine smul_eq_zero_of_isLocalizedModule (f := f) (L.resBasicOpen f) hreg _ ?_
  have := congrArg (rs L hfV) h
  have h0 : rs L hfV (0 : Γ(L, V)) = 0 := map_zero _
  rw [rs_smul, h0] at this
  rw [resBasicOpen_apply]
  convert this using 2
  exact (rs_rs L _ _ s₀).trans (rs_rs L _ _ s₀).symm

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] [IsAffine T] in
lemma exists_mem_chart (x : ↥(XT)) : ∃ i : Fin 2, x ∈ 𝒰 i := by
  have : x ∈ (𝒰 0) ⊔ (𝒰 1) := by rw [chartOf_sup]; trivial
  simp only [Opens.mem_sup] at this
  rcases this with h | h
  exacts [⟨0, h⟩, ⟨1, h⟩]

/-- **The zero scheme of a generating section is a relative effective Cartier divisor**
(Stacks, Lemma 44.6.4, Tag 0B9X): if `L` satisfies the `F`-condition and `Ȟ⁰(L)` is generated
by the image of `s₀ ∈ Γ(X_T, L)`, the zero scheme of `s₀` is a relative effective Cartier
divisor on `X_T = C ×_k T` over `T`. -/
def zeroSchemeDivisor (L : (XT).Modules) [L.IsInvertible] (hL : FCond π (T ↘ Sk) L)
    (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤) :
    RelEffCartier (pullback.snd (C ↘ Sk) (T ↘ Sk)) where
  ideal := Scheme.Modules.zeroIdeal L s₀
  locally_principal x := by
    obtain ⟨i, hi⟩ := exists_mem_chart π x
    obtain ⟨V, e, hxV, he⟩ := Scheme.Modules.IsInvertible.exists_basis (L := L) x
    have hU := isAffineOpen_chart (T₀ := T) π i
    obtain ⟨f, hfV, hxf⟩ := hU.exists_basicOpen_le ⟨x, hxV⟩ hi
    let W : (XT).affineOpens := ⟨(XT).basicOpen f, hU.basicOpen f⟩
    have he' : L.IsBasisOn W.1 (rs L hfV e) := isBasisOn_rs he hfV
    obtain ⟨t, ht⟩ := exists_smul_eq_of_isBasisOn he' (rs L (le_top : W.1 ≤ ⊤) s₀)
    refine ⟨W, t, hxf, Scheme.Modules.zeroIdeal_ideal_of_isBasisOn L s₀ he' ht.symm, ?_⟩
    intro a b hab
    have hab' : t * a = t * b := hab
    have h0 : (a - b) • rs L (le_top : W.1 ≤ ⊤) s₀ = 0 := by
      rw [← ht, smul_smul, sub_mul, mul_comm a t, mul_comm b t, hab', sub_self, zero_smul]
    exact sub_eq_zero.mp (eq_zero_of_smul_eq_zero π L hL s₀ hs W.1 (a - b) h0)
  flat := by
    apply Scheme.IdealSheafData.flat_of_flat_quotient
    intro x _
    obtain ⟨i, hi⟩ := exists_mem_chart π x
    refine ⟨⟨⊤, isAffineOpen_top T⟩, ⟨𝒰 i, isAffineOpen_chart (T₀ := T) π i⟩, hi, by simp, ?_⟩
    have key : (Ideal.Quotient.mk ((Scheme.Modules.zeroIdeal L s₀).ideal
        ⟨𝒰 i, isAffineOpen_chart (T₀ := T) π i⟩)).comp
        ((pullback.snd (C ↘ Sk) (T ↘ Sk)).appLE ⊤ (𝒰 i) (by simp)).hom =
        algebraMap Γ(T, ⊤) (Γ(XT, 𝒰 i) ⧸
          contentIdeal (R := Γ(XT, 𝒰 i)) (rs L (le_top : 𝒰 i ≤ ⊤) s₀)) := rfl
    rw [key]
    exact RingHom.flat_algebraMap_iff.mpr (flat_quotient_chart π L hL s₀ hs i)

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] [IsAffine T] in
lemma injective_smul_of_eq_zero {L : (XT).Modules} {s₀ : Γ(L, ⊤)} {V : (XT).Opens}
    (h : ∀ r : Γ(XT, V), r • rs L (le_top : V ≤ ⊤) s₀ = 0 → r = 0) :
    Function.Injective fun r : Γ(XT, V) ↦ r • rs L (le_top : V ≤ ⊤) s₀ := fun r r' hr ↦ by
  rw [← sub_eq_zero]
  exact h _ (by rw [sub_smul]; exact sub_eq_zero.mpr hr)

/-- **The zero scheme of a generating section has degree `g(C)`** over every point of `T`
(Stacks, Lemma 44.6.4, Tag 0B9X). -/
theorem degree_zeroSchemeDivisor (L : (XT).Modules) [L.IsInvertible] (hL : FCond π (T ↘ Sk) L)
    (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤)
    (t : ↥T) :
    haveI := IsCurveOver.isIntegral k C
    ((zeroSchemeDivisor π L hL s₀ hs).degree t : ℤ) = curveGenus k C := by
  refine degree_zeroScheme_eq_curveGenus π (T ↘ Sk) L s₀ _
    (injective_smul_of_eq_zero (eq_zero_of_smul_eq_zero π L hL s₀ hs _)) hL.1 (fun x ↦ ?_)
    (fun _ _ _ ↦ rfl) t
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hs ▸ Submodule.mem_top : x ∈ _)
  exact ⟨a, by rw [← ha]; rfl⟩

/-- The zero scheme of a generating section of `L` has class `[L]`. -/
theorem picClass_zeroSchemeDivisor (L : (XT).Modules) [L.IsInvertible]
    (hL : FCond π (T ↘ Sk) L) (s₀ : Γ(L, ⊤))
    (hs : Submodule.span Γ(T, ⊤) {globalSectionsEquivH0 T L (chartOf_sup π (T ↘ Sk)) s₀} = ⊤) :
    (zeroSchemeDivisor π L hL s₀ hs).picClass = Scheme.Pic.mk L :=
  RelEffCartier.picClass_eq_of_ideal_eq_zeroIdeal _ L s₀
    (fun U ↦ injective_smul_of_eq_zero (eq_zero_of_smul_eq_zero π L hL s₀ hs U.1)) rfl

end Curve

section Main

open Cech Belyi

variable {k : Type u} [Field k] [PerfectField k] {C : Scheme.{u}}
  [C.Over (Spec (CommRingCat.of k))] [IsCurveOver k C] (π : C ⟶ ProjectiveLine.scheme k)
  [IsFinite π] {T : Scheme.{u}} [IsAffine T]

local notation "Sk" => Spec (CommRingCat.of k)

/-- **A line bundle with cyclic `H⁰` in the `F`-locus is the class of a divisor of degree `g`**
(Stacks, Lemma 44.6.4, Tag 0B9X, surjectivity of `h_W → F`): let `L` be an invertible sheaf on
`X_T = C ×_k T` (`T` affine) satisfying the `F`-condition, and let `s` generate its Čech `H⁰`
over `Γ(T)`. Then the zero scheme of the corresponding global section is a relative effective
Cartier divisor `D` on `X_T` over `T` of degree `g(C)` at every point of `T`, with
`𝒪(D) ≅ L`. -/
theorem exists_relEffCartier_of_cyclic (g : T ⟶ Sk) (L : (pullback (C ↘ Sk) g).Modules)
    [L.IsInvertible] (hL : FCond π g L) (s : chartH0 π g L)
    (hs : Submodule.span Γ(T, ⊤) {s} = ⊤) :
    ∃ D : RelEffCartier (pullback.snd (C ↘ Sk) g),
      (∀ t, haveI := IsCurveOver.isIntegral k C; (D.degree t : ℤ) = curveGenus k C) ∧
        D.picClass = Scheme.Pic.mk L := by
  letI : T.Over Sk := ⟨g⟩
  let L' : (pullback (C ↘ Sk) (T ↘ Sk)).Modules := L
  haveI : L'.IsInvertible := ‹L.IsInvertible›
  have hL' : FCond π (T ↘ Sk) L' := hL
  let E := globalSectionsEquivH0 T L' (chartOf_sup π (T ↘ Sk))
  have hs₀ : Submodule.span Γ(T, ⊤) {E (E.symm s)} = ⊤ := by
    rw [LinearEquiv.apply_symm_apply]
    exact hs
  exact ⟨zeroSchemeDivisor π L' hL' (E.symm s) hs₀, degree_zeroSchemeDivisor π L' hL' _ hs₀,
    picClass_zeroSchemeDivisor π L' hL' _ hs₀⟩

end Main

end CurvesJacobian
