import CurvesJacobian.Picard.CartierCriterion
import CurvesJacobian.Picard.CartierChart
import CurvesJacobian.Picard.CartierCurve
import CurvesJacobian.Picard.RelEffCartier

/-!
# Finite flat closed subschemes of relative curves are relative effective Cartier divisors

Let `C` be a curve over a perfect field `k` (`Belyi.IsCurveOver`), `T` a `k`-scheme and
`X_T = C ×_k T → T`. This file proves the direction "(1) ⇒ (2)" of Stacks, Lemma 44.3.1
(Tag 0B9D): a closed subscheme `D ⊆ X_T` which is finite, flat and of finite presentation over `T`
(i.e. finite locally free) is a relative effective Cartier divisor
(`CurvesJacobian.RelEffCartier.ofFiniteFlat`).

The proof is local around a point `x ∈ X_T` over `s ∈ T`:
* the points of `D` over `s` map to finitely many points of `C`, which lie in an affine open `U` of
  `C` carrying a function `u` with `Γ(U)` flat over `k[u]` (`exists_affine_chart_flat`); after
  shrinking `T` to an affine `V ∋ s`, `D_V ⊆ U_V`, so `B/I = Γ(D_V)` is finite over `A = Γ(V)`,
  where `B = Γ(U_V) = A ⊗_k Γ(U)` and `I` is the ideal of `D`;
* the characteristic polynomial of `u` on `B/I` gives a nonzerodivisor in `I`
  (`CartierCriterion.exists_isSMulRegular_mem`, `B` is flat over `A[X]`);
* near the image of `x` in `C` there is an étale coordinate (`exists_kaehler_chart`), so a basic
  open of `B` is formally unramified over `A[X]` (`CartierChart.formallyUnramified_of_tensorEquiv`);
* the local criterion `CartierCriterion.exists_smul_le_span_of_unramified` then shows that `I` is
  generated by a nonzerodivisor on a basic open neighbourhood of `x`.
-/

open CategoryTheory Limits TopologicalSpace AlgebraicGeometry Polynomial TensorProduct

universe u

noncomputable section

namespace CurvesJacobian

variable {k : Type u} [Field k] (C : Scheme.{u}) [C.Over (Spec (CommRingCat.of k))]
  {T : Scheme.{u}} (gT : T ⟶ Spec (CommRingCat.of k))

local notation "Sk" => Spec (CommRingCat.of k)
local notation "XT" => pullback (C ↘ Sk) gT
local notation "pC" => pullback.fst (C ↘ Sk) gT
local notation "fT" => pullback.snd (C ↘ Sk) gT

section Sections

variable {W : C.Opens} (hW : IsAffineOpen W) {V : T.Opens} (hV : IsAffineOpen V)

include hW hV in
lemma isAffineOpen_inf_preimage : IsAffineOpen (pC ⁻¹ᵁ W ⊓ fT ⁻¹ᵁ V) := by
  have H := IsPullback.of_hasPullback (C ↘ Sk) gT
  have : IsAffine (⊤ : (Sk).Opens) := isAffineOpen_top _
  have : IsAffine V := hV
  have : IsAffine W := hW
  exact .of_isIso (Scheme.Hom.isPullback_resLE H (US := ⊤) (UT := V) (UX := W)
    (by simp) (by simp) rfl).isoPullback.hom

include hW hV in
lemma isPushout_inf_preimage :
    IsPushout (gT.appLE ⊤ V (by simp)) ((C ↘ Sk).appLE ⊤ W (by simp))
      ((fT).appLE V (pC ⁻¹ᵁ W ⊓ fT ⁻¹ᵁ V) inf_le_right)
      ((pC).appLE W (pC ⁻¹ᵁ W ⊓ fT ⁻¹ᵁ V) inf_le_left) := by
  have H := IsPullback.of_hasPullback (C ↘ Sk) gT
  exact ((isIso_pushoutSection_iff H (US := ⊤) (UT := V) (UX := W) (by simp) (by simp) rfl).mp
    (isIso_pushoutSection_of_isAffineOpen H _ _ rfl (isAffineOpen_top _) hV hW)).flip

end Sections

section Quotient

variable {X S : Scheme.{u}} (f : X ⟶ S) (D : X.IdealSheafData) (V : S.affineOpens)
  (W : X.affineOpens) (hWV : W.1 ≤ f ⁻¹ᵁ V.1)

/-- `𝒪_X(W)/I(W)` over `𝒪_S(V)` is the ring map `𝒪_S(V) → 𝒪_D(W ∩ D)` up to isomorphism. -/
lemma quotient_comp_eq :
    ((Ideal.Quotient.mk (D.ideal W)).comp (f.appLE V.1 W.1 hWV).hom) =
      ((D.subschemeObjIso W).hom.hom).comp
        ((D.subschemeι ≫ f).appLE V.1 (D.subschemeι ⁻¹ᵁ W.1)
          (D.subschemeι.preimage_mono hWV)).hom := by
  rw [D.appLE_subschemeι_comp f V W hWV]
  ext z
  simp

include hWV in
/-- If `D → S` is locally of finite presentation, `𝒪_X(W)/I(W)` is finitely presented over
`𝒪_S(V)`. -/
lemma finitePresentation_quotient [LocallyOfFinitePresentation (D.subschemeι ≫ f)] :
    ((Ideal.Quotient.mk (D.ideal W)).comp (f.appLE V.1 W.1 hWV).hom).FinitePresentation := by
  rw [quotient_comp_eq]
  refine RingHom.FinitePresentation.comp (RingHom.FinitePresentation.of_bijective
    (ConcreteCategory.bijective_of_isIso _)) ?_
  exact HasRingHomProperty.appLE (P := @LocallyOfFinitePresentation) _ inferInstance V
    ⟨_, W.2.preimage D.subschemeι⟩ _

include hWV in
/-- If `D → S` is finite and `D ∩ f⁻¹V ⊆ W`, then `𝒪_X(W)/I(W)` is finite over `𝒪_S(V)`. -/
lemma finite_quotient [IsFinite (D.subschemeι ≫ f)]
    (hD : ∀ y : D.subscheme, (D.subschemeι ≫ f) y ∈ V.1 → D.subschemeι y ∈ W.1) :
    ((Ideal.Quotient.mk (D.ideal W)).comp (f.appLE V.1 W.1 hWV).hom).Finite := by
  rw [quotient_comp_eq]
  refine RingHom.Finite.comp (RingHom.Finite.of_surjective _
    (ConcreteCategory.bijective_of_isIso _).2) ?_
  have heq : D.subschemeι ⁻¹ᵁ W.1 = (D.subschemeι ≫ f) ⁻¹ᵁ V.1 :=
    le_antisymm (fun y hy ↦ hWV hy) (fun y hy ↦ hD y hy)
  rw [Scheme.Hom.appLE, CommRingCat.hom_comp]
  refine RingHom.Finite.comp (RingHom.Finite.of_surjective _ ?_)
    (IsFinite.finite_app _ V.1 V.2)
  have hiso : ∀ e : D.subschemeι ⁻¹ᵁ W.1 ≤ (D.subschemeι ≫ f) ⁻¹ᵁ V.1,
      Function.Surjective (D.subscheme.presheaf.map (homOfLE e).op).hom := by
    intro e
    rw [show homOfLE e = eqToHom heq from Subsingleton.elim _ _, eqToHom_op]
    exact (ConcreteCategory.bijective_of_isIso _).2
  exact hiso _

end Quotient

section Main

open Cech Belyi

variable [PerfectField k] [IsCurveOver k C]

/-- The local statement of Stacks, Lemma 44.3.1 (Tag 0B9D), "(1) ⇒ (2)", for `X_T = C ×_k T`. -/
theorem exists_principal_of_finite_flat (D : (XT).IdealSheafData)
    [IsFinite (D.subschemeι ≫ fT)] [Flat (D.subschemeι ≫ fT)]
    [LocallyOfFinitePresentation (D.subschemeι ≫ fT)] (x : ↥(pullback (C ↘ Sk) gT)) :
    ∃ (U : (XT).affineOpens) (g : Γ(XT, U.1)), x ∈ U.1 ∧ D.ideal U = Ideal.span {g} ∧
      IsSMulRegular Γ(XT, U.1) g := by
  classical
  haveI := IsCurveOver.isIntegral k C
  set ι := D.subschemeι
  set s := fT x
  -- the fibre of `D` over `s` is finite
  have hfib : ((ι ≫ fT).base ⁻¹' {s}).Finite := (ι ≫ fT).finite_preimage_singleton s
  let S : Finset C := insert (pC x) ((hfib.image fun y ↦ pC (ι y)).toFinset)
  obtain ⟨U, hU, u, hSU, hflat⟩ := exists_affine_chart_flat k C S
  have hxU : pC x ∈ U := hSU _ (Finset.mem_insert_self _ _)
  -- shrink `T` so that `D_V ⊆ U_V`
  set Z : Set D.subscheme := ι.base ⁻¹' (↑(pC ⁻¹ᵁ U))ᶜ
  have hZ : IsClosed Z :=
    ((pC ⁻¹ᵁ U).isOpen.isClosed_compl).preimage ι.continuous
  have hsZ : s ∉ (ι ≫ fT).base '' Z := by
    rintro ⟨y, hyZ, hys⟩
    apply hyZ
    exact hSU _ (Finset.mem_insert_of_mem ((Set.Finite.mem_toFinset _).mpr ⟨y, hys, rfl⟩))
  obtain ⟨V, hV, hsV, hVZ⟩ : ∃ V : T.Opens, IsAffineOpen V ∧ s ∈ V ∧
      (V : Set T) ⊆ ((ι ≫ fT).base '' Z)ᶜ := by
    let O : T.Opens := ⟨_, ((ι ≫ fT).isClosedMap Z hZ).isOpen_compl⟩
    obtain ⟨V, hV, hsV, hVO⟩ := Opens.isBasis_iff_nbhd.mp T.isBasis_affineOpens
      (show s ∈ O from hsZ)
    exact ⟨V, hV, hsV, hVO⟩
  -- the affine open `𝒰 = U_V` of `X_T`
  set 𝒰 := pC ⁻¹ᵁ U ⊓ fT ⁻¹ᵁ V
  have h𝒰 : IsAffineOpen 𝒰 := isAffineOpen_inf_preimage C gT hU hV
  have hx𝒰 : x ∈ 𝒰 := ⟨hxU, hsV⟩
  have hD𝒰 : ∀ y : D.subscheme, (ι ≫ fT) y ∈ V → ι y ∈ 𝒰 := by
    intro y hy
    refine ⟨?_, by simpa using hy⟩
    by_contra hyU
    exact hVZ hy ⟨y, hyU, rfl⟩
  -- an étale coordinate near the image of `x` in `C`
  obtain ⟨W', hW', σ, hxW', hσ, hft⟩ := exists_kaehler_chart (k := k) C (pC x)
  obtain ⟨a, b, hab, hxa⟩ := exists_basicOpen_le_affine_inter hU hW' (pC x) ⟨hxU, hxW'⟩
  set 𝒲' := pC ⁻¹ᵁ W' ⊓ fT ⁻¹ᵁ V
  have h𝒲' : IsAffineOpen 𝒲' := isAffineOpen_inf_preimage C gT hW' hV
  set a' : Γ(XT, 𝒰) := (pC).appLE U 𝒰 inf_le_left a
  set b' : Γ(XT, 𝒲') := (pC).appLE W' 𝒲' inf_le_left b
  have ha' : (XT).basicOpen a' = 𝒰 ⊓ pC ⁻¹ᵁ C.basicOpen a := Scheme.basicOpen_appLE _ _ _ _ _
  have hb' : (XT).basicOpen b' = 𝒲' ⊓ pC ⁻¹ᵁ C.basicOpen b := Scheme.basicOpen_appLE _ _ _ _ _
  have hab' : (XT).basicOpen a' = (XT).basicOpen b' := by
    rw [ha', hb', ← hab]
    ext y
    simp only [𝒰, 𝒲', TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe,
      Scheme.Hom.mem_preimage]
    constructor
    · rintro ⟨⟨-, hy⟩, hya⟩
      exact ⟨⟨(C.basicOpen_le b) (hab ▸ hya), hy⟩, hya⟩
    · rintro ⟨⟨-, hy⟩, hya⟩
      exact ⟨⟨(C.basicOpen_le a) hya, hy⟩, hya⟩
  have hx𝒲 : x ∈ (XT).basicOpen a' := by
    rw [ha']; exact ⟨hx𝒰, hxa⟩
  have h𝒲𝒲' : (XT).basicOpen a' ≤ 𝒲' := hab' ▸ (XT).basicOpen_le b'
  -- the rings `A = Γ(V)`, `B = Γ(𝒰)` and the ideal `I` of `D`
  letI : Algebra Γ(T, V) Γ(XT, 𝒰) := ((fT).appLE V 𝒰 inf_le_right).hom.toAlgebra
  set I := D.ideal ⟨𝒰, h𝒰⟩
  have hquot : algebraMap Γ(T, V) (Γ(XT, 𝒰) ⧸ I) =
      (Ideal.Quotient.mk I).comp ((fT).appLE V 𝒰 inf_le_right).hom := rfl
  haveI : Module.Flat Γ(T, V) (Γ(XT, 𝒰) ⧸ I) := by
    have := D.flat_quotient_of_flat (hf := inferInstance) (fT) ⟨V, hV⟩ ⟨𝒰, h𝒰⟩ inf_le_right
    rw [← hquot, RingHom.flat_algebraMap_iff] at this
    exact this
  haveI : Module.Finite Γ(T, V) (Γ(XT, 𝒰) ⧸ I) := by
    have := finite_quotient (fT) D ⟨V, hV⟩ ⟨𝒰, h𝒰⟩ inf_le_right hD𝒰
    rw [← hquot] at this
    exact RingHom.finite_algebraMap.mp this
  have hIfg : I.FG := by
    have hQ := finitePresentation_quotient (fT) D ⟨V, hV⟩ ⟨𝒰, h𝒰⟩ inf_le_right
    rw [← hquot, RingHom.finitePresentation_algebraMap] at hQ
    haveI : LocallyOfFinitePresentation (fT) := inferInstance
    have hB := HasRingHomProperty.appLE (P := @LocallyOfFinitePresentation) (fT) inferInstance
      ⟨V, hV⟩ ⟨𝒰, h𝒰⟩ inf_le_right
    have hB' : Algebra.FinitePresentation Γ(T, V) Γ(XT, 𝒰) := hB
    have := Algebra.FinitePresentation.ker_fG_of_surjective (Ideal.Quotient.mkₐ Γ(T, V) I)
      Ideal.Quotient.mk_surjective
    have e : RingHom.ker (Ideal.Quotient.mkₐ Γ(T, V) I).toRingHom = I := Ideal.mk_ker
    rwa [e] at this
  -- a nonzerodivisor in `I`: `B = Γ(V) ⊗ Γ(U)` is flat over `Γ(V)[X]` via `u`
  letI : Algebra Γ(Sk, ⊤) Γ(T, V) := (gT.appLE ⊤ V (by simp)).hom.toAlgebra
  obtain ⟨c, hcI, hc⟩ : ∃ c ∈ I, IsSMulRegular Γ(XT, 𝒰) c := by
    let e := pushoutTensorEquiv (isPushout_inf_preimage C gT hU hV)
    have he : ∀ r : Γ(T, V), e (r ⊗ₜ 1) = algebraMap Γ(T, V) Γ(XT, 𝒰) r := by
      intro r
      rw [pushoutTensorEquiv_tmul, map_one, mul_one]
      rfl
    have hflatB := CartierChart.flat_of_tensorEquiv e he u hflat
    letI : Algebra Γ(T, V)[X] Γ(XT, 𝒰) :=
      (aeval (R := Γ(T, V)) (e ((1 : Γ(T, V)) ⊗ₜ u))).toRingHom.toAlgebra
    haveI : IsScalarTower Γ(T, V) Γ(T, V)[X] Γ(XT, 𝒰) := IsScalarTower.of_algebraMap_eq
      fun r ↦ by
        change _ = aeval (e ((1 : Γ(T, V)) ⊗ₜ u)) (algebraMap Γ(T, V) Γ(T, V)[X] r)
        rw [Polynomial.algebraMap_eq, aeval_C]
    exact CartierCriterion.exists_isSMulRegular_mem (A := Γ(T, V)) I
  -- the étale coordinate: `B' = Γ(D(a'))` is formally unramified over `Γ(V)[X]`
  set 𝒲 := (XT).basicOpen a'
  letI : Algebra Γ(T, V) Γ(XT, 𝒲') := ((fT).appLE V 𝒲' inf_le_right).hom.toAlgebra
  letI : Algebra Γ(T, V) Γ(XT, 𝒲) :=
    ((fT).appLE V 𝒲 (((XT).basicOpen_le a').trans inf_le_right)).hom.toAlgebra
  letI : Algebra Γ(XT, 𝒲') Γ(XT, 𝒲) := ((XT).presheaf.map (homOfLE h𝒲𝒲').op).hom.toAlgebra
  haveI : IsLocalization.Away b' Γ(XT, 𝒲) :=
    h𝒲'.isLocalization_of_eq_basicOpen b' (homOfLE h𝒲𝒲') hab'
  haveI : IsLocalization.Away a' Γ(XT, 𝒲) := h𝒰.isLocalization_basicOpen a'
  haveI : IsScalarTower Γ(T, V) Γ(XT, 𝒰) Γ(XT, 𝒲) := IsScalarTower.of_algebraMap_eq fun r ↦ by
    change _ = ((fT).appLE V 𝒰 inf_le_right ≫ (XT).presheaf.map _) r
    rw [Scheme.Hom.appLE_map]
    rfl
  haveI : IsScalarTower Γ(T, V) Γ(XT, 𝒲') Γ(XT, 𝒲) := IsScalarTower.of_algebraMap_eq fun r ↦ by
    change _ = ((fT).appLE V 𝒲' inf_le_right ≫ (XT).presheaf.map _) r
    rw [Scheme.Hom.appLE_map]
    rfl
  let e' := pushoutTensorEquiv (isPushout_inf_preimage C gT hW' hV)
  have he' : ∀ r : Γ(T, V), e' (r ⊗ₜ 1) = algebraMap Γ(T, V) Γ(XT, 𝒲') r := by
    intro r
    rw [pushoutTensorEquiv_tmul, map_one, mul_one]
    rfl
  have hunr := CartierChart.formallyUnramified_of_tensorEquiv e' he' σ hσ
  letI : Algebra Γ(T, V)[X] Γ(XT, 𝒲') :=
    (aeval (R := Γ(T, V)) (e' ((1 : Γ(T, V)) ⊗ₜ σ))).toRingHom.toAlgebra
  letI : Algebra Γ(T, V)[X] Γ(XT, 𝒲) :=
    ((algebraMap Γ(XT, 𝒲') Γ(XT, 𝒲)).comp (algebraMap Γ(T, V)[X] Γ(XT, 𝒲'))).toAlgebra
  haveI : IsScalarTower Γ(T, V)[X] Γ(XT, 𝒲') Γ(XT, 𝒲) := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower Γ(T, V) Γ(T, V)[X] Γ(XT, 𝒲) := IsScalarTower.of_algebraMap_eq fun r ↦ by
    change _ = algebraMap Γ(XT, 𝒲') Γ(XT, 𝒲)
      (aeval (e' ((1 : Γ(T, V)) ⊗ₜ σ)) (algebraMap Γ(T, V) Γ(T, V)[X] r))
    rw [Polynomial.algebraMap_eq, aeval_C, ← IsScalarTower.algebraMap_apply]
  haveI : Algebra.FormallyUnramified Γ(XT, 𝒲') Γ(XT, 𝒲) :=
    Algebra.FormallyUnramified.of_isLocalization (Submonoid.powers b')
  haveI : Algebra.FormallyUnramified Γ(T, V)[X] Γ(XT, 𝒲) :=
    Algebra.FormallyUnramified.comp Γ(T, V)[X] Γ(XT, 𝒲') Γ(XT, 𝒲)
  haveI : Algebra.EssFiniteType Γ(T, V) Γ(XT, 𝒲) := by
    have hB := HasRingHomProperty.appLE (P := @LocallyOfFiniteType) (fT) inferInstance
      ⟨V, hV⟩ ⟨𝒰, h𝒰⟩ inf_le_right
    haveI : Algebra.FiniteType Γ(T, V) Γ(XT, 𝒰) := hB
    haveI : Algebra.EssFiniteType Γ(XT, 𝒰) Γ(XT, 𝒲) :=
      Algebra.EssFiniteType.of_isLocalization Γ(XT, 𝒲) (Submonoid.powers a')
    exact Algebra.EssFiniteType.comp Γ(T, V) Γ(XT, 𝒰) Γ(XT, 𝒲)
  haveI : Algebra.EssFiniteType Γ(T, V)[X] Γ(XT, 𝒲) :=
    Algebra.EssFiniteType.of_comp Γ(T, V) Γ(T, V)[X] Γ(XT, 𝒲)
  -- the prime of `x`
  set q := (h𝒰.primeIdealOf ⟨x, hx𝒰⟩).asIdeal
  have hmem : ∀ r : Γ(XT, 𝒰), x ∈ (XT).basicOpen r ↔ r ∉ q := by
    intro r
    have h1 : h𝒰.fromSpec (h𝒰.primeIdealOf ⟨x, hx𝒰⟩) = x := h𝒰.fromSpec_primeIdealOf ⟨x, hx𝒰⟩
    have h2 := h𝒰.fromSpec_preimage_basicOpen r
    constructor
    · intro hx
      rw [← h1] at hx
      have : h𝒰.primeIdealOf ⟨x, hx𝒰⟩ ∈ h𝒰.fromSpec ⁻¹ᵁ (XT).basicOpen r := hx
      rw [h2] at this
      exact this
    · intro hr
      have : h𝒰.primeIdealOf ⟨x, hx𝒰⟩ ∈ h𝒰.fromSpec ⁻¹ᵁ (XT).basicOpen r := by
        rw [h2]; exact hr
      rw [← h1]
      exact this
  obtain ⟨g, hg, t, htI, hgt⟩ :=
    CartierCriterion.exists_smul_le_span_of_unramified (A := Γ(T, V)) (B' := Γ(XT, 𝒲)) a' I hIfg q
      ((hmem a').mp hx𝒲)
  refine ⟨(XT).affineBasicOpen (U := ⟨𝒰, h𝒰⟩) g,
    (XT).presheaf.map (homOfLE ((XT).basicOpen_le g)).op t, (hmem g).mpr hg, ?_, ?_⟩
  · rw [← D.map_ideal_basicOpen ⟨𝒰, h𝒰⟩ g]
    haveI := h𝒰.isLocalization_basicOpen g
    exact CartierCriterion.map_away_eq_span Γ(XT, (XT).basicOpen g) htI hgt
  · haveI := h𝒰.isLocalization_basicOpen g
    exact CartierCriterion.isSMulRegular_away Γ(XT, (XT).basicOpen g) hcI hc hgt

/-- **Stacks, Lemma 44.3.1 (Tag 0B9D), "(1) ⇒ (2)"**: a closed subscheme of `X_T = C ×_k T`
which is finite, flat and of finite presentation (i.e. finite locally free) over `T` is a relative
effective Cartier divisor. -/
def RelEffCartier.ofFiniteFlat (D : (XT).IdealSheafData)
    [IsFinite (D.subschemeι ≫ fT)] [Flat (D.subschemeι ≫ fT)]
    [LocallyOfFinitePresentation (D.subschemeι ≫ fT)] : RelEffCartier (fT) where
  ideal := D
  locally_principal x := exists_principal_of_finite_flat C gT D x
  flat := inferInstance

@[simp]
lemma RelEffCartier.ofFiniteFlat_ideal (D : (XT).IdealSheafData)
    [IsFinite (D.subschemeι ≫ fT)] [Flat (D.subschemeι ≫ fT)]
    [LocallyOfFinitePresentation (D.subschemeι ≫ fT)] :
    (RelEffCartier.ofFiniteFlat C gT D).ideal = D := rfl

end Main

end CurvesJacobian
