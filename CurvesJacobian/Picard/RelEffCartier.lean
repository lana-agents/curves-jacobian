import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion

/-!
# Relative effective Cartier divisors

A relative effective Cartier divisor on `X/S` (Stacks, Tag 062T) is a closed subscheme
`D ⊂ X`, given by an ideal sheaf which is locally generated by a nonzerodivisor, such that
`D → S` is flat.

* `RelEffCartier f`, `RelEffCartier.idealSheaf` (the invertible sheaf `𝒪_X(-D)`),
  `RelEffCartier.lineBundle` (`𝒪_X(D)`, its dual), its class in `X.Pic` and the canonical
  section `RelEffCartier.canonicalSection`.
* `RelEffCartier.degree`: the rank of the finite flat morphism `D → S`.
* `IdealSheafData.flat_subschemeι_comp_iff`: flatness of `D → S` in terms of the rings
  `𝒪_X(W)/I(W)` over `𝒪_S(V)`.
* `RelEffCartier.add` (Stacks, Tag 0B8U): the sum `D + E`, with ideal `I_D · I_E`.
-/

open CategoryTheory MonoidalCategory Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

universe u

noncomputable section

namespace AlgebraicGeometry

open Scheme CurvesJacobian

variable {X S : Scheme.{u}} (f : X ⟶ S)

namespace Scheme.IdealSheafData

variable (I : X.IdealSheafData)

lemma appLE_subschemeι_comp (V : S.affineOpens) (W : X.affineOpens) (e : W.1 ≤ f ⁻¹ᵁ V.1) :
    (I.subschemeι ≫ f).appLE V.1 (I.subschemeι ⁻¹ᵁ W.1) (I.subschemeι.preimage_mono e) =
      f.appLE V.1 W.1 e ≫ CommRingCat.ofHom (Ideal.Quotient.mk (I.ideal W)) ≫
        (I.subschemeObjIso W).inv := by
  rw [← I.subschemeι_app W, Hom.app_eq_appLE, Hom.appLE_comp_appLE]

lemma ringHomFlat_comp_iso {R T T' : CommRingCat.{u}} (φ : R ⟶ T) (e : T ⟶ T') [IsIso e] :
    (φ ≫ e).hom.Flat ↔ φ.hom.Flat := by
  constructor
  · intro h
    have : φ = (φ ≫ e) ≫ inv e := by simp
    rw [this, CommRingCat.hom_comp]
    exact RingHom.Flat.stableUnderComposition _ _ h
      (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso (inv e)))
  · intro h
    rw [CommRingCat.hom_comp]
    exact RingHom.Flat.stableUnderComposition _ _ h
      (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso e))

/-- If `D → S` is flat, then `𝒪_X(W)/I(W)` is flat over `𝒪_S(V)`. -/
lemma flat_quotient_of_flat [hf : Flat (I.subschemeι ≫ f)] (V : S.affineOpens) (W : X.affineOpens)
    (e : W.1 ≤ f ⁻¹ᵁ V.1) :
    ((Ideal.Quotient.mk (I.ideal W)).comp (f.appLE V.1 W.1 e).hom).Flat := by
  have := HasRingHomProperty.appLE (P := @Flat) (I.subschemeι ≫ f) ‹_› V
    ⟨_, W.2.preimage I.subschemeι⟩ (I.subschemeι.preimage_mono e)
  rw [I.appLE_subschemeι_comp f V W e, ← Category.assoc, ringHomFlat_comp_iso] at this
  exact this

/-- Flatness of `D → S` can be checked on the rings `𝒪_X(W)/I(W)` for affine opens `W` covering
the support of `D`. -/
lemma flat_of_flat_quotient
    (H : ∀ x ∈ I.support, ∃ (V : S.affineOpens) (W : X.affineOpens) (_ : x ∈ W.1)
      (e : W.1 ≤ f ⁻¹ᵁ V.1), ((Ideal.Quotient.mk (I.ideal W)).comp (f.appLE V.1 W.1 e).hom).Flat) :
    Flat (I.subschemeι ≫ f) := by
  rw [HasRingHomProperty.iff_exists_appLE (P := @Flat)
    (RingHom.Flat.stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.Flat.holdsForLocalizationAway).left]
  intro z
  have hz : I.subschemeι z ∈ I.support := by
    change I.subschemeι z ∈ (I.support : Set X)
    rw [← I.range_subschemeι]
    exact ⟨z, rfl⟩
  obtain ⟨V, W, hxW, e, hflat⟩ := H _ hz
  refine ⟨V, ⟨_, W.2.preimage I.subschemeι⟩, hxW, I.subschemeι.preimage_mono e, ?_⟩
  rw [I.appLE_subschemeι_comp f V W e, ← Category.assoc, ringHomFlat_comp_iso]
  exact hflat

end Scheme.IdealSheafData

/-- A relative effective Cartier divisor on `X/S` (Stacks, Tag 062T): a closed subscheme of `X`
whose ideal sheaf is locally generated by a nonzerodivisor and which is flat over `S`. -/
structure RelEffCartier where
  /-- the ideal sheaf of the divisor -/
  ideal : X.IdealSheafData
  locally_principal : ∀ x : X, ∃ (U : X.affineOpens) (g : Γ(X, U.1)), x ∈ U.1 ∧
    ideal.ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X, U.1) g
  flat : Flat (ideal.subschemeι ≫ f)

namespace RelEffCartier

variable {f} (D : RelEffCartier f)

/-- The underlying closed subscheme. -/
abbrev toScheme : Scheme.{u} := D.ideal.subscheme

/-- The ideal sheaf `𝒪_X(-D)`. -/
def idealSheaf : X.Modules := D.ideal.idealSheaf

instance : D.idealSheaf.IsInvertible :=
  IdealSheafData.isInvertible_idealSheaf D.locally_principal

/-- The line bundle `𝒪_X(D)`, the dual of the ideal sheaf. -/
def lineBundle : X.Modules := Modules.dual D.idealSheaf

instance : D.lineBundle.IsInvertible := inferInstanceAs (Modules.dual D.idealSheaf).IsInvertible

/-- The class of `𝒪_X(D)` in the Picard group. -/
def picClass : X.Pic := Pic.mk D.lineBundle

lemma picClass_eq_neg : D.picClass = -Pic.mk D.idealSheaf :=
  Pic.mk_dual _


section Add

/-- On a basic open `D(a)` of an affine open `U` where `I` is generated by a nonzerodivisor `g`,
`I` is generated by the nonzerodivisor `g|_{D(a)}`. -/
lemma _root_.AlgebraicGeometry.Scheme.IdealSheafData.principal_basicOpen
    {I : X.IdealSheafData} {U : X.affineOpens} {g : Γ(X, U.1)}
    (hI : I.ideal U = Ideal.span {g}) (hg : IsSMulRegular Γ(X, U.1) g)
    (W : X.affineOpens) (a : Γ(X, U.1)) (hW : W.1 = X.basicOpen a) (hWU : W.1 ≤ U.1) :
    I.ideal W = Ideal.span {X.presheaf.map (homOfLE hWU).op g} ∧
      IsSMulRegular Γ(X, W.1) (X.presheaf.map (homOfLE hWU).op g) := by
  refine ⟨?_, ?_⟩
  · rw [← I.map_ideal (U := W) (V := U) hWU, hI, Ideal.map_span, Set.image_singleton]
    rfl
  · obtain ⟨W, hWa⟩ := W
    simp only at hW
    subst hW
    haveI := U.2.isLocalization_basicOpen a
    exact isSMulRegular_algebraMap_of_isLocalization (S := Γ(X, X.basicOpen a))
      (Submonoid.powers a) hg

/-- Two locally principal ideal sheaves are simultaneously principal, with nonzerodivisor
generators, on arbitrarily small affine neighbourhoods. -/
lemma exists_affine_principal_principal {I J : X.IdealSheafData}
    (hI : ∀ x : X, ∃ (U : X.affineOpens) (g : Γ(X, U.1)), x ∈ U.1 ∧
      I.ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X, U.1) g)
    (hJ : ∀ x : X, ∃ (U : X.affineOpens) (g : Γ(X, U.1)), x ∈ U.1 ∧
      J.ideal U = Ideal.span {g} ∧ IsSMulRegular Γ(X, U.1) g)
    (x : X) (O : X.Opens) (hxO : x ∈ O) :
    ∃ (W : X.affineOpens) (g h : Γ(X, W.1)), x ∈ W.1 ∧ W.1 ≤ O ∧
      I.ideal W = Ideal.span {g} ∧ IsSMulRegular Γ(X, W.1) g ∧
      J.ideal W = Ideal.span {h} ∧ IsSMulRegular Γ(X, W.1) h := by
  obtain ⟨U₁, g₁, hx₁, hI₁, hg₁⟩ := hI x
  obtain ⟨U₂, g₂, hx₂, hJ₂, hg₂⟩ := hJ x
  obtain ⟨a₁, ha₁, hxa₁⟩ := U₁.2.exists_basicOpen_le (V := U₂.1 ⊓ O) ⟨x, hx₂, hxO⟩ hx₁
  let W₁ : X.affineOpens := X.affineBasicOpen a₁
  have hW₁U₁ : W₁.1 ≤ U₁.1 := X.basicOpen_le a₁
  obtain ⟨hIW₁, hgW₁⟩ := Scheme.IdealSheafData.principal_basicOpen hI₁ hg₁ W₁ a₁ rfl hW₁U₁
  obtain ⟨a, b, hab, hxa⟩ := exists_basicOpen_le_affine_inter W₁.2 U₂.2 x ⟨hxa₁, hx₂⟩
  let W : X.affineOpens := X.affineBasicOpen b
  have hWU₂ : W.1 ≤ U₂.1 := X.basicOpen_le b
  have hWW₁ : W.1 ≤ W₁.1 := by
    change X.basicOpen b ≤ W₁.1
    rw [← hab]
    exact X.basicOpen_le a
  obtain ⟨hIW, hgW⟩ :=
    Scheme.IdealSheafData.principal_basicOpen hIW₁ hgW₁ W a hab.symm hWW₁
  obtain ⟨hJW, hhW⟩ := Scheme.IdealSheafData.principal_basicOpen hJ₂ hg₂ W b rfl hWU₂
  refine ⟨W, _, _, ?_, ?_, hIW, hgW, hJW, hhW⟩
  · change x ∈ X.basicOpen b
    rw [← hab]
    exact hxa
  · exact (hWW₁.trans (show W₁.1 ≤ U₂.1 ⊓ O from ha₁)).trans inf_le_right

variable (D E : RelEffCartier f)

/-- The sum of two relative effective Cartier divisors (Stacks, Tag 0B8U): the ideal sheaf is
the product of the ideal sheaves. -/
def add : RelEffCartier f where
  ideal := D.ideal * E.ideal
  locally_principal x := by
    obtain ⟨W, g, h, hxW, -, hgI, hg, hhJ, hh⟩ := exists_affine_principal_principal
      D.locally_principal E.locally_principal x ⊤ trivial
    refine ⟨W, g * h, hxW, ?_, hg.mul hh⟩
    rw [IdealSheafData.ideal_mul, Pi.mul_apply, hgI, hhJ, Ideal.span_singleton_mul_span_singleton]
  flat := by
    apply IdealSheafData.flat_of_flat_quotient
    intro x _
    obtain ⟨V, hV, hxV, -⟩ := Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens
      (Opens.mem_top (f.base x))
    obtain ⟨W, g, h, hxW, hWV, hgI, hg, hhJ, hh⟩ := exists_affine_principal_principal
      D.locally_principal E.locally_principal x (f ⁻¹ᵁ V) hxV
    refine ⟨⟨V, hV⟩, W, hxW, hWV, ?_⟩
    have hD := D.ideal.flat_quotient_of_flat (hf := D.flat) f ⟨V, hV⟩ W hWV
    have hE := E.ideal.flat_quotient_of_flat (hf := E.flat) f ⟨V, hV⟩ W hWV
    rw [hgI] at hD
    rw [hhJ] at hE
    rw [IdealSheafData.ideal_mul, Pi.mul_apply, hgI, hhJ, Ideal.span_singleton_mul_span_singleton]
    letI := (f.appLE V W.1 hWV).hom.toAlgebra
    have key : ∀ I : Ideal Γ(X, W.1), (Ideal.Quotient.mk I).comp (f.appLE V W.1 hWV).hom =
        algebraMap Γ(S, V) (Γ(X, W.1) ⧸ I) := fun _ ↦ rfl
    rw [key, RingHom.flat_algebraMap_iff] at hD hE ⊢
    exact flat_quotient_mul hg h

end Add

section CanonicalSection

/-- The inclusion of the ideal sheaf into the structure sheaf. -/
def idealSheafToStructureSheaf : D.idealSheaf ⟶ Modules.structureSheaf X :=
  (Modules.sheafify X).map D.ideal.idealSub.ι ≫ (Modules.structureSheafIsoUnit X).inv

/-- The canonical section `s_D ∈ Γ(𝒪_X(D), X)`: the image of the inclusion `𝒪_X(-D) ⟶ 𝒪_X`
in `Hom(𝒪_X(-D), 𝒪_X) = Γ(𝒪_X(D))`. -/
def canonicalSection : Γ(D.lineBundle, ⊤) :=
  (Modules.toSheafify (Scheme.PresheafOfModules.dualPre (Modules.toPre D.idealSheaf))).app (op ⊤)
    { toFun := fun V _ a ↦ D.idealSheafToStructureSheaf.app V a
      map_add' := fun _ _ a b ↦ map_add _ a b
      map_smul' := fun _ _ r a ↦ Modules.Hom.app_smul D.idealSheafToStructureSheaf r a
      natural' := fun _ _ _ hW a ↦
        Scheme.PresheafOfModules.app_res
          ((Modules.toPresheafOfModules X).map D.idealSheafToStructureSheaf) hW a }

end CanonicalSection

section Degree

/-- The degree of a relative effective Cartier divisor `D ⊂ X` over `S`, i.e. the rank of the
finite flat morphism `D → S` (meaningful when `D → S` is finite). -/
def degree (s : S) : ℕ := (D.ideal.subschemeι ≫ f).finrank s

lemma isLocallyConstant_degree [IsFinite (D.ideal.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (D.ideal.subschemeι ≫ f)] : IsLocallyConstant D.degree :=
  haveI := D.flat
  Scheme.Hom.isLocallyConstant_finrank _

end Degree
end RelEffCartier

end AlgebraicGeometry

end
