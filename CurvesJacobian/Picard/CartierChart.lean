import Mathlib.RingTheory.Unramified.Basic
import Mathlib.RingTheory.Kaehler.Basic
import Mathlib.RingTheory.PolynomialAlgebra
import Mathlib.RingTheory.IsTensorProduct
import Mathlib.RingTheory.Flat.Stability

/-!
# Coordinates on base changes `A ⊗_K R`

Let `R` be a `K`-algebra with an element `u`, and `A` a `K`-algebra. Let `A[X]` act on
`A ⊗_K R` through `X ↦ 1 ⊗ u`.

* `CurvesJacobian.CartierChart.flat_tensor`: if `R` is flat over `K[X]` (via `u`), then
  `A ⊗_K R` is flat over `A[X]` (it is the base change `A[X] ⊗_{K[X]} R`).
* `CurvesJacobian.CartierChart.formallyUnramified_tensor`: if `Ω_{R/K}` is generated by `du`,
  then `A ⊗_K R` is formally unramified over `A[X]` (an "étale coordinate" survives base change).
-/

open Polynomial TensorProduct

namespace CurvesJacobian.CartierChart

variable {K A R : Type*} [CommRing K] [CommRing A] [CommRing R] [Algebra K A] [Algebra K R]

/-- `A[X]` acting on `A ⊗_K R` through `X ↦ 1 ⊗ u`. -/
noncomputable abbrev tensorAlgebra (u : R) : Algebra A[X] (A ⊗[K] R) :=
  (aeval (R := A) ((1 : A) ⊗ₜ[K] u)).toRingHom.toAlgebra

lemma tensorAlgebra_isScalarTower (u : R) :
    letI := tensorAlgebra (K := K) (A := A) u
    IsScalarTower A A[X] (A ⊗[K] R) := by
  letI := tensorAlgebra (K := K) (A := A) u
  exact IsScalarTower.of_algebraMap_eq fun a ↦ by
    change _ = aeval ((1 : A) ⊗ₜ[K] u) (algebraMap A A[X] a)
    rw [Polynomial.algebraMap_eq, aeval_C]

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- If `Ω_{R/K}` is generated by `du`, then `A ⊗_K R` is formally unramified over `A[X]`
(`X ↦ 1 ⊗ u`). -/
theorem formallyUnramified_tensor (u : R)
    (hu : Submodule.span R {KaehlerDifferential.D K R u} = ⊤) :
    letI := tensorAlgebra (K := K) (A := A) u
    Algebra.FormallyUnramified A[X] (A ⊗[K] R) := by
  letI := tensorAlgebra (K := K) (A := A) u
  haveI := tensorAlgebra_isScalarTower (K := K) (A := A) u
  haveI : IsScalarTower K A[X] (A ⊗[K] R) := IsScalarTower.of_algebraMap_eq fun c ↦ by
    change _ = aeval ((1 : A) ⊗ₜ[K] u) (algebraMap K A[X] c)
    rw [Polynomial.algebraMap_apply, aeval_C, ← IsScalarTower.algebraMap_apply]
  have hD0 : ∀ r : R, KaehlerDifferential.D A[X] (A ⊗[K] R) ((1 : A) ⊗ₜ r) = 0 := by
    intro r
    have hr : KaehlerDifferential.D K R r ∈ Submodule.span R {KaehlerDifferential.D K R u} :=
      hu ▸ Submodule.mem_top
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hr
    have := congrArg (KaehlerDifferential.map K A[X] R (A ⊗[K] R)) hc
    rw [LinearMap.map_smul, KaehlerDifferential.map_D, KaehlerDifferential.map_D] at this
    rw [← Algebra.TensorProduct.right_algebraMap_apply, ← this]
    have hu' : (algebraMap R (A ⊗[K] R) u) = algebraMap A[X] (A ⊗[K] R) X := by
      change (1 : A) ⊗ₜ u = aeval ((1 : A) ⊗ₜ[K] u) X
      rw [aeval_X]
    rw [hu', Derivation.map_algebraMap, smul_zero]
  constructor
  refine subsingleton_of_forall_eq 0 fun ω ↦ ?_
  have hω : ω ∈ Submodule.span (A ⊗[K] R)
      (Set.range (KaehlerDifferential.D A[X] (A ⊗[K] R))) := by
    rw [KaehlerDifferential.span_range_derivation]; trivial
  induction hω using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨y, rfl⟩ := hx
    induction y with
    | zero => simp
    | add x y hx hy => rw [map_add, hx, hy, add_zero]
    | tmul a r =>
      have e : a ⊗ₜ[K] r = algebraMap A[X] (A ⊗[K] R) (C a) * ((1 : A) ⊗ₜ r) := by
        change _ = aeval ((1 : A) ⊗ₜ[K] u) (C a) * _
        rw [aeval_C, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
          RingHom.id_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e, Derivation.leibniz, Derivation.map_algebraMap, hD0, smul_zero, smul_zero,
        add_zero]
  | zero => rfl
  | add x y _ _ hx hy => rw [hx, hy, add_zero]
  | smul a x _ hx => rw [hx, smul_zero]

attribute [local instance] Algebra.TensorProduct.rightAlgebra Polynomial.algebra in
/-- If `R` is flat over `K[X]` (via `u`), then `A ⊗_K R` is flat over `A[X]`
(via `X ↦ 1 ⊗ u`). -/
theorem flat_tensor (u : R)
    (hflat : letI := (aeval (R := K) u).toRingHom.toAlgebra; Module.Flat K[X] R) :
    letI := tensorAlgebra (K := K) (A := A) u
    Module.Flat A[X] (A ⊗[K] R) := by
  letI : Algebra K[X] R := (aeval (R := K) u).toRingHom.toAlgebra
  letI := tensorAlgebra (K := K) (A := A) u
  letI : Algebra K[X] (A ⊗[K] R) := (aeval (R := K) ((1 : A) ⊗ₜ[K] u)).toRingHom.toAlgebra
  haveI := tensorAlgebra_isScalarTower (K := K) (A := A) u
  haveI : IsScalarTower K K[X] R := IsScalarTower.of_algebraMap_eq fun a ↦ by
    change _ = aeval u (algebraMap K K[X] a)
    rw [Polynomial.algebraMap_eq, aeval_C]
  haveI : IsScalarTower K R (A ⊗[K] R) := inferInstance
  haveI : IsScalarTower K[X] R (A ⊗[K] R) := IsScalarTower.of_algebraMap_eq fun p ↦ by
    change aeval ((1 : A) ⊗ₜ[K] u) p = (1 : A) ⊗ₜ aeval u p
    exact aeval_algHom_apply (Algebra.TensorProduct.includeRight (R := K) (A := A)) u p
  haveI : IsScalarTower K[X] A[X] (A ⊗[K] R) := IsScalarTower.of_algebraMap_eq fun p ↦ by
    change aeval ((1 : A) ⊗ₜ[K] u) p = aeval ((1 : A) ⊗ₜ[K] u) (mapRingHom (algebraMap K A) p)
    rw [coe_mapRingHom, aeval_map_algebraMap]
  haveI : IsScalarTower K A[X] (A ⊗[K] R) := IsScalarTower.of_algebraMap_eq fun c ↦ by
    change _ = aeval ((1 : A) ⊗ₜ[K] u) (algebraMap K A[X] c)
    rw [Polynomial.algebraMap_apply, aeval_C, ← IsScalarTower.algebraMap_apply]
  haveI : Algebra.IsPushout K[X] R A[X] (A ⊗[K] R) :=
    (Algebra.IsPushout.comp_iff K K[X] A (T := R) (S' := A[X]) (T' := A ⊗[K] R)).mp
      inferInstance
  exact Module.Flat.isBaseChange (R := K[X]) (M := R) (S := A[X]) (A ⊗[K] R)
    (Algebra.IsPushout.symm this).out

section Transport

variable {B : Type*} [CommRing B] [Algebra A B] (e : A ⊗[K] R ≃+* B)

/-- An `A`-linear ring isomorphism `A ⊗_K R ≃ B` is an `A[X]`-algebra isomorphism for the actions
through `X ↦ 1 ⊗ u` and `X ↦ e (1 ⊗ u)`. -/
noncomputable def tensorAlgEquiv (he : ∀ a : A, e (a ⊗ₜ 1) = algebraMap A B a) (u : R) :
    letI := tensorAlgebra (K := K) (A := A) u
    letI : Algebra A[X] B := (aeval (R := A) (e ((1 : A) ⊗ₜ[K] u))).toRingHom.toAlgebra
    (A ⊗[K] R) ≃ₐ[A[X]] B :=
  letI := tensorAlgebra (K := K) (A := A) u
  letI : Algebra A[X] B := (aeval (R := A) (e ((1 : A) ⊗ₜ[K] u))).toRingHom.toAlgebra
  AlgEquiv.ofRingEquiv (f := e) fun p ↦ by
    change e (aeval ((1 : A) ⊗ₜ[K] u) p) = aeval (e ((1 : A) ⊗ₜ[K] u)) p
    rw [aeval_def, aeval_def]
    refine (Polynomial.hom_eval₂ p (algebraMap A (A ⊗[K] R)) e.toRingHom
      ((1 : A) ⊗ₜ[K] u)).trans ?_
    congr 1
    ext a
    change e (a ⊗ₜ 1) = algebraMap A B a
    exact he a

theorem flat_of_tensorEquiv (he : ∀ a : A, e (a ⊗ₜ 1) = algebraMap A B a) (u : R)
    (hflat : letI := (aeval (R := K) u).toRingHom.toAlgebra; Module.Flat K[X] R) :
    letI : Algebra A[X] B := (aeval (R := A) (e ((1 : A) ⊗ₜ[K] u))).toRingHom.toAlgebra
    Module.Flat A[X] B := by
  letI := tensorAlgebra (K := K) (A := A) u
  letI : Algebra A[X] B := (aeval (R := A) (e ((1 : A) ⊗ₜ[K] u))).toRingHom.toAlgebra
  haveI := flat_tensor (A := A) u hflat
  exact Module.Flat.of_linearEquiv (tensorAlgEquiv e he u).symm.toLinearEquiv

theorem formallyUnramified_of_tensorEquiv (he : ∀ a : A, e (a ⊗ₜ 1) = algebraMap A B a)
    (u : R)
    (hu : Submodule.span R {KaehlerDifferential.D K R u} = ⊤) :
    letI : Algebra A[X] B := (aeval (R := A) (e ((1 : A) ⊗ₜ[K] u))).toRingHom.toAlgebra
    Algebra.FormallyUnramified A[X] B := by
  letI := tensorAlgebra (K := K) (A := A) u
  letI : Algebra A[X] B := (aeval (R := A) (e ((1 : A) ⊗ₜ[K] u))).toRingHom.toAlgebra
  haveI := formallyUnramified_tensor (A := A) u hu
  exact Algebra.FormallyUnramified.of_equiv (tensorAlgEquiv e he u)

end Transport

end CurvesJacobian.CartierChart
