/-!
# A local criterion for closed subschemes to be relative effective Cartier divisors

This is the commutative algebra behind Stacks, Lemma 44.3.1 (Tag 0B9D) for the direction
"finite locally free over the base ⇒ relative effective Cartier divisor", in the following form.
Let `A → B` be a ring map, `q ⊂ B` a prime over `𝔭 ⊂ A`, and `I ⊆ q` a finitely generated ideal
with `B/I` flat over `A`.  Write `R := B_q / 𝔭 B_q` for the local ring of the fibre at `q`.

* `CurvesJacobian.CartierCriterion.exists_smul_le_span`: if the maximal ideal of `R` is
  principal and `q` is minimal among the primes containing `I + 𝔭B` (e.g. `B/I` is integral
  over `A`), then there are `g ∉ q` and `t ∈ I` with `g • I ⊆ (t)`; so `I` is principal on the
  basic open `D(g)` (`map_away_eq_span`).  The proof: in `R` the image of `I` contains a power
  of the maximal ideal, hence is a power of it (`eq_span_pow_of_pow_mem`), generated by the image
  of some `t ∈ I` (`exists_mem_eq_span_map`); flatness of `B/I` gives `I ∩ 𝔭B = 𝔭I`
  (`inf_map_le_mul_of_flat`), and Nakayama's lemma in `B_q` gives `I B_q = t B_q`.
* `isPrincipal_maximalIdeal_fibre`: the maximal ideal of `R` is principal when `B` is
  formally unramified and essentially of finite type over `A[X]` (the fibre is then unramified
  over the principal ideal domain `κ(𝔭)[X]`, so `𝔪_R` is generated by the image of a prime of
  `κ(𝔭)[X]`; Mathlib's `Algebra.FormallyUnramified.map_maximalIdeal`, Stacks 00UW).
* `isSMulRegular_away`: if moreover `I` contains a nonzerodivisor of `B`, then `t` is a
  nonzerodivisor of `B_g`.
-/

open IsLocalRing Polynomial
open scoped TensorProduct

namespace CurvesJacobian.CartierCriterion

section LocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- In a local ring whose maximal ideal is generated by `π`, an ideal containing a power of `π`
is generated by a power of `π`. -/
theorem eq_span_pow_of_pow_mem {π : R} (hπ : maximalIdeal R = Ideal.span {π}) {J : Ideal R}
    {n : ℕ} (hn : π ^ n ∈ J) : ∃ j : ℕ, J = Ideal.span {π ^ j} := by
  classical
  have hex : ∃ j, π ^ j ∈ J := ⟨n, hn⟩
  refine ⟨Nat.find hex,
    le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).mpr (Nat.find_spec hex))⟩
  intro a ha
  have key : ∀ i ≤ Nat.find hex, a ∈ Ideal.span {π ^ i} := by
    intro i
    induction i with
    | zero => intro _; simp
    | succ i ih =>
      intro hi
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (ih (Nat.le_of_succ_le hi))
      by_cases hbm : b ∈ maximalIdeal R
      · rw [hπ] at hbm
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hbm
        exact Ideal.mem_span_singleton'.mpr ⟨c, by rw [← hb]; ring⟩
      · exfalso
        have hu : IsUnit b := by
          by_contra h
          exact hbm ((IsLocalRing.mem_maximalIdeal _).mpr h)
        have : π ^ i ∈ J := by
          rw [← hb] at ha
          have := J.mul_mem_left (↑hu.unit⁻¹) ha
          rwa [← mul_assoc, IsUnit.val_inv_mul, one_mul] at this
        exact Nat.find_min hex (Nat.lt_of_succ_le hi) this
  exact key _ le_rfl

/-- In a local ring, if the image of an ideal `I` under `φ` is principal, it is generated by the
image of an element of `I`. -/
theorem exists_mem_eq_span_map {B : Type*} [CommRing B] (φ : B →+* R) (I : Ideal B) {x : R}
    (hx : I.map φ = Ideal.span {x}) : ∃ t ∈ I, I.map φ = Ideal.span {φ t} := by
  classical
  have hxmem : x ∈ I.map φ := hx ▸ Ideal.mem_span_singleton_self x
  rw [Ideal.map, Submodule.mem_span_set'] at hxmem
  obtain ⟨n, c, g, hsum⟩ := hxmem
  have hg : ∀ i, ∃ t ∈ I, φ t = (g i : R) := fun i ↦ (g i).2
  choose t ht hφt using hg
  have hd : ∀ i, ∃ d, (g i : R) = d * x := fun i ↦ by
    have : (g i : R) ∈ Ideal.span {x} := hx ▸ Ideal.subset_span (g i).2
    exact Ideal.mem_span_singleton'.mp this |>.imp fun _ h ↦ h.symm
  choose d hd using hd
  by_cases hall : ∀ i, c i * d i ∈ maximalIdeal R
  · -- then `x = 0`
    refine ⟨0, I.zero_mem, ?_⟩
    have hs : (∑ i, c i * d i) ∈ maximalIdeal R := Ideal.sum_mem _ fun i _ ↦ hall i
    have hu : IsUnit (1 - ∑ i, c i * d i) := by
      by_contra h
      have h1 : (1 - ∑ i, c i * d i) ∈ maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr h
      exact (maximalIdeal.isMaximal R).ne_top
        ((Ideal.eq_top_iff_one _).mpr (by simpa using Ideal.add_mem _ h1 hs))
    have hx0 : (1 - ∑ i, c i * d i) * x = 0 := by
      have : x = (∑ i, c i * d i) * x := by
        conv_lhs => rw [← hsum]
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ ↦ ?_
        rw [smul_eq_mul, hd i, mul_assoc]
      rw [sub_mul, one_mul, ← this, sub_self]
    have : x = 0 := (hu.mul_right_eq_zero).mp hx0
    rw [hx, this, map_zero]
  · push Not at hall
    obtain ⟨i, hi⟩ := hall
    have hdi : IsUnit (d i) := by
      by_contra h
      exact hi (Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).mpr h))
    refine ⟨t i, ht i, ?_⟩
    rw [hx, hφt i, hd i]
    exact (Ideal.span_singleton_mul_left_unit hdi x).symm

end LocalRing

section Flat

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- If `B/I` is `A`-flat, then `I ∩ 𝔭B = 𝔭I` for every ideal `𝔭` of `A`. -/
theorem inf_map_le_mul_of_flat (I : Ideal B) (𝔭 : Ideal A) [Module.Flat A (B ⧸ I)] :
    I ⊓ 𝔭.map (algebraMap A B) ≤ 𝔭.map (algebraMap A B) * I := by
  intro x ⟨hxI, hx𝔭⟩
  let f : I →ₗ[A] B := (I.restrictScalars A).subtype
  let g : B →ₗ[A] B ⧸ I := (Ideal.Quotient.mkₐ A I).toLinearMap
  have hinj := LinearMap.lTensor_injective_of_exact_of_flat g
    (Ideal.Quotient.mkₐ_surjective A I) f Subtype.val_injective (by
      intro y
      simp only [g, f, AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem, Set.mem_range]
      exact ⟨fun h ↦ ⟨⟨y, h⟩, rfl⟩, fun ⟨z, hz⟩ ↦ hz ▸ z.2⟩) (A ⧸ 𝔭)
  have h1 : f.lTensor (A ⧸ 𝔭) (1 ⊗ₜ ⟨x, hxI⟩) = 0 := by
    rw [LinearMap.lTensor_tmul]
    apply (TensorProduct.quotTensorEquivQuotSMul B 𝔭).injective
    rw [TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul, map_zero,
      Submodule.Quotient.mk_eq_zero, Ideal.smul_top_eq_map]
    exact hx𝔭
  have h2 : ((1 : A ⧸ 𝔭) ⊗ₜ[A] (⟨x, hxI⟩ : I)) = 0 := hinj (h1.trans (map_zero _).symm)
  have h3 := congrArg (TensorProduct.quotTensorEquivQuotSMul I 𝔭) h2
  rw [TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul, map_zero,
    Submodule.Quotient.mk_eq_zero] at h3
  -- `x ∈ 𝔭 • I` as `A`-submodules of `B`
  have h4 : x ∈ 𝔭 • I.restrictScalars A :=
    (Submodule.mem_smul_top_iff 𝔭 (I.restrictScalars A) ⟨x, hxI⟩).mp h3
  refine Submodule.smul_induction_on h4 (fun a ha y hy ↦ ?_) (fun _ _ h h' ↦ Ideal.add_mem _ h h')
  rw [Algebra.smul_def]
  exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ ha) hy

end Flat

section Fibre

variable (A : Type*) {B : Type*} [CommRing A] [CommRing B] [Algebra A B]
  (q : Ideal B) [q.IsPrime] (L : Type*) [CommRing L] [Algebra B L] [IsLocalization.AtPrime L q]
  [IsLocalRing L] [Algebra A L] [IsScalarTower A B L]

/-- The local ring `B_q / 𝔭 B_q` of the fibre of `Spec B → Spec A` at `q`, `𝔭 = q ∩ A`, for a
localization `L` of `B` at `q`. -/
abbrev FibreLocal : Type _ := L ⧸ (q.comap (algebraMap A B)).map (algebraMap A L)

lemma map_le_maximalIdeal :
    (q.comap (algebraMap A B)).map (algebraMap A L) ≤ maximalIdeal L := by
  rw [IsScalarTower.algebraMap_eq A B L, ← Ideal.map_map,
    ← IsLocalization.AtPrime.map_eq_maximalIdeal q L]
  exact Ideal.map_mono Ideal.map_comap_le

instance : IsLocalRing (FibreLocal A q L) := by
  have : Nontrivial (FibreLocal A q L) := Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (maximalIdeal.isMaximal _).ne_top (map_le_maximalIdeal A q L))
  exact .of_surjective' _ Ideal.Quotient.mk_surjective

/-- The map `B → B_q/𝔭B_q`. -/
abbrev toFibre : B →+* FibreLocal A q L :=
  (Ideal.Quotient.mk _).comp (algebraMap B L)

lemma maximalIdeal_fibreLocal : maximalIdeal (FibreLocal A q L) = q.map (toFibre A q L) := by
  rw [← Ideal.map_map, IsLocalization.AtPrime.map_eq_maximalIdeal q L]
  apply le_antisymm
  · intro z hz
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine Ideal.mem_map_of_mem _ ((IsLocalRing.mem_maximalIdeal _).mpr fun hy ↦ ?_)
    exact (IsLocalRing.mem_maximalIdeal _).mp hz (hy.map _)
  · rw [Ideal.map_le_iff_le_comap]
    intro y hy
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
    intro hu
    obtain ⟨u, hu'⟩ := hu
    obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective ((u⁻¹ : (FibreLocal A q L)ˣ) : FibreLocal A q L)
    have h1 : 1 - v * y ∈ (q.comap (algebraMap A B)).map (algebraMap A L) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hv, ← hu', map_one,
        Units.inv_mul, sub_self]
    have h2 := Ideal.add_mem _ (map_le_maximalIdeal A q L h1) (Ideal.mul_mem_left _ v hy)
    rw [sub_add_cancel] at h2
    exact (maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h2)

omit [q.IsPrime] [IsLocalization.AtPrime L q] [IsLocalRing L] in
lemma toFibre_algebraMap {a : A} (ha : a ∈ q.comap (algebraMap A B)) :
    toFibre A q L (algebraMap A B a) = 0 := by
  rw [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mem_map_of_mem _ ha

end Fibre

section Main

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- Spreading out an inclusion of ideals from `B_q` to a basic open `D(g)`, `g ∉ q`. -/
theorem exists_smul_mem_of_map_le (q : Ideal B) [q.IsPrime] (L : Type*) [CommRing L]
    [Algebra B L] [IsLocalization.AtPrime L q] {I J : Ideal B} (hI : I.FG)
    (h : I.map (algebraMap B L) ≤ J.map (algebraMap B L)) :
    ∃ g ∉ q, ∀ a ∈ I, g * a ∈ J := by
  classical
  obtain ⟨s, rfl⟩ := hI
  have hloc : ∀ a ∈ s, ∃ g : q.primeCompl, (g : B) * a ∈ J := by
    intro a ha
    have := h (Ideal.mem_map_of_mem _ (Ideal.subset_span ha))
    obtain ⟨⟨⟨y, hy⟩, w⟩, hw⟩ :=
      (IsLocalization.mem_map_algebraMap_iff q.primeCompl L).mp this
    rw [← map_mul] at hw
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists q.primeCompl L).mp hw
    refine ⟨c * w, ?_⟩
    have : (c : B) * (a * w) ∈ J := hc ▸ J.mul_mem_left _ hy
    simpa [Submonoid.coe_mul, mul_comm, mul_left_comm, mul_assoc] using this
  choose g hg using hloc
  refine ⟨∏ a ∈ s.attach, (g a.1 a.2 : B), ?_, ?_⟩
  · have : ∏ a ∈ s.attach, (g a.1 a.2 : B) ∈ q.primeCompl :=
      Submonoid.prod_mem _ fun a _ ↦ (g a.1 a.2).2
    exact this
  · intro x hx
    induction hx using Submodule.span_induction with
    | mem a ha =>
      rw [← Finset.mul_prod_erase s.attach (fun a ↦ (g a.1 a.2 : B)) (Finset.mem_attach _ ⟨a, ha⟩)]
      have := J.mul_mem_left (∏ x ∈ s.attach.erase ⟨a, ha⟩, (g x.1 x.2 : B)) (hg a ha)
      convert this using 1
      ring
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact J.add_mem hx hy
    | smul r x _ hx => rw [smul_eq_mul, mul_left_comm]; exact J.mul_mem_left _ hx

/-- **Local criterion.** Let `I ⊆ q` be a finitely generated ideal of `B` with `B/I` flat over
`A`, such that `q` is minimal over `I + 𝔭B` (`𝔭 = q ∩ A`) and the local ring `B_q/𝔭B_q` of the
fibre has principal maximal ideal.  Then `g • I ⊆ (t)` for some `g ∉ q` and `t ∈ I`. -/
theorem exists_smul_le_span (I q : Ideal B) [q.IsPrime] (L : Type*) [CommRing L] [Algebra B L]
    [IsLocalization.AtPrime L q] [IsLocalRing L] [Algebra A L] [IsScalarTower A B L]
    (hI : I.FG) [Module.Flat A (B ⧸ I)]
    (hmin : ∀ q' : Ideal B, q'.IsPrime → I ≤ q' →
      (q.comap (algebraMap A B)).map (algebraMap A B) ≤ q' → q' ≤ q → q' = q)
    (hπ : (maximalIdeal (FibreLocal A q L)).IsPrincipal) :
    ∃ g ∉ q, ∃ t ∈ I, ∀ a ∈ I, g * a ∈ Ideal.span {t} := by
  classical
  set 𝔭 := q.comap (algebraMap A B)
  set ψ := toFibre A q L
  obtain ⟨π, hπ⟩ := hπ.principal
  rw [Ideal.submodule_span_eq] at hπ
  -- Step 1: the image of `I` in the fibre contains a power of `π`.
  have hrad : π ∈ (I.map ψ).radical := by
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro P ⟨hJP, hP⟩
    have hq' : P.comap ψ = q := by
      refine hmin _ (Ideal.comap_isPrime _ _) (Ideal.map_le_iff_le_comap.mp hJP) ?_ ?_
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, Ideal.mem_comap, toFibre_algebraMap A q L ha]
        exact P.zero_mem
      · intro b hb
        by_contra hbq
        have hu : IsUnit (ψ b) := by
          rw [RingHom.comp_apply]
          exact (IsLocalization.map_units L (⟨b, hbq⟩ : q.primeCompl)).map _
        exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ hb hu)
    have : maximalIdeal (FibreLocal A q L) ≤ P := by
      rw [maximalIdeal_fibreLocal]
      exact Ideal.map_le_iff_le_comap.mpr hq'.ge
    exact this (hπ ▸ Ideal.mem_span_singleton_self π)
  obtain ⟨n, hn⟩ := hrad
  -- Step 2: the image of `I` is principal, generated by the image of some `t ∈ I`.
  obtain ⟨j, hj⟩ := eq_span_pow_of_pow_mem hπ hn
  obtain ⟨t, htI, ht⟩ := exists_mem_eq_span_map ψ I hj
  -- Step 3: `s a ∈ (t) + 𝔭 I` for every `a ∈ I` and some `s ∉ q`.
  have hB : ∀ a ∈ I, ∃ s ∉ q, s * a ∈ Ideal.span {t} ⊔ 𝔭.map (algebraMap A B) * I := by
    intro a ha
    have hψa : ψ a ∈ Ideal.span {ψ t} := ht ▸ Ideal.mem_map_of_mem ψ ha
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hψa
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    obtain ⟨⟨b, w⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl r
    have hmem : algebraMap B L a - IsLocalization.mk' L b w * algebraMap B L t ∈
        𝔭.map (algebraMap A L) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul]
      change ψ a - _ = 0
      rw [← hr]
      exact sub_eq_zero.mpr rfl
    have hmem' :
        algebraMap B L (w * a - b * t) ∈ (𝔭.map (algebraMap A B)).map (algebraMap B L) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
      have := (𝔭.map (algebraMap A L)).mul_mem_left (algebraMap B L w) hmem
      convert this using 1
      rw [mul_sub, ← mul_assoc, IsLocalization.mk'_spec', map_sub, map_mul, map_mul]
    obtain ⟨⟨⟨y, hy⟩, w'⟩, hw'⟩ := (IsLocalization.mem_map_algebraMap_iff q.primeCompl L).mp hmem'
    rw [← map_mul] at hw'
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists q.primeCompl L).mp hw'
    -- `c y = c w' (w a - b t)` lies in `I ∩ 𝔭B ⊆ 𝔭 I`
    have hcy : (c : B) * y ∈ 𝔭.map (algebraMap A B) * I := by
      apply inf_map_le_mul_of_flat I 𝔭
      refine ⟨?_, Ideal.mul_mem_left _ _ hy⟩
      rw [← hc]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _
        (I.sub_mem (I.mul_mem_left _ ha) (I.mul_mem_left _ htI)))
    refine ⟨c * w' * w, (q.primeCompl.mul_mem (q.primeCompl.mul_mem c.2 w'.2) w.2), ?_⟩
    have : (c : B) * w' * w * a = (c * w' * b) * t + c * y := by
      rw [← hc]; ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨_, rfl⟩))
      (Ideal.mem_sup_right hcy)
  -- Step 4: Nakayama in `B_q`.
  have hL : I.map (algebraMap B L) ≤ (Ideal.span {t}).map (algebraMap B L) ⊔
      (𝔭.map (algebraMap A L)) • I.map (algebraMap B L) := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    obtain ⟨s, hs, hsa⟩ := hB a ha
    have h1 := Ideal.mem_map_of_mem (algebraMap B L) hsa
    rw [Ideal.map_sup, Ideal.map_mul, Ideal.map_map, ← IsScalarTower.algebraMap_eq,
      map_mul] at h1
    rw [Ideal.mem_comap, Ideal.smul_eq_mul]
    have hu : IsUnit (algebraMap B L s) := IsLocalization.map_units L (⟨s, hs⟩ : q.primeCompl)
    have := Ideal.mul_mem_left _ (↑hu.unit⁻¹) h1
    rwa [← mul_assoc, IsUnit.val_inv_mul, one_mul] at this
  have hNak : I.map (algebraMap B L) ≤ (Ideal.span {t}).map (algebraMap B L) :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (hI.map _)
      (by rw [IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top]; exact map_le_maximalIdeal A q L)
      hL
  obtain ⟨g, hg, hgI⟩ := exists_smul_mem_of_map_le q L hI hNak
  exact ⟨g, hg, t, htI, hgI⟩

/-- On the basic open `D(g)` the ideal becomes principal. -/
theorem map_away_eq_span {I : Ideal B} {g t : B} (S : Type*) [CommRing S] [Algebra B S]
    [IsLocalization.Away g S] (ht : t ∈ I) (hg : ∀ a ∈ I, g * a ∈ Ideal.span {t}) :
    I.map (algebraMap B S) = Ideal.span {algebraMap B S t} := by
  refine le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_map_of_mem _ ht))
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hg a ha)
  have hu : IsUnit (algebraMap B S g) := IsLocalization.Away.algebraMap_isUnit g
  rw [Ideal.mem_comap]
  have : algebraMap B S a = ↑hu.unit⁻¹ * (algebraMap B S c * algebraMap B S t) := by
    rw [← map_mul, hc, map_mul, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
  rw [this]
  exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))

/-- If `I` contains a nonzerodivisor `c` of `B` and `g • I ⊆ (t)`, then `t` is a nonzerodivisor
of `B_g`. -/
theorem isSMulRegular_away {I : Ideal B} {g t c : B} (S : Type*) [CommRing S] [Algebra B S]
    [IsLocalization.Away g S] (hc : c ∈ I) (hcreg : IsSMulRegular B c)
    (hg : ∀ a ∈ I, g * a ∈ Ideal.span {t}) : IsSMulRegular S (algebraMap B S t) := by
  obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp (hg c hc)
  have hcS : IsSMulRegular S (algebraMap B S c) := by
    have key : ∀ e : S, algebraMap B S c * e = 0 → e = 0 := by
      intro e he
      obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers g) e
      simp only at he ⊢
      rw [← IsLocalization.mk'_one (M := Submonoid.powers g) S c, ← IsLocalization.mk'_mul,
        one_mul] at he
      obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp he
      rw [IsLocalization.mk'_eq_zero_iff]
      refine ⟨m, hcreg ?_⟩
      simp only [smul_eq_mul, mul_zero]
      rw [← mul_assoc, mul_comm c, mul_assoc, hm]
    intro a b hab
    simp only [smul_eq_mul] at hab
    exact sub_eq_zero.mp (key _ (by rw [mul_sub, hab, sub_self]))
  intro x y hxy
  apply hcS
  have hu : IsUnit (algebraMap B S g) := IsLocalization.Away.algebraMap_isUnit g
  apply hu.mul_left_cancel
  simp only [smul_eq_mul] at hxy ⊢
  calc algebraMap B S g * (algebraMap B S c * x) = algebraMap B S h * (algebraMap B S t * x) := by
        rw [← mul_assoc, ← map_mul, ← hh, map_mul, mul_assoc]
    _ = algebraMap B S h * (algebraMap B S t * y) := by rw [hxy]
    _ = _ := by rw [← mul_assoc, ← map_mul, hh, map_mul, mul_assoc]

end Main

section Unramified

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Algebra A[X] B]
  [IsScalarTower A A[X] B]

/-- If `B` is formally unramified and essentially of finite type over `A[X]`, then the local ring
`B_q/𝔭B_q` of the fibre at any prime `q` has principal maximal ideal: it is generated by the image
of a generator of the image of `q ∩ A[X]` in the principal ideal domain `κ(𝔭)[X]`. -/
theorem isPrincipal_maximalIdeal_fibre [Algebra.FormallyUnramified A[X] B]
    [Algebra.EssFiniteType A[X] B] (q : Ideal B) [q.IsPrime] :
    (maximalIdeal (FibreLocal A q (Localization.AtPrime q))).IsPrincipal := by
  classical
  set L := Localization.AtPrime q
  set p' := q.comap (algebraMap A[X] B)
  set 𝔭 := q.comap (algebraMap A B)
  -- Step 1: `p' L` is the maximal ideal of `L` (`L` is unramified over `A[X]`).
  have hunr : p'.map (algebraMap A[X] L) = maximalIdeal L := by
    letI : Algebra (Localization.AtPrime p') L :=
      (Localization.localRingHom p' q (algebraMap A[X] B) rfl).toAlgebra
    have : IsScalarTower A[X] (Localization.AtPrime p') L := IsScalarTower.of_algebraMap_eq
      fun x ↦ by
        rw [RingHom.algebraMap_toAlgebra, Localization.localRingHom_to_map,
          IsScalarTower.algebraMap_apply A[X] B L]
    have : Algebra.FormallyUnramified (Localization.AtPrime p') L :=
      .of_restrictScalars A[X] _ _
    have : Algebra.EssFiniteType A[X] L := .comp A[X] B L
    have : Algebra.EssFiniteType (Localization.AtPrime p') L := .of_comp A[X] _ _
    have : IsLocalHom (algebraMap (Localization.AtPrime p') L) :=
      inferInstanceAs (IsLocalHom (Localization.localRingHom p' q (algebraMap A[X] B) rfl))
    have h := Algebra.FormallyUnramified.map_maximalIdeal (R := Localization.AtPrime p') (S := L)
    rwa [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
      ← IsScalarTower.algebraMap_eq] at h
  -- Step 2: the maximal ideal of the fibre is the image of `p'`.
  set θ : A[X] →+* FibreLocal A q L := (Ideal.Quotient.mk _).comp (algebraMap A[X] L)
  have hmax : maximalIdeal (FibreLocal A q L) = p'.map θ := by
    rw [maximalIdeal_fibreLocal, ← Ideal.map_map, Localization.AtPrime.map_eq_maximalIdeal,
      ← hunr, Ideal.map_map]
  -- Step 3: `θ` factors through `κ(𝔭)[X]`.
  set K := IsLocalRing.ResidueField (Localization.AtPrime 𝔭)
  set φ : Localization.AtPrime 𝔭 →+* FibreLocal A q L :=
    (Ideal.Quotient.mk _).comp (Localization.localRingHom 𝔭 q (algebraMap A B) rfl)
  have hφ : ∀ a : A, φ (algebraMap A (Localization.AtPrime 𝔭) a) =
      Ideal.Quotient.mk _ (algebraMap A L a) := by
    intro a
    simp only [φ, RingHom.comp_apply]
    erw [Localization.localRingHom_to_map]
    rw [← IsScalarTower.algebraMap_apply]
  have hker : maximalIdeal (Localization.AtPrime 𝔭) ≤ RingHom.ker φ := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, hφ, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ ha
  let ι : K →+* FibreLocal A q L := Ideal.Quotient.lift _ φ hker
  let μ₀ : A →+* K := (IsLocalRing.residue _).comp (algebraMap A (Localization.AtPrime 𝔭))
  let θ' : K[X] →+* FibreLocal A q L := Polynomial.eval₂RingHom ι (θ X)
  have hθ : θ = θ'.comp (Polynomial.mapRingHom μ₀) := by
    refine Polynomial.ringHom_ext (fun a ↦ ?_) ?_
    · change Ideal.Quotient.mk _ (algebraMap A[X] L (Polynomial.C a)) =
        Polynomial.eval₂ ι (θ X) (Polynomial.map μ₀ (Polynomial.C a))
      rw [Polynomial.map_C, Polynomial.eval₂_C]
      change _ = Ideal.Quotient.lift _ φ hker (Ideal.Quotient.mk _ _)
      rw [Ideal.Quotient.lift_mk, hφ]
      congr 1
      rw [IsScalarTower.algebraMap_apply A[X] B L, IsScalarTower.algebraMap_apply A B L,
        IsScalarTower.algebraMap_apply A A[X] B, Polynomial.algebraMap_eq]
    · simp [θ']
  obtain ⟨h, hh⟩ := (IsPrincipalIdealRing.principal (p'.map (Polynomial.mapRingHom μ₀))).principal
  refine ⟨⟨θ' h, ?_⟩⟩
  rw [hmax, hθ, ← Ideal.map_map, hh, Ideal.submodule_span_eq, Ideal.map_span, Set.image_singleton,
    Ideal.submodule_span_eq]

/-- If `B` is flat over `A[X]` and `B/I` is a finite `A`-module, then `I` contains a nonzerodivisor
of `B`: the characteristic polynomial of `X` acting on `B/I` (Cayley–Hamilton), which is monic. -/
theorem exists_isSMulRegular_mem [Module.Flat A[X] B] (I : Ideal B) [Module.Finite A (B ⧸ I)] :
    ∃ c ∈ I, IsSMulRegular B c := by
  obtain ⟨p, hp, -, hpf⟩ := LinearMap.exists_monic_and_natDegree_eq_and_aeval_eq_zero A
    (Algebra.lsmul A A (B ⧸ I) (algebraMap A[X] B X))
  refine ⟨algebraMap A[X] B p, ?_, ?_⟩
  · rw [Polynomial.aeval_algHom_apply, Polynomial.aeval_algebraMap_apply,
      Polynomial.aeval_X_left_apply] at hpf
    have := congrArg (fun f ↦ f (1 : B ⧸ I)) hpf
    simp only [Algebra.lsmul_coe, LinearMap.zero_apply] at this
    rwa [Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem] at this
  · have := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := B) hp.mem_nonZeroDivisors
    intro x y h
    apply this
    simpa only [Algebra.smul_def, smul_eq_mul, Algebra.algebraMap_self, RingHom.id_apply] using h

end Unramified

end CurvesJacobian.CartierCriterion

namespace CurvesJacobian.CartierCriterion

open IsLocalRing Polynomial

lemma isPrincipal_maximalIdeal_congr {L : Type*} [CommRing L] {J J' : Ideal L} (h : J = J')
    [IsLocalRing (L ⧸ J)] [IsLocalRing (L ⧸ J')] (hp : (maximalIdeal (L ⧸ J)).IsPrincipal) :
    (maximalIdeal (L ⧸ J')).IsPrincipal := by
  subst h
  exact hp

/-- **The algebraic core of Stacks, Lemma 44.3.1 (Tag 0B9D), "(1) ⇒ (2)".**  Let `B` be an
`A`-algebra, `I ⊆ q` an ideal of `B` contained in a prime `q`, such that `I` is finitely
generated, `B/I` is flat and integral over `A`, and `I` contains a nonzerodivisor `c` of `B`.
Suppose `B_a` (`a ∉ q`) is formally unramified and essentially of finite type over `A[X]` (an
"étale coordinate" near `q`).  Then there are `g ∉ q` and `t ∈ I` with `g • I ⊆ (t)`; hence on
`D(g)` the ideal `I` is generated by the nonzerodivisor `t` (`map_away_eq_span`,
`isSMulRegular_away`). -/
theorem exists_smul_le_span_of_unramified {A B B' : Type*} [CommRing A] [CommRing B]
    [CommRing B'] [Algebra A B] [Algebra A B'] [Algebra B B'] [IsScalarTower A B B']
    [Algebra A[X] B'] [IsScalarTower A A[X] B'] [Algebra.FormallyUnramified A[X] B']
    [Algebra.EssFiniteType A[X] B'] (a : B) [IsLocalization.Away a B']
    (I : Ideal B) (hI : I.FG) [Module.Flat A (B ⧸ I)] [Algebra.IsIntegral A (B ⧸ I)]
    (q : Ideal B) [q.IsPrime] (ha : a ∉ q) :
    ∃ g ∉ q, ∃ t ∈ I, ∀ b ∈ I, g * b ∈ Ideal.span {t} := by
  classical
  have hdisj : Disjoint (Submonoid.powers a : Set B) q := by
    rw [Set.disjoint_left]
    rintro _ ⟨n, rfl⟩ hn
    exact ha (Ideal.IsPrime.mem_of_pow_mem inferInstance n hn)
  set q' := q.map (algebraMap B B')
  haveI hq' : q'.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers a) B' q inferInstance hdisj
  have hcomap : q'.comap (algebraMap B B') = q :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers a) B' inferInstance hdisj
  set L := Localization.AtPrime q'
  haveI : IsScalarTower A B L := IsScalarTower.of_algebraMap_eq fun x ↦ by
    rw [IsScalarTower.algebraMap_apply A B' L, IsScalarTower.algebraMap_apply A B B',
      IsScalarTower.algebraMap_apply B B' L]
  haveI : IsLocalization.AtPrime L q := by
    have h : IsLocalization (q'.comap (algebraMap B B')).primeCompl L :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Submonoid.powers a) (S := B') (T := L) q'
    have e : (q'.comap (algebraMap B B')).primeCompl = q.primeCompl := by
      ext x
      simp only [Ideal.mem_primeCompl_iff, hcomap]
    change IsLocalization q.primeCompl L
    exact e ▸ h
  -- minimality of `q` over `I + 𝔭B`, from integrality of `B/I` over `A`
  have hmin : ∀ q'' : Ideal B, q''.IsPrime → I ≤ q'' →
      (q.comap (algebraMap A B)).map (algebraMap A B) ≤ q'' → q'' ≤ q → q'' = q := by
    intro q'' hq'' hIq'' h𝔭 hle
    by_contra hne
    have hlt : q''.map (Ideal.Quotient.mk I) < q.map (Ideal.Quotient.mk I) := by
      refine lt_of_le_of_ne (Ideal.map_mono hle) fun h ↦ hne ?_
      have := congrArg (Ideal.comap (Ideal.Quotient.mk I)) h
      rwa [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective,
        Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr hIq'', sup_eq_left.mpr (hIq''.trans hle)] at this
    haveI : (q''.map (Ideal.Quotient.mk I)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
    have hlt' := Ideal.IsIntegral.comap_lt_comap (R := A) hlt
    rw [IsScalarTower.algebraMap_eq A B (B ⧸ I), Ideal.Quotient.algebraMap_eq,
      ← Ideal.comap_comap, ← Ideal.comap_comap,
      Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective,
      Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
      sup_eq_left.mpr hIq'', sup_eq_left.mpr (hIq''.trans hle)] at hlt'
    exact hlt'.not_ge (Ideal.map_le_iff_le_comap.mp h𝔭)
  have hπ' := isPrincipal_maximalIdeal_fibre (A := A) q'
  have he : (q'.comap (algebraMap A B')).map (algebraMap A L) =
      (q.comap (algebraMap A B)).map (algebraMap A L) := by
    rw [← hcomap, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq]
  exact exists_smul_le_span I q L hI hmin (isPrincipal_maximalIdeal_congr he hπ')

end CurvesJacobian.CartierCriterion
