import CurvesJacobian.Picard.ThetaFitting
import CurvesJacobian.Picard.EulerChar

/-!
# Local principality of `Fit₀(H¹)` for Čech data with a perfect model

Let `f : P → R`, `g : Q → R` be two-set Čech data over a ring `A` with a perfect model
(`TwoTerm.HasPerfectModel f g`).

* `Fitting.fitt0_eq_top_of_subsingleton`: `Fit₀(0) = (1)`;
* `TwoTerm.HasPerfectModel.finite_H1`: `H¹(f, g)` is a finite `A`-module;
* `TwoTerm.HasPerfectModel.exists_fitt0_eq_span`: if the Euler characteristic
  `dim H⁰ − dim H¹` vanishes at a field `B` over `A`, then near the image point of `Spec B`
  (on a basic open `D(s)`) the ideal `Fit₀(H¹)` is principal, generated by some `d ∈ A`;
* `TwoTerm.HasPerfectModel.map_fitt0_eq_top` and
  `TwoTerm.HasPerfectModel.algebraMap_ne_zero_of_H1`: at an `A`-algebra `B` where `H¹` of the
  base-changed data vanishes, `Fit₀(H¹) B = (1)`, so the image of `d` in `B` is nonzero.
-/

open TensorProduct LinearMap Module

universe u

noncomputable section

namespace CurvesJacobian

namespace Fitting

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-- **The Fitting ideal of the zero module is the unit ideal.** -/
theorem fitt0_eq_top_of_subsingleton [Subsingleton M] : fitt0 R M = ⊤ := by
  classical
  have hg : Submodule.span R (Set.range (Fin.elim0 : Fin 0 → M)) = ⊤ :=
    eq_top_iff.2 fun x _ ↦ by rw [Subsingleton.elim x 0]; exact zero_mem _
  rw [fitt0_eq_minorIdeal hg, Ideal.eq_top_iff_one]
  simpa using det_mem_minorIdeal (R := R) (g := (Fin.elim0 : Fin 0 → M))
    (1 : Matrix (Fin 0) (Fin 0) R) fun j ↦ j.elim0

end Fitting

namespace TwoTerm

variable {A : Type u} [CommRing A] {P Q R : Type u} [AddCommGroup P] [Module A P]
  [AddCommGroup Q] [Module A Q] [AddCommGroup R] [Module A R] {f : P →ₗ[A] R} {g : Q →ₗ[A] R}

/-- With a perfect model, `H¹` of two-set Čech data is a finite module. -/
theorem HasPerfectModel.finite_H1 (H : HasPerfectModel f g) :
    Module.Finite A (TwoCech.H1 f g) := by
  obtain ⟨K₀, K₁, δ, -, -, h₃, -, H⟩ := H
  obtain ⟨-, ⟨e⟩⟩ := H A
  exact Module.Finite.equiv (e ≪≫ₗ TwoCech.H1BaseChangeEquiv A f g ≪≫ₗ TensorProduct.lid A _)

/-- The common core of `HasPerfectModel.exists_fitt0_eq_span` and
`HasPerfectModel.exists_fitt0_eq_span_of_preconnected`: for a model `δ : K₀ → K₁` of `H¹`
whose terms have the same rank at `p`, `Fit₀(H¹)` is principal on a basic open around `p`. -/
theorem exists_fitt0_eq_span_of_rankAtStalk_eq {K₀ K₁ : Type u} [AddCommGroup K₀] [Module A K₀]
    [AddCommGroup K₁] [Module A K₁] [Module.Finite A K₀] [Module.Projective A K₀]
    [Module.Finite A K₁] [Module.Free A K₁] (δ : K₀ →ₗ[A] K₁)
    (H : ∀ (B : Type u) [CommRing B] [Algebra A B],
      Nonempty (((B ⊗[A] K₁) ⧸ range (δ.baseChange B)) ≃ₗ[B]
        TwoCech.H1 (f.baseChange B) (g.baseChange B)))
    [Module.Finite A (TwoCech.H1 f g)] (p : PrimeSpectrum A)
    (hrk : rankAtStalk K₀ p = rankAtStalk K₁ p) :
    ∃ s d : A, s ∉ p.asIdeal ∧
      ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away s A'],
        (Fitting.fitt0 A (TwoCech.H1 f g)).map (algebraMap A A') =
          Ideal.span {algebraMap A A' d} := by
  -- `K₀` becomes free on a basic open around `p`
  have : Module.FinitePresentation A K₀ := Module.finitePresentation_of_projective A K₀
  let Ap := Localization.AtPrime p.asIdeal
  have : Module.Free Ap (LocalizedModule p.asIdeal.primeCompl K₀) :=
    Module.free_of_flat_of_isLocalRing
  obtain ⟨s, hs, hfree, hrank⟩ := Module.FinitePresentation.exists_free_localizedModule_powers
    p.asIdeal.primeCompl (LocalizedModule.mkLinearMap p.asIdeal.primeCompl K₀) Ap
  let As := Localization.Away s
  have : Nontrivial As := (show As →+* Ap from IsLocalization.map (M := .powers s)
    (T := p.asIdeal.primeCompl) _ (RingHom.id _) (Submonoid.powers_le.mpr hs)).domain_nontrivial
  let e₀ : As ⊗[A] K₀ ≃ₗ[As] LocalizedModule.Away s K₀ :=
    (IsLocalizedModule.isBaseChange (.powers s) As
      (LocalizedModule.mkLinearMap (.powers s) K₀)).equiv
  have : Module.Free As (As ⊗[A] K₀) := Module.Free.of_equiv e₀.symm
  have hn₀ : finrank As (As ⊗[A] K₀) = rankAtStalk K₀ p := by
    rw [e₀.finrank_eq, hrank]
    rfl
  have : Nontrivial A := (algebraMap A As).domain_nontrivial
  have hn₁ : finrank As (As ⊗[A] K₁) = rankAtStalk K₀ p := by
    rw [Module.finrank_baseChange, hrk, rankAtStalk_eq_finrank_of_free]
    rfl
  let b₀ := Module.finBasisOfFinrankEq As (As ⊗[A] K₀) hn₀
  let b₁ := Module.finBasisOfFinrankEq As (As ⊗[A] K₁) hn₁
  obtain ⟨e₁⟩ := H As
  have : Module.Finite As (TwoCech.H1 (f.baseChange As) (g.baseChange As)) :=
    Module.Finite.equiv (TwoCech.H1BaseChangeEquiv As f g).symm
  have key : (Fitting.fitt0 A (TwoCech.H1 f g)).map (algebraMap A As) =
      Ideal.span {(LinearMap.toMatrix b₀ b₁ (δ.baseChange As)).det} := by
    rw [← Fitting.fitt0_baseChange,
      ← Fitting.fitt0_congr (TwoCech.H1BaseChangeEquiv As f g), ← Fitting.fitt0_congr e₁,
      Fitting.fitt0_quotient_range_eq]
  -- clear denominators
  obtain ⟨⟨d, t⟩, ht⟩ := IsLocalization.surj (Submonoid.powers s)
    (LinearMap.toMatrix b₀ b₁ (δ.baseChange As)).det
  refine ⟨s, d, hs, fun A' _ _ _ ↦ ?_⟩
  have hAs : (Fitting.fitt0 A (TwoCech.H1 f g)).map (algebraMap A As) =
      Ideal.span {algebraMap A As d} := by
    rw [key, ← ht, Ideal.span_singleton_mul_right_unit (IsLocalization.map_units As t)]
  let φ : As ≃ₐ[A] A' := IsLocalization.algEquiv (Submonoid.powers s) As A'
  have hφ : (φ : As →+* A').comp (algebraMap A As) = algebraMap A A' :=
    RingHom.ext fun a ↦ φ.commutes a
  rw [← hφ, ← Ideal.map_map, hAs, Ideal.map_span, Set.image_singleton, ← RingHom.comp_apply, hφ]

/-- For a model `δ : K₀ → K₁` and a field `B` over `A` with `dim_B H⁰ = dim_B H¹`, the ranks
of `K₀` and `K₁` agree at the image of `Spec B` in `Spec A`. -/
lemma rankAtStalk_eq_of_finrank_eq {K₀ K₁ : Type u} [AddCommGroup K₀] [Module A K₀]
    [AddCommGroup K₁] [Module A K₁] [Module.Finite A K₀] [Module.Projective A K₀]
    [Module.Finite A K₁] [Module.Projective A K₁] (δ : K₀ →ₗ[A] K₁) (B : Type u) [Field B]
    [Algebra A B]
    (e₀ : ker (δ.baseChange B) ≃ₗ[B] TwoCech.H0 (f.baseChange B) (g.baseChange B))
    (e₁ : ((B ⊗[A] K₁) ⧸ range (δ.baseChange B)) ≃ₗ[B]
      TwoCech.H1 (f.baseChange B) (g.baseChange B))
    (hχ : finrank B (TwoCech.H0 (f.baseChange B) (g.baseChange B)) =
      finrank B (TwoCech.H1 (f.baseChange B) (g.baseChange B))) (q : PrimeSpectrum B) :
    rankAtStalk K₀ (q.comap (algebraMap A B)) = rankAtStalk K₁ (q.comap (algebraMap A B)) := by
  have := finrank_ker_sub_finrank_coker δ B q
  rw [e₀.finrank_eq, e₁.finrank_eq, hχ, sub_self] at this
  omega

/-- **`Fit₀(H¹)` is principal near a point of Euler characteristic zero.** If the Čech data
have a perfect model and `dim_B H⁰ = dim_B H¹` after base change to a field `B` over `A`, there
are `s ∉ ker (A → B)` and `d ∈ A` such that `Fit₀(H¹(f, g)) A' = (d)` for every localization
`A'` of `A` away from `s`. -/
theorem HasPerfectModel.exists_fitt0_eq_span (H : HasPerfectModel f g) (B : Type u) [Field B]
    [Algebra A B]
    (hχ : finrank B (TwoCech.H0 (f.baseChange B) (g.baseChange B)) =
      finrank B (TwoCech.H1 (f.baseChange B) (g.baseChange B))) :
    ∃ s d : A, s ∉ RingHom.ker (algebraMap A B) ∧
      ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away s A'],
        (Fitting.fitt0 A (TwoCech.H1 f g)).map (algebraMap A A') =
          Ideal.span {algebraMap A A' d} := by
  have := H.finite_H1
  obtain ⟨K₀, K₁, δ, h₁, h₂, h₃, h₄, H⟩ := H
  let q : PrimeSpectrum B := ⟨⊥, Ideal.isPrime_bot⟩
  have hp : (q.comap (algebraMap A B)).asIdeal = RingHom.ker (algebraMap A B) :=
    (RingHom.ker_eq_comap_bot _).symm
  obtain ⟨⟨e₀⟩, ⟨e₁⟩⟩ := H B
  rw [← hp]
  exact exists_fitt0_eq_span_of_rankAtStalk_eq δ (fun B _ _ ↦ (H B).2) _
    (rankAtStalk_eq_of_finrank_eq δ B e₀ e₁ hχ q)

/-- **`Fit₀(H¹)` is locally principal over a connected base of Euler characteristic zero.**
If the Čech data have a perfect model, `Spec A` is preconnected and `dim_B H⁰ = dim_B H¹` at one
field `B` over `A`, then around every prime `p` there are `s ∉ p` and `d ∈ A` such that
`Fit₀(H¹(f, g)) A' = (d)` for every localization `A'` of `A` away from `s`. -/
theorem HasPerfectModel.exists_fitt0_eq_span_of_preconnected (H : HasPerfectModel f g)
    [PreconnectedSpace (PrimeSpectrum A)] (B : Type u) [Field B] [Algebra A B]
    (hχ : finrank B (TwoCech.H0 (f.baseChange B) (g.baseChange B)) =
      finrank B (TwoCech.H1 (f.baseChange B) (g.baseChange B))) (p : PrimeSpectrum A) :
    ∃ s d : A, s ∉ p.asIdeal ∧
      ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away s A'],
        (Fitting.fitt0 A (TwoCech.H1 f g)).map (algebraMap A A') =
          Ideal.span {algebraMap A A' d} := by
  have := H.finite_H1
  obtain ⟨K₀, K₁, δ, h₁, h₂, h₃, h₄, H⟩ := H
  have : Module.FinitePresentation A K₀ := Module.finitePresentation_of_projective A K₀
  have : Module.FinitePresentation A K₁ := Module.finitePresentation_of_projective A K₁
  let q : PrimeSpectrum B := ⟨⊥, Ideal.isPrime_bot⟩
  obtain ⟨⟨e₀⟩, ⟨e₁⟩⟩ := H B
  have h := rankAtStalk_eq_of_finrank_eq δ B e₀ e₁ hχ q
  have hc := (isLocallyConstant_rank_sub (A := A) (K₀ := K₀)
    (K₁ := K₁)).apply_eq_of_preconnectedSpace p (q.comap (algebraMap A B))
  refine exists_fitt0_eq_span_of_rankAtStalk_eq δ (fun B _ _ ↦ (H B).2) p ?_
  simp only [h, sub_self] at hc
  omega

/-- **`Fit₀(H¹)` is the unit ideal where `H¹` vanishes**: for an `A`-algebra `B` with
`H¹(f_B, g_B) = 0`, `Fit₀(H¹(f, g)) B = (1)`. -/
theorem HasPerfectModel.map_fitt0_eq_top (H : HasPerfectModel f g) (B : Type*) [CommRing B]
    [Algebra A B] [Subsingleton (TwoCech.H1 (f.baseChange B) (g.baseChange B))] :
    (Fitting.fitt0 A (TwoCech.H1 f g)).map (algebraMap A B) = ⊤ := by
  have := H.finite_H1
  have : Module.Finite B (TwoCech.H1 (f.baseChange B) (g.baseChange B)) :=
    Module.Finite.equiv (TwoCech.H1BaseChangeEquiv B f g).symm
  rw [← Fitting.fitt0_baseChange, ← Fitting.fitt0_congr (TwoCech.H1BaseChangeEquiv B f g)]
  exact Fitting.fitt0_eq_top_of_subsingleton

/-- **The local generator of `Fit₀(H¹)` does not vanish where `H¹` vanishes**: if
`Fit₀(H¹(f, g)) A_s = (d)` and `B` is a field over `A` in which `s` is invertible and
`H¹(f_B, g_B) = 0`, then `d ≠ 0` in `B`. -/
theorem HasPerfectModel.algebraMap_ne_zero_of_H1 (H : HasPerfectModel f g) {s d : A}
    (A' : Type*) [CommRing A'] [Algebra A A'] [IsLocalization.Away s A']
    (hd : (Fitting.fitt0 A (TwoCech.H1 f g)).map (algebraMap A A') =
      Ideal.span {algebraMap A A' d})
    (B : Type*) [Field B] [Algebra A B] (hs : IsUnit (algebraMap A B s))
    [Subsingleton (TwoCech.H1 (f.baseChange B) (g.baseChange B))] :
    algebraMap A B d ≠ 0 := by
  have h := H.map_fitt0_eq_top B
  let φ : A' →+* B := IsLocalization.Away.lift s hs
  have hφ : φ.comp (algebraMap A A') = algebraMap A B := IsLocalization.Away.lift_comp s hs
  rw [← hφ, ← Ideal.map_map, hd, Ideal.map_span, Set.image_singleton,
    Ideal.span_singleton_eq_top, ← RingHom.comp_apply, hφ] at h
  exact h.ne_zero

end TwoTerm

end CurvesJacobian
