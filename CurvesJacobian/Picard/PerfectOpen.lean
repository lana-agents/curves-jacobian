import CurvesJacobian.Picard.FinrankFibre
import CurvesJacobian.Picard.PerfectModel
import Mathlib.RingTheory.PicardGroup
import Mathlib.RingTheory.Flat.LocallyFree
import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic
import Mathlib.RingTheory.LocalRing.Module
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
import Mathlib.RingTheory.Spectrum.Prime.FreeLocus
import Mathlib.LinearAlgebra.TensorProduct.Quotient
import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix

/-!
# The locus where a two-term perfect complex is an invertible module in degree 0

Let `δ : K₀ → K₁` be a map of finite projective modules over a ring `A`. For an `A`-algebra `B`
the condition "`coker(B ⊗ δ) = 0` and `ker(B ⊗ δ)` is an invertible `B`-module" holds iff
`Spec B → Spec A` lands in the open set `PerfectOpen.goodLocus δ`
(`PerfectOpen.good_iff`, `PerfectOpen.isOpen_goodLocus`): this is Stacks, Lemma 36.31.3
(Tag 0BDK) with `i = 0`, `r = 1`, for two-term complexes, the input of Lemma 36.32.3 (Tag 0B9S)
and hence of the openness statement Lemma 44.6.2 (Tag 0B9V).

Along the way:
* `PerfectOpen.invertible_iff`: a module is invertible iff it is finite projective of rank one
  at every prime (the converse direction is not in Mathlib);
* `PerfectOpen.mem_support_baseChange_iff`: the support of a finite module commutes with base
  change.
-/

open TensorProduct LinearMap Module

attribute [local instance] Module.free_of_flat_of_isLocalRing

universe u

namespace CurvesJacobian.PerfectOpen

section Invertible

variable {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M] [Module R M]

/-- An invertible module has rank one at every prime. -/
lemma rankAtStalk_eq_one [Module.Invertible R M] (p : PrimeSpectrum R) : rankAtStalk M p = 1 := by
  simp [rankAtStalk, Invertible.finrank_eq_one]

/-- A projective module is generated by the values of its linear forms (dual basis lemma):
`M = I • M` for the trace ideal `I = range (Mᵛ ⊗ M → R)`. -/
lemma le_trace_smul [Module.Projective R M] :
    (⊤ : Submodule R M) ≤ (LinearMap.range (contractLeft R M)) • ⊤ := by
  obtain ⟨s, hs⟩ := Module.projective_def'.mp (inferInstance : Module.Projective R M)
  intro x _
  have hx : x = Finsupp.linearCombination R id (s x) := (LinearMap.congr_fun hs x).symm
  rw [hx, Finsupp.linearCombination_apply]
  refine Submodule.sum_mem _ fun y _ ↦ Submodule.smul_mem_smul ⟨(Finsupp.lapply y ∘ₗ s) ⊗ₜ x, ?_⟩
    Submodule.mem_top
  simp

/-- **A finite projective module of rank one at every prime is invertible.** -/
theorem invertible_of_rankAtStalk [Module.Finite R M] [Module.Projective R M]
    (h : ∀ p : PrimeSpectrum R, rankAtStalk M p = 1) : Module.Invertible R M := by
  -- surjectivity of `Mᵛ ⊗ M → R`
  have hsurj : Function.Surjective (contractLeft R M) := by
    rw [← LinearMap.range_eq_top]
    by_contra hI
    obtain ⟨m, hm, hIm⟩ := Ideal.exists_le_maximal _ hI
    have hle : (⊤ : Submodule R M) ≤ m • ⊤ :=
      le_trace_smul.trans (Submodule.smul_mono_left hIm)
    obtain ⟨r, hr, hr0⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul m ⊤
      (Module.Finite.fg_top) hle
    have hann : r ∈ Module.annihilator R M :=
      Module.mem_annihilator.mpr fun x ↦ hr0 x Submodule.mem_top
    have hrm : r ∉ m := fun h' ↦ hm.ne_top ((Ideal.eq_top_iff_one _).mpr
      (by simpa using m.sub_mem h' hr))
    have hsupp : (⟨m, hm.isPrime⟩ : PrimeSpectrum R) ∉ Module.support R M := by
      rw [Module.support_eq_zeroLocus, PrimeSpectrum.mem_zeroLocus]
      exact fun h' ↦ hrm (h' hann)
    have := h ⟨m, hm.isPrime⟩
    rw [(rankAtStalk_eq_zero_iff_notMem_support _).mpr hsupp] at this
    exact zero_ne_one this
  -- the rank of the dual
  have hdual : ∀ p : PrimeSpectrum R, rankAtStalk (Dual R M) p = rankAtStalk M p := fun p ↦ by
    haveI : Nontrivial R := p.nontrivial
    haveI : Module.FinitePresentation R M := Module.finitePresentation_of_projective R M
    let S := p.asIdeal.primeCompl
    let e := (IsLocalizedModule.iso S (LocalizedModule.map S (M := M) (N := R))
      ).extendScalarsOfIsLocalization S (Localization S)
    change finrank _ (LocalizedModule S (Dual R M)) = finrank _ (LocalizedModule S M)
    have h1 : finrank (Localization S) (LocalizedModule S R) = 1 := by
      have := congrFun (rankAtStalk_self (R := R)) p
      exact this
    rw [e.finrank_eq, Module.finrank_linearMap, h1, mul_one]
  refine ⟨bijective_of_surjective_of_rankAtStalk_eq hsurj fun m _ ↦ ?_⟩
  haveI : Nontrivial R := ⟨⟨0, 1, fun h ↦ (‹m.IsMaximal›).ne_top
    ((Ideal.eq_top_iff_one _).mpr (h ▸ m.zero_mem))⟩⟩
  rw [rankAtStalk_tensorProduct, Pi.mul_apply, hdual, h, rankAtStalk_self]
  rfl

/-- An invertible module is finite projective of rank one at every prime, and conversely. -/
theorem invertible_iff : Module.Invertible R M ↔ Module.Finite R M ∧ Module.Projective R M ∧
    ∀ p : PrimeSpectrum R, rankAtStalk M p = 1 :=
  ⟨fun _ ↦ ⟨inferInstance, inferInstance, rankAtStalk_eq_one⟩,
    fun ⟨_, _, h⟩ ↦ invertible_of_rankAtStalk h⟩

end Invertible

section Support

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] {Q : Type u} [AddCommGroup Q]
  [Module A Q]

/-- **The support of a finite module commutes with base change.** -/
theorem mem_support_baseChange_iff [Module.Finite A Q] (q : PrimeSpectrum B) :
    q ∈ Module.support B (B ⊗[A] Q) ↔
      PrimeSpectrum.comap (algebraMap A B) q ∈ Module.support A Q := by
  rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct,
    Module.mem_support_iff_nontrivial_residueField_tensorProduct]
  set p := PrimeSpectrum.comap (algebraMap A B) q
  let φ := Ideal.ResidueField.mapₐ p.asIdeal q.asIdeal (Algebra.ofId A B) rfl
  letI : Algebra p.asIdeal.ResidueField q.asIdeal.ResidueField := φ.toAlgebra
  haveI : IsScalarTower A p.asIdeal.ResidueField q.asIdeal.ResidueField :=
    IsScalarTower.of_algebraMap_eq fun a ↦ (φ.commutes a).symm
  let e₁ := AlgebraTensorModule.cancelBaseChange A B q.asIdeal.ResidueField
    q.asIdeal.ResidueField Q
  let e₂ := AlgebraTensorModule.cancelBaseChange A p.asIdeal.ResidueField
    q.asIdeal.ResidueField q.asIdeal.ResidueField Q
  rw [e₁.nontrivial_congr, ← e₂.nontrivial_congr,
    Module.FaithfullyFlat.nontrivial_tensorProduct_iff_right]

end Support

section Locus

variable {A : Type u} [CommRing A] {K₀ K₁ : Type u} [AddCommGroup K₀] [Module A K₀]
  [AddCommGroup K₁] [Module A K₁] (δ : K₀ →ₗ[A] K₁)

/-- Surjectivity of `B ⊗ δ` is the vanishing of `B ⊗ coker δ`. -/
lemma surjective_baseChange_iff (B : Type u) [CommRing B] [Algebra A B] :
    Function.Surjective (δ.baseChange B) ↔ Subsingleton (B ⊗[A] (K₁ ⧸ LinearMap.range δ)) := by
  have hex : Function.Exact (δ.lTensor B) ((LinearMap.range δ).mkQ.lTensor B) :=
    lTensor_exact B (LinearMap.exact_map_mkQ_range δ) (Submodule.mkQ_surjective _)
  have hg : Function.Surjective ((LinearMap.range δ).mkQ.lTensor B) :=
    LinearMap.lTensor_surjective B (Submodule.mkQ_surjective _)
  have hfun : ⇑(δ.baseChange B) = ⇑(δ.lTensor B) := rfl
  rw [hfun]
  constructor
  · intro hs
    refine ⟨fun y z ↦ ?_⟩
    obtain ⟨y, rfl⟩ := hg y
    obtain ⟨z, rfl⟩ := hg z
    obtain ⟨y, rfl⟩ := hs y
    obtain ⟨z, rfl⟩ := hs z
    rw [hex.apply_apply_eq_zero, hex.apply_apply_eq_zero]
  · intro hQ x
    exact (hex x).mp (Subsingleton.elim _ _)

/-- **The good locus** of `δ`: primes where `coker δ` vanishes and the ranks of `K₀`, `K₁` differ
by one. -/
def goodLocus : Set (PrimeSpectrum A) :=
  {p | p ∉ Module.support A (K₁ ⧸ LinearMap.range δ) ∧ rankAtStalk K₀ p = rankAtStalk K₁ p + 1}

variable [Module.Finite A K₀] [Module.Projective A K₀] [Module.Finite A K₁]
  [Module.Projective A K₁]

/-- The good locus is open (Stacks, Lemma 36.31.3, Tag 0BDK, two-term case). -/
theorem isOpen_goodLocus : IsOpen (goodLocus δ) := by
  haveI : Module.FinitePresentation A K₀ := Module.finitePresentation_of_projective A K₀
  haveI : Module.FinitePresentation A K₁ := Module.finitePresentation_of_projective A K₁
  refine IsOpen.inter ?_ ?_
  · rw [Module.support_eq_zeroLocus]
    exact (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl
  · have h := (isLocallyConstant_rankAtStalk (R := A) (M := K₀)).comp₂
      (isLocallyConstant_rankAtStalk (R := A) (M := K₁)) (fun a b ↦ decide (a = b + 1))
    have := h.isOpen_fiber true
    convert this using 1
    ext p
    change rankAtStalk K₀ p = rankAtStalk K₁ p + 1 ↔
      decide (rankAtStalk K₀ p = rankAtStalk K₁ p + 1) = true
    exact decide_eq_true_iff.symm

/-- **The good locus represents the condition `coker(B ⊗ δ) = 0`, `ker(B ⊗ δ)` invertible**
(Stacks, Lemma 36.31.3, Tag 0BDK, for two-term perfect complexes, `i = 0`, `r = 1`). -/
theorem good_iff (B : Type u) [CommRing B] [Algebra A B] :
    (Function.Surjective (δ.baseChange B) ∧ Module.Invertible B (LinearMap.ker (δ.baseChange B)))
      ↔ ∀ q : PrimeSpectrum B, PrimeSpectrum.comap (algebraMap A B) q ∈ goodLocus δ := by
  have hsurj : Function.Surjective (δ.baseChange B) ↔
      ∀ q : PrimeSpectrum B, PrimeSpectrum.comap (algebraMap A B) q ∉
        Module.support A (K₁ ⧸ LinearMap.range δ) := by
    rw [surjective_baseChange_iff, ← Module.support_eq_empty_iff (R := B),
      Set.eq_empty_iff_forall_notMem]
    exact forall_congr' fun q ↦ (mem_support_baseChange_iff q).not
  -- ranks once `B ⊗ δ` is surjective
  have hrank : Function.Surjective (δ.baseChange B) →
      (Module.Invertible B (LinearMap.ker (δ.baseChange B)) ↔
        ∀ q : PrimeSpectrum B, rankAtStalk K₀ (PrimeSpectrum.comap (algebraMap A B) q) =
          rankAtStalk K₁ (PrimeSpectrum.comap (algebraMap A B) q) + 1) := by
    intro hs
    obtain ⟨s, hs'⟩ := LinearMap.exists_rightInverse_of_surjective (δ.baseChange B)
      (LinearMap.range_eq_top.mpr hs)
    let ι := (LinearMap.ker (δ.baseChange B)).subtype
    let π : B ⊗[A] K₀ →ₗ[B] LinearMap.ker (δ.baseChange B) :=
      (LinearMap.id - s ∘ₗ δ.baseChange B).codRestrict _ fun x ↦ by
        rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, map_sub,
          LinearMap.comp_apply, ← LinearMap.comp_apply (δ.baseChange B) s, hs',
          LinearMap.id_apply, sub_self]
    have hπι : π ∘ₗ ι = LinearMap.id := LinearMap.ext fun x ↦ Subtype.ext <| by
      simp [π, ι]
    haveI : Module.Finite B (LinearMap.ker (δ.baseChange B)) :=
      Module.Finite.of_surjective π fun x ↦ ⟨ι x, by rw [← LinearMap.comp_apply, hπι]; rfl⟩
    haveI : Module.Projective B (LinearMap.ker (δ.baseChange B)) :=
      Module.Projective.of_split ι π hπι
    have hadd := fun q ↦ Module.rankAtStalk_eq_add_of_exact ι (δ.baseChange B)
      Subtype.val_injective hs (fun x ↦ by simp [ι]) q
    rw [invertible_iff]
    constructor
    · rintro ⟨_, _, h⟩ q
      have := hadd q
      rw [rankAtStalk_baseChange, rankAtStalk_baseChange, h q] at this
      omega
    · intro h
      refine ⟨inferInstance, inferInstance, fun q ↦ ?_⟩
      have := hadd q
      rw [rankAtStalk_baseChange, rankAtStalk_baseChange, h q] at this
      omega
  constructor
  · rintro ⟨hs, hinv⟩ q
    exact ⟨hsurj.mp hs q, (hrank hs).mp hinv q⟩
  · intro h
    have hs := hsurj.mpr fun q ↦ (h q).1
    exact ⟨hs, (hrank hs).mpr fun q ↦ (h q).2⟩

end Locus

end CurvesJacobian.PerfectOpen
