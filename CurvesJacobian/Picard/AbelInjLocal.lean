import CurvesJacobian.Picard.ZeroScheme
import CurvesJacobian.Picard.RelEffCartierUnit
import CurvesJacobian.Picard.CechGlobal
import CurvesJacobian.Picard.PicFH0
import CurvesJacobian.Picard.RelEffCartierDegree

/-!
# Divisors with isomorphic line bundles and cyclic `H⁰` coincide

Let `C` be a curve over a perfect field `k` with a finite `π : C → ℙ¹_k`, `T` an affine
`k`-scheme, and `D`, `D'` relative effective Cartier divisors on `C ×_k T` over `T` with
`𝒪(D) ≅ 𝒪(D')`. If the Čech `H⁰` of `𝒪(D')` (chart covering) is generated by one element `s`
over `Γ(T)`, then `D = D'` (`CurvesJacobian.RelEffCartier.eq_of_picClass_eq`).

Proof (Stacks, Lemma 44.6.4, Tag 0B9X, injectivity of `h_W → F`): write the canonical sections
as `s_D = α s`, `s_{D'} = β s` (after transporting along `𝒪(D) ≅ 𝒪(D')`), with
`α, β ∈ Γ(T)`. The zero scheme of `s_D` is `D` (`RelEffCartier.zeroIdeal_canonicalSection`), so
`D ⊆ α · 𝒪`, whence `α` is a unit (`RelEffCartier.isUnit_of_ideal_le`); similarly for `β`. So
`D` and `D'` both equal the zero scheme of `s`.
-/

open CategoryTheory Limits TopologicalSpace AlgebraicGeometry

universe u

noncomputable section

namespace CurvesJacobian

open Cech Belyi

variable {k : Type u} [Field k] {C : Scheme.{u}} [C.Over (Spec (CommRingCat.of k))]
  (π : C ⟶ ProjectiveLine.scheme k)

local notation "Sk" => Spec (CommRingCat.of k)

lemma chartOf_sup {T : Scheme.{u}} (g : T ⟶ Sk) : chartOf π g 0 ⊔ chartOf π g 1 = ⊤ := by
  rw [chartOf, chartOf, ← Scheme.Hom.preimage_sup, ProjectiveLine.U_sup]
  rfl

lemma surjective_pullback_snd [IsCurveOver k C] [PerfectField k] {T : Scheme.{u}}
    (g : T ⟶ Sk) : Surjective (pullback.snd (C ↘ Sk) g) := by
  haveI := IsCurveOver.isIntegral k C
  haveI : Surjective (C ↘ Sk) := ⟨fun x ↦ by
    obtain ⟨c⟩ := (inferInstance : Nonempty C)
    refine ⟨c, Subsingleton.elim (α := Sk) _ _⟩⟩
  exact MorphismProperty.pullback_snd _ _ inferInstance

variable [PerfectField k] [IsCurveOver k C]

/-- **Divisors with isomorphic line bundles and cyclic `H⁰` coincide** (Stacks, Lemma 44.6.4,
Tag 0B9X, injectivity). -/
theorem RelEffCartier.eq_of_picClass_eq {T : Scheme.{u}} [IsAffine T] (g : T ⟶ Sk)
    (D D' : RelEffCartier (pullback.snd (C ↘ Sk) g)) (hpic : D.picClass = D'.picClass)
    (s : chartH0 π g D'.lineBundle) (hs : Submodule.span Γ(T, ⊤) {s} = ⊤) : D = D' := by
  haveI := surjective_pullback_snd (C := C) g
  obtain ⟨e⟩ := (Scheme.Pic.mk_eq_mk_iff (L := D.lineBundle) (M := D'.lineBundle)).mp hpic
  let E := globalSectionsEquivH0 T D'.lineBundle (chartOf_sup π g)
  set s₀ := E.symm s
  have hs₀ : Submodule.span Γ(T, ⊤) {s₀} = ⊤ :=
    span_singleton_equiv_eq_top E.symm hs
  have hmem : ∀ x : Γ(D'.lineBundle, ⊤), ∃ α : Γ(T, ⊤), α • s₀ = x := fun x ↦
    Submodule.mem_span_singleton.mp (hs₀ ▸ Submodule.mem_top)
  -- the zero scheme of `α • s₀`, `α` a unit, is that of `s₀`
  have key : ∀ (D₁ : RelEffCartier (pullback.snd (C ↘ Sk) g)) (α : Γ(T, ⊤)),
      D₁.ideal = Scheme.Modules.zeroIdeal D'.lineBundle (α • s₀) →
        D₁.ideal = Scheme.Modules.zeroIdeal D'.lineBundle s₀ := by
    intro D₁ α hD₁
    have hα' := smul_sections_def (S := T) (pullback (C ↘ Sk) g) D'.lineBundle ⊤ α s₀
    have hres : ∀ U : (pullback (C ↘ Sk) g).affineOpens,
        (pullback (C ↘ Sk) g).presheaf.map (homOfLE le_top).op
          (algebraMap Γ(T, ⊤) Γ(pullback (C ↘ Sk) g, ⊤) α) =
          (pullback.snd (C ↘ Sk) g).appLE ⊤ U.1 (by simp) α := fun U ↦ by
      rw [algebraMap_sections, ← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
      rfl
    have hunit : IsUnit α := by
      refine D₁.isUnit_of_ideal_le α fun U ↦ ?_
      rw [hD₁, hα', Scheme.Modules.zeroIdeal_smul, hres]
      exact Ideal.mul_le_right
    rw [hD₁]
    refine Scheme.IdealSheafData.ext (funext fun U ↦ ?_)
    rw [hα', Scheme.Modules.zeroIdeal_smul, hres,
      Ideal.span_singleton_eq_top.mpr ((hunit.map _)), Ideal.top_mul]
  obtain ⟨α, hα⟩ := hmem (e.hom.app ⊤ D.canonicalSection)
  obtain ⟨β, hβ⟩ := hmem D'.canonicalSection
  have h1 : D.ideal = Scheme.Modules.zeroIdeal D'.lineBundle (α • s₀) := by
    rw [hα, Scheme.Modules.zeroIdeal_iso, RelEffCartier.zeroIdeal_canonicalSection]
  have h2 : D'.ideal = Scheme.Modules.zeroIdeal D'.lineBundle (β • s₀) := by
    rw [hβ, RelEffCartier.zeroIdeal_canonicalSection]
  exact RelEffCartier.ext_ideal ((key D α h1).trans (key D' β h2).symm)

end CurvesJacobian
