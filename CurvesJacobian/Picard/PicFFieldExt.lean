import CurvesJacobian.Picard.PicDegreeTranslate
import CurvesJacobian.Picard.JacobianBaseChange

/-!
# Translates of `F` by classes of geometric points (Stacks, Lemma 44.6.5, Tag 0B9Y, over `k̄`)

Let `C` be a curve over a perfect field `k` with a finite `π : C → ℙ¹_k`, `Ω ⊇ k` an
algebraically closed field and `K` a field over `Ω`. This file proves the version of Stacks,
Lemma 44.6.5 (Tag 0B9Y) used to descend the Jacobian to a finite extension of `k`: every point
of `Pic_{C/k,σ}` over `K` has a translate in `F` (chart Čech complex with `H¹ = 0`, `h⁰ = 1`, for
the chart `π` of `C` over `k`) by a class over `Ω` which is a sum of a class pulled back from `k`
and of the classes of `Ω`-points of `C`.

* `CurvesJacobian.ptSec`: the section `S₁ ⟶ C ×_k S₁` of a point `x : S₁ ⟶ C` over `k`;
  `CurvesJacobian.map_picClass_ptSec`: the divisors of these sections are compatible with base
  change (the image of a section is cartesian over its base change);
* `CurvesJacobian.ptClass`: the class of `𝒪(x)` in `Pic_{C/k,σ}(S₁)` (`Pic(S₁) = 0`);
  `CurvesJacobian.map_ptClass`: naturality;
* `CurvesJacobian.chiCurve_add_ofSection'`, `CurvesJacobian.chiPoint_add_ptClass`: translating by
  the class of a point in both charts raises `χ` by one;
* `CurvesJacobian.exists_pt_appLE_ne_zero` (**density of `C(Ω)`**): a nonzero function on
  `W ×_k K` does not vanish at the base change of some `Ω`-point (reduction to
  `exists_point_appLE_ne_zero` for the curve `C_Ω` over `Ω`);
* **`CurvesJacobian.exists_picF_translate_ext`**: the translate statement, with the translating
  class in the subgroup `ptSubgroup` generated by classes from `k` and classes of `Ω`-points.
-/

open CategoryTheory Limits Opposite TopologicalSpace AlgebraicGeometry Function
open AlgebraicGeometry.Scheme.Modules MonoidalCategory

universe u

noncomputable section

namespace CurvesJacobian

open Cech Belyi

variable {k : Type u} [Field k] (C : Scheme.{u}) [C.Over (Spec (CommRingCat.of k))]

local notation "Sk" => Spec (CommRingCat.of k)

section PointSection

variable {S₁ : Scheme.{u}} (g₁ : S₁ ⟶ Spec (CommRingCat.of k)) (x : S₁ ⟶ C)
  (hx : x ≫ (C ↘ Spec (CommRingCat.of k)) = g₁)

include hx in
/-- The section `S₁ ⟶ C ×_k S₁` of the projection defined by a point `x : S₁ ⟶ C` over `k`. -/
def ptSec : S₁ ⟶ pullback (C ↘ Sk) g₁ :=
  pullback.lift x (𝟙 S₁) (by rw [hx, Category.id_comp])

@[reassoc (attr := simp)]
lemma ptSec_fst : ptSec C g₁ x hx ≫ pullback.fst _ _ = x := pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
lemma ptSec_snd : ptSec C g₁ x hx ≫ pullback.snd _ _ = 𝟙 S₁ := pullback.lift_snd _ _ _

variable {T : Scheme.{u}} (a : T ⟶ S₁) (g : T ⟶ Spec (CommRingCat.of k)) (ha : a ≫ g₁ = g)

include hx ha in
lemma comp_pt_hom : (a ≫ x) ≫ (C ↘ Sk) = g := by rw [Category.assoc, hx, ha]

lemma ptSec_bcMap :
    ptSec C g (a ≫ x) (comp_pt_hom C g₁ x hx a g ha) ≫ bcMap (C ↘ Sk) a g₁ g ha =
      a ≫ ptSec C g₁ x hx := by
  apply pullback.hom_ext <;> simp

variable [IsCurveOver k C]

/-- The image of the base change of a section is the preimage of the image of the section. -/
theorem ker_ptSec_eq_comap :
    (ptSec C g (a ≫ x) (comp_pt_hom C g₁ x hx a g ha)).ker =
      (ptSec C g₁ x hx).ker.comap (bcMap (C ↘ Sk) a g₁ g ha) := by
  haveI := isClosedImmersion_of_section C g₁ (ptSec C g₁ x hx) (ptSec_snd C g₁ x hx)
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
  have hbig : IsPullback a (ptSec C g (a ≫ x) (comp_pt_hom C g₁ x hx a g ha) ≫
      pullback.snd (C ↘ Sk) g) (ptSec C g₁ x hx ≫ pullback.snd (C ↘ Sk) g₁) a := by
    rw [ptSec_snd, ptSec_snd]
    exact IsPullback.id_vert a
  have H := (IsPullback.of_bot hbig (ptSec_bcMap C g₁ x hx a g ha).symm
    (isPullback_bcMap (C ↘ Sk) a g₁ g ha)).flip
  rw [← H.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso]

variable [PerfectField k]

/-- The divisors of `x` and of its base change correspond under pullback. -/
theorem map_picClass_ptSec :
    Scheme.Pic.map (bcMap (C ↘ Sk) a g₁ g ha)
        (RelEffCartier.ofSection C g₁ (ptSec C g₁ x hx) (ptSec_snd C g₁ x hx)).picClass =
      (RelEffCartier.ofSection C g (ptSec C g (a ≫ x) (comp_pt_hom C g₁ x hx a g ha))
        (ptSec_snd _ _ _ _)).picClass :=
  RelEffCartier.map_picClass_of_ideal_eq _ _ _ (by
    rw [RelEffCartier.ofSection_ideal, RelEffCartier.ofSection_ideal, ker_ptSec_eq_comap])

end PointSection

section PtClass

variable [PerfectField k] [IsCurveOver k C] (σ : Spec (CommRingCat.of k) ⟶ C)
  (hσ : σ ≫ (C ↘ Spec (CommRingCat.of k)) = 𝟙 (Spec (CommRingCat.of k)))

local notation "G" => picSigma (C ↘ Sk) σ hσ

variable {S₁ : Scheme.{u}} [Subsingleton S₁.Pic] (g₁ : S₁ ⟶ Spec (CommRingCat.of k)) (x : S₁ ⟶ C)
  (hx : x ≫ (C ↘ Spec (CommRingCat.of k)) = g₁)

/-- The class of `𝒪(x)` in `Pic_{C/k,σ}(S₁)` for a point `x : S₁ ⟶ C` (with `Pic(S₁) = 0`). -/
def ptClass : (picSigma (C ↘ Sk) σ hσ).obj (op (Over.mk g₁)) :=
  have hmem : (RelEffCartier.ofSection C g₁ (ptSec C g₁ x hx)
      (ptSec_snd _ _ _ _)).picClass ∈ picSigmaGrp (C ↘ Sk) σ hσ g₁ := by
    rw [mem_picSigmaGrp]
    exact Subsingleton.elim _ _
  ⟨_, hmem⟩

lemma coe_ptClass : (ptClass C σ hσ g₁ x hx).1 =
      (RelEffCartier.ofSection C g₁ (ptSec C g₁ x hx) (ptSec_snd _ _ _ _)).picClass := rfl

/-- `ptClass` is natural. -/
lemma map_ptClass {T : Scheme.{u}} [Subsingleton T.Pic] (a : T ⟶ S₁) (g : T ⟶ Sk)
    (ha : a ≫ g₁ = g) :
    ((G).map (Over.homMk a ha : Over.mk g ⟶ Over.mk g₁).op).hom (ptClass C σ hσ g₁ x hx) =
      ptClass C σ hσ g (a ≫ x) (comp_pt_hom C g₁ x hx a g ha) := by
  apply Subtype.ext
  exact map_picClass_ptSec C g₁ x hx a g ha

end PtClass

section Degree

variable [PerfectField k] [IsCurveOver k C] (π : C ⟶ ProjectiveLine.scheme k) [IsFinite π]

/-- **Twisting by a section in both charts raises `χ` by one**: for `T` affine over `k` with
`Γ(T)` a field and a section `s` of `C ×_k T → T` landing in both charts,
`χ(M ⊗ 𝒪(s(T))) = χ(M) + 1`. -/
theorem chiCurve_add_ofSection' {T : Scheme.{u}} [T.Over (Spec (CommRingCat.of k))] [IsAffine T]
    (hF : IsField Γ(T, ⊤)) (M : (pullback (C ↘ Sk) (T ↘ Sk)).Modules) [M.IsInvertible]
    (s : T ⟶ pullback (C ↘ Sk) (T ↘ Sk)) (hs : s ≫ pullback.snd _ _ = 𝟙 T)
    (hsW : ⊤ ≤ (s ≫ pullback.fst _ _) ⁻¹ᵁ
      (π ⁻¹ᵁ (ProjectiveLine.U k 0 ⊓ ProjectiveLine.U k 1))) :
    chiCurve π (T ↘ Sk) (Scheme.Pic.rep (Scheme.Pic.mk M +
      (RelEffCartier.ofSection C (T ↘ Sk) s hs).picClass)) = chiCurve π (T ↘ Sk) M + 1 := by
  letI := hF.toField
  haveI := isClosedImmersion_of_section C (T ↘ Sk) s hs
  set D := RelEffCartier.ofSection C (T ↘ Sk) s hs
  set P := Scheme.Pic.rep (Scheme.Pic.mk M + D.picClass)
  have e : P ≅ M ⊗ D.lineBundle := by
    refine (Scheme.Pic.mk_eq_mk_iff.mp ?_).some
    rw [Scheme.Pic.mk_tensor, Scheme.Pic.mk_rep]
    rfl
  have hU := isAffineOpen_chart (T₀ := T) π 0
  have hV := isAffineOpen_chart (T₀ := T) π 1
  have hUV := isAffineOpen_chart_inf (T₀ := T) π
  have hσ : ⊤ ≤ s ⁻¹ᵁ ((pullback.fst (C ↘ Sk) (T ↘ Sk) ≫ π) ⁻¹ᵁ ProjectiveLine.U k 0 ⊓
      (pullback.fst (C ↘ Sk) (T ↘ Sk) ≫ π) ⁻¹ᵁ ProjectiveLine.U k 1) := by
    intro t _
    exact hsW (show t ∈ (⊤ : T.Opens) from trivial)
  haveI := (finite_cechModH0_H1 (T₀ := T) π M).1
  haveI := (finite_cechModH0_H1 (T₀ := T) π M).2
  haveI := (finite_cechModH0_H1 (T₀ := T) π P).1
  haveI := (finite_cechModH0_H1 (T₀ := T) π P).2
  have key := chi_twist s hs hF hU hV hUV hσ D (RelEffCartier.ofSection_ideal _ _ _ _) M P e
  rw [chiCurve, chiCurve]
  exact key

variable (σ : Spec (CommRingCat.of k) ⟶ C)
  (hσ : σ ≫ (C ↘ Spec (CommRingCat.of k)) = 𝟙 (Spec (CommRingCat.of k)))

local notation "G" => picSigma (C ↘ Sk) σ hσ

/-- **Translating by the class of a point in both charts raises `χ` by one** (`deg 𝒪(x) = 1`). -/
theorem chiPoint_add_ptClass {S₁ : Scheme.{u}} [Subsingleton S₁.Pic] (g₁ : S₁ ⟶ Sk)
    (x : S₁ ⟶ C) (hx : x ≫ (C ↘ Sk) = g₁)
    (hxW : ⊤ ≤ x ⁻¹ᵁ (π ⁻¹ᵁ (ProjectiveLine.U k 0 ⊓ ProjectiveLine.U k 1)))
    {T : Scheme.{u}} [IsAffine T] (hF : IsField Γ(T, ⊤)) (a : T ⟶ S₁) (g : T ⟶ Sk)
    (ha : a ≫ g₁ = g) (y : (G).obj (op (Over.mk g))) :
    chiPoint σ hσ π (⟨g, ((G).map (Over.homMk a ha : Over.mk g ⟶ Over.mk g₁).op).hom
      (ptClass C σ hσ g₁ x hx) + y⟩ : (sigmaG G).obj (op T)) =
        chiPoint σ hσ π (⟨g, y⟩ : (sigmaG G).obj (op T)) + 1 := by
  letI : T.Over Sk := ⟨g⟩
  haveI : Scheme.Modules.IsInvertible (X := pullback (C ↘ Sk) (T ↘ Sk))
      (Scheme.Pic.rep (y : picSigmaGrp (C ↘ Sk) σ hσ g).1) :=
    inferInstanceAs (Scheme.Pic.rep (y : picSigmaGrp (C ↘ Sk) σ hσ g).1).IsInvertible
  have hsW : ⊤ ≤ (ptSec C g (a ≫ x) (comp_pt_hom C g₁ x hx a g ha) ≫ pullback.fst _ _) ⁻¹ᵁ
      (π ⁻¹ᵁ (ProjectiveLine.U k 0 ⊓ ProjectiveLine.U k 1)) := by
    rw [ptSec_fst, Scheme.Hom.comp_preimage]
    exact le_top.trans (a.preimage_mono hxW)
  have key := chiCurve_add_ofSection' C π hF
    (Scheme.Pic.rep (y : picSigmaGrp (C ↘ Sk) σ hσ g).1) _ (ptSec_snd _ _ _ _) hsW
  rw [Scheme.Pic.mk_rep, add_comm] at key
  change chiCurve π g (Scheme.Pic.rep (Scheme.Pic.map (bcMap (C ↘ Sk) a g₁ g ha)
    (ptClass C σ hσ g₁ x hx).1 + (show (pullback (C ↘ Sk) g).Pic from y.1))) =
      chiCurve π g (Scheme.Pic.rep (show (pullback (C ↘ Sk) g).Pic from y.1)) + 1
  rw [coe_ptClass, map_picClass_ptSec C g₁ x hx a g ha]
  exact key

end Degree

section Density

lemma appLE_injective_of_iso {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] {O : Y.Opens}
    {O' : X.Opens} (h : O' ≤ f ⁻¹ᵁ O) (hO' : O' = f ⁻¹ᵁ O) :
    Function.Injective (f.appLE O O' h) := by
  subst hO'
  rw [Scheme.Hom.appLE_eq_app]
  exact (asIso (f.app O)).commRingCatIsoToRingEquiv.injective

variable [PerfectField k] [IsCurveOver k C] (Ω : Type u) [Field Ω] [Algebra k Ω] [IsAlgClosed Ω]

local notation "SΩ" => Spec (CommRingCat.of Ω)
local notation "sΩ" => specAlgebraMap (k₀ := k) Ω

omit [PerfectField k] in
/-- **Density of `C(Ω)`** (proof of Stacks, Lemma 44.6.5, Tag 0B9Y, over `Ω = k̄`): for `T`
affine over `Ω` with `Γ(T)` a field, a nonzero function on `W ×_k T` does not vanish at the
base change of some `Ω`-point `x` of `C`. -/
theorem exists_pt_appLE_ne_zero {T : Scheme.{u}} [IsAffine T] (hF : IsField Γ(T, ⊤))
    (j : T ⟶ Spec (CommRingCat.of Ω)) (g : T ⟶ Spec (CommRingCat.of k))
    (hj : j ≫ specAlgebraMap (k₀ := k) Ω = g) (W : C.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (a : Γ(pullback (C ↘ Spec (CommRingCat.of k)) g,
      pullback.fst (C ↘ Spec (CommRingCat.of k)) g ⁻¹ᵁ W)) (ha : a ≠ 0) :
    ∃ (x : SΩ ⟶ C) (hx : x ≫ (C ↘ Sk) = sΩ)
      (h : ⊤ ≤ ptSec C g (j ≫ x) (comp_pt_hom C sΩ x hx j g hj) ⁻¹ᵁ
        (pullback.fst (C ↘ Sk) g ⁻¹ᵁ W)),
      (ptSec C g (j ≫ x) (comp_pt_hom C sΩ x hx j g hj)).appLE _ ⊤ h a ≠ 0 := by
  letI : T.Over SΩ := ⟨j⟩
  set C' := pullback (C ↘ Sk) sΩ
  let p := pullback.fst (C ↘ Sk) sΩ
  haveI : AlgebraicGeometry.Surjective sΩ :=
    ⟨fun y ↦ ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩
  haveI : AlgebraicGeometry.Surjective p :=
    MorphismProperty.pullback_fst (P := @AlgebraicGeometry.Surjective) _ _ inferInstance
  haveI : IsAffineHom p := MorphismProperty.pullback_fst (P := @IsAffineHom) _ _ inferInstance
  let W' : C'.Opens := p ⁻¹ᵁ W
  have hW' : IsAffineOpen W' := hW.preimage p
  haveI : Nonempty W' := by
    obtain ⟨⟨w, hw⟩⟩ := (inferInstance : Nonempty W)
    obtain ⟨c, hc⟩ := p.surjective w
    exact ⟨⟨c, show p c ∈ W from hc ▸ hw⟩⟩
  let φ := bcHom C Ω j g hj
  have hφ1 : φ ≫ pullback.fst _ _ = pullback.fst _ _ ≫ pullback.fst _ _ := bcHom_fst j g hj
  have hφ2 : φ ≫ pullback.snd _ _ = pullback.snd _ _ := bcHom_snd j g hj
  have hφ : φ ⁻¹ᵁ (pullback.fst (C ↘ Sk) g ⁻¹ᵁ W) =
      pullback.fst (C' ↘ SΩ) (T ↘ SΩ) ⁻¹ᵁ W' := by
    rw [← Scheme.Hom.comp_preimage, hφ1, Scheme.Hom.comp_preimage]
    rfl
  let a' := φ.appLE _ _ hφ.ge a
  have ha' : a' ≠ 0 := fun h0 ↦ ha (appLE_injective_of_iso φ hφ.ge hφ.symm
    (h0.trans (map_zero _).symm))
  obtain ⟨xC', hx', -, h', hne⟩ := exists_point_appLE_ne_zero C' hF W' hW' a' ha'
  let x : SΩ ⟶ C := xC' ≫ p
  have hx : x ≫ (C ↘ Sk) = sΩ := by
    change xC' ≫ p ≫ (C ↘ Sk) = sΩ
    rw [pullback.condition]
    change (xC' ≫ (C' ↘ SΩ)) ≫ sΩ = sΩ
    rw [hx', Category.id_comp]
  have key : ptSec C g (j ≫ x) (comp_pt_hom C sΩ x hx j g hj) =
      secT (C' ↘ SΩ) xC' hx' (T ↘ SΩ) ≫ φ := by
    apply pullback.hom_ext
    · rw [ptSec_fst, Category.assoc]
      erw [hφ1, secT_fst_assoc]
      rfl
    · rw [ptSec_snd, Category.assoc]
      erw [hφ2, secT_snd]
  refine ⟨x, hx, ?_, ?_⟩
  · rw [key, Scheme.Hom.comp_preimage]
    erw [hφ]
    exact h'
  · suffices H : ∀ (s : T ⟶ pullback (C ↘ Sk) g) (_ : s = secT (C' ↘ SΩ) xC' hx' (T ↘ SΩ) ≫ φ)
        (hs : ⊤ ≤ s ⁻¹ᵁ (pullback.fst (C ↘ Sk) g ⁻¹ᵁ W)), s.appLE _ ⊤ hs a ≠ 0 from H _ key _
    rintro s rfl hs
    rw [← Scheme.Hom.appLE_comp_appLE (V := pullback.fst (C' ↘ SΩ) (T ↘ SΩ) ⁻¹ᵁ W')
      (e₁ := hφ.ge) (e₂ := h')]
    exact hne

end Density

section Translate

variable [PerfectField k] [IsCurveOver k C] (π : C ⟶ ProjectiveLine.scheme k) [IsFinite π]
  (σ : Spec (CommRingCat.of k) ⟶ C)
  (hσ : σ ≫ (C ↘ Spec (CommRingCat.of k)) = 𝟙 (Spec (CommRingCat.of k)))
  (Ω : Type u) [Field Ω] [Algebra k Ω] [IsAlgClosed Ω]

local notation "G" => picSigma (C ↘ Sk) σ hσ
local notation "SΩ" => Spec (CommRingCat.of Ω)
local notation "sΩ" => specAlgebraMap (k₀ := k) Ω

/-- The classes over `Ω` used as translates: the subgroup of `Pic_{C/k,σ}(Ω)` generated by the
classes pulled back from `k` and the classes `[𝒪(x)]` of `Ω`-points `x` of `C`. -/
def ptSubgroup : AddSubgroup ((G).obj (op (Over.mk sΩ))) :=
  AddSubgroup.closure (Set.range (fun c ↦ restr G c sΩ) ∪
    {c | ∃ (x : SΩ ⟶ C) (hx : x ≫ (C ↘ Sk) = sΩ), c = ptClass C σ hσ sΩ x hx})

omit [IsAlgClosed Ω] in
lemma restr_mem_ptSubgroup (c : (G).obj (op (Over.mk (𝟙 Sk)))) :
    restr G c sΩ ∈ ptSubgroup C σ hσ Ω :=
  AddSubgroup.subset_closure (Or.inl ⟨c, rfl⟩)

omit [IsAlgClosed Ω] in
lemma ptClass_mem_ptSubgroup (x : SΩ ⟶ C) (hx : x ≫ (C ↘ Sk) = sΩ) :
    ptClass C σ hσ sΩ x hx ∈ ptSubgroup C σ hσ Ω :=
  AddSubgroup.subset_closure (Or.inr ⟨x, hx, rfl⟩)

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] [IsAlgClosed Ω] in
lemma bcMap_comp_bcMap_top {T : Scheme.{u}} (j : T ⟶ SΩ) (g : T ⟶ Sk) (hj : j ≫ sΩ = g) :
    bcMap (C ↘ Sk) j sΩ g hj ≫ bcMap (C ↘ Sk) sΩ (𝟙 Sk) sΩ (Category.comp_id _) =
      bcMap (C ↘ Sk) g (𝟙 Sk) g (Category.comp_id _) := by
  subst hj
  apply pullback.hom_ext <;> simp

section Field

variable (K : CommRingCat.{u}) [(Spec K).Over (Spec (CommRingCat.of k))]

local notation "XK" => pullback (C ↘ Sk) (Spec K ↘ Sk)

/-- **Removing an `Ω`-point** (Stacks, Lemma 44.6.5, Tag 0B9Y, over `Ω = k̄`). -/
theorem goodK_removePoint_ext (hF : IsField Γ(Spec K, ⊤)) (j : Spec K ⟶ SΩ)
    (hj : j ≫ sΩ = (Spec K ↘ Sk)) (M : (XK).Modules) [M.IsInvertible]
    {d : ℕ} (hM : GoodK C π K M (d + 1)) :
    ∃ c ∈ ptSubgroup C σ hσ Ω,
      GoodK C π K (Scheme.Pic.rep (Scheme.Pic.mk M +
        Scheme.Pic.map (bcMap (C ↘ Sk) j sΩ (Spec K ↘ Sk) hj) c.1)) d := by
  letI := hF.toField
  set U' := chartK C π K 0
  set V' := chartK C π K 1
  have hU : IsAffineOpen U' := isAffineOpen_chart (T₀ := Spec K) π 0
  have hV : IsAffineOpen V' := isAffineOpen_chart (T₀ := Spec K) π 1
  have hUV : IsAffineOpen (U' ⊓ V') := isAffineOpen_chart_inf (T₀ := Spec K) π
  haveI := (finite_H0_H1_K C π K hF M).1
  obtain ⟨h, hh⟩ : ∃ h : cechModH0 (Spec K) M U' V', h ≠ 0 :=
    Module.finrank_pos_iff_exists_ne_zero.mp (by rw [hM.2]; omega)
  have hW : M.presheaf.map (homOfLE (inf_le_left : U' ⊓ V' ≤ U')).op h.1.1 ≠ 0 := by
    intro h0
    have h2 : M.presheaf.map (homOfLE (inf_le_right : U' ⊓ V' ≤ V')).op h.1.2 = 0 :=
      (TwoCech.mem_H0.mp h.2).symm.trans h0
    apply hh
    refine Subtype.ext (Prod.ext ?_ ?_)
    · exact injective_res_chartK C π K hF M 0 inf_le_left (h0.trans (map_zero _).symm)
    · exact injective_res_chartK C π K hF M 1 inf_le_right (h2.trans (map_zero _).symm)
  haveI := projective_sections M hUV
  obtain ⟨μ, hμ⟩ : ∃ μ : Module.Dual Γ(XK, U' ⊓ V') Γ(M, U' ⊓ V'),
      μ (M.presheaf.map (homOfLE (inf_le_left : U' ⊓ V' ≤ U')).op h.1.1) ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hW ((Module.forall_dual_apply_eq_zero_iff _ _).mp hcon)
  -- an `Ω`-point in the overlap of the charts at which `h` does not vanish
  let WC : C.Opens := π ⁻¹ᵁ (ProjectiveLine.U k 0 ⊓ ProjectiveLine.U k 1)
  have hWC : IsAffineOpen WC := (ProjectiveLine.isAffineOpen_U_inf k).preimage π
  haveI : Nonempty WC := nonempty_chart_inf π
  obtain ⟨xΩ, hxΩ, hσx, hne⟩ := exists_pt_appLE_ne_zero C Ω hF j _ hj WC hWC _ hμ
  set σx := ptSec C (Spec K ↘ Sk) (j ≫ xΩ) (comp_pt_hom C sΩ xΩ hxΩ j _ hj)
  haveI := isClosedImmersion_of_section C (Spec K ↘ Sk) σx (ptSec_snd _ _ _ _)
  let D := RelEffCartier.ofSection C (Spec K ↘ Sk) σx (ptSec_snd _ _ _ _)
  refine ⟨-ptClass C σ hσ sΩ xΩ hxΩ, neg_mem (ptClass_mem_ptSubgroup C σ hσ Ω xΩ hxΩ), ?_⟩
  have hc : Scheme.Pic.map (bcMap (C ↘ Sk) j sΩ (Spec K ↘ Sk) hj)
      (-ptClass C σ hσ sΩ xΩ hxΩ).1 = -D.picClass := by
    change Scheme.Pic.map _ (-(ptClass C σ hσ sΩ xΩ hxΩ).1) = _
    rw [map_neg]
    exact congrArg Neg.neg (map_picClass_ptSec C sΩ xΩ hxΩ j _ hj)
  rw [hc]
  set M' := Scheme.Pic.rep (Scheme.Pic.mk M + -D.picClass)
  have e : M ≅ M' ⊗ D.lineBundle := by
    refine (Scheme.Pic.mk_eq_mk_iff.mp ?_).some
    rw [Scheme.Pic.mk_tensor, Scheme.Pic.mk_rep]
    change Scheme.Pic.mk M = Scheme.Pic.mk M + -D.picClass + D.picClass
    abel
  have hh0 : M.presheaf.map (homOfLE (inf_le_left : U' ⊓ V' ≤ U')).op h.1.1 ∉
      RingHom.ker (σx.appLE (U' ⊓ V') ⊤ hσx).hom •
        (⊤ : Submodule Γ(XK, U' ⊓ V') Γ(M, U' ⊓ V')) := by
    intro hmem
    apply hne
    have : μ (M.presheaf.map (homOfLE (inf_le_left : U' ⊓ V' ≤ U')).op h.1.1) ∈
        RingHom.ker (σx.appLE (U' ⊓ V') ⊤ hσx).hom := by
      refine Submodule.smul_induction_on (p := fun y ↦ μ y ∈
        RingHom.ker (σx.appLE (U' ⊓ V') ⊤ hσx).hom) hmem ?_ ?_
      · intro r hr y _
        rw [LinearMap.map_smul, smul_eq_mul]
        exact Ideal.mul_mem_right _ _ hr
      · intro y z hy hz
        rw [map_add]
        exact add_mem hy hz
    exact this
  obtain ⟨h1, h0⟩ := removePoint σx (ptSec_snd _ _ _ _) hF hU hV hUV hσx D
    (RelEffCartier.ofSection_ideal _ _ _ _) M' M e hM.1 h.2 hh0
  refine ⟨h1, ?_⟩
  have h0' : Module.finrank Γ(Spec K, ⊤) (cechModH0 (Spec K) M' (chartK C π K 0)
      (chartK C π K 1)) + 1 = d + 1 := by
    rw [← hM.2]
    exact h0
  change Module.finrank Γ(Spec K, ⊤) (cechModH0 (Spec K) M' (chartK C π K 0)
      (chartK C π K 1)) = d
  omega

/-- Iterating `goodK_removePoint_ext`: from `h⁰ = d + 1` down to `h⁰ = 1`. -/
theorem goodK_one_ext (hF : IsField Γ(Spec K, ⊤)) (j : Spec K ⟶ SΩ)
    (hj : j ≫ sΩ = (Spec K ↘ Sk)) :
    ∀ (d : ℕ) (z : (XK).Pic), GoodK C π K (Scheme.Pic.rep z) (d + 1) →
      ∃ c ∈ ptSubgroup C σ hσ Ω, GoodK C π K (Scheme.Pic.rep
        (z + Scheme.Pic.map (bcMap (C ↘ Sk) j sΩ (Spec K ↘ Sk) hj) c.1)) 1 := by
  intro d
  induction d with
  | zero => exact fun z hz ↦ ⟨0, zero_mem _, by
      change GoodK C π K (Scheme.Pic.rep (z + Scheme.Pic.map _ 0)) 1
      rwa [map_zero, add_zero]⟩
  | succ d ih =>
    intro z hz
    obtain ⟨c, hc, hgc⟩ := goodK_removePoint_ext C π σ hσ Ω K hF j hj (Scheme.Pic.rep z) hz
    rw [Scheme.Pic.mk_rep] at hgc
    obtain ⟨c₂, hc₂, hgc₂⟩ := ih _ hgc
    refine ⟨c + c₂, add_mem hc hc₂, ?_⟩
    change GoodK C π K (Scheme.Pic.rep (z + Scheme.Pic.map _ (c.1 + c₂.1))) 1
    rwa [map_add, ← add_assoc]

/-- **Stacks, Lemma 44.6.5 (Tag 0B9Y), over `Ω = k̄`**, for line bundles: every invertible
sheaf on `X_K` (`K` a field over `Ω`) is twisted into the `F`-condition by a class of
`ptSubgroup`. -/
theorem exists_fCond_translate_ext (hF : IsField Γ(Spec K, ⊤)) (j : Spec K ⟶ SΩ)
    (hj : j ≫ sΩ = (Spec K ↘ Sk)) (z : (XK).Pic) :
    ∃ c ∈ ptSubgroup C σ hσ Ω, FCond π (Spec K ↘ Sk) (Scheme.Pic.rep
      (Scheme.Pic.map (bcMap (C ↘ Sk) j sΩ (Spec K ↘ Sk) hj) c.1 + z)) := by
  obtain ⟨c₁, d, h₁⟩ := goodK_twist C π K hF (Scheme.Pic.rep z)
  rw [Scheme.Pic.mk_rep] at h₁
  obtain ⟨c₂, hc₂, h₂⟩ := goodK_one_ext C π σ hσ Ω K hF j hj d _ h₁
  have hmem : c₁ ∈ picSigmaGrp (C ↘ Sk) σ hσ (𝟙 Sk) := by
    rw [mem_picSigmaGrp]
    exact Subsingleton.elim _ _
  refine ⟨restr G ⟨c₁, hmem⟩ sΩ + c₂, add_mem (restr_mem_ptSubgroup C σ hσ Ω _) hc₂,
    fCond_of_goodK C π K hF ?_⟩
  let c₂' : (pullback (C ↘ Sk) sΩ).Pic := c₂.1
  have e : Scheme.Pic.map (bcMap (C ↘ Sk) j sΩ (Spec K ↘ Sk) hj)
      (restr G ⟨c₁, hmem⟩ sΩ + c₂).1 + z =
        z + Scheme.Pic.map (bcK C K) c₁ +
          Scheme.Pic.map (bcMap (C ↘ Sk) j sΩ (Spec K ↘ Sk) hj) c₂' := by
    change Scheme.Pic.map _ (Scheme.Pic.map (bcMap (C ↘ Sk) sΩ (𝟙 Sk) sΩ
      (Category.comp_id _)) c₁ + c₂') + z = _
    rw [map_add, ← AddMonoidHom.comp_apply, ← Scheme.Pic.map_comp, bcMap_comp_bcMap_top]
    abel
  rw [e]
  exact h₂

end Field

/-- **Every point of `Pic_{C/k,σ}` over a field `K ⊇ Ω` has a translate in `F` by a class of
`ptSubgroup`** (Stacks, Lemma 44.6.5, Tag 0B9Y, over `Ω = k̄`). -/
theorem exists_picF_translate_ext (K : CommRingCat.{u}) (hK : IsField K)
    (g : Spec K ⟶ Sk) (j : Spec K ⟶ SΩ) (hj : j ≫ sΩ = g) (y : (G).obj (op (Over.mk g))) :
    ∃ c ∈ ptSubgroup C σ hσ Ω, picF σ hσ π (Spec K)
      ⟨g, ((G).map (Over.homMk j hj : Over.mk g ⟶ Over.mk sΩ).op).hom c + y⟩ := by
  have hF : IsField Γ(Spec K, ⊤) :=
    MulEquiv.isField hK (Scheme.ΓSpecIso K).commRingCatIsoToRingEquiv.toMulEquiv
  letI : (Spec K).Over Sk := ⟨g⟩
  obtain ⟨c, hc, hf⟩ := exists_fCond_translate_ext C π σ hσ Ω K hF j hj
    (y : picSigmaGrp (C ↘ Sk) σ hσ g).1
  exact ⟨c, hc, picF_of_fPoint C π σ hσ _ hf⟩

end Translate

section Aux

variable [PerfectField k] [IsCurveOver k C] (π : C ⟶ ProjectiveLine.scheme k) [IsFinite π]
  (σ : Spec (CommRingCat.of k) ⟶ C)
  (hσ : σ ≫ (C ↘ Spec (CommRingCat.of k)) = 𝟙 (Spec (CommRingCat.of k)))

local notation "G" => picSigma (C ↘ Sk) σ hσ

omit [PerfectField k] in
lemma comp_comp_eq {T₁ T₂ T₃ : Scheme.{u}} {g₁ : T₁ ⟶ Sk} {g₂ : T₂ ⟶ Sk} {g₃ : T₃ ⟶ Sk}
    {a : T₁ ⟶ T₂} {b : T₂ ⟶ T₃} (wa : a ≫ g₂ = g₁) (wb : b ≫ g₃ = g₂) : (a ≫ b) ≫ g₃ = g₁ := by
  rw [Category.assoc, wb, wa]

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] in
lemma map_homMk_map_homMk {T₁ T₂ T₃ : Scheme.{u}} {g₁ : T₁ ⟶ Sk} {g₂ : T₂ ⟶ Sk}
    {g₃ : T₃ ⟶ Sk} (a : T₁ ⟶ T₂) (b : T₂ ⟶ T₃) (wa : a ≫ g₂ = g₁) (wb : b ≫ g₃ = g₂)
    (y : (G).obj (op (Over.mk g₃))) :
    ((G).map (Over.homMk a wa : Over.mk g₁ ⟶ Over.mk g₂).op).hom
        (((G).map (Over.homMk b wb : Over.mk g₂ ⟶ Over.mk g₃).op).hom y) =
      ((G).map (Over.homMk (a ≫ b) (comp_comp_eq wa wb) :
        Over.mk g₁ ⟶ Over.mk g₃).op).hom y := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
  rfl

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] in
lemma map_homMk_congr {T₁ T₂ : Scheme.{u}} {g₁ : T₁ ⟶ Sk} {g₂ : T₂ ⟶ Sk} {a a' : T₁ ⟶ T₂}
    (e : a = a') (w : a ≫ g₂ = g₁) (w' : a' ≫ g₂ = g₁) (y : (G).obj (op (Over.mk g₂))) :
    ((G).map (Over.homMk a w : Over.mk g₁ ⟶ Over.mk g₂).op).hom y =
      ((G).map (Over.homMk a' w' : Over.mk g₁ ⟶ Over.mk g₂).op).hom y := by
  subst e
  rfl

omit [PerfectField k] [IsCurveOver k C] [IsFinite π] in
lemma map_homMk_id {T : Scheme.{u}} {g : T ⟶ Sk} (w : 𝟙 T ≫ g = g)
    (y : (G).obj (op (Over.mk g))) :
    ((G).map (Over.homMk (𝟙 T) w : Over.mk g ⟶ Over.mk g).op).hom y = y := by
  have : (Over.homMk (𝟙 T) w : Over.mk g ⟶ Over.mk g) = 𝟙 _ := rfl
  rw [this, op_id, (G).map_id]
  rfl

/-- The class of a point in both charts has degree one. -/
theorem picDeg_one_ptClass {S₁ : Scheme.{u}} [Subsingleton S₁.Pic] (g₁ : S₁ ⟶ Sk)
    (x : S₁ ⟶ C) (hx : x ≫ (C ↘ Sk) = g₁)
    (hxW : ⊤ ≤ x ⁻¹ᵁ (π ⁻¹ᵁ (ProjectiveLine.U k 0 ⊓ ProjectiveLine.U k 1)))
    {T : Scheme.{u}} (a : T ⟶ S₁) (g : T ⟶ Sk) (ha : a ≫ g₁ = g) :
    picDeg σ hσ π 1 T ⟨g, ((G).map (Over.homMk a ha : Over.mk g ⟶ Over.mk g₁).op).hom
      (ptClass C σ hσ g₁ x hx)⟩ := by
  intro T' _ hF h
  have h0 := picDeg_zero_zero π σ hσ (h ≫ g) T' hF (𝟙 T')
  rw [op_id, Functor.map_id_apply] at h0
  have e : (sigmaG G).map h.op ⟨g, ((G).map (Over.homMk a ha : Over.mk g ⟶ Over.mk g₁).op).hom
      (ptClass C σ hσ g₁ x hx)⟩ = ⟨h ≫ g, ((G).map (Over.homMk (h ≫ a)
        (comp_comp_eq rfl ha) : Over.mk (h ≫ g) ⟶ Over.mk g₁).op).hom
          (ptClass C σ hσ g₁ x hx) + (0 : (G).obj (op (Over.mk (h ≫ g))))⟩ := by
    rw [sigmaG_map_mk, add_zero]
    exact Sigma.ext rfl (heq_of_eq (map_homMk_map_homMk C σ hσ h a rfl ha _))
  rw [e]
  have key := chiPoint_add_ptClass C π σ hσ g₁ x hx hxW hF (h ≫ a) (h ≫ g)
    (comp_comp_eq rfl ha) 0
  refine key.trans ?_
  erw [h0]
  ring

omit [IsFinite π] in
lemma picDeg_congr {T : Scheme.{u}} {g : T ⟶ Sk} {y y' : (G).obj (op (Over.mk g))} {d d' : ℤ}
    (h : y = y') (hd : d = d') (hy : picDeg σ hσ π d T ⟨g, y⟩) : picDeg σ hσ π d' T ⟨g, y'⟩ := by
  subst h hd
  exact hy

/-- Multiples of a class of degree `e` have degree `n e`. -/
theorem picDeg_zsmul {T : Scheme.{u}} (g : T ⟶ Sk) (y : (G).obj (op (Over.mk g))) {e : ℤ}
    (hy : picDeg σ hσ π e T ⟨g, y⟩) (n : ℤ) : picDeg σ hσ π (n * e) T ⟨g, n • y⟩ := by
  induction n using Int.induction_on with
  | zero =>
    exact picDeg_congr C π σ hσ (zero_smul ℤ y).symm (zero_mul e).symm
      (picDeg_zero_zero π σ hσ g)
  | succ n ih =>
    exact picDeg_congr C π σ hσ (by rw [add_smul, one_smul]; rfl) (by ring)
      (picDeg_add π σ hσ g _ _ ih hy)
  | pred n ih =>
    exact picDeg_congr C π σ hσ (by rw [sub_smul, one_smul, sub_eq_add_neg]; rfl) (by ring)
      (picDeg_add π σ hσ g _ _ ih (picDeg_neg π σ hσ g _ hy))

/-- `F`-membership of a point over a field can be checked after a field extension. -/
theorem picF_of_map {T T' : Scheme.{u}} [IsAffine T] [IsAffine T'] [Subsingleton T]
    [Nonempty T'] (h : T' ⟶ T) (x : (sigmaG G).obj (op T))
    (hx : picF σ hσ π T' ((sigmaG G).map h.op x)) : picF σ hσ π T x := by
  obtain ⟨U, hU⟩ := picF_open σ hσ π T x
  have h1 : Set.range h ⊆ U := (hU T' h).1 hx
  obtain ⟨p⟩ := (inferInstance : Nonempty T')
  have h2 := (hU T (𝟙 T)).2 (by
    rintro _ ⟨q, rfl⟩
    rw [Subsingleton.elim ((𝟙 T : T ⟶ T) q) (h p)]
    exact h1 ⟨p, rfl⟩)
  rwa [op_id, Functor.map_id_apply] at h2

variable (Ω : Type u) [Field Ω] [Algebra k Ω] [IsAlgClosed Ω]

/-- `C` has an `Ω`-point in both charts. -/
theorem exists_pt_chart_inf_ext :
    ∃ (x : Spec (CommRingCat.of Ω) ⟶ C) (_ : x ≫ (C ↘ Sk) = specAlgebraMap (k₀ := k) Ω),
      ⊤ ≤ x ⁻¹ᵁ (π ⁻¹ᵁ (ProjectiveLine.U k 0 ⊓ ProjectiveLine.U k 1)) := by
  set sΩ := specAlgebraMap (k₀ := k) Ω
  let WC : C.Opens := π ⁻¹ᵁ (ProjectiveLine.U k 0 ⊓ ProjectiveLine.U k 1)
  have hWC : IsAffineOpen WC := (ProjectiveLine.isAffineOpen_U_inf k).preimage π
  haveI : Nonempty WC := nonempty_chart_inf π
  let p := pullback.fst (C ↘ Sk) sΩ
  haveI : AlgebraicGeometry.Surjective sΩ :=
    ⟨fun y ↦ ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩
  haveI : AlgebraicGeometry.Surjective p :=
    MorphismProperty.pullback_fst (P := @AlgebraicGeometry.Surjective) _ _ inferInstance
  haveI : Nonempty (p ⁻¹ᵁ WC) := by
    obtain ⟨⟨w, hw⟩⟩ := (inferInstance : Nonempty WC)
    obtain ⟨c, hc⟩ := p.surjective w
    exact ⟨⟨c, show p c ∈ WC from hc ▸ hw⟩⟩
  haveI : IsIntegral (pullback (C ↘ Sk) sΩ) := IsCurveOver.isIntegral Ω _
  haveI : Nontrivial Γ(pullback (C ↘ Sk) sΩ, p ⁻¹ᵁ WC) := inferInstance
  obtain ⟨x, hx, h, -⟩ := exists_pt_appLE_ne_zero C Ω (isField_ΓSpec' Ω) (𝟙 _) sΩ
    (Category.id_comp _) WC hWC (1 : Γ(pullback (C ↘ Sk) sΩ, p ⁻¹ᵁ WC)) one_ne_zero
  refine ⟨x, hx, ?_⟩
  rw [← Scheme.Hom.comp_preimage, ptSec_fst, Category.id_comp] at h
  exact h

end Aux

end CurvesJacobian
