import Mathlib.NumberTheory.Padics.Complex
import Mathlib.Algebra.Field.ULift
import Mathlib.Analysis.Normed.Algebra.Basic
import Mathlib.NumberTheory.Padics.ProperSpace
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# Number fields embed into nonarchimedean local fields

We show that every number field `k` admits a ring homomorphism into a locally compact
(proper) nonarchimedean nontrivially normed field living in the same universe as `k`.

The field is a finite extension `F` of `ℚ_[2]` inside `AlgebraicClosure ℚ_[2]`, generated by
the images of a `ℚ`-basis of `k`, with the norm restricted from `PadicAlgCl 2` (the spectral
norm), and lifted to the universe of `k` via `ULift`.
-/

universe u v

namespace CurvesJacobian

/-- A nontrivially normed, ultrametric, proper field `L₀` can be transported to `ULift L₀` in any
universe, keeping all the properties and the ring homomorphism from `k`. -/
theorem exists_ulift_localField (k : Type u) [Field k] {L₀ : Type v}
    [NontriviallyNormedField L₀] [IsUltrametricDist L₀] [ProperSpace L₀] (f : k →+* L₀) :
    ∃ (L : Type max v u) (_ : NontriviallyNormedField L), IsUltrametricDist L ∧
      ProperSpace L ∧ Nonempty (k →+* L) := by
  letI nf : NormedField (ULift.{u} L₀) :=
    { ULift.normedCommRing, ULift.field with
      norm_mul := fun x y => norm_mul x.down y.down }
  letI : NontriviallyNormedField (ULift.{u} L₀) :=
    { nf with
      non_trivial :=
        let ⟨x, hx⟩ := NontriviallyNormedField.non_trivial (α := L₀)
        ⟨ULift.up x, hx⟩ }
  have hiso : Isometry (ULift.up : L₀ → ULift.{u} L₀) := Isometry.of_dist_eq fun _ _ => rfl
  refine ⟨ULift.{u} L₀, inferInstance, ⟨fun x y z => dist_triangle_max x.down y.down z.down⟩,
    hiso.antilipschitz.properSpace hiso.continuous ULift.up_surjective,
    ⟨ULift.ringEquiv.symm.toRingHom.comp f⟩⟩

/-- A finite extension `F` of `ℚ_[p]` inside `AlgebraicClosure ℚ_[p]` receiving `k` gives a
locally compact nonarchimedean nontrivially normed field in the universe of `k` receiving `k`. -/
theorem Padic.exists_localField_of_intermediateField (p : ℕ) [Fact p.Prime] (k : Type u)
    [Field k] (F : IntermediateField ℚ_[p] (AlgebraicClosure ℚ_[p]))
    [FiniteDimensional ℚ_[p] F] (f : k →+* F) :
    ∃ (L : Type u) (_ : NontriviallyNormedField L), IsUltrametricDist L ∧ ProperSpace L ∧
      Nonempty (k →+* L) := by
  haveI : IsUltrametricDist F := inferInstance
  letI : NormedSpace ℚ_[p] F :=
    { norm_smul_le := fun c x => (norm_smul c (x : AlgebraicClosure ℚ_[p])).le }
  haveI : ProperSpace F := FiniteDimensional.proper ℚ_[p] F
  exact exists_ulift_localField.{u, 0} k f

/-- A finite extension `k` of `ℚ_[p]` embeds into a finite extension of `ℚ_[p]` inside
`AlgebraicClosure ℚ_[p]`. -/
theorem Padic.exists_finite_of_finiteDimensional (p : ℕ) [Fact p.Prime] (k : Type u) [Field k]
    [Algebra ℚ_[p] k] [FiniteDimensional ℚ_[p] k] :
    ∃ F : IntermediateField ℚ_[p] (AlgebraicClosure ℚ_[p]),
      FiniteDimensional ℚ_[p] F ∧ Nonempty (k →+* F) := by
  let φ : k →ₐ[ℚ_[p]] AlgebraicClosure ℚ_[p] := IsAlgClosed.lift
  let b := Module.finBasis ℚ_[p] k
  let F := IntermediateField.adjoin ℚ_[p] (Set.range (φ ∘ b))
  have hF : FiniteDimensional ℚ_[p] F :=
    IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  have hmem (x : k) : φ x ∈ F := by
    rw [← b.sum_repr x, map_sum]
    refine F.sum_mem fun i _ => ?_
    rw [map_smul]
    exact F.smul_mem (IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩)
  exact ⟨F, hF, ⟨φ.toRingHom.codRestrict F.toSubfield hmem⟩⟩

/-- **A finite extension of `ℚ_[p]` (any universe) embeds into a locally compact nonarchimedean
nontrivially normed field in its own universe.** -/
theorem Padic.exists_localField_of_finiteDimensional (p : ℕ) [Fact p.Prime] (k : Type u)
    [Field k] [Algebra ℚ_[p] k] [FiniteDimensional ℚ_[p] k] :
    ∃ (L : Type u) (_ : NontriviallyNormedField L), IsUltrametricDist L ∧ ProperSpace L ∧
      Nonempty (k →+* L) := by
  obtain ⟨F, hF, ⟨f⟩⟩ := Padic.exists_finite_of_finiteDimensional p k
  exact Padic.exists_localField_of_intermediateField p k F f

/-- A number field embeds into a finite extension of `ℚ_[2]` inside `AlgebraicClosure ℚ_[2]`. -/
theorem NumberField.exists_finite_padic (k : Type u) [Field k] [NumberField k] :
    ∃ F : IntermediateField ℚ_[2] (AlgebraicClosure ℚ_[2]),
      FiniteDimensional ℚ_[2] F ∧ Nonempty (k →+* F) := by
  let φ : k →ₐ[ℚ] AlgebraicClosure ℚ_[2] := IsAlgClosed.lift
  let b := Module.finBasis ℚ k
  let F := IntermediateField.adjoin ℚ_[2] (Set.range (φ ∘ b))
  have hF : FiniteDimensional ℚ_[2] F :=
    IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  have hmem (x : k) : φ x ∈ F := by
    rw [← b.sum_repr x, map_sum]
    refine F.sum_mem fun i _ => ?_
    rw [map_rat_smul]
    exact SubfieldClass.qsmul_mem F _ (IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩)
  exact ⟨F, hF, ⟨φ.toRingHom.codRestrict F.toSubfield hmem⟩⟩

/-- A number field embeds into a locally compact nonarchimedean nontrivially normed field
in the same universe. -/
theorem NumberField.exists_localField (k : Type u) [Field k] [NumberField k] :
    ∃ (L : Type u) (_ : NontriviallyNormedField L), IsUltrametricDist L ∧ ProperSpace L ∧
      Nonempty (k →+* L) := by
  obtain ⟨F, hF, ⟨f⟩⟩ := NumberField.exists_finite_padic k
  exact Padic.exists_localField_of_intermediateField 2 k F f

end CurvesJacobian
